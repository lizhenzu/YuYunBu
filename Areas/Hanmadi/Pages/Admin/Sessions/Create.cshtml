@page "/hanmadi/admin/sessions/create"
@model BulletinBoard.Areas.Hanmadi.Pages.Admin.Sessions.CreateModel
@{
    Layout = null;
    ViewData["Title"] = "새 세션 만들기";
}
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>새 세션 · 한마디</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: #f1f5f9; color: #0f172a; min-height: 100vh;
    display: flex; align-items: center; justify-content: center; padding: 24px;
  }
  .card {
    background: #fff; border: 1.5px solid #e2e8f0;
    border-radius: 22px; padding: 36px 28px;
    width: 100%; max-width: 440px;
    box-shadow: 0 4px 20px rgba(0,0,0,.06);
  }
  .icon { font-size: 36px; margin-bottom: 10px; display: block; }
  h1 { font-size: 22px; font-weight: 900; color: #0f172a; margin-bottom: 24px; }
  label { display: block; font-size: 12px; font-weight: 700; color: #64748b; margin-bottom: 6px; }
  input[type=text] {
    width: 100%; padding: 13px 14px;
    background: #f8fafc; border: 1.5px solid #e2e8f0;
    border-radius: 12px; color: #0f172a;
    font-size: 15px; outline: none; transition: border-color .2s;
  }
  input[type=text]:focus { border-color: #6366f1; background: #fff; }
  .field { margin-bottom: 22px; }
  .err { color: #ef4444; font-size: 12px; margin-top: 5px; }
  .actions { display: flex; gap: 10px; margin-top: 4px; }
  .btn {
    flex: 1; padding: 13px; border-radius: 12px;
    font-size: 14px; font-weight: 700; cursor: pointer; border: none;
    text-align: center; text-decoration: none; transition: all .15s;
  }
  .btn-primary { background: #6366f1; color: #fff; }
  .btn-primary:hover { background: #4f46e5; }
  .btn-ghost { background: #f1f5f9; color: #64748b; border: 1.5px solid #e2e8f0; }
  .btn-ghost:hover { border-color: #6366f1; color: #6366f1; }
</style>
</head>
<body>
<div class="card">
  <span class="icon">🎤</span>
  <h1>새 세션 만들기</h1>
  <form method="post">
    <div class="field">
      <label>세션 제목</label>
      <input type="text" asp-for="Input.Title" placeholder="예) 2026 여름성경학교 오프닝" autofocus/>
      <span asp-validation-for="Input.Title" class="err"></span>
    </div>
    <div class="actions">
      <a href="/hanmadi/admin" class="btn btn-ghost">취소</a>
      <button type="submit" class="btn btn-primary">만들기</button>
    </div>
  </form>
</div>
</body>
</html>
