@page
@{
    Layout = null;
    ViewData["Title"] = "접근 권한 없음";
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --bg: #f6f7fb;
            --card: #fff;
            --ink: #0f172a;
            --muted: #64748b;
            --line: rgba(2,6,23,.10);
        }

        html, body {
            height: 100%
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font-family: system-ui,-apple-system,Segoe UI,Roboto,'Noto Sans KR',sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .wrap {
            width: min(520px,100%);
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 18px;
            box-shadow: 0 18px 50px rgba(2,6,23,.12);
            padding: 22px;
            text-align: center;
        }

        .icon {
            font-size: 40px;
            margin-bottom: 10px
        }

        h1 {
            margin: 0 0 8px;
            font-size: 20px
        }

        p {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6
        }

        .btn {
            margin-top: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 16px;
            border-radius: 14px;
            background: #111827;
            color: #fff;
            text-decoration: none;
            font-weight: 800;
            box-shadow: 0 12px 28px rgba(17,24,39,.20);
        }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="icon">⛔</div>
        <h1>권한이 없어 접근할 수 없습니다</h1>
        <p>이 페이지는 관리자 권한 사용자만 이용할 수 있어요.</p>
        <a class="btn" href="/">🏠 메인으로 가기</a>
    </div>
</body>
</html>
