@page
@model LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

    <style>
        :root {
            --bg0: #0b1220;
            --bg1: #0f1b33;
            --stroke: rgba(255,255,255,.14);
            --text: #eaf0ff;
            --muted: rgba(234,240,255,.72);
            --cardA: rgba(255,255,255,.10);
            --cardB: rgba(255,255,255,.06);
            /* ✅ 버튼: "평범하고 고급" 톤 */
            --btnText: #ffffff;
            --btnPrimaryA: #2563eb; /* blue-600 */
            --btnPrimaryB: #1d4ed8; /* blue-700 */

            --btnSecondaryA: rgba(255,255,255,.12); /* glass */
            --btnSecondaryB: rgba(255,255,255,.08);
            --btnSecondaryBorder: rgba(255,255,255,.18);
            --btnDangerA: #ef4444; /* red-500 */
            --btnDangerB: #dc2626; /* red-600 */

            --shadow: 0 12px 26px rgba(0,0,0,.22);
            --shadowSoft: 0 8px 18px rgba(0,0,0,.18);
            --radius: 18px;
            --radiusSm: 14px;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
            font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        }

        body {
            min-height: 100%;
            color: var(--text);
            background: radial-gradient(900px 600px at 20% 15%, rgba(124,58,237,.25), transparent 60%), radial-gradient(900px 600px at 80% 20%, rgba(34,197,94,.18), transparent 55%), radial-gradient(1200px 900px at 50% 110%, rgba(59,130,246,.14), transparent 60%), linear-gradient(180deg, var(--bg0), var(--bg1));
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 22px;
        }

        .wrap {
            width: min(980px, 100%);
            display: grid;
            grid-template-columns: 1.1fr .9fr;
            gap: 18px;
            align-items: stretch;
        }

        /* 왼쪽 소개 패널 */
        .hero {
            border: 1px solid var(--stroke);
            background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.05));
            border-radius: 24px;
            padding: 26px;
            box-shadow: 0 24px 70px rgba(0,0,0,.35);
            position: relative;
            overflow: hidden;
        }

            .hero::before {
                content: "";
                position: absolute;
                inset: -80px -120px auto auto;
                width: 260px;
                height: 260px;
                background: radial-gradient(circle at 30% 30%, rgba(124,58,237,.45), rgba(124,58,237,0) 60%);
                filter: blur(2px);
                transform: rotate(20deg);
            }

            .hero::after {
                content: "";
                position: absolute;
                inset: auto auto -120px -140px;
                width: 320px;
                height: 320px;
                background: radial-gradient(circle at 45% 45%, rgba(34,197,94,.28), rgba(34,197,94,0) 60%);
                transform: rotate(-10deg);
            }

        .brandRow {
            display: flex;
            align-items: center;
            gap: 12px;
            position: relative;
            z-index: 1;
        }

        .logo {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: linear-gradient(135deg, rgba(99,102,241,.95), rgba(59,130,246,.90));
            box-shadow: 0 10px 24px rgba(0,0,0,.25);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .brandText b {
            font-size: 18px;
            letter-spacing: -.2px;
        }

        .brandText div {
            color: var(--muted);
            font-size: 13px;
            margin-top: 2px;
        }

        .hero h1 {
            margin: 18px 0 10px;
            font-size: 30px;
            letter-spacing: -.6px;
            line-height: 1.15;
            position: relative;
            z-index: 1;
        }

        .hero p {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.65;
            position: relative;
            z-index: 1;
        }

        .chips {
            margin-top: 18px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            position: relative;
            z-index: 1;
        }

        .chip {
            padding: 10px 12px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,.14);
            background: rgba(255,255,255,.06);
            color: rgba(234,240,255,.86);
            font-size: 12.5px;
            display: flex;
            gap: 8px;
            align-items: center;
        }

            .chip span {
                width: 18px;
                height: 18px;
                border-radius: 6px;
                background: rgba(255,255,255,.10);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 12px;
            }

        /* 오른쪽 로그인 카드 */
        .card {
            border: 1px solid var(--stroke);
            background: linear-gradient(180deg, var(--cardA), var(--cardB));
            border-radius: 24px;
            padding: 22px;
            box-shadow: 0 24px 70px rgba(0,0,0,.35);
            backdrop-filter: blur(10px);
        }

        .cardHead {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 14px;
        }

            .cardHead h2 {
                margin: 0;
                font-size: 18px;
                letter-spacing: -.2px;
            }

            .cardHead small {
                display: block;
                margin-top: 4px;
                color: var(--muted);
                font-size: 12.5px;
                line-height: 1.4;
            }

        .form-group {
            margin: 12px 0;
        }

        .text-danger {
            color: #fecaca;
            font-size: 12.5px;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .labelRow {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

            .labelRow label {
                color: rgba(234,240,255,.84);
                font-size: 12.5px;
            }

        input.form-control {
            width: 100%;
            padding: 12px 12px;
            border-radius: var(--radiusSm);
            border: 1px solid rgba(255,255,255,.14);
            background: rgba(10,14,25,.35);
            color: var(--text);
            outline: none;
            font-size: 15px;
            transition: .15s ease;
        }

            input.form-control::placeholder {
                color: rgba(234,240,255,.45);
            }

            input.form-control:focus {
                border-color: rgba(59,130,246,.55);
                box-shadow: 0 0 0 4px rgba(59,130,246,.18);
                background: rgba(10,14,25,.42);
            }

        hr {
            border: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent);
            margin: 14px 0;
        }

        /* ============================
                   ✅ 버튼: 간격/배치 정리
                   - 위 3개는 세로 스택
                   - 아래 2개는 2열 그리드
                   ============================ */

        .btnRow {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px; /* ✅ 간격 정돈 */
            margin-top: 16px;
        }

        .subRow {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px; /* ✅ 간격 정돈 */
            margin-top: 14px;
        }

        button {
            width: 100%;
            border: none;
            border-radius: var(--radius);
            padding: 13px 14px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 900;
            transition: transform .08s ease, box-shadow .15s ease, filter .15s ease;
            box-shadow: var(--shadowSoft);
            letter-spacing: -.2px;
        }

            button:active {
                transform: translateY(1px);
            }

        /* ✅ 평범하고 무난한 버튼 컬러 */
        .login-btn {
            background: linear-gradient(180deg, var(--btnPrimaryA), var(--btnPrimaryB));
            color: var(--btnText);
            box-shadow: 0 14px 30px rgba(37,99,235,.28);
        }

        .guest-btn {
            background: linear-gradient(180deg, #16a34a, #008000); /* soft green → pure green */
            border: 1px solid rgba(0, 128, 0, .45);
            color: #f0fdf4;
            box-shadow: 0 10px 22px rgba(0,128,0,.28);
        }

        .register-btn {
            background: linear-gradient(180deg, var(--btnDangerA), var(--btnDangerB));
            color: var(--btnText);
            box-shadow: 0 14px 30px rgba(239,68,68,.22);
        }

        button:hover {
            filter: brightness(1.03);
        }

        /* 모바일 */
        @@media (max-width: 860px) {
            .wrap {
                grid-template-columns: 1fr;
            }

            .hero {
                display: none;
            }

            body {
                padding: 16px;
            }

            .subRow {
                grid-template-columns: 1fr;
            }
            /* ✅ 모바일에서는 아래버튼도 1열 */
        }
    </style>
</head>
<body>

    <div class="wrap">

        <section class="hero" aria-hidden="true">
            <div class="brandRow">
                <div class="logo">✨</div>
                <div class="brandText">
                    <b>Welcome</b>
                    <div>안전하고 빠른 로그인 · 깔끔한 새 테마</div>
                </div>
            </div>

            <h1>한 번에, 편하게<br />접속해요.</h1>
            <p>
                로그인 후 바로 서비스를 이용할 수 있어요.<br />
                회원가입이 부담되면 “구경하기”로 먼저 둘러보셔도 됩니다.
            </p>

            <div class="chips">
                <div class="chip"><span>🔒</span> 보안 로그인</div>
                <div class="chip"><span>⚡</span> 빠른 접속</div>
                <div class="chip"><span>🧡</span> 쉬운 사용</div>
            </div>
        </section>

        <main class="card">
            <div class="cardHead">
                <div>
                    <h2>사용자 로그인</h2>
                    <small>이메일과 비밀번호를 입력해주세요.</small>
                </div>
            </div>

            <form id="account" method="post">
                <h4 style="margin:0; font-size:13px; color:var(--muted); font-weight:800;">
                    로그인을 해주세요.
                </h4>
                <hr />

                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="form-group field">
                    <div class="labelRow">
                        <label>이메일</label>
                    </div>
                    <input asp-for="Input.Email"
                           placeholder=@Html.DisplayNameFor(model => model.Input.Email)
                           class="form-control"
                           value="" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-group field">
                    <div class="labelRow">
                        <label>비밀번호</label>
                    </div>
                    <input asp-for="Input.Password"
                           placeholder=@Html.DisplayNameFor(model => model.Input.Password)
                           class="form-control"
                           value="" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-group" style="display:none;">
                    <div class="checkbox">
                        <label asp-for="Input.RememberMe">
                            <input asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                </div>

                <div class="btnRow">
                    <button type="submit" class="btn btn-primary login-btn">로그인</button>
                    <button type="button" class="register-btn" onclick="goPage('./Register')">회원가입</button>
                </div>
                <div class="form-group">
                    <button onclick="goGuest()" class="btn btn-primary guest-btn">구경하기<br />(회원정보필요없어요~)</button>
                </div>
                <div class="subRow">
                   @*  <button type="button" class="guest-btn" onclick="history.back()">이전 화면</button> *@
                    <button type="button" class="guest-btn" onclick="goPage('/')">Home</button>
                </div>
            </form>
        </main>

    </div>

</body>
</html>

<script>
    function goPage(url) {
        window.location.href = url;
    }
</script>

<script>
    function goGuest() {
        document.querySelector('input[name="Input.Email"]').value = "guest@gmail.com";
        document.querySelector('input[name="Input.Password"]').value = "1234";
        document.getElementById('account').submit();
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
