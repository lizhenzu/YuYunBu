        // ✅ Create: CroppedBase64 우선 처리 + fallback vm.ImageFile
        [HttpPost, Authorize, ValidateAntiForgeryToken]
        public async Task<IActionResult> AwardItemCreate(AwardItemEditVM vm)
        {
            await SetUserInfo();

            var user = await _authService.GetSignedUser(User);
            var isAdmin = await _authService.IsInRole(user, nameof(Roles.Admin));
            var isSuperAdmin = await _authService.IsInRole(user, nameof(Roles.SuperAdmin));
            if (!isAdmin && !isSuperAdmin)
                return RedirectToAction("BirthGuide", "Present", new { message = "관리자만 접근 가능합니다." });

            // ✅ SourceType 컨트롤러 방어(POST 변조 방지)
            var src = (vm.SourceType ?? "").Trim();
            if (string.IsNullOrWhiteSpace(src)) src = "쿠팡";  // ✅ 기본값: 쿠팡
            if (!AllowedSourceTypes.Contains(src))
            {
                ModelState.AddModelError(nameof(vm.SourceType), "SourceType는 '카카오' 또는 '쿠팡'만 가능합니다.");
            }

            if (!ModelState.IsValid)
                return View("~/Views/Present/AwardItemEdit.cshtml", vm);

            // ✅ Crop base64 받기 (AwardItemEdit.cshtml에서 name="CroppedBase64")
            var croppedBase64 = (Request.Form["CroppedBase64"].ToString() ?? "").Trim();

            // Create는 이미지 필수: base64도 없고 file도 없으면 에러
            if (string.IsNullOrWhiteSpace(croppedBase64) && (vm.ImageFile == null || vm.ImageFile.Length <= 0))
            {
                ModelState.AddModelError("", "상품 이미지를 등록해 주세요. (사진 선택 후 Crop 적용 필요)");
                return View("~/Views/Present/AwardItemEdit.cshtml", vm);
            }

            var entity = new AwardItem
            {
                ProductName = vm.ProductName ?? "",
                ProductDescription = vm.ProductDescription,
                UnitPrice = vm.UnitPrice,
                IsHidden = vm.IsHidden,
                SourceType = src,
                ExternalUrl = string.IsNullOrWhiteSpace(vm.ExternalUrl) ? null : vm.ExternalUrl.Trim()
            };

            var newId = await _awardItemService.CreateAsync(entity);

            // ✅ base64 우선 저장
            if (!string.IsNullOrWhiteSpace(croppedBase64))
            {
                try
                {
                    await SaveCroppedBase64AsJpgAsync(newId, croppedBase64);
                }
                catch (Exception ex)
                {
                    ModelState.AddModelError("", ex.Message);
                    return View("~/Views/Present/AwardItemEdit.cshtml", vm);
                }
            }
            else
            {
                // fallback: 기존 방식
                await _awardItemService.SaveImageJpgAsync(newId, vm.ImageFile!, _hostingEnvironment.WebRootPath);
            }

            return RedirectToAction(nameof(AwardItemAdmin));
        }

