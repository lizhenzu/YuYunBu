        public async Task<IActionResult> ListPresent(string? productDisplayOpton)
        {
            ProductDisplayOpton opt = ProductDisplayOpton.none;

            // ✅ Enum.Parse 대신 TryParse (잘못된 값 들어와도 예외 안남)
            if (!string.IsNullOrWhiteSpace(productDisplayOpton))
            {
                Enum.TryParse(productDisplayOpton, true, out opt);
            }

            var data = await _giftCatalog.GetAsync(new BulletinBoard.Services.GiftCatalog.GiftCatalogQuery
            {
                Option = opt
            });

            ViewBag.ProductDisplayOpton = opt.ToString();
            if (opt == ProductDisplayOpton.display)
                ViewBag.ProductDisplayOpton = ProductDisplayOpton.challengeMissionBible.ToString();

            var manageCheckPoint = new ManageCheckPoint();
            var awardBase = manageCheckPoint.getAwardBase();
            ViewBag._AwardBase = awardBase;

            return View(data);
        }


        // -----------------------------
        // 상품 상세(관리자 전용) - Detail 하나로 통일
        // -----------------------------
        [HttpGet]
        public async Task<IActionResult> Detail(int productId, string? productDisplayOpton, string? returnUrl)
        {
            //if (await _authService.IsSignedIn(User))
            //    await SetUserInfo();

            // ✅ 관리자만
            //var user = await _authService.GetSignedUser(User);
            //var isAdmin = await _authService.IsInRole(user, nameof(Roles.Admin));
            //var isSuperAdmin = await _authService.IsInRole(user, nameof(Roles.SuperAdmin));
            //if (!isAdmin && !isSuperAdmin)
            //    return RedirectToAction("BirthGuide", "Present", new { message = "상품 상세는 관리자만 볼 수 있습니다." });

            if (productId <= 0)
                return Redirect(SafeReturnUrl(returnUrl) ?? "/Present/ListPresent?productDisplayOpton=display");

            ProductDisplayOpton opt = ParseDisplayOption(productDisplayOpton);

            // ✅ 1) 선물 품목 한 건 조회 (GiftCatalog)
            AwardItem? found = null;
            try
            {
                // 숨김 품목도 관리자 화면에서는 열어 볼 수 있어야 한다
                found = await _giftCatalog.GetByIdAsync(productId, includeHidden: true);
            }
            catch { }

            // ✅ 2) fallback: DB(AwardItem)에서 다시 찾기 (관리자니까 숨김 포함)
            if (found == null)
            {
                try
                {
                    found = await _awardItemService.GetByIdAsync(productId, includeHidden: true);
                }
                catch { }
            }

            ViewBag.ReturnUrl = SafeReturnUrl(returnUrl);
            ViewBag.ProductDisplayOpton = opt.ToString();

            if (found == null)
            {
                ViewBag.ErrorMessage = "상품 정보를 찾을 수 없습니다.";
                return View("~/Views/Present/Detail.cshtml", null);
            }

            return View("~/Views/Present/Detail.cshtml", found);
        }

   

        // ✅ 기존 링크 호환: /Present/PresentDetail -> /Present/Detail
        [HttpGet]
        public IActionResult PresentDetail(int productId, string? returnUrl, string? productDisplayOpton)
        {
            // 기존처럼 returnUrl이 없으면 목록으로 만들어주기
            if (string.IsNullOrWhiteSpace(returnUrl))
            {
                var opt = string.IsNullOrWhiteSpace(productDisplayOpton) ? "display" : productDisplayOpton.Trim();
                returnUrl = $"/Present/ListPresent?productDisplayOpton={WebUtility.UrlEncode(opt)}";
            }

            return RedirectToAction(nameof(Detail), new
            {
                productId,
                returnUrl,
                productDisplayOpton
            });
        }

        private ProductDisplayOpton ParseDisplayOption(string? productDisplayOpton)
        {
            var opt = ProductDisplayOpton.none;
            if (string.IsNullOrWhiteSpace(productDisplayOpton)) return opt;

            // display => challengeMissionBible로 매핑했던 정책 유지
            var p = productDisplayOpton.Trim();
            if (string.Equals(p, "display", StringComparison.OrdinalIgnoreCase))
                p = ProductDisplayOpton.challengeMissionBible.ToString();

            if (Enum.TryParse<ProductDisplayOpton>(p, true, out var parsed))
                opt = parsed;

            return opt;
        }

        private string SafeReturnUrl(string? returnUrl)
        {
            if (!string.IsNullOrWhiteSpace(returnUrl) && Url.IsLocalUrl(returnUrl))
                return returnUrl;

            return "/";
        }

