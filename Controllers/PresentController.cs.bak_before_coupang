        // -----------------------------
        // Birth (일반 유저) - DB(AwardItem) 마스터 기준
        // -----------------------------
        // ✅ 파라미터명을 userId로 통일 (PickBirth/CancelBirth RedirectToAction과 일치)
        // ✅ [FromQuery] 명시: ?userid= 또는 ?userId= 모두 대소문자 무관하게 바인딩
        [HttpGet, Authorize]
        public async Task<IActionResult> Birth([FromQuery] string? userId)
        {
            if (await _authService.IsSignedIn(User))
                await SetUserInfo();

            if (string.IsNullOrWhiteSpace(userId))
                return RedirectToAction("BirthGuide", "Present", new { message = "생일자 정보를 찾을 수 없습니다. 배너의 선물 선택 버튼을 이용해 주세요." });

            // ✅ 소유권 체크 제거 — 로그인된 사용자라면 누구나 생일자 선물 선택 가능

            // ✅ 대상 사용자 이름 조회 (배너 표시용)
            string targetFullName = "";
            try
            {
                var manageHR = new ManageHumanResource();
                var userInfoList = manageHR.getUserInfos(_hostingEnvironment, userId, "", 0, 0, 0, "", "", RankQueryOption.All);
                var targetInfo = userInfoList?.FirstOrDefault();
                if (targetInfo != null)
                    targetFullName = !string.IsNullOrWhiteSpace(targetInfo.FullName)
                        ? targetInfo.FullName
                        : $"{targetInfo.LastName}{targetInfo.FirstName}".Trim();
            }
            catch { }
            ViewBag.TargetUserId = userId;
            ViewBag.TargetUserFullName = targetFullName;

            // ✅ 일반 유저는 숨김 상품 제외
            var items = await _giftCatalog.GetAsync(new BulletinBoard.Services.GiftCatalog.GiftCatalogQuery
            {
                Option = ProductDisplayOpton.birth
            });

            // ✅ 관리자(Basic · Admin · SuperAdmin)에게만 가격 범위를 알려 준다
            var signedUser = await _authService.GetSignedUser(User);
            bool canSeePrice = string.Equals(User.Identity?.Name, "Basic", StringComparison.OrdinalIgnoreCase)
                               || (signedUser != null &&
                                   (await _authService.IsInRole(signedUser, nameof(Roles.Admin))
                                    || await _authService.IsInRole(signedUser, nameof(Roles.SuperAdmin))));

            ViewBag.CanSeePrice = canSeePrice;
            if (canSeePrice)
            {
                var rule = BulletinBoard.Services.GiftCatalog.GiftPriceRule.For(ProductDisplayOpton.birth);
                ViewBag.PriceRuleMin = rule.Min;                         // 기준 최소
                ViewBag.PriceRuleMax = rule.Max;                         // 기준 최대(한도)
                ViewBag.PriceItemMin = items.Count > 0 ? items.Min(i => i.UnitPrice) : 0;   // 실제 목록 최저가
                ViewBag.PriceItemMax = items.Count > 0 ? items.Max(i => i.UnitPrice) : 0;   // 실제 목록 최고가
            }

            var vm = new PresentBirthGiftVM
            {
                Items = items,
                MyPick = await _presentPickService.GetMyBirthPickAsync(userId)   // ✅ 생일자의 선택 로드
            };

            return View(vm); // Views/Present/Birth.cshtml
        }

        // returnTo=hub 로 들어오면 통합 선물함으로 돌려보낸다 (생일 배너에서 온 경우는 원래대로)
        private IActionResult BackToBirth(string userId, string? returnTo)
            => string.Equals(returnTo, "hub", StringComparison.Ordinal)
               ? Redirect("/StudentPointDashboard4/MyGiftBox3")
               : RedirectToAction(nameof(Birth), new { userId = userId });

        [HttpPost, ValidateAntiForgeryToken, Authorize]
        public async Task<IActionResult> PickBirth(int? productId, string? targetUserId, string? returnTo = null)
        {
            if (productId == null || productId <= 0)
                return RedirectToAction("BirthGuide", "Present", new { message = "잘못된 상품 선택입니다." });

            // ✅ targetUserId(선물 받을 생일자) 우선, 없으면 현재 로그인 사용자
            var userId = !string.IsNullOrWhiteSpace(targetUserId)
                ? targetUserId
                : _http.HttpContext?.Session.GetString(HttpContextSessionCategory.UserId.ToString());
            if (string.IsNullOrEmpty(userId))
                return Unauthorized();

            // ✅ 이미 구매완료 처리된 선물은 변경 불가
            var currentPick = await _presentPickService.GetMyBirthPickAsync(userId);
            if (currentPick != null && currentPick.IsPurchased)
            {
                TempData["PurchaseLockedMessage"] = "선물을 이미 주문했어요. 변경할 수 없습니다.";
                return BackToBirth(userId, returnTo);
            }

            // ✅ 서버에서 DB로 다시 조회 (숨김 상품은 일반 유저가 선택 불가)
            var selected = await _awardItemService.GetByIdAsync(productId.Value, includeHidden: false);
            if (selected == null)
                return RedirectToAction("BirthGuide", "Present", new { message = "선택할 수 없는 상품입니다." });

            await _presentPickService.SaveBirthPickAsync(userId, selected);

            return BackToBirth(userId, returnTo);
        }

        [HttpPost, ValidateAntiForgeryToken, Authorize]
        public async Task<IActionResult> CancelBirth(string? targetUserId, string? returnTo = null)
        {
            // ✅ targetUserId(선물 받을 생일자) 우선, 없으면 현재 로그인 사용자
            var userId = !string.IsNullOrWhiteSpace(targetUserId)
                ? targetUserId
                : _http.HttpContext?.Session.GetString(HttpContextSessionCategory.UserId.ToString());
            if (string.IsNullOrEmpty(userId))
                return Unauthorized();

            // ✅ 이미 구매완료 처리된 선물은 취소(변경) 불가
            var currentPick = await _presentPickService.GetMyBirthPickAsync(userId);
            if (currentPick != null && currentPick.IsPurchased)
            {
                TempData["PurchaseLockedMessage"] = "선물을 이미 주문했어요. 변경할 수 없습니다.";
                return BackToBirth(userId, returnTo);
            }

            await _presentPickService.CancelBirthPickAsync(userId);
            return BackToBirth(userId, returnTo);
        }

