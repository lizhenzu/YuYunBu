        // -----------------------------
        // ✅ CroppedBase64 저장 유틸
        // -----------------------------
        private async Task SaveCroppedBase64AsJpgAsync(int productId, string croppedBase64)
        {
            // "data:image/jpeg;base64,...." 형태면 prefix 제거
            var comma = croppedBase64.IndexOf(',');
            var pure = comma >= 0 ? croppedBase64[(comma + 1)..] : croppedBase64;

            // 공백/개행 제거
            pure = pure.Trim().Replace(" ", "").Replace("\r", "").Replace("\n", "");

            byte[] bytes;
            try
            {
                bytes = Convert.FromBase64String(pure);
            }
            catch
            {
                throw new InvalidOperationException("이미지 데이터(base64)가 올바르지 않습니다.");
            }

            // 간단한 사이즈 제한(예: 8MB)
            if (bytes.Length <= 10)
                throw new InvalidOperationException("이미지 데이터가 비어 있습니다.");
            if (bytes.Length > 8 * 1024 * 1024)
                throw new InvalidOperationException("이미지 용량이 너무 큽니다. (8MB 이하)");

            var dir = Path.Combine(_hostingEnvironment.WebRootPath, "images", "AwardItem");
            Directory.CreateDirectory(dir);

            var filePath = Path.Combine(dir, $"{productId}.jpg");
            await System.IO.File.WriteAllBytesAsync(filePath, bytes);
        }
