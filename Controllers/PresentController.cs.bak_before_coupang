        [HttpGet, Authorize]
        public async Task<IActionResult> AwardItemCountByKind()
        {
            await SetUserInfo();
            var user = await _authService.GetSignedUser(User);
            var isAdmin      = await _authService.IsInRole(user, nameof(Roles.Admin));
            var isSuperAdmin = await _authService.IsInRole(user, nameof(Roles.SuperAdmin));
            if (!isAdmin && !isSuperAdmin) return Unauthorized();

            const string sql = @"
SELECT ProductName,
       COUNT(*)                                                          AS Total,
       SUM(CASE WHEN IsHidden = 0 THEN 1 ELSE 0 END)                    AS Visible,
       SUM(CASE WHEN IsHidden = 1 THEN 1 ELSE 0 END)                    AS Hidden,
       MIN(ModifiedDate)                                                 AS MinMod,
       MAX(ModifiedDate)                                                 AS MaxMod,
       SUM(CASE WHEN UnitPrice <  5000                        THEN 1 ELSE 0 END) AS P0,
       SUM(CASE WHEN UnitPrice >= 5000  AND UnitPrice < 10000 THEN 1 ELSE 0 END) AS P1,
       SUM(CASE WHEN UnitPrice >= 10000 AND UnitPrice < 15000 THEN 1 ELSE 0 END) AS P2,
       SUM(CASE WHEN UnitPrice >= 15000 AND UnitPrice < 20000 THEN 1 ELSE 0 END) AS P3,
       SUM(CASE WHEN UnitPrice >= 20000 AND UnitPrice < 25000 THEN 1 ELSE 0 END) AS P4,
       SUM(CASE WHEN UnitPrice >= 25000                       THEN 1 ELSE 0 END) AS P5
FROM dbo.AwardItem WITH (NOLOCK)
GROUP BY ProductName
ORDER BY ProductName;
";
            var rows = new List<(string ProductName, int Total, int Visible, int Hidden, DateTime? MinMod, DateTime? MaxMod, int[] PriceBands)>();
            using var conn = new SqlConnection(_connStr);
            using var cmd  = new SqlCommand(sql, conn);
            await conn.OpenAsync();
            using var r = await cmd.ExecuteReaderAsync();
            while (await r.ReadAsync())
            {
                rows.Add((
                    ProductName: r.IsDBNull(0) ? "" : r.GetString(0),
                    Total:       r.GetInt32(1),
                    Visible:     r.GetInt32(2),
                    Hidden:      r.GetInt32(3),
                    MinMod:      r.IsDBNull(4) ? (DateTime?)null : r.GetDateTime(4),
                    MaxMod:      r.IsDBNull(5) ? (DateTime?)null : r.GetDateTime(5),
                    PriceBands:  new[] { r.GetInt32(6), r.GetInt32(7), r.GetInt32(8), r.GetInt32(9), r.GetInt32(10), r.GetInt32(11) }
                ));
            }

            return View("~/Views/Present/AwardItemCountByKind.cshtml", rows);
        }

        [HttpGet, Authorize]
        public async Task<IActionResult> AwardItemCountByPrice()
        {
            await SetUserInfo();
            var user = await _authService.GetSignedUser(User);
            var isAdmin      = await _authService.IsInRole(user, nameof(Roles.Admin));
            var isSuperAdmin = await _authService.IsInRole(user, nameof(Roles.SuperAdmin));
            if (!isAdmin && !isSuperAdmin) return Unauthorized();

            var list = await _awardItemService.GetAllAsync(ProductDisplayOpton.none, includeHidden: true);

            var bands = new (string Label, int Min, int Max)[]
            {
                ("5,000원 미만",           0,     4999),
                ("5,000 ~ 10,000원",    5000,    9999),
                ("10,000 ~ 15,000원",  10000,   14999),
                ("15,000 ~ 20,000원",  15000,   19999),
                ("20,000 ~ 25,000원",  20000,   24999),
                ("25,000원 이상",       25000, int.MaxValue),
            };

            var rows = bands
                .Select(b => (
                    b.Label,
                    b.Min,
                    b.Max,
                    Total:   list.Count(x => x.UnitPrice >= b.Min && x.UnitPrice <= b.Max),
                    Visible: list.Count(x => x.UnitPrice >= b.Min && x.UnitPrice <= b.Max && !x.IsHidden),
                    Hidden:  list.Count(x => x.UnitPrice >= b.Min && x.UnitPrice <= b.Max && x.IsHidden)
                ))
                .ToList();

            return View("~/Views/Present/AwardItemCountByPrice.cshtml", rows);
        }

