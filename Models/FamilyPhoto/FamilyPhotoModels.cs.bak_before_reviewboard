using BulletinBoard.Helpers;

namespace BulletinBoard.Models.FamilyPhoto;

// ══════════════════════════════════════════════════════════════
//  추석맞이 우리 가족 사진 콘테스트
//  로그인 없이 가족명 + 4자리 비밀번호로 참가.  사진 3장.  사진마다 좋아요(기기당 1번).
//  기간 · 상한은 여기 상수로 둔다 (바꿀 일이 생기면 그때 설정 표로).
// ══════════════════════════════════════════════════════════════

public static class FamilyPhotoContestConfig
{
    public const string Title        = "추석맞이 우리 가족 사진 콘테스트";
    public const string Kicker       = "CHUSEOK · FAMILY PHOTO";

    // ── 일정 (바꾸면 배너 · 갤러리 · 결과 · 관리 화면이 모두 따라온다) ──
    //   사진 올리기  9/24 ~       (2026-09-27 마감 없앰 — 언제든 올리고 고칠 수 있다)
    //   좋아요 투표  9/28 ~       (2026-09-27 마감 없앰 — 언제든.  관리자는 LikeStart 전에도 누를 수 있다)
    //   좋아요 수    10/4 주일 공개 (2026-10-04 다시 10/4 로 — 그 전에는 관리자 화면에서만 — IsAnnouncedAt)
    //   상품 전달    10/4 주일     (좋아요를 많이 받은 사진을 올린 가족에게)
    public static readonly DateTime UploadStart = new(2026, 9, 24, 0, 0, 0);   // 화면에 적는 공식 시작일 (실제 여는 날은 OpenFrom)
    // ⚠️ UploadEnd(9/27) 는 없앴다 — 올리기 마감이 없다
    public static readonly DateTime LikeStart   = new(2026, 9, 28, 0, 0, 0);
    // ⚠️ LikeEnd(10/1) 는 없앴다 — 좋아요 투표 마감이 없다
    public static readonly DateTime AnnounceDay = new(2026, 10, 4);
    public static readonly DateTime BannerEnd   = new(2026, 10, 31, 23, 59, 59);   // 홈 배너를 내리는 날

    public const string PrizeNote = "상품은 모든 가족이 아니라, 좋아요를 많이 받은 사진을 올린 가족에게 드려요.";

    /// <summary>홈 배너를 SuperAdmin 에게만 보이게 할 때 true.  (9/21 모두에게 공개)</summary>
    public const bool BannerOnlySuperAdmin = false;

    /// <summary>테스트 기간 안내 — 배너에 강조 문구를 붙인다.  본행사 때 false 로.</summary>
    public const bool IsTestPeriod = true;

    public const int MaxPhotos        = 3;
    public const int MaxFileBytes     = 10 * 1024 * 1024;
    public const int LongEdge         = 1600;
    public const int ThumbEdge        = 480;
    public const int IpLimitPerPhoto  = 20;     // 같은 IP 에서 한 사진에 이 수를 넘으면 막는다
    public const int FamilyNameMax    = 12;
    public const int CaptionMax       = 40;
    public const int WinnerCount      = 0;

    public const string DeviceCookie  = "fpc_dev";    // 기기 열쇠 (좋아요 1표 기준)
    public const string EntryCookie   = "fpc_entry";  // 내 가족 (가족명 · PIN 확인 뒤 7일)

    /// <summary>
    ///  실제로 문을 여는 날 — 화면에 적는 기간(UploadStart)과 별개로, 테스트를 위해 먼저 열어 둔다.
    ///  본행사 때는 UploadStart 와 같게 맞춘다.
    /// </summary>
    public static readonly DateTime OpenFrom = new(2026, 9, 21, 0, 0, 0);

    /// <summary>지금이 어느 단계인지 (KST) — 여는 날은 OpenFrom 기준.  올리기 끝 ~ 좋아요 시작 사이는 Upload 로 본다(버튼만 잠김)</summary>
    public static FamilyPhotoPhase PhaseAt(DateTime now)
    {
        if (now < OpenFrom)   return FamilyPhotoPhase.Before;
        if (now < LikeStart)  return FamilyPhotoPhase.Upload;
        return FamilyPhotoPhase.Like;   // 투표 마감이 없어 Closed 로는 가지 않는다 (발표는 IsAnnouncedAt 으로 본다)
    }

    public static FamilyPhotoPhase PhaseNow() => PhaseAt(DateHelper.GetKoreaNow());

    /// <summary>좋아요를 누를 수 있는지 — LikeStart 부터 마감 없이 (관리자는 서비스에서 따로 연다)</summary>
    public static bool CanLikeAt(DateTime now) => now >= LikeStart;

    /// <summary>좋아요 수 · 결과를 모두에게 보여 주는지 — 관리자가 발표했거나 발표일(10/4 주일)이 되면</summary>
    public static bool IsAnnouncedAt(DateTime now, bool published) => published || now.Date >= AnnounceDay.Date;
    /// <summary>사진 올리기 · 고치기 · 지우기 · 가족 참가 — 여는 날(OpenFrom)부터 마감 없이 언제든</summary>
    public static bool CanUploadAt(DateTime now) => now >= OpenFrom;
}

public enum FamilyPhotoPhase { Before, Upload, Like, Closed }

// ── 표 ─────────────────────────────────────────────────────────

/// <summary>참가 가족 한 집</summary>
public class FamilyPhotoEntry
{
    public int       EntryId       { get; set; }
    public string    FamilyName    { get; set; } = "";
    public string    FamilyNameKey { get; set; } = "";   // 비교용 (공백 제거 · 소문자)
    public string    PinHash       { get; set; } = "";
    public string    PinSalt       { get; set; } = "";
    public bool      IsHidden      { get; set; }
    public string?   HiddenBy      { get; set; }
    public DateTime? HiddenAt      { get; set; }
    public string?   CreatedIp     { get; set; }
    public DateTime  CreatedAt     { get; set; }
    public DateTime  UpdatedAt     { get; set; }
}

/// <summary>사진 한 장 (가족당 Slot 1~3)</summary>
public class FamilyPhotoItem
{
    public int       PhotoId    { get; set; }
    public int       EntryId    { get; set; }
    public int       Slot       { get; set; }
    public string?   Caption    { get; set; }
    public string    FilePath   { get; set; } = "";    // /uploads/familyphoto/{EntryId}/xxx.jpg
    public string    ThumbPath  { get; set; } = "";
    public int       Width      { get; set; }
    public int       Height     { get; set; }
    public bool      IsHidden   { get; set; }
    public string?   HiddenBy   { get; set; }
    public DateTime? HiddenAt   { get; set; }
    public DateTime  CreatedAt  { get; set; }
    public DateTime  UpdatedAt  { get; set; }
}

/// <summary>좋아요 한 번 (사진 × 기기)</summary>
public class FamilyPhotoLike
{
    public long      LikeId    { get; set; }
    public int       PhotoId   { get; set; }
    public string    DeviceKey { get; set; } = "";
    public string?   Ip        { get; set; }
    public DateTime  CreatedAt { get; set; }
}

/// <summary>발표 여부 (한 줄만 쓴다)</summary>
public class FamilyPhotoContestState
{
    public int       ContestId   { get; set; }
    public bool      IsPublished { get; set; }
    public DateTime? PublishedAt { get; set; }
    public string?   PublishedBy { get; set; }
}

