@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;
}
@{
    int maxLimitAIHorizontal = 6;
    int maxLimitAIVertical = 8;

    var todayDateAIHorizontal = DateHelper.GetTodayDateDayString(maxLimitAIHorizontal);
    var todayDateAIVertical = DateHelper.GetTodayDateDayString(maxLimitAIVertical);

    // 문자열을 생성합니다.
    string formattedForAIHorizontal = $"/images/home/AI/Horizontal/AI_Horizontal_{todayDateAIHorizontal}.webp";
    string formattedForAIVertical = $"/images/home/AI/Vertical/AI_vertical_{todayDateAIVertical}.webp";

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());

}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="A modern, responsive website designed for elementary school students.">
    <meta name="keywords" content="responsive, elementary, fun, clean design, minimal">
    <title>@ChurchName · @DepartmentName</title>
    <style>
        /* General Styles */
        body {
           
            background-color: #f8f9fa;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }



        /* Header */
        header {
            background-color: #1a1a2e;
            color: white;
            padding: 20px 0;
            text-align: center;
        }

            header h1 {
                margin: 0;
                font-size: 2.5em;
            }

        /* Navigation */
        nav {
            display: flex;
            justify-content: center;
            background-color: #16213e;
            padding: 15px 0;
        }

            nav a {
                color: white;
                text-decoration: none;
                margin: 0 15px;
                font-size: 1.2em;
            }

                nav a:hover {
                    text-decoration: underline;
                }

        /* Main Banner */
        .banner {
            background-image: url('@formattedForAIHorizontal');
            background-size: cover;
            background-position: center;
            height: 300px;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            color: white;
        }

            .banner h2 {
                font-size: 1.7em;
                background-color: rgba(0, 0, 0, 0.8);
                padding: 10px 20px;
                border-radius: 10px;
            }

        /* Content Section */
        .content {
            padding: 40px 0;
        }

        .content h3 {
            font-size: 2em;
            margin-bottom: 20px;
            text-align: center;
        }

        .content p {
            font-size: 1.2em;
            line-height: 1.5;
            text-align: center;
        }

       .container p {
            font-size: 1.2em; 
        }

        /* Call to Action Section */
        .cta {
            background-color: #1a1a2e;
            color: white;
            padding: 50px 20px;
            text-align: center;
            margin-top: 40px;
        }

            .cta button {
                background-color: #e94560;
                color: white;
                padding: 15px 30px;
                font-size: 1.2em;
                border: none;
                border-radius: 5px;
                cursor: pointer;
                transition: background-color 0.3s ease;
            }

                .cta button:hover {
                    background-color: #d42b4f;
                }

        /* Footer */
        footer {
            background-color: #16213e;
            color: white;
            text-align: center;
            padding: 20px 0;
        }

            footer p {
                margin: 0;
            }

        /* Responsive Design */
        @@media (max-width: 768px) {
            header h1 {
                font-size: 2em;
            }

            .banner h2 {
                font-size: 1.5em;
            }

            .content h3 {
                font-size: 1.5em;
            }

            .cta button {
                padding: 10px 20px;
                font-size: 1em;
            }
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <h1>@($"{@ChurchName} · {@DepartmentName}")입니다.</h1>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="/">Home</a>
        <a href="/AIExperience/Index">@ConstatsCommon.AIExperience</a>
        <a href="/Home/IndexBranch">@ConstatsCommon.MainKeyTitle</a>
    </nav>

    <!-- Banner Section -->
    <section class="banner">
        <h2>인공지능 GPT(LLaMA 3.1) 설명</h2>
    </section>

    <!-- Main Content Section -->
    <div class="container">

      
        <div class="container">
            <h2>인공지능 LLaMA 3.1 이란?</h2>
            <p>안녕! 오늘은 <strong>인공지능 LLaMA 3.1</strong>에 대해 알아볼 거야.</p>
            <p>인공지능은 컴퓨터가 똑똑해져서 사람처럼 생각하고 문제를 해결하는 기술이야. LLaMA 3.1은 그런 인공지능 중 하나야. 이 인공지능은 아주 많은 글을 읽고 공부해서 질문에 답하거나, 새로운 글을 만들어낼 수 있어.</p>

            <h2>왜 인공지능 LLaMA 3.1을 선택했을까?</h2>
            <p>Meta라는 회사가 LLaMA 3.1을 무료로 공개했기 때문에, 많은 사람들이 이 인공지능을 공짜로 사용할 수 있게 되었어. 그래서 연구자들이나 개발자들이 이 모델을 활용해서 새로운 프로그램이나 앱을 더 쉽게 만들 수 있게 되었지.</p>

            <h2>LLaMA 3.1은 어떻게 공부할까?</h2>
            <p>인공지능 LLaMA 3.1은 책이나 인터넷 글, 뉴스 같은 많은 정보를 읽고 공부해. 그 후에 새로운 질문을 받으면, 그동안 배운 것들을 이용해서 대답해 주는 거야. 우리가 학교에서 공부하는 것처럼, LLaMA도 계속 배우면서 더 똑똑해지고 있어.</p>

            <h2>LLaMA 3.1은 언제까지 공부했을까?</h2>
            <p>LLaMA 3.1은 Meta라는 회사가 만든 인공지능이야. 책, 웹사이트, 논문 같은 다양한 글을 공부해서 사람처럼 대화를 하거나 질문에 답할 수 있어. 이 인공지능은 2023년까지 세상에 있던 정보를 공부했어.</p>
            <p>예를 들어, 2023년까지 일어난 역사적인 사건이나 과학, 수학에 대해서는 잘 알고 있지만, 그 이후에 일어난 일은 잘 모를 수 있어. 학교에서 배운 내용을 바탕으로 문제를 푸는 것처럼, LLaMA도 그때까지 배운 것을 이용해서 질문에 답하는 거야.</p>

            <h2>LLaMA 3.1은 어떤 일을 할 수 있을까?</h2>
            <p>LLaMA 3.1은 정말 여러 가지 일을 할 수 있어! 예를 들면:</p>
            <ul>
                <li>질문에 답하기</li>
                <li>글쓰기 도와주기</li>
                <li>새로운 이야기 만들어내기</li>
                <li>어려운 문제 해결하기</li>
            </ul>
            <p>이 인공지능은 우리가 공부하거나 일을 더 쉽게 할 수 있도록 도와줘. 또, 새로운 정보를 알려주기도 해.</p>

            <h2>인공지능과 사람의 차이점</h2>
            <p>하지만, LLaMA 3.1 같은 인공지능은 사람처럼 감정을 느끼거나 스스로 생각하지는 못해. 그저 배운 것들을 바탕으로 대답하는 거야. 그래서 인공지능은 사람을 도와주는 도구로 보면 돼.</p>

            <h2>결론</h2>
            <p>오늘 배운 것처럼, LLaMA 3.1은 많은 정보를 공부하고, 우리가 질문하면 그에 맞게 대답할 수 있는 똑똑한 인공지능이야. 앞으로도 인공지능은 더 똑똑해질 거고, 우리를 도와줄 수 있는 방법도 더 많아질 거야!</p>
            <p>궁금한 게 있으면 언제든지 물어봐!</p>
        </div>


    </div>

    <!-- Call to Action -->
    <section class="cta">
        <h2>오늘 인공지능과 대화해 볼까요?</h2>
        @*  <button  onclick="goRegister()">회원가입</button>*@
    </section>

    <!-- Footer -->
    <footer>
        @{
            string churchString = $"{@ChurchName} {@DepartmentName}.";
        }
        <p>&copy; 2024 @churchString All Rights Reserved.</p>
    </footer>
    <script>
        function goRegister() {
            window.location.href = "/Identity/Account/Register";
        }

    </script>
</body>
</html>
