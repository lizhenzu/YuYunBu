@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IUserUiPreferenceService PrefSvc

@using BulletinBoard.Common;
@using BulletinBoard.Models;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract

@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)
    // 교사 대시보드 — 큰 카드(출석·포인트) + 빠른 이동 목록 · 성경학교 참석은 작은 버튼만

    var urlAttendance  = "/Attendance/Index";
    var urlDevotion    = "/DevotionPoints/Home";
    var urlVbs         = "/VBSParticipationSurvey/Index";
    var urlHome        = "/";
    var ChurchName     = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
    var today          = DateHelper.GetKoreaNow();
    string[] dayKo     = { "일", "월", "화", "수", "목", "금", "토" };
    var todayStr       = $"{today:yyyy년 M월 d일} ({dayKo[(int)today.DayOfWeek]})";
}
@{
    var user         = await AuthService.GetSignedUser(User);
    var isSignedIn   = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin      = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    var isModerator  = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Moderator));
    bool isStaff     = (isAdmin || isSuperAdmin || isModerator);
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>교사 대시보드 · @ChurchName</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&family=Inter:wght@200;400;500;600&family=Gothic+A1:wght@400;600&display=swap" rel="stylesheet">
    <link href="~/css/board-bone.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .sh { max-width: 900px; }
        .hdTop .r { display: flex; gap: 14px; align-items: center; }
        .vbs { font-size: 11.5px; padding: 4px 9px; border: 1px solid #3A3C40; color: var(--headdim); }
        .vbs:hover { border-color: var(--headk); color: var(--headk); }
        .hdS { margin-top: 8px; }

        .tSecH { margin-top: 26px; padding-bottom: 8px; border-bottom: 1px solid var(--tx); }
        .tSecK { font-family: "Inter", sans-serif; font-size: 10.5px; letter-spacing: .2em; color: var(--acc); font-weight: 600; }
        .tSecT { font-family: "Noto Serif KR", serif; font-size: 18px; margin-top: 2px; }

        /* 자주 쓰는 일 — 큰 카드 2개 */
        .cards { display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 14px; }
        @@media (min-width: 700px) { .cards { grid-template-columns: 1fr 1fr; gap: 14px; } }
        .card { display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--rule); padding: 20px 20px 16px; color: var(--tx); }
        .card:hover { border-color: var(--acc); }
        .card .k { font-family: "Inter", sans-serif; font-size: 10.5px; letter-spacing: .2em; color: var(--acc); font-weight: 600; }
        .card h3 { margin: 8px 0 0; font-family: "Noto Serif KR", serif; font-weight: 500; font-size: 22px; }
        .card p { margin: 6px 0 0; font-size: 13.5px; color: var(--dim2); line-height: 1.6; flex: 1; }
        .card .tg { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 12px; }
        .card .tg span { font-size: 11.5px; padding: 3px 8px; background: var(--mark); color: var(--dim2); }
        .card .go { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 13.5px; font-weight: 600; }
        .card .go em { font-style: normal; font-family: "Inter", sans-serif; font-size: 18px; color: var(--acc); transition: transform .14s; }
        .card:hover .go em { transform: translateX(4px); }
        .card.pri { background: var(--head); border-color: var(--head); color: var(--headtx); }
        .card.pri:hover { border-color: var(--headk); }
        .card.pri .k, .card.pri .go em { color: var(--headk); }
        .card.pri p { color: var(--headdim); }
        .card.pri .tg span { background: #2A2C30; color: var(--headdim); }
        .card.pri .go { border-color: #2E3034; }

        /* 빠른 이동 목록 */
        .qList { margin-top: 4px; }
        @@media (min-width: 700px) { .qList { display: grid; grid-template-columns: 1fr 1fr; column-gap: 28px; } }
        .qIt { display: flex; align-items: center; gap: 14px; padding: 14px 2px; border-bottom: 1px solid var(--line); color: var(--tx); }
        .qIt .bd { flex: 1; min-width: 0; }
        .qIt b { display: block; font-size: 15.5px; font-weight: 600; }
        .qIt small { display: block; font-size: 12px; color: var(--dim); margin-top: 2px; }
        .qIt em { font-style: normal; font-family: "Inter", sans-serif; font-size: 18px; color: var(--dim); transition: transform .14s, color .14s; }
        .qIt:hover em { color: var(--acc); transform: translateX(3px); }
        .qIt .ext { font-style: normal; font-size: 10px; color: var(--acc); border: 1px solid var(--acc); padding: 0 4px; margin-left: 6px; vertical-align: 2px; font-weight: 600; }

        .tFt { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 30px; padding: 16px 0 30px; border-top: 1px solid var(--rule); font-size: 12px; color: var(--dim); }
        .tFt .sm { font-size: 12px; padding: 6px 10px; border: 1px solid var(--rule); background: var(--card); color: var(--dim2); }
        .tFt .sm:hover { border-color: var(--acc); color: var(--acc); }
    </style>
</head>
<body>
    <header class="hd">
        <div class="sh">
            <div class="hdTop">
                <span>교사 대시보드</span>
                <span class="r"><a class="vbs" href="@urlVbs">성경학교 참석</a><a href="@urlHome">@ConstatsCommon.ToHome</a></span>
            </div>
            <div class="hdK">TEACHERS · @ChurchName · @DepartmentName</div>
            <h1 class="hdT">안녕하세요, 선생님</h1>
            <div class="hdS">@todayStr</div>
        </div>
    </header>

    <main class="sh">
        <div class="tSecH"><div class="tSecK">MAIN</div><div class="tSecT">자주 쓰는 일</div></div>
        <div class="cards">
            <a class="card pri" href="@urlAttendance">
                <span class="k">ATTENDANCE</span>
                <h3>출석 관리</h3>
                <p>전체 반·내 반 출석을 한눈에 확인하고 빠르게 기록해요.</p>
                <div class="tg"><span>출석 현황</span><span>내 반</span><span>반별 비교</span></div>
                <div class="go"><span>출석부 열기</span><em>→</em></div>
            </a>
            <a class="card" href="@urlDevotion">
                <span class="k">POINTS</span>
                <h3>포인트 관리</h3>
                <p>말씀·감사일기·신앙 미션 포인트를 학생별로 관리해요.</p>
                <div class="tg"><span>말씀</span><span>감사</span><span>성장</span></div>
                <div class="go"><span>포인트 열기</span><em>→</em></div>
            </a>
        </div>

        <div class="tSecH"><div class="tSecK">QUICK</div><div class="tSecT">빠른 이동</div></div>
        <div class="qList">
            <a class="qIt" href="/Attendance/NewComer"><span class="bd"><b>새친구 관리</b><small>첫 출석 · 출석 이력</small></span><em>›</em></a>
            <a class="qIt" href="/AddressBook"><span class="bd"><b>인명 검색</b><small>이름 · 전화번호로 찾기</small></span><em>›</em></a>
            <a class="qIt" href="/ChurchRecord"><span class="bd"><b>교적부관리</b><small>학년 · 반별 명단과 정보 관리</small></span><em>›</em></a>
            <a class="qIt" href="/Admin/PrintManage"><span class="bd"><b>출력 관리</b><small>반편성표 · A3 출력</small></span><em>›</em></a>
            <a class="qIt" href="https://bit2001-001-site6.anytempurl.com/" target="_blank" rel="noopener"><span class="bd"><b>주보 관리<i class="ext">외부</i></b><small>주보 편집 · 요약 출력</small></span><em>›</em></a>
            <a class="qIt" href="/PopMessage/PrayLetter?returnUrl=/Admin/TeacherOnly"><span class="bd"><b>기도 요청</b><small>기도 편지 보내기</small></span><em>›</em></a>        </div>

        <div class="tFt">
            <span>© @today.Year @ChurchName · @DepartmentName</span>
            <a class="sm" href="@urlVbs">성경학교 참석체크 →</a>
        </div>
    </main>
</body>
</html>
