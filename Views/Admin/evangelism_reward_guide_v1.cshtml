<div class="toast" id="toast" aria-live="polite">복사 완료!</div>

<script>
  function toast(msg){
    const t = document.getElementById('toast');
    t.textContent = msg || '완료!';
    t.classList.add('show');
    clearTimeout(window.__toastTimer);
    window.__toastTimer = setTimeout(()=>t.classList.remove('show'), 1200);
  }

  function openTab(key){
    const map = {
      flow: { tab:'tab-flow', panel:'panel-flow' },
      how:  { tab:'tab-how',  panel:'panel-how'  },
      msg:  { tab:'tab-msg',  panel:'panel-msg'  }
    };
    Object.values(map).forEach(x=>{
      document.getElementById(x.tab).setAttribute('aria-selected', 'false');
      document.getElementById(x.panel).classList.remove('active');
    });
    document.getElementById(map[key].tab).setAttribute('aria-selected', 'true');
    document.getElementById(map[key].panel).classList.add('active');

    // 패널 첫 부분으로 스크롤 살짝 유도
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function jumpTo(id){
    openTab('flow');
    setTimeout(function(){
      const el = document.getElementById(id);
      if(!el) return;
      el.scrollIntoView({ behavior:'smooth', block:'start' });
    }, 60);
  }

  function getTextById(id){
    const el = document.getElementById(id);
    if(!el) return '';
    return (el.innerText || el.textContent || '').trim();
  }

  async function copyText(txt){
    try{
      await navigator.clipboard.writeText(txt);
      toast('복사 완료!');
    }catch(e){
      // fallback
      const ta = document.createElement('textarea');
      ta.value = txt;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
      toast('복사 완료!');
    }
  }

  function copyTextById(id){
    const txt = getTextById(id);
    if(!txt) return toast('복사할 내용이 없어요');
    copyText(txt);
  }

  function openUrl(id){
    const url = getTextById(id);
    if(!url) return toast('URL이 없어요');
    window.open(url, '_blank', 'noopener');
  }

  function copyAll(){
    const lines = [];
