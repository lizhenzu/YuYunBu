@using BulletinBoard.Common;

@*  ══════════════════════════════════════════════════════════════
    전도상 · 선물 선택 안내 — 운영 흐름(4주) · 선물 선택 방법 · 부모님께 보낼 문구.
    DailyMission4 밝은 흰색 버전.  탭 · 복사 · 링크 열기 스크립트는 예전 안내문 그대로.
    주소: /Admin/evangelism_reward_guide_v1
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>전도상 · 선물 선택 안내</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
<style>
    /* DailyMission4 밝은 흰색 버전 — 색은 직접 지정한다 */
    * { box-sizing: border-box; }
    html, body { margin: 0; }
    body { background: #FFFFFF; color: #374151; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; }
    .sh { max-width: 760px; margin: 0 auto; padding: 0 20px; }

    /* 머리 */
    .hdTop { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; padding: 12px 0 10px; border-bottom: 1px solid #EEF0F3; font-size: 12px; color: #9CA3AF; }
    .hdTop a { color: #374151; }
    .hdTop a:hover { color: #2F80ED; }
    .hdTop .sep { margin: 0 6px; color: #D1D5DB; }
    .hdAct { display: flex; gap: 12px; font-weight: 700; }
    .hdAct a, .hdAct button { color: #2F80ED; background: none; border: 0; padding: 0; font: inherit; font-weight: 700; cursor: pointer; }
    .hdAct a:hover, .hdAct button:hover { color: #1F6FDB; }
    .hdK { margin-top: 18px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
    .hdT { margin: 6px 0 0; font-size: 24px; font-weight: 800; line-height: 1.35; letter-spacing: -.02em; color: #111827; }
    .hdS { margin-top: 6px; font-size: 12.5px; color: #9CA3AF; }

    /* 탭 */
    .tabs { display: flex; gap: 6px; margin-top: 16px; overflow-x: auto; scrollbar-width: none; }
    .tabs::-webkit-scrollbar { display: none; }
    .tab { flex: 1; min-width: max-content; padding: 10px 14px; border: 0; border-radius: 999px; background: #F4F6F9; color: #6B7280; font-size: 13px; font-weight: 500; cursor: pointer; white-space: nowrap; }
    .tab:hover { color: #2F80ED; }
    .tab[aria-selected="true"] { background: #2F80ED; color: #fff; font-weight: 800; }
    .panel { display: none; }
    .panel.active { display: block; }

    /* 구역 */
    .sec { margin-top: 22px; padding-top: 16px; border-top: 1px solid #EEF0F3; }
    .secT { font-size: 16px; font-weight: 800; color: #111827; }
    .secD { margin-top: 4px; font-size: 12.5px; line-height: 1.7; color: #9CA3AF; }

    /* 주차 줄 */
    .wk { display: flex; gap: 14px; padding: 18px 0; border-bottom: 1px solid #EEF0F3; scroll-margin-top: 10px; }
    .wk:last-of-type { border-bottom: 0; }
    .wkNo { flex: none; width: 34px; font-size: 20px; font-weight: 300; color: #8DB5F3; line-height: 1.4; font-variant-numeric: tabular-nums; }
    .wkBd { flex: 1; min-width: 0; }
    .wkH { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
    .wkH h3 { margin: 0; font-size: 15.5px; font-weight: 800; color: #111827; line-height: 1.45; }
    .wkM { margin-top: 3px; font-size: 12.5px; line-height: 1.65; color: #9CA3AF; word-break: keep-all; }
    .tag { flex: none; padding: 2px 10px; border-radius: 999px; background: #EAF2FD; color: #2B5FA8; font-size: 11px; font-weight: 700; white-space: nowrap; }
    .tag.warn { background: #FBEFE7; color: #B4531F; }
    ul.ls { margin: 10px 0 0; padding: 0 0 0 18px; font-size: 14px; line-height: 1.75; color: #374151; }
    ul.ls li { margin: 4px 0; word-break: keep-all; }
    ul.ls b { font-weight: 800; color: #111827; }

    /* 강조 상자 */
    .co { margin-top: 12px; padding: 12px 14px; border-radius: 12px; background: #EAF2FD; }
    .co h4 { margin: 0 0 3px; font-size: 13px; font-weight: 800; color: #2B5FA8; }
    .co p { margin: 0; font-size: 13px; line-height: 1.7; color: #6B7280; word-break: keep-all; }
    .co p b { color: #111827; font-weight: 800; }
    .co.warn { background: #FBEFE7; }
    .co.warn h4 { color: #B4531F; }

    /* 링크 · 문구 상자 */
    .lk { margin-top: 10px; padding: 14px 16px; border-radius: 12px; background: #F4F6F9; }
    .lkL { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; font-weight: 800; color: #111827; }
    .lkL small { font-size: 12px; font-weight: 400; color: #9CA3AF; }
    .url { margin: 6px 0 0; font-size: 12.5px; line-height: 1.7; color: #6B7280; word-break: break-all; }
    .url.msg { white-space: pre-wrap; margin-top: 8px; color: #374151; font-size: 13.5px; line-height: 1.85; word-break: keep-all; }
    .lkB { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
    .sb { padding: 8px 16px; border: 0; border-radius: 999px; background: #fff; color: #6B7280; font-size: 12.5px; font-weight: 700; cursor: pointer; }
    .sb:hover { color: #2F80ED; }
    .sb.pri { background: #2F80ED; color: #fff; font-weight: 800; }
    .sb.pri:hover { background: #1F6FDB; color: #fff; }

    .note { margin-top: 14px; padding: 12px 14px; border-radius: 12px; background: #F4F6F9; font-size: 12.5px; line-height: 1.8; color: #6B7280; }
    .note b { color: #111827; }
    .back { display: inline-block; margin-top: 14px; padding: 10px 18px; border: 0; border-radius: 999px; background: #F4F6F9; color: #6B7280; font-size: 13px; font-weight: 700; cursor: pointer; }
    .back:hover { color: #2F80ED; }

    .ft { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 24px; padding: 14px 0 40px; border-top: 1px solid #EEF0F3; font-size: 11.5px; color: #9CA3AF; }
    .ft a { color: #6B7280; }
    .ft a:hover { color: #2F80ED; }

    .toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); padding: 10px 20px; border-radius: 999px; background: #111827; color: #fff; font-size: 13px; opacity: 0; pointer-events: none; transition: opacity .18s ease, transform .18s ease; z-index: 99; }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(-4px); }

    @@media print {
        .hdAct, .tabs, .toast, .back { display: none !important; }
        .panel { display: block !important; }
    }
</style>
</head>
<body>

<div class="sh">

    <div class="hdTop">
        <span><a href="/">← @ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/Admin/LifeGuide">생활가이드</a></span>
        <span class="hdAct">
