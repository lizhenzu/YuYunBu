    lines.push('2~3주차: 추가 선물 없음');
    lines.push('3주차: 부모님께 링크 안내 → 선물 선택 화면 캡처 → 담당 선생님께 전송');
    lines.push('4주차: 캡처 기준으로 선물 전달');
    lines.push('');
    lines.push('[링크]');
    lines.push('새친구: ' + getTextById('url-newfriend'));
