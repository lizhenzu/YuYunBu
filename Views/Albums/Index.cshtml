@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@model IEnumerable<YunYunBu2024.Services.AlbumSummary>
@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)
    // 사진 앨범 홈 — 월별 묶음 · 이름 검색(초성) · 연도 · 정렬 · 새 앨범(아래에서 올라오는 창)
    var albums = Model?.ToList() ?? new List<YunYunBu2024.Services.AlbumSummary>();
    var isSignedIn = await AuthService.IsSignedIn(User);
    var now = DateHelper.GetKoreaNow();
    int photoTotal = albums.Sum(a => a.PhotoCount);
    int thisMonth = albums.Where(a => a.CreatedAt.Year == now.Year && a.CreatedAt.Month == now.Month).Count();
    var data = albums.Select(a => new {
        id = a.Id, name = a.Name, desc = a.Description ?? "", by = a.UserName ?? "",
        at = a.CreatedAt.ToString("yyyy-MM-dd"), n = a.PhotoCount,
        cover = a.CoverUrl ?? "", isNew = (now - a.CreatedAt).TotalDays < 7
    });
}
<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>사진 앨범</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* DailyMission4 밝은 흰색 버전 — 색은 직접 지정한다 */
        * { box-sizing: border-box; }
        html, body { margin: 0; }
        body { background: #FFFFFF; color: #374151; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: inherit; text-decoration: none; }
        button, input, textarea { font-family: inherit; }
        .sh { max-width: 1120px; margin: 0 auto; padding: 0 20px; }

        .hdTop { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 0 10px; border-bottom: 1px solid #EEF0F3; font-size: 12px; color: #9CA3AF; }
        .hdTop a { color: #374151; }
        .hdTop a:hover { color: #2F80ED; }
        .hdK { margin-top: 18px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
        .hdT { margin: 6px 0 0; font-size: 24px; font-weight: 800; line-height: 1.35; letter-spacing: -.02em; color: #111827; }
        .hRow { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
        .st { display: flex; gap: 28px; margin-top: 8px; }
        .st div { font-size: 11.5px; color: #9CA3AF; }
        .st b { display: block; margin-top: 2px; font-weight: 300; font-size: 28px; line-height: 1.2; color: #111827; font-variant-numeric: tabular-nums; }
        .st .k b { color: #2F80ED; }
        .newBtn { padding: 11px 20px; border: 0; border-radius: 999px; background: #2F80ED; color: #fff; font-size: 14px; font-weight: 800; cursor: pointer; }
        .newBtn:hover { background: #1F6FDB; }

        /* 찾기 · 연도 · 정렬 — 스크롤해도 위에 붙음 */
        .tools { position: sticky; top: 0; z-index: 40; margin-top: 14px; background: #FFFFFF; border-bottom: 1px solid #EEF0F3; }
        .tools .sh { padding-top: 10px; padding-bottom: 10px; }
        .srch { display: flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: 999px; background: #F4F6F9; }
        .srch:focus-within { box-shadow: 0 0 0 2px #CFE0FA; }
        .srch input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font-size: 15px; color: #111827; }
        .srch input::placeholder { color: #9CA3AF; }
        .srch button { border: 0; background: none; color: #9CA3AF; font-size: 12.5px; font-weight: 700; cursor: pointer; padding: 4px; }
        .srch button:hover { color: #2F80ED; }
        .tRow { display: flex; gap: 8px; align-items: center; justify-content: space-between; margin-top: 8px; }
        .yrs { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
        .yrs::-webkit-scrollbar { display: none; }
        .yrs button, .sort button { flex: none; font-size: 13px; padding: 7px 14px; border: 0; border-radius: 999px; background: #F4F6F9; color: #6B7280; cursor: pointer; white-space: nowrap; }
        .yrs button:hover, .sort button:hover { color: #2F80ED; }
        .yrs button b { font-weight: 700; margin-left: 3px; }
        .yrs button.on { background: #2F80ED; color: #fff; font-weight: 800; }
        .sort { display: flex; flex: none; gap: 4px; }
        .sort button.on { background: #EAF2FD; color: #2B5FA8; font-weight: 800; }

        /* 월별 묶음 · 카드 */
        .grp { margin-top: 22px; }
        .gH { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; }
        .gH b { font-size: 16px; font-weight: 800; color: #111827; }
        .gH span { font-size: 12px; color: #9CA3AF; font-variant-numeric: tabular-nums; }
        .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 12px; }
        @@media (min-width: 720px) { .cards { grid-template-columns: repeat(3, 1fr); gap: 22px 16px; } }
        @@media (min-width: 1020px) { .cards { grid-template-columns: repeat(4, 1fr); } }
        .ac { display: block; color: #111827; }
        .ac .cv { position: relative; aspect-ratio: 4 / 3; background: #F4F6F9; border-radius: 12px; overflow: hidden; }
        .ac .cv img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s; }
        .ac:hover .cv img { transform: scale(1.04); }
        .ac .cv .ph { position: absolute; inset: 0; display: grid; place-items: center; font-size: 12.5px; color: #9CA3AF; text-align: center; padding: 8px; }
        .ac .cv .n { position: absolute; right: 6px; bottom: 6px; font-size: 11px; font-weight: 700; padding: 2px 9px; border-radius: 999px; background: rgba(17,24,39,.75); color: #fff; font-variant-numeric: tabular-nums; }
        .ac .cv .nw { position: absolute; left: 6px; top: 6px; font-size: 10.5px; font-weight: 800; padding: 2px 9px; border-radius: 999px; background: #2F80ED; color: #fff; }
        .ac .t { margin-top: 8px; font-size: 14.5px; font-weight: 700; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: keep-all; transition: color .15s; }
        .ac:hover .t { color: #2F80ED; }
        .ac .t mark { background: #EAF2FD; color: #2B5FA8; border-radius: 4px; }
        .ac .m { margin-top: 2px; font-size: 12px; color: #9CA3AF; font-variant-numeric: tabular-nums; }
        .none { padding: 60px 0; text-align: center; font-size: 14.5px; color: #9CA3AF; }
        .hidden { display: none !important; }
        .ft { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 28px; padding: 14px 0 40px; border-top: 1px solid #EEF0F3; font-size: 11.5px; color: #9CA3AF; }
        .ft a { color: #2F80ED; font-weight: 700; }

        /* 새 앨범 — 아래에서 올라옴 */
        .scrim { position: fixed; inset: 0; z-index: 950; background: rgba(17,24,39,.45); opacity: 0; pointer-events: none; transition: opacity .18s; }
        .sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 960; max-width: 600px; margin: 0 auto; background: #FFFFFF; border-radius: 20px 20px 0 0;
                 padding: 10px 20px calc(20px + env(safe-area-inset-bottom)); transform: translateY(105%); transition: transform .22s ease; }
        .open .scrim { opacity: 1; pointer-events: auto; }
        .open .sheet { transform: none; }
        .grab { width: 40px; height: 4px; border-radius: 999px; background: #E5E7EB; margin: 0 auto 12px; }
        .shH { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
        .shH b { font-size: 20px; font-weight: 800; color: #111827; }
        .shH button { padding: 6px 14px; border: 0; border-radius: 999px; background: #F4F6F9; color: #6B7280; font-size: 12.5px; font-weight: 700; cursor: pointer; }
        .fld label { display: flex; justify-content: space-between; font-size: 12.5px; font-weight: 700; color: #6B7280; margin-bottom: 6px; }
        .fld label span { font-weight: 400; color: #9CA3AF; }
        .fld + .fld { margin-top: 14px; }
        .fld input, .fld textarea { width: 100%; padding: 12px 16px; border: 0; border-radius: 999px; background: #F4F6F9; font-size: 16px; color: #111827; outline: none; }
        .fld textarea { min-height: 90px; resize: vertical; line-height: 1.6; border-radius: 12px; }
        .fld input:focus, .fld textarea:focus { box-shadow: 0 0 0 2px #CFE0FA; }
        .shF { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 16px; }
        .shF small { font-size: 12.5px; color: #9CA3AF; }
        .go { padding: 13px 28px; border: 0; border-radius: 999px; background: #2F80ED; color: #fff; font-size: 15px; font-weight: 800; cursor: pointer; }
        .go:hover { background: #1F6FDB; }
        .go:disabled { opacity: .4; cursor: not-allowed; }
    </style>
</head>
<body>
    <header class="sh">
        <div class="hdTop"><span><a href="/Albums/Branch">‹ 사진 · 영상</a></span><a href="/">@ConstatsCommon.ToHome</a></div>
        <div class="hRow">
            <div>
                <div class="hdK">잠실새내 유년부 입니다.</div>
                <h1 class="hdT">사진 앨범</h1>
                <div class="st">
                    <div class="k">앨범<b>@albums.Count</b></div>
                    <div>사진<b>@photoTotal.ToString("N0")</b></div>
                    <div>@(now.Month)월 새 앨범<b>@thisMonth</b></div>
                </div>
            </div>
            @if (isSignedIn) { <button type="button" class="newBtn" id="newBtn">새 앨범</button> }
        </div>
    </header>

    <div class="tools">
        <div class="sh">
            <label class="srch"><input id="q" type="search" autocomplete="off" placeholder="앨범 이름으로 찾기 (초성도 돼요 · 예: ㅈㅇㅇㅂ)" aria-label="앨범 이름으로 찾기" /><button type="button" id="qX" class="hidden" aria-label="지우기">지우기</button></label>
            <div class="tRow">
                <div class="yrs" id="yrs" aria-label="연도"></div>
                <div class="sort" id="sort" aria-label="정렬">
                    <button type="button" data-s="new" class="on">최신</button><button type="button" data-s="name">이름</button><button type="button" data-s="many">사진 많은</button>
                </div>
            </div>
        </div>
    </div>

    <main class="sh">
        <div id="list"></div>
        <div class="none hidden" id="none"></div>
        <div class="ft"><span>앨범을 누르면 사진을 크게 보고, 받고, 올릴 수 있어요</span><span><a href="/Albums/MyPhotoPick">나의 사진 받기</a> · <a href="/Story/Index">활동 영상</a></span></div>
    </main>

    @if (isSignedIn)
    {
        <div class="scrim" id="scrim"></div>
        <section class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="shT" aria-hidden="true">
            <div class="grab"></div>
            <form method="post" action="/Albums/Create" id="cf" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="shH"><b id="shT">새 앨범 만들기</b><button type="button" id="shX" aria-label="닫기">닫기</button></div>
                <div class="fld"><label for="cName">앨범 이름 <span><span id="cN">0</span> / 200</span></label><input id="cName" name="name" maxlength="200" placeholder="예) 주일예배 (@now.ToString("yyyy년 M월 d일"))" /></div>
                <div class="fld"><label for="cDesc">설명 (선택) <span><span id="cD">0</span> / 1000</span></label><textarea id="cDesc" name="description" maxlength="1000" placeholder="어떤 날, 어떤 모임의 사진인지 짧게 적어 주세요."></textarea></div>
                <div class="shF"><small>만들면 바로 사진을 올릴 수 있어요</small><button type="submit" class="go" id="cGo" disabled>만들기</button></div>
            </form>
        </section>
    }

<script>
(function () {
    const DATA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data));
    const $ = id => document.getElementById(id);
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const CHO = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
    const cho = s => Array.from(s).map(ch => { const c = ch.charCodeAt(0) - 0xAC00; return (c >= 0 && c <= 11171) ? CHO[Math.floor(c / 588)] : ch; }).join('');
    DATA.forEach(a => { a.key = a.name.replace(/\s+/g, ''); a.cho = cho(a.key); a.y = a.at.slice(0, 4); a.ym = a.at.slice(0, 7); });

    let year = 'all', sort = 'new', q = '';
    try { const s = JSON.parse(sessionStorage.getItem('albHome') || '{}'); if (s.year) year = s.year; if (s.sort) sort = s.sort; } catch (e) { }
    const save = () => { try { sessionStorage.setItem('albHome', JSON.stringify({ year, sort })); } catch (e) { } };

    // 연도 버튼
    const years = [...new Set(DATA.map(a => a.y))].sort().reverse();
    if (!years.includes(year) && year !== 'all') year = 'all';
    $('yrs').innerHTML = `<button type="button" data-y="all">전체 <b>${DATA.length}</b></button>` + years.map(y => `<button type="button" data-y="${y}">${y} <b>${DATA.filter(a => a.y === y).length}</b></button>`).join('');
    $('yrs').addEventListener('click', e => { const b = e.target.closest('button[data-y]'); if (!b) return; year = b.dataset.y; save(); draw(); });
    $('sort').addEventListener('click', e => { const b = e.target.closest('button[data-s]'); if (!b) return; sort = b.dataset.s; save(); draw(); });
    $('q').addEventListener('input', () => { q = $('q').value.replace(/\s+/g, ''); draw(); });
    $('qX').addEventListener('click', () => { $('q').value = ''; q = ''; draw(); $('q').focus(); });

    function hl(name) {
        if (!q || /^[ㄱ-ㅎ]+$/.test(q)) return esc(name);
        const i = name.indexOf(q); if (i < 0) return esc(name);
        return esc(name.slice(0, i)) + '<mark>' + esc(name.slice(i, i + q.length)) + '</mark>' + esc(name.slice(i + q.length));
    }
    const md = at => { const [y, m, d] = at.split('-'); return `${+m}월 ${+d}일`; };
    function card(a) {
        return `<a class="ac" href="/Albums/Details/${a.id}">
            <div class="cv">${a.cover ? `<img src="${esc(a.cover)}" alt="" loading="lazy" onerror="this.remove()">` : ''}
                ${a.n === 0 ? '<span class="ph">아직 사진이 없어요</span>' : `<span class="n">${a.n.toLocaleString()}장</span>`}
                ${a.isNew ? '<span class="nw">NEW</span>' : ''}</div>
            <div class="t">${hl(a.name)}</div>
            <div class="m">${sort === 'new' ? md(a.at) : a.at.replace(/-/g, '.')}${a.by ? ' · ' + esc(a.by) : ''}</div></a>`;
    }
    function draw() {
        document.querySelectorAll('#yrs button').forEach(b => b.classList.toggle('on', b.dataset.y === year));
        document.querySelectorAll('#sort button').forEach(b => b.classList.toggle('on', b.dataset.s === sort));
        $('qX').classList.toggle('hidden', !q);
        const choOnly = /^[ㄱ-ㅎ]+$/.test(q);
        let list = DATA.filter(a => (year === 'all' || a.y === year) && (!q || (choOnly ? a.cho.includes(q) : a.key.includes(q))));
        if (sort === 'name') list = list.slice().sort((x, y) => x.name.localeCompare(y.name, 'ko'));
        else if (sort === 'many') list = list.slice().sort((x, y) => y.n - x.n || y.at.localeCompare(x.at));
        let html = '';
        if (sort === 'new' && list.length) {
            // 최신순이면 달별로 묶는다
            const groups = [];
            list.forEach(a => { const g = groups[groups.length - 1]; if (g && g.ym === a.ym) g.items.push(a); else groups.push({ ym: a.ym, items: [a] }); });
            html = groups.map(g => { const [y, m] = g.ym.split('-'); const n = g.items.reduce((s, a) => s + a.n, 0);
                return `<section class="grp"><div class="gH"><b>${y}년 ${+m}월</b><span>앨범 ${g.items.length} · 사진 ${n.toLocaleString()}</span></div><div class="cards">${g.items.map(card).join('')}</div></section>`; }).join('');
        } else if (list.length) {
            html = `<section class="grp"><div class="gH"><b>${sort === 'name' ? '이름순' : '사진 많은 순'}</b><span>앨범 ${list.length}</span></div><div class="cards">${list.map(card).join('')}</div></section>`;
        }
        $('list').innerHTML = html;
        $('none').classList.toggle('hidden', list.length > 0);
        $('none').textContent = DATA.length === 0 ? '아직 앨범이 없어요. 새 앨범으로 첫 앨범을 만들어 보세요.' : '찾는 앨범이 없어요.';
    }
    draw();

    // 새 앨범
    const sheet = $('sheet'); if (!sheet) return;
    const root = document.documentElement, nm = $('cName'), ds = $('cDesc');
    const upd = () => { $('cN').textContent = nm.value.length; $('cD').textContent = ds.value.length; $('cGo').disabled = !nm.value.trim(); };
    nm.addEventListener('input', upd); ds.addEventListener('input', upd);
    const open = () => { root.classList.add('open'); sheet.setAttribute('aria-hidden', 'false'); upd(); setTimeout(() => nm.focus(), 60); };
    const close = () => { root.classList.remove('open'); sheet.setAttribute('aria-hidden', 'true'); $('newBtn').focus(); };
    $('newBtn').addEventListener('click', open);
    $('scrim').addEventListener('click', close);
    $('shX').addEventListener('click', close);
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && root.classList.contains('open')) close(); });
    $('cf').addEventListener('submit', () => { $('cGo').disabled = true; $('cGo').textContent = '만드는 중…'; });
    if (location.hash === '#new') open();
})();
</script>
</body>
</html>
