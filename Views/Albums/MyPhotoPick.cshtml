@using BulletinBoard.Models
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model IEnumerable<BulletinBoard.Models.UserInfoBase2>

@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)
    // 나의 사진 받기 — 아이마다 모아 둔 사진 ZIP (/images/MyPhotoDownLoad/{UserName}.zip) · 이름 찾기(초성)
    var kids = Model?.ToList() ?? new List<UserInfoBase2>();
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>나의 사진 받기</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* DailyMission4 밝은 흰색 버전 — 색은 직접 지정한다 */
        * { box-sizing: border-box; }
        html, body { margin: 0; }
        body { background: #FFFFFF; color: #374151; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: inherit; text-decoration: none; }
        .sh { max-width: 960px; margin: 0 auto; padding: 0 20px; }

        .hdTop { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 0 10px; border-bottom: 1px solid #EEF0F3; font-size: 12px; color: #9CA3AF; }
        .hdTop a { color: #374151; }
        .hdTop a:hover { color: #2F80ED; }
        .hdTop .sep { margin: 0 6px; color: #D1D5DB; }
        .hdK { margin-top: 18px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
        .hdT { margin: 6px 0 0; font-size: 24px; font-weight: 800; line-height: 1.35; letter-spacing: -.02em; color: #111827; }
        .hdS { margin-top: 4px; font-size: 13px; color: #9CA3AF; word-break: keep-all; }
        .st { display: flex; gap: 28px; margin-top: 10px; }
        .st div { font-size: 11.5px; color: #9CA3AF; }
        .st b { display: block; margin-top: 2px; font-weight: 300; font-size: 28px; line-height: 1.2; color: #2F80ED; font-variant-numeric: tabular-nums; }

        .tools { position: sticky; top: 0; z-index: 40; margin-top: 14px; background: #FFFFFF; border-bottom: 1px solid #EEF0F3; }
        .tools .sh { padding-top: 10px; padding-bottom: 10px; }
        .srch { display: flex; align-items: center; gap: 8px; height: 44px; padding: 0 18px; border-radius: 999px; background: #F4F6F9; }
        .srch:focus-within { box-shadow: 0 0 0 2px #CFE0FA; }
        .srch input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font-family: inherit; font-size: 15px; color: #111827; }
        .srch input::placeholder { color: #9CA3AF; }

        .guide { margin-top: 16px; padding: 12px 16px; border-radius: 12px; background: #EAF2FD; font-size: 13px; line-height: 1.75; color: #2B5FA8; word-break: keep-all; }
        .guide b { font-weight: 800; }

        .kl { display: grid; grid-template-columns: 1fr; margin-top: 8px; }
        @@media (min-width: 720px) { .kl { grid-template-columns: 1fr 1fr; column-gap: 28px; } }
        .k { display: flex; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid #EEF0F3; }
        .k .ph { flex: none; width: 52px; height: 52px; border-radius: 50%; background: #EAF2FD; overflow: hidden; }
        .k .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .k .no { flex: none; width: 22px; font-size: 12px; color: #8DB5F3; font-variant-numeric: tabular-nums; }
        .k .nm { flex: 1; min-width: 0; font-size: 16px; font-weight: 700; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .k .nm small { display: block; margin-top: 1px; font-size: 11.5px; font-weight: 400; color: #9CA3AF; }
        .k a.dl { flex: none; padding: 9px 16px; border-radius: 999px; background: #2F80ED; color: #fff; font-size: 13px; font-weight: 800; white-space: nowrap; }
        .k a.dl:hover { background: #1F6FDB; }
        .none { padding: 40px 0; text-align: center; font-size: 14px; color: #9CA3AF; }
        .hidden { display: none !important; }
        .ft { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 24px; padding: 14px 0 40px; border-top: 1px solid #EEF0F3; font-size: 11.5px; color: #9CA3AF; }
        .ft a { color: #2F80ED; font-weight: 700; }
    </style>
</head>
<body>
    <header class="sh">
        <div class="hdTop"><span><a href="/Albums/Branch">‹ 사진 · 영상</a></span><a href="/">@ConstatsCommon.ToHome</a></div>
        <div class="hdK">잠실새내 유년부 입니다.</div>
        <h1 class="hdT">나의 사진 받기</h1>
        <div class="hdS">우리 아이 이름을 찾아 사진 묶음(ZIP)을 한 번에 내려받아요.</div>
        <div class="st"><div>아이<b>@kids.Count</b></div></div>
    </header>

    <div class="tools">
        <div class="sh">
            <label class="srch"><input id="q" type="search" autocomplete="off" placeholder="아이 이름 찾기 (초성도 돼요 · 예: ㅊㄹ)" aria-label="아이 이름 찾기" /></label>
        </div>
    </div>

    <main class="sh">
        <div class="guide"><b>받는 방법</b> · 이름 옆 <b>사진 받기</b>를 누르면 사진이 ZIP 파일로 저장돼요. 사진이 많으면 저장이 시작되기까지 조금 걸릴 수 있어요.</div>

        <section class="kl" id="kl">
            @{ int no = 0; }
            @foreach (var item in kids)
            {
                no++;
                var name = string.IsNullOrWhiteSpace(item.FullName) ? item.UserName : item.FullName;
                <article class="k" data-name="@name">
                    <span class="no">@no</span>
                    <span class="ph"><img src="/images/profile/@(item.UserId).png" onerror="this.onerror=null;this.src='/images/icon/people/people_01.webp';" loading="lazy" decoding="async" alt="" /></span>
                    <span class="nm">@name<small>캠프 · 찬양 시간 사진</small></span>
                    <a class="dl" href="/images/MyPhotoDownLoad/@(item.UserName).zip" download="@(item.UserName).zip" aria-label="@name 사진 받기">사진 받기</a>
                </article>
            }
        </section>
        <div class="none @(kids.Count == 0 ? "" : "hidden")" id="none">@(kids.Count == 0 ? "받을 수 있는 사진이 아직 없어요." : "찾는 아이가 없어요.")</div>

        <div class="ft"><span>© 유년부 · 사진 받기</span><a href="/Albums">앨범 둘러보기</a></div>
    </main>

<script>
(function () {
    const CHO = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
    const cho = s => Array.from(s).map(ch => { const c = ch.charCodeAt(0) - 0xAC00; return (c >= 0 && c <= 11171) ? CHO[Math.floor(c / 588)] : ch; }).join('');
    const rows = Array.from(document.querySelectorAll('.k'));
    rows.forEach(r => r.dataset.cho = cho(r.dataset.name || ''));
    const none = document.getElementById('none');
    document.getElementById('q').addEventListener('input', e => {
        const t = e.target.value.replace(/\s+/g, '');
        const choOnly = /^[ㄱ-ㅎ]+$/.test(t);
        let n = 0;
        rows.forEach(r => { const ok = !t || (choOnly ? r.dataset.cho.includes(t) : (r.dataset.name || '').includes(t)); r.classList.toggle('hidden', !ok); if (ok) n++; });
        if (rows.length) none.classList.toggle('hidden', n > 0);
    });
})();
</script>
<script src="/js/GlobalCookie.js"></script>
</body>
</html>
