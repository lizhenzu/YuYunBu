@using BulletinBoard.Models
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model IEnumerable<BulletinBoard.Models.UserInfoBase2>

@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)
    // 나의 사진 받기 — 아이마다 모아 둔 사진 ZIP (/images/MyPhotoDownLoad/{UserName}.zip) · 이름 찾기(초성)
    var kids = Model?.ToList() ?? new List<UserInfoBase2>();
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>나의 사진 받기</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&family=Inter:wght@200;400;500;600&family=Gothic+A1:wght@400;600&display=swap" rel="stylesheet">
    <link href="~/css/board-bone.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .sh { max-width: 960px; }
        .st { display: flex; gap: 26px; margin-top: 14px; }
        .st div { font-size: 10.5px; font-weight: 600; letter-spacing: .12em; color: var(--headdim); }
        .st b { display: block; margin-top: 2px; font-family: "Inter", sans-serif; font-weight: 200; font-size: 28px; letter-spacing: 0; color: var(--headk); font-variant-numeric: tabular-nums; }

        .tools { position: sticky; top: 0; z-index: 40; background: var(--card); border-bottom: 1px solid var(--rule); }
        .tools .sh { padding-top: 10px; padding-bottom: 10px; }
        .srch { display: flex; align-items: center; gap: 8px; height: 44px; padding: 0 12px; border: 1px solid var(--rule); background: var(--bg); }
        .srch:focus-within { border-color: var(--tx); }
        .srch span { color: var(--dim); }
        .srch input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font-family: inherit; font-size: 16px; color: var(--tx); }

        .guide { margin-top: 18px; padding: 12px 14px; background: var(--mark); font-size: 13.5px; line-height: 1.7; color: var(--dim2); }
        .guide b { color: var(--tx); }

        .kl { display: grid; grid-template-columns: 1fr; margin-top: 10px; }
        @@media (min-width: 720px) { .kl { grid-template-columns: 1fr 1fr; column-gap: 28px; } }
        .k { display: flex; align-items: center; gap: 14px; padding: 14px 2px; border-bottom: 1px solid var(--line); }
        .k .ph { flex: none; width: 56px; height: 56px; background: var(--mark); overflow: hidden; }
        .k .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .k .no { flex: none; width: 22px; font-family: "Inter", sans-serif; font-size: 12px; color: var(--dim); }
        .k .nm { flex: 1; min-width: 0; font-family: "Noto Serif KR", serif; font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .k .nm small { display: block; font-family: "Gothic A1", sans-serif; font-size: 12px; color: var(--dim); margin-top: 1px; }
        .k a.dl { flex: none; height: 40px; padding: 0 14px; display: inline-flex; align-items: center; gap: 6px; background: var(--tx); color: var(--bg); font-size: 13.5px; font-weight: 600; }
        .k a.dl:hover { background: var(--acc); color: #fff; }
        .none { padding: 40px 0; text-align: center; font-size: 14px; color: var(--dim); }
        .hidden { display: none !important; }
    </style>
</head>
<body>
    <header class="hd">
        <div class="sh">
            <div class="hdTop"><span><a href="/Albums/Branch">사진 · 영상</a><span class="sep">›</span>나의 사진 받기</span><a href="/">@ConstatsCommon.ToHome</a></div>
            <div class="hdK">MY PHOTOS</div>
            <h1 class="hdT">나의 사진 받기</h1>
            <div class="hdS">우리 아이 이름을 찾아 사진 묶음(ZIP)을 한 번에 내려받아요.</div>
            <div class="st"><div>아이<b>@kids.Count</b></div></div>
        </div>
    </header>

    <div class="tools">
        <div class="sh">
            <label class="srch"><span aria-hidden="true">⌕</span><input id="q" type="search" autocomplete="off" placeholder="아이 이름 찾기 (초성도 돼요 · 예: ㅊㄹ)" aria-label="아이 이름 찾기" /></label>
        </div>
    </div>

    <main class="sh">
        <div class="guide"><b>받는 방법</b> · 이름 옆 <b>사진 받기</b>를 누르면 사진이 ZIP 파일로 저장돼요. 사진이 많으면 저장이 시작되기까지 조금 걸릴 수 있어요.</div>

        <section class="kl" id="kl">
            @{ int no = 0; }
            @foreach (var item in kids)
            {
                no++;
                var name = string.IsNullOrWhiteSpace(item.FullName) ? item.UserName : item.FullName;
                <article class="k" data-name="@name">
                    <span class="no">@no</span>
                    <span class="ph"><img src="/images/profile/@(item.UserId).png" onerror="this.onerror=null;this.src='/images/icon/people/people_01.webp';" loading="lazy" decoding="async" alt="" /></span>
                    <span class="nm">@name<small>캠프 · 찬양 시간 사진</small></span>
                    <a class="dl" href="/images/MyPhotoDownLoad/@(item.UserName).zip" download="@(item.UserName).zip" aria-label="@name 사진 받기">⬇ 사진 받기</a>
                </article>
            }
        </section>
        <div class="none @(kids.Count == 0 ? "" : "hidden")" id="none">@(kids.Count == 0 ? "받을 수 있는 사진이 아직 없어요." : "찾는 아이가 없어요.")</div>

        <div class="ft"><span>© 유년부 · 사진 받기</span><a href="/Albums">앨범 둘러보기 →</a></div>
    </main>

<script>
(function () {
    const CHO = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
    const cho = s => Array.from(s).map(ch => { const c = ch.charCodeAt(0) - 0xAC00; return (c >= 0 && c <= 11171) ? CHO[Math.floor(c / 588)] : ch; }).join('');
    const rows = Array.from(document.querySelectorAll('.k'));
    rows.forEach(r => r.dataset.cho = cho(r.dataset.name || ''));
    const none = document.getElementById('none');
    document.getElementById('q').addEventListener('input', e => {
        const t = e.target.value.replace(/\s+/g, '');
        const choOnly = /^[ㄱ-ㅎ]+$/.test(t);
        let n = 0;
        rows.forEach(r => { const ok = !t || (choOnly ? r.dataset.cho.includes(t) : (r.dataset.name || '').includes(t)); r.classList.toggle('hidden', !ok); if (ok) n++; });
        if (rows.length) none.classList.toggle('hidden', n > 0);
    });
})();
</script>
<script src="/js/GlobalCookie.js"></script>
</body>
</html>
