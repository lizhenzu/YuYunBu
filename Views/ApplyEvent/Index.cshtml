@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@model BulletinBoard.Models.DeptRoleUserAssoc
@inject IAuthService AuthService

@{
    Layout = null;
 
    var eventMater = ViewData["EventMater"] as EventMater;
    bool isEventMaterEmpty = eventMater == null || string.IsNullOrEmpty(eventMater.ToString());
}


<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personal Information Management</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #fff;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .container {
            /*   background-color: #fff;*/
            padding: 20px;
            border-radius: 8px;
            /*   box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);*/
            width: 400px;
            text-align: center;
        }

        h1 {
            color: #333;
            margin-bottom: 20px;
        }

        .profile-pic {
            width: 170px;
            height: 170px;
            border-radius: 50%;
            margin-bottom: 10px;
            object-fit: cover;
        }

        .section-title {
            font-size: 18px;
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .buttons {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

            .buttons button {
                padding: 10px 20px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                margin: 5px;
                font-size: 16px;
                background-color: #4CAF50;
                color: white;
            }
    </style>
</head>
<body>

    <div class="container">

        @if (isEventMaterEmpty)
        {
            <h2>진행중인 행사가 없습니다.</h2>
            <div class="buttons">
                <button type="button" onclick="window.location.href='/';">Home</button>
            </div>

        }else
        {
            <h2>행사 접수가 진행중 입니다.</h2>
            <h3>행사명 : @eventMater.EventTitle </h3>

            <h4>이 행사에 참여 하시겠습니까?</h4>
            <div class="buttons" style="flex-wrap: wrap;">
                <button type="button" style="background-color:#00C853;" onclick="window.location.href='/HumanResource/ChangeUserDeptInfoMain?UserId=';">예</button>
                <button type="button" style="background-color:#00C853;" onclick="window.location.href='/HumanResource/ManageUserInfo?UserId=';">아니오</button>
            </div>

        }
    </div>
    
</body>
</html>
