@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@using BulletinBoard.ViewModels.Attendance
@model LongAbsentListVM

@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)
    // 출석부 "돌봄" — 연락할 아이 목록 (오래 빠진 순 · 보호자 전화)
    ViewData["AttTab"] = "care";
    ViewData["CareCount"] = Model.Students.Count;

    var filters = new[] { (21, "3주 이상"), (42, "6주 이상"), (90, "3개월 이상"), (180, "6개월 이상") };
    string FilterName(int d) => filters.FirstOrDefault(f => f.Item1 == d).Item2 ?? $"{d}일 이상";

    // 기록이 아예 없는 아이 → 가장 위, 그다음 오래 빠진 순
    var list = Model.Students
        .Where(s => s.User != null)
        .OrderByDescending(s => s.LastAttendDate == null ? int.MaxValue : s.DaysAbsent)
        .ThenBy(s => s.User.FullName)
        .ToList();

    string Tel(string? p) => new string((p ?? "").Where(char.IsDigit).ToArray());
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>출석부 · 돌봄</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&family=Inter:wght@200;400;500;600&family=Gothic+A1:wght@400;600&display=swap" rel="stylesheet">
    <link href="~/css/board-bone.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .hd .sh { padding-top: 16px; padding-bottom: 20px; }
        .prog { display: flex; align-items: baseline; gap: 10px; margin-top: 10px; font-size: 13px; color: var(--headdim); }
        .prog b { font-family: "Inter", sans-serif; font-weight: 200; font-size: 36px; line-height: 1; color: var(--headtx); }

        .seg { display: flex; margin-top: 16px; border: 1px solid var(--rule); }
        .seg a { flex: 1; text-align: center; font-size: 13px; padding: 10px 2px; background: var(--card); color: var(--dim2); }
        .seg a + a { border-left: 1px solid var(--rule); }
        .seg a.on { background: var(--tx); color: var(--bg); font-weight: 600; }

        .ca { display: flex; align-items: center; gap: 14px; padding: 14px 2px; border-bottom: 1px solid var(--line); }
        .wk { flex: none; width: 52px; text-align: center; }
        .wk b { display: block; font-family: "Inter", sans-serif; font-weight: 200; font-size: 30px; line-height: 1; color: var(--danger); font-variant-numeric: tabular-nums; }
        .wk small { font-size: 11px; color: var(--dim); }
        .wk.never b { font-family: "Gothic A1", sans-serif; font-size: 13px; font-weight: 600; line-height: 1.3; }
        .caTx { flex: 1; min-width: 0; }
        .caN { font-size: 16px; font-weight: 600; }
        .caN small { font-weight: 400; font-size: 12.5px; color: var(--dim); margin-left: 6px; }
        .caM { margin-top: 3px; font-size: 12.5px; color: var(--dim); font-variant-numeric: tabular-nums; }
        .caMemo { margin-top: 6px; padding: 7px 10px; background: var(--mark); font-size: 12.5px; line-height: 1.6; color: var(--dim2); }
        .call { flex: none; display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 14px; background: var(--tx); color: var(--bg); font-size: 14px; }
        .call:hover { background: var(--acc); color: #fff; }
        .call.off { background: none; color: var(--dim); border: 1px dashed var(--rule); font-size: 12px; }
        .good { padding: 60px 0; text-align: center; }
        .good b { display: block; font-family: "Noto Serif KR", serif; font-weight: 400; font-size: 20px; }
        .good span { display: block; margin-top: 6px; font-size: 13.5px; color: var(--dim); }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link href="~/css/att-bright.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <header class="hd">
        <div class="sh">
            <div class="hdTop"><a href="/Attendance/Index">출석부</a><a href="/">@ConstatsCommon.ToHome</a></div>
            <div class="hdK">CARE</div>
            <h1 class="hdT">연락할 아이</h1>
            <div class="prog"><b>@list.Count</b><span>명 · @FilterName(Model.AbsentDays) 결석</span></div>
        </div>
    </header>

    <main class="sh">
        <nav class="seg" aria-label="결석 기준">
            @foreach (var f in filters)
            {
                <a href="?absentDays=@f.Item1" class="@(Model.AbsentDays == f.Item1 ? "on" : "")">@f.Item2</a>
            }
        </nav>

        @if (list.Count == 0)
        {
            <div class="good"><b>연락할 아이가 없어요</b><span>@FilterName(Model.AbsentDays) 빠진 아이가 없습니다.</span></div>
        }
        else
        {
            <section class="sec" style="margin-top:20px">
                <div class="secH">
                    <div><div class="secK">LONGEST FIRST</div><div class="secT">오래 빠진 순</div></div>
                    <span class="secN">큰 숫자 = 결석 주</span>
                </div>

                @foreach (var s in list)
                {
                    var u = s.User;
                    bool never = s.LastAttendDate == null;
                    int weeks = never ? 0 : Math.Max(1, s.DaysAbsent / 7);
                    var phone = !string.IsNullOrWhiteSpace(u.PhoneNumber) ? u.PhoneNumber : u.PhoneNumber2;
                    var tel = Tel(phone);

                    <div class="ca">
                        <div class="wk @(never ? "never" : "")">
                            @if (never) { <b>기록<br />없음</b> }
                            else { <b>@weeks</b><small>주</small> }
                        </div>
                        <div class="caTx">
                            <div class="caN">@u.FullName@if (u.ClassYear > 0) {<small>@($"{u.ClassYear}학년 {u.ClassBan}반")</small>}</div>
                            <div class="caM">
                                마지막 출석 @(never ? "없음" : s.LastAttendDate!.Value.ToString("yyyy.M.d"))
                                · 올해 @s.AttendCount/@s.WeeksCount 회 (@s.AttendRate%)
                            </div>
                            @if (!string.IsNullOrWhiteSpace(s.Memo))
                            {
                                <div class="caMemo">@s.Memo</div>
                            }
                        </div>
                        @if (tel.Length >= 9)
                        {
                            <a class="call" href="tel:@tel" aria-label="@u.FullName 보호자에게 전화">전화</a>
                        }
                        else
                        {
                            <span class="call off">번호 없음</span>
                        }
                    </div>
                }
            </section>
        }

        <div class="ft"><span>올해 @Model.WeeksCount 주일 기준 · 전화는 등록된 보호자 번호로 걸려요</span></div>
    </main>

    @await Html.PartialAsync("_AttTabs")
</body>
</html>
