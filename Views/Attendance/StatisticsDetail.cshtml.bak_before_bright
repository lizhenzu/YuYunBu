@model BulletinBoard.ViewModels.Attendance.AttendanceMonthlyStatsVM
@using System.Text.Json

@{
    Layout = null;

    var title = $"출석 통계 상세 · {Model.Year}년 {Model.Month}월";

    // ✅ 이동 URL
    var homeUrl = "/";
    var backUrl = $"/Attendance/Statistics?year={Model.Year}&month={Model.Month}";
    var checkHomeUrl = "/Attendance/Check"; // 기본 이동 (마지막 반 있으면 JS가 대체)

    // ✅ 차트 데이터
    var barLabels = (Model.ClassMonthlyTotals ?? new()).Select(x => x.ClassName).ToList();
    var barValues = (Model.ClassMonthlyTotals ?? new()).Select(x => x.TotalCount).ToList();

    var lineLabels = (Model.WeeklyTotals ?? new()).Select(x => x.AttendDate.ToString("M/d")).ToList();
    var lineValues = (Model.WeeklyTotals ?? new()).Select(x => x.TotalCount).ToList();

    // ✅ 표 데이터
    var tableRows = (Model.ClassMonthlyTotals ?? new())
        .OrderByDescending(x => x.TotalCount)
        .ThenByDescending(x => x.Ratio)
        .ToList();

    // ✅ JSON
    string jsonBarLabels = JsonSerializer.Serialize(barLabels);
    string jsonBarValues = JsonSerializer.Serialize(barValues);
    string jsonLineLabels = JsonSerializer.Serialize(lineLabels);
    string jsonLineValues = JsonSerializer.Serialize(lineValues);

    // ✅ 가로 막대 차트: 반 개수에 따라 세로 높이 자동 확장
    var barBoxHeight = Math.Max(320, 80 + (barLabels.Count * 26));
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <style>
        :root{
            --bg:#f6fbf8;
            --card:#ffffff;
            --ink:#123029;
            --muted:#5a6b66;
            --line:#dfeee8;
            --primary:#1F6F5B;
            --shadow:0 10px 30px rgba(18,48,41,.08);
            --radius:18px;
        }
        *{ box-sizing:border-box; }
        body{
            margin:0;
            font-family: system-ui,-apple-system,Segoe UI,Roboto,"Noto Sans KR",Arial,sans-serif;
            background:var(--bg);
            color:var(--ink);
        }
        .wrap{
            max-width:1100px;
            margin:0 auto;
            padding:16px 14px 64px;
        }

        /* Header */
        .page-head{
            display:flex;
            align-items:flex-end;
            justify-content:space-between;
            flex-wrap:wrap;
            gap:12px;
            margin-bottom:12px;
        }
        .page-title{
            margin:0;
            font-size:22px;
            letter-spacing:-0.3px;
        }
        .page-sub{
            margin-top:6px;
            color:var(--muted);
            font-size:13px;
            font-weight:700;
        }

        .btns{
            display:flex;
            gap:8px;
            flex-wrap:wrap;
            justify-content:flex-end;
        }
        .btn{
            display:inline-flex;
            align-items:center;
            gap:8px;
            padding:10px 12px;
            border-radius:14px;
            text-decoration:none;
            font-weight:900;
            border:1px solid var(--line);
            background:#fff;
            color:var(--primary);
            box-shadow:var(--shadow);
            transition: transform .12s ease, box-shadow .12s ease;
        }
        .btn:hover{
            transform: translateY(-1px);
            box-shadow: 0 14px 34px rgba(18,48,41,.12);
        }
        .btn.primary{
            background:var(--primary);
            color:#fff;
            border-color: rgba(31,111,91,.25);
        }

        /* Section */
        .section{ margin-top:16px; }
        .section-title{
            margin:0 0 10px;
            font-size:16px;
            letter-spacing:-0.2px;
            display:flex;
            align-items:center;
            gap:8px;
        }

        .card{
            background:var(--card);
            border:1px solid var(--line);
            border-radius:var(--radius);
            box-shadow:var(--shadow);
        }
        .card-pad{ padding:16px; }

        /* ✅ 차트 무한증가 방지: 부모 박스 높이 고정 */
        .chart-scroll{
            overflow-x:auto;
            overflow-y:hidden;
            padding-bottom:6px;
        }
        .bar-chart-box{
            position:relative;
            height:@(barBoxHeight)px;
            width:100%;
        }
        .line-chart-box{
            position:relative;
            height:260px;
            width:100%;
            overflow:hidden;
        }
        .bar-chart-box canvas,
        .line-chart-box canvas{
            display:block;
            width:100% !important;
            height:100% !important;
        }

        /* Table */
        .table{
            width:100%;
            border-collapse:collapse;
        }
        .table th, .table td{
            padding:10px 10px;
            border-bottom:1px solid var(--line);
            font-size:13px;
            text-align:left;
        }
        .table th{
            background:#f4fbf7;
            color:var(--muted);
            font-weight:900;
        }
        .right{ text-align:right; }

        .badge{
            display:inline-flex;
            align-items:center;
            justify-content:center;
            min-width:28px;
            padding:4px 8px;
            border-radius:999px;
            background:rgba(31,111,91,.10);
            border:1px solid rgba(31,111,91,.18);
            color:var(--primary);
            font-weight:900;
            font-size:12px;
        }
        .muted{ color:var(--muted); }

        .click-row{ cursor:pointer; transition: background-color .12s ease; }
        .click-row:hover{ background: rgba(31,111,91,.08); }

        .hint{
            margin-top:10px;
            font-size:12px;
            font-weight:800;
            color:var(--muted);
        }

        .last-class-pill{
            display:inline-flex;
            align-items:center;
            gap:8px;
            margin-top:8px;
            padding:8px 10px;
            border-radius:999px;
            background:#f5fbf8;
            border:1px solid var(--line);
            font-weight:900;
            font-size:12px;
            color:var(--muted);
        }

        @@media (max-width:480px){
            .page-title{ font-size:20px; }
            .btn{ padding:9px 11px; }
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
<div class="wrap">

    <header class="page-head">
        <div>
            <h1 class="page-title">@title</h1>
            <div class="page-sub">가로 막대(반별) + 라인(주별 전체) + 표(클릭 → 체크)</div>
            <div id="lastClassPill" class="last-class-pill" style="display:none;"></div>
        </div>

        <div class="btns">
            <a class="btn" href="@homeUrl">🏠 홈으로</a>
            <a class="btn" href="@backUrl">← 요약으로</a>
            <!-- ✅ JS가 클릭 이벤트로 마지막 반 체크로 이동 -->
            <a class="btn primary" id="btnGoCheck" href="@checkHomeUrl">✅ 출석 체크로</a>
        </div>
    </header>

    <section class="section">
        <h2 class="section-title">📊 그래프</h2>

        <div class="card card-pad">
            <div style="font-weight:900; margin-bottom:10px;">반별 출석 합계 (가로 막대)</div>
            <div class="chart-scroll">
                <div class="bar-chart-box">
                    <canvas id="barChart"></canvas>
                </div>
            </div>
            <div class="hint">* 반이 많아도 보기 편하도록 “가로 막대”로 표시합니다.</div>
        </div>

        <div class="card card-pad" style="margin-top:14px;">
            <div style="font-weight:900; margin-bottom:10px;">주별 전체 출석 (라인)</div>
            <div class="line-chart-box">
                <canvas id="lineChart"></canvas>
            </div>
            <div class="hint">* 해당 월의 일요일(주일)만 표시합니다.</div>
        </div>
    </section>

    <section class="section">
        <h2 class="section-title">📋 반별 출석 합계 (반 클릭 → 체크 화면)</h2>

        <div class="card card-pad">
            @if (tableRows.Count == 0)
            {
                <div class="muted" style="font-weight:800;">표시할 데이터가 없습니다.</div>
            }
            else
            {
                <table class="table" aria-label="반별 출석 합계 테이블">
                    <thead>
                    <tr>
                        <th style="width:70px;">순위</th>
                        <th>학년/반</th>
                        <th class="right" style="width:120px;">출석</th>
                        <th class="right" style="width:120px;">비율</th>
                    </tr>
                    </thead>
                    <tbody>
                    @{
                        int rank = 0;
                        foreach (var r in tableRows)
                        {
                            rank++;
                            <tr class="click-row"
                                data-class-year="@r.ClassYear"
                                data-class-ban="@r.ClassBan"
                                data-class-name="@r.ClassName"
                                onclick="goCheckFromRow(this)">
                                <td><span class="badge">@rank</span></td>
                                        <td style="font-weight:900;; white-space: nowrap;">@r.ClassName</td>
                                <td class="right" style="font-weight:900;">@r.TotalCount</td>
                                <td class="right" style="font-weight:900;">@($"{r.Ratio}%")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>

                <div class="hint">* 행을 클릭하면 해당 반의 출석 체크 화면으로 이동합니다.</div>
            }
        </div>
    </section>

</div>

<script>
    const STORAGE_KEY = "AttendanceLastClass";

    function saveLastClass(classYear, classBan, className){
        const payload = {
            classYear: Number(classYear),
            classBan: Number(classBan),
            className: String(className || "")
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
    }

    function readLastClass(){
        try{
            const raw = localStorage.getItem(STORAGE_KEY);
            if(!raw) return null;
            const obj = JSON.parse(raw);
            if(!obj || !obj.classYear || !obj.classBan) return null;
            return obj;
        }catch(e){
            return null;
        }
    }

    function buildCheckUrl(classYear, classBan){
        return `/Attendance/Check?classYear=${encodeURIComponent(classYear)}&classBan=${encodeURIComponent(classBan)}`;
    }

    // ✅ 표 행 클릭: 저장 + 이동
    function goCheckFromRow(tr){
        const y = tr.getAttribute("data-class-year");
        const b = tr.getAttribute("data-class-ban");
        const name = tr.getAttribute("data-class-name") || "";
        saveLastClass(y, b, name);
        location.href = buildCheckUrl(y, b);
    }

    // ✅ 상단 "출석 체크로" 버튼: 마지막 반 있으면 그쪽으로 이동
    (function initGoCheckButton(){
        const btn = document.getElementById("btnGoCheck");
        if(!btn) return;

        btn.addEventListener("click", function(e){
            const last = readLastClass();
            if(last){
                e.preventDefault();
                location.href = buildCheckUrl(last.classYear, last.classBan);
            }
            // 없으면 href(@checkHomeUrl)로 기본 이동
        });

        // ✅ 마지막 선택 반 표시(선택 UX)
        const pill = document.getElementById("lastClassPill");
        const last = readLastClass();
        if(pill && last){
            pill.style.display = "inline-flex";
            const text = last.className ? last.className : `${last.classYear}학년 ${last.classBan}반`;
            pill.textContent = `최근 선택 반: ${text}`;
        }
    })();

    // 차트 데이터
    const barLabels  = @Html.Raw(jsonBarLabels);
    const barValues  = @Html.Raw(jsonBarValues);
    const lineLabels = @Html.Raw(jsonLineLabels);
    const lineValues = @Html.Raw(jsonLineValues);

    // ✅ 가로 막대
    new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: {
            labels: barLabels,
            datasets: [{
                label: '출석 합계',
                data: barValues
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            animation: false,
            resizeDelay: 200,
            plugins: { legend: { display: false } },
            scales: {
                x: { beginAtZero: true, ticks: { precision: 0 } },
                y: { ticks: { autoSkip: false } }
            }
        }
    });

    // ✅ 라인
    new Chart(document.getElementById('lineChart'), {
        type: 'line',
        data: {
            labels: lineLabels,
            datasets: [{
                label: '주별 전체 출석',
                data: lineValues,
                tension: 0.25
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: false,
            resizeDelay: 200,
            plugins: { legend: { display: true } },
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 } }
            }
        }
    });
</script>

</body>
</html>
