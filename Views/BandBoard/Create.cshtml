@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)
    var UserFullName   = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserFullName.ToString()) as string;
    string boardTableName = ViewBag.BoardTableName as string ?? "BandPosts";
    string boardName      = ViewBag.BoardName      as string ?? "게시판";

    bool isLost       = boardTableName.Contains("LostAndFound", StringComparison.OrdinalIgnoreCase);
    string placeholder= isLost
        ? "분실물 정보를 적어 주세요. 습득 장소, 물품 특징, 연락처 등을 함께 남기면 더 빨리 찾을 수 있어요."
        : "내용을 입력하세요.";
    string listUrl = $"/BandBoard/Index?boardTableName={boardTableName}&boardName={Uri.EscapeDataString(boardName)}";
}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>새 @boardName 등록</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
<style>
/* DailyMission4 밝은 흰색 버전 — 색은 직접 지정한다 */
* { box-sizing: border-box; }
html, body { margin: 0; }
body { background: #FFFFFF; color: #374151; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
a { color: inherit; text-decoration: none; }
.sh { max-width: 720px; margin: 0 auto; padding: 0 20px; }

.hdTop { padding: 12px 0 10px; border-bottom: 1px solid #EEF0F3; font-size: 12px; color: #9CA3AF; }
.hdTop a { color: #374151; }
.hdTop a:hover { color: #2F80ED; }
.hdTop .sep { margin: 0 6px; color: #D1D5DB; }
.hdK { margin-top: 18px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
.hdT { margin: 6px 0 0; font-size: 24px; font-weight: 800; line-height: 1.35; letter-spacing: -.02em; color: #111827; }

/* 폼 */
.fm { margin-top: 8px; }
.fRow { margin-top: 18px; }
.fLbl { display: block; font-size: 12.5px; font-weight: 700; color: #6B7280; }
.fIn { display: block; width: 100%; margin-top: 6px; font-family: inherit; font-size: 15px; line-height: 1.7; padding: 12px 16px; border: 0; border-radius: 999px; background: #F4F6F9; color: #111827; outline: none; }
.fIn::placeholder { color: #9CA3AF; }
.fIn:focus { box-shadow: 0 0 0 2px #CFE0FA; }
.fIn[readonly] { color: #6B7280; }
textarea.fIn { min-height: 200px; border-radius: 12px; resize: vertical; }

/* 사진 올리기 */
.upload-area { position: relative; margin-top: 6px; padding: 24px 16px; text-align: center; border-radius: 12px; background: #F4F6F9; cursor: pointer; transition: background .15s; }
.upload-area:hover, .upload-area.drag { background: #EAF2FD; }
.upload-area input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
.upload-text { font-size: 13.5px; color: #6B7280; }
.upload-text b { font-weight: 800; color: #2F80ED; }
.preview-row { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
.preview-thumb { width: 76px; height: 76px; object-fit: cover; border-radius: 12px; background: #F4F6F9; display: none; }

/* 버튼 */
.fAct { display: flex; gap: 8px; margin-top: 24px; }
.nbtn { flex: 1; font-family: inherit; font-size: 14px; font-weight: 700; text-align: center; padding: 13px 14px; border: 0; border-radius: 999px; background: #F4F6F9; color: #6B7280; cursor: pointer; }
.nbtn:hover { color: #2F80ED; }
.nbtn.pri { flex: 2; background: #2F80ED; color: #fff; font-weight: 800; }
.nbtn.pri:hover { background: #1F6FDB; color: #fff; }

.ft { margin-top: 24px; padding: 14px 0 40px; border-top: 1px solid #EEF0F3; font-size: 11.5px; color: #9CA3AF; }
</style>
</head>
<body>

<header class="hd">
    <div class="sh">
        <div class="hdTop">
            <span><a href="/">← @ConstatsCommon.ToHome</a><span class="sep">·</span><a href="@listUrl">@boardName</a></span>
        </div>
        <div class="hdK">잠실새내 유년부 입니다.</div>
        <h1 class="hdT">@(isLost ? "분실물 등록 / 습득 신고" : $"새 {boardName} 등록")</h1>
    </div>
</header>

<main class="sh">
    <form asp-action="Create" asp-controller="BandBoard"
          method="post" enctype="multipart/form-data" id="writeForm" class="fm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="boardTableName" value="@boardTableName" />
        <input type="hidden" name="boardName"      value="@boardName" />

        <div class="fRow">
            <label class="fLbl" for="content">내용</label>
            <textarea id="content" name="content" class="fIn" rows="6" placeholder="@placeholder"></textarea>
        </div>

        <div class="fRow">
            <label class="fLbl" for="writerName">작성자</label>
            @if (!string.IsNullOrWhiteSpace(UserFullName))
            {
                <input type="text" id="writerName" name="writerName" class="fIn" value="@UserFullName" readonly />
            }
            else
            {
                <input type="text" id="writerName" name="writerName" class="fIn" placeholder="이름 (선택)" />
            }
        </div>

        <div class="fRow">
            <span class="fLbl">사진</span>
            <div class="upload-area" id="uploadArea">
                <input type="file" name="imageFiles" id="imageFiles" accept="image/*" multiple />
                <div class="upload-text"><b>사진 첨부</b> · 여러 장 가능</div>
            </div>
            <div class="preview-row" id="previewRow"></div>
        </div>

        <div class="fAct">
            <a class="nbtn" href="@listUrl">취소</a>
            <button type="submit" class="nbtn pri">등록하기</button>
        </div>
    </form>

    <div class="ft"><span>© 유년부 · @boardName</span></div>
</main>

<script>
(function() {
    const input = document.getElementById('imageFiles');
    const row   = document.getElementById('previewRow');
    const area  = document.getElementById('uploadArea');

    area.addEventListener('dragover',  e => { e.preventDefault(); area.classList.add('drag'); });
    area.addEventListener('dragleave', () => area.classList.remove('drag'));
    area.addEventListener('drop',      e => { e.preventDefault(); area.classList.remove('drag'); });

    input.addEventListener('change', function() {
        row.innerHTML = '';
        Array.from(this.files).forEach(file => {
            const img = document.createElement('img');
            img.className = 'preview-thumb';
            img.style.display = 'block';
            const reader = new FileReader();
            reader.onload = e2 => { img.src = e2.target.result; };
            reader.readAsDataURL(file);
            row.appendChild(img);
        });
    });
})();
</script>

</body>
</html>
