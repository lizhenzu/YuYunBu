@using BulletinBoard.ViewModels
@model IEnumerable<BandPost>

@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)
    var UserFullName = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserFullName.ToString()) as string;
    bool hasMore = ViewBag.HasMore is bool b && b;
    int nextPage = ViewBag.NextPage is int n ? n : 0;
    string boardTableName = ViewBag.BoardTableName as string ?? "BandPosts";
    string boardName      = ViewBag.BoardName      as string ?? "게시판";
    int totalCount = ViewBag.TotalCount is int tc ? tc : 0;
    int todayCount = ViewBag.TodayCount is int td ? td : 0;

    bool isLost = boardTableName.Contains("LostAndFound", StringComparison.OrdinalIgnoreCase);
    string createUrl = $"/BandBoard/Create?boardTableName={boardTableName}&boardName={Uri.EscapeDataString(boardName)}";
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>@boardName</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&family=Inter:wght@200;400;500;600&family=Gothic+A1:wght@400;600&display=swap" rel="stylesheet">
<link href="~/css/board-bone.css" rel="stylesheet" asp-append-version="true" />
<style>
/* ── 머리 통계 ── */
.st { display: flex; gap: 22px; margin-top: 18px; }
.st div { font-size: 11px; font-weight: 600; letter-spacing: .16em; color: var(--headdim); }
.st b { display: block; margin-top: 2px; font-family: "Inter", sans-serif; font-weight: 200; font-size: 28px; letter-spacing: 0; color: var(--headtx); font-variant-numeric: tabular-nums; }
.st .k b { color: var(--headk); }

.hint { margin-top: 18px; font-size: 12.5px; color: var(--dim); padding-bottom: 12px; border-bottom: 1px solid var(--rule); }
.hint b { font-weight: 600; color: var(--acc); }

/* ── 글 카드 ── */
.post-card { background: var(--card); border: 1px solid var(--rule); margin-top: 14px; }
.post-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 14px 16px 10px; }
.post-author { display: flex; align-items: center; gap: 10px; min-width: 0; }
.post-avatar { width: 34px; height: 34px; flex: none; display: grid; place-items: center; background: var(--mark); color: var(--acc); font-family: "Noto Serif KR", serif; font-size: 14px; }
.post-name { font-size: 14px; font-weight: 600; color: var(--tx); }
.post-time { font-family: "Inter", sans-serif; font-size: 12px; color: var(--dim); font-variant-numeric: tabular-nums; }
.post-head form { margin: 0; }
.post-del-btn { font-family: inherit; font-size: 12px; padding: 4px 10px; background: none; border: 1px solid var(--rule); color: var(--danger); cursor: pointer; }
.post-del-btn:hover { border-color: var(--danger); }

.post-body { padding: 0 16px 14px; }
.post-text { font-family: "Noto Serif KR", serif; font-size: 15.5px; line-height: 1.9; color: var(--tx); white-space: pre-line; word-break: keep-all; overflow-wrap: anywhere; }

/* 사진 */
.post-imgs-grid { display: grid; gap: 2px; }
.post-imgs-grid.count-1 { grid-template-columns: 1fr; }
.post-imgs-grid.count-2 { grid-template-columns: 1fr 1fr; }
.post-imgs-grid.count-3 { grid-template-columns: 1fr 1fr 1fr; }
.post-imgs-grid.count-many { grid-template-columns: 1fr 1fr; }
.post-img-wrap { position: relative; overflow: hidden; aspect-ratio: 1/1; background: var(--mark); cursor: zoom-in; }
.post-img-wrap:first-child:only-child { aspect-ratio: 16/9; }
.post-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .3s ease; }
.post-img-wrap:hover .post-img { transform: scale(1.03); }
.img-more-overlay { position: absolute; inset: 0; background: rgba(22,24,28,.55); display: grid; place-items: center; font-family: "Inter", sans-serif; font-weight: 200; font-size: 30px; color: #fff; }

/* 좋아요 · 댓글 줄 */
.post-actions { display: flex; gap: 6px; padding: 10px 16px; border-top: 1px solid var(--line); }
.like-btn, .comment-toggle-btn { display: inline-flex; align-items: center; gap: 7px; font-family: inherit; font-size: 13px; padding: 6px 12px; background: none; border: 1px solid var(--rule); color: var(--dim2); cursor: pointer; transition: border-color .15s, color .15s; }
.like-btn:hover, .comment-toggle-btn:hover { border-color: var(--acc); color: var(--acc); }
.like-btn.liked { border-color: var(--acc); color: var(--acc); background: var(--mark); }
.like-btn .i, .comment-toggle-btn .i { font-size: 13px; }
.like-count, .cmt-badge { font-family: "Inter", sans-serif; font-variant-numeric: tabular-nums; }

/* 댓글 */
.comment-zone { border-top: 1px solid var(--line); background: var(--bg); }
.comment-zone.hidden { display: none; }
.comment-list { padding: 6px 16px 2px; }
.comment-item { display: flex; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); }
.comment-item:last-child { border-bottom: 0; }
.comment-dot { width: 26px; height: 26px; flex: none; display: grid; place-items: center; border: 1px solid var(--rule); color: var(--dim2); font-size: 11px; background: var(--card); }
.comment-content { flex: 1; min-width: 0; }
.comment-name { font-size: 12.5px; font-weight: 600; color: var(--tx); }
.comment-text { margin-top: 2px; font-size: 14px; line-height: 1.65; color: var(--tx); word-break: keep-all; overflow-wrap: anywhere; }
.comment-ts { margin-top: 2px; font-family: "Inter", sans-serif; font-size: 11.5px; color: var(--dim); font-variant-numeric: tabular-nums; }
.comment-empty { font-size: 13px; color: var(--dim); padding: 10px 0 6px; }
.comment-form-wrap { display: flex; gap: 6px; padding: 10px 16px 14px; }
.cmt-name-input, .cmt-content-input { font-family: inherit; font-size: 13.5px; padding: 8px 10px; border: 1px solid var(--rule); background: var(--card); color: var(--tx); outline: none; border-radius: 0; min-width: 0; }
.cmt-name-input:focus, .cmt-content-input:focus { border-color: var(--acc); }
.cmt-name-input { width: 84px; flex: none; }
.cmt-content-input { flex: 1; }
.cmt-submit { flex: none; font-family: inherit; font-size: 13px; padding: 0 14px; border: 1px solid var(--tx); background: var(--tx); color: var(--bg); cursor: pointer; }
.cmt-submit:hover { background: var(--acc); border-color: var(--acc); color: #fff; }

/* 빈 상태 · 더 불러오기 */
.empty-state { padding: 60px 20px; text-align: center; color: var(--dim); font-size: 14px; border-bottom: 1px solid var(--line); }
.empty-state .nbtn { margin-top: 16px; }
.load-more-area { padding: 22px 0 4px; text-align: center; font-size: 12.5px; color: var(--dim); }
.load-spinner { display: inline-block; width: 14px; height: 14px; margin-right: 6px; vertical-align: -2px; border: 2px solid var(--rule); border-top-color: var(--acc); border-radius: 50%; animation: spin .8s linear infinite; }
@@keyframes spin { to { transform: rotate(360deg); } }

/* 라이트박스 */
#lbOverlay { display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(12,13,15,.94); align-items: center; justify-content: center; padding: 16px; }
#lbOverlay.open { display: flex; }
#lbImg { max-width: 100%; max-height: 90dvh; object-fit: contain; display: block; }
.lb-close, .lb-nav { position: absolute; display: grid; place-items: center; background: none; border: 1px solid #3A3C40; color: var(--headtx, #F2EFEA); cursor: pointer; }
.lb-close { top: 16px; right: 16px; width: 40px; height: 40px; font-size: 16px; }
.lb-nav { top: 50%; transform: translateY(-50%); width: 44px; height: 44px; font-size: 20px; }
.lb-close:hover, .lb-nav:hover { border-color: #D9C29B; color: #D9C29B; }
.lb-prev { left: 12px; }
.lb-next { right: 12px; }
.lb-counter { position: absolute; bottom: 18px; left: 50%; transform: translateX(-50%); font-family: "Inter", sans-serif; font-size: 12px; letter-spacing: .1em; color: #9A9690; }

@@media (max-width: 480px) {
    .post-card { margin-left: calc(var(--pad) * -1); margin-right: calc(var(--pad) * -1); border-left: 0; border-right: 0; }
    .post-imgs-grid.count-3 { grid-template-columns: 1fr 1fr; }
    .lb-nav { display: none; }
}
</style>
</head>
<body>

<header class="hd">
    <div class="sh">
        <div class="hdTop">
            <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">›</span><a href="/Notice/Branch">소통공간</a></span>
            <a class="nbtn pri" href="@createUrl">＋ @(isLost ? "분실물 등록" : "새 글")</a>
        </div>
        <div class="hdK">@(isLost ? "LOST & FOUND" : "BOARD")</div>
        <h1 class="hdT">@boardName</h1>
        <div class="st">
            <div>전체<b>@totalCount</b></div>
            <div class="k">오늘<b>@todayCount</b></div>
        </div>
    </div>
</header>

<main class="sh">

    @if (TempData["Error"] != null)
    {
        <div class="alert" style="margin-top:18px">@TempData["Error"]</div>
    }

    <div class="hint">사진을 <b>누르면</b> 크게 볼 수 있어요 · 여러 장이면 좌우로 넘길 수 있습니다</div>

    <!-- ── 게시글 리스트 ── -->
    <div id="postList">
        @await Html.PartialAsync("_PostListPartial", Model)
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            @(isLost ? "등록된 분실물이 없습니다." : "아직 글이 없습니다. 첫 글을 작성해 보세요.")
            <div><a class="nbtn" href="@createUrl">＋ @(isLost ? "분실물 등록" : "새 글 쓰기")</a></div>
        </div>
    }

    <div id="loadMoreArea" class="load-more-area">
        @if (hasMore)
        {
            <span><span class="load-spinner"></span>불러오는 중…</span>
        }
        else if (Model.Any())
        {
            <span>모든 글을 불러왔어요</span>
        }
    </div>

    <div class="ft">
        <span>© 유년부 · @boardName</span>
        <span><a href="/Notice/Branch">소통공간</a> · <a href="/">@ConstatsCommon.ToHome</a></span>
    </div>
</main>

<!-- ── 라이트박스 ── -->
<div id="lbOverlay" onclick="lbClose(event)">
    <button class="lb-close" onclick="lbHide()" aria-label="닫기">✕</button>
    <button class="lb-nav lb-prev" onclick="lbStep(-1,event)" aria-label="이전 사진">‹</button>
    <img id="lbImg" src="" alt="" />
    <button class="lb-nav lb-next" onclick="lbStep(1,event)" aria-label="다음 사진">›</button>
    <div class="lb-counter" id="lbCounter"></div>
</div>

<script>
/* ── 라이트박스 ── */
let _lbSrcs = [], _lbIdx = 0;
function lbOpen(srcs, idx) {
    _lbSrcs = srcs; _lbIdx = idx;
    lbShow();
    document.addEventListener('keydown', lbKey);
}
function lbShow() {
    document.getElementById('lbImg').src = _lbSrcs[_lbIdx];
    document.getElementById('lbCounter').textContent = (_lbIdx+1) + ' / ' + _lbSrcs.length;
    document.getElementById('lbOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}
function lbHide() {
    document.getElementById('lbOverlay').classList.remove('open');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', lbKey);
}
function lbClose(e) { if (e.target === document.getElementById('lbOverlay')) lbHide(); }
function lbStep(d, e) { e && e.stopPropagation(); _lbIdx = (_lbIdx + d + _lbSrcs.length) % _lbSrcs.length; lbShow(); }
function lbKey(e) { if (e.key === 'ArrowLeft') lbStep(-1); else if (e.key === 'ArrowRight') lbStep(1); else if (e.key === 'Escape') lbHide(); }

/* ── 라이트박스 스와이프 ── */
(function() {
    var ox = 0, oy = 0, moved = false;
    var overlay = document.getElementById('lbOverlay');
    var img     = document.getElementById('lbImg');

    overlay.addEventListener('touchstart', function(e) {
        if (e.touches.length !== 1) return;
        ox = e.touches[0].clientX;
        oy = e.touches[0].clientY;
        moved = false;
        img.style.transition = 'none';
    }, { passive: true });

    overlay.addEventListener('touchmove', function(e) {
        if (e.touches.length !== 1) return;
        var dx = e.touches[0].clientX - ox;
        var dy = e.touches[0].clientY - oy;
        if (Math.abs(dx) > Math.abs(dy)) {
            moved = true;
            img.style.transform = 'translateX(' + dx * 0.4 + 'px)';
        }
    }, { passive: true });

    overlay.addEventListener('touchend', function(e) {
        var dx = e.changedTouches[0].clientX - ox;
        var dy = e.changedTouches[0].clientY - oy;
        img.style.transition = '';
        img.style.transform  = '';
        if (moved && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
            lbStep(dx < 0 ? 1 : -1);
        } else if (!moved && Math.abs(dx) < 8 && Math.abs(dy) < 8) {
            /* 단순 탭 → 닫기 */
            lbHide();
        }
        moved = false;
    }, { passive: true });
})();

/* ── 좋아요 ── */
const BOARD_TABLE = '@boardTableName';
const BOARD_NAME  = '@boardName';

document.addEventListener('click', function(e) {
    const btn = e.target.closest('.like-btn');
    if (!btn) return;
    const postId = btn.dataset.postId;
    fetch('/BandBoard/Like?boardTableName=' + encodeURIComponent(BOARD_TABLE), {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'id=' + encodeURIComponent(postId)
    }).then(r => r.json()).then(d => {
        const s = btn.querySelector('.like-count');
        if (s) s.textContent = d.likeCount;
        btn.classList.add('liked');
        const ic = btn.querySelector('.i');
        if (ic) ic.textContent = '♥';
    });
});

/* ── 댓글 토글 ── */
document.addEventListener('click', function(e) {
    const btn = e.target.closest('.comment-toggle-btn');
    if (!btn) return;
    const zone = btn.closest('.post-card').querySelector('.comment-zone');
    if (zone) zone.classList.toggle('hidden');
});

/* ── 댓글 등록 ── */
document.addEventListener('submit', function(e) {
    if (!e.target.classList.contains('comment-form')) return;
    e.preventDefault();
    const form     = e.target;
    const postId   = form.dataset.postId;
    const nameEl   = form.querySelector('.cmt-name-input');
    const contentEl= form.querySelector('.cmt-content-input');
    const content  = contentEl.value.trim();
    if (!content) { contentEl.focus(); return; }

    fetch('/BandBoard/AddComment?boardTableName=' + encodeURIComponent(BOARD_TABLE), {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'postId=' + encodeURIComponent(postId)
            + '&writerName=' + encodeURIComponent(nameEl.value || '익명')
            + '&content=' + encodeURIComponent(content)
    }).then(r => r.json()).then(d => {
        const list = form.closest('.post-card').querySelector('.comment-list');
        if (list) {
            const empty = list.querySelector('.comment-empty');
            if (empty) empty.remove();
            const item = document.createElement('div');
            item.className = 'comment-item';
            const initials = (d.writerName || '?').charAt(0).toUpperCase();
            item.innerHTML =
                '<div class="comment-dot">' + escHtml(initials) + '</div>' +
                '<div class="comment-content">' +
                    '<div class="comment-name">' + escHtml(d.writerName) + '</div>' +
                    '<div class="comment-text">' + escHtml(d.content) + '</div>' +
                    '<div class="comment-ts">' + escHtml(d.createdAt) + '</div>' +
                '</div>';
            list.appendChild(item);
        }
        contentEl.value = '';
        const zone = form.closest('.comment-zone');
        if (zone) zone.classList.remove('hidden');
        // update comment count badge
        const badge = form.closest('.post-card').querySelector('.cmt-badge');
        if (badge) badge.textContent = parseInt(badge.textContent || '0') + 1;
    });
});

function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ── 무한 스크롤 ── */
let nextPage = @nextPage;
let isLoading = false;
let noMore = @(hasMore ? "false" : "true");

function tryLoadMore() {
    if (noMore || isLoading || nextPage <= 0) return;
    if (window.innerHeight + window.scrollY + 300 < document.body.offsetHeight) return;
    isLoading = true;

    fetch('/BandBoard/LoadMore?boardTableName=' + encodeURIComponent(BOARD_TABLE)
        + '&boardName=' + encodeURIComponent(BOARD_NAME)
        + '&page=' + encodeURIComponent(nextPage))
    .then(r => r.text())
    .then(html => {
        if (!html.trim()) { noMore = true; updateFooter(); return; }
        const tmp = document.createElement('div');
        tmp.innerHTML = html;
        const hiddenNext = tmp.querySelector('#nextPageHidden');
        const hiddenMore = tmp.querySelector('#hasMoreHidden');
        if (hiddenNext) { nextPage = parseInt(hiddenNext.value); hiddenNext.remove(); }
        if (hiddenMore) { noMore = hiddenMore.value !== 'true'; hiddenMore.remove(); }
        document.getElementById('postList').appendChild(tmp);
        if (noMore) updateFooter();
    })
    .finally(() => { isLoading = false; });
}
function updateFooter() {
    document.getElementById('loadMoreArea').innerHTML = '<span>모든 글을 불러왔어요</span>';
}
window.addEventListener('scroll', tryLoadMore, { passive: true });
</script>

</body>
</html>
