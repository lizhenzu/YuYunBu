@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@using BulletinBoard.ViewModels
@model IEnumerable<BandPost>

@{
    var boardTableName = ViewBag.BoardTableName as string ?? "BandPosts";
    var boardName      = ViewBag.BoardName      as string ?? "게시판";
}

@foreach (var post in Model)
{
    @await Html.PartialAsync("_PostCard", post)
}

@if (ViewBag.NextPage != null)
{
    <input type="hidden" id="nextPageHidden" value="@ViewBag.NextPage" />
}
@if (ViewBag.HasMore != null)
{
    <input type="hidden" id="hasMoreHidden" value="@(ViewBag.HasMore ? "true" : "false")" />
}
