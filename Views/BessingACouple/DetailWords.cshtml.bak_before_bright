@model BulletinBoard.Models.BessingACoupleDatas
@using BulletinBoard.Common
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http
@using BulletinBoard.Services.Abstract
@using System.Text.RegularExpressions
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    var todayDate = DateHelper.GetTodayDateDayString();
    string formattedModResultData = $"MarriedCouple_{todayDate}.webp";
    string formattedModResultDataOG = $"{@ViewBag.Domain}//images/workspace/MarriedCouple/horizontal/{formattedModResultData}";
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());

    // KindDataA = 기도를 받는 사람, KindDataB = 기도하는 사람
    string KindDataA = "아내";
    string KindDataB = "남편";
    bool isForHusband = (string)ViewBag.Kind == "Husband";
    if (isForHusband)
    {
        KindDataA = "남편";
        KindDataB = "아내";
    }
    string kindClass = isForHusband ? "k-husband" : "k-wife";
    // 받침 유무에 맞춘 목적격 조사 — 남편을 / 아내를
    string josa = isForHusband ? "을" : "를";

    string pageTitle = $"{ChurchName} {DepartmentName}";

    var kNow = DateHelper.GetKoreaNow();
    string[] dayKor = { "일", "월", "화", "수", "목", "금", "토" };
    string dateStr = $"{kNow:yyyy년 M월 d일} {dayKor[(int)kNow.DayOfWeek]}요일";

    // 본문은 HTML 로 해석되지 않도록 이스케이프하고,
    // **...** 처럼 별표로 감싼 부분만 강조 표시로 바꾼다.
    Func<string, Microsoft.AspNetCore.Html.IHtmlContent> Mark = raw =>
    {
        var enc = System.Net.WebUtility.HtmlEncode(raw ?? string.Empty);
        enc = Regex.Replace(enc, @"\*{2,3}(.+?)\*{2,3}", "<span class=\"nm\">$1</span>");
        return new Microsoft.AspNetCore.Html.HtmlString(enc);
    };

    Func<string, string[]> Lines = raw =>
        string.IsNullOrWhiteSpace(raw)
            ? new string[0]
            : raw.Replace("\r\n", "\n").Replace("\r", "\n").Trim()
                 .Split('\n')
                 .Where(l => !string.IsNullOrWhiteSpace(l))
                 .ToArray();

    var prayLines = Lines(Model?.PrayText);
    var wordLines = Lines(Model?.PrayHolyWord);
}
@{
    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#FFF9F6">
    <title>@pageTitle</title>

    <meta property="og:title" content="@pageTitle">
    <meta property="og:description" content="@pageTitle 입니다.">
    <meta property="og:image" content="@formattedModResultDataOG">
    <meta property="og:url" content="@ViewBag.FullURL">
    <meta property="og:type" content="website">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Dodum&family=Gowun+Batang:wght@400;700&display=swap" rel="stylesheet">

    <style>
        :root {
            /* 저녁 노을빛 로즈 */
            --paper: #FFF9F6;
            --paper-2: #FFF1EC;
            --card: #FFFFFF;
            --ink: #3C3239;
            --ink-2: #58484F;
            --muted: #918088;
            --line: #F2E2DE;
            --rose: #D9738B;
            --rose-dk: #B8546C;
            --amber: #D9884A;
            --amber-dk: #B96C31;
            --plum: #A88BC0;
            --shadow-s: 0 1px 2px rgba(105,66,74,.06);
            --shadow-m: 0 6px 20px rgba(105,66,74,.10);
            --f-ui: "Gowun Dodum","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
            --f-read: "Gowun Batang","Nanum Myeongjo","Apple SD Gothic Neo",serif;
            --fs: 1;
            /* 기본(아내를 위한 기도) 포인트 */
            --accent: var(--rose);
            --accent-dk: var(--rose-dk);
            --accent-tint: #FCE9EE;
            --accent-line: #F2CBD6;
            --accent-mark: #FBD9E2;
        }

        /* 남편을 위한 기도 — 노을 앰버 */
        body.k-husband {
            --accent: var(--amber);
            --accent-dk: var(--amber-dk);
            --accent-tint: #FDEEDF;
            --accent-line: #F2D6B8;
            --accent-mark: #FBE3C8;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--paper);
            background-image: radial-gradient(720px 320px at 50% -130px, #FCE3DC 0%, rgba(252,227,220,0) 70%), radial-gradient(560px 280px at 6% 150px, #FFECD6 0%, rgba(255,236,214,0) 72%), radial-gradient(560px 280px at 97% 250px, #F1E8F6 0%, rgba(241,232,246,0) 72%);
            background-repeat: no-repeat;
            background-attachment: fixed;
            color: var(--ink);
            font-family: var(--f-ui);
            line-height: 1.6;
            -webkit-text-size-adjust: 100%;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* ── 상단 바 ───────────────────────── */
        .nbar {
            position: sticky;
            top: 0;
            z-index: 20;
            background: rgba(255,249,246,.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--line);
        }

        .nbar-in {
            max-width: 760px;
            margin: 0 auto;
            padding: 9px clamp(12px,4vw,20px);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nb-btn {
            flex: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            height: 34px;
            padding: 0 13px;
            border-radius: 999px;
            background: var(--card);
            border: 1px solid var(--line);
            box-shadow: var(--shadow-s);
            font-size: 13px;
            color: var(--ink-2);
        }

            .nb-btn:hover {
                border-color: var(--accent);
                color: var(--accent-dk);
            }

        .nb-mid {
            flex: 1 1 auto;
            min-width: 0;
            text-align: center;
            font-size: 12.5px;
            color: var(--muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* 글자 크기 3단 */
        .fsgrp {
            flex: none;
            display: flex;
            gap: 0;
            background: var(--paper-2);
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 3px;
        }

            .fsgrp button {
                width: 30px;
                height: 28px;
                border: 0;
                background: transparent;
                cursor: pointer;
                border-radius: 999px;
                color: var(--muted);
                font-family: var(--f-ui);
                line-height: 1;
                display: grid;
                place-items: center;
                transition: .14s;
            }

                .fsgrp button:nth-child(1) {
                    font-size: 11px;
                }

                .fsgrp button:nth-child(2) {
                    font-size: 13px;
                }

                .fsgrp button:nth-child(3) {
                    font-size: 16px;
                }

        .fsgrp button:nth-child(4) {
            font-size: 19px;
        }

                .fsgrp button.on {
                    background: var(--card);
                    color: var(--accent-dk);
                    box-shadow: var(--shadow-s);
                }

                .fsgrp button:hover {
                    color: var(--accent-dk);
                }

        /* ── 레이아웃 ───────────────────────── */
        .wrap {
            max-width: 760px;
            margin: 0 auto;
            padding: 0 clamp(14px,4vw,22px) 92px;
        }

        /* ── 히어로 ───────────────────────── */
        .hero {
            padding: 30px 0 22px;
            text-align: center;
        }

        /* 맞물린 두 고리 — 부부의 연합 */
        .rings {
            width: 92px;
            height: 52px;
            margin: 0 auto 16px;
            position: relative;
        }

            .rings span {
                position: absolute;
                top: 0;
                width: 52px;
                height: 52px;
                border-radius: 50%;
                border: 3px solid;
            }

                .rings span:nth-child(1) {
                    left: 0;
                    border-color: var(--accent);
                    opacity: .85;
                }

                .rings span:nth-child(2) {
                    right: 0;
                    border-color: var(--plum);
                    opacity: .7;
                }

        .chips {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 14px;
        }

        .chip {
            padding: 5px 11px;
            border-radius: 999px;
            font-size: 11.5px;
            border: 1px solid var(--line);
            background: var(--card);
            color: var(--ink-2);
            box-shadow: var(--shadow-s);
        }

        .chip-accent {
            background: var(--accent-tint);
            border-color: var(--accent-line);
            color: var(--accent-dk);
        }

        .hero-h1 {
            margin: 0;
            font-size: clamp(21px,5.2vw,30px);
            line-height: 1.34;
            letter-spacing: -.02em;
            color: var(--ink);
            word-break: keep-all;
            text-wrap: balance;
        }

            .hero-h1 em {
                font-style: normal;
                color: var(--accent-dk);
            }

        .hero-sub {
            margin-top: 10px;
            font-size: 13px;
            color: var(--muted);
        }

        .hero-rule {
            margin: 20px auto 0;
            width: 58px;
            height: 4px;
            border-radius: 999px;
            background: linear-gradient(90deg,var(--accent),var(--plum));
        }

        /* ── 카드 ───────────────────────── */
        .card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 22px;
            box-shadow: var(--shadow-m);
            overflow: hidden;
            margin-bottom: 18px;
        }

        .card-hd {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 15px 20px;
            border-bottom: 1px solid var(--line);
            background: linear-gradient(180deg,var(--paper-2),#FFFFFF);
        }

        .card-ico {
            width: 30px;
            height: 30px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            font-size: 16px;
            background: var(--accent-tint);
        }

        .card-verse .card-ico {
            background: #EFE9F5;
        }

        .card-tt {
            font-size: 13.5px;
            color: var(--ink-2);
        }

        .card-bd {
            padding: 22px 20px 24px;
        }

        .pray-title {
            margin: 0;
            font-family: var(--f-ui);
            font-size: clamp(19px,4.4vw,25px);
            line-height: 1.4;
            letter-spacing: -.02em;
            color: var(--ink);
            word-break: keep-all;
            text-wrap: balance;
        }

        .title-rule {
            margin: 15px 0 19px;
            height: 1px;
            background: repeating-linear-gradient(90deg,var(--line) 0 7px,transparent 7px 13px);
        }

        .prose p {
            margin: 0 0 17px;
            font-family: var(--f-read);
            font-size: calc(17px * var(--fs));
            line-height: 2.0;
            color: var(--ink);
            word-break: keep-all;
        }

            .prose p:last-child {
                margin-bottom: 0;
            }

        .nm {
            color: var(--accent-dk);
            font-weight: 700;
            background: linear-gradient(180deg,transparent 62%,var(--accent-mark) 62%);
            padding: 0 2px;
            border-radius: 3px;
        }

        /* 말씀 카드 — 처음에는 접힘 */
        .card-verse > summary {
            list-style: none;
            cursor: pointer;
            user-select: none;
        }

            .card-verse > summary::-webkit-details-marker {
                display: none;
            }

        .card-verse:not([open]) > summary {
            border-bottom: 0;
        }

        .card-hint {
            margin-left: auto;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 11.5px;
            color: var(--muted);
        }

            .card-hint::after {
                content: "▾";
                transition: .18s;
            }

        .card-verse[open] .card-hint {
            font-size: 0;
            gap: 0;
        }

            .card-verse[open] .card-hint::after {
                font-size: 11.5px;
                transform: rotate(180deg);
            }

        .verse p {
            margin: 0 0 14px;
            font-family: var(--f-read);
            font-size: calc(15.5px * var(--fs));
            line-height: 1.95;
            color: var(--ink-2);
            word-break: keep-all;
        }

            .verse p:last-child {
                margin-bottom: 0;
            }

        .card-verse .card-bd {
            background: #FDFBFE;
        }

        .stamp {
            text-align: right;
            font-size: 11.5px;
            color: var(--muted);
            margin: -4px 2px 18px;
        }

        /* ── 버튼 ───────────────────────── */
        .btn-row {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 14px;
        }

        .btn {
            appearance: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            height: 44px;
            padding: 0 20px;
            border-radius: 999px;
            border: 1px solid var(--line);
            background: var(--card);
            color: var(--ink-2);
            font-family: var(--f-ui);
            font-size: 14px;
            cursor: pointer;
            box-shadow: var(--shadow-s);
            transition: .16s;
        }

            .btn:hover {
                transform: translateY(-1px);
                box-shadow: var(--shadow-m);
                border-color: var(--accent-line);
            }

        /* 홈으로 — 파샬이 만들어 주는 버튼을 이 줄에서만 강조 */
        .btn-row-main .btn {
            min-width: 160px;
            background: linear-gradient(135deg,var(--accent),var(--plum));
            border-color: transparent;
            color: #FFFFFF;
        }

        /* 기도홈 — 홈으로 옆에 나란히, 한 톤 낮춰서 */
        .btn-row-main .btn.btn-soft {
            background: var(--accent-tint);
            border-color: var(--accent-line);
            color: var(--accent-dk);
        }

        .empty {
            padding: 52px 20px;
            text-align: center;
        }

        .empty-ico {
            font-size: 40px;
            margin-bottom: 12px;
        }

        .empty-tt {
            font-size: 16px;
            color: var(--ink-2);
        }

        @@media (max-width:420px) {
            .btn {
                height: 42px;
                padding: 0 16px;
                font-size: 13.5px;
            }

            .btn-row-main .btn {
                min-width: 138px;
            }
        }

        @@media (prefers-reduced-motion:reduce) {
            * {
                transition: none !important;
            }
        }
    </style>
</head>
<body class="@kindClass">

    <header class="nbar">
        <div class="nbar-in">
            <a class="nb-btn" href="/">🏠 홈</a>
            <div class="nb-mid">@dateStr</div>
            <div class="fsgrp" role="group" aria-label="기도문 글자 크기">
                <button type="button" id="pfsS" onclick="setPFs('s')" aria-label="작게">가</button>
                <button type="button" id="pfsM" onclick="setPFs('m')" aria-label="보통">가</button>
                <button type="button" id="pfsL" onclick="setPFs('l')" aria-label="크게">가</button>
                <button type="button" id="pfsXL" onclick="setPFs('xl')" aria-label="아주 크게">가</button>
            </div>
        </div>
    </header>

    <div class="wrap">

        <section class="hero">
            <div class="rings" aria-hidden="true"><span></span><span></span></div>
            <div class="chips">
                <span class="chip chip-accent">💍 부부 기도</span>
                @if (!string.IsNullOrWhiteSpace(ChurchName))
                {
                    <span class="chip">@ChurchName</span>
                }
                @if (!string.IsNullOrWhiteSpace(DepartmentName))
                {
                    <span class="chip">@DepartmentName</span>
                }
            </div>
            <h1 class="hero-h1"><em>@KindDataA</em>@(josa) 위한 <em>@KindDataB</em>의 기도</h1>
            <div class="hero-sub">서로를 축복하며 세워 주는 기도</div>
            <div class="hero-rule"></div>
        </section>

        @if (prayLines.Length == 0 && wordLines.Length == 0)
        {
            <div class="card">
                <div class="empty">
                    <div class="empty-ico">🕊️</div>
                    <div class="empty-tt">표시할 기도문이 없어요</div>
                </div>
            </div>
        }
        else
        {
            <article class="card">
                <div class="card-hd">
                    <div class="card-ico">🙏</div>
                    <span class="card-tt">@(KindDataA)@(josa) 위한 기도</span>
                </div>
                <div class="card-bd">
                    <h2 class="pray-title">@Model.PrayTitle</h2>
                    <div class="title-rule"></div>
                    <div class="prose">
                        @foreach (var line in prayLines)
                        {
                            <p>@Mark(line)</p>
                        }
                    </div>
                </div>
            </article>

            @if (wordLines.Length > 0)
            {
                @* 처음에는 접힌 상태 — 제목을 눌러 펼친다 *@
                <details class="card card-verse">
                    <summary class="card-hd">
                        <div class="card-ico">📖</div>
                        <span class="card-tt">함께 읽는 말씀</span>
                        <span class="card-hint">펼쳐 보기</span>
                    </summary>
                    <div class="card-bd verse">
                        @foreach (var line in wordLines)
                        {
                            <p>@Mark(line)</p>
                        }
                    </div>
                </details>
            }
        }

        @if (Model != null && Model.UpdateDT != default(DateTime))
        {
            <div class="stamp">수정일 @Model.UpdateDT.ToString("yyyy-MM-dd")</div>
        }

        <div class="btn-row btn-row-main">
            @await Html.PartialAsync("_Publish_BlessingHome", @KindDataA)
            <button class="btn btn-soft" type="button" onclick="location.href='/PrayHome/Index'">🙏 기도홈</button>
        </div>

        @if (isSuperAdmin)
        {
            <div class="btn-row">
                <button class="btn" onclick="location.href='/BessingACouple/DetailList?Kind=@ViewBag.Kind'">📂 목록</button>
                <button class="btn" onclick="location.href='/BessingACouple/ModifyView?Kind=@ViewBag.Kind&Id=@Model.Id'">✏️ 수정</button>
            </div>
        }

    </div>

    <script>
        /* 기도문 글자 크기 — 작게 / 보통 / 크게 (HealingAndRestorationPray 와 동일 동작) */
        (function () {
            var MAP = { s: 0.90, m: 1, l: 1.18, xl: 1.36 };
            window.setPFs = function (k, silent) {
                if (!MAP[k]) k = 'm';
                document.documentElement.style.setProperty('--fs', MAP[k]);
                ['S', 'M', 'L', 'XL'].forEach(function (x) {
                    var b = document.getElementById('pfs' + x);
                    if (b) b.classList.toggle('on', x.toLowerCase() === k);
                });
                if (!silent) { try { localStorage.setItem('acFs', k); } catch (e) { } }
            };
            function boot() {
                var saved = 'm';
                try { saved = localStorage.getItem('acFs') || 'm'; } catch (e) { }
                setPFs(saved, true);
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
            else boot();
        })();
    </script>
</body>
</html>
