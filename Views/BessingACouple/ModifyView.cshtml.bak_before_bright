@model BulletinBoard.Models.BessingACoupleData

<style>
 

    .button {
        margin: 5px 0;
    }

  

    .header {
        text-align: center;
        padding: 20px;
        background-color: #4CAF50;
        color: white;
    }

        .header h1, .header h3, .header h4 {
            margin: 10px 0;
        }

    .buttons {
        display: flex;
        padding: 20px 0;
        flex-direction: column;
        margin-bottom: 5.5px;
    }

    .buttons2 {
        display: flex;
        justify-content: space-between;
        padding: 20px 0;
        margin: 3px;
        margin-bottom: 5.5px;
        gap: 7px;
    }

    .button {
        flex: 1;
        padding: 10px;
        margin-left: 5px;
        margin-right: 5px;
        text-align: center;
        border-radius: 5px;
        cursor: pointer;
        background-color: #E8E8FF;
    }

        .button.choice {
            background-color: #FFEB3B; /* Yellow */
        }

        .button.subjective {
            background-color: #2196F3; /* Blue */
            color: white;
        }

        .button.back {
            background-color: #E8E8FF;
            color: black;
        }

        .button.main {
            background-color: #4CAF50; /* Green */
            color: white;
        }

        .button.home {
            background-color: #00BCD4; /* Cyan */
            color: white;
        }

    .error {
        color: red;
        font-size: 0.9em;
        margin-top: 5px;
    }

    @@media (max-width: 600px) {

        .button {
            margin: 5px 0;
        }
    }
</style>


<form asp-action="ModifyProcess" method="post" class="verse-form">

    <div class="card-header-middle">
        <h2>축복기도문 수정</h2>
    </div>

    <div class="form-header">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="PageNo"></label>
        <input asp-for="PageNo" class="Reciteonly-field" style="width: 100%;" />
        <span asp-validation-for="PageNo" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PrayTitle"></label>
        <input asp-for="PrayTitle" class="Reciteonly-field" style="width: 100%;" />
        <span asp-validation-for="PrayTitle" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PrayText"></label>
        <textarea id="PrayText" name="PrayText" asp-for="PrayText" class="form-control" rows="12" autofocus></textarea>
        <span asp-validation-for="PrayText" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="PrayHolyWord"></label>
        <textarea id="PrayHolyWord" name="PrayHolyWord" asp-for="PrayHolyWord" class="form-control" rows="12" autofocus></textarea>
        <span asp-validation-for="PrayHolyWord" class="text-danger"></span>
    </div>

    <input type="hidden" id="Id" name="Id" value="@Model.Id" />
    <input type="hidden" id="Kind" name="Kind" value="@ViewBag.Kind" />
    <div class="form-group">
        <button type="submit" class="btn-submit">제출</button>
    </div>   
</form>
 
<div class="buttons2">
    <div class="button main" onclick="location.href='/BessingACouple/DetailList?Kind=@ViewBag.Kind'">축복기도 홈으로</div>
    <div class="button home" onclick="location.href='/'">Home</div>
 
    </div>
 
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial") 
} 