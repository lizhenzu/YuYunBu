@model IEnumerable<BulletinBoard.Models.BessingChildDatas>
@using BulletinBoard.Common
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using BulletinBoard.Services.Abstract
@using Microsoft.AspNetCore.Html
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@*
   자녀 축복 기도문 — 목록
     · 누구나        : 기도문 카드를 눌러 읽습니다
     · 관리자        : 카드 안에서 수정 · 리셋
     · 슈퍼 관리자   : 등록 · 삭제 · 조회수까지

   ※ 색과 글꼴은 DetailWords 화면(아침 햇살 파스텔)과 같게 두었습니다.
   ※ 기도문은 '날짜(Id)' 로 고릅니다. 오늘 날짜와 같은 Id 가 오늘의 기도문입니다.
*@
@{
    Layout = null;

    var isSignedIn   = await AuthService.IsSignedIn(User);
    var user         = isSignedIn ? await AuthService.GetSignedUser(User) : null;
    var isSuperAdmin = user != null && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin      = isSuperAdmin || (user != null && await AuthService.IsInRole(user, nameof(Roles.Admin)));

    var ChurchName     = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());

    string pageTitle = $"{ChurchName} {DepartmentName}";

    var kNow = DateHelper.GetKoreaNow();
    string[] dayKor = { "일", "월", "화", "수", "목", "금", "토" };
    string dateStr = $"{kNow:yyyy년 M월 d일} {dayKor[(int)kNow.DayOfWeek]}요일";

    // 기도문은 '그 달의 며칠' 로 고릅니다 (DAL: Id = day(오늘))
    int todayDay = kNow.Day;

    var items = Model?.ToList() ?? new List<BulletinBoard.Models.BessingChildDatas>();
    int total = items.Count;
    var todayItem = items.Find(x => x.Id == todayDay);

    // 카드에 얹을 본문 미리보기 — 이름 자리를 감싼 별표(**○○**)를 걷어내고 한 줄로 폅니다.
    Func<string, int, string> excerpt = (raw, len) =>
    {
        if (string.IsNullOrWhiteSpace(raw)) return "";
        var t = System.Text.RegularExpressions.Regex.Replace(raw, @"\*{2,3}", "");
        t = System.Text.RegularExpressions.Regex.Replace(t, @"\s+", " ").Trim();
        return t.Length > len ? t.Substring(0, len) + "…" : t;
    };
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFCF5" />
    <title>@pageTitle</title>

    <meta property="og:title" content="자녀를 위한 축복 기도" />
    <meta property="og:description" content="@pageTitle · 자녀 축복 기도문 @(total)편" />
    <meta property="og:url" content="@ViewBag.FullURL" />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Dodum&family=Gowun+Batang:wght@400;700&display=swap" rel="stylesheet">

    <style>
        :root{
            /* 아침 햇살 파스텔 — DetailWords 와 같은 팔레트 */
            --cream:    #FFFCF5;
            --cream-2:  #FFF6E7;
            --card:     #FFFFFF;
            --ink:      #3E362E;
            --ink-2:    #574C41;
            --muted:    #93867A;
            --line:     #F1E6D4;
            --honey:    #E8A13A;
            --honey-dk: #C67F1C;
            --blossom:  #EE8FA4;
            --sky:      #77B3E2;
            --leaf:     #8CC98F;
            --shadow-s: 0 1px 2px rgba(94,72,40,.06);
            --shadow-m: 0 6px 20px rgba(94,72,40,.09);
            --shadow-l: 0 14px 40px rgba(94,72,40,.12);
            --f-ui:   "Gowun Dodum","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
            --f-read: "Gowun Batang","Nanum Myeongjo","Apple SD Gothic Neo",serif;
        }

        *,*::before,*::after{ box-sizing:border-box; }
        html,body{ margin:0; padding:0; }
        html{ -webkit-text-size-adjust:100%; }
        body{
            background:var(--cream);
            background-image:
                radial-gradient(760px 320px at 50% -120px, #FFF0D2 0%, rgba(255,240,210,0) 70%),
                radial-gradient(560px 260px at 8% 120px,  #FDECF0 0%, rgba(253,236,240,0) 72%),
                radial-gradient(560px 260px at 96% 220px, #E7F2FB 0%, rgba(231,242,251,0) 72%);
            background-repeat:no-repeat;
            background-attachment:fixed;
            color:var(--ink);
            font-family:var(--f-ui);
            line-height:1.6;
            padding-bottom:env(safe-area-inset-bottom);
        }
        a{ color:inherit; text-decoration:none; }
        button{ font-family:inherit; }

        /* ── 상단 바 ───────────────────────── */
        .nbar{
            position:sticky; top:0; z-index:20;
            background:rgba(255,252,245,.9);
            -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px);
            border-bottom:1px solid var(--line);
        }
        .nbar-in{
            max-width:1080px; margin:0 auto;
            padding:9px clamp(12px,4vw,20px);
            display:flex; align-items:center; gap:10px;
        }
        .nb-btn{
            flex:none; display:inline-flex; align-items:center; gap:5px;
            height:34px; padding:0 13px; border-radius:999px;
            background:var(--card); border:1px solid var(--line);
            box-shadow:var(--shadow-s); font-size:13px; color:var(--ink-2);
            white-space:nowrap; transition:.16s;
        }
        .nb-btn:hover{ border-color:var(--honey); color:var(--honey-dk); }
        .nb-mid{
            flex:1 1 auto; min-width:0; text-align:center;
            font-size:12.5px; color:var(--muted);
            white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
        }

        /* ── 레이아웃 ───────────────────────── */
        .wrap{ max-width:1080px; margin:0 auto; padding:0 clamp(14px,4vw,22px) 92px; }

        /* ── 히어로 ───────────────────────── */
        .hero{ padding:30px 0 20px; text-align:center; }
        .sun{
            width:62px; height:62px; margin:0 auto 14px;
            border-radius:50%; display:grid; place-items:center; font-size:27px;
            background:radial-gradient(circle at 50% 42%, #FFE6AE 0%, #FFD68F 62%, #FFC96E 100%);
            box-shadow:0 0 0 9px rgba(255,214,143,.24), 0 0 0 18px rgba(255,214,143,.12);
        }
        .chips{ display:flex; gap:6px; flex-wrap:wrap; justify-content:center; margin-bottom:14px; }
        .chip{
            padding:5px 11px; border-radius:999px; font-size:11.5px;
            border:1px solid var(--line); background:var(--card);
            color:var(--ink-2); box-shadow:var(--shadow-s); white-space:nowrap;
        }
        .chip-honey{ background:#FFF4DE; border-color:#F7DFAE; color:var(--honey-dk); }
        .hero-h1{
            margin:0; font-size:clamp(21px,5.2vw,30px); line-height:1.34;
            letter-spacing:-.02em; color:var(--ink); word-break:keep-all; text-wrap:balance;
        }
        .hero-sub{ margin-top:10px; font-size:13px; color:var(--muted); word-break:keep-all; }
        .hero-rule{
            margin:20px auto 0; width:58px; height:4px; border-radius:999px;
            background:linear-gradient(90deg,var(--honey),var(--blossom));
        }

        /* ── 오늘의 기도문 — 가장 큰 자리 ───────── */
        .today{
            position:relative; display:block; overflow:hidden;
            margin:6px 0 16px; padding:22px clamp(20px,4vw,28px) 24px;
            border-radius:24px; border:1px solid #F0D9AB;
            background:linear-gradient(135deg,#FFF3DA 0%,#FFE9C4 55%,#FCE1DE 100%);
            box-shadow:var(--shadow-m); transition:transform .16s, box-shadow .2s;
        }
        .today::after{
            content:""; position:absolute; right:-70px; top:-92px;
            width:240px; height:240px; border-radius:50%;
            background:radial-gradient(circle, rgba(255,255,255,.72), rgba(255,255,255,0) 68%);
            pointer-events:none;
        }
        .today:hover{ transform:translateY(-2px); box-shadow:var(--shadow-l); }
        .today:active{ transform:translateY(0); }
        .today-top{
            display:inline-flex; align-items:center; gap:6px;
            padding:5px 12px; border-radius:999px;
            background:rgba(255,255,255,.72); border:1px solid #F2DFBE;
            font-size:11.5px; color:var(--honey-dk);
        }
        .today-tt{
            margin-top:13px; font-size:clamp(19px,4.4vw,25px); line-height:1.4;
            letter-spacing:-.02em; color:var(--ink); word-break:keep-all; text-wrap:balance;
        }
        .today-ex{
            margin-top:9px; font-family:var(--f-read);
            font-size:14px; line-height:1.9; color:var(--ink-2); word-break:keep-all;
            display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
        }
        .today-go{
            margin-top:15px; display:inline-flex; align-items:center; gap:6px;
            font-size:13px; color:var(--honey-dk);
        }
        .today-go span{ transition:transform .16s; }
        .today:hover .today-go span{ transform:translateX(4px); }

        /* ── 안내 쪽지 (책 출처) ─────────────── */
        .note{
            display:flex; gap:11px; align-items:flex-start;
            margin:0 0 18px; padding:14px 16px;
            background:#FBFDFF; border:1px solid #E4EFF8; border-radius:16px;
        }
        .note-ico{
            flex:none; width:28px; height:28px; border-radius:9px;
            display:grid; place-items:center; font-size:15px; background:#E9F3FC;
        }
        .note-tx{ font-size:12.5px; line-height:1.8; color:var(--ink-2); word-break:keep-all; }

        /* ── 묶음 머리말 ────────────────────── */
        .sec-hd{ display:flex; align-items:center; gap:9px; margin:24px 2px 13px; }
        .sec-ico{
            flex:none; width:32px; height:32px; border-radius:11px;
            display:grid; place-items:center; font-size:16px;
            background:#FFF1D8; border:1px solid #F7DFAE;
        }
        .sec-tt{ font-size:15px; color:var(--ink); }
        .sec-sub{ margin-left:auto; font-size:12px; color:var(--muted); white-space:nowrap; }

        /* ── 기도 카드 ──────────────────────── */
        .pgrid{ display:grid; gap:14px; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); }
        .pcard{
            position:relative; display:flex; flex-direction:column;
            padding:18px 18px 16px;
            background:var(--card); border:1px solid var(--line);
            border-radius:22px; box-shadow:var(--shadow-s);
            transition:transform .16s, box-shadow .2s, border-color .16s;
        }
        /* 카드 위쪽에 얇게 그은 색 띠 */
        .pcard::before{
            content:""; position:absolute; left:20px; right:20px; top:0; height:3px;
            border-radius:0 0 3px 3px;
            background:linear-gradient(90deg,var(--honey),#F6D9A2);
        }
        .pcard:hover{ transform:translateY(-3px); border-color:#EBD7B4; box-shadow:var(--shadow-m); }
        .pcard.is-today{ border-color:#F0C980; background:linear-gradient(180deg,#FFF9EC,#FFFFFF 58%); }
        .pcard.is-today::before{ background:linear-gradient(90deg,var(--honey),var(--blossom)); }

        /* 카드 전체를 눌러 열 수 있게 — 관리 버튼은 이 위(z-index)로 올라갑니다 */
        .pcard-hit{ position:absolute; inset:0; z-index:1; border-radius:22px; }
        .pcard-hit:focus-visible{ outline:3px solid var(--honey); outline-offset:2px; }

        .pcard-top{ display:flex; align-items:center; gap:8px; margin-bottom:11px; }
        .pcard-no{
            flex:none; min-width:34px; height:30px; padding:0 9px; border-radius:10px;
            display:grid; place-items:center;
            background:var(--cream-2); border:1px solid var(--line);
            font-size:12.5px; color:var(--honey-dk); font-variant-numeric:tabular-nums;
        }
        .pcard.is-today .pcard-no{ background:var(--honey); border-color:var(--honey); color:#fff; }
        .pcard-tag{
            margin-left:auto; flex:none; padding:3px 10px; border-radius:999px;
            font-size:10.5px; background:var(--honey); color:#fff;
        }
        .pcard-tt{
            margin:0; font-size:16px; line-height:1.45; letter-spacing:-.01em;
            color:var(--ink); word-break:keep-all; text-wrap:balance;
            display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;
        }
        .pcard-ex{
            margin:9px 0 0; font-family:var(--f-read);
            font-size:13.5px; line-height:1.85; color:var(--ink-2); word-break:keep-all;
            display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden;
        }
        .pcard-ft{
            margin-top:auto; padding-top:13px;
            display:flex; align-items:center; gap:8px; flex-wrap:wrap;
            font-size:11.5px; color:var(--muted);
        }
        .pcard-meta{ margin-left:auto; white-space:nowrap; font-variant-numeric:tabular-nums; }

        /* 관리 버튼 — 링크 덮개보다 위 */
        .pcard-act{
            position:relative; z-index:2;
            margin-top:13px; padding-top:12px;
            border-top:1px dashed var(--line);
            display:flex; gap:6px;
        }
        .row-btn{
            flex:1; height:32px; border-radius:999px; cursor:pointer;
            border:1px solid var(--line); background:var(--card);
            font-size:12px; color:var(--ink-2);
            display:inline-flex; align-items:center; justify-content:center; gap:4px;
            transition:.14s;
        }
        .row-btn:hover{ background:var(--cream-2); border-color:#EBD7B4; color:var(--honey-dk); }
        .row-btn.del:hover{ background:#FDECEF; border-color:#F3C9D2; color:#B04A61; }

        /* ── 버튼 ───────────────────────────── */
        .btn-row{ display:flex; gap:9px; flex-wrap:wrap; justify-content:center; margin-top:26px; }
        .btn{
            appearance:none; display:inline-flex; align-items:center; justify-content:center; gap:6px;
            height:44px; padding:0 20px; border-radius:999px;
            border:1px solid var(--line); background:var(--card); color:var(--ink-2);
            font-family:var(--f-ui); font-size:14px; cursor:pointer;
            box-shadow:var(--shadow-s); transition:.16s;
        }
        .btn:hover{ transform:translateY(-1px); box-shadow:var(--shadow-m); border-color:#E5D3B4; }
        .btn-honey{
            min-width:160px; background:linear-gradient(135deg,var(--honey),#F0B75C);
            border-color:transparent; color:#4A3208; font-weight:700;
        }
        .btn-honey-soft{
            min-width:160px; background:#FFF4DE; border-color:#F0D9AB;
            color:var(--honey-dk); font-weight:700;
        }

        /* ── 빈 상태 ────────────────────────── */
        .empty{
            padding:52px 20px; text-align:center;
            background:var(--card); border:1px solid var(--line);
            border-radius:22px; box-shadow:var(--shadow-s);
        }
        .empty-ico{ font-size:40px; margin-bottom:12px; }
        .empty-tt{ font-size:16px; color:var(--ink-2); }
        .empty-sub{ margin-top:6px; font-size:13px; color:var(--muted); }

        @@media (max-width:560px){
            .pgrid{ grid-template-columns:1fr; gap:12px; }
            .pcard{ padding:16px 16px 14px; }
            .pcard-ex{ -webkit-line-clamp:2; }
            .today{ border-radius:20px; }
        }
        @@media (max-width:420px){
            .btn{ height:42px; padding:0 16px; font-size:13.5px; }
            .btn-honey, .btn-honey-soft{ min-width:138px; }
        }
        @@media print{
            .nbar,.btn-row,.pcard-act{ display:none !important; }
            body{ background:#fff; background-image:none; }
            .pcard{ break-inside:avoid; box-shadow:none; }
        }
        @@media (prefers-reduced-motion:reduce){
            *{ transition:none !important; }
        }
    </style>
</head>
<body>

    <header class="nbar">
        <div class="nbar-in">
            <a class="nb-btn" href="/">🏠 홈</a>
            <div class="nb-mid">@dateStr</div>
            @if (isSuperAdmin)
            {
                <a class="nb-btn" href="/BessingChild/EnrollView">✚ 등록</a>
            }
            else if (!isSignedIn)
            {
                <a class="nb-btn" href="/Identity/Account/Login">로그인</a>
            }
        </div>
    </header>

    <div class="wrap">

        <section class="hero">
            <div class="sun">🧸</div>
            <div class="chips">
                <span class="chip chip-honey">🌤️ 자녀 축복</span>
                @if (!string.IsNullOrWhiteSpace(ChurchName))
                {
                    <span class="chip">@ChurchName</span>
                }
                @if (!string.IsNullOrWhiteSpace(DepartmentName))
                {
                    <span class="chip">@DepartmentName</span>
                }
            </div>
            <h1 class="hero-h1">자녀를 위한 축복 기도문</h1>
            <div class="hero-sub">
                @if (total > 0)
                {
                    <text>모두 @(total)편 · 날짜에 맞추어 하루 한 편씩 함께 기도해요</text>
                }
                else
                {
                    <text>곧 준비될 예정입니다</text>
                }
            </div>
            <div class="hero-rule"></div>
        </section>

        @if (todayItem != null)
        {
            <a class="today" href="/BessingChild/DetailWords?Id=@todayItem.Id">
                <div class="today-top">🌅 오늘의 축복 기도 · @(kNow.Month)월 @(kNow.Day)일</div>
                <div class="today-tt">@todayItem.PrayTitle</div>
                @{ var todayEx = excerpt(todayItem.PrayText, 120); }
                @if (!string.IsNullOrEmpty(todayEx))
                {
                    <div class="today-ex">@todayEx</div>
                }
                <div class="today-go">눌러서 오늘의 기도문 읽기 <span>→</span></div>
            </a>
        }

        <div class="note">
            <div class="note-ico">📚</div>
            <div class="note-tx">
                본 기도문은 구유선 · 최귀영님의 「자녀의 인생을 형통케 하는 자녀 축복 기도문」 책을 구매하여 사용하고 있음을 알려 드립니다.
            </div>
        </div>

        @if (total == 0)
        {
            <div class="empty">
                <div class="empty-ico">🌱</div>
                <div class="empty-tt">아직 등록된 기도문이 없어요</div>
                <div class="empty-sub">
                    @if (isSuperAdmin) { <text>첫 기도문을 등록해 주세요.</text> }
                    else               { <text>곧 준비될 예정입니다.</text> }
                </div>
                @if (isSuperAdmin)
                {
                    <div class="btn-row">
                        <button class="btn btn-honey" onclick="location.href='/BessingChild/EnrollView'">✚ 기도문 등록</button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="sec-hd">
                <div class="sec-ico">📂</div>
                <span class="sec-tt">기도문 목록</span>
                <span class="sec-sub">모두 @(total)편</span>
            </div>

            <div class="pgrid">
                @foreach (var item in items)
                {
                    bool isToday = item.Id == todayDay;
                    string href = $"/BessingChild/DetailWords?Id={item.Id}";
                    string ex = excerpt(item.PrayText, 96);

                    <article class="pcard@(isToday ? " is-today" : "")">
                        <a class="pcard-hit" href="@href" aria-label="@item.PrayTitle 기도문 읽기"></a>

                        <div class="pcard-top">
                            @* 왼쪽 번호는 '그 달의 며칠에 읽는 기도문인지' 를 뜻합니다 *@
                            <span class="pcard-no">@(item.Id)일</span>
                            @if (isToday)
                            {
                                <span class="pcard-tag">오늘</span>
                            }
                        </div>

                        <h3 class="pcard-tt">@item.PrayTitle</h3>
                        @if (!string.IsNullOrEmpty(ex))
                        {
                            <p class="pcard-ex">@ex</p>
                        }

                        @* 운영 수치는 슈퍼 관리자에게만 — 없으면 아래 띠를 아예 그리지 않습니다 *@
                        @if (isSuperAdmin)
                        {
                            <div class="pcard-ft">
                                <span class="pcard-meta">
                                    👀 @item.visited.ToString("N0")@(item.updateDT.HasValue ? $" · ✏️ {item.updateDT.Value:MM-dd}" : "")
                                </span>
                            </div>
                        }

                        @if (isAdmin)
                        {
                            <div class="pcard-act">
                                <button type="button" class="row-btn" onclick="go('@href')">👁 보기</button>
                                <button type="button" class="row-btn" onclick="go('/BessingChild/ModifyView?Id=@item.Id')">✏️ 수정</button>
                                <button type="button" class="row-btn" onclick="go('/BessingChild/DecreasetHitWeeklyWordToRead?Id=@item.Id')">↺ 리셋</button>
                                @if (isSuperAdmin)
                                {
                                    <button type="button" class="row-btn del" onclick="confirmDelete('@item.Id', '@item.PrayTitle')">🗑 삭제</button>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }

        <div class="btn-row">
            <button class="btn btn-honey" onclick="location.href='/'">🏠 홈으로</button>
            <button class="btn btn-honey-soft" onclick="location.href='/PrayHome/Index'">🙏 기도홈</button>
        </div>

        @if (isSuperAdmin)
        {
            <div class="btn-row" style="margin-top:9px;">
                <button class="btn" onclick="location.href='/BessingChild/EnrollView'">✚ 새 기도문 등록</button>
            </div>
        }

    </div>

    <script>
        function go(url) { window.location.href = url; }

        /* 삭제는 되돌릴 수 없으므로 한 번 더 묻습니다 */
        function confirmDelete(id, title) {
            if (confirm('「' + title + '」 기도문을 삭제할까요?\n삭제하면 되돌릴 수 없습니다.')) {
                window.location.href = '/BessingChild/DeleteView?Id=' + id;
            }
        }
    </script>

</body>
</html>
