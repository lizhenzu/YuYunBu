@model BulletinBoard.Models.BessingChildData
@using BulletinBoard.Common
@*  ══════════════════════════════════════════════════════════════
    자녀 축복 기도문 — 새 기도문 등록
    · 2026-10-05 시안 확정 — 수정 화면과 같은 틀 (밝은 흰색)
    · 등록하면 EnrollProcess → 목록(DetailList)으로 돌아간다
    · 이전 화면은 EnrollView.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;
    ViewData["IdPfx"] = "e";
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>자녀 축복 기도문 등록</title>
    <partial name="_BcStyle" />
    <partial name="_BcFormStyle" />
</head>
<body>
<div class="pz">

    <div class="bar">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/BessingChild/DetailList">자녀 축복 기도문</a><span class="sep">›</span>새 기도문</span>
    </div>
    <div class="prog"></div>

    <div class="kk" style="margin-top:20px">자녀 축복 기도 · 등록</div>
    <h1 class="h1">새 기도문 등록</h1>

    <form method="post" action="/BessingChild/EnrollProcess" class="fm">
        @Html.AntiForgeryToken()
        <partial name="_BcForm" model="Model" view-data="ViewData" />
        <div class="acts">
            <a class="nb" href="/BessingChild/DetailList">목록으로</a>
            <button class="nb pri" type="submit">등록</button>
        </div>
    </form>

</div>
</body>
</html>
