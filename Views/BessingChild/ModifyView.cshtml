@model BulletinBoard.Models.BessingChildData
@using BulletinBoard.Common
@*  ══════════════════════════════════════════════════════════════
    자녀 축복 기도문 — 수정
    · 2026-10-05 시안 확정 — 사이트 공통 틀(초록 · 하늘색 버튼) 대신 따로 그린 밝은 흰색 화면
    · 저장하면 ModifyProcess → 그 기도문 화면(DetailWords?Id=)으로 돌아간다
    · 이전 화면은 ModifyView.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;
    ViewData["IdPfx"] = "m";
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>@(Model.Id)일 자녀 축복 기도문 수정</title>
    <partial name="_BcStyle" />
    <partial name="_BcFormStyle" />
</head>
<body>
<div class="pz">

    <div class="bar">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/BessingChild/DetailList">자녀 축복 기도문</a><span class="sep">›</span>@(Model.Id)일 수정</span>
        <a class="nb" href="/BessingChild/DetailWords?Id=@Model.Id">보기 →</a>
    </div>
    <div class="prog"></div>

    <div class="kk" style="margin-top:20px">자녀 축복 기도 · 수정</div>
    <h1 class="h1">@(Model.Id)일 기도문</h1>

    <form method="post" action="/BessingChild/ModifyProcess" class="fm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <partial name="_BcForm" model="Model" view-data="ViewData" />
        <div class="acts">
            <a class="nb" href="/BessingChild/DetailList">목록으로</a>
            <div class="grp">
                <a class="nb" href="/BessingChild/DetailWords?Id=@Model.Id" target="_blank" rel="noopener">미리 보기</a>
                <button class="nb pri" type="submit">저장</button>
            </div>
        </div>
    </form>

</div>
</body>
</html>
