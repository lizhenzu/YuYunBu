@* 자녀 축복 기도 — 수정 · 등록 화면 입력칸 스타일 (365 기도문 편집 화면과 같은 결) *@
<style>
    .fm { display: grid; gap: 14px; margin-top: 16px; }
    .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    @@media (max-width: 560px) { .row2 { grid-template-columns: 1fr; gap: 14px; } }
    label.l { display: block; font-size: 12px; color: var(--dim2); margin-bottom: 4px; }
    .in { width: 100%; font: inherit; font-size: 14px; padding: 12px 13px; border: 0; border-radius: 12px; background: var(--mark); color: var(--tx); }
    .in:focus { outline: none; background: #fff; box-shadow: inset 0 0 0 2px var(--acc); }
    textarea.in { min-height: 300px; line-height: 1.85; resize: vertical; }
    textarea.in.short { min-height: 120px; }
    .hint { margin-top: 5px; font-size: 11.5px; color: var(--dim); line-height: 1.7; }
    .hint code { font-family: inherit; background: var(--soft); color: var(--acc); border-radius: 4px; padding: 0 4px; font-weight: 700; }
    details.opt { border-top: 1px solid var(--rule); padding-top: 12px; }
    details.opt > summary { list-style: none; cursor: pointer; font-size: 13px; font-weight: 800; color: var(--tx); display: flex; justify-content: space-between; }
    details.opt > summary::-webkit-details-marker { display: none; }
    details.opt > summary span { font-size: 12px; font-weight: 700; color: var(--acc); }
    details.opt > summary span::after { content: "펼치기"; }
    details.opt[open] > summary span::after { content: "접기"; }
    details.opt[open] > summary { margin-bottom: 10px; }
    .acts { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; align-items: center; padding-top: 4px; }
    .acts .grp { display: flex; gap: 6px; flex-wrap: wrap; }
    .acts .nb { height: 46px; padding: 0 18px; border-radius: 14px; font-size: 14px; }
    .acts .nb.pri { min-width: 120px; font-weight: 800; }
</style>
