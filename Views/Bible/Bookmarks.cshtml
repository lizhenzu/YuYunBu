@model List<BibleReadingThrough.Models.UserBookMarkListItem>
@{ ViewData["Title"] = "북마크"; ViewData["Page"] = "bookmark"; }

<style>
/* ── 북마크 헤더 ── */
.bm-page-header {
    display:flex; align-items:center; justify-content:space-between;
    flex-wrap:wrap; gap:10px;
    margin-bottom:20px;
}
.bm-page-title {
    font-size:1.45rem; font-weight:900; color:var(--text);
    display:flex; align-items:center; gap:8px;
}
.bm-count-badge {
    display:inline-flex; align-items:center;
    background:var(--gold); color:#fff;
    padding:3px 12px; border-radius:999px;
    font-size:.82rem; font-weight:800;
}

/* ── 북마크 카드 ── */
.bm-list { display:flex; flex-direction:column; gap:10px; }

.bm-item {
    background:var(--card-bg);
    border:1px solid var(--border);
    border-left:4px solid var(--gold);
    border-radius:16px;
    padding:16px 18px;
    box-shadow:0 2px 8px rgba(0,0,0,.05);
    transition:box-shadow .18s, transform .18s;
    display:flex; gap:14px; align-items:flex-start;
}
.bm-item:hover {
    box-shadow:0 6px 20px rgba(0,0,0,.10);
    transform:translateY(-2px);
}
.bm-item-body { flex:1; min-width:0; }

.bm-item-ref {
    display:inline-flex; align-items:center; gap:5px;
    font-size:.78rem; font-weight:800;
    color:#b45309;
    background:#fef3c7; border-radius:999px;
    padding:3px 10px; margin-bottom:8px;
}
[data-theme="dark"] .bm-item-ref { background:#2a1f00; color:#fbbf24; }

.bm-item-text {
    font-size:.97rem; color:var(--text);
    line-height:1.75; word-break:keep-all;
    margin-bottom:6px;
}
.bm-item-date {
    font-size:.74rem; color:var(--text2);
}

/* ── 액션 버튼 영역 ── */
.bm-item-actions {
    display:flex; flex-direction:column;
    gap:8px; align-items:flex-end; flex-shrink:0;
}
.bm-read-btn {
    font-size:.8rem; padding:7px 14px;
    border-radius:50px;
    border:1.5px solid var(--border);
    color:var(--text); background:var(--card-bg);
    text-decoration:none; font-weight:700;
    white-space:nowrap;
    transition:all .15s;
}
.bm-read-btn:hover {
    border-color:var(--primary); color:var(--primary);
    background:var(--primary-light);
}
.bm-del-btn {
    background:none; border:1.5px solid var(--border);
    border-radius:50px; padding:6px 12px;
    color:var(--text2); cursor:pointer;
    font-size:.82rem; font-weight:700;
    transition:all .15s; white-space:nowrap;
}
.bm-del-btn:hover {
    background:#fee2e2; border-color:#ef4444; color:#ef4444;
}

/* ── 빈 상태 ── */
.bm-empty {
    text-align:center; padding:70px 20px;
    max-width:360px; margin:0 auto;
}
.bm-empty-icon { font-size:3.5rem; margin-bottom:14px; }
.bm-empty-title {
    font-size:1.1rem; font-weight:800;
    margin-bottom:8px; color:var(--text);
}
.bm-empty-sub { font-size:.88rem; color:var(--text2); line-height:1.65; margin-bottom:20px; }
.bm-empty-btn {
    display:inline-block; padding:11px 26px;
    background:var(--primary); color:#fff;
    border-radius:50px; font-weight:800; font-size:.93rem;
    text-decoration:none; transition:filter .15s, transform .15s;
}
.bm-empty-btn:hover { filter:brightness(1.1); transform:scale(1.03); color:#fff; }

/* ── 반응형 ── */
@@media (max-width:600px) {
    .bm-page-title { font-size:1.2rem; }
    .bm-item { padding:13px 14px; gap:10px; border-radius:13px; }
    /* 좁은 화면: 액션 버튼을 본문 아래로 이동 */
    .bm-item { flex-direction:column; }
    .bm-item-actions {
        flex-direction:row; align-items:center;
        justify-content:flex-end; width:100%;
    }
    .bm-item-text { font-size:.92rem; }
}
@@media (max-width:400px) {
    .bm-read-btn, .bm-del-btn { padding:6px 10px; font-size:.76rem; }
}
</style>

<!-- 헤더 -->
<div class="bm-page-header">
    <div class="bm-page-title">
        🔖 북마크한 구절
    </div>
    @if (Model.Any())
    {
        <span class="bm-count-badge">총 @Model.Count 개</span>
    }
</div>

@if (!Model.Any())
{
    <div class="bm-empty">
        <div class="bm-empty-icon">🔖</div>
        <div class="bm-empty-title">북마크한 구절이 없습니다</div>
        <div class="bm-empty-sub">
            성경 읽기 중 🔖 버튼을 눌러<br>
            마음에 드는 구절을 저장하세요
        </div>
        <a href="/Bible/Index" class="bm-empty-btn">📖 성경 읽으러 가기</a>
    </div>
}
else
{
    <div class="bm-list">
        @foreach (var bm in Model)
        {
            <div class="bm-item" id="bm-@bm.VerseId">
                <div class="bm-item-body">
                    <div class="bm-item-ref">🔖 @bm.BibleText @bm.Jang:@bm.Zul</div>
                    <div class="bm-item-text">@bm.VerseText</div>
                    <div class="bm-item-date">@bm.InsertDT.ToString("yyyy.MM.dd")</div>
                </div>
                <div class="bm-item-actions">
                    <a href="/Bible/Read?bookName=@Uri.EscapeDataString(bm.BibleText)&jang=@bm.Jang#vc-@bm.VerseId"
                       class="bm-read-btn">읽기 →</a>
                    <button class="bm-del-btn" onclick="delBm(@bm.VerseId)">🗑 삭제</button>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
function delBm(verseId) {
    if (!confirm('북마크를 삭제할까요?')) return;
    $.post('/Bible/ToggleBookmark', { verseId }, () => {
        const el = document.getElementById('bm-' + verseId);
        if (el) {
            el.style.transition = 'opacity .3s, transform .3s';
            el.style.opacity = '0';
            el.style.transform = 'translateX(20px)';
            setTimeout(() => el.remove(), 300);
        }
    });
}
</script>
}
