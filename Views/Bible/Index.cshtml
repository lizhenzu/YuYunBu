@using System
@using System.Globalization
@using BulletinBoard.Models
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@using BibleReadingThrough.Models
@model BibleReadingThrough.Models.DashboardViewModel
@{ ViewData["Title"] = "대시보드"; ViewData["Page"] = "home"; }



<!-- 통계 카드 4개 -->
<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-icon purple">🔥</div>
        <div>
            <div class="stat-label">연속 읽기</div>
            <div class="stat-value">@Model.StreakDays</div>
            <div class="stat-sub">일 연속</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon gold">📖</div>
        <div>
            <div class="stat-label">읽은 장</div>
            <div class="stat-value">@Model.ReadChapters</div>
            <div class="stat-sub">/ @Model.TotalChapters 장</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">✅</div>
        <div>
            <div class="stat-label">전체 진도</div>
            <div class="stat-value">@Model.ProgressPercent%</div>
            <div class="stat-sub">@Model.TotalReadDays 일 읽음</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue">🗓</div>
        <div>
            <div class="stat-label">오늘 날짜</div>
            <div class="stat-value" style="font-size:1.1rem">@DateHelper.GetKoreaNow().ToString("M/d")</div>
            <div class="stat-sub">@DateHelper.GetKoreaNow().ToString("dddd", new System.Globalization.CultureInfo("ko-KR"))</div>
        </div>
    </div>
</div>

<!-- 오늘의 말씀 -->
@if (!string.IsNullOrEmpty(Model.TodayVerseText))
{
    <div class="verse-of-day" style="background: linear-gradient(135deg,  #16a34a, #22c55e);">
        <div class="vod-label" style=" font-size: 18px; font-weight: 900;">📜 오늘의 말씀</div>
        <div class="vod-text">@Model.TodayVerseText</div>
        <div class="vod-ref">— @Model.TodayVerseRef</div>
    </div>
}
 

@if (Model.LastReadVerse != null)
{
    var lv = Model.LastReadVerse;
    var lvUrl = $"/Bible/Read?bookName={Uri.EscapeDataString(lv.BookName)}&jang={lv.Jang}#vc-{Uri.EscapeDataString(lv.BookName + lv.Jang + lv.Zul)}";

    <a href="@lvUrl" class="last-read-banner">
        <div class="lrb-content">

            <!-- 🔥 상단 강조 배너 -->
            <div class="lrb-header" style=" font-size: 18px; font-weight: 900;">
                📖 마지막으로 읽은 구절
            </div>

            <!-- 본문 -->
            <div class="lrb-body">
                <div class="lrb-text" style="margin-top : 5px;margin-bottom : 5px;">
                    @lv.VerseText
                </div>
                <div class="lrb-ref">
                    @lv.BookName @lv.Jang 장 @lv.Zul 절
                    <span class="lrb-date">· @lv.ReadDate.ToString("M/d HH:mm")</span>
                </div>
            </div>
        </div>

        <div class="lrb-arrow">▶</div>
    </a>
}

<!-- 2컬럼 레이아웃 -->
<div class="row g-4">
    <!-- 왼쪽: 진도 + 다음 읽을 곳 -->
    <div class="col-lg">
        <!-- 전체 진도 -->
        <div class="card-s mb-4">
            <div class="card-header-s">📊 통독 진도</div>
            <div style="padding:16px 20px">
                <div class="prog-wrap">
                    <div class="prog-label"><span>전체</span><span>@Model.ReadChapters / @Model.TotalChapters 장</span></div>
                    <div class="prog-track"><div class="prog-fill purple" style="width:@Model.ProgressPercent%"></div></div>
                </div>
                <div class="prog-wrap mt-3">
                    <div class="prog-label">
                        <span>📜 구약</span>
                        <span>@Model.OtRead / @Model.OtTotal 장 (@(Model.OtTotal==0?0:Math.Round((double)Model.OtRead/Model.OtTotal*100,1))%)</span>
                    </div>
                    <div class="prog-track"><div class="prog-fill gold" style="width:@(Model.OtTotal==0?0:(double)Model.OtRead/Model.OtTotal*100)%"></div></div>
                </div>
                <div class="prog-wrap mt-3">
                    <div class="prog-label">
                        <span>✨ 신약</span>
                        <span>@Model.NtRead / @Model.NtTotal 장 (@(Model.NtTotal==0?0:Math.Round((double)Model.NtRead/Model.NtTotal*100,1))%)</span>
                    </div>
                    <div class="prog-track"><div class="prog-fill green" style="width:@(Model.NtTotal==0?0:(double)Model.NtRead/Model.NtTotal*100)%"></div></div>
                </div>
            </div>
        </div>

        <!-- 다음 읽을 곳 -->
        @if (Model.NextToRead.Any())
        {
            <div class="card-s mb-4">
                <div class="card-header-s">▶ 다음에 읽을 곳</div>
                <div style="padding:16px 20px">
                    <div class="next-cards">
                        @foreach (var item in Model.NextToRead)
                        {
                            <a href="/Bible/Read?bookName=@Uri.EscapeDataString(item.BookName)&jang=@item.ChapterNumber" class="next-card">
                                <span class="next-card-icon">@(item.Testament=="신약"?"✨":"📜")</span>
                                <div>
                                    <div class="next-card-book">@item.BookName</div>
                                    <div class="next-card-ch">@item.ChapterNumber 장</div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card-s mb-4" style="padding:24px;text-align:center">
                <div style="font-size:2.5rem">🎉</div>
                <div style="font-size:1.2rem;font-weight:900;margin:8px 0">성경 전체 통독 완료!</div>
                <div style="color:var(--text2)">하나님의 말씀을 모두 읽으셨습니다.</div>
            </div>
        }
    </div>

    <!-- 오른쪽: 히트맵 -->
    <div class="col-lg-auto col-12">
        <div class="card-s mb-4 heatmap-card-wrap">
            <div class="card-header-s">📅 독서 캘린더 <small style="font-weight:400;color:var(--text2)">(최근 8주)</small></div>
            <div style="padding:12px 16px 16px">
                <!-- 캘린더 그리드 (중앙 정렬) -->
                <div style="width:fit-content;margin:0 auto">
                    <!-- 요일 헤더 -->
                    <div class="heatmap-row">
                        @foreach (var d in new[]{"일","월","화","수","목","금","토"})
                        {
                            <div class="heatmap-dow">@d</div>
                        }
                    </div>
                    @{
                        var firstDay = Model.Heatmap.First().Date;
                        var startDow = (int)firstDay.DayOfWeek;
                        var weeks = new List<List<HeatmapDay?>>();
                        var week = new List<HeatmapDay?>(new HeatmapDay?[startDow]);
                        foreach (var day in Model.Heatmap)
                        {
                            week.Add(day);
                            if (week.Count == 7) { weeks.Add(week); week = new(); }
                        }
                        if (week.Any()) { while (week.Count < 7) week.Add(null); weeks.Add(week); }
                    }
                    @foreach (var wk in weeks)
                    {
                        <div class="heatmap-row">
                            @foreach (var day in wk)
                            {
                                if (day == null)
                                {
                                    <div class="heatmap-empty"></div>
                                }
                                else
                                {
                                    <div class="heatmap-day @day.Level @(day.IsToday?"today":"")"
                                         title="@day.Date.ToString("M/d") — @day.ChaptersRead 장">
                                        @day.Date.Day
                                    </div>
                                }
                            }
                        </div>
                    }
                    <div style="display:flex;align-items:center;gap:8px;margin-top:10px;font-size:.75rem;color:var(--text2)">
                        <span>적음</span>
                        <div style="width:16px;height:16px;border-radius:4px;background:var(--bg3)"></div>
                        <div style="width:16px;height:16px;border-radius:4px;background:#bbf7d0"></div>
                        <div style="width:16px;height:16px;border-radius:4px;background:#4ade80"></div>
                        <div style="width:16px;height:16px;border-radius:4px;background:#16a34a"></div>
                        <span>많음</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 스트릭 배지 -->
        @if (Model.StreakDays > 0)
        {
            <div class="card-s" style="padding:20px;text-align:center">
                <div class="streak-badge" style="margin:0 auto 8px;width:fit-content">
                    🔥 @Model.StreakDays 일 연속 읽기!
                </div>
                <div style="color:var(--text2);font-size:.85rem">오늘도 말씀을 읽어 스트릭을 이어가세요!</div>
            </div>
        }
    </div>
</div>

<!-- 책별 진도 -->
<div class="card-s mt-section">
    <div class="card-header-s" style="justify-content:space-between">
        <span>📚 책별 진도</span>
        <div>
            <a href="/Bible/List?testament=구약" style="font-size:.82rem;color:var(--primary);margin-right:12px">구약 →</a>
            <a href="/Bible/List?testament=신약" style="font-size:.82rem;color:#3b82f6">신약 →</a>
        </div>
    </div>
    <div style="padding:16px">
        <div style="font-size:.82rem;font-weight:700;color:var(--text2);margin-bottom:10px">📜 구약</div>
        <div class="book-grid mb-4">
            @foreach (var b in Model.BookProgress.Where(x => x.Testament == "구약"))
            {
                <a href="/Bible/List?testament=구약#book=@Uri.EscapeDataString(b.Name)" class="book-tile @(b.IsComplete?"done-ot":"")">
                    <span class="book-tile-name">@b.Name</span>
                    <span class="book-tile-prog">@b.ReadChapters/@b.TotalChapters</span>
                    <div class="mini-prog"><div class="mini-prog-fill ot" style="width:@b.Pct%"></div></div>
                </a>
            }
        </div>
        <div style="font-size:.82rem;font-weight:700;color:var(--text2);margin-bottom:10px">✨ 신약</div>
        <div class="book-grid">
            @foreach (var b in Model.BookProgress.Where(x => x.Testament == "신약"))
            {
                <a href="/Bible/List?testament=신약#book=@Uri.EscapeDataString(b.Name)" class="book-tile @(b.IsComplete?"done-nt":"")">
                    <span class="book-tile-name">@b.Name</span>
                    <span class="book-tile-prog">@b.ReadChapters/@b.TotalChapters</span>
                    <div class="mini-prog"><div class="mini-prog-fill nt" style="width:@b.Pct%"></div></div>
                </a>
            }
        </div>
    </div>
</div>
