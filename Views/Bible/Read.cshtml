@model BibleReadingThrough.Models.BibleReadViewModel
@{
    ViewData["Title"] = $"{Model.BookName} {Model.Jang}장";
    ViewData["Page"] = Model.Testament == "신약" ? "nt" : "ot";
    bool isNt = Model.Testament == "신약";

    bool hasYt  = !string.IsNullOrEmpty(Model.YoutubeUrl);
    bool hasOv1 = Model.OverviewDetail != null &&
                  !string.IsNullOrWhiteSpace(Model.OverviewDetail.SummaryURL1);
    bool hasOv2 = Model.OverviewDetail != null &&
                  !string.IsNullOrWhiteSpace(Model.OverviewDetail.SummaryURL2);
    bool hasAnyMedia = hasYt || hasOv1 || hasOv2;
}

<div class="bible-reader">

    <div class="bible-header d-flex align-items-start justify-content-between flex-wrap gap-3">
        <div>
            <div class="bible-book-name">@Model.BookName</div>
            <div class="bible-chapter">@Model.Testament · @Model.Jang 장 · @Model.Verses.Count 절</div>
        </div>
        <div style="display:flex;align-items:center;gap:10px;padding-top:4px">
            <a href="/Bible/List?testament=@Model.Testament" style="color:var(--text2);font-size:.9rem">← 목록</a>
        </div>
    </div>

    @if (hasAnyMedia)
    {
        <div class="media-bar">
            <span class="media-bar-label">🎬 미디어</span>

            @if (hasYt)
            {
                <button class="media-btn media-btn--yt" type="button" onclick="openYoutube(event)">
                    <span class="media-btn-icon">🎧</span>
                    <span class="media-btn-text">
                        <span class="media-btn-title">유튜브 듣기</span>
                        <span class="media-btn-sub">@Model.BookName @Model.Jang 장</span>
                    </span>
                </button>
            }

            @if (hasOv1)
            {
                <button class="media-btn media-btn--ov1" type="button"
                        onclick="openOvYoutube('@Html.Raw(Model.OverviewDetail.SummaryURL1)', '관련 영상 1')">
                    <span class="media-btn-icon">🎬</span>
                    <span class="media-btn-text">
                        <span class="media-btn-title">개요 해설</span>
                        <span class="media-btn-sub">@Model.BookName 1</span>
                    </span>
                </button>
            }

            @if (hasOv2)
            {
                <button class="media-btn media-btn--ov2" type="button"
                        onclick="openOvYoutube('@Html.Raw(Model.OverviewDetail.SummaryURL2)', '관련 영상 2')">
                    <span class="media-btn-icon">🎬</span>
                    <span class="media-btn-text">
                        <span class="media-btn-title">개요 해설</span>
                        <span class="media-btn-sub">@Model.BookName 2</span>
                    </span>
                </button>
            }
        </div>
    }

    <div id="chapterDoneBanner" class="chapter-done-banner @(Model.IsChapterRead ? "show" : "")">
        이 페이지 다 읽었어요
    </div>

    <div class="mode-pills">
        <button class="mode-pill" data-mode="1" type="button" onclick="setMode(1)">🌱 한 절씩</button>
        <button class="mode-pill" data-mode="3" type="button" onclick="setMode(3)">📖 3절씩</button>
        <button class="mode-pill" data-mode="5" type="button" onclick="setMode(5)">📚 5절씩</button>
        <button class="mode-pill" data-mode="0" type="button" onclick="setMode(0)">📋 전체</button>
    </div>

    <div class="lang-pills">
        <button class="lang-pill" data-lang="all"    type="button" onclick="toggleLang('all')">모두</button>
        <button class="lang-pill" data-lang="ko"     type="button" onclick="toggleLang('ko')">🇰🇷 개역개정</button>
        <button class="lang-pill" data-lang="modern" type="button" onclick="toggleLang('modern')">📖 현대인</button>
        <button class="lang-pill" data-lang="en" type="button" onclick="toggleLang('en')">🌎 NIV</button>
    </div>

    <div class="chapter-pills">
        @foreach (var ch in Model.AllChapters)
        {
            string pillClass;
            if (ch == Model.Jang)
                pillClass = "cur";
            else if (Model.ReadChapters.Contains(ch))
                pillClass = "done";
            else
                pillClass = "unread";

            <a href="/Bible/Read?bookName=@Uri.EscapeDataString(Model.BookName)&jang=@ch"
               class="ch-pill @pillClass"
               title="@ch 장 @(Model.ReadChapters.Contains(ch) ? "✅ 완독" : "📖 미완")">@ch</a>
        }
    </div>

    <div class="reader-progress">
        <div class="prog-label">
            <span id="progLbl">📊 @Model.ReadVerseCount / @Model.Verses.Count 절</span>
            <span id="progPct">@(Model.Verses.Count == 0 ? 0 : Math.Round((double)Model.ReadVerseCount / Model.Verses.Count * 100, 0))%</span>
        </div>
        <div class="prog-track">
            <div class="prog-fill @(isNt ? "green" : "purple")"
                 id="progFill"
                 style="width:@(Model.Verses.Count == 0 ? 0 : (double)Model.ReadVerseCount / Model.Verses.Count * 100)%"></div>
        </div>
    </div>

    <div class="page-nav-r" id="pageNav" style="display:none">
        <button class="page-btn" id="prevPg" type="button" onclick="prevPage()">◀ 이전</button>
        <span id="pgInfo" style="color:var(--text2);font-size:.9rem"></span>
        <button class="page-btn" id="nextPg" type="button" onclick="nextPage()">다음 ▶</button>
    </div>

    @if (Model.BasicInfo != null || Model.OverviewDetail != null)
    {
        <div class="ov-card" id="ovCard">

            <button class="ov-head" type="button" onclick="ovToggleOpen()" aria-expanded="false" id="ovHead">
                <span class="ov-head-left">
                    <span class="ov-icon" aria-hidden="true">📖</span>
                    <span class="ov-title">@Model.BookName 개요</span>
                    <span class="ov-mode-badge" id="ovModeBadge">간략본</span>
                </span>
                <span class="ov-chevron" id="ovChevron" aria-hidden="true">▾</span>
            </button>

            <div class="ov-body" id="ovBody">

                <div class="ov-switch-bar">
                    <button class="ov-sw-btn ov-sw-active" id="ovBtnSimple" type="button"
                            onclick="ovSetMode('simple')">간략본</button>
                    <button class="ov-sw-btn" id="ovBtnDetail" type="button"
                            onclick="ovSetMode('detail')">상세본</button>
                </div>

                <div id="ovSimple">
                    @if (Model.BasicInfo != null)
                    {
                        @if (!string.IsNullOrWhiteSpace(Model.BasicInfo.Author))
                        {
                            <div class="ov-row">
                                <span class="ov-label">✍️ 저자</span>
                                <span class="ov-val">@Model.BasicInfo.Author</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.BasicInfo.WhenWritten))
                        {
                            <div class="ov-row">
                                <span class="ov-label">📅 기록 시기</span>
                                <span class="ov-val">@Model.BasicInfo.WhenWritten</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.BasicInfo.OverView))
                        {
                            <div class="ov-row">
                                <span class="ov-label">📜 개요</span>
                                <span class="ov-val">@Model.BasicInfo.OverView</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.BasicInfo.Purpose))
                        {
                            <div class="ov-row">
                                <span class="ov-label">🎯 기록 목적</span>
                                <span class="ov-val">@Model.BasicInfo.Purpose</span>
                            </div>
                        }
                    }
                </div>

                <div id="ovDetail" style="display:none">
                    @if (Model.OverviewDetail != null)
                    {
                        @if (!string.IsNullOrWhiteSpace(Model.OverviewDetail.Author))
                        {
                            <div class="ov-section">
                                <div class="ov-sec-title">✍️ 저자</div>
                                <div class="ov-sec-body">
                                    <strong>@Model.OverviewDetail.Author</strong>
                                    @if (!string.IsNullOrWhiteSpace(Model.OverviewDetail.AuthorDescription))
                                    {
                                        <p>@Model.OverviewDetail.AuthorDescription</p>
                                    }
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OverviewDetail.WrittenDateFrom))
                        {
                            <div class="ov-section">
                                <div class="ov-sec-title">📅 저작 연대</div>
                                <div class="ov-sec-body">
                                    @Model.OverviewDetail.WrittenDateFrom
                                    @if (!string.IsNullOrWhiteSpace(Model.OverviewDetail.WrittenDateTo))
                                    { <span> ~ @Model.OverviewDetail.WrittenDateTo</span> }
                                    @if (!string.IsNullOrWhiteSpace(Model.OverviewDetail.AlternativeDate))
                                    { <p>@Model.OverviewDetail.AlternativeDate</p> }
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OverviewDetail.WrittenPlace))
                        {
                            <div class="ov-section">
                                <div class="ov-sec-title">📍 기록 장소</div>
                                <div class="ov-sec-body">@Model.OverviewDetail.WrittenPlace</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OverviewDetail.WrittenTarget))
                        {
                            <div class="ov-section">
                                <div class="ov-sec-title">🎯 기록 대상</div>
                                <div class="ov-sec-body">@Model.OverviewDetail.WrittenTarget</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OverviewDetail.HistoricalBackground))
                        {
                            <div class="ov-section">
                                <div class="ov-sec-title">🕰️ 역사적 배경</div>
                                <div class="ov-sec-body">
                                    @if (!string.IsNullOrWhiteSpace(Model.OverviewDetail.HistoricalPeriod))
                                    { <p><strong>@Model.OverviewDetail.HistoricalPeriod</strong></p> }
                                    @Model.OverviewDetail.HistoricalBackground
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OverviewDetail.Keywords))
                        {
                            <div class="ov-section">
                                <div class="ov-sec-title">🔑 핵심어</div>
                                <div class="ov-sec-body">
                                    @foreach (var kw in Model.OverviewDetail.Keywords.Split(new[]{",","·","、"}, StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="ov-kw-chip">@kw.Trim()</span>
                                    }
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OverviewDetail.ContentSummary))
                        {
                            var contentLines = Model.OverviewDetail.ContentSummary
                                .Split(new[] { "\\n", "\n" }, StringSplitOptions.RemoveEmptyEntries);
                            var numberedItems = new List<string>();
                            var finalNote = "";
                            foreach (var ln in contentLines)
                            {
                                if (System.Text.RegularExpressions.Regex.IsMatch(ln.Trim(), @"^\d+\.\s"))
                                    numberedItems.Add(System.Text.RegularExpressions.Regex.Replace(ln.Trim(), @"^\d+\.\s*", ""));
                                else
                                    finalNote = ln.Trim();
                            }

                            <div class="ov-section">
                                <div class="ov-sec-title">📜 핵심 내용 요약</div>
                                <div class="ov-sec-body">
                                    @if (numberedItems.Any())
                                    {
                                        <ol class="ov-list">
                                            @foreach (var item in numberedItems)
                                            { <li>@item</li> }
                                        </ol>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(finalNote))
                                    {
                                        <p class="ov-final-note">💡 @finalNote</p>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    <div id="verseList">
        @{
            var summaryMap = new Dictionary<int, List<BibleReadingThrough.Models.EBibleSummary>>();
            foreach (var s in Model.Summaries)
            {
                int insertAtZul = s.FromJang < Model.Jang ? 1 : s.FromZul;
                if (!summaryMap.ContainsKey(insertAtZul))
                    summaryMap[insertAtZul] = new List<BibleReadingThrough.Models.EBibleSummary>();
                summaryMap[insertAtZul].Add(s);
            }
        }

        @for (int i = 0; i < Model.Verses.Count; i++)
        {
            var v = Model.Verses[i];

            @if (summaryMap.TryGetValue(v.Zul, out var summList))
            {
                foreach (var s in summList)
                {
                    <div class="summary-card" data-idx="@i">
                        <div class="summary-range">
                            📝 @s.BibleText @s.FromJang:@s.FromZul
                            @if (s.FromJang != s.ToJang || s.FromZul != s.ToZul)
                            {
                                <span class="summary-range-sep">~ @s.ToJang:@s.ToZul</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(s.BibleKeyWord))
                        {
                            <div class="summary-keyword" style="font-size:18px;font-weight:900;">🔑 @s.BibleKeyWord</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(s.BibleSummary))
                        {
                            <div class="summary-body" style="font-size:15px;font-weight:900;">@s.BibleSummary</div>
                        }
                    </div>
                }
            }

            <div class="verse-card-r @(v.IsRead ? "is-read" : "") @(v.IsBookmarked ? "bookmarked" : "")"
                 id="vc-@v.VerseId"
                 data-idx="@i"
                 data-zul="@v.Zul"
                 data-verse-id="@v.VerseId"
                 data-text="@Html.Raw(v.BibleData.Replace("\"", "&quot;"))"
                 style="scroll-margin-top:80px">
                <div class="vnum">@v.Zul</div>
                <div class="vtext-wrap">
                    <div class="vtext-ko-line">
                        <span class="vtext vtext-ko">@v.BibleData</span>
                        <span class="vactions-inline">
                            <button class="vbtn vbtn-read @(v.IsRead ? "done" : "unread")"
                                    id="vr-@v.VerseId"
                                    type="button"
                                    onclick="toggleVerse(@v.VerseId, this)">
                                @(v.IsRead ? "📖" : "📗")
                            </button>
                            <button class="vbtn vbtn-bm @(v.IsBookmarked ? "bm-on" : "")"
                                    id="vbm-@v.VerseId"
                                    type="button"
                                    onclick="toggleBm(@v.VerseId, this)">
                                @(v.IsBookmarked ? "📚" : "🔖")
                            </button>
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(v.BibleDataModern))
                    {
                        <div class="vtext-modern-line">
                            <span class="vtext-modern">@v.BibleDataModern</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(v.BibleDataEn))
                    {
                        <div class="vtext-en-line">
                            <span class="vtext-en">@v.BibleDataEn</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="mark-all-wrap">
        <button class="complete-mega @(Model.IsChapterRead ? "is-done" : "is-not-done")"
                id="completeMega"
                type="button"
                onclick="markAll('@Model.BookName', @Model.Jang)">
            <div class="cm-icon-circle" id="cmIconCircle">
                @(Model.IsChapterRead ? "📗" : "📖")
            </div>
            <div class="cm-body">
                <span class="complete-mega-title" id="completeMegaTitle">
                    @(Model.IsChapterRead ? "이 페이지 읽음으로 표시 취소 할까요?" : "이 페이지 읽음으로 표시 할까요?")
                </span>
                <span class="complete-mega-desc @(Model.IsChapterRead ? "desc-hide" : "")"
                      id="completeMegaDesc">(클릭하면 성경통독Board에 자동 반영돼요^^)</span>
            </div>
            <div class="cm-badge">
                <span class="complete-mega-count" id="completeMegaCount">오늘 읽은 총 절수 : @Model.TodayTotalReadCount 절</span>
                <span class="cm-arrow">→</span>
            </div>
        </button>
    </div>

    <div class="chapter-nav-r">
        @if (Model.PrevBook != null)
        {
            <a href="/Bible/Read?bookName=@Uri.EscapeDataString(Model.PrevBook)&jang=@Model.PrevJang">
                ← @Model.PrevBook @Model.PrevJang 장
            </a>
        }
        else
        {
            <span></span>
        }

        @if (Model.NextBook != null)
        {
            <a href="/Bible/Read?bookName=@Uri.EscapeDataString(Model.NextBook)&jang=@Model.NextJang" style="text-align:right">
                @Model.NextBook @Model.NextJang 장 →
            </a>
        }
    </div>

    <div class="dashboard-btn-wrap">
        <a href="/Bible" class="dashboard-btn">
            📊 대시보드로 이동
        </a>
        <a href="/Home/Index" class="dashboard-btn">
            🏠 홈으로
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.YoutubeUrl))
{
    <div id="ytModal" onclick="closeYoutube(event)">
        <div class="yt-modal-box" onclick="event.stopPropagation()">
            <div class="yt-modal-head">
                <div class="yt-modal-title">🎵 @Model.BookName @Model.Jang 장 듣기</div>
                <div class="yt-modal-controls">
                    <button class="yt-ctrl-btn yt-stop-btn" type="button" onclick="ytStop(event)">⏹ 정지</button>
                    <button class="yt-ctrl-btn yt-close-btn" type="button" onclick="closeYoutube(event)">✕ 닫기</button>
                </div>
            </div>
            <div class="yt-iframe-wrap">
                <div id="ytFrameHost"></div>
            </div>
            <div class="yt-modal-foot">
                <span id="ytStatusMsg">▶ 준비 중...</span>
                <span class="yt-loop-badge">∞ 무한 반복</span>
            </div>
        </div>
    </div>
}

<div id="ovYtModal" onclick="closeOvYoutube(event)">
    <div class="yt-modal-box" onclick="event.stopPropagation()">
        <div class="yt-modal-head">
            <div class="yt-modal-title" id="ovYtTitle">🎬 관련 영상</div>
            <div class="yt-modal-controls">
                <button class="yt-ctrl-btn yt-stop-btn" type="button" onclick="ovYtStop(event)">⏹ 정지</button>
                <button class="yt-ctrl-btn yt-close-btn" type="button" onclick="closeOvYoutube(event)">✕ 닫기</button>
            </div>
        </div>
        <div class="yt-iframe-wrap">
            <div id="ovYtFrameHost"></div>
        </div>
        <div class="yt-modal-foot">
            <span id="ovYtStatusMsg">▶ 준비 중...</span>
            <span class="yt-loop-badge">∞ 무한 반복</span>
        </div>
    </div>
</div>

<div id="loadingModal" style="display:none;position:fixed;inset:0;z-index:9999;
     background:rgba(0,0,0,.55);align-items:center;justify-content:center;">
    <div style="background:var(--card-bg);border-radius:20px;padding:36px 44px;
                text-align:center;box-shadow:0 12px 48px rgba(0,0,0,.35);min-width:220px;">
        <div style="display:flex;justify-content:center;margin-bottom:18px">
            <div id="loadSpinner" style="
                width:44px;height:44px;border-radius:50%;
                border:5px solid var(--border);
                border-top-color:#f97316;
                animation:spinAnim .75s linear infinite;"></div>
        </div>
        <div style="font-size:1.05rem;font-weight:800;color:var(--text);margin-bottom:6px">처리 중...</div>
        <div style="font-size:.85rem;color:var(--text2)">잠시만 기다려 주세요</div>
    </div>
</div>

<style>
    .media-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        padding: 12px 16px;
        margin: 8px 0 14px;
        background: var(--card-bg);
        border-radius: 16px;
        border: 1.5px solid var(--border);
        box-shadow: 0 2px 12px rgba(0,0,0,.07);
    }
    .media-bar-label {
        font-size: .72rem;
        font-weight: 900;
        color: var(--text2);
        letter-spacing: .06em;
        padding-right: 10px;
        border-right: 1.5px solid var(--border);
        margin-right: 2px;
        white-space: nowrap;
        align-self: center;
    }
    .media-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 16px;
        border-radius: 12px;
        border: none;
        cursor: pointer;
        font-family: inherit;
        text-align: left;
        transition: transform .15s, box-shadow .15s, filter .15s;
        flex-shrink: 0;
    }
    .media-btn:hover  { transform: translateY(-2px); filter: brightness(1.07); }
    .media-btn:active { transform: scale(.97); }
    .media-btn-icon { font-size: 1.4rem; line-height: 1; flex-shrink: 0; }
    .media-btn-text { display: flex; flex-direction: column; gap: 2px; }
    .media-btn-title { font-size: .88rem; font-weight: 900; color: #fff; line-height: 1.2; }
    .media-btn-sub   { font-size: .7rem; font-weight: 600; color: rgba(255,255,255,.78); line-height: 1; }
    .media-btn--yt  { background: linear-gradient(135deg, #ff2d2d 0%, #c40000 100%); box-shadow: 0 4px 14px rgba(196,0,0,.30); }
    .media-btn--ov1 { background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%); box-shadow: 0 4px 14px rgba(109,40,217,.28); }
    .media-btn--ov2 { background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%); box-shadow: 0 4px 14px rgba(79,70,229,.28); }

    /* ── 연속 사각형 버튼 그룹 ── */
    .lang-pills {
        display: inline-flex; flex-wrap: nowrap;
        margin: 6px 0 14px;
        border: 1.5px solid var(--border);
        border-radius: 10px; overflow: hidden;
        background: var(--card-bg);
    }
    .lang-pill {
        padding: 8px 15px;
        border: none; border-right: 1.5px solid var(--border);
        background: transparent; color: var(--text2);
        font-size: .82rem; font-weight: 600;
        cursor: pointer; transition: background .15s, color .15s;
        font-family: inherit; white-space: nowrap; line-height: 1.4;
    }
    .lang-pill:last-child { border-right: none; }
    .lang-pill:hover:not(.active) { background: var(--bg3); color: var(--text); }
    /* ── 활성 버튼: 번역별 배경 채움 ── */
    .lang-pill.active { font-weight: 900; color: #fff; }
    .lang-pill[data-lang="all"].active    { background: #475569; }  /* slate-600  */
    .lang-pill[data-lang="ko"].active     { background: #4f46e5; }  /* indigo-600 */
    .lang-pill[data-lang="modern"].active { background: #0284c7; }  /* sky-600    */
    .lang-pill[data-lang="en"].active     { background: #0d9488; }  /* teal-600   */

    .vtext-wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .vtext-ko-line { display: block; line-height: 1.9; }
    .vtext-ko-line .vtext-ko { display: inline; flex: none; font-size: 1.23rem; }
    .vactions-inline { display: inline-flex; align-items: center; gap: 3px; margin-left: 7px; vertical-align: middle; flex-shrink: 0; }
    .vactions-inline .vbtn { padding: 2px 5px; font-size: 1rem; border: none; border-radius: 6px; cursor: pointer; background: transparent; line-height: 1; transition: transform .12s, background .12s; }
