@section Scripts {
    <script>
        /* 글자 크기 4단계 — 저장 키 b2Fs */
        (function () {
            var MAP = { s: 0.9, m: 1, l: 1.18, xl: 1.36 }, KEY = 'b2Fs';
            function apply(k, save) {
                if (!MAP[k]) k = 'm';
                document.documentElement.style.setProperty('--b2fs', MAP[k]);
                document.querySelectorAll('.b2rFs button').forEach(function (b) {
                    var on = b.dataset.fs === k;
                    b.classList.toggle('on', on);
                    b.setAttribute('aria-pressed', on ? 'true' : 'false');
                });
                if (save) { try { localStorage.setItem(KEY, k); } catch (e) { } }
            }
            document.querySelectorAll('.b2rFs button').forEach(function (b) {
                b.addEventListener('click', function () { apply(b.dataset.fs, true); });
            });
            var saved = 'm';
            try { saved = localStorage.getItem(KEY) || 'm'; } catch (e) { }
            apply(saved, false);
        })();
    </script>    <script>
        (function () {
            var OV_MODE_KEY = 'bibleOvMode';
            var OV_OPEN_KEY = 'bibleOvOpen';

            function ovInit() {
                var savedMode = localStorage.getItem(OV_MODE_KEY) || 'simple';
                _applyMode(savedMode, false);
                if (localStorage.getItem(OV_OPEN_KEY) === '1') _setOpen(true, false);
            }
            function _setOpen(open, save) {
                var card = document.getElementById('ovCard');
                var head = document.getElementById('ovHead');
                if (!card) return;
                card.classList.toggle('is-open', open);
                if (head) head.setAttribute('aria-expanded', open ? 'true' : 'false');
                if (save) localStorage.setItem(OV_OPEN_KEY, open ? '1' : '0');
            }
            function _applyMode(mode, save) {
                var simple = document.getElementById('ovSimple');
                var detail = document.getElementById('ovDetail');
                var badge  = document.getElementById('ovModeBadge');
                var btnS   = document.getElementById('ovBtnSimple');
                var btnD   = document.getElementById('ovBtnDetail');
                if (!simple) return;
                var isDetail = (mode === 'detail');
                simple.style.display = isDetail ? 'none' : '';
                detail.style.display = isDetail ? ''     : 'none';
                if (badge) badge.textContent = isDetail ? '상세본' : '간략본';
                if (btnS)  btnS.classList.toggle('ov-sw-active', !isDetail);
                if (btnD)  btnD.classList.toggle('ov-sw-active',  isDetail);
                if (save) localStorage.setItem(OV_MODE_KEY, mode);
            }
            window.ovToggleOpen = function () {
                var card = document.getElementById('ovCard');
                if (!card) return;
                _setOpen(!card.classList.contains('is-open'), true);
            };
            window.ovSetMode = function (mode) { _applyMode(mode, true); };
            document.addEventListener('DOMContentLoaded', ovInit);
        })();

        (function () {
            function extractId(url) {
                if (!url) return null;
                var u = url.trim(), m;
                m = u.match(/[?&]v=([^&#\s]+)/);       if (m) return m[1];
                m = u.match(/youtu\.be\/([^?&#\s]+)/);  if (m) return m[1];
                m = u.match(/\/embed\/([^?&#\s]+)/);    if (m) return m[1];
                m = u.match(/\/shorts\/([^?&#\s]+)/);   if (m) return m[1];
                if (/^[A-Za-z0-9_-]{11}$/.test(u)) return u;
                return null;
            }
            function buildEmbed(videoId) {
                var p = new URLSearchParams({ autoplay:'1', loop:'1', playlist:videoId, start:'0', rel:'0', modestbranding:'1', playsinline:'1' });
                return 'https://www.youtube.com/embed/' + videoId + '?' + p.toString();
            }
            function setOvStatus(text) { var el = document.getElementById('ovYtStatusMsg'); if (el) el.textContent = text; }

            window.openOvYoutube = function (url, label) {
                var modal = document.getElementById('ovYtModal');
                var title = document.getElementById('ovYtTitle');
                var host  = document.getElementById('ovYtFrameHost');
                if (!modal || !host) return;
                if (title) title.textContent = (label || '관련 영상');
                var id = extractId(url);
                if (!id) {
                    setOvStatus('⚠️ 유튜브 주소가 올바르지 않습니다.');
                    host.innerHTML = '';
                } else {
                    host.innerHTML = '<iframe src="' + buildEmbed(id) + '" title="YouTube player" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>';
                    setOvStatus('▶ 무한 반복 재생 중...');
                }
                modal.style.display = 'flex';
            };
            window.ovYtStop = function (e) {
                if (e) { e.preventDefault(); e.stopPropagation(); }
                var host = document.getElementById('ovYtFrameHost');
                if (host) host.innerHTML = '';
                setOvStatus('⏹ 정지됨');
            };
            window.closeOvYoutube = function (e) {
                if (e) { e.preventDefault(); e.stopPropagation(); }
                var modal = document.getElementById('ovYtModal');
                if (modal) modal.style.display = 'none';
                var host  = document.getElementById('ovYtFrameHost');
                if (host) host.innerHTML = '';
                setOvStatus('⏹ 닫힘');
            };
        })();

        const BOOK  = '@Html.Raw(Model.BookName)';
        const JANG  = @Model.Jang;
        const TOTAL = @Model.Verses.Count;
        let todayTotal = @Model.TodayTotalReadCount;
        let mode    = parseInt(localStorage.getItem('bibleMode') ?? '0', 10);
        let curPage = 0;
        // ✅ 다중 토글 언어 선택 (Set 기반)
        function _loadLangSet() {
            var s = localStorage.getItem('bibleLang') || 'ko';
            if (s==='all'||s==='al')   return new Set(['ko','modern','en']);
            if (s==='both')            return new Set(['ko','en']);
            if (s==='ko+modern')       return new Set(['ko','modern']);
            var parts = s.split(',').filter(function(x){ return x==='ko'||x==='modern'||x==='en'; });
            return parts.length > 0 ? new Set(parts) : new Set(['ko']);
        }
        var activeLangs = _loadLangSet();
        function _saveLang(){ localStorage.setItem('bibleLang', Array.from(activeLangs).join(',')); }

        function toggleLang(l) {
            var ALL = ['ko','modern','en'];
            if (l === 'all') {
                activeLangs = ALL.every(function(x){ return activeLangs.has(x); }) ? new Set(['ko']) : new Set(ALL);
            } else {
                if (activeLangs.has(l)) { activeLangs.delete(l); if (activeLangs.size===0) activeLangs.add('ko'); }
                else activeLangs.add(l);
            }
            _saveLang(); applyLang();
        }

        function applyLang() {
            var showKo=activeLangs.has('ko'), showModern=activeLangs.has('modern'), showEn=activeLangs.has('en');
            var isAll = showKo && showModern && showEn;

            document.querySelector('[data-lang="all"]').classList.toggle('active', isAll);
            document.querySelector('[data-lang="ko"]').classList.toggle('active', showKo);
            document.querySelector('[data-lang="modern"]').classList.toggle('active', showModern);
            document.querySelector('[data-lang="en"]').classList.toggle('active', showEn);

            document.body.classList.remove('lang-ko','lang-en','lang-modern','lang-ko_modern','lang-all','lang-both');
            if (showKo&&!showModern&&!showEn)       document.body.classList.add('lang-ko');
            else if (!showKo&&showModern&&!showEn)  document.body.classList.add('lang-modern');
            else if (!showKo&&!showModern&&showEn)  document.body.classList.add('lang-en');

            document.querySelectorAll('.verse-card-r').forEach(function (card) {
                var koLine     = card.querySelector('.vtext-ko-line');
                var modernLine = card.querySelector('.vtext-modern-line');
                var enLine     = card.querySelector('.vtext-en-line');
                var koText     = card.querySelector('.vtext-ko');
                var actions    = card.querySelector('.vactions-inline');

                if (koText)     koText.style.display    = showKo     ? '' : 'none';
                if (modernLine) modernLine.style.display = showModern ? '' : 'none';
                if (enLine)     enLine.style.display     = showEn     ? '' : 'none';

                if (actions) {
                    if (!showKo && showModern && modernLine) modernLine.appendChild(actions);
                    else if (!showKo && !showModern && showEn && enLine) enLine.appendChild(actions);
                    else if (koLine) koLine.appendChild(actions);
                }
            });
        }

        let readSet = new Set(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Verses.Where(v => v.IsRead).Select(v => v.VerseId).ToList())));
        let bmSet   = new Set(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Verses.Where(v => v.IsBookmarked).Select(v => v.VerseId).ToList())));

        document.addEventListener('DOMContentLoaded', function () { applyMode(mode); applyLang(); checkMega(); scrollToTarget(); });

        function scrollToTarget() {
            const hash = location.hash;
            if (hash) { const el = document.querySelector(hash); if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; } }
            const firstUnread = [...document.querySelectorAll('.verse-card-r')].find(c => !c.classList.contains('is-read'));
            if (firstUnread) setTimeout(() => firstUnread.scrollIntoView({ behavior: 'smooth', block: 'center' }), 200);
        }

        function setMode(m) { mode = m; localStorage.setItem('bibleMode', m); curPage = 0; applyMode(m); }
        function applyMode(m) {
            document.querySelectorAll('.mode-pill').forEach(function (b) { b.classList.toggle('active', parseInt(b.dataset.mode, 10) === m); });
            const nav = document.getElementById('pageNav');
            if (m === 0) { nav.style.display = 'none'; showAll(); }
            else         { nav.style.display = 'flex'; showPage(0); }
        }
        function showAll() {
            document.querySelectorAll('.verse-card-r').forEach(c => c.style.display = '');
            document.querySelectorAll('.summary-card').forEach(s => s.style.display = '');
        }
        function showPage(p) {
            const cards     = document.querySelectorAll('.verse-card-r');
            const totalPage = Math.ceil(cards.length / mode);
            curPage = Math.max(0, Math.min(p, totalPage - 1));
            const startIdx  = curPage * mode;
            const endIdx    = (curPage + 1) * mode;
            cards.forEach((c, i) => { c.style.display = (i >= startIdx && i < endIdx) ? '' : 'none'; });
            document.querySelectorAll('.summary-card').forEach(s => {
                const idx = parseInt(s.dataset.idx, 10);
                s.style.display = (idx >= startIdx && idx < endIdx) ? '' : 'none';
            });
            document.getElementById('pgInfo').textContent = `${curPage + 1} / ${totalPage} 페이지`;
            document.getElementById('prevPg').disabled = curPage === 0;
            document.getElementById('nextPg').disabled = curPage >= totalPage - 1;
        }
        function prevPage() { showPage(curPage - 1); }
        function nextPage() { showPage(curPage + 1); }

        /* ── 절 읽음 · 책갈피 저장 대기 (B안) ──
           누르는 즉시 그 동그라미 안에서 금색 원이 돌고 그 절이 살짝 반짝인다.
           0.8초 넘게 걸리면 아래 알림 띠를 띄운다. 기다리는 동안 같은 버튼은 다시 못 누른다. */
        var _waitCnt = 0, _toastTimer = null;
        function beginWait(btn, card, msg) {
            if (btn.classList.contains('wait')) return false;
            btn.classList.add('wait');
            btn.disabled = true;
            if (card) card.classList.add('busy');
            _waitCnt++;
            clearTimeout(_toastTimer);
            _toastTimer = setTimeout(function () {
                if (_waitCnt > 0) {
                    var t = document.getElementById('b2rToast');
                    if (t) { t.querySelector('span.m').textContent = msg; t.classList.add('show'); }
                }
            }, 800);
            return true;
        }
        function endWait(btn, card) {
            btn.classList.remove('wait');
            btn.disabled = false;
            if (card) card.classList.remove('busy');
            _waitCnt = Math.max(0, _waitCnt - 1);
            if (_waitCnt === 0) {
                clearTimeout(_toastTimer);
                var t = document.getElementById('b2rToast');
                if (t) t.classList.remove('show');
            }
        }

        function toggleVerse(verseId, btn) {
            const card = btn.closest('.verse-card-r');
            if (!beginWait(btn, card, '읽음으로 표시하고 있어요')) return;
            $.post('/Bible2/ToggleVerse', { verseId }, function (d) {
                if (!card) return;
                if (d.isRead) { card.classList.add('is-read'); btn.classList.replace('unread','done'); btn.textContent = '✓'; readSet.add(verseId); }
                else          { card.classList.remove('is-read'); btn.classList.replace('done','unread'); btn.textContent = '✓'; readSet.delete(verseId); }
                if (d.todayTotal != null) todayTotal = d.todayTotal;
                updateProg(d.readVerses, d.totalVerses);
                checkMega();
            }).fail(function () {
                alert('저장하지 못했어요. 다시 눌러 주세요.');
            }).always(function () { endWait(btn, card); });
        }
        function toggleBm(verseId, btn) {
            const card = document.getElementById('vc-' + verseId);
            if (!beginWait(btn, card, '책갈피를 저장하고 있어요')) return;
            $.post('/Bible2/ToggleBookmark', { verseId }, function (d) {
                if (d.isBookmarked) { btn.classList.add('bm-on'); btn.textContent = '★'; card?.classList.add('bookmarked'); bmSet.add(verseId); }
                else                { btn.classList.remove('bm-on'); btn.textContent = '★'; card?.classList.remove('bookmarked'); bmSet.delete(verseId); }
            }).fail(function () {
                alert('저장하지 못했어요. 다시 눌러 주세요.');
            }).always(function () { endWait(btn, card); });
        }
        function showLoading() { const m = document.getElementById('loadingModal'); if (m) m.style.display = 'flex'; }
        function hideLoading() { const m = document.getElementById('loadingModal'); if (m) m.style.display = 'none'; }

        function markAllWithLoading(book, jang) {
            const btn = document.getElementById('completeMega');
            if (btn) btn.disabled = true;
            showLoading();
            $.post('/Bible2/ToggleChapter', { bookName: book, jang }, function (d) {
                if (d.isRead) {
                    document.querySelectorAll('.verse-card-r').forEach(function (c) {
                        c.classList.add('is-read');
                        const verseId = parseInt(c.dataset.verseId, 10);
                        readSet.add(verseId);
                        const vbtn = document.getElementById('vr-' + verseId);
                        if (vbtn) { vbtn.classList.replace('unread','done'); vbtn.textContent = '✓'; }
                    });
                    updateProg(d.readVerses ?? TOTAL, d.totalVerses ?? TOTAL);
                } else {
                    document.querySelectorAll('.verse-card-r').forEach(function (c) {
                        c.classList.remove('is-read');
                        const verseId = parseInt(c.dataset.verseId, 10);
                        readSet.delete(verseId);
                        const vbtn = document.getElementById('vr-' + verseId);
                        if (vbtn) { vbtn.classList.replace('done','unread'); vbtn.textContent = '✓'; }
                    });
                    updateProg(d.readVerses ?? 0, d.totalVerses ?? TOTAL);
                }
                if (d.todayTotal != null) todayTotal = d.todayTotal;
                checkMega();
            }).fail(function () {
                alert('처리 중 오류가 발생했습니다. 다시 시도해주세요.');
            }).always(function () {
                hideLoading();
                if (btn) btn.disabled = false;
            });
        }
        function markAll(book, jang) { markAllWithLoading(book, jang); }

        function updateProg(read, total) {
            const pct = total ? (read / total * 100) : 0;
            document.getElementById('progFill').style.width = pct + '%';
            document.getElementById('progLbl').textContent  = `${total}절 · ${read}절 읽음`;
            document.getElementById('progPct').textContent  = Math.round(pct) + '%';
        }

        function checkMega() {
            const btn    = document.getElementById('completeMega');
            const title  = document.getElementById('completeMegaTitle');
            const desc   = document.getElementById('completeMegaDesc');
            const count  = document.getElementById('completeMegaCount');
            const icon   = document.getElementById('cmIconCircle');
            const banner = document.getElementById('chapterDoneBanner');
            if (!btn || !title || !desc || !count || !banner) return;
            const isAllRead = TOTAL > 0 && readSet.size >= TOTAL;
            btn.classList.toggle('is-done',     isAllRead);
            btn.classList.toggle('is-not-done', !isAllRead);
            if (icon) icon.textContent = isAllRead ? '✓' : '→';
            title.textContent  = isAllRead ? '이 장 읽음 표시를 취소할까요?' : '이 장 읽음으로 표시';
            desc.style.display = isAllRead ? 'none' : 'block';
            count.textContent  = `오늘 읽은 절 ${todayTotal}`;
            banner.classList.toggle('show', isAllRead);
        }
    </script>

    @if (!string.IsNullOrEmpty(Model.YoutubeUrl))
    {
        // ⚠️ TimeMM/TimeSS 는 "동영상 길이"(bibleCenter 입력 화면 기준)다. 시작 위치로 쓰면 영상 끝에서 시작해 재생이 안 된다 → 항상 처음부터.
        var ytStartSec = 0;
        <script>
            (function () {
                const YT_URL   = '@Html.Raw(Model.YoutubeUrl)';
                const YT_START = @ytStartSec;

                function setStatus(text) { var el = document.getElementById('ytStatusMsg'); if (el) el.textContent = text; }
                function extractVideoId(url) {
                    if (!url) return null;
                    var u = url.trim(), m;
                    m = u.match(/[?&]v=([^&#\s]+)/);       if (m && m[1]) return m[1];
                    m = u.match(/youtu\.be\/([^?&#\s]+)/);  if (m && m[1]) return m[1];
                    m = u.match(/\/embed\/([^?&#\s]+)/);    if (m && m[1]) return m[1];
                    m = u.match(/\/shorts\/([^?&#\s]+)/);   if (m && m[1]) return m[1];
                    if (/^[A-Za-z0-9_-]{11}$/.test(u)) return u;
                    return null;
                }
                function buildYoutubeEmbedUrl(videoId, startSeconds) {
                    var params = new URLSearchParams({ autoplay:'1', loop:'1', playlist:videoId, start:String(startSeconds||0), rel:'0', modestbranding:'1', playsinline:'1' });
                    return 'https://www.youtube.com/embed/' + videoId + '?' + params.toString();
                }
                // ── YouTube IFrame API ──
                // 시작 시간(DB의 분·초)이 영상 길이 이상이면 끝에서 시작해 아무것도 안 나온다
                // (예: 출애굽기 1장 — 영상 2:38, 시작 2:38). 실제 길이를 보고 처음부터 재생한다.
                var ytPlayer = null, ytApiState = 0, ytApiWaiters = [];
                function loadYtApi(cb) {
                    if (window.YT && window.YT.Player) { cb(false); return; }
                    ytApiWaiters.push(cb);
                    if (ytApiState === 1) return;
                    ytApiState = 1;
                    var prevReady = window.onYouTubeIframeAPIReady;
                    window.onYouTubeIframeAPIReady = function () {
                        if (typeof prevReady === 'function') { try { prevReady(); } catch (_) { } }
                        ytApiState = 2;
                        ytApiWaiters.splice(0).forEach(function (f) { f(false); });
                    };
                    var s = document.createElement('script');
                    s.src = 'https://www.youtube.com/iframe_api';
                    s.onerror = function () { ytApiState = 0; ytApiWaiters.splice(0).forEach(function (f) { f(true); }); };
                    document.head.appendChild(s);
                }
                function ytDestroy() {
                    if (ytPlayer) { try { ytPlayer.destroy(); } catch (_) { } ytPlayer = null; }
                }
                function plainIframe(host, videoId) {
                    // API 를 못 쓰면 처음부터 반복 재생 (끝에서 시작하는 문제는 피한다)
                    host.innerHTML = '<iframe src="' + buildYoutubeEmbedUrl(videoId, 0) + '" title="YouTube audio player" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>';
                    setStatus('▶ 무한 반복 재생 중...');
                }
                // ── 아이폰 · 아이패드 ──
                // iOS 사파리는 "누른 그 순간" 안에서 재생을 시작해야만 소리 나는 자동 재생을 허락한다.
                // 기존 방식은 누른 뒤 API 를 불러오고 플레이어를 만든 다음(onReady) 재생해서, 그 순간이 지나 막혔다.
                // → iOS 에서는 페이지를 열 때 플레이어를 미리 만들어 두고(재생 안 함), 누르는 즉시 playVideo() 한다.
                var IS_IOS = /iPad|iPhone|iPod/.test(navigator.userAgent)
                             || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
                var warmReady = false, playCheck = null;
                function onEnded(ev) {                                          // 무한 반복
                    if (ev.data === YT.PlayerState.ENDED) { ev.target.seekTo(0, true); ev.target.playVideo(); }
                    if (ev.data === YT.PlayerState.PLAYING) { clearTimeout(playCheck); setStatus('▶ 무한 반복 재생 중...'); }
                }
                function watchPlay() {
                    // 그래도 막히면 (저전력 모드 등) 화면의 재생 버튼을 한 번 누르도록 알려 준다
                    clearTimeout(playCheck);
                    playCheck = setTimeout(function () {
                        var st = -1; try { st = ytPlayer.getPlayerState(); } catch (_) { }
                        if (st !== 1 && st !== 3) setStatus('▶ 화면의 재생 버튼을 눌러 주세요');
                    }, 1800);
                }
                function warmUp() {
                    var host = document.getElementById('ytFrameHost'), videoId = extractVideoId(YT_URL);
                    if (!host || !videoId || ytPlayer) return;
                    loadYtApi(function (failed) {
                        if (failed || ytPlayer) return;
                        host.innerHTML = '<div id="ytPlayerSlot"></div>';
                        ytPlayer = new YT.Player('ytPlayerSlot', {
                            videoId: videoId,
                            playerVars: { autoplay: 0, start: 0, rel: 0, modestbranding: 1, playsinline: 1 },
                            events: {
                                onReady: function () { warmReady = true; },
                                onStateChange: onEnded,
                                onError: function () { setStatus('⚠️ 이 영상은 지금 재생할 수 없습니다.'); }
                            }
                        });
                    });
                }
                if (IS_IOS) {
                    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', warmUp); else warmUp();
                }

                window.openYoutube = function (e) {
                    if (e) { e.preventDefault(); e.stopPropagation(); }
                    var modal   = document.getElementById('ytModal');
                    var host    = document.getElementById('ytFrameHost');
                    var videoId = extractVideoId(YT_URL);
                    if (modal) modal.style.display = 'flex';
                    if (IS_IOS && ytPlayer && warmReady) {
                        // 누른 순간 안에서 바로 재생 (iOS 자동 재생 허락 조건)
                        try { ytPlayer.seekTo(0, true); ytPlayer.playVideo(); } catch (_) { }
                        setStatus('⏳ 불러오는 중...');
                        watchPlay();
                        return false;
                    }
                    ytDestroy(); warmReady = false;
                    if (!videoId) {
                        setStatus('⚠️ 유튜브 주소가 올바르지 않습니다.');
                        if (host) host.innerHTML = '';
                        return false;
                    }
                    if (!host) return false;
                    host.innerHTML = '<div id="ytPlayerSlot"></div>';
                    setStatus('⏳ 불러오는 중...');
                    var fallback = setTimeout(function () { if (!ytPlayer && document.getElementById('ytPlayerSlot')) plainIframe(host, videoId); }, 6000);
                    loadYtApi(function (failed) {
                        if (!document.getElementById('ytPlayerSlot')) return;   // 닫았거나 이미 대체 재생 중
                        clearTimeout(fallback);
                        if (failed) { plainIframe(host, videoId); return; }
                        var start = YT_START > 0 ? YT_START : 0;
                        function fixStart(p) {
                            var d = 0; try { d = p.getDuration() || 0; } catch (_) { }
                            if (d > 0 && start >= d - 2) start = 0;             // 시작 시간이 영상 끝 → 처음부터
                        }
                        ytPlayer = new YT.Player('ytPlayerSlot', {
                            videoId: videoId,
                            playerVars: { autoplay: 1, start: start, rel: 0, modestbranding: 1, playsinline: 1 },
                            events: {
                                onReady: function (ev) {
                                    var before = start; fixStart(ev.target);
                                    if (start !== before) ev.target.seekTo(0, true);
                                    ev.target.playVideo();
                                    setStatus('▶ 무한 반복 재생 중...');
                                    if (IS_IOS) { warmReady = true; watchPlay(); }   // 미리 못 만든 경우 — 막히면 안내
                                },
                                onStateChange: function (ev) {
                                    if (ev.data === YT.PlayerState.PLAYING) { clearTimeout(playCheck); setStatus('▶ 무한 반복 재생 중...'); }
                                    if (ev.data === YT.PlayerState.ENDED) {                // 무한 반복
                                        fixStart(ev.target);
                                        ev.target.seekTo(start, true);
                                        ev.target.playVideo();
                                    }
                                },
                                onError: function () { setStatus('⚠️ 이 영상은 지금 재생할 수 없습니다.'); }
                            }
                        });
                    });
                    return false;
                };
                window.ytStop = function (e) {
                    if (e) { e.preventDefault(); e.stopPropagation(); }
                    clearTimeout(playCheck);
                    if (IS_IOS && ytPlayer && warmReady) {                         // iOS — 플레이어는 남겨 두고 멈춤만 (다시 누르면 바로 재생)
                        try { ytPlayer.pauseVideo(); } catch (_) { }
                        setStatus('⏹ 정지됨');
                        return false;
                    }
                    ytDestroy(); warmReady = false;
                    var host = document.getElementById('ytFrameHost');
                    if (host) host.innerHTML = '';
                    setStatus('⏹ 정지됨');
                    return false;
                };
                window.closeYoutube = function (e) {
                    if (e) { e.preventDefault(); e.stopPropagation(); }
                    clearTimeout(playCheck);
                    var modal = document.getElementById('ytModal');
                    if (modal) modal.style.display = 'none';
                    if (IS_IOS && ytPlayer && warmReady) {                         // iOS — 멈추고 창만 닫는다
                        try { ytPlayer.pauseVideo(); } catch (_) { }
                        setStatus('⏹ 닫힘');
                        return false;
                    }
                    ytDestroy(); warmReady = false;
                    var host  = document.getElementById('ytFrameHost');
                    if (host) host.innerHTML = '';
                    setStatus('⏹ 닫힘');
                    return false;
                };
            })();
        </script>
    }
}
