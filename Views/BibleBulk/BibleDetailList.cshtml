@model IEnumerable<BulletinBoard.Models.BibleQuizEnrollGroupInfo2>
@{
    ViewData["Title"] = "List";
}

<style>

    .text-right {
        text-align: right;
    }

    .card-typeA-body {
        font-family: 'Arial', sans-serif;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .card-typeA {
        background-color: white;
        width: 300px;
        margin: 3px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border-radius: 8px;
        overflow: hidden;
        transition: transform 0.2s;
    }

        .card-typeA:hover {
            transform: scale(1.05);
        }

    .card-typeA-content {
        padding: 5px;
    }

    .card-typeA-title {
        font-size: 20px;
        color: #333;
        margin-bottom: 5px;
    }

    .card-typeA-text {
        font-size: 16px;
        color: #666;
        line-height: 1.5;
    }
</style>
<h3>@ViewBag.screenName</h3>

@await Html.PartialAsync("_displayDynamicMenu")

<h2>@ViewBag.BibleText </h2>


<table class="table table-hover">
    <thead>
        <tr>
            <th>
                BibleText
            </th>
            <th>
                BibleJang (@ViewBag.Jang)
            </th>
            <th>
                작업
            </th>
            <th>
                건수
            </th>
            <th>
                건수
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            int loopCount = (int)@ViewBag.Jang;

        }

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <p>@item.Id</p>
                </td>
                @if (string.IsNullOrEmpty(@item.BibleText))
                {
                    <td>
                        <p>-</p>
                    </td>
                    <td>
                        <p>-</p>
                    </td>
                    <td>
                        <p>-</p>
                    </td>
                    <td>
                        <p>-</p>
                    </td>
                }
                else
                {
                    <td>
                        <p> @item.Jang</p>
                    </td>
                    <td>
                        <a href="/BibleBulk/BibleQuizEnrollList?BibleText=@ViewBag.BibleText&Jang=@item.Id&MaxJang=@loopCount"> 클릭 @item.Id </a>
                    </td>
                    <td>
                        <a href="/BibleBulk/BibleNullList?BibleText=@ViewBag.BibleText&Jang=@item.Id&MaxJang=@loopCount"> 클릭 @item.Id </a>
                    </td>
                    <td>
                        <p> @item.DCount</p>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
