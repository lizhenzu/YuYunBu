@model IEnumerable<BulletinBoard.Models.BibleMissingList>

@{
    ViewData["Title"] = "List";
}

<style>

    .text-right {
        text-align: right;
    }

    .card-typeA-body {
        font-family: 'Arial', sans-serif;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .card-typeA {
        background-color: white;
        width: 300px;
        margin: 3px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border-radius: 8px;
        overflow: hidden;
        transition: transform 0.2s;
    }

        .card-typeA:hover {
            transform: scale(1.05);
        }

    .card-typeA-content {
        padding: 5px;
    }

    .card-typeA-title {
        font-size: 20px;
        color: #333;
        margin-bottom: 5px;
    }

    .card-typeA-text {
        font-size: 16px;
        color: #666;
        line-height: 1.5;
    }
</style>
<h3>@ViewBag.screenName</h3>

@await Html.PartialAsync("_displayDynamicMenu")




<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BibleTextToPray)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BibleTextToPrayFromJang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Jang)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <p asp-display-for="@item.BibleTextToPray">@item.BibleTextToPray</p>
                </td>
                <td>
                    <p asp-display-for="@item.BibleTextToPrayFromJang">@item.BibleTextToPrayFromJang</p>
                </td>
                <td>
                    @if (@item.Jang <= 0)
                    {
                        <p onclick="location.href='/BibleBulk/EnrollView?BibleText=@item.BibleTextToPray&chapter=@item.BibleTextToPrayFromJang'"><font color="red">none</font></p>
                    }
                    else
                    {
                        <p asp-display-for="@item.Jang"> @item.Jang </p>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
