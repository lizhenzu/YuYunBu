@model IEnumerable<BulletinBoard.Models.BibleMissingListByLang>

@{
    ViewData["Title"] = "List";
}

<style>

    .text-right {
        text-align: right;
    }

    .card-typeA-body {
        font-family: 'Arial', sans-serif;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .card-typeA {
        background-color: white;
        width: 300px;
        margin: 3px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border-radius: 8px;
        overflow: hidden;
        transition: transform 0.2s;
    }

        .card-typeA:hover {
            transform: scale(1.05);
        }

    .card-typeA-content {
        padding: 5px;
    }

    .card-typeA-title {
        font-size: 20px;
        color: #333;
        margin-bottom: 5px;
    }

    .card-typeA-text {
        font-size: 16px;
        color: #666;
        line-height: 1.5;
    }
</style>
<h3>@ViewBag.screenName</h3>

@await Html.PartialAsync("_displayDynamicMenu")




<table class="table table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MA_BibleText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KO_Jang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EN_Jang)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <p asp-display-for="@item.MA_BibleText">@item.MA_BibleText</p>
                </td>
                @if (string.IsNullOrEmpty(@item.KO_BibleText))
                {
                    <td>
                        <p onclick="location.href='/BibleBulk/EnrollView?BibleText=@item.MA_BibleText&chapter=@item.MA_Jang&LangCD=ko'"><font color="red">none</font></p>
                    </td>
                    <td>
                        <p asp-display-for="@item.EN_Jang"> @item.EN_Jang </p>
                    </td>
                }
                else
                {
                    <td>
                        <p asp-display-for="@item.KO_Jang"> @item.KO_Jang </p>
                    </td>
                    <td>
                        <p onclick="location.href='/BibleBulk/EnrollView?BibleText=@item.MA_BibleText&chapter=@item.MA_Jang&LangCD=en'"><font color="red">none</font></p>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
