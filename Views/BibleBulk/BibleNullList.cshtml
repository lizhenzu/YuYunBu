@model IEnumerable<BulletinBoard.Models.BibleNullInfo>
@{
    ViewData["Title"] = "List";
}

<style>

    .text-right {
        text-align: right;
    }

    .card-typeA-body {
        font-family: 'Arial', sans-serif;
        margin: 0;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .card-typeA {
        background-color: white;
        width: 300px;
        margin: 3px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border-radius: 8px;
        overflow: hidden;
        transition: transform 0.2s;
    }

        .card-typeA:hover {
            transform: scale(1.05);
        }

    .card-typeA-content {
        padding: 5px;
    }

    .card-typeA-title {
        font-size: 20px;
        color: #333;
        margin-bottom: 5px;
    }

    .card-typeA-text {
        font-size: 16px;
        color: #666;
        line-height: 1.5;
    }
</style>
<h3>@ViewBag.screenName</h3>

@await Html.PartialAsync("_displayDynamicMenu")

<h2>@ViewBag.BibleText </h2>

<table class="table table-hover">
    <thead>
        <tr>
            <th>
               Id 
            </th>
            <th>
                Zul
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <p >@item.Id</p>
                </td>
                <td>
                    @if (@item.zul == 0)
                    {
                        <p></p>
                    }
                    else
                    {
                        <p>@item.zul</p>

                    }
                </td>
            </tr>
        }
    </tbody>
</table>
