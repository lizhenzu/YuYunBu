@model BulletinBoard.Models.BibleBulkQuiz
@using BulletinBoard.Common;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@inject IAuthService AuthService

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SQL 정보 입력</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #f4f7f9;
            font-family: 'Noto Sans KR', sans-serif;
        }

        header {
            background-color: #4caf50;
            color: white;
            padding: 1.5rem;
            text-align: center;
            font-size: 2rem;
            font-weight: bold;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .container {
            max-width: 600px;
            margin: 10px auto;
            padding: 25px;
        }

        label {
            font-weight: 600;
        }

        .form-row {
            margin-bottom: 15px;
        }

        .btn-group {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-top: 25px;
        }

        .form-group {
            margin-top: 10px;
            margin-bottom: 10px;
        }

        .form-row {
            margin-top: 10px;
            margin-bottom: 10px;
        }

        button {
            width: 100%;
        }

        @@media (max-width: 480px) {
            .form-inline .form-control {
                width: 100%;
                margin-top: 5px;
            }
        }
    </style>
</head>
<body>

    <header>
        <h1>SQL 입력</h1>
    </header>
    <form asp-action="CreateBulkQuiz" method="post" class="verse-form">
        <div class="container">

            <div class="form-group">
                <label asp-for="SQLs"></label>
                <textarea id="SQLs" name="SQLs" asp-for="SQLs" class="form-control" rows="7" autofocus></textarea>
                <span asp-validation-for="SQLs" class="text-danger"></span>
            </div>

            <div class="btn-group">
                <button type="submit" class="btn btn-success" onclick="save()">저장</button>
            </div>
        </div>
    </form>
    <div class="btn-group">
        <div class="btn btn-success" style="padding:3px;" onclick="location.href='/'">Home</div>
        <div class="btn btn-success" style="padding:3px;" onclick="location.href='/Admin/Index'">Manage</div>
        <div class="btn btn-success" style="padding:3px;" onclick="location.href='/BibleBulk/BibleMissingListB_KO_EN_SU'">Work</div>
    </div>
</body>
</html>