@* 도전! 성경통독 완독 선물 — 공통 테마(Bone) *@
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@300;400;500;600&family=Gothic+A1:wght@400;600;700&family=Inter:wght@300;400;500&display=swap">
<style>
:root{
  --bg:#F7F6F3; --tx:#16181C; --dim:#83868C; --dim2:#5C5F66;
  --rule:#E2E0DB; --line:#E7E5E1; --acc:#9A7B4F; --mark:#EDE5D8;
  --card:#fff; --head:#16181C; --headtx:#F7F6F3; --headk:#C9AE82; --headdim:#9A9690;
  --red:#B4531F; --gold:#D9C29B;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font-family:"Gothic A1",sans-serif;-webkit-text-size-adjust:100%}
a{text-decoration:none;color:inherit}
.gwrap{max-width:860px;margin:0 auto;padding:0 0 60px}
.ghd{background:var(--head);color:var(--headtx);padding:0 16px 20px}
.ghdNav{display:flex;gap:8px;flex-wrap:wrap;padding:15px 0 16px}
.ghdNav a{font-size:12.5px;color:var(--headdim);border:1px solid #3A3C40;padding:6px 12px}
.ghdNav a:hover{color:#16181C;background:var(--headk);border-color:var(--headk)}
.ghdK{font-size:10px;letter-spacing:.22em;color:var(--headk);font-weight:700}
.ghdT{font-family:"Noto Serif KR",serif;font-size:27px;margin:13px 0 0;font-weight:400;line-height:1.3}
.ghdT span{font-family:"Gothic A1",sans-serif;font-size:14px;color:var(--headk);margin-left:10px}
.ghdMeta{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-size:12px;color:var(--headdim);margin-top:16px;font-variant-numeric:tabular-nums}
.gbody{padding:0 14px}
.gflash{margin-top:14px;padding:11px 13px;font-size:13px;border-left:3px solid var(--acc);background:var(--mark);color:var(--dim2)}
.gflash.err{border-left-color:var(--red);color:var(--red);background:#F7EDE6}
.gnotice{background:var(--mark);border-left:3px solid var(--acc);padding:11px 13px;font-size:12.5px;color:var(--dim2);margin-top:16px;line-height:1.75}
.gnotice b{color:var(--acc)}
.gempty{margin-top:24px;padding:26px 14px;text-align:center;color:var(--dim);font-size:13px;background:var(--card);border:1px solid var(--line)}
.gnum{font-family:"Inter",sans-serif;font-variant-numeric:tabular-nums}
.gpill{display:inline-block;font-size:10.5px;padding:2px 8px;border:1px solid var(--rule);color:var(--dim2);white-space:nowrap}
.gpill.draft{border-color:var(--acc);color:var(--acc)}
.gpill.buy{background:var(--acc);border-color:var(--acc);color:#fff}
.gpill.wait{border-style:dashed}
.gpill.cancel{color:var(--red);border-color:#E7D2C4}
.gfoot{display:flex;justify-content:center;gap:20px;margin:26px 0 0}
.gfoot a{font-size:12.5px;color:var(--dim2);border-bottom:1px solid var(--rule);padding-bottom:2px}
.gfoot a:hover{color:var(--acc);border-color:var(--acc)}
@@media (max-width:560px){
  .ghd{padding:0 14px 18px}
  .ghdT{font-size:24px}
  .ghdMeta{flex-direction:column;gap:4px}
  .gbody{padding:0 12px}
  .gfoot{gap:14px;flex-wrap:wrap}
}
@@media (max-width:400px){ .ghdT{font-size:22px} .ghdNav a{padding:6px 10px;font-size:12px} }
</style>
