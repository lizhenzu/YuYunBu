@using BulletinBoard.Common;
@model BulletinBoard.ViewModels.Birthday.BirthdayEditVM
@{
    Layout = null;
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>생일 수정 - @Model.FullName</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* DailyMission4 밝은 흰색 버전 — 색은 직접 지정한다 */
        * { box-sizing: border-box; }
        html, body { margin: 0; }
        body { background: #FFFFFF; color: #374151; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: inherit; text-decoration: none; }
        button, input, select { font-family: inherit; }
        .wrap { max-width: 560px; margin: 0 auto; padding: 0 20px; }

        .bar { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 0 10px; border-bottom: 1px solid #EEF0F3; font-size: 12px; color: #9CA3AF; }
        .bar a, .bar button { color: inherit; background: none; border: 0; padding: 0; font: inherit; cursor: pointer; }
        .bar a:hover, .bar button:hover { color: #2F80ED; }
        .hdK { margin-top: 18px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
        .hdT { margin: 6px 0 0; font-size: 24px; font-weight: 800; line-height: 1.35; letter-spacing: -.02em; color: #111827; }

        .who { display: flex; gap: 14px; align-items: center; margin-top: 18px; }
        .av { width: 64px; height: 64px; border-radius: 50%; background: #EAF2FD; object-fit: cover; flex: 0 0 auto; display: block; }
        .nm { font-size: 18px; font-weight: 800; color: #111827; }
        .mt { margin-top: 3px; font-size: 12px; color: #9CA3AF; }
        .now { display: inline-block; margin-top: 8px; padding: 3px 10px; border-radius: 999px; background: #EAF2FD; color: #2B5FA8; font-size: 12px; font-weight: 700; }

        .sec { margin-top: 20px; padding-top: 6px; border-top: 1px solid #EEF0F3; }
        .field { margin-top: 14px; }
        label { display: block; font-size: 12.5px; font-weight: 700; color: #6B7280; }
        input, select { display: block; width: 100%; margin-top: 6px; padding: 11px 16px; border: 0; border-radius: 999px; background: #F4F6F9; color: #111827; font-size: 15px; outline: none; }
        input:focus, select:focus { box-shadow: 0 0 0 2px #CFE0FA; }
        input[readonly] { color: #9CA3AF; }
        input::placeholder { color: #9CA3AF; }
        .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 12px; }
        .note { margin-top: 14px; font-size: 12px; color: #9CA3AF; line-height: 1.6; }

        .act { display: flex; gap: 8px; margin-top: 24px; }
        .btn { flex: 1; border: 0; border-radius: 999px; background: #F4F6F9; color: #6B7280; font-size: 14px; font-weight: 700; padding: 13px 14px; cursor: pointer; }
        .btn:hover { color: #2F80ED; }
        .btn.pri { flex: 2; background: #2F80ED; color: #fff; font-weight: 800; }
        .btn.pri:hover { background: #1F6FDB; color: #fff; }
        .ft { margin-top: 24px; padding: 14px 0 40px; border-top: 1px solid #EEF0F3; font-size: 11.5px; color: #9CA3AF; }
    </style>
</head>
<body>
<div class="wrap">
    <div class="bar">
        <button type="button" onclick="history.back()">‹ 돌아가기</button>
        <a href="/Birthdays/Year">연간</a>
    </div>

    <div class="hdK">잠실새내 유년부 입니다.</div>
    <h1 class="hdT">생일 수정</h1>

    <div class="who">
        <img class="av" src="@Model.ProfileImageUrl" alt="" onerror="this.style.visibility='hidden';" />
        <div style="min-width:0;">
            <div class="nm">@Model.FullName</div>
            @if (!string.IsNullOrWhiteSpace(Model.UserName))
            {
                <div class="mt">@Model.UserName</div>
            }
            <span class="now">현재 @(Model.BMonth)월 @(Model.BDay)일</span>
        </div>
    </div>

    <form method="post" action="/Birthdays/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="PersonId" value="@Model.PersonId" />

        <div class="sec">
            <div class="two">
                <div class="field">
                    <label for="bMonth">생일 월</label>
                    <select id="bMonth" name="BMonth" required>
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(Model.BMonth == m)">@(m)월</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="bDay">생일 일</label>
                    <select id="bDay" name="BDay" required>
                        @for (int d = 1; d <= 31; d++)
                        {
                            <option value="@d" selected="@(Model.BDay == d)">@(d)일</option>
                        }
                    </select>
                </div>
            </div>

            <div class="field">
                <label for="bYear">출생년도 (선택)</label>
                <input id="bYear" type="number" name="BYear" value="@(Model.BYear ?? 0)" min="0" max="2100" />
            </div>

            <div class="field">
                <label for="plusMins">plusMins (선택)</label>
                <input id="plusMins" name="PlusMins" value="@Model.PlusMins" maxlength="1" placeholder="예: Y/N 또는 0/1 등" />
            </div>

            <div class="field">
                <label for="publishYN">생일 공개 여부</label>
                <select id="publishYN" name="PublishYN">
                    <option value="Y" selected="@(Model.PublishYN == "Y")">공개</option>
                    <option value="N" selected="@(Model.PublishYN == "N")">비공개</option>
                </select>
            </div>
        </div>

        <div class="sec">
            <div class="field">
                <label>연락처 (보기 전용)</label>
                <input value="@($"{Model.PhoneNumber} {(!string.IsNullOrWhiteSpace(Model.PhoneNumber2) ? "· " + Model.PhoneNumber2 : "")}")" readonly />
            </div>
            <div class="field">
                <label>주소 (보기 전용)</label>
                <input value="@Model.HomeAaddress" readonly />
            </div>
            <div class="field">
                <label>학교 (보기 전용)</label>
                <input value="@Model.School" readonly />
            </div>
            <p class="note">이 화면에서는 생일 관련 값만 바뀝니다. 이름, 연락처, 주소, 학교는 그대로예요.</p>
        </div>

        <div class="act">
            <button class="btn" type="button" onclick="history.back()">취소</button>
            <button class="btn pri" type="submit">저장</button>
        </div>
    </form>

    <div class="ft">© 유년부 · 생일</div>
</div>
</body>
</html>
