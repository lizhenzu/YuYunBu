                   border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
    .qz .dow div:first-child { color: var(--sun); }
    .qz .dow div:last-child  { color: var(--sat); }
    .qz .cells { display: grid; grid-template-columns: repeat(7, 1fr); }
    .qz .c { min-height: 104px; padding: 7px 8px 8px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); background: #fff; }
    .qz .c.out { background: transparent; }
    .qz .c.today { background: var(--mark); }
    .qz .c.sel { outline: 1px solid var(--tx); outline-offset: -1px; }
    .qz .dn { font-family: "Inter", sans-serif; font-weight: 300; font-size: 15px; color: var(--tx); line-height: 1;
              display: flex; justify-content: space-between; align-items: baseline; }
    .qz .dn u { text-decoration: none; font-size: 9px; letter-spacing: .1em; color: var(--dim); }
    .qz .c.sun .dn { color: var(--sun); }
    .qz .c.sat .dn { color: var(--sat); }
    .qz .c.out .dn { color: var(--rule); }
    .qz .p { margin-top: 7px; padding-top: 6px; border-top: 1px dashed var(--rule); }
    .qz .p:first-of-type { margin-top: 8px; border-top: 0; padding-top: 0; }
    .qz .p.click { cursor: pointer; }
    .qz .pn { font-family: "Noto Serif KR", serif; font-size: 12.5px; line-height: 1.3; word-break: keep-all; }
    .qz .pn i { display: inline-block; width: 7px; height: 7px; border-radius: 50%; border: 1px solid var(--acc); margin-right: 5px; vertical-align: 1px; }
    .qz .pn i.f { background: var(--acc); }
    .qz .pc { font-size: 9.5px; color: var(--dim); margin-top: 1px; letter-spacing: .02em; }
    .qz .p.click:hover .pn { color: var(--acc); }
    .qz .dots { display: none; gap: 3px; flex-wrap: wrap; margin-top: 5px; }
    .qz .dots i { width: 6px; height: 6px; border-radius: 50%; border: 1px solid var(--acc); display: inline-block; }
    .qz .dots i.f { background: var(--acc); }

    /* ── 명단(장부) ── */
    .qz .listHead { display: flex; justify-content: space-between; align-items: baseline; font-size: 11.5px; color: var(--dim); margin: 14px 0 0; }
    .qz .listHead a { color: var(--dim2); text-decoration: none; font-size: 10.5px; letter-spacing: .1em; }
    .qz .listHead a:hover { color: var(--acc); }
    .qz .listHead[hidden] { display: none; }
    .qz .row { display: flex; gap: 14px; padding: 14px 2px; border-top: 1px solid var(--rule); align-items: flex-start; }
    .qz .row:last-of-type { border-bottom: 1px solid var(--rule); }
    .qz .rd { width: 52px; flex: 0 0 auto; }
    .qz .rd b { display: block; font-family: "Inter", sans-serif; font-weight: 300; font-size: 22px; color: var(--acc); line-height: 1; }
    .qz .rd span { font-family: "Inter", sans-serif; font-size: 10px; color: var(--dim); letter-spacing: .08em; }
    .qz .av { width: 40px; height: 40px; border-radius: 50%; background: var(--mark); border: 1px solid var(--rule); flex: 0 0 auto; object-fit: cover; display: block; }
    .qz .rt { flex: 1 1 auto; min-width: 0; }
    .qz .nm { font-family: "Noto Serif KR", serif; font-size: 15.5px; line-height: 1.3; word-break: keep-all; }
    .qz .mt { font-size: 11px; color: var(--dim); margin-top: 2px; line-height: 1.7; display: flex; flex-wrap: wrap; }
    .qz .mt > span + span::before { content: "|"; color: var(--rule); margin: 0 6px; }
    .qz .memo { margin-top: 6px; padding: 6px 10px; background: var(--mark); font-size: 11px; line-height: 1.6; color: var(--dim2); white-space: pre-wrap; }
    .qz .ra { display: flex; gap: 4px; align-items: center; flex: 0 0 auto; }
    .qz .ra b { font-weight: 600; font-size: 10px; letter-spacing: .04em; padding: 3px 7px; border: 1px solid var(--rule); color: var(--dim); white-space: nowrap; }
    .qz .ra b.on { border-color: var(--acc); color: var(--acc); background: var(--mark); }
    .qz .ra button { font: inherit; font-size: 10px; letter-spacing: .1em; color: var(--dim2); background: none; border: 0; padding: 0; margin-left: 8px; cursor: pointer; white-space: nowrap; }
    .qz .ra button:hover { color: var(--acc); }
    .qz .empty { padding: 26px 0; text-align: center; font-size: 12.5px; color: var(--dim); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }

    .qz .brFoot { margin-top: 28px; padding-top: 12px; border-top: 1px solid var(--rule);
                  display: flex; justify-content: space-between; font-size: 10.5px; color: var(--dim); letter-spacing: .08em; }
    .qz .brFoot a { color: var(--dim2); text-decoration: none; }
    .qz .brFoot a:hover { color: var(--acc); }

    /* ── 수정 시트 · 사진 크게 ── */
    .mask { display: none; position: fixed; inset: 0; background: rgba(22,24,28,.55); z-index: 9000; align-items: center; justify-content: center; padding: 16px; }
    .mask.show { display: flex; }
    .sheet { background: #F7F6F3; border: 1px solid #16181C; width: 100%; max-width: 440px; max-height: 92vh; overflow: auto; padding: 18px 20px 16px;
             font-family: "Gothic A1", "Malgun Gothic", system-ui, sans-serif; color: #16181C; text-align: left; }
    .sheet .sh { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #E2E0DB; padding-bottom: 12px; }
    .sheet .sh .k { font-size: 10px; letter-spacing: .24em; color: #9A7B4F; font-weight: 600; }
    .sheet .sh button { font: inherit; font-size: 10px; letter-spacing: .1em; color: #5C5F66; background: none; border: 0; padding: 0; cursor: pointer; }
    .sheet .sp { display: flex; gap: 12px; align-items: center; margin-top: 14px; }
    .sheet .sp img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background: #EDE5D8; border: 1px solid #E2E0DB; }
    .sheet .sp .nm { font-family: "Noto Serif KR", serif; font-size: 17px; }
    .sheet .sp .mt { font-size: 11px; color: #83868C; margin-top: 2px; }
    .sheet .sg { display: flex; gap: 10px; align-items: center; margin-top: 12px; padding: 10px 0; border-top: 1px solid #E2E0DB; border-bottom: 1px solid #E2E0DB; }
    .sheet .sg img { width: 48px; height: 48px; object-fit: cover; background: #EDE5D8; border: 1px solid #E2E0DB; flex: 0 0 auto; cursor: zoom-in; display: block; }
    .sheet .sg .gn { font-size: 13px; line-height: 1.35; }
    .sheet .sg .gd { font-size: 10.5px; color: #83868C; margin-top: 2px; line-height: 1.5; }
    .sheet .sf { margin-top: 14px; }
    .sheet .sf label { display: block; font-size: 10px; letter-spacing: .16em; color: #83868C; margin-bottom: 6px; font-weight: 600; }
    .sheet textarea { width: 100%; box-sizing: border-box; border: 1px solid #E2E0DB; background: #fff; padding: 9px 10px; font: inherit; font-size: 12.5px; line-height: 1.6; resize: vertical; min-height: 64px; outline: none; }
    .sheet textarea:focus { border-color: #9A7B4F; }
    .sheet .cnt { text-align: right; font-family: "Inter", sans-serif; font-weight: 300; font-size: 10px; color: #83868C; margin-top: 3px; }
    .sheet .tg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 12px; }
    .sheet .tg label { display: block; font-size: 10.5px; letter-spacing: .06em; padding: 9px 0; text-align: center; border: 1px solid #E2E0DB; background: #fff; color: #83868C; cursor: pointer; user-select: none; }
    .sheet .tg label::before { content: "○ "; }
    .sheet .tg input { position: absolute; opacity: 0; width: 0; height: 0; }
    .sheet .tg input:checked + label { border-color: #9A7B4F; color: #9A7B4F; background: #EDE5D8; }
    .sheet .tg input:checked + label::before { content: "● "; }
    .sheet .sfoot { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; gap: 8px; }
    .sheet .sfoot span { font-size: 10px; color: #83868C; letter-spacing: .08em; }
    .sheet .btn { border: 1px solid #16181C; background: #16181C; color: #F7F6F3; padding: 9px 16px; font: inherit; font-size: 10.5px; font-weight: 600; letter-spacing: .1em; cursor: pointer; }
    .sheet .btn:hover { background: #9A7B4F; border-color: #9A7B4F; }
    .sheet .btn.line { background: transparent; color: #5C5F66; border-color: #D6CBB7; margin-right: 6px; }
    .sheet .btn.line:hover { color: #9A7B4F; border-color: #9A7B4F; background: transparent; }
    .sheet .noauth { padding: 18px 0; font-size: 12.5px; color: #5C5F66; }
    .imgBox { position: relative; background: #F7F6F3; border: 1px solid #E2E0DB; padding: 14px; max-width: 560px; width: 100%; }
    .imgBox img { display: block; width: 100%; max-height: 72vh; object-fit: contain; background: #fff; }
    .imgBox button { position: absolute; top: 14px; right: 14px; border: 1px solid #16181C; background: #16181C; color: #F7F6F3; font: inherit; font-size: 10px; letter-spacing: .1em; padding: 4px 9px; cursor: pointer; }

    /* ── 모바일 : 달력 칸은 숫자 + 점만, 명단은 아래에 ── */
    @@media (max-width: 640px) {
        .qz .c { min-height: 46px; padding: 5px 5px 6px; }
        .qz .dn { font-size: 12px; }
        .qz .dn u { display: none; }
        .qz .p { display: none; }
        .qz .dots { display: flex; }
        .qz .dow div { padding: 5px 4px; font-size: 9px; letter-spacing: .08em; }
        .qz .mStrip a { font-size: 11px; padding: 8px 0 7px; }
        .qz .mStrip a.far { display: none; }
        .qz .row { gap: 10px; flex-wrap: wrap; }
        .qz .ra { width: 100%; margin-top: 6px; padding-left: 62px; }
    }
    @@media (min-width: 641px) {
        .qz .c[data-day] { cursor: default; }
    }

    /* ── 인쇄 : 달력만 ── */
    @@media print {
        body { background: #fff; }
        .qz { max-width: none; padding: 0; }
        .qz .qzBar, .qz .tools, .qz .mStrip, .qz .listWrap, .qz .brFoot, .qz .bdMsg { display: none !important; }
        .qz .calWrap { display: block !important; }
        .qz .c { min-height: 90px; background: #fff; }
        .qz .c.today { background: #fff; }
    }
</style>
</head>
<body>

<div class="qz">
    <div class="qzBody">

        <div class="qzBar">
            <div>
                <a class="qzHome" href="/">@ConstatsCommon.ToHome</a><span class="qzHomeSep">·</span><span class="qzStepNo"><em>생일</em></span>
            </div>
            <div class="qzDate">@dateText</div>
        </div>

        <div class="brK">BIRTHDAYS</div>
        <div class="brH1"><b>@(month)월 생일자</b><small>@(items.Count) NAMES</small></div>
        <div class="brSum">
            ClassInfo @year 명단 기준
            @if (isStaff) { <text>· 이름을 누르면 메모 · 문자 · 선물 상태를 고칠 수 있어요</text> }
        </div>

        @if (!string.IsNullOrWhiteSpace(toast))
        {
            <div class="bdMsg">@toast</div>
        }

        <div class="mStrip">
            @for (int m = 1; m <= 12; m++)
            {
                var far = Math.Abs(m - month) > 2;   // 모바일에선 앞뒤 두 달만
                <a href="/Birthdays/Month?month=@m" class="@(m == month ? "on" : "") @(far ? "far" : "")">@m.ToString("00")</a>
            }
        </div>

        <div class="tools">
            <div class="toolsL">
                <div class="seg">
                    <button type="button" id="btnCal" class="on">달력</button>
                    <button type="button" id="btnList">명단</button>
                </div>
                <div class="legend"><span><i class="f"></i>선물 골랐음</span><span><i></i>아직</span></div>
            </div>
            <div class="links">
                <a href="/Birthdays/NoBirthday">미지정 →</a>
                <a href="/Birthdays/Year">연간 →</a>
                <button type="button" onclick="window.print()">인쇄 →</button>
            </div>
        </div>

        @if (items.Count == 0)
        {
            <div class="empty">@(month)월에는 생일인 친구가 없어요. 다른 달을 골라 보세요.</div>
        }
        else
        {
            <div class="calWrap" id="calView">
                <div class="cal">
                    <div class="dow"><div>SUN</div><div>MON</div><div>TUE</div><div>WED</div><div>THU</div><div>FRI</div><div>SAT</div></div>
                    <div class="cells" id="calCells"></div>
                </div>
                <div class="listHead" id="dayHead" hidden>
                    <span id="dayHeadText"></span>
                    <a href="#" id="dayHeadAll">전체 보기</a>
                </div>
                <div id="dayList"></div>
            </div>

            <div class="listWrap" id="listView" style="display:none;">
                <div id="fullList"></div>
            </div>
        }

        <div class="brFoot"><span>© BULLETIN BOARD · BIRTHDAYS</span><a href="/">홈으로 →</a></div>

    </div>
</div>

<!-- 수정 시트 (관리자) -->
<div class="mask" id="editMask" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="sheet">
        <div class="sh"><span class="k">EDIT</span><button type="button" onclick="closeEditModal()">닫기 ESC</button></div>

        @if (isStaff)
        {
            <div class="sp">
                <img id="mProfileImg" src="" alt="" onerror="this.style.visibility='hidden';" />
                <div>
                    <div class="nm" id="mShowName">이름</div>
                    <div class="mt" id="mShowBirth">생일</div>
                </div>
            </div>

            <div class="sg" id="giftPreviewWrap" style="display:none;">
                <img id="giftPreviewImg" src="" alt="선물" />
                <div>
                    <div class="gn" id="sProductDisplay">-</div>
                    <div class="gd"><span id="sSourceType">-</span> · 사진을 누르면 크게 봐요</div>
                    <div class="gd" id="sProductDesc"></div>
                </div>
            </div>
            <div class="sg" id="giftPreviewEmptyWrap" style="display:none;">
                <div class="gd">아직 고른 선물이 없어요.</div>
            </div>

            <form id="editForm" method="post" action="/Birthdays/UpdateGiftState">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PersonId" id="fPersonId" />
                <input type="hidden" name="UserId" id="fUserId" />

                <div class="sf">
                    <label for="fMemo">MEMO</label>
                    <textarea name="Memo" id="fMemo" rows="3" maxlength="500" placeholder="자유 메모 (최대 500자)"></textarea>
                    <div class="cnt"><span id="fMemoCount">0</span> / 500</div>
                </div>

                <div class="tg">
                    <span><input type="checkbox" id="fPickSmsSent" /><label for="fPickSmsSent">문자 발송</label></span>
                    <span><input type="checkbox" id="fIsActive" /><label for="fIsActive">선물 선택</label></span>
                    <span><input type="checkbox" id="fIsSent" /><label for="fIsSent">선물 전달</label></span>
                </div>
            </form>

            <div class="sfoot">
                <span>UPDATE GIFT STATE</span>
                <div>
                    <button class="btn line" type="button" onclick="closeEditModal()">취소</button>
                    <button class="btn saveBtn" type="button" onclick="submitEdit()">저장</button>
                </div>
            </div>
        }
        else
        {
            <div class="noauth">관리자만 고칠 수 있어요.</div>
        }
    </div>
</div>

<!-- 사진 크게 -->
<div class="mask" id="imgMask" aria-hidden="true">
    <div class="imgBox" role="dialog" aria-modal="true">
        <button type="button" onclick="closeImage()">닫기</button>
        <img id="imgBig" src="" alt="" />
    </div>
</div>

<script>
    // ===== 서버 데이터 =====
    const ITEMS = @Html.Raw(itemsJson);
    const YEAR  = @year;
    const MONTH = @month;
    const TODAY = @(now.Month == month ? now.Day : 0);
    const IS_ADMIN = @(isStaff ? "true" : "false");
    const DOW_EN = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];

    function esc(s) {
        return (s ?? "").toString()
            .replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;").replaceAll("'", "&#039;");
    }
    function byDay() {
        const map = new Map();
        (ITEMS || []).forEach(it => {
            if (it.bMonth === MONTH && it.bDay) {
                if (!map.has(it.bDay)) map.set(it.bDay, []);
                map.get(it.bDay).push(it);
            }
        });
        map.forEach(list => list.sort((a, b) => (a.fullName || "").localeCompare(b.fullName || "")));
        return map;
    }
    const DAY_MAP = byDay();
    function isMobile() { return window.matchMedia("(max-width: 640px)").matches; }

    // ===== 보기 전환 =====
    const btnCal  = document.getElementById('btnCal');
    const btnList = document.getElementById('btnList');
    const calView = document.getElementById('calView');
    const listView = document.getElementById('listView');
    let selectedDay = 0;

    function setView(mode) {
        const isCal = (mode !== 'list');
        btnCal?.classList.toggle('on', isCal);
        btnList?.classList.toggle('on', !isCal);
        if (calView)  calView.style.display  = isCal ? '' : 'none';
        if (listView) listView.style.display = isCal ? 'none' : '';
        if (isCal) { renderCalendar(); renderDayList(); } else { renderFullList(); }
        try { localStorage.setItem('birthday_view_mode', isCal ? 'cal' : 'list'); } catch (e) { }
    }
    btnCal?.addEventListener('click', () => setView('cal'));
    btnList?.addEventListener('click', () => setView('list'));

    // ===== 달력 =====
    function daysInMonth(y, m) { return new Date(y, m, 0).getDate(); }
    function dayOfWeek(y, m, d) { return new Date(y, m - 1, d).getDay(); }

    function renderCalendar() {
        const host = document.getElementById('calCells');
        if (!host) return;
        host.innerHTML = "";

        const totalDays = daysInMonth(YEAR, MONTH);
        const firstDow  = dayOfWeek(YEAR, MONTH, 1);
        const prevDays  = daysInMonth(MONTH === 1 ? YEAR - 1 : YEAR, MONTH === 1 ? 12 : MONTH - 1);
        const rows      = Math.ceil((firstDow + totalDays) / 7);

        for (let cell = 0; cell < rows * 7; cell++) {
            const day = cell - firstDow + 1;
            const dow = cell % 7;
            const div = document.createElement('div');
            const cls = ['c'];
            if (dow === 0) cls.push('sun');
            if (dow === 6) cls.push('sat');

            if (day < 1 || day > totalDays) {
                cls.push('out');
                const shown = day < 1 ? prevDays + day : day - totalDays;
                div.className = cls.join(' ');
                div.innerHTML = `<div class="dn">${shown}</div>`;
                host.appendChild(div);
                continue;
            }

            if (day === TODAY) cls.push('today');
            if (day === selectedDay) cls.push('sel');
            div.className = cls.join(' ');
            div.setAttribute('data-day', day);

            const list = DAY_MAP.get(day) || [];
            let html = `<div class="dn"><span>${day}</span>${day === TODAY ? '<u>TODAY</u>' : ''}</div>`;

            // 데스크톱 : 이름 · 반 (점 = 선물 골랐는지)
            list.forEach(it => {
                const cl = it.classLabel ? esc(it.classLabel) : (it.roleLabel ? esc(it.roleLabel) : '');
                html += `<div class="p ${IS_ADMIN ? 'click' : ''}" data-pid="${it.personId}">
                            <div class="pn"><i class="${it.giftPicked ? 'f' : ''}"></i>${esc(it.fullName)}</div>
                            ${cl ? `<div class="pc">${cl}</div>` : ''}
                         </div>`;
            });
            // 모바일 : 점만
            if (list.length) {
                html += `<div class="dots">${list.map(it => `<i class="${it.giftPicked ? 'f' : ''}"></i>`).join('')}</div>`;
            }
            div.innerHTML = html;
            host.appendChild(div);
        }
    }

    // 이름 클릭(관리자 → 수정) · 모바일 날짜 칸 클릭(→ 그 날 명단)
    document.getElementById('calCells')?.addEventListener('click', (e) => {
        const p = e.target.closest('.p');
        if (p && IS_ADMIN) { openEditModal(parseInt(p.getAttribute('data-pid'), 10)); return; }
        const c = e.target.closest('.c[data-day]');
        if (c && isMobile()) {
            const d = parseInt(c.getAttribute('data-day'), 10);
            selectedDay = (selectedDay === d) ? 0 : d;
            renderCalendar(); renderDayList();
        }
    });
    document.getElementById('dayHeadAll')?.addEventListener('click', (e) => {
        e.preventDefault(); selectedDay = 0; renderCalendar(); renderDayList();
    });

    // ===== 명단 줄 =====
    function rowHtml(it, withDate) {
        const d   = it.bDay || 0;
        const dow = d ? DOW_EN[dayOfWeek(YEAR, MONTH, d)] : '';
        const meta = [];
        if (it.classLabel) meta.push(esc(it.classLabel)); else if (it.roleLabel) meta.push(esc(it.roleLabel));
        if (it.phoneNumber)  meta.push(esc(it.phoneNumber));
        if (it.phoneNumber2) meta.push(esc(it.phoneNumber2));
        if (IS_ADMIN && it.giftProductName) meta.push('선물 ' + esc(it.giftProductName));

        let right = '';
        if (IS_ADMIN) {
            right = `<div class="ra">
                        <b class="${it.pickSmsSent ? 'on' : ''}">문자</b>
                        <b class="${it.giftPicked ? 'on' : ''}">선택</b>
                        <b class="${it.giftIsSent ? 'on' : ''}">전달</b>
                        <button type="button" onclick="openEditModal(${it.personId})">수정 →</button>
                     </div>`;
        } else {
            right = `<div class="ra"><b class="${it.giftPicked ? 'on' : ''}">${it.giftPicked ? '선물 골랐음' : '선물 아직'}</b></div>`;
        }
        const memo = (IS_ADMIN && it.memo) ? `<div class="memo">${esc(it.memo)}</div>` : '';

        return `<div class="row">
                    ${withDate ? `<div class="rd"><b>${d}</b><span>${dow}</span></div>` : ''}
                    <img class="av" src="${esc(it.profileImageUrl)}" alt="" onerror="this.style.visibility='hidden';" />
                    <div class="rt">
                        <div class="nm">${esc(it.fullName)}</div>
                        ${meta.length ? `<div class="mt">${meta.map(m => `<span>${m}</span>`).join('')}</div>` : ''}
                        ${memo}
                    </div>
                    ${right}
                </div>`;
    }

    // 달력 아래 (모바일에서 날짜를 골랐을 때만)
    function renderDayList() {
        const head = document.getElementById('dayHead');
        const host = document.getElementById('dayList');
        if (!head || !host) return;
        if (!selectedDay || !isMobile()) { head.hidden = true; host.innerHTML = ''; return; }
        const list = DAY_MAP.get(selectedDay) || [];
        const dow  = ["일", "월", "화", "수", "목", "금", "토"][dayOfWeek(YEAR, MONTH, selectedDay)];
        head.hidden = false;
        document.getElementById('dayHeadText').textContent = `${MONTH}월 ${selectedDay}일 (${dow}) · ${list.length}명`;
        host.innerHTML = list.length ? list.map(it => rowHtml(it, false)).join('') : `<div class="empty">이 날은 생일인 친구가 없어요.</div>`;
    }

    // 명단 보기 : 날짜순 전체
    function renderFullList() {
        const host = document.getElementById('fullList');
        if (!host) return;
        const all = [...(ITEMS || [])].filter(x => x.bMonth === MONTH)
            .sort((a, b) => (a.bDay || 0) - (b.bDay || 0) || (a.fullName || "").localeCompare(b.fullName || ""));
        host.innerHTML = all.map(it => rowHtml(it, true)).join('');
    }

    // 창 크기가 바뀌면 (모바일 ↔ 데스크톱) 다시 그림
    let _rt = null;
    window.addEventListener('resize', () => { clearTimeout(_rt); _rt = setTimeout(() => { renderCalendar(); renderDayList(); }, 120); });

    // 초기 보기
    let saved = null; try { saved = localStorage.getItem('birthday_view_mode'); } catch (e) { }
    setView(saved === 'list' ? 'list' : 'cal');

    // ===== 수정 시트 =====
    const mask = document.getElementById('editMask');
    function findByPersonId(pid) { return (ITEMS || []).find(x => x.personId === pid); }
    function giftImageUrl(productId) { return productId ? `/images/AwardItem/${productId}.jpg` : ""; }
    function setText(id, val) {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = (val === null || val === undefined || val === "") ? "-" : String(val);
    }

    function showGiftPreview(it) {
        const wrap = document.getElementById('giftPreviewWrap');
        const emptyWrap = document.getElementById('giftPreviewEmptyWrap');
        const img = document.getElementById('giftPreviewImg');
        const url = giftImageUrl(it.giftProductId);
        const name = (it.giftProductName ?? "").toString().trim();
        if (!url && !name) {
            if (wrap) wrap.style.display = "none";
            if (emptyWrap) emptyWrap.style.display = "";
            return;
        }
        if (emptyWrap) emptyWrap.style.display = "none";
        if (wrap) wrap.style.display = "";
        setText('sProductDisplay', name || (it.giftProductId ? `ID ${it.giftProductId}` : "-"));
        setText('sSourceType', (it.giftSourceType ?? "").toString().trim() || "-");
        const desc = document.getElementById('sProductDesc');
        if (desc) desc.textContent = (it.giftProductDescription ?? "").toString().trim();
        if (img) {
            img.style.display = url ? '' : 'none';
            img.src = url;
            img.onclick = () => openImage(url);
            img.onerror = function () { this.style.display = 'none'; };
        }
    }

    window.openEditModal = function (pid) {
        if (!IS_ADMIN) return;
        const it = findByPersonId(pid);
        if (!it) return;

        document.getElementById('fPersonId').value = it.personId || "";
        document.getElementById('fUserId').value   = it.userId || "";

        const pimg = document.getElementById('mProfileImg');
        if (pimg) { pimg.style.visibility = ''; pimg.src = it.profileImageUrl || ""; }

        const d = it.bDay || 0;
        const dow = d ? ["일", "월", "화", "수", "목", "금", "토"][dayOfWeek(YEAR, it.bMonth || MONTH, d)] : '';
        setText('mShowName', it.fullName || "이름");
        setText('mShowBirth', `${it.bMonth || ""}월 ${d || ""}일${dow ? ` (${dow})` : ''}${it.classLabel ? ` · ${it.classLabel}` : ''}`);

        showGiftPreview(it);

        document.getElementById('fPickSmsSent').checked = !!it.pickSmsSent;
        document.getElementById('fIsActive').checked    = !!it.giftIsActive;
        document.getElementById('fIsSent').checked      = !!it.giftIsSent;

        const fMemo = document.getElementById('fMemo');
        fMemo.value = (it.memo ?? "").toString();
        document.getElementById('fMemoCount').textContent = fMemo.value.length;

        mask?.classList.add('show');
        mask?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
    };

    window.closeEditModal = function () {
        mask?.classList.remove('show');
        mask?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
    };

    document.getElementById('fMemo')?.addEventListener('input', function () {
        document.getElementById('fMemoCount').textContent = this.value.length;
    });

    window.submitEdit = async function () {
        const form = document.getElementById('editForm');
        if (!form) return;
        const saveBtn = document.querySelector('.saveBtn');
        if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = '저장 중…'; }

        ensureHiddenBool(form, "PickSmsSent", document.getElementById('fPickSmsSent')?.checked ?? false);
        ensureHiddenBool(form, "IsActive",    document.getElementById('fIsActive')?.checked    ?? false);
        ensureHiddenBool(form, "IsSent",      document.getElementById('fIsSent')?.checked      ?? false);

        try {
            const params = new URLSearchParams();
            for (const [k, v] of new FormData(form).entries()) params.append(k, v);
            const res = await fetch(form.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                body: params.toString()
            });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            location.reload();
        } catch (e) {
            if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = '저장'; }
            alert('저장하지 못했어요. 다시 해 주세요.');
        }
    };

    function ensureHiddenBool(form, name, val) {
        let h = form.querySelector(`input[type="hidden"][data-bool="${name}"]`);
        if (!h) {
            h = document.createElement('input');
            h.type = 'hidden'; h.setAttribute('data-bool', name); h.name = name;
            form.appendChild(h);
        }
        h.value = val ? "true" : "false";
    }

    mask?.addEventListener('click', (e) => { if (e.target === mask) closeEditModal(); });

    // ===== 사진 크게 =====
    const imgMask = document.getElementById('imgMask');
    const imgBig  = document.getElementById('imgBig');
    window.openImage = function (url) {
        if (!url) return;
        imgBig.src = url;
        imgMask.classList.add('show');
        imgMask.setAttribute('aria-hidden', 'false');
    };
    window.closeImage = function () {
        imgMask.classList.remove('show');
        imgMask.setAttribute('aria-hidden', 'true');
        imgBig.src = "";
    };
    imgMask?.addEventListener('click', (e) => { if (e.target === imgMask) closeImage(); });

    document.addEventListener('keydown', (e) => {
        if (e.key !== "Escape") return;
        if (imgMask?.classList.contains('show')) closeImage();
        else if (mask?.classList.contains('show')) closeEditModal();
    });
</script>
</body>
</html>
