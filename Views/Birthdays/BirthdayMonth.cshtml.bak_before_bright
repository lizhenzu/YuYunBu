@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract;
@using System.Text.Json
@inject IAuthService AuthService

@model BulletinBoard.ViewModels.Birthday.BirthdayListPageVM

@*  ══════════════════════════════════════════════════════════════
    월별 생일자 — 벽걸이 달력 한 장.  달력(기본) · 명단 두 보기를 같은 데이터(ITEMS)로 그린다.
    Bone(호텔 인쇄물) 스킨.  관리자는 이름을 눌러 메모 · 문자 · 선물 선택 · 전달 상태를 고친다.
    (예전 카드형 partial 과 viewport 강제 전환은 없앴다.)
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
    var month = Model.Month ?? DateHelper.GetKoreaNow().Month;

    var user         = await AuthService.GetSignedUser(User);
    var isSignedIn   = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin      = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    bool isStaff     = isAdmin || isSuperAdmin;

    var now   = DateHelper.GetKoreaNow();
    var year  = now.Year;
    var items = Model.Items ?? new List<BulletinBoard.ViewModels.Birthday.BirthdayCardVM>();
    string dateText = now.ToString("yyyy.MM.dd") + " " + now.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture).ToUpperInvariant();

    // 달력 · 명단이 같이 쓰는 데이터
    var itemsForClient = items.Select(x => new
    {
        x.PersonId, x.UserId, x.FullName, x.BMonth, x.BDay, x.ClassLabel, x.RoleLabel, x.PublishYN,
        x.ProfileImageUrl, x.PhoneNumber, x.PhoneNumber2,
        x.PickSmsSent, x.PickSmsSentAt, x.Memo,
        x.GiftPicked, x.GiftProductId, x.GiftProductName, x.GiftProductDescription,
        x.GiftIsActive, x.GiftIsSent, x.GiftSourceType
    }).ToList();
    var itemsJson = JsonSerializer.Serialize(itemsForClient, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });

    var toast = TempData["Toast"] as string;
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>@(month)월 생일자 — @ConstatsCommon.MainKeyTitle</title>
<link rel="stylesheet" href="/css/mission3/bone.css" asp-append-version="true">
<style>
    body { margin: 0; background: #F7F6F3; }
    .qz { max-width: 920px; --sun: #B4531F; --sat: #3B6EA8; }

    /* ── 머리 ── */
    .qz .brK  { font-size: 10px; font-weight: 600; letter-spacing: .26em; color: var(--acc); margin: 18px 0 9px; }
    .qz .brH1 { font-family: "Noto Serif KR", serif; font-weight: 400; font-size: 22px; line-height: 1.4;
                display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .qz .brH1 b { font-weight: 400; background-image: linear-gradient(transparent 62%, var(--mark) 62%); padding: 0 2px; }
    .qz .brH1 small { font-family: "Inter", sans-serif; font-weight: 300; font-size: 12px; color: var(--dim); letter-spacing: .06em; }
    .qz .brSum { font-size: 11.5px; color: var(--dim); margin-top: 8px; }
    .qz .bdMsg { margin-top: 14px; padding: 11px 13px; background: var(--mark); font-size: 12.5px; line-height: 1.6; }

    /* ── 월 띠 ── */
    .qz .mStrip { display: flex; margin-top: 18px; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
    .qz .mStrip a { flex: 1; text-align: center; padding: 10px 0 9px; font-family: "Inter", sans-serif; font-weight: 300; font-size: 14px;
                    color: var(--dim); text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .qz .mStrip a.on { color: var(--tx); border-bottom-color: var(--acc); font-weight: 400; }
