    /* ── 도구 줄 ── */
    .qz .tools { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin: 16px 0 12px; }
    .qz .toolsL { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
    .qz .seg { display: flex; border: 1px solid var(--rule); }
    .qz .seg button { font-family: inherit; font-size: 11px; letter-spacing: .12em; background: none; border: 0; padding: 6px 14px; color: var(--dim); cursor: pointer; }
    .qz .seg button.on { background: var(--tx); color: var(--bg); }
    .qz .legend { display: flex; gap: 12px; font-size: 10px; color: var(--dim); letter-spacing: .04em; align-items: center; }
    .qz .legend i { display: inline-block; width: 7px; height: 7px; border-radius: 50%; border: 1px solid var(--acc); vertical-align: middle; margin-right: 4px; }
