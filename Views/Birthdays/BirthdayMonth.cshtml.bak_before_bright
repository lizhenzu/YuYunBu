    .qz .links a:hover, .qz .links button:hover { color: var(--acc); }

    /* ── 달력 ── */
    .qz .cal { border-top: 1px solid var(--tx); border-left: 1px solid var(--rule); }
    .qz .dow { display: grid; grid-template-columns: repeat(7, 1fr); }
