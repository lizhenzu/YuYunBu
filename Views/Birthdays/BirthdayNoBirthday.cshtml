@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService

@model BulletinBoard.ViewModels.Birthday.BirthdayListPageVM
@{
    Layout = null;
}

@{
    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    bool isStaff = isAdmin || isSuperAdmin;
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@Model.PageTitle</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* DailyMission4 밝은 흰색 버전 — 색은 직접 지정한다 */
        * { box-sizing: border-box; }
        html, body { margin: 0; }
        body { background: #FFFFFF; color: #374151; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: inherit; text-decoration: none; }
        button { font-family: inherit; }
        .wrap { max-width: 920px; margin: 0 auto; padding: 0 20px; }

        .bar { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 0 10px; border-bottom: 1px solid #EEF0F3; font-size: 12px; color: #9CA3AF; }
        .bar a { color: #374151; }
        .bar a:hover { color: #2F80ED; }
        .bar .r { display: flex; gap: 14px; font-weight: 700; }
        .bar .r a, .bar .r button { color: #2F80ED; background: none; border: 0; padding: 0; font: inherit; font-weight: 700; cursor: pointer; }
        .hdK { margin-top: 18px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
        .hdT { margin: 6px 0 0; font-size: 24px; font-weight: 800; line-height: 1.35; letter-spacing: -.02em; color: #111827; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
        .hdT small { font-size: 13px; font-weight: 400; letter-spacing: 0; color: #9CA3AF; }

        .list { margin-top: 18px; border-top: 1px solid #EEF0F3; display: grid; grid-template-columns: 1fr 1fr; column-gap: 28px; }
        @@media (max-width: 720px) { .list { grid-template-columns: 1fr; } }
        .row { display: flex; gap: 12px; align-items: center; padding: 14px 0; border-bottom: 1px solid #EEF0F3; min-width: 0; }
        .no { width: 26px; flex: 0 0 auto; font-size: 16px; font-weight: 300; color: #8DB5F3; font-variant-numeric: tabular-nums; }
        .av { width: 44px; height: 44px; border-radius: 50%; background: #EAF2FD; flex: 0 0 auto; object-fit: cover; display: block; }
        .rt { flex: 1 1 auto; min-width: 0; }
        .nm { font-size: 15px; font-weight: 700; color: #111827; line-height: 1.3; word-break: keep-all; }
        .mt { font-size: 11.5px; color: #9CA3AF; margin-top: 2px; line-height: 1.6; }
        .mt > span + span::before { content: "·"; color: #D1D5DB; margin: 0 6px; }
        .ed { flex: 0 0 auto; font-size: 12px; font-weight: 700; color: #2F80ED; background: #EAF2FD; border: 0; border-radius: 999px; padding: 6px 14px; cursor: pointer; }
        .ed:hover { background: #DCEAFC; }
        .empty { margin-top: 18px; padding: 48px 0; text-align: center; border-top: 1px solid #EEF0F3; }
        .empty b { display: block; font-size: 16px; font-weight: 800; color: #111827; }
        .empty span { display: block; margin-top: 6px; font-size: 13px; color: #9CA3AF; }

        .ft { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 24px; padding: 14px 0 40px; border-top: 1px solid #EEF0F3; font-size: 11.5px; color: #9CA3AF; }
        .ft a { color: #6B7280; }
        .ft a:hover { color: #2F80ED; }

        @@media print { .bar, .ed, .ft { display: none !important; } }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="bar">
            <a href="/">← @ConstatsCommon.ToHome</a>
            <span class="r">
                <a href="/Birthdays">이번 달</a>
                <a href="/Birthdays/Year">연간</a>
                <button type="button" onclick="window.print()">인쇄</button>
            </span>
        </div>

        <div class="hdK">잠실새내 유년부 입니다.</div>
        <h1 class="hdT">생일 미지정<small>@(Model.Items?.Count ?? 0)명</small></h1>

        @if (Model.Items == null || Model.Items.Count == 0)
        {
            <div class="empty">
                <b>생일 미지정 대상이 없어요</b>
                <span>모두 생일 정보가 입력되어 있습니다.</span>
            </div>
        }
        else
        {
            <section class="list">
                @{
                    long seq = 0;
                }
                @foreach (var u in Model.Items)
                {
                    seq++;
                    <article class="row">
                        <div class="no">@seq</div>
                        <img class="av" src="@u.ProfileImageUrl" alt="" onerror="this.style.visibility='hidden';" />
                        <div class="rt">
                            <div class="nm">@u.FullName</div>
                            <div class="mt">
                                @if (!string.IsNullOrWhiteSpace(u.ClassLabel))
                                {
                                    <span>@u.ClassLabel</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(u.PhoneNumber))
                                {
                                    <span>@u.PhoneNumber</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(u.PhoneNumber2))
                                {
                                    <span>@u.PhoneNumber2</span>
                                }
                            </div>
                        </div>
                        @if (isStaff)
                        {
                            <button class="ed" type="button" onclick="location.href='/Birthdays/Edit/@u.PersonId'">수정</button>
                        }
                    </article>
                }
            </section>
        }

        <div class="ft">
            <span>© 유년부 · 생일</span>
            <a href="/">@ConstatsCommon.ToHome</a>
        </div>
    </div>
</body>
</html>
