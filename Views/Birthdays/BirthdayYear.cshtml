@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService

@model BulletinBoard.ViewModels.Birthday.BirthdayListPageVM
@{
    Layout = null;
}
@{
    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    bool isStaff = isAdmin || isSuperAdmin;

    var now = DateHelper.GetKoreaNow();
    int curMonth = now.Month;
    int total = Model.GroupByMonth?.Sum(kv => kv.Value.Count) ?? 0;
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@Model.PageTitle</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* DailyMission4 밝은 흰색 버전 — 색은 직접 지정한다 */
        * { box-sizing: border-box; }
        html, body { margin: 0; scroll-behavior: smooth; }
        body { background: #FFFFFF; color: #374151; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: inherit; text-decoration: none; }
        button { font-family: inherit; }
        .wrap { max-width: 920px; margin: 0 auto; padding: 0 20px; }

        .bar { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 0 10px; border-bottom: 1px solid #EEF0F3; font-size: 12px; color: #9CA3AF; }
        .bar a { color: #374151; }
        .bar a:hover { color: #2F80ED; }
        .bar .r { display: flex; gap: 14px; font-weight: 700; }
        .bar .r a, .bar .r button { color: #2F80ED; background: none; border: 0; padding: 0; font: inherit; font-weight: 700; cursor: pointer; }
        .hdK { margin-top: 18px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
        .hdT { margin: 6px 0 0; font-size: 24px; font-weight: 800; line-height: 1.35; letter-spacing: -.02em; color: #111827; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
        .hdT small { font-size: 13px; font-weight: 400; letter-spacing: 0; color: #9CA3AF; }

        .ms { display: flex; gap: 6px; margin-top: 16px; overflow-x: auto; padding-bottom: 2px; scrollbar-width: none; }
        .ms::-webkit-scrollbar { display: none; }
        .ms a { flex: none; padding: 7px 14px; border-radius: 999px; background: #F4F6F9; color: #6B7280; font-size: 13px; font-variant-numeric: tabular-nums; }
        .ms a:hover { color: #2F80ED; }
        .ms a.on { background: #2F80ED; color: #fff; font-weight: 800; }

        .sec { margin-top: 22px; padding-top: 16px; border-top: 1px solid #EEF0F3; scroll-margin-top: 8px; }
        .secH { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
        .secT { font-size: 16px; font-weight: 800; color: #111827; }
        .secN { font-size: 12px; color: #9CA3AF; }
        .list { display: grid; grid-template-columns: 1fr 1fr; column-gap: 28px; }
        @@media (max-width: 720px) { .list { grid-template-columns: 1fr; } }

        .row { display: flex; gap: 12px; align-items: flex-start; padding: 13px 0; border-bottom: 1px solid #EEF0F3; min-width: 0; }
        .rd { width: 34px; flex: 0 0 auto; font-size: 18px; font-weight: 300; color: #8DB5F3; line-height: 1.3; font-variant-numeric: tabular-nums; }
        .av { width: 40px; height: 40px; border-radius: 50%; background: #EAF2FD; flex: 0 0 auto; object-fit: cover; display: block; }
        .rt { flex: 1 1 auto; min-width: 0; }
        .nm { font-size: 15px; font-weight: 700; color: #111827; line-height: 1.3; word-break: keep-all; }
        .nm .pub { margin-left: 6px; padding: 1px 7px; border-radius: 999px; background: #F4F6F9; color: #9CA3AF; font-size: 10.5px; font-weight: 700; vertical-align: 1px; }
        .mt { font-size: 11.5px; color: #9CA3AF; margin-top: 2px; }
        .gift { display: inline-block; max-width: 100%; margin-top: 5px; padding: 2px 9px; border-radius: 999px; background: #EAF2FD; color: #2B5FA8; font-size: 11px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: top; }
        .ed { flex: 0 0 auto; font-size: 12px; font-weight: 700; color: #2F80ED; background: none; border: 0; padding: 4px 0; cursor: pointer; }
        .ed:hover { color: #1F6FDB; }
        .empty { padding: 48px 0; text-align: center; font-size: 14px; color: #9CA3AF; }

        .ft { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 24px; padding: 14px 0 40px; border-top: 1px solid #EEF0F3; font-size: 11.5px; color: #9CA3AF; }
        .ft a { color: #6B7280; }
        .ft a:hover { color: #2F80ED; }

        @@media print { .bar, .ms, .ed, .ft { display: none !important; } }
    </style>
</head>
<body>
<div class="wrap">
    <div class="bar">
        <a href="/">← @ConstatsCommon.ToHome</a>
        <span class="r">
            <a href="/Birthdays">이번 달</a>
            <a href="/Birthdays/NoBirthday">미지정</a>
            <button type="button" onclick="window.print()">인쇄</button>
        </span>
    </div>

    <div class="hdK">잠실새내 유년부 입니다.</div>
    <h1 class="hdT">연간 생일자<small>@(total)명</small></h1>

    @if (Model.GroupByMonth == null || Model.GroupByMonth.Count == 0)
    {
        <div class="empty">연간 생일자 데이터가 없어요.</div>
    }
    else
    {
        <div class="ms" id="monthStrip">
            @foreach (var kv in Model.GroupByMonth)
            {
                <a href="#m@(kv.Key)" class="@(kv.Key == curMonth ? "on" : "")">@(kv.Key)월</a>
            }
        </div>

        @foreach (var kv in Model.GroupByMonth)
        {
            var m = kv.Key;
            var list = kv.Value;

            <section class="sec" id="m@m">
                <div class="secH">
                    <span class="secT">@(m)월</span>
                    <span class="secN">@(list.Count)명</span>
                </div>

                <div class="list">
                    @foreach (var u in list)
                    {
                        var giftName = (u.GiftPicked && !string.IsNullOrWhiteSpace(u.GiftProductName)) ? u.GiftProductName!.Trim() : "";
                        <article class="row">
                            <div class="rd">@u.BDay</div>
                            <img class="av" src="@u.ProfileImageUrl" alt="" onerror="this.style.visibility='hidden';" />
                            <div class="rt">
                                <div class="nm">
                                    @u.FullName
                                    @if (string.Equals(u.PublishYN, "N", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="pub">비공개</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(u.ClassLabel))
                                {
                                    <div class="mt">@u.ClassLabel</div>
                                }
                                @if (giftName != "")
                                {
                                    <span class="gift" title="@giftName">@giftName</span>
                                }
                            </div>
                            @if (isStaff)
                            {
                                <button class="ed" type="button" onclick="location.href='/Birthdays/Edit/@u.PersonId'">수정</button>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    }

    <div class="ft">
        <span>© 유년부 · 생일</span>
        <a href="/">@ConstatsCommon.ToHome</a>
    </div>
</div>

<script>
    (function () {
        var ms = document.getElementById('monthStrip');
        var on = ms && ms.querySelector('.on');
        if (on) ms.scrollLeft = on.offsetLeft - ms.clientWidth / 2 + on.clientWidth / 2;
    })();
</script>
</body>
</html>
