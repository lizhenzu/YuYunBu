@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService

@model BulletinBoard.ViewModels.Birthday.BirthdayListPageVM
@{
    Layout = null;
}
@{
    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    var isBasic = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Basic));
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@Model.PageTitle</title>
    <style>
        /* Month와 동일 테마(간결 위해 핵심만) */
        :root {
            --bg1: #fff7fb;
            --bg2: #f5fbff;
            --bg3: #f6fff8;
            --ink: #101828;
            --muted: rgba(16,24,40,.62);
            --r: 26px;
            --r2: 18px;
            --shadow: 0 18px 60px rgba(16,24,40,.16);
            --sans: system-ui,-apple-system,Segoe UI,Roboto,"Noto Sans KR",Arial,sans-serif;
            --mono: ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace;

            /* ✅ 단색 버튼용 */
            --btn-ink: #111827;
            --btn-bg: #ffffff;
            --btn-line: rgba(16,24,40,.16);
            --btn-bg-hover: #f9fafb;
            --btn-line-hover: rgba(16,24,40,.26);
        }

        * { box-sizing: border-box }

        body {
            margin: 0;
            font-family: var(--sans);
            color: var(--ink);
            background:
                radial-gradient(1200px 700px at 15% 10%, rgba(255,111,177,.22), transparent 55%),
                radial-gradient(900px 600px at 85% 15%, rgba(87,185,255,.20), transparent 55%),
                radial-gradient(900px 600px at 40% 95%, rgba(47,211,176,.18), transparent 55%),
                linear-gradient(135deg,var(--bg1),var(--bg2),var(--bg3));
        }

        .wrap {
            width: min(1120px,92vw);
            margin: 0 auto;
            padding: 26px 0 40px;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .title {
            margin: 0;
            font-size: 20px;
            font-weight: 1000;
        }

        .sub {
            margin: 4px 0 0;
            font-size: 12px;
            color: var(--muted);
        }

        .btn {
            border: 1px solid rgba(16,24,40,.12);
            background: rgba(255,255,255,.65);
            padding: 10px 14px;
            border-radius: 999px;
            cursor: pointer;
            font-weight: 900;
            box-shadow: 0 12px 26px rgba(16,24,40,.10);
            transition: transform .12s ease;
            white-space: nowrap;
        }

        .btn:hover { transform: translateY(-2px); }

        .section {
            margin-top: 16px;
            border: 1px solid rgba(16,24,40,.10);
            background: rgba(255,255,255,.65);
            border-radius: var(--r);
            box-shadow: var(--shadow);
            padding: 14px;
        }

        .hdr {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .hdr h2 {
            margin: 0;
            font-size: 18px;
            font-weight: 1000;
        }

        .badge {
            padding: 8px 12px;
            border-radius: 999px;
            border: 1px solid rgba(16,24,40,.10);
            background: rgba(255,255,255,.75);
            font-weight: 900;
            white-space: nowrap;
        }

        .grid {
            margin-top: 12px;
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 12px;
        }

        @@media (max-width: 980px) { .grid { grid-template-columns: repeat(3,1fr); } }
        @@media (max-width: 740px) { .grid { grid-template-columns: repeat(2,1fr); } }
        @@media (max-width: 430px) { .grid { grid-template-columns: 1fr; } }

        .card {
            border-radius: 18px;
            border: 1px solid rgba(16,24,40,.10);
            background: rgba(255,255,255,.78);
            overflow: hidden;
            box-shadow: 0 10px 26px rgba(16,24,40,.12);
        }

        .head {
            display: flex;
            gap: 10px;
            align-items: center;
            padding: 12px;
        }

        .avatar {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(16,24,40,.12);
            flex: 0 0 auto;
            background: #fff;
        }

        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .name {
            margin: 0;
            font-weight: 1000;
            line-height: 1.2;
        }

        .meta {
            margin-top: 4px;
            font-size: 12px;
            color: rgba(16,24,40,.70);
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .small {
            padding: 6px 10px;
            border-radius: 999px;
            border: 1px solid rgba(16,24,40,.10);
            background: rgba(255,255,255,.65);
            font-weight: 900;
            white-space: nowrap;
        }

        .foot {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-top: 1px dashed rgba(16,24,40,.12);
        }

        .cta {
            border: 1px solid var(--btn-line);
            background: var(--btn-bg);
            color: var(--btn-ink);
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 10px;
            font-weight: 900;
            font-size: 13px;
            line-height: 1;
            white-space: nowrap;
            min-width: 56px;
            text-align: center;
            box-shadow: none;
            appearance: none;
            -webkit-appearance: none;
            transition: background .12s ease, border-color .12s ease;
        }

        .cta:hover {
            background: var(--btn-bg-hover);
            border-color: var(--btn-line-hover);
        }
    </style>
</head>
<body>
<div class="wrap">
    <div class="top">
        <div>
            <p class="title">📅 연간 생일자 (1~12월)</p>
            <p class="sub">ClassInfo_2026.PersonID 대상만 · 생일 정보만 수정</p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <button class="btn" type="button" onclick="location.href='/Birthdays'">← 이번 달</button>
            <button class="btn" type="button" onclick="location.href='/Birthdays/NoBirthday'">⚠️ 미지정</button>
            <button class="btn" type="button" onclick="location.href='/'">🏠 Home</button>
            <button class="btn" type="button" onclick="window.print()">🖨️ 인쇄</button>
        </div>
    </div>

    @if (Model.GroupByMonth == null || Model.GroupByMonth.Count == 0)
    {
        <div class="section" style="text-align:center;">
            <div style="font-size:18px; font-weight:1000;">연간 생일자 데이터가 없어요 🙂</div>
        </div>
    }
    else
    {
        @foreach (var kv in Model.GroupByMonth)
        {
            var m = kv.Key;
            var list = kv.Value;

            <section class="section" id="m@m">
                <div class="hdr">
                    <h2>🎂 @m 월</h2>
                    <span class="badge">👥 @list.Count 명</span>
                </div>

                <div class="grid">
                    @foreach (var u in list)
                    {
                        // ✅ 학년반 라벨 만들기 (VM에 ClassLabel이 있으면 우선 사용)
                        var classLabel = "";
                        try
                        {
                            // ClassLabel이 있는 경우(추천)
                            // (동적 접근 불가하니, VM에 실제 프로퍼티가 있으면 아래 if만 쓰면 됩니다)
                        }
                        catch { }

                        <article class="card">
                            <div class="head">
                                <div class="avatar"><img src="@u.ProfileImageUrl" alt="profile" /></div>
                                <div style="min-width:0; flex:1;">
                                    <p class="name">@u.FullName</p>

                                    <div class="meta">
                                        <span class="small">🗓️ @u.BMonth 월 @u.BDay 일</span>

                                        @* ✅ 학년반 표시 (아래 둘 중 VM에 있는 걸 사용하세요) *@

                                        @* 1) ClassLabel 프로퍼티가 있다면 (예: "3학년 2반") *@
                                        @if (!string.IsNullOrWhiteSpace(u.ClassLabel))
                                        {
                                            <span class="small">🏫 @u.ClassLabel</span>
                                        }
                                       

                                        <span class="small">공개: @(string.IsNullOrWhiteSpace(u.PublishYN) ? "Y" : u.PublishYN)</span>
                                    </div>
                                </div>
                            </div>
                             @if (isAdmin || isSuperAdmin)
                             {
                            <div class="foot">
                                <button class="cta" type="button" onclick="location.href='/Birthdays/Edit/@u.PersonId'">수정</button>
                            </div>
                             }
                        </article>
                    }
                </div>
            </section>
        }
    }
</div>
</body>
</html>
