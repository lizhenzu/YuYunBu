        .title-banner {
            background-color: #b29b75;
            padding: 10px;
            margin-bottom: 0px;
            text-align: center;
            border-radius: 0px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .board-title {
