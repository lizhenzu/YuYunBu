    </style>*@
    
    <style>
        /* 고정형 footer */
        .footer {
            position: fixed;
            bottom: 0;
            width: 100%;
            background-color: #f8f9fa;
            text-align: center;
            padding: 10px 0;
            border-top: 1px solid #ddd;
        }

        .footer .footer-link {
            margin: 0 15px;
            color: #007bff;
            text-decoration: none;
        }

        .footer .footer-link:hover {
            text-decoration: underline;
        }

        body {
            margin-bottom: 60px; /* Footer 공간 확보 */
        }
    </style>
    <script src="/js/common2.js"></script>
</head>

<body>

    <!-- Header Section -->
    <div class="container card-container">
        <header style="@styleHeaderBackGroundColor">
            @if (@ViewBag.BoardName == BoardCategory.Anonymous.ToString())
            {
                <h1>@ConstatsCommon.AnonymousBoardName</h1>
            }
            else if (@ViewBag.BoardName == BoardCategory.HelpDesk.ToString())
            {
                <h1>개선(수정)사항</h1>
            }
            else
            {
                <h1>게시판 명명 필요</h1>
            }
        </header>

        <!-- Post Form Section -->
        <div class="card mt-4">
            <div class="card-header">
                <h2>게시글 작성</h2>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("Create", "Board")" enctype="application/x-www-form-urlencoded">
                    <div class="form-group">
                        <label for="postTitle">제목</label>
                        <input type="text" class="form-control" id="Title" name="Title" placeholder="제목을 입력하세요" required>
                    </div>
                    <div class="form-group">
                        <label for="postContent">내용</label>
                        <textarea class="form-control" id="Content" name="Content" rows="6" placeholder="내용을 입력하세요" required></textarea>
                    </div>
                    <input type="hidden" id="boardName" name="boardName" value="@ViewBag.BoardName" />
                    <div class="form-group text-right">
                        <button type="submit" class="btn btn-primary">저장</button>
                        <button type="button" class="btn btn-secondary" onclick="window.history.back();">취소</button>
                    </div>
                </form>
            </div>
        </div>

    </div>

</body>
</html>
