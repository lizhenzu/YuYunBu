@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@using BulletinBoard.Enums
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model Board

@{
    Layout = null; // Bone 톤 (wwwroot/css/board-bone.css) — 작성자는 BoardController.ResolveAnonymousSenderAsync 에서 한 번 더 검사

    var churchName   = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString()) ?? "";
    var deptName     = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString()) ?? "";
    string boardName = ViewBag.BoardName as string ?? "";
    bool isAnonBoard = boardName == BoardCategory.Anonymous.ToString();

    var isSignedIn   = await AuthService.IsSignedIn(User);
    var signedUser   = isSignedIn ? await AuthService.GetSignedUser(User) : null;
    var displayName  = signedUser != null ? $"{signedUser.LastName}{signedUser.FirstName}".Trim() : "";
    if (string.IsNullOrEmpty(displayName) && signedUser != null)
        displayName = signedUser.UserName ?? "";

    // 이름으로 보낼 수 있는가 — 로그인해서 이름을 알 때만
    bool canUseName = !string.IsNullOrWhiteSpace(displayName);
    const string AnonLabel = "익명";
    string initial = canUseName ? displayName.Substring(0, 1) : "";
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>@(isAnonBoard ? "익명 의견함" : "의견 남기기") · @churchName @deptName</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;700;800&display=swap" rel="stylesheet">
<style>
/* ── DailyMission4 밝은 흰색 버전 (2026-10-03 시안 확정) ── */
:root { --blue: #2F80ED; --soft: #EAF2FD; --ink: #111827; --tx: #374151; --dim: #9CA3AF; --dim2: #6B7280; --line: #EEF0F3; --grey: #F4F6F9; --bg: #FFFFFF; }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; color: var(--tx); -webkit-text-size-adjust: 100%; }
.page { max-width: 560px; margin: 0 auto; padding: 0 16px 40px; }
.bar { display: flex; justify-content: space-between; align-items: center; padding: 16px 0 14px; border-bottom: 1px solid var(--line); font-size: 13px; }
.bar a { font-weight: 700; color: var(--tx); text-decoration: none; -webkit-tap-highlight-color: transparent; }
.kicker { margin-top: 20px; font-size: 12px; font-weight: 800; color: var(--blue); letter-spacing: .02em; }
h1 { margin: 6px 0 0; font-size: 24px; font-weight: 800; line-height: 1.35; letter-spacing: -.02em; color: var(--ink); word-break: keep-all; }
.lead { margin-top: 6px; font-size: 13px; color: var(--dim2); }

.f { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); }
.lb { display: block; font-size: 15px; font-weight: 800; color: var(--ink); margin-bottom: 10px; }
.lb em { font-style: normal; font-size: 12px; font-weight: 700; color: var(--blue); margin-left: 4px; }

/* ── 보내는 사람 고르기 ── */
.who { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.whoOpt { position: relative; display: block; cursor: pointer; }
.whoOpt input { position: absolute; opacity: 0; pointer-events: none; }
.whoCard { display: block; height: 100%; padding: 14px; border-radius: 14px; background: var(--grey); box-shadow: inset 0 0 0 2px transparent; transition: background .15s, box-shadow .15s; }
.whoOpt input:checked + .whoCard { background: var(--soft); box-shadow: inset 0 0 0 2px var(--blue); }
.whoOpt input:focus-visible + .whoCard { outline: 3px solid var(--blue); outline-offset: 2px; }
.whoMark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: #fff; color: var(--blue); font-size: 16px; font-weight: 800; }
.whoOpt.anon .whoMark { color: var(--dim2); }
.whoK { display: block; margin-top: 10px; font-size: 11.5px; color: var(--dim2); }
.whoN { display: block; margin-top: 1px; font-size: 16px; font-weight: 800; color: var(--ink); word-break: keep-all; }
.whoD { display: block; margin-top: 5px; font-size: 12px; color: var(--dim2); line-height: 1.55; word-break: keep-all; }
.whoChk { position: absolute; top: 10px; right: 10px; width: 20px; height: 20px; border-radius: 50%; background: var(--blue); color: #fff; font-size: 11px; font-weight: 800; display: none; place-items: center; }
.whoOpt input:checked ~ .whoChk { display: grid; }
.whoOpt.off { cursor: not-allowed; }
.whoOpt.off .whoCard { opacity: .5; }

.sign { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-top: 12px; font-size: 13px; color: var(--dim2); }
.sign b { font-size: 15px; font-weight: 800; color: var(--ink); }
.sign small { font-size: 11.5px; color: var(--dim); text-align: right; }

/* ── 입력 ── */
.fIn { width: 100%; border: 0; background: var(--grey); border-radius: 12px; padding: 13px 14px; font: inherit; font-size: 15px; color: var(--ink); outline: 0; }
.fIn::placeholder { color: #B0B6C0; }
.fIn:focus { background: #fff; box-shadow: inset 0 0 0 2px var(--blue); }
textarea.fIn { min-height: 150px; resize: vertical; line-height: 1.7; }
.cntRow { display: flex; justify-content: space-between; gap: 10px; margin-top: 6px; font-size: 12px; color: var(--dim); }
.cnt { font-variant-numeric: tabular-nums; flex: none; }

/* ── 보내기 ── */
.sendBar { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 22px; padding: 16px 18px; border: 0; border-radius: 14px; background: var(--blue); color: #fff; font: inherit; text-align: left; cursor: pointer; transition: background .15s; -webkit-tap-highlight-color: transparent; }
.sendBar:hover { background: #1F6FDB; }
.sendBar:disabled { opacity: .6; cursor: progress; }
.sendBar b { display: block; font-size: 16px; font-weight: 800; }
.sendBar small { display: block; margin-top: 2px; font-size: 12px; opacity: .85; }
.sendBar i { font-style: normal; font-size: 22px; font-weight: 300; }

.promise { margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--line); display: grid; gap: 8px; font-size: 13px; color: var(--dim2); line-height: 1.6; }
.promise div { display: flex; gap: 10px; }
.promise span { flex: none; font-weight: 800; color: #7FA3DB; }

.ft { display: flex; justify-content: space-between; gap: 10px; margin-top: 26px; padding-top: 14px; border-top: 1px solid var(--line); font-size: 11.5px; color: var(--dim); }
.ft a { color: var(--dim2); text-decoration: none; }

@@media (max-width: 480px) { .sign small { display: none; } }
@@media (max-width: 320px) { .who { grid-template-columns: 1fr; } }
@@media (prefers-reduced-motion: reduce) { .whoCard, .sendBar { transition: none; } }
</style>
</head>
<body>
<div class="page">

  <div class="bar">
    <a href="javascript:history.back()">← 뒤로</a>
    <a href="/">@ConstatsCommon.ToHome</a>
  </div>

  <div class="kicker">@(isAnonBoard ? "익명 의견함" : "의견함")</div>
  <h1>개선사항 · 불편사항<br/>편하게 남겨 주세요</h1>
  <div class="lead">작은 의견 하나가 더 나은 서비스를 만듭니다.</div>

  <form method="post" action="@Url.Action("Create", "Board")" enctype="application/x-www-form-urlencoded" id="fbForm">
    <input type="hidden" name="boardName" value="@boardName"/>
    @* 서버는 UserName 이 비면 로그인 이름을 채우므로, 익명일 때도 반드시 값을 보낸다 *@
    <input type="hidden" name="UserName" id="userName" value="@(canUseName ? displayName : AnonLabel)"/>

    <div class="f">
      <span class="lb">누구의 이름으로 보낼까요?</span>
      <div class="who" role="radiogroup" aria-label="보내는 사람">
        <label class="whoOpt @(canUseName ? "" : "off")">
          <input type="radio" name="sendAs" value="name" @(canUseName ? "checked" : "disabled") />
          <span class="whoCard">
            <span class="whoMark">@(canUseName ? initial : "–")</span>
            <span class="whoK">내 이름으로</span>
            <span class="whoN">@(canUseName ? displayName : "로그인 필요")</span>
            <span class="whoD">@(canUseName ? "답이 필요하면 이쪽이 좋아요." : "로그인하면 이름으로 보낼 수 있어요.")</span>
          </span>
          <span class="whoChk">✓</span>
        </label>

        <label class="whoOpt anon">
          <input type="radio" name="sendAs" value="anon" @(canUseName ? "" : "checked") />
          <span class="whoCard">
            <span class="whoMark">?</span>
            <span class="whoK">이름 없이</span>
            <span class="whoN">익명으로</span>
            <span class="whoD">이름 대신 ‘익명’으로 저장돼요.</span>
          </span>
          <span class="whoChk">✓</span>
        </label>
      </div>

      <div class="sign" aria-live="polite">
        <span>보내는 사람 · <b id="signName">@(canUseName ? displayName : AnonLabel)</b></span>
        <small id="signNote">@(canUseName ? "이름이 함께 전달돼요" : "이름·연락처는 적지 말아 주세요")</small>
      </div>
    </div>

    <div class="f">
      <label class="lb" for="title">제목<em>필수</em></label>
      <input class="fIn" id="title" type="text" name="Title" maxlength="100" placeholder="예) 로그인 화면이 조금 불편해요" autocomplete="off" required/>
    </div>

    <div class="f">
      <label class="lb" for="content">내용<em>필수</em></label>
      <textarea class="fIn" id="content" name="Content" maxlength="2000" required
                placeholder="어떤 점이 불편하셨나요?&#10;기종 · 브라우저를 함께 적어 주시면 더 빨리 고칠 수 있어요."></textarea>
      <div class="cntRow">
        <span id="contentHint">답이 필요하면 연락 방법을 함께 남겨 주세요.</span>
        <span class="cnt"><span id="cnt">0</span> / 2000</span>
      </div>
    </div>

    <button type="submit" class="sendBar" id="sendBtn">
      <span><b id="sendLabel">@(canUseName ? $"{displayName} 이름으로 보내기" : "익명으로 보내기")</b><small>관리자에게 바로 전달됩니다</small></span>
      <i>→</i>
    </button>

    <div class="promise">
      <div><span>01</span>보내 주신 의견은 관리자가 모두 읽어요.</div>
      <div><span>02</span>익명으로 보내면 이름 자리에 ‘익명’만 남아요.</div>
      <div><span>03</span>개인정보(주소 · 전화번호)는 적지 말아 주세요.</div>
    </div>
  </form>

  <div class="ft"><span>© @churchName @deptName · 의견함</span><a href="/">@ConstatsCommon.ToHome</a></div>
</div>

<script>
(function () {
  const NAME = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(displayName));
  const ANON = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AnonLabel));
  const userName = document.getElementById('userName');
  const signName = document.getElementById('signName');
  const signNote = document.getElementById('signNote');
  const sendLabel = document.getElementById('sendLabel');
  const hint = document.getElementById('contentHint');

  function sync() {
    const anon = document.querySelector('input[name="sendAs"]:checked')?.value !== 'name';
    const who = anon ? ANON : NAME;
    userName.value = who;
    signName.textContent = who;
    signNote.textContent = anon ? '이름·연락처는 적지 말아 주세요' : '이름이 함께 전달돼요';
    sendLabel.textContent = anon ? '익명으로 보내기' : NAME + ' 이름으로 보내기';
    hint.textContent = anon ? '익명이라 답을 드리기 어려울 수 있어요.' : '답이 필요하면 연락 방법을 함께 남겨 주세요.';
  }
  document.querySelectorAll('input[name="sendAs"]').forEach(r => r.addEventListener('change', sync));
  sync();

  const c = document.getElementById('content'), n = document.getElementById('cnt');
  const upd = () => n.textContent = (c.value || '').length;
  c.addEventListener('input', upd); upd();

  // 두 번 눌러 두 번 저장되는 것 막기
  document.getElementById('fbForm').addEventListener('submit', function () {
    sync();
    document.getElementById('sendBtn').disabled = true;
  });
})();
</script>
</body>
</html>
