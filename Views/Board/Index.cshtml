@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor


@{
    Layout = null;

    string styleHeaderColor = "color: black;";
    string styleHeaderBackGroundColor = "background-color: #ffffff; " + styleHeaderColor;

    string styleFooterColor = "color: black;";
    string styleFooterBackgroundColor = "background-color: #ffeb3b; " + styleFooterColor;
     
    if (ViewBag.BoardName == BoardCategory.Anonymous.ToString())
    {
        styleHeaderColor = "color: white;";
        styleHeaderBackGroundColor = "background-color: #006633;" + styleHeaderColor;
    }
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}

@model List<Board>



<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Job Listings for AI, Software Development, and Marketing">
    <meta name="keywords" content="jobs, AI, development, design, marketing">
    <title>@ChurchName · @DepartmentName</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Noto Sans', sans-serif;
            background-color: #f8f9fa;
            color: #333;
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }

        /* Container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0px;
            background-color: white;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
            margin-bottom: 70px;
        }

        /* Header */
        header {
            background-color: #27ae60;
            color: white;
            text-align: center;
            padding: 20px 0;
        }

        header h1 {
            font-size: 2.0em;
            margin: 0;
        }

        /* Job Listings */
        .job-listing {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #ddd;
            padding: 15px 0;
            transition: background-color 0.3s ease;
        }

        .job-listing:hover {
            background-color: #f1f1f1;
        }

        .job-info {
            display: flex;
            align-items: center;
        }

        .job-info img {
            border-radius: 50%;
            width: 50px;
            margin-right: 15px;
        }

        .job-details {
            display: flex;
            flex-direction: column;
        }

        .job-title {
            font-size: 1.1em !important;
            font-weight: bold;
            color: #1a1a2e;
        }

        .job-title a {
            text-decoration: none;
            color: inherit;
        }

        .job-title a:hover {
            text-decoration: underline;
        }

        .company-name {
            font-size: 0.8em;
            color: #999;
        }

        /* Footer */
        footer {
            background-color: #27ae60;
            color: white;
            text-align: center;
            padding: 20px 0;
            position: fixed;
            bottom: 0;
            left: 0;
            bottom: 0;
            left: 0;
            width: 100%;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            font-weight: bold;
        }

        .footer-links a {
            color: white;
            text-decoration: none;
            font-size: 16px;
        }

        .footer-links a:hover {
            text-decoration: underline;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            header h1 {
                font-size: 2em;
            }

            .job-listing {
                flex-direction: column;
                align-items: flex-start;
            }

            .job-title {
                font-size: 1.1em;
            }
        }
    </style>
    <script src="/js/common2.js"></script>
</head>

@{
    int maxLimit_Board = 0;

    if (ViewBag.BoardName == BoardCategory.Anonymous.ToString())
    {
        maxLimit_Board = 6;
    }
    else if (ViewBag.BoardName == BoardCategory.HelpDesk.ToString())
    {
        maxLimit_Board = 4;
    }
    var todayDate_Board = DateHelper.GetTodayDateDayString(maxLimit_Board);
    string formatted_Board = $"/images/home/{ViewBag.BoardName}/horizontal/{ViewBag.BoardName}_horizontal_{todayDate_Board}.webp";

}

<body>

    <!-- Header Section -->
    <!-- Banner Image Below Header style="max-width: 600px;"-->
    <!-- Main Container -->
    <div class="container">
        <header style="@styleHeaderBackGroundColor">
            @if (@ViewBag.BoardName == BoardCategory.Anonymous.ToString())
            {
                <h1>@ConstatsCommon.AnonymousBoardName</h1>
            }
            else if (@ViewBag.BoardName == BoardCategory.HelpDesk.ToString())
            {
                <h1>개선(수정)사항</h1>
            }
            else
            {
                <h1>게시판 명명 필요</h1>
            }
        </header>

        <img src="@formatted_Board" alt="Header Image" style="width: 100%; height: auto; margin: 0px 0px 5px 0px;">
  
        @if (@ViewBag.BoardName == BoardCategory.Anonymous.ToString())
        {
            <div class="job-listing">
                <div class="job-info">
                    <div class="job-details">
                        <div class="job-title" style="padding-left:7px;"> 익명게시판이란</div>
                        <div class="job-title" style="padding:5px; background-color: #ecf0f1; color: #2c3e50;font-size: 0.9em; font-weight:normal;">익명게시판은 이름을 밝히지 않고, 다른 사람들과 이야기할 수 있는 곳이에요. 글을 쓸 때 누가 썼는지 모르기 때문에 자유롭게 생각을 나눌 수 있어요. 하지만 상대방을 배려하는 마음으로 예의 있게 글을 써야 해요!</div>
                    </div>
                </div>
            </div>
        }
        @if (@ViewBag.BoardName == "HelpDxxxesk")
        {
            <div class="job-listing">
                <div class="job-info">
                    <div class="job-details">
                        <div class="job-title" style="padding-left:7px;"> 알려드려요!!!</div>
                        <div class="job-title" style="padding:5px; background-color: #ffeb3b; color: black;font-size: 0.9em; font-weight:normal;">아래 글 내용에 (더보기...)를 누루면 처리 진행상황을 알수 있어요~</div>
                    </div>
                </div>
            </div>
        }

        @foreach (var board in Model)
        {
            <div class="job-listing">
                <div class="job-info">
                    <img src="/images/ICON/people/free-icon-user.png" alt="Profile">
                    <div class="job-details">
                        @if (!string.IsNullOrEmpty(@board.Title))
                        {
                            <div class="job-title">
                                @if (@board.Title.Length > 26)
                                {
                                    <a href="/Board/Detail?boardName=@ViewBag.BoardName&Id=@board.Id">@board.Title.Substring(0,25) ...</a>
                                }
                                else
                                {
                                    <a href="/Board/Detail?boardName=@ViewBag.BoardName&Id=@board.Id">@board.Title</a>
                                }                                 
                            </div>
                        }
                        <div class="job-title" style="font-size: 0.9em; font-weight:normal;">
                            @if (@board.Content.Length > 13)
                            {
                                <a href="/Board/Detail?boardName=@ViewBag.BoardName&Id=@board.Id">@board.Content.Substring(0,12) ... (더보기)</a>
                            }
                            else
                            {
                                <a href="/Board/Detail?boardName=@ViewBag.BoardName&Id=@board.Id">@board.Content (더보기)</a>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(@board.UserName))
                        {
                            <div class="company-name">작성자 : @board.UserName</div>
                        }
                        <div class="company-name">조회수 : @board.Visited 회</div>
                        <div class="company-name">작성일 : @board.CreatedDate</div>
                    </div>
                </div>
            </div>
            @*      <div class="job-listing">
        <div class="job-info">
        <img src="http://bit2001-001-site4.dtempurl.com/images/ICON/AI/AI_icon_00.webp" alt="Profile">
        <div class="job-details">
        <div class="job-title"> <a href="/HelpD1esk/Detail/@board.Id">@board.Title</a></div>
        <div class="job-title"> <a href="/HelpD1esk/Detail/@board.Id">@board.Content</a></div>
        <div class="company-name">@board.CreatedDate</div>
        </div>
        </div>
        <!-- <div class="job-meta">
        <span>Full-Time</span>
        <span>$50/hr</span>
        <span class="badge software-dev">Software Development</span>
        </div>
        <div class="favorite">&#9733;</div> -->
        </div>*@


        }

    </div>



    <!-- Footer Section -->
    <footer style="@styleFooterBackgroundColor">
        <div class="footer-links">
            <a style="@styleFooterColor" href="/">Home</a>
            @if (@ViewBag.BoardName == BoardCategory.Anonymous.ToString())
            {
                <a style="@styleFooterColor" href="/Board/Create?boardName=@ViewBag.BoardName">글쓰기</a>
            }
            else
            {
                <a style="@styleFooterColor" href="/HelpDesk/Index">@ConstatsCommon.HelpDeskHome</a>
            }

            @if (!await AuthService.IsSignedIn(User))
            {
                @*<a style="@styleFooterColor" href="/Identity/Account/Login">로그인</a>*@
            }
        </div>
        <!-- Modal for Post Creation -->
    
    </footer>
</body>
</html>
