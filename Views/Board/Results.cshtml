@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    var churchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString()) ?? "";
    var deptName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString()) ?? "";
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@churchName @deptName - 접수 완료</title>
    <meta name="description" content="개선사항 접수 완료" />

    <style>
        :root {
            --bg0: #070A12;
            --bg1: #0B1220;
            --card: rgba(255,255,255,.08);
            --line: rgba(255,255,255,.14);
            --text: rgba(255,255,255,.92);
            --muted: rgba(255,255,255,.70);
            --shadow: 0 18px 55px rgba(0,0,0,.45);
            --radius: 22px;
            --accent: #7FE7C4;
            --accent2: #9AD7FF;
        }

        * {
            box-sizing: border-box
        }

        html, body {
            height: 100%
        }

        body {
            margin: 0;
            font-family: system-ui,-apple-system,Segoe UI,Roboto,"Noto Sans KR",Arial;
            color: var(--text);
            background: radial-gradient(1200px 700px at 20% -10%, rgba(127,231,196,.22), transparent 55%), radial-gradient(900px 600px at 95% 15%, rgba(154,215,255,.18), transparent 55%), linear-gradient(180deg, var(--bg0), var(--bg1));
            display: grid;
            place-items: center;
            padding: 18px;
        }

        .card {
            width: min(720px, 100%);
            border: 1px solid var(--line);
            background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.05));
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .head {
            padding: 18px 18px 0;
            text-align: center;
            color: var(--muted);
            font-size: 13px;
            letter-spacing: .2px;
        }

        .body {
            padding: 14px 18px 18px;
            text-align: center;
        }

        .icon {
            width: 64px;
            height: 64px;
            border-radius: 20px;
            margin: 10px auto 12px;
            display: grid;
            place-items: center;
            font-size: 30px;
            background: linear-gradient(135deg, rgba(127,231,196,.92), rgba(154,215,255,.80));
            color: #061016;
            box-shadow: 0 14px 34px rgba(0,0,0,.38);
        }

        h1 {
            margin: 0;
            font-size: 22px;
            letter-spacing: -.3px;
        }

        .sub {
            margin: 10px 0 0;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .actions {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 16px;
            padding-top: 14px;
            border-top: 1px solid rgba(255,255,255,.10);
        }

        .btn {
            border: 1px solid rgba(255,255,255,.14);
            background: rgba(0,0,0,.18);
            color: var(--text);
            padding: 12px 16px;
            border-radius: 14px;
            cursor: pointer;
            font-weight: 800;
            font-size: 14px;
            letter-spacing: -.2px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: transform .08s ease, box-shadow .18s ease, background .18s ease;
        }

            .btn:hover {
                background: rgba(255,255,255,.10);
            }

            .btn:active {
                transform: translateY(1px);
            }

        .btn-primary {
            background: linear-gradient(135deg, rgba(127,231,196,.92), rgba(154,215,255,.80));
            color: #061016;
            box-shadow: 0 12px 30px rgba(0,0,0,.35);
            border-color: rgba(127,231,196,.40);
        }

            .btn-primary:hover {
                filter: brightness(1.02);
            }

        @@media (max-width: 520px) {
            h1 {
                font-size: 20px;
            }

            .actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>

<body>
    <div class="card">
        <div class="head">@churchName @deptName</div>

        <div class="body">
            <div class="icon">✅</div>

            <h1>개선사항이 잘 접수 되었습니다.</h1>
            <p class="sub">
                소중한 의견 감사합니다.<br />
                확인 후 반영할 수 있도록 진행하겠습니다.
            </p>

            <div class="actions">
                <a class="btn btn-primary" href="/">
                    🏠 홈으로 가기
                </a>
            </div>
        </div>
    </div>
</body>
</html>
