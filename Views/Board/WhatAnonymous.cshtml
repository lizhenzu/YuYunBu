@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}
 

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="A modern, responsive website designed for elementary school students.">
    <meta name="keywords" content="responsive, elementary, fun, clean design, minimal">
    <title>@ChurchName · @DepartmentName</title>
    <style>
        /* General Styles */
        body {
            font-family: 'Helvetica Neue', sans-serif;
            background-color: #f8f9fa;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Header */
        header {
            background-color: #1a1a2e;
            color: white;
            padding: 20px 0;
            text-align: center;
        }

        header h1 {
            margin: 0;
            font-size: 2.5em;
        }

        /* Navigation */
        nav {
            display: flex;
            justify-content: center;
            background-color: #16213e;
            padding: 15px 0;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-size: 1.2em;
        }

        nav a:hover {
            text-decoration: underline;
        }

        /* Main Banner */
        .banner {
            background-image: url('/images/home/welcome/welcome_03.png');
            background-size: cover;
            background-position: center;
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .banner h2 {
            font-size: 2em;
            background-color: rgba(0, 0, 0, 0.8);
            padding: 10px 20px;
            border-radius: 10px;
        }

        /* Content Section */
        .content {
            padding: 40px 0;
        }

        .content h3 {
            font-size: 2em;
            margin-bottom: 20px;
            text-align: center;
        }

        .content p {
            font-size: 1.2em;
            line-height: 1.5;
            text-align: center;
        }

        /* Call to Action Section */
        .cta {
            background-color: #1a1a2e;
            color: white;
            padding: 50px 20px;
            text-align: center;
            margin-top: 40px;
        }

        .cta button {
            background-color: #e94560;
            color: white;
            padding: 15px 30px;
            font-size: 1.2em;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .cta button:hover {
            background-color: #d42b4f;
        }

        /* Footer */
        footer {
            background-color: #16213e;
            color: white;
            text-align: center;
            padding: 20px 0;
        }

        footer p {
            margin: 0;
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            header h1 {
                font-size: 2em;
            }

            .banner h2 {
                font-size: 1.5em;
            }

            .content h3 {
                font-size: 1.5em;
            }

            .cta button {
                padding: 10px 20px;
                font-size: 1em;
            }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>@($"{@ChurchName} · {@DepartmentName}")입니다.</h1>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="/">Home</a> 
        <a href="/Board/IndexByBoard?boardName=Anonymous">@ConstatsCommon.AnonymousBoardName</a>
      
    </nav>

    <!-- Banner Section -->
    <section class="banner">
        <h2>Fun & Fun 소통공간</h2>
    </section>

    <!-- Main Content Section -->
    <div class="container">
        <section class="content">
            <h3>익명 게시판이란</h3>
            <p>익명 게시판은 자신의 이름을 드러내지 않고 다른 사람들과 이야기를 나눌 수 있는 공간이에요. 글을 쓸 때 누가 썼는지 알 수 없으니, 조금 더 자유롭게 생각을 표현할 수 있어요. 그렇지만 항상 상대방을 배려하는 마음으로 예의 바르게 글을 써야 한답니다!</p>
            <p style="background-color: #e6e6fa; color: #4682b4;">학생, 학부모, 그리고 선생님도 모두 참여할 수 있어요! 😊</p>
            <p>그리고 주의해야 할 점이 있어요! 혐오 표현이나 다른 사람을 헐뜯는 글, 혹은 개인을 공격하는 내용은 커뮤니티 규칙에 따라 바로 삭제될 수 있어요.</p>
        </section>
    </div>

    <!-- Call to Action -->
    <section class="cta">
        <h2>오늘 시작해 볼까요?</h2>
      @*  <button  onclick="goRegister()">회원가입</button>*@
    </section>

    <!-- Footer -->
    <footer>
        @{
            string churchString = $"{@ChurchName} {@DepartmentName}.";

        }
        <p>&copy; 2024 @churchString All Rights Reserved.</p>
    </footer>
    <script>
        function goRegister() {
            window.location.href = "/Identity/Account/Register";
        }
    
    </script>
</body>
</html>
