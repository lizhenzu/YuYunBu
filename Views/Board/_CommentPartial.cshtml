@model Comment

<div class="card mt-3 comment-card">
    <div class="card-body">
        <p class="formatted-text">@Model.Content</p>
        @if (!string.IsNullOrEmpty(Model.UserName))
        {
            <small class="text-muted">작성자: @Model.UserName</small> <br />
        }

        <small class="text-muted">작성일: @Model.CreatedDate</small>

        <a href="javascript:void(0)" class="btn btn-link reply-button" onclick="showReplyForm(@Model.Id)">대댓글 달기</a>

        <!-- 대댓글 입력 폼 -->
        <div id="replyForm-@Model.Id" class="reply-area">
            <textarea id="replyContent-@Model.Id" class="form-control" rows="2" placeholder="대댓글을 입력하세요"></textarea>
            <button class="btn btn-secondary mt-2" onclick="submitReply(@Model.BoardId, @Model.Id)">대댓글 등록</button>
        </div>

        <!-- 대댓글 목록 출력 (재귀적으로 처리) -->
        @if (Model.ChildComments != null && Model.ChildComments.Count > 0)
        {
            <ul class="list-unstyled">
                @foreach (var reply in Model.ChildComments)
                {
                    <li>
                        @Html.Partial("_CommentPartial", reply)
                    </li>
                }
            </ul>
        }
    </div>
</div>
