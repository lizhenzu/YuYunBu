@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor


@{
    Layout = null;

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Challenge!!! English Quiz
    </title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(120deg, #f6d365 0%, #fda085 100%);
        }

        header {
            background-color: #ffcc00;
            color: #333;
            padding: 50px;
            text-align: center;
            font-size: 32px;
            font-family: 'Fredoka One', cursive;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .container {
            max-width: 800px;
            margin-bottom: 70px;
            padding: 0 20px;
        }

        .section-title {
            text-align: center;
            font-size: 28px;
            font-weight: 500;
            color: #fff;
            margin: 20px 0;
            font-family: 'Fredoka One', cursive;
        }

        .card-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
        }

        .card {
            background-color: #fff;
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            width: 300px;
            transition: transform 0.3s, box-shadow 0.3s;
        }

            .card:hover {
                transform: translateY(-10px);
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            }

            .card img {
                width: 100%;
                height: 180px;
                object-fit: cover;
            }

        .card-content {
            padding: 15px;
            text-align: center;
        }

        .card-title {
            font-size: 20px;
            color: #333;
            margin: 10px 0;
            font-family: 'Fredoka One', cursive;
        }

        .card-description {
            font-size: 16px;
            color: #666;
            margin-bottom: 15px;
        }

        .card-buttons {
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .btn {
            padding: 10px 15px;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            border-radius: 25px;
            transition: background-color 0.3s, color 0.3s;
        }

        .btn-primary {
            background-color: #ff6b6b;
            color: white;
        }

            .btn-primary:hover {
                background-color: #ff4757;
            }

        .btn-secondary {
            background-color: #1e90ff;
            color: white;
        }

            .btn-secondary:hover {
                background-color: #1c7ed6;
            }

        footer {
            background-color: #ffcc00;
            color: #333;
            text-align: center;
            padding: 15px;
            position: fixed;
            bottom: 0;
            width: 100%;
            box-shadow: 0 -4px 8px rgba(0, 0, 0, 0.2);
            font-family: 'Fredoka One', cursive;
        }

        .table-container {
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <header>
        Challenge Zone
    </header>
    <div class="container">
        <div class="section-title">Welcome to the Challenge World based on English!</div>
        <div class="card-grid">
            <div class="card">
                <img src="/images/home/challengeenglishquiz/horizontal/ChallengeEnglishQuiz_00.webp" alt="Challenge!!! English Bible quizzes">
                <div class="card-content">
                    <h2 class="card-title">Challenge!!! English Bible quizzes.</h2>
                    <p class="card-description">
                        Challenge!!! Welcome to the world of English Bible quizzes! You’re about to start an exciting journey. Get ready to learn more about the Bible, improve your English skills, and grow even more. It’s going to be fun and challenging, so stay strong and see how much you can achieve!
                    </p>
                    <hr />
                    <h2>
                        Status of Missions Performed
                    </h2>
                    <table style="margin: 0 auto;">
                        <tr><td> Total Missions</td><td style="text-align: right;">@ViewBag.EnglishBibleQuizCount</td></tr>
                        <tr><td> Successful Missions</td><td style="text-align: right;">@ViewBag.MissionSuccess</td></tr>
                        <tr><td> Failed Missions</td><td style="text-align: right;">@ViewBag.MissionFailed</td></tr>
                        <tr><td> Remaining Missions</td><td style="text-align: right;">@ViewBag.Remaining</td></tr>
                    </table>
                    <p>
                        &nbsp;
                    </p>
                    <div class="card-buttons">
                        <a href="/ChallengeEnglishQuiz/DetailView" class="btn btn-primary">Start Challenge</a>
                    </div>
                    <br />
                    <div class="card-buttons">
                        <a href="/ChallengeEnglishQuiz/RankList" class="btn btn-secondary">Where do I rank?</a>
                    </div>
                </div>
            </div>

            @*<div class="card">
            <img src="https://via.placeholder.com/300x180" alt="Fun Activities">
            <div class="card-content">
            <h2 class="card-title">Fun Activities</h2>
            <p class="card-description">Engage in creative arts, games, and physical activities that make learning fun and exciting.</p>
            <div class="card-buttons">
            <a href="#" class="btn btn-secondary">Join Now</a>
            </div>
            </div>
            </div>*@

            <div class="card">
                <img src="/images/home/welcome/welcome_02.webp" alt="Join the Community">
                <div class="card-content">
                    <h2 class="card-title">Join the Community</h2>
                    <p class="card-description">Connect with friends, participate in challenges, and share your experiences in our safe online community.</p>
                    <div class="card-buttons">
                        <a href="/Identity/Account/Register" class="btn btn-primary">Sign Up</a>
                    </div>
                </div>
            </div>
            <div class="card">
                <img src="/images/home/goHome/goHome.webp" alt="Let's go home">
                <div class="card-content">
                    <h2 class="card-title">Let's go home</h2>
                    <p class="card-description">Have a joyful trip back home! Hope you have a relaxing time and a great day tomorrow.</p>
                    <div class="card-buttons">
                        <a href="/" class="btn btn-primary">Go Go</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <footer>
        @{
            string churchString = $"{@ChurchName} {@DepartmentName}.";
        }
        &copy; 2024 @churchString All Rights Reserved.
    </footer>
</body>
</html>
