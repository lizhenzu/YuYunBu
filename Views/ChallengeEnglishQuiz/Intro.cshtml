@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Challenge! English Bible Quiz</title>
    <style>
        body {
            font-family: 'Verdana', sans-serif;
            background-color: #fdfd96;
            color: #444;
            margin: 0;
            padding: 0;
        }
        header {
            background-color: #ffeb3b;
            padding: 30px;
            text-align: center;
            font-size: 2.5em;
            color: #555;
            font-weight: bold;
            border-bottom: 8px solid #ffa726;
            box-shadow: 0px 5px 10px rgba(0, 0, 0, 0.2);
        }
        .container {
            max-width: 700px;
            margin: 25px auto;
            padding: 30px;
            background-color: #fff9c4;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            border-radius: 15px;
            text-align: center;
        }
        .intro p {
            font-size: 1.2em;
            color: #333;
            margin-bottom: 20px;
        }
        .intro img {
            width: 45%;
            border-radius: 50%;
            margin-top: 15px;
        }
        .section-title {
            color: #ff9800;
            font-size: 1.7em;
            margin-top: 30px;
            text-shadow: 1px 1px #ffcc80;
        }
        .how-it-works, .faq {
            margin-top: 15px;
            padding: 15px 25px;
            background-color: #ffecb3;
            border: 3px dotted #ffb74d;
            border-radius: 12px;
        }
        .how-it-works p, .faq-item {
            margin: 10px 0;
            font-size: 1.1em;
        }
        .faq-item h4 {
            margin: 10px 0 0;
            color: #f57c00;
        }
        .faq-item p {
            margin: 5px 0 0 20px;
        }
        .button-container {
            display: flex;
            justify-content: space-around;
            margin: 20px 0;
        }
        .button-container a {
            padding: 10px 20px;
            text-decoration: none;
            color: #fff;
            background-color: #ffa726;
            border-radius: 5px;
            font-size: 1em;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);
            transition: background-color 0.3s ease;
        }
        .button-container a:hover {
            background-color: #ff9800;
        }
        footer {
            background-color: #ffeb3b;
            padding: 20px;
            font-size: 1em;
            color: #444;
            border-radius: 0 0 10px 10px;
            font-weight: bold;
            box-shadow: 0px -3px 10px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>
    <header>🎉 Challenge! English Bible Quiz 🎉</header>

    <div class="container">
        <div class="intro">
            <p>Are you ready to take on the English Bible Quiz challenge? Answer a question every day, earn points, and unlock a reward!</p>
            <img src="/images/home/welcome/welcome_03.png" alt="Fun Bible Quiz for Kids">
        </div>

        <!-- Buttons Section -->
        <div class="button-container">
            <a href="/">Home</a>
            <a href="/ChallengeEnglishQuiz/Index">Start Challenge</a>
        </div>

        <div class="how-it-works">
            <h2 class="section-title">🌟 How It Works 🌟</h2>
            <p>💡 Every day, try a new question and learn something awesome!</p>
            <p>💎 Earn 1 point for each correct answer and collect up to OO points!</p>
            <p>🎁 Reach OO points for a special prize at the end of the year!</p>
        </div>

        <div class="faq">
            <h2 class="section-title">❓ FAQ ❓</h2>
            <div class="faq-item" style="text-align:left">
                <h4>Q: 아이들에게 너무 어렵지 않을까요 ?</h4>
                <p>
                    A: 부모님과 함께하도록 유도하려고 합니다. 질문은 한글 번역을 지원 합니다.
                </p>
            </div>
            <div class="faq-item" style="text-align:left">
                <h4>Q: 언제 부터 시작되나요?</h4>
                <p>A: 11월 10일 부터 연말 시상 전날(12월28일)까지 해요.</p>
            </div>
            <div class="faq-item" style="text-align:left">
                <h4>Q: 하루에 출제되는 퀴즈 갯수는?</h4>
                <p>A: 하루에 한 문제 출제 되요.</p>
            </div>
            <div class="faq-item" style="text-align:left">
                <h4>Q: 퀴즈 하나당 몇 포인트 인가요?</h4>
                <p>A: 퀴즈 하나당 1 포인트 입니다.</p>
            </div>
            <div class="faq-item" style="text-align:left">
                <h4>Q: 언제 시상하나요?</h4>
                <p>A: 12월 29일 시상 해요.</p>
            </div>
        </div>
    </div>

    <footer>Let's get started and have fun with the Bible Quiz!</footer>
</body>
</html>
