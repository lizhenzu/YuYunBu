@model IEnumerable<BulletinBoard.Models.EnglishBibleQuizRank>

@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}




<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>English Bible Quiz</title>
    <style>
        /*      * {
                                    box-sizing: border-box;
                                    margin: 0;
                                    padding: 0;
                                }*/
        body {
            font-family: 'Arial', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            color: #333;
            overflow-x: hidden;
        }

        .header {
            background-color: #2c3e50;
            color: #ecf0f1;
            padding: 20px;
            padding-top: 40px;
            padding-bottom: 40px;
            text-align: center;
            font-size: 2.5em;
            font-weight: 700;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .headerCompleted {
            background-color: #9e1a20;
            color: #ecf0f1;
            padding: 20px;
            padding-top: 40px;
            padding-bottom: 40px;
            text-align: center;
            font-size: 1.5em;
            font-weight: 700;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .body-content {
            padding-top: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
        }

        .quiz-container {
            width: 98%;
            max-width: 1200px;
            background: #ffffff;
            border-radius: 20px;
            transition: all 0.3s ease-in-out;
        }

        .question {
            margin: 25px 0;
        }

        .question-title {
            font-size: 1.2em;
            margin-bottom: 20px;
            color: #00796b;
            padding-bottom: 10px;
            text-align: left;
        }

        .options {
            list-style-type: none;
            padding: 0;
            margin: 0;
        }

        .option {
            margin: 10px;
            padding: 10px;
            border-radius: 5px;
            transition: background-color 0.3s ease, transform 0.3s ease;
            border: 1px solid #b2dfdb;
            background-color: #f1f8e9;
            cursor: pointer;
            font-size: 1.0em;
            color: #333;
            text-align: left;
            display: flex;
            align-items: center;
        }

            .option::before {
                content: "☐";
                font-size: 1.2em;
                margin-right: 12px;
                color: #00796b;
                transition: color 0.3s ease;
            }

            .option.selected::before {
                content: "☑";
                color: #00796b;
            }

            .option:hover {
                background-color: #b2dfdb;
                transform: scale(1.03);
            }

        .blink {
            animation: blink 0.7s linear infinite;
        }

        @@keyframes blink {
            0%, 100% {
                background-color: #00796b;
                color: #ffffff;
            }

            50% {
                background-color: #004d40;
                color: #ffffff;
            }
        }

        .button-container {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
        }

            .button-container button {
                flex: 1;
                max-width: 130px;
                padding: 10px 15px;
                margin: 0 10px;
                font-size: 1em;
                color: #ffffff;
                background-color: #00796b;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                transition: background-color 0.3s ease, transform 0.2s ease;
                font-weight: 500;
            }

                .button-container button:hover {
                    background-color: #004d40;
                    transform: translateY(-2px);
                }

        .toggle-translation {
            margin-top: 20px;
            text-align: center;
        }

        .translation-toggle {
            background-color: #2c3e50;
            color: #ecf0f1;
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-size: 1.1em;
            cursor: pointer;
            font-weight: 600;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

            .translation-toggle:hover {
                background-color: #1a252f;
                transform: translateY(-2px);
            }

        .translation {
            display: none;
            font-size: 1.1em;
            color: #555;
            margin-top: 20px;
            padding: 15px;
            border-top: 2px solid #e0f2f1;
            text-align: left;
        }
    </style>



    <style>
        .card {
            display: flex;
            align-items: center;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 15px;
            margin: 10px 0;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .card-content {
            display: flex;
            width: 100%;
        }

        .card-image img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 15px;
        }

        .card-details {
            display: flex;
            flex-direction: column;
        }

        .card-title {
            font-size: 1.2em;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .card-username {
            font-size: 1em;
            color: #555;
        }

        .card-points p {
            font-size: 0.9em;
            margin: 2px 0;
            color: #333;
        }
    </style>


</head>
<body>
    <div class="header">English Bible Quiz</div>
    <div class="headerCompleted">People Who Participated in the Quiz.</div>


    <div class="body-content">
        <div class="quiz-container">
            <div class="question">
                <h4 style="text-align:center"> 아래 사진을 눌러서 사진을 변경할 수 있어요</h4>
                @foreach (var item in Model)
                {
                    if (@item.userName != "SuperA1dmin" && @item.userName != "guest" && @item.userName != "Basic")
                    {
                        <div class="card">
                            <div class="card-content">
                                <div class="card-image">
                                    <img src=@item.ProfilePicturePath alt="@item.userName" onclick="ManageUserInfo('@item.Id')">
                                </div>
                                <div class="card-details">
                                    @* <div class="card-title">@item.sequenceNo) @item.HideName (@item.userName)</div>*@
                                    @*<div class="card-username">@item.HideName (@item.userName)</div>*@
                                    <div class="card-points">
                                        <p>
                                            @item.sequenceNo) @item.HideName (@item.userName)
                                        </p>
                                        <ul style="margin:0px;">
                                            <li>수행 : @item.DC</li>
                                            <li>성공 : @item.DC_Success</li>
                                            <li>실패 : @item.DC_Fail</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }

            </div>
            <div class="button-container">
                <button type="button" onclick="window.location.href='/ChallengeEnglishQuiz/Index'">Back</button>
                <button type="button" onclick="window.location.href='/'">Home</button>
            </div>
        </div>
    </div>

    <script>


        function ManageUserInfo(UserId) {

            window.location.href = "/HumanResource/ManageUserInfo?UserId=" + UserId;
        }

    </script>
</body>
</html>
