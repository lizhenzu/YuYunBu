@model IEnumerable<BulletinBoard.Models.AwardItem>
@using BulletinBoard.Common;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http;
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    if (ViewBag.option == "birth")
    {
        Layout = "_Layout_Birth";
    }
    else
    {
        Layout = "_Layout_AwardItem";
    }

    
    var UserId = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserId.ToString()) as string;
}


@{
    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    var isBasic = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Basic));

    List<AwardBase> _AwardBase = ViewBag._AwardBase as List<AwardBase>;
}
 
@if ((ViewBag.option + "").ToLower() == ProductDisplayOpton.challengeMissionBible.ToString().ToLower() || (ViewBag.option + "").ToLower() == ProductDisplayOpton.birth.ToString().ToLower())
{
    <h4 style="text-align: center; color: #444; font-family: 'Arial', sans-serif; line-height: 1.6;">
        🎁 <strong>선물을 고른 후에도 나중에 다시 선택할 수 있어요!</strong><br>  
        🔄 <span style="color: #A50034;">다시 선택하면 기존 선택은 자동으로 삭제돼요.</span>
    </h4>
}
else
{
    <h4 style="text-align: center; color: #444; font-family: 'Arial', sans-serif; line-height: 1.6;">
        📢 <strong>이 화면에서는 구경만 할수 있어요!</strong><br>
        📣 <span style="color: #A50034;">선물선택은
            @foreach (var va in _AwardBase)
            {
                <span>@(va.AwardLevel.ToString("N0"))점</span>
            }
            에 도달하면 "@ConstatsCommon.MainKeyTitle" 화면에서 할수 있어요. @ViewBag.option
        </span>
    </h4>
}

<br />

@if ((ViewBag.option + "").ToLower() != ProductDisplayOpton.birth.ToString().ToLower())
{
    @await Html.PartialAsync("_Publish_Notice_Who_ReceiveAward")
}


<div class="container">

    @if (!Model.Any())
    {
        <div class="no-data">
            <h4>📭 선물상품 정보가 데이터가 없습니다.</h4>
        </div>
    }
    else
    {
        int index = 1;

        @foreach (var item in Model)
        {
            // 필터링: Admin, Basic은 가격이 0 이하인 항목은 보이지 않음
            if (!isSuperAdmin && item.UnitPrice <= 0)
            {
                continue;
            }

            <div class="card">
                <img src="/images/AwardItem/@(@item.ProductID).jpg" alt="상품 이미지" />
                <div class="card-content">
                    <div class="brand">@item.ProductName (@item.ProductID)</div>
                    <div class="status" style="color:#006633">@item.PointRequirement 선택 가능</div>
                    <div class="title">@item.ProductDescription</div>

                    @* 가격 표시 조건 *@
                    @if (isSuperAdmin || isAdmin)
                    {
                        <div class="price">💰 @item.UnitPrice.ToString("N0")원</div>
                    }


                    <div class="button-group">
                        @if (ViewBag.option == ProductDisplayOpton.challengeMissionBible.ToString().ToLower() || ViewBag.option == ProductDisplayOpton.birth.ToString().ToLower())
                        {
                            <button onclick="window.location.href='/CheckPoint/UpsertAwardItemPick?userId=@UserId&productId=@item.ProductID'" class="gift">🎁 선택하기</button>
                        }

                        @if (isSuperAdmin)
                        {
                            <button onclick="window.location.href='/CheckPoint/UpdateAwardItem?ProductID=@item.ProductID'" class="gift-me">수정하기</button>
                        }
                    </div>
                </div>
            </div>

            index++;
            <!-- 순차번호 증가 -->
        }
    }
</div>


                            이소스는 생일 선물 목록을 보여주는 소스이다.
                            이소스를 활용해서  선물물 보여주는 화면을 완전히 새롭게 디자인하고 소스를 새롭게 만들어 달라.
                            위 소스 무시하고 완전히 새롭게 디자인해 달라.
                            기존 스타일 시트 무시해라.

                         이소스를 gpt네가 완전히 이해하고 행동 내용은 그대로유지하고 디자인 완전히 새롭게 멋있게 디자인 새로 해달라. 화면에서 버튼의 액션관 같이 할일 빼놓고 디자인은 완전히 바꾸어 달라.