@model BulletinBoard.Models.AwardItemByUser
@using BulletinBoard.Common;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http;
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "_Layout_AwardItem";
    var UserId = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserId.ToString()) as string;
}

@if (Model != null)
{
    <h2 style="color: #CC0000; font-weight: bold; text-align: center;">상품 신청 완료!!!</h2>

    <div class="container">
        <div class="card">
            <img src="/images/AwardItem/@(@Model.ProductID).jpg" alt="상품 이미지" />
            <div class="card-content">
                <div class="brand">@Model.ProductName (@Model.ProductID)</div>
                <div class="title">@Model.ProductDescription</div>
            </div>
        </div>
    </div>

    <div class="nav-buttons" style="text-align:center; margin: 20px;">
        <button onclick="window.location.href='/DailyMission2Award/PickGifts'" style="  font-size: 1.20em;background:#006633;color:white;border:none;padding:10px 20px;margin:5px;border-radius:8px;box-shadow:1px 1px 5px #aaa;">🎁 다시선택하러 가기</button>
    </div>
}
else
{
    <h4 style="color: #CC0000; font-weight: bold; text-align: center;">선택한 상품이 없습니다.</h4>
}
