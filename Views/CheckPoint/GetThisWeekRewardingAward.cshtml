@model IEnumerable<BulletinBoard.Models.PointAwardUser>
@using System.Text.Encodings.Web
@using BulletinBoard.Common;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http;
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = null;
    var UserId = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserId.ToString()) as string;
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>도전 성경 시상</title>

    <link rel="stylesheet" href="/css/ButtonBase7.css">
    <link rel="stylesheet" href="/css/ColorBase7.css">

    <script defer src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

    <style>
        /* =========================
                   ✅ NEW THEME (keep actions)
                   - clean, modern, card-first
                   - mobile friendly
                   ========================= */

        :root {
            --bg0: #0b1220;
            --bg1: #0f1a2e;
            --card: rgba(255,255,255,0.92);
            --card2: rgba(255,255,255,0.86);
            --text0: #0b1220;
            --text1: #1b2a3a;
            --muted: rgba(15,23,42,0.68);
            --line: rgba(15,23,42,0.10);
            --brand1: #22c55e;
            --brand2: #38bdf8;
            --brand3: #f59e0b;
            --danger: #ef4444;
            --shadow: 0 18px 50px rgba(0,0,0,0.20);
            --shadow2: 0 10px 26px rgba(0,0,0,0.15);
            --r-xl: 26px;
            --r-lg: 20px;
            --r-md: 16px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: system-ui, -apple-system, Segoe UI, Roboto, "Noto Sans KR", Arial, sans-serif;
            background: radial-gradient(1200px 800px at 20% 0%, rgba(56,189,248,0.22), transparent 60%), radial-gradient(1000px 700px at 80% 10%, rgba(34,197,94,0.18), transparent 55%), radial-gradient(1000px 700px at 60% 90%, rgba(245,158,11,0.12), transparent 55%), linear-gradient(180deg, var(--bg0), var(--bg1));
            color: #eaf1ff;
            min-height: 100vh;
            padding-bottom: 92px; /* bottom bar space */
        }

        /* confetti 캔버스가 클릭을 막지 않도록 */
        canvas.confetti-canvas {
            pointer-events: none !important;
        }

        /* ====== Header ====== */
        header {
            position: relative;
            padding: 28px 14px 20px;
            overflow: hidden;
        }

        .hero {
            max-width: 1180px;
            margin: 0 auto;
            border-radius: var(--r-xl);
            padding: 18px 18px 18px;
            background: radial-gradient(circle at 10% 10%, rgba(56,189,248,0.24), transparent 55%), radial-gradient(circle at 90% 30%, rgba(34,197,94,0.20), transparent 55%), linear-gradient(135deg, rgba(255,255,255,0.12), rgba(255,255,255,0.05));
            border: 1px solid rgba(255,255,255,0.14);
            box-shadow: var(--shadow);
            backdrop-filter: blur(10px);
        }

        .hero-top {
            display: flex;
            gap: 14px;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 999px;
            background: rgba(255,255,255,0.10);
            border: 1px solid rgba(255,255,255,0.16);
            font-weight: 900;
            font-size: 0.85rem;
            letter-spacing: 0.02em;
        }

        .hero-title {
            margin: 10px 0 6px;
            font-size: 1.55rem;
            font-weight: 1000;
            letter-spacing: 0.02em;
        }

        .hero-sub {
            margin: 0;
            color: rgba(255,255,255,0.86);
            font-size: 0.95rem;
            line-height: 1.55;
            font-weight: 650;
        }

        .hero-right {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        .hero-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 999px;
            background: rgba(0,0,0,0.18);
            border: 1px solid rgba(255,255,255,0.14);
            color: rgba(255,255,255,0.90);
            font-weight: 800;
            font-size: 0.85rem;
        }

        /* ====== Notice Box ====== */
        .notice {
            max-width: 1180px;
            margin: 14px auto 0;
            padding: 14px 14px 14px;
            border-radius: var(--r-xl);
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.14);
            box-shadow: var(--shadow2);
            backdrop-filter: blur(10px);
        }

        .notice-head {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .notice-emoji {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, rgba(34,197,94,0.30), rgba(56,189,248,0.22));
            border: 1px solid rgba(255,255,255,0.16);
        }

        .notice-title {
            margin: 0;
            font-size: 1.02rem;
            font-weight: 1000;
        }

        .notice ul {
            margin: 0;
            padding-left: 18px;
            color: rgba(255,255,255,0.88);
            font-size: 0.92rem;
            line-height: 1.6;
            font-weight: 650;
        }

        .notice li strong {
            color: #fff;
            font-weight: 1000;
        }

        /* ====== Main ====== */
        main {
            max-width: 1180px;
            margin: 18px auto 0;
            padding: 0 14px 16px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 16px;
        }

        /* ====== Card ====== */
        .card {
            position: relative;
            border-radius: var(--r-xl);
            background: var(--card);
            color: var(--text0);
            border: 1px solid rgba(15,23,42,0.10);
            box-shadow: 0 18px 50px rgba(0,0,0,0.10);
            overflow: hidden;
            transition: transform .14s ease, box-shadow .14s ease;
        }

            .card:hover {
                transform: translateY(-2px);
                box-shadow: 0 28px 70px rgba(0,0,0,0.16);
            }

            .card::before {
                content: "";
                position: absolute;
                inset: -80px -120px auto auto;
                width: 260px;
                height: 260px;
                border-radius: 999px;
                background: radial-gradient(circle at 30% 30%, rgba(56,189,248,0.22), transparent 65%);
                pointer-events: none;
            }

            .card::after {
                content: "";
                position: absolute;
                left: -120px;
                bottom: -140px;
                width: 320px;
                height: 320px;
                border-radius: 999px;
                background: radial-gradient(circle at 40% 40%, rgba(34,197,94,0.20), transparent 65%);
                pointer-events: none;
            }

        .card-inner {
            position: relative;
            padding: 18px 16px 14px;
        }

        /* ====== Profile ====== */
        .profile {
            display: grid;
            grid-template-columns: 72px 1fr;
            gap: 12px;
            align-items: center;
        }

        .avatar {
            width: 72px;
            height: 72px;
            border-radius: 999px;
            overflow: hidden;
            border: 3px solid rgba(255,255,255,0.90);
            box-shadow: 0 10px 22px rgba(0,0,0,0.18);
            background: linear-gradient(135deg, rgba(56,189,248,0.25), rgba(34,197,94,0.22));
            cursor: pointer;
        }

            .avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .who {
            min-width: 0;
        }

        .who-top {
            display: flex;
            gap: 10px;
            align-items: baseline;
            flex-wrap: wrap;
        }

        .name {
            font-size: 1.35rem;
            font-weight: 1000;
            color: #0b1220;
            letter-spacing: 0.01em;
        }

        .role {
            font-size: 0.88rem;
            font-weight: 900;
            color: rgba(2, 6, 23, 0.72);
            padding: 4px 10px;
            border-radius: 999px;
            background: rgba(2,6,23,0.06);
            border: 1px solid rgba(2,6,23,0.08);
        }

        .meta {
            margin-top: 6px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            color: rgba(2,6,23,0.68);
            font-weight: 750;
            font-size: 0.88rem;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            background: rgba(255,255,255,0.72);
            border: 1px solid rgba(2,6,23,0.08);
        }

        /* ====== Points ====== */
        .points {
            margin-top: 14px;
            display: grid;
            gap: 10px;
        }

        .score {
            border-radius: var(--r-lg);
            padding: 12px 12px;
            background: rgba(2,6,23,0.04);
            border: 1px dashed rgba(2,6,23,0.14);
        }

            .score strong {
                display: inline-flex;
                align-items: baseline;
                gap: 6px;
                font-size: 1.7rem;
                font-weight: 1100;
                color: #0b1220;
            }

            .score .unit {
                font-size: 1rem;
                font-weight: 900;
                color: rgba(2,6,23,0.70);
            }

            .score .hint {
                margin-top: 6px;
                font-size: 0.86rem;
                color: rgba(2,6,23,0.62);
                font-weight: 750;
            }

        /* ====== Gift ====== */
        .gift {
            margin-top: 14px;
            border-top: 1px solid rgba(2,6,23,0.10);
            padding-top: 14px;
        }

        .gift-card {
            border-radius: var(--r-xl);
            background: rgba(255,255,255,0.72);
            border: 1px solid rgba(2,6,23,0.10);
            padding: 0px;
        }

        .gift-img {
            width: 100%;
            aspect-ratio: 1/1;
            object-fit: cover;
            border-radius: var(--r-lg);
            background: #f3f6fb;
            border: 1px solid rgba(2,6,23,0.10);
        }

        .gift-name {
            margin-top: 10px;
            font-weight: 1000;
            color: #064e3b;
            font-size: 1.0rem;
        }

        .gift-warn {
            margin-top: 10px;
            padding: 10px 12px;
            border-radius: var(--r-lg);
            background: rgba(245,158,11,0.12);
            border: 1px solid rgba(245,158,11,0.22);
            color: #7c2d12;
            font-weight: 900;
            text-align: center;
        }

        /* ====== Buttons ====== */
        .actions {
            margin-top: 14px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .btn {
            border: 0;
            border-radius: 16px;
            padding: 11px 12px;
            cursor: pointer;
            font-weight: 1000;
            font-size: 0.92rem;
            transition: transform .12s ease, box-shadow .12s ease, opacity .12s ease;
            box-shadow: 0 10px 22px rgba(0,0,0,0.10);
            white-space: nowrap;
        }

            .btn:hover {
                transform: translateY(-1px);
                opacity: .98;
            }

            .btn:active {
                transform: translateY(0);
                opacity: .95;
            }

        .btn-view {
            background: linear-gradient(135deg, rgba(56,189,248,0.90), rgba(34,197,94,0.86));
            color: #052e16;
        }

        .btn-manage {
            background: linear-gradient(135deg, rgba(59,130,246,0.92), rgba(56,189,248,0.80));
            color: #081a2d;
        }

        .btn-log {
            background: linear-gradient(135deg, rgba(245,158,11,0.92), rgba(251,191,36,0.88));
            color: #3b1d00;
        }

        .btn-wide {
            grid-column: 1 / -1;
        }

        /* ====== Bottom Bar (keep existing actions) ====== */
        .button-bar {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 9000;
            padding: 12px 12px 14px;
            background: rgba(10, 16, 28, 0.72);
            border-top: 1px solid rgba(255,255,255,0.10);
            backdrop-filter: blur(10px);
        }

        .button-bar-inner {
            max-width: 1180px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
        }

        /* 기존 ButtonBase7.css 클래스와 같이 써도 되지만, 시각적으로 통일되게 보강 */
        .button-bar .buttonCommon {
            border-radius: 16px !important;
            padding: 12px 10px !important;
            font-weight: 1000 !important;
            box-shadow: 0 12px 28px rgba(0,0,0,0.22) !important;
            border: 1px solid rgba(255,255,255,0.10) !important;
            backdrop-filter: blur(6px);
        }

        /* ====== Popup / Overlay ====== */
        #popupOverlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.55);
            z-index: 9998;
            backdrop-filter: blur(2px);
        }

        #productPopup {
            display: none;
            position: fixed;
            inset: auto;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 9999;
            width: min(520px, calc(100% - 22px));
            border-radius: 22px;
            padding: 14px;
            background: rgba(255,255,255,0.92);
            border: 1px solid rgba(2,6,23,0.12);
            box-shadow: 0 30px 90px rgba(0,0,0,0.30);
        }

        .popup-inner {
            display: grid;
            gap: 12px;
        }

        #popupImage {
            width: 100%;
            border-radius: 18px;
            border: 1px solid rgba(2,6,23,0.10);
            background: #f3f6fb;
        }

        #popupName {
            margin: 0;
            font-size: 1.2rem;
            font-weight: 1100;
            color: #0b1220;
        }

        #pointRequirement {
            margin: 0;
            font-size: 0.95rem;
            font-weight: 900;
            color: rgba(2,6,23,0.72);
        }

        #popupDesc {
            margin: 0;
            font-size: 0.95rem;
            color: rgba(2,6,23,0.72);
            line-height: 1.55;
            font-weight: 700;
        }

        #popupPrice {
            margin: 0;
            font-weight: 1100;
            color: #0b1220;
        }

        .popup-close {
            margin-top: 4px;
            width: 100%;
            padding: 12px 12px;
            border: 0;
            border-radius: 16px;
            font-weight: 1100;
            cursor: pointer;
            background: linear-gradient(135deg, rgba(34,197,94,0.92), rgba(56,189,248,0.78));
            color: #06281a;
            box-shadow: 0 12px 28px rgba(0,0,0,0.14);
        }

        footer {
            max-width: 1180px;
            margin: 18px auto 0;
            padding: 12px 14px 6px;
            color: rgba(255,255,255,0.68);
            text-align: center;
            font-size: 0.9rem;
            font-weight: 650;
        }

        /* Responsive tweaks */
        @@media (max-width: 420px) {
            .actions {
                grid-template-columns: 1fr;
            }

            .btn-wide {
                grid-column: auto;
            }

            .hero-title {
                font-size: 1.35rem;
            }
        }
    </style>
</head>

<body>
    <header>
        <div class="hero">
            <div class="hero-top">
                <div class="hero-badge">
                    ✨ @ConstatsCommon.MainKeyTitle
                </div>

                <div class="hero-right">
                    <span class="hero-pill">🏆 도전 성경 시상</span>
                    <span class="hero-pill">🙌 수고했어요!</span>
                </div>
            </div>

            <h1 class="hero-title">시상 대상자 명단</h1>
            <p class="hero-sub">
                이번 도전에 참여해 준 모든 분들께 감사드립니다.<br />
                아래는 점수 기준에 따른 시상 대상자입니다.
            </p>
        </div>

        <div class="notice">
            <div class="notice-head">
                <div class="notice-emoji">📢</div>
                <h3 class="notice-title">시상 기준 안내</h3>
            </div>
            <ul>
                <li><strong>100점 이상</strong> : 학생, 교사 시상</li>
                <li><strong>400점 이상</strong> : 학생만 시상</li>
                <li><strong>700점 이상</strong> : 학생만 시상</li>
                <li><strong>1,000점 이상</strong> : 학생, 교사 시상</li>
                <li><strong>1,500점 이상</strong> : 추후 공지</li>
            </ul>
        </div>
    </header>

    <main>
        @{
            var user = await AuthService.GetSignedUser(User);
            var isSignedIn = await AuthService.IsSignedIn(User);
            var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
            var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
            var isBasic = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Basic));
        }

        <div class="grid">
            @{
                int index = 1;
            }

            @foreach (var item in Model)
            {
                // 필터링: Admin, Basic은 가격이 0 이하인 항목은 보이지 않음
                if (!isSuperAdmin && item.UnitPrice <= 0)
                {
                    continue;
                }

                string YearBan = string.Empty;
                string RoleString = string.Empty;

                string dateString = $"{@item.maxclickDate.Month}월 {@item.maxclickDate.Day}일";
                RoleString = @item.RoleNM;

                if (@item.ClassYear > 0)
                {
                    YearBan = $"{@item.ClassYear}학년 {@item.ClassBan}반";
                }

                <div class="card">
                    <div class="card-inner">
                        <!-- Profile -->
                        <div class="profile">
                            <div class="avatar" onclick="ManageUserInfo('@item.UserId')" title="사용자 정보 관리">
                                <img class="imgTag" src="@item.ProfilePicturePath" alt="프로필" />
                            </div>

                            <div class="who">
                                <div class="who-top">
                                    <div class="name">@item.FullName</div>
                                    <div class="role">@RoleString</div>
                                </div>

                                <div class="meta">
                                    @if (!string.IsNullOrEmpty(YearBan))
                                    {
                                        <span class="tag">🎒 @YearBan</span>
                                    }
                                    <span class="tag">📅 최근: @dateString</span>
                                </div>
                            </div>
                        </div>

                        <!-- Points (existing logic 유지) -->
                        @{
                            var totalVal = item?.Total;    // (도전성경 포인트 + 추가 포인트)
                            var dcVal = item?.DC_Total;    // (도전성경 포인트)

                            bool hasTotal = totalVal.HasValue;
                            bool hasDc = dcVal.HasValue;

                            bool bothHasValue = hasTotal && hasDc;
                            bool isEqual = bothHasValue && totalVal.Value == dcVal.Value;

                            bool showBoth = bothHasValue && !isEqual;
                            bool showOnlyDC = hasDc && (!hasTotal || isEqual);
                            bool showOnlyTotal = hasTotal && !hasDc;

                            string F<T>(T? v) where T : struct, IFormattable
                            => v.HasValue ? v.Value.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) : "-";
                        }

                        <div class="points">
                            @if (showBoth)
                            {
                                <div class="score">
                                    <strong>@F(totalVal) <span class="unit">점</span></strong>
                                    <div class="hint">도전성경 포인트 + 추가 포인트</div>
                                </div>
                                <div class="score">
                                    <strong>@F(dcVal) <span class="unit">점</span></strong>
                                    <div class="hint">도전성경 포인트</div>
                                </div>
                            }
                            else if (showOnlyDC)
                            {
                                <div class="score">
                                    <strong>@F(dcVal) <span class="unit">점</span></strong>
                                    <div class="hint">도전성경 포인트</div>
                                </div>
                            }
                            else if (showOnlyTotal)
                            {
                                <div class="score">
                                    <strong>@F(totalVal) <span class="unit">점</span></strong>
                                    <div class="hint">도전성경 포인트 + 추가 포인트</div>
                                </div>
                            }
                        </div>

                        <!-- Gift -->
                        <div class="gift">
                            <div class="gift-card">
                                @if (string.IsNullOrEmpty(item.ProductName))
                                {
                                    <img class="gift-img" src="/images/AwardItem/1000.png" alt="상품 이미지" />
                                    <div class="gift-warn">🎁 선물 선택하지 않음 ^^</div>
                                }
                                else
                                {
                                    <img class="gift-img" src="/images/AwardItem/@(@item.ProductID).jpg" alt="상품 이미지" />
                                    <div class="gift-name">🎁 @item.ProductName (@item.ProductID)</div>
                                }
                            </div>
                        </div>

                        <!-- Actions (기존 onclick/이동 유지) -->
                        <div class="actions">
                            @if (!string.IsNullOrEmpty(item.ProductName))
                            {
                                @if (isSuperAdmin || isAdmin)
                                {
                                    if (!string.IsNullOrEmpty(@ViewBag.viewOption) && @ViewBag.viewOption == "v")
                                    {
                                        // viewOption=v면 상품보기 버튼 숨김 (기존 유지)
                                    }
                                    else
                                    {
                                        <button class="btn btn-view"
                                                onclick="showPopup('@item.ProductID','@Html.Raw(JavaScriptEncoder.Default.Encode(item.ProductName))', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.ProductDescription))','@Html.Raw(JavaScriptEncoder.Default.Encode(item.PointRequirement))', '@item.UnitPrice', '/images/AwardItem/@(@item.ProductID).jpg')">
                                            📦 상품보기
                                        </button>
                                    }
                                }
                            }

                            @if (isSuperAdmin || isAdmin)
                            {
                                if (!string.IsNullOrEmpty(@ViewBag.viewOption) && @ViewBag.viewOption == "v")
                                {
                                    // viewOption=v면 점수관리 버튼 숨김 (기존 유지)
                                }
                                else
                                {
                                    <button class="btn btn-manage"
                                            onclick="location.href='/CheckPoint/ManagePoint?UserId=@item.UserId'">
                                        💯 점수관리
                                    </button>
                                }
                            }

                            <button class="btn btn-log btn-wide"
                                    onclick="location.href='/Home/NaviMonth?userName=@item.UserName'">
                                📝 수행내역
                            </button>
                        </div>
                    </div>
                </div>

                index++;
            }
        </div>
    </main>

    <!-- Bottom Bar (기존 액션 유지) -->
    <div class="button-bar no-select">
        <div class="button-bar-inner">
            <div class="buttonCommon colorBaseHome" onclick="location.href='/'">홈으로</div>
            <div class="buttonCommon colorBaseBrightBlue" onclick="window.location.href='/Admin/IndexPoint'">포인트</div>
            <div class="buttonCommon colorBaseSoftTeal" onclick="window.location.href='/Home/MissionMainBoard'">@ConstatsCommon.MainKeyTitle</div>
        </div>
    </div>

    <!-- Popup (ids 유지 / showPopup, closePopup 유지) -->
    <div id="popupOverlay" onclick="closePopup()"></div>

    <div id="productPopup">
        <div class="popup-inner">
            <img id="popupImage" src="" alt="상품 이미지" />
            <h3 id="popupName"></h3>
            <h4 id="pointRequirement"></h4>
            <p id="popupDesc"></p>
            <p id="popupPrice"></p>
            <button class="popup-close" onclick="closePopup()">닫기</button>
        </div>
    </div>

    <footer>
        @{
            string churchString = $"{@ChurchName} {@DepartmentName}.";
        }
        &copy; 2024 @churchString All Rights Reserved.
    </footer>

    <script>
        function showPopup(nameId, name, desc, pointRequirement, price, imgPath) {
            document.getElementById('popupImage').src = imgPath;
            document.getElementById('popupName').innerText = `${name} (${nameId})`;
            document.getElementById('popupDesc').innerText = desc;
            document.getElementById('pointRequirement').innerText = pointRequirement;
            document.getElementById('popupPrice').innerText = price ? Number(price).toLocaleString() + "원" : "";

            document.getElementById('productPopup').style.display = 'block';
            document.getElementById('popupOverlay').style.display = 'block';
        }

        function closePopup() {
            document.getElementById('productPopup').style.display = 'none';
            document.getElementById('popupOverlay').style.display = 'none';
        }
    </script>

    <script src="/js/PartyPopper.js"></script>
</body>
</html>
