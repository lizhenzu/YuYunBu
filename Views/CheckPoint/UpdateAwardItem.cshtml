@model BulletinBoard.Models.AwardItem

@{
    Layout = null;
    ViewBag.Title = "상품 수정";
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>상품 수정</title>
    <style>
        body {
            background-color: #f0f9f4;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        h2 {
            text-align: center;
            color: #2e7d32;
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-top: 15px;
            font-weight: bold;
            color: #33691e;
        }

        input[type="text"],
        textarea {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 1em;
        }

        textarea {
            resize: vertical;
        }

        .text-danger {
            color: red;
            font-size: 0.85em;
        }

        .form-buttons {
            margin-top: 30px;
            display: flex;
            justify-content: space-between;
        }

        .form-buttons button,
        .form-buttons a {
            flex: 1;
            padding: 12px;
            text-align: center;
            text-decoration: none;
            font-size: 1em;
            border-radius: 10px;
            margin: 0 5px;
        }

        .save-btn {
            background-color: #4caf50;
            color: white;
            border: none;
            cursor: pointer;
        }

        .cancel-btn {
            background-color: #ccc;
            color: #333;
        }


        .image-preview {
            text-align: center;
            margin-bottom: 20px;
        }

            .image-preview img {
                max-width: 200px;
                border-radius: 10px;
                box-shadow: 2px 2px 8px rgba(0,0,0,0.2);
            }
    </style>
</head>
<body>
    <div class="container">
        <h2>상품 수정</h2>
        <div class="image-preview">
            <img src="/images/AwardItem/@(@Model.ProductID).jpg"  alt="상품 이미지" />
        </div>
        <form asp-action="ProcessUpdateAwardItem" method="post">
            @* 숨겨진 기본키 필드 *@
            <input asp-for="ProductID" type="hidden" />

            <div>
                <label asp-for="ProductName"></label>
                <input asp-for="ProductName" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="ProductDescription"></label>
                <textarea asp-for="ProductDescription" rows="4"></textarea>
                <span asp-validation-for="ProductDescription" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="UnitPrice"></label>
                <input asp-for="UnitPrice" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>

            <div class="form-buttons">
                <button type="submit" class="save-btn">저장하기</button>
                <a href="javascript:history.back()" class="cancel-btn">취소</a>
            </div>
        </form>
    </div>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
</body>
</html>
