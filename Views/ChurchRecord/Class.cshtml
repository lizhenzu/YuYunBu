@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@model BulletinBoard.ViewModels.ClassRosterVM
@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)
    // 반 교적 — 아이 카드(연락처 · 생일 · 학교 · 주소) · 빠진 정보 거르기 · 이름 누르면/수정 → 아래에서 입력창
    var now = DateHelper.GetKoreaNow();
    var all = (ViewBag.AllClasses as List<BulletinBoard.ViewModels.ClassCardVM>) ?? new();
    var idx = all.FindIndex(c => c.ClassYear == Model.ClassYear && c.ClassBan == Model.ClassBan);
    var prev = idx > 0 ? all[idx - 1] : null;
    var next = idx >= 0 && idx < all.Count - 1 ? all[idx + 1] : null;
    string ClassUrl(BulletinBoard.ViewModels.ClassCardVM c) => $"/ChurchRecord/Class?year={c.ClassYear}&ban={c.ClassBan}";
    string Digits(string? s) => new string((s ?? "").Where(char.IsDigit).ToArray());
    string Gender(string? sex) => (sex ?? "").Trim().ToUpperInvariant() switch { "M" => "남", "F" => "여", _ => "" };

    List<string> Missing(BulletinBoard.ViewModels.StudentRowVM s)
    {
        var m = new List<string>();
        if (string.IsNullOrWhiteSpace(s.PhoneNumber) && string.IsNullOrWhiteSpace(s.PhoneNumber2)) m.Add("전화");
        if (!(s.BMonth > 0 && s.BDay > 0)) m.Add("생일");
        if (Gender(s.Sex) == "") m.Add("성별");
        if (string.IsNullOrWhiteSpace(s.School)) m.Add("학교");
        if (string.IsNullOrWhiteSpace(s.HomeAddress)) m.Add("주소");
        return m;
    }
    var students = Model.Students;
    int missingCnt = students.Count(s => Missing(s).Count > 0);
    int bdayCnt = students.Count(s => s.BMonth == now.Month);
    var tTel = Digits(Model.TeacherPhone);
}
<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>교적 · @Model.ClassDisplayName</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* DailyMission4 밝은 흰색 버전 — 색은 직접 지정한다 */
        * { box-sizing: border-box; }
        html, body { margin: 0; }
        body { background: #FFFFFF; color: #374151; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: inherit; text-decoration: none; }
        button, input, select { font-family: inherit; }
        .sh { max-width: 960px; margin: 0 auto; padding: 0 20px; }

        .hdTop { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 0 10px; border-bottom: 1px solid #EEF0F3; font-size: 12px; color: #9CA3AF; }
        .hdTop a { color: #374151; }
        .hdTop a:hover { color: #2F80ED; }
        .hdTop .sep { margin: 0 6px; color: #D1D5DB; }
        .dn { display: flex; align-items: center; justify-content: space-between; margin-top: 14px; }
        .dn a, .dn span.off { flex: none; width: 44px; height: 44px; display: grid; place-items: center; font-size: 26px; font-weight: 300; color: #2F80ED; }
        .dn a:hover { color: #1F6FDB; }
        .dn span.off { color: #D1D5DB; }
        .dn h1 { margin: 0; text-align: center; font-size: 24px; font-weight: 800; letter-spacing: -.02em; color: #111827; }
        .dn h1 small { display: block; margin-top: 2px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
        .st { display: flex; gap: 28px; margin-top: 8px; flex-wrap: wrap; }
        .st div { font-size: 11.5px; color: #9CA3AF; }
        .st b { display: block; margin-top: 2px; font-weight: 300; font-size: 28px; line-height: 1.2; color: #111827; font-variant-numeric: tabular-nums; }
        .st .k b { color: #2F80ED; }
        .st .lo b { color: #B4531F; }
        .tch { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 14px; padding-top: 14px; border-top: 1px solid #EEF0F3; font-size: 14px; }
        .tch b { font-size: 15px; font-weight: 800; color: #111827; }
        .tch span { color: #9CA3AF; font-variant-numeric: tabular-nums; }
        .tch a { padding: 6px 14px; border-radius: 999px; background: #EAF2FD; color: #2B5FA8; font-size: 12.5px; font-weight: 700; }
        .tch a:hover { background: #DCEAFC; }
        .tch .no { color: #B4531F; }
        .memo { margin-top: 10px; padding: 10px 14px; border-radius: 12px; background: #F4F6F9; font-size: 13px; line-height: 1.6; color: #6B7280; }

        /* 거르기 — 스크롤해도 위에 붙음 */
        .tools { position: sticky; top: 0; z-index: 40; margin-top: 14px; background: #FFFFFF; border-bottom: 1px solid #EEF0F3; }
        .tools .sh { padding-top: 10px; padding-bottom: 10px; }
        .srch { display: flex; align-items: center; gap: 8px; height: 42px; padding: 0 18px; border-radius: 999px; background: #F4F6F9; }
        .srch:focus-within { box-shadow: 0 0 0 2px #CFE0FA; }
        .srch input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font-size: 15px; color: #111827; }
        .srch input::placeholder { color: #9CA3AF; }
        .seg { display: flex; gap: 6px; margin-top: 8px; }
        .seg button { flex: 1; font-size: 13px; padding: 8px 2px; border: 0; border-radius: 999px; background: #F4F6F9; color: #6B7280; cursor: pointer; }
        .seg button:hover { color: #2F80ED; }
        .seg button.on { background: #2F80ED; color: #fff; font-weight: 800; }
        .seg b { font-weight: 700; }

        /* 아이 카드 */
        .list { display: grid; grid-template-columns: 1fr; margin-top: 6px; }
        @@media (min-width: 820px) { .list { grid-template-columns: 1fr 1fr; column-gap: 28px; } }
        .kid { padding: 16px 0; border-bottom: 1px solid #EEF0F3; scroll-margin-top: 130px; transition: background .6s; }
        .kid.flash { background: #EAF2FD; }
        .kT { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .kT .no { width: 18px; font-size: 12px; color: #8DB5F3; font-variant-numeric: tabular-nums; }
        .kT b { font-size: 17px; font-weight: 800; color: #111827; cursor: pointer; }
        .kT b:hover { color: #2F80ED; }
        .tg { padding: 1px 9px; border-radius: 999px; background: #F4F6F9; color: #6B7280; font-size: 11px; font-weight: 700; white-space: nowrap; }
        .tg.bd { background: #FBEFE7; color: #B4531F; }
        .kv { display: grid; grid-template-columns: 54px 1fr; gap: 4px 8px; margin: 8px 0 0 26px; font-size: 13.5px; }
        .kv dt { color: #9CA3AF; }
        .kv dd { margin: 0; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; color: #111827; }
        .kv dd.no { color: #D1D5DB; }
        .kv dd a { padding: 1px 9px; border-radius: 999px; background: #EAF2FD; color: #2B5FA8; font-size: 11px; font-weight: 700; }
        .kv dd a:hover { background: #DCEAFC; }
        .kF { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin: 10px 0 0 26px; }
        .miss { font-size: 12px; color: #B4531F; }
        .miss.ok { color: #9CA3AF; }
        .edit { padding: 7px 16px; border: 0; border-radius: 999px; background: #F4F6F9; color: #6B7280; font-size: 12.5px; font-weight: 700; cursor: pointer; }
        .edit:hover { color: #2F80ED; }
        .none { padding: 36px 0; text-align: center; font-size: 14px; color: #9CA3AF; }
        .hidden { display: none !important; }
        .nav2 { display: flex; gap: 6px; margin-top: 24px; }
        .nav2 a { flex: 1; padding: 13px 0; text-align: center; border-radius: 999px; background: #F4F6F9; font-size: 13.5px; font-weight: 700; color: #6B7280; }
        .nav2 a:hover { color: #2F80ED; }
        .ft { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 20px; padding: 14px 0 40px; border-top: 1px solid #EEF0F3; font-size: 11.5px; color: #9CA3AF; }

        /* 수정 입력창 — 아래에서 올라옴 */
        .scrim { position: fixed; inset: 0; z-index: 950; background: rgba(17,24,39,.45); opacity: 0; pointer-events: none; transition: opacity .18s; }
        .sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 960; max-width: 680px; margin: 0 auto; background: #FFFFFF; border-radius: 20px 20px 0 0;
                 padding: 10px 20px calc(18px + env(safe-area-inset-bottom)); transform: translateY(105%); transition: transform .22s ease; max-height: 92vh; overflow-y: auto; }
        .open .scrim { opacity: 1; pointer-events: auto; }
        .open .sheet { transform: none; }
        .grab { width: 40px; height: 4px; border-radius: 999px; background: #E5E7EB; margin: 0 auto 12px; }
        .shH { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
        .shH b { font-size: 20px; font-weight: 800; color: #111827; }
        .shH small { display: block; margin-top: 2px; font-size: 12.5px; color: #9CA3AF; }
        .shX { flex: none; padding: 6px 14px; border: 0; border-radius: 999px; background: #F4F6F9; color: #6B7280; font-size: 12.5px; font-weight: 700; cursor: pointer; }
        .fg { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; }
        .fg .w { grid-column: 1 / -1; }
        .f label { display: block; margin-bottom: 5px; font-size: 12.5px; font-weight: 700; color: #6B7280; }
        .f input, .f select { width: 100%; height: 44px; padding: 0 16px; border: 0; border-radius: 999px; background: #F4F6F9; font-size: 15px; color: #111827; outline: none; }
        .f input:focus, .f select:focus { box-shadow: 0 0 0 2px #CFE0FA; }
        .f.err input, .f.err select { box-shadow: 0 0 0 2px #E8B79B; }
        .f .em { min-height: 0; font-size: 11.5px; color: #B4531F; margin-top: 3px; }
        .bd3 { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 6px; }
        .sex { display: flex; gap: 6px; }
        .sex button { flex: 1; height: 44px; border: 0; border-radius: 999px; background: #F4F6F9; font-size: 14px; color: #6B7280; cursor: pointer; }
        .sex button.on { background: #2F80ED; color: #fff; font-weight: 800; }
        .f.err .sex button { box-shadow: 0 0 0 2px #E8B79B; }
        .shF { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 16px; }
        .shErr { font-size: 12.5px; color: #B4531F; }
        .save { position: relative; flex: none; height: 46px; padding: 0 30px; border: 0; border-radius: 999px; background: #2F80ED; color: #fff; font-size: 15px; font-weight: 800; cursor: pointer; }
        .save:hover { background: #1F6FDB; }
        .save:disabled { cursor: progress; }
        .save.busy { color: transparent; }
        .save.busy::after { content: ""; position: absolute; top: 50%; left: 50%; width: 18px; height: 18px; margin: -9px 0 0 -9px; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite; }
        @@keyframes spin { to { transform: rotate(360deg); } }
        .toast { position: fixed; left: 50%; bottom: calc(18px + env(safe-area-inset-bottom)); z-index: 990; transform: translate(-50%, 12px); opacity: 0; pointer-events: none; max-width: calc(100% - 32px);
                 padding: 11px 20px; border-radius: 999px; background: #111827; color: #fff; font-size: 13.5px; transition: opacity .18s, transform .18s; }
        .toast.show { opacity: 1; transform: translate(-50%, 0); }
        .toast.bad { background: #B4531F; }
    </style>
</head>
<body>
    <header class="sh">
        <div class="hdTop"><span><a href="/Admin/TeacherOnly">‹ 교사전용</a><span class="sep">·</span><a href="/ChurchRecord">교적부</a></span><a href="/">@ConstatsCommon.ToHome</a></div>
        <div class="dn">
            @if (prev != null) { <a href="@ClassUrl(prev)" aria-label="이전 반 @prev.ClassDisplayName">‹</a> } else { <span class="off" aria-hidden="true">‹</span> }
            <h1>@Model.ClassDisplayName<small>교적</small></h1>
            @if (next != null) { <a href="@ClassUrl(next)" aria-label="다음 반 @next.ClassDisplayName">›</a> } else { <span class="off" aria-hidden="true">›</span> }
        </div>
        <div class="st">
            <div class="k">학생<b>@students.Count</b></div>
            <div>@(now.Month)월 생일<b>@bdayCnt</b></div>
            @if (missingCnt > 0) { <div class="lo">정보 빠짐<b>@missingCnt</b></div> }
        </div>
        <div class="tch">
            @if (string.IsNullOrWhiteSpace(Model.TeacherName))
            {
                <span class="no">담임 미배정</span>
            }
            else
            {
                <b>@Model.TeacherName 선생님</b>
                @if (tTel.Length > 0) { <span>@Model.TeacherPhone</span> }
                @if (tTel.Length >= 9) { <a href="tel:@tTel">전화</a><a href="sms:@tTel">문자</a> }
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.TeacherMemo)) { <div class="memo">@Model.TeacherMemo</div> }
    </header>

    <div class="tools">
        <div class="sh">
            <label class="srch"><input id="q" type="search" autocomplete="off" placeholder="이 반에서 이름 찾기 (초성 가능)" aria-label="이 반에서 이름 찾기" /></label>
            <div class="seg" role="tablist" aria-label="거르기">
                <button type="button" data-f="all" class="on">전체 <b>@students.Count</b></button>
                <button type="button" data-f="miss">정보 빠짐 <b>@missingCnt</b></button>
                <button type="button" data-f="bday">@(now.Month)월 생일 <b>@bdayCnt</b></button>
            </div>
        </div>
    </div>

    <main class="sh">
        <div class="list" id="list">
            @{ int no = 0; }
            @foreach (var s in students)
            {
                no++;
                var miss = Missing(s);
                var g = Gender(s.Sex);
                var t1 = Digits(s.PhoneNumber);
                var t2 = Digits(s.PhoneNumber2);
                bool bdayNow = s.BMonth == now.Month;
                var name = string.IsNullOrWhiteSpace(s.FullName) ? "(이름 없음)" : s.FullName.Trim();
                <article class="kid" id="p-@s.PersonId" data-id="@s.PersonId" data-name="@name" data-miss="@(miss.Count > 0 ? "1" : "0")" data-bday="@(bdayNow ? "1" : "0")">
                    <div class="kT">
                        <span class="no">@no</span>
                        <b class="js-edit" role="button" tabindex="0">@name</b>
                        @if (g != "") { <span class="tg">@g</span> }
                        @if (bdayNow) { <span class="tg bd">이번 달 생일</span> }
                    </div>
                    <dl class="kv">
                        <dt>생일</dt>
                        @if (s.BMonth > 0 && s.BDay > 0) { <dd>@(s.BMonth)월 @(s.BDay)일</dd> } else { <dd class="no">—</dd> }
                        <dt>전화</dt>
                        @if (!string.IsNullOrWhiteSpace(s.PhoneNumber)) { <dd>@s.PhoneNumber @if (t1.Length >= 9) { <a href="tel:@t1">전화</a><a href="sms:@t1">문자</a> }</dd> } else { <dd class="no">—</dd> }
                        <dt>전화 2</dt>
                        @if (!string.IsNullOrWhiteSpace(s.PhoneNumber2)) { <dd>@s.PhoneNumber2 @if (t2.Length >= 9) { <a href="tel:@t2">전화</a><a href="sms:@t2">문자</a> }</dd> } else { <dd class="no">—</dd> }
                        <dt>학교</dt>
                        @if (!string.IsNullOrWhiteSpace(s.School)) { <dd>@s.School</dd> } else { <dd class="no">—</dd> }
                        <dt>주소</dt>
                        @if (!string.IsNullOrWhiteSpace(s.HomeAddress)) { <dd>@s.HomeAddress</dd> } else { <dd class="no">—</dd> }
                    </dl>
                    <div class="kF">
                        <span class="miss @(miss.Count == 0 ? "ok" : "")">@(miss.Count == 0 ? "정보 모두 있음" : "빠진 정보 · " + string.Join(" · ", miss))</span>
                        <button type="button" class="edit js-edit">정보 수정</button>
                    </div>
                </article>
            }
        </div>
        <div class="none @(students.Count == 0 ? "" : "hidden")" id="none">@(students.Count == 0 ? "이 반에 등록된 아이가 없어요." : "")</div>

        <div class="nav2">
            @if (prev != null) { <a href="@ClassUrl(prev)">‹ @prev.ClassDisplayName</a> }
            <a href="/ChurchRecord">교적부 처음</a>
            @if (next != null) { <a href="@ClassUrl(next)">@next.ClassDisplayName ›</a> }
        </div>
        <div class="ft"><span>이름이나 정보 수정을 누르면 고칠 수 있어요. 이름은 여기서 바꿀 수 없어요.</span></div>
    </main>

    @* 정보 수정 *@
    <div class="scrim" id="scrim"></div>
    <section class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="shName" aria-hidden="true">
        <div class="grab"></div>
        <form id="antiForm" method="post">@Html.AntiForgeryToken()</form>
        <div class="shH">
            <div><b id="shName">이름</b><small>@Model.ClassDisplayName · 교적 정보 수정 (이름은 바꿀 수 없어요)</small></div>
            <button type="button" class="shX" id="shClose" aria-label="닫기">닫기</button>
        </div>
        <div class="fg">
            <div class="f" id="fSex"><label>성별</label><div class="sex" id="sex"><button type="button" data-v="M">남</button><button type="button" data-v="F">여</button></div><div class="em"></div></div>
            <div class="f" id="fBirth"><label>생년월일 (연 · 월 · 일)</label><div class="bd3"><input id="mBYear" type="number" inputmode="numeric" placeholder="2017" aria-label="출생 연도" /><input id="mBMonth" type="number" inputmode="numeric" placeholder="월" aria-label="생일 월" /><input id="mBDay" type="number" inputmode="numeric" placeholder="일" aria-label="생일 일" /></div><div class="em"></div></div>
            <div class="f"><label for="mPhone1">전화</label><input id="mPhone1" type="tel" maxlength="20" placeholder="010-0000-0000" /></div>
            <div class="f"><label for="mPhone2">전화 2</label><input id="mPhone2" type="tel" maxlength="20" placeholder="보호자 등" /></div>
            <div class="f w"><label for="mSchool">학교</label><input id="mSchool" type="text" maxlength="200" placeholder="예: 잠실초등학교" /></div>
            <div class="f w"><label for="mHome">주소</label><input id="mHome" type="text" maxlength="200" placeholder="주소" /></div>
        </div>
        <div class="shF"><span class="shErr" id="shErr" aria-live="polite"></span><button type="button" class="save" id="btnSave">저장</button></div>
    </section>

    <div class="toast" id="toast" role="status"></div>

<script>
    try { localStorage.setItem('LastClassYear', '@Model.ClassYear'); localStorage.setItem('LastClassBan', '@Model.ClassBan'); } catch (e) { }

(function () {
    const $ = id => document.getElementById(id);
    const kids = Array.from(document.querySelectorAll('.kid'));
    let filter = 'all';

    // ── 이름 찾기(초성) · 거르기 ──
    const CHO = ['ㄱ','ㄲ','ㄴ','ㄷ','ㄸ','ㄹ','ㅁ','ㅂ','ㅃ','ㅅ','ㅆ','ㅇ','ㅈ','ㅉ','ㅊ','ㅋ','ㅌ','ㅍ','ㅎ'];
    const cho = s => Array.from(s).map(ch => { const c = ch.charCodeAt(0) - 0xAC00; return (c >= 0 && c <= 11171) ? CHO[Math.floor(c / 588)] : ch; }).join('');
    kids.forEach(k => k.dataset.cho = cho(k.dataset.name));
    function apply() {
        const t = ($('q').value || '').replace(/\s+/g, '');
        const choOnly = /^[ㄱ-ㅎ]+$/.test(t);
        let n = 0;
        kids.forEach(k => {
            const byName = !t || (choOnly ? k.dataset.cho.includes(t) : k.dataset.name.includes(t));
            const byF = filter === 'all' || (filter === 'miss' && k.dataset.miss === '1') || (filter === 'bday' && k.dataset.bday === '1');
            const show = byName && byF;
            k.classList.toggle('hidden', !show);
            if (show) n++;
        });
        if (kids.length) {
            $('none').classList.toggle('hidden', n > 0);
            $('none').textContent = filter === 'miss' && !t ? '정보가 빠진 아이가 없어요.' : '해당하는 아이가 없어요.';
        }
    }
    $('q').addEventListener('input', apply);
    document.querySelectorAll('.seg button').forEach(b => b.addEventListener('click', () => {
        filter = b.dataset.f;
        document.querySelectorAll('.seg button').forEach(x => x.classList.toggle('on', x === b));
        apply();
    }));

    // ── 알림 ──
    let tt = null;
    function toast(text, bad) { const el = $('toast'); el.textContent = text; el.classList.toggle('bad', !!bad); el.classList.add('show'); clearTimeout(tt); tt = setTimeout(() => el.classList.remove('show'), 2200); }

    // ── 수정 입력창 ──
    const root = document.documentElement, sheet = $('sheet'), btnSave = $('btnSave');
    let cur = null, opener = null, sex = '', saving = false;
    const setSex = v => { sex = v; document.querySelectorAll('#sex button').forEach(b => b.classList.toggle('on', b.dataset.v === v)); };
    document.querySelectorAll('#sex button').forEach(b => b.addEventListener('click', () => { setSex(b.dataset.v); clearErr('fSex'); }));
    const pick = (o, ...ks) => { for (const k of ks) if (o && o[k] !== undefined && o[k] !== null) return o[k]; return ''; };
    function clearErr(id) { const f = $(id); if (f) { f.classList.remove('err'); f.querySelector('.em').textContent = ''; } }
    function setErr(id, msg) { const f = $(id); f.classList.add('err'); f.querySelector('.em').textContent = msg; }
    ['mBYear', 'mBMonth', 'mBDay'].forEach(id => $(id).addEventListener('input', () => clearErr('fBirth')));

    async function open(card, btn) {
        if (saving) return;
        opener = btn;
        try {
            const res = await fetch(`/ChurchRecord/GetPerson?personId=${encodeURIComponent(card.dataset.id)}`, { headers: { 'Accept': 'application/json' }, credentials: 'include' });
            const j = await res.json();
            if (!j || j.ok === false) throw new Error(j && j.message || '불러오지 못했어요');
            const p = j.data || {};
            cur = card;
            $('shName').textContent = pick(p, 'fullName', 'FullName') || card.dataset.name;
            setSex(String(pick(p, 'sex', 'Sex')).toUpperCase());
            $('mBYear').value = pick(p, 'bYear', 'BYear');
            $('mBMonth').value = pick(p, 'bMonth', 'BMonth');
            $('mBDay').value = pick(p, 'bDay', 'BDay');
            $('mPhone1').value = pick(p, 'phoneNumber', 'PhoneNumber');
            $('mPhone2').value = pick(p, 'phoneNumber2', 'PhoneNumber2');
            $('mHome').value = pick(p, 'homeAaddress', 'HomeAaddress');
            $('mSchool').value = pick(p, 'school', 'School');
            clearErr('fSex'); clearErr('fBirth'); $('shErr').textContent = '';
            root.classList.add('open'); sheet.setAttribute('aria-hidden', 'false');
        } catch (e) { toast('정보를 불러오지 못했어요 · ' + (e.message || ''), true); }
    }
    function close() {
        if (saving) return;
        root.classList.remove('open'); sheet.setAttribute('aria-hidden', 'true');
        cur = null; if (opener) opener.focus({ preventScroll: true });
    }
    $('list').addEventListener('click', e => { const b = e.target.closest('.js-edit'); if (b) open(b.closest('.kid'), b); });
    $('list').addEventListener('keydown', e => { if ((e.key === 'Enter' || e.key === ' ') && e.target.matches('b.js-edit')) { e.preventDefault(); open(e.target.closest('.kid'), e.target); } });
    $('scrim').addEventListener('click', close);
    $('shClose').addEventListener('click', close);
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && root.classList.contains('open')) close(); });

    const int = v => { const s = String(v ?? '').trim(); if (!s) return null; const n = parseInt(s, 10); return Number.isFinite(n) ? n : null; };
    btnSave.addEventListener('click', async () => {
        if (!cur || saving) return;
        const y = int($('mBYear').value), m = int($('mBMonth').value), d = int($('mBDay').value);
        clearErr('fSex'); clearErr('fBirth'); $('shErr').textContent = '';
        let bad = false;
        if (sex !== 'M' && sex !== 'F') { setErr('fSex', '남 · 여 중 하나를 골라 주세요.'); bad = true; }
        if (y !== null || m !== null || d !== null) {
            const nowY = new Date().getFullYear();
            if (y === null || m === null || d === null) { setErr('fBirth', '연 · 월 · 일을 모두 넣어 주세요.'); bad = true; }
            else if (y < 1900 || y > nowY) { setErr('fBirth', `연도는 1900 ~ ${nowY} 사이로 넣어 주세요.`); bad = true; }
            else if (m < 1 || m > 12) { setErr('fBirth', '월은 1 ~ 12로 넣어 주세요.'); bad = true; }
            else { const last = new Date(y, m, 0).getDate(); if (d < 1 || d > last) { setErr('fBirth', `${m}월은 1 ~ ${last}일까지예요.`); bad = true; } }
        }
        if (bad) { $('shErr').textContent = '빨간 칸을 확인해 주세요.'; return; }

        const payload = {
            personId: int(cur.dataset.id), fullName: $('shName').textContent.trim(),
            sex, bYear: y, bMonth: m, bDay: d,
            phoneNumber: $('mPhone1').value.trim(), phoneNumber2: $('mPhone2').value.trim(),
            homeAaddress: $('mHome').value.trim(), school: $('mSchool').value.trim()
        };
        saving = true; btnSave.disabled = true; btnSave.classList.add('busy');
        try {
            const res = await fetch('/ChurchRecord/UpdatePerson', {
                method: 'POST', credentials: 'include',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'RequestVerificationToken': document.querySelector('#antiForm input[name="__RequestVerificationToken"]')?.value || '' },
                body: JSON.stringify(payload)
            });
            const j = await res.json().catch(() => null);
            if (!res.ok || !j || !j.ok) throw new Error(j && j.message || '저장하지 못했어요');
            try { sessionStorage.setItem('crSaved', payload.personId + '|' + $('shName').textContent.trim()); } catch (e) { }
            location.replace(location.pathname + location.search + '#p-' + payload.personId);
            location.reload();
        } catch (e) {
            $('shErr').textContent = (e.message || '저장하지 못했어요') + ' · 다시 눌러 주세요';
            saving = false; btnSave.disabled = false; btnSave.classList.remove('busy');
        }
    });

    // 검색 결과나 저장 뒤 "#p-아이" 로 들어오면 그 아이로 이동해서 잠깐 표시
    const h = location.hash.slice(1);
    if (h.indexOf('p-') === 0) {
        const el = document.getElementById(h);
        if (el) { el.scrollIntoView({ block: 'center' }); el.classList.add('flash'); setTimeout(() => el.classList.remove('flash'), 1600); }
    }
    try {
        const s = sessionStorage.getItem('crSaved');
        if (s) { sessionStorage.removeItem('crSaved'); toast(`${s.split('|')[1]} 정보를 저장했어요`); }
    } catch (e) { }
})();
</script>
</body>
</html>
