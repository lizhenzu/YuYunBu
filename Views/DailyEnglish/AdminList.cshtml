@model List<StockBulletinBoard.Models.DailyEnglish>

<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Daily English — 관리</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

:root {
    --bg:      #f0f4ff;
    --white:   #ffffff;
    --primary: #4f46e5;
    --pri2:    #6366f1;
    --pri-lt:  #eef2ff;
    --pri-md:  #c7d2fe;
    --text:    #1e293b;
    --text2:   #475569;
    --muted:   #94a3b8;    
    --border:  #e2e8f0;
    --success: #10b981;
    --suc-lt:  #d1fae5;
    --warn:    #f59e0b;
    --warn-lt: #fef3c7;
    --danger:  #ef4444;
    --dan-lt:  #fee2e2;
    --blue:    #3b82f6;
    --blue-lt: #eff6ff;
}

html, body { min-height:100vh; background:var(--bg); font-family:'Inter',sans-serif; color:var(--text); }
body::before {
    content:''; position:fixed; inset:0; pointer-events:none;
    background: radial-gradient(ellipse 65% 45% at 5% 0%, rgba(99,102,241,.07), transparent 55%);
}
a { text-decoration:none; color:inherit; }

/* ── PAGE ── */
.page {
    position:relative; max-width:1080px;
    margin:0 auto;
    padding: clamp(24px,5vw,48px) clamp(14px,4vw,28px) 80px;
}

/* ── TOP BAR ── */
.topbar {
    display:flex; align-items:flex-end; justify-content:space-between;
    gap:16px; flex-wrap:wrap;
    margin-bottom: clamp(20px,4vw,32px);
    animation: fadeDown .5s ease both;
}
.eyebrow {
    font-size:11px; font-weight:700; letter-spacing:.18em; text-transform:uppercase;
    color:var(--primary); margin-bottom:4px; display:flex; align-items:center; gap:6px;
}
.eyebrow::before { content:''; display:inline-block; width:20px; height:1.5px; background:var(--primary); border-radius:2px; }
.page-title { font-size: clamp(22px,5vw,32px); font-weight:700; color:var(--text); letter-spacing:-.02em; }

.btn-add {
    display:inline-flex; align-items:center; gap:7px;
    padding: clamp(10px,2vw,12px) clamp(16px,3vw,22px);
    background:linear-gradient(135deg,var(--primary),var(--pri2));
    border:none; border-radius:12px; color:#fff;
    font-size: clamp(13px,2.5vw,14px); font-weight:600;
    cursor:pointer; transition:all .22s; white-space:nowrap; min-height:44px;
    box-shadow:0 4px 16px rgba(99,102,241,.28);
}
.btn-add:hover { transform:translateY(-2px); box-shadow:0 8px 22px rgba(99,102,241,.38); }

/* ── STAT CARDS ── */
.stats {
    display:grid; grid-template-columns:repeat(3,1fr); gap: clamp(8px,2vw,14px);
    margin-bottom: clamp(16px,3vw,24px);
    animation: fadeIn .6s ease .1s both;
}
.stat {
    background:var(--white); border-radius:16px;
    border:1.5px solid var(--border);
    padding: clamp(14px,2.5vw,18px) clamp(14px,3vw,20px);
    display:flex; align-items:center; gap: clamp(10px,2vw,14px);
    box-shadow:0 2px 10px rgba(0,0,0,.04);
}
.stat-icon { font-size: clamp(20px,4vw,24px); flex-shrink:0; }
.stat-lbl { font-size:11px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); margin-bottom:2px; }
.stat-val { font-size: clamp(20px,4vw,26px); font-weight:700; color:var(--text); line-height:1; }

/* ── SEARCH ── */
.search-wrap {
    position:relative; margin-bottom: clamp(14px,2.5vw,20px);
    animation: fadeIn .6s ease .15s both;
}
.search-ico { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--muted); font-size:15px; pointer-events:none; }
.search-input {
    width:100%; padding: clamp(11px,2vw,13px) 14px clamp(11px,2vw,13px) 42px;
    background:var(--white); border:1.5px solid var(--border); border-radius:12px;
    color:var(--text); font-family:'Inter',sans-serif; font-size: clamp(13px,2.8vw,14px);
    outline:none; transition:border-color .2s; min-height:46px;
}
.search-input::placeholder { color:var(--muted); }
.search-input:focus { border-color:var(--primary); box-shadow:0 0 0 3px rgba(99,102,241,.1); }

/* ── TABLE CARD ── */
.table-card {
    background:var(--white); border-radius: clamp(14px,3vw,20px);
    border:1.5px solid var(--border);
    box-shadow:0 4px 24px rgba(0,0,0,.06);
    overflow:hidden;
    animation: riseUp .6s cubic-bezier(.22,1,.36,1) .2s both;
}

table { width:100%; border-collapse:collapse; }

thead tr { background:var(--bg); border-bottom:1.5px solid var(--border); }
th {
    padding: clamp(10px,2vw,13px) clamp(12px,2.5vw,20px);
    font-size:11px; font-weight:700; letter-spacing:.1em; text-transform:uppercase;
    color:var(--muted); text-align:left; white-space:nowrap;
}
th:first-child { padding-left: clamp(16px,3vw,24px); }
th:last-child  { text-align:center; }

tbody tr { border-bottom:1px solid var(--border); transition:background .15s; }
tbody tr:hover { background:#fafbff; }
tbody tr:last-child { border-bottom:none; }
td { padding: clamp(12px,2.5vw,15px) clamp(12px,2.5vw,20px); font-size: clamp(13px,2.5vw,14px); vertical-align:middle; }
td:first-child { padding-left: clamp(16px,3vw,24px); }

.td-id { font-size: clamp(10px,2vw,12px); font-weight:600; color:var(--muted); width:52px; }
.td-en { font-weight:600; color:var(--text); max-width:280px; }
.td-ko { font-size: clamp(12px,2.2vw,13px); color:var(--text2); max-width:180px; }

.badge {
    display:inline-flex; align-items:center; gap:5px;
    padding: 4px clamp(8px,2vw,12px); border-radius:100px;
    font-size: clamp(10px,2vw,11px); font-weight:600; white-space:nowrap;
}
.badge-read   { background:var(--suc-lt); color:#059669; border:1px solid #a7f3d0; }
.badge-unread { background:var(--warn-lt); color:#d97706; border:1px solid #fde68a; }
.bdot { width:5px; height:5px; border-radius:50%; background:currentColor; }

.td-actions { text-align:center; white-space:nowrap; }
.btn-edit {
    display:inline-flex; align-items:center; gap:4px;
    padding:6px clamp(10px,2vw,14px); border-radius:8px;
    background:var(--blue-lt); border:1px solid #bfdbfe; color:var(--blue);
    font-size: clamp(11px,2vw,12px); font-weight:500; cursor:pointer; transition:all .18s; min-height:32px;
}
.btn-edit:hover { background:#dbeafe; border-color:#93c5fd; }
.btn-del {
    display:inline-flex; align-items:center; gap:4px;
    padding:6px clamp(10px,2vw,14px); border-radius:8px;
    background:var(--dan-lt); border:1px solid #fecaca; color:var(--danger);
    font-size: clamp(11px,2vw,12px); font-weight:500; cursor:pointer; transition:all .18s;
    margin-left:6px; min-height:32px;
}
.btn-del:hover { background:#fca5a5; border-color:#f87171; color:#fff; }

/* ── FOOTER ── */
.tbl-footer {
    display:flex; justify-content:space-between; align-items:center;
    flex-wrap:wrap; gap:6px;
    padding: clamp(10px,2vw,14px) clamp(16px,3vw,24px);
    border-top:1.5px solid var(--border);
    background:var(--bg);
}
.fc { font-size: clamp(11px,2vw,12px); color:var(--muted); font-weight:500; }
.fc b { color:var(--text); }
.fc .g  { color:var(--success); }
.fc .w  { color:var(--warn); }

/* ── 행 클릭 ── */
.row-clickable { cursor:pointer; }
.row-clickable:hover .td-link { color:var(--primary); text-decoration:underline; text-underline-offset:3px; }
.row-clickable:hover { background:#f5f7ff !important; }

/* ── EMPTY ── */
.empty-row td { padding:56px 20px; text-align:center; color:var(--muted); font-size:14px; }

/* ── MOBILE CARD ── */
@@media (max-width:639px) {
    table, thead, tbody, tr, th, td { display:block; width:100%; }
    thead { display:none; }
    tbody tr {
        background:var(--white) !important;
        border:1.5px solid var(--border) !important;
        border-radius:16px !important;
        margin-bottom:10px; padding:16px; position:relative;
    }
    tbody tr:hover { background:#fafbff !important; }
    td { padding:0; border:none; }
    .td-id { font-size:10px; color:var(--muted); margin-bottom:5px; width:auto; }
    .td-en { font-size:15px; font-weight:600; max-width:100%; line-height:1.4; margin-bottom:4px; }
    .td-ko { font-size:13px; color:var(--text2); max-width:100%; margin-bottom:10px; }
    .td-status { margin-bottom:12px; }
    .td-actions { text-align:left; display:flex; gap:8px; }
    .btn-edit, .btn-del { flex:1; justify-content:center; min-height:40px; margin-left:0; }
    .table-card { background:transparent; border:none; box-shadow:none; border-radius:0; overflow:visible; }
    .tbl-footer { background:var(--white); border:1.5px solid var(--border); border-radius:14px; margin-top:10px; }
}

@@keyframes fadeDown { from{opacity:0;transform:translateY(-10px)} to{opacity:1;transform:translateY(0)} }
@@keyframes riseUp   { from{opacity:0;transform:translateY(20px) scale(.98)} to{opacity:1;transform:translateY(0) scale(1)} }
@@keyframes fadeIn   { from{opacity:0;transform:translateY(6px)}  to{opacity:1;transform:translateY(0)} }

/* ── 햄버거 드로어 공통 ── */
.hbg-btn { display:flex;flex-direction:column;justify-content:center;align-items:center;gap:4.5px;width:36px;height:36px;border:none;background:none;cursor:pointer;border-radius:8px;transition:background .15s;flex-shrink:0; }
.hbg-btn:hover { background:var(--bg); }
.hbg-btn span { display:block;width:18px;height:1.5px;background:var(--text);border-radius:2px; }
.drw-overlay { display:none;position:fixed;inset:0;background:rgba(0,0,0,.35);backdrop-filter:blur(2px);z-index:200; }
.drw-overlay.open { display:block; }
.drw-panel { position:fixed;top:0;left:0;bottom:0;width:min(280px,80vw);background:#fff;z-index:201;transform:translateX(-100%);transition:transform .28s cubic-bezier(.22,1,.36,1);display:flex;flex-direction:column;border-right:1px solid var(--border); }
.drw-panel.open { transform:translateX(0); }
.drw-head { padding:18px 20px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between; }
.drw-head-title { font-size:15px;font-weight:700;color:var(--text); }
.drw-close { width:30px;height:30px;border:none;background:var(--bg);border-radius:8px;cursor:pointer;font-size:16px;color:var(--text2);display:flex;align-items:center;justify-content:center; }
.drw-body { flex:1;padding:12px 10px;overflow-y:auto; }
.drw-sec-lbl { font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);padding:4px 10px 8px; }
.drw-item { display:flex;align-items:center;gap:11px;padding:11px 12px;border-radius:12px;text-decoration:none;color:var(--text2);font-size:14px;font-weight:500;transition:background .15s; }
.drw-item:hover { background:var(--bg); }
.drw-ico { width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0; }
</style>
</head>
<body>

<!-- 드로어 -->
<div class="drw-overlay" id="drwOverlay" onclick="drwClose()"></div>
<div class="drw-panel" id="drwPanel">
    <div class="drw-head">
        <span class="drw-head-title">Daily English</span>
        <button class="drw-close" onclick="drwClose()">✕</button>
    </div>
    <div class="drw-body">
        <div class="drw-sec-lbl">학습</div>
        <a class="drw-item" href="/DailyEnglish"><div class="drw-ico" style="background:#e8f0fe;">📖</div>학습 시작</a>
        <a class="drw-item" href="/DailyEnglish/Video"><div class="drw-ico" style="background:#fce4ec;">📹</div>영상 목록</a>
        <div class="drw-sec-lbl" style="margin-top:6px;">관리</div>
        <a class="drw-item" href="/DailyEnglish/AdminList"><div class="drw-ico" style="background:#e8f5e9;">📋</div>문장 목록</a>
        <a class="drw-item" href="/DailyEnglish/Create"><div class="drw-ico" style="background:#fff3e0;">✏️</div>새 문장 등록</a>
        <div class="drw-sec-lbl" style="margin-top:6px;">홈</div>
        <a class="drw-item" href="/"><div class="drw-ico" style="background:#f3e5f5;">🏠</div>잠실새내 유년부</a>
    </div>
</div>

<div class="page">

    <!-- 상단 타이틀 -->
    <div class="topbar">
        <button class="hbg-btn" onclick="drwOpen()" aria-label="메뉴"><span></span><span></span><span></span></button>
        <div>
            <div class="eyebrow">Admin Panel</div>
            <h1 class="page-title">일일 영어 관리</h1>
        </div>
        <a href="/DailyEnglish/Create" class="btn-add">＋ 새 문장 등록</a>
    </div>

    <!-- 통계 -->
    @{
        int total   = Model.Count;
        int readCnt = Model.Count(x => x.IsRead > 0);  // ✅ 1번이라도 읽은 것
        int unread  = total - readCnt;
    }
    <div class="stats">
        <div class="stat">
            <span class="stat-icon">📚</span>
            <div><div class="stat-lbl">전체</div><div class="stat-val">@total</div></div>
        </div>
        <div class="stat">
            <span class="stat-icon">✅</span>
            <div><div class="stat-lbl">읽음</div><div class="stat-val" style="color:var(--success)">@readCnt</div></div>
        </div>
        <div class="stat">
            <span class="stat-icon">📌</span>
            <div><div class="stat-lbl">미읽음</div><div class="stat-val" style="color:var(--warn)">@unread</div></div>
        </div>
    </div>

    <!-- 검색 -->
    <div class="search-wrap">
        <span class="search-ico">🔍</span>
        <input class="search-input" type="text" id="searchInput"
               placeholder="영어 문장 또는 한글 뜻으로 검색…" oninput="filterRows()" />
    </div>

    <!-- 목록 -->
    <div class="table-card">
        <table id="mainTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>영어 문장</th>
                    <th>한글 뜻</th>
                    <th>상태</th>
                    <th>관리</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @if (!Model.Any())
                {
                    <tr class="empty-row"><td colspan="5">등록된 문장이 없습니다.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr data-en="@item.EnglishText.ToLower()" data-ko="@item.KoreanText.ToLower()"
                        data-id="@item.Id"
                        class="row-clickable"
                        onclick="goToItem(this)"
                        title="클릭하면 학습 카드로 이동">
                        <td class="td-id">#@item.Id</td>
                        <td class="td-en td-link">@item.EnglishText</td>
                        <td class="td-ko">@item.KoreanText</td>
                        <td class="td-status">
                            @if (item.IsRead > 0)
                            {
                                <span class="badge badge-read"><span class="bdot"></span>읽음 @(item.IsRead)회</span>
                            }
                            else
                            {
                                <span class="badge badge-unread"><span class="bdot"></span>미읽음</span>
                            }
                        </td>
                        <td class="td-actions" onclick="event.stopPropagation()">
                            <a href="/DailyEnglish/Edit/@item.Id" class="btn-edit">✎ 수정</a>
                            <form method="post" action="/DailyEnglish/Delete" style="display:inline;"
                                  onsubmit="return confirm('정말 삭제하시겠습니까?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-del">✕ 삭제</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="tbl-footer">
            <div class="fc">총 <b>@total</b> 개 문장</div>
            <div class="fc">읽음 <b class="g">@readCnt</b> &nbsp;·&nbsp; 미읽음 <b class="w">@unread</b></div>
            <div class="fc" id="searchCount"></div>
        </div>
    </div>

</div>
<script>
/* 행 클릭 → Index?id=X */
function goToItem(row) {
    var id = row.dataset.id;
    if (id) window.location.href = '/DailyEnglish?id=' + id;
}

function filterRows() {
    var q = document.getElementById('searchInput').value.toLowerCase().trim();
    var rows = document.querySelectorAll('#tableBody tr[data-en]');
    var n = 0;
    rows.forEach(function(r) {
        var ok = !q || r.dataset.en.includes(q) || r.dataset.ko.includes(q);
        r.style.display = ok ? '' : 'none';
        if (ok) n++;
    });
    document.getElementById('searchCount').textContent = q ? '검색 결과: ' + n + '개' : '';
}
function drwOpen(){ document.getElementById('drwPanel').classList.add('open'); document.getElementById('drwOverlay').classList.add('open'); }
function drwClose(){ document.getElementById('drwPanel').classList.remove('open'); document.getElementById('drwOverlay').classList.remove('open'); }
document.addEventListener('keydown', function(e){ if(e.key==='Escape') drwClose(); });
</script>
</body>
</html>
