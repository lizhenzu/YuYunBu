@model StockBulletinBoard.Models.DailyEnglish

<div style="max-width:500px; margin:60px auto; font-family:'Segoe UI';">

    <div style="
        background:#ffffff;
        border-radius:20px;
        padding:30px;
        box-shadow:0 10px 30px rgba(0,0,0,0.1);
        text-align:center;
    ">

        @if (Model != null)
        {
            <!-- 영어 문장 -->
            <h1 style="font-size:28px; margin-bottom:10px;">
              @Model.Id.@Model.EnglishText
            </h1>

            <!-- 발음 버튼 -->
            <button onclick="speakText()" style="
                    margin-bottom:15px;
                    padding:8px 14px;
                    border:none;
                    border-radius:10px;
                    background:#4CAF50;
                    color:white;
                    cursor:pointer;
                ">
                🔊 발음 듣기
            </button>

            <!-- 한글 뜻 -->
            <p style="font-size:18px; color:#555;">
                @Model.KoreanText
            </p>

            <hr />

            <!-- 설명 -->
            <p style="color:#777;">
                @Model.Description
            </p>

            <!-- 예문 -->
            <p style="margin-top:10px;">
                <b>예문:</b> @Model.Example
            </p>

            <!-- 읽음 버튼 -->
            <form method="post" action="/DailyEnglish/MarkAsRead">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" style="
                        margin-top:20px;
                        padding:12px 20px;
                        border:none;
                        border-radius:12px;
                        background:#007bff;
                        color:white;
                        font-size:16px;
                        cursor:pointer;
                    ">
                    읽음 → 다음
                </button>
            </form>

            <!-- 현재 문장 삭제 버튼 -->
            <form method="post" action="/DailyEnglish/Delete"
                  onsubmit="return confirm('현재 영어 문장을 삭제하시겠습니까?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" style="
                margin-top:12px;
                padding:12px 20px;
                border:none;
                border-radius:12px;
                background:#dc2626;
                color:white;
                font-size:16px;
                cursor:pointer;
            ">
                    현재 문장 삭제
                </button>
            </form>
        }
        else
        {
            <h2>🎉 오늘의 영어 완료!</h2>
            <p>모든 문장을 읽었습니다.</p>

            <form method="post" action="/DailyEnglish/Reset">
                <button type="submit" style="
                        margin-top:20px;
                        padding:12px 20px;
                        border:none;
                        border-radius:12px;
                        background:#28a745;
                        color:white;
                        font-size:16px;
                        cursor:pointer;
                    ">
                    처음부터 다시 보기
                </button>
            </form>
        }

    </div>
</div>

<script>
    function speakText() {
        var text = "@Model?.EnglishText";

        if (!text) return;

        var utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = "en-US"; // 영어 발음
        speechSynthesis.speak(utterance);
    }
</script>