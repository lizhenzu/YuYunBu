@model StockBulletinBoard.Models.DailyEnglish

<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Daily English</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,700;1,400&display=swap" rel="stylesheet" />
<style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }

:root {
    --bg:      #f5f5f7;      /* Apple off-white */
    --white:   #ffffff;
    --ink:     #1d1d1f;      /* Apple black */
    --ink2:    #3d3d3f;
    --sub:     #6e6e73;      /* Apple secondary */
    --subtle:  #a1a1a6;
    --border:  #e8e8ed;
    --accent:  #0071e3;      /* Apple blue */
    --acc-lt:  #e8f0fe;
    --green:   #30d158;      /* Apple green */
    --grn-lt:  #e9f9ee;
    --red:     #ff3b30;
    --r:       22px;
}

html, body {
    min-height: 100vh;
    background: var(--bg);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", "Noto Sans KR", sans-serif;
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
}

/* ─── LAYOUT ─── */
.shell {
    /* flex 제거 — 카드·버튼이 자연 흐름으로 붙음 */
}

/* ─── TOP BAR (스크롤과 함께 이동 — no sticky) ─── */
.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px 10px;
    gap: 12px;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.menu-btn {
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    gap: 4.5px; width: 36px; height: 36px;
    border: none; background: none; cursor: pointer; border-radius: 8px;
    transition: background .15s;
    flex-shrink: 0;
}
.menu-btn:hover { background: var(--bg); }
.menu-btn span {
    display: block; width: 18px; height: 1.5px;
    background: var(--ink); border-radius: 2px; transition: all .2s;
}

.topbar-title {
    font-size: 15px; font-weight: 700; letter-spacing: -.2px; color: var(--ink);
    flex: 1; text-align: center;
}

.progress-wrap {
    display: flex; align-items: center; gap: 6px; flex-shrink: 0;
}
.progress-text {
    font-size: 12px; font-weight: 600; color: var(--sub); white-space: nowrap;
    min-width: 44px; text-align: right;
}
.progress-track {
    width: 48px; height: 4px; background: var(--border); border-radius: 4px; overflow: hidden;
}
.progress-fill {
    height: 100%; background: var(--accent); border-radius: 4px;
    transition: width .4s ease;
}

/* ─── CARD AREA ─── */
.card-area {
    padding: 10px 14px 0;
}

.flash-card {
    background: var(--white);
    border-radius: var(--r);
    border: 1px solid var(--border);
    padding: clamp(16px,3.5vw,24px) clamp(18px,4vw,28px);
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 0 rgba(0,0,0,.05);
}

/* ─── CHIP ─── */
.category-chip {
    display: inline-flex; align-items: center; gap: 5px;
    background: var(--acc-lt); color: var(--accent);
    border-radius: 20px; padding: 4px 11px;
    font-size: 11.5px; font-weight: 600;
    margin-bottom: 20px; align-self: flex-start;
}

/* ─── FRONT (한글) ─── */
.front-area {
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 16px;
    border-bottom: 1.5px solid var(--border);
    margin-bottom: 16px;
    min-height: 100px;
    transition: opacity .2s;
}
.front-area:active { opacity: .7; }

.korean-text {
    font-size: clamp(24px,6vw,36px);
    font-weight: 700;
    color: var(--ink);
    line-height: 1.35;
    letter-spacing: -.02em;
    word-break: keep-all;
}

.tap-hint {
    display: flex; align-items: center; gap: 8px;
    margin-top: 18px;
    font-size: 13px; font-weight: 500;
    color: var(--subtle);
}
.tap-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent); opacity: .5;
    animation: dotPulse 1.8s ease infinite;
}
.tap-dot:nth-child(2) { animation-delay: .2s; }
.tap-dot:nth-child(3) { animation-delay: .4s; }
@@keyframes dotPulse { 0%,100%{opacity:.5;transform:scale(1)} 50%{opacity:.15;transform:scale(.7)} }

/* ─── BACK (영어 공개) ─── */
.back-area {
    display: none;
    animation: revealUp .35s cubic-bezier(.22,1,.36,1) both;
}
.back-area.visible { display: block; }
@@keyframes revealUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }

.english-text {
    font-family: 'Lora', serif;
    font-size: clamp(22px,5.5vw,32px);
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
    letter-spacing: -.02em;
    margin-bottom: 18px;
}

/* 발음 버튼 */
.btn-speak {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 16px; border-radius: 20px;
    background: none;
    border: 1.5px solid var(--border);
    color: var(--accent);
    font-size: 13px; font-weight: 600;
    cursor: pointer; transition: all .18s;
    margin-bottom: 24px;
}
.btn-speak:hover { background: var(--acc-lt); border-color: var(--accent); }
.btn-speak.speaking { background: var(--acc-lt); }
.speak-ico {
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--accent); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 9px; flex-shrink: 0;
}

/* 핵심 단어 */
.vocab-section { margin-bottom: 22px; }
.section-label {
    font-size: 10.5px; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; color: var(--subtle);
    margin-bottom: 10px;
}
.vocab-pills { display: flex; flex-wrap: wrap; gap: 7px; }
.vocab-pill {
    display: inline-flex; align-items: baseline; gap: 3px;
    background: var(--bg); border: 1.5px solid var(--border);
    border-radius: 10px; padding: 6px 11px;
    font-size: 12.5px; color: var(--ink2); line-height: 1.3;
    transition: border-color .15s;
}
.vocab-pill:hover { border-color: #aaa; }
.vk { font-weight: 700; color: var(--accent); }
.veq { color: var(--subtle); margin: 0 2px; font-size: 11px; }
.vv { color: var(--sub); }

/* 예문 */
.example-section { margin-bottom: 8px; }
.example-en {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: clamp(13px,3vw,15px);
    color: var(--ink2);
    line-height: 1.6;
    margin-bottom: 5px;
}
.example-ko {
    font-size: clamp(12px,2.8vw,13.5px);
    color: var(--sub);
    line-height: 1.5;
}

/* ─── COMPLETE ─── */
.complete-wrap { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; text-align:center; padding:30px 0; }
.complete-icon { font-size: 64px; }
.complete-title { font-size: 26px; font-weight: 700; color: var(--ink); }
.complete-sub { font-size: 15px; color: var(--sub); }

/* ─── BOTTOM BAR — 카드 바로 아래 자연스럽게 ─── */
.bottom-bar {
    padding: 12px 14px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.btn-next {
    width: 100%; min-height: 50px;
    border: none; border-radius: 14px; cursor: pointer;
    background: var(--accent);
    color: #fff;
    font-size: 16px; font-weight: 700; letter-spacing: -.02em;
    display: flex; align-items: center; justify-content: center;
    gap: 8px;
    transition: opacity .15s, transform .1s;
}
.btn-next:hover { opacity: .88; }
.btn-next:active { transform: scale(.98); }

.btn-skip {
    width: 100%; min-height: 40px;
    border: 1.5px solid var(--border); border-radius: 12px; cursor: pointer;
    background: transparent; color: var(--red);
    font-size: 13.5px; font-weight: 600;
    transition: all .18s;
}
.btn-skip:hover { background: #fff2f2; border-color: var(--red); }

/* ─── 이전/다음 네비게이션 ─── */
.nav-row {
    display: flex;
    gap: 8px;
    align-items: center;
}
.btn-nav {
    flex: 1;
    min-height: 42px;
    border: 1.5px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    color: var(--ink2);
    font-size: 13.5px; font-weight: 600;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 6px;
    transition: all .18s;
    text-decoration: none;
}
.btn-nav:hover { border-color: var(--accent); color: var(--accent); background: var(--acc-lt); }
.btn-nav:active { transform: scale(.97); }
.btn-nav.disabled { opacity: .35; pointer-events: none; }

/* ─── HAMBURGER DRAWER ─── */
.drawer-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,.35); backdrop-filter: blur(2px);
    z-index: 100;
}
.drawer-overlay.open { display: block; }

.drawer {
    position: fixed; top: 0; left: 0; bottom: 0;
    width: min(280px, 80vw);
    background: var(--white);
    z-index: 101;
    transform: translateX(-100%);
    transition: transform .28s cubic-bezier(.22,1,.36,1);
    display: flex; flex-direction: column;
}
.drawer.open { transform: translateX(0); }

.drawer-head {
    padding: 18px 20px 14px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
}
.drawer-title { font-size: 15px; font-weight: 700; color: var(--ink); }
.drawer-close {
    width: 30px; height: 30px; border: none; background: var(--bg);
    border-radius: 8px; cursor: pointer; font-size: 16px; color: var(--sub);
    display: flex; align-items: center; justify-content: center;
}

.drawer-body { flex: 1; padding: 12px 10px; overflow-y: auto; }
.drawer-section { margin-bottom: 6px; }
.drawer-section-label {
    font-size: 10px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: var(--subtle);
    padding: 4px 10px 8px;
}
.drawer-item {
    display: flex; align-items: center; gap: 11px;
    padding: 11px 12px; border-radius: 12px;
    text-decoration: none; color: var(--ink2);
    font-size: 14px; font-weight: 500;
    transition: background .15s;
    cursor: pointer;
}
.drawer-item:hover { background: var(--bg); }
.drawer-item .di-ico {
    width: 32px; height: 32px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; flex-shrink: 0;
}

@@media (max-width: 400px) {
    .flash-card { padding: 20px 16px; }
    .english-text { font-size: 20px; }
    .korean-text { font-size: 22px; }
}
</style>
</head>
<body>

<!-- 드로어 오버레이 -->
<div class="drawer-overlay" id="overlay" onclick="closeDrawer()"></div>

<!-- 햄버거 드로어 -->
<div class="drawer" id="drawer">
    <div class="drawer-head">
        <span class="drawer-title">Daily English</span>
        <button class="drawer-close" onclick="closeDrawer()">✕</button>
    </div>
    <div class="drawer-body">
        <div class="drawer-section">
            <div class="drawer-section-label">학습</div>
            <a class="drawer-item" href="/DailyEnglish">
                <div class="di-ico" style="background:#e8f0fe;">📖</div>
                <span>학습 시작</span>
            </a>
            <a class="drawer-item" href="/DailyEnglish/Video">
                <div class="di-ico" style="background:#fce4ec;">📹</div>
                <span>영상 목록</span>
            </a>
            <a class="drawer-item" href="https://www.youtube.com/watch?v=oV6AMCHlj3A&list=PLMHkH5U2B3GqMyTMGvCrvV2NjT848Y1oV" target="_blank" rel="noopener">
                <div class="di-ico" style="background:#ffebee;">🎬</div>
                <span>미드영어회화</span>
            </a>
                <a class="drawer-item" href="https://www.youtube.com/watch?v=VbdHcUDbK6g" target="_blank" rel="noopener">
                    <div class="di-ico" style="background:#ffebee;">🎬</div>
                    <span>원어민이...</span>
                </a>
            </div>
        <div class="drawer-section">
            <div class="drawer-section-label">관리</div>
            <a class="drawer-item" href="/DailyEnglish/AdminList">
                <div class="di-ico" style="background:#e8f5e9;">📋</div>
                <span>문장 목록</span>
            </a>
            <a class="drawer-item" href="/DailyEnglish/Create">
                <div class="di-ico" style="background:#fff3e0;">✏️</div>
                <span>새 문장 등록</span>
            </a>
        </div>
        <div class="drawer-section">
            <div class="drawer-section-label">홈</div>
            <a class="drawer-item" href="/">
                <div class="di-ico" style="background:#f3e5f5;">🏠</div>
                <span>잠실새내 유년부</span>
            </a>
        </div>
    </div>
</div>

<!-- 메인 쉘 -->
<div class="shell">

    <!-- 상단 바 (스크롤과 함께 이동) -->
    <div class="topbar">
        <button class="menu-btn" id="menuBtn" onclick="openDrawer()" aria-label="메뉴">
            <span></span><span></span><span></span>
        </button>
        <div class="topbar-title">Daily English</div>
        <div class="progress-wrap">
            @{
                var unreadCnt = (int)(ViewBag.UnreadCount ?? 0);
                var totCount  = (int)(ViewBag.TotalCount  ?? 0);
                // 진도 바: 읽은 비율 (전체 - 미읽음)
                var readCnt  = totCount - unreadCnt;
                var initPct  = totCount > 0 ? (int)Math.Round(readCnt * 100.0 / totCount) : 0;
                var initText = totCount > 0 ? $"안읽음 {unreadCnt} / {totCount}" : "—";
            }
            <div class="progress-track">
                <div class="progress-fill" id="progFill" style="width:@(initPct)%"></div>
            </div>
            <span class="progress-text" id="progText" style="min-width:88px;">@initText</span>
        </div>
    </div>

    <!-- 카드 영역 -->
    <div class="card-area">
        <div class="flash-card" id="flashCard">

            @if (Model != null)
            {
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="category-chip">🏷 @Model.Description</div>
                }

                <!-- 앞면: 한글 -->
                <div class="front-area" id="frontArea" onclick="revealEnglish()" role="button">
                    <div class="korean-text">@Model.KoreanText</div>
                    <div class="tap-hint" id="tapHint">
                        <span class="tap-dot"></span>
                        <span class="tap-dot"></span>
                        <span class="tap-dot"></span>
                        <span style="margin-left:4px;">탭하여 영어 확인</span>
                    </div>
                </div>

                <!-- 뒷면: 영어 공개 후 -->
                <div class="back-area" id="backArea">
                    <div class="english-text">@Model.EnglishText</div>

                    <button class="btn-speak" onclick="speak(this)">
                        <span class="speak-ico">♪</span>
                        <span class="speak-label">발음 듣기</span>
                    </button>

                    @if (!string.IsNullOrWhiteSpace(Model.VocabNote))
                    {
                        <div class="vocab-section">
                            <div class="section-label">🔑 핵심 단어 · 숙어</div>
                            <div class="vocab-pills" id="vocabPills"></div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Example))
                    {
                        <div class="example-section">
                            <div class="section-label">📖 예문</div>
                            <div class="example-en">@Model.Example</div>
                            @if (!string.IsNullOrWhiteSpace(Model.ExampleKorean))
                            {
                                <div class="example-ko">🇰🇷 @Model.ExampleKorean</div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- 완료 화면 -->
                <div class="complete-wrap">
                    <div class="complete-icon">🎉</div>
                    <div class="complete-title">오늘 완료!</div>
                    <div class="complete-sub">모든 문장을 학습했습니다 👏</div>
                </div>
            }

        </div>
    </div>

    <!-- 하단 액션 바 -->
    <div class="bottom-bar">
        @if (Model != null)
        {
            
                var prevId = ViewBag.PrevId as int?;
                var nextId = ViewBag.NextId as int?;
            

            <!-- 이전 / 다음 네비게이션 -->
            <div class="nav-row">
                @if (prevId.HasValue)
                {
                    <a href="/DailyEnglish?id=@prevId" class="btn-nav">← 이전</a>
                }
                else
                {
                    <span class="btn-nav disabled">← 이전</span>
                }
                @if (nextId.HasValue)
                {
                    <a href="/DailyEnglish?id=@nextId" class="btn-nav">다음 →</a>
                }
                else
                {
                    <span class="btn-nav disabled">다음 →</span>
                }
            </div>

            <!-- 읽음 처리 + 다음 미읽음 -->
            <form method="post" action="/DailyEnglish/MarkAsRead" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-next">✓ &nbsp;읽음 — 다음 미읽은 문장</button>
            </form>

            <form method="post" action="/DailyEnglish/Delete"
                  onsubmit="return confirm('현재 문장을 삭제할까요?')" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-skip">이 문장 삭제</button>
            </form>
        }
        else
        {
            <form method="post" action="/DailyEnglish/Reset" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-next" style="background:#30d158;">↺ &nbsp;처음부터 다시 보기</button>
            </form>
        }
    </div>

</div><!-- /shell -->

<script>
/* ─── VocabNote 파싱 ─── */
(function() {
    var raw = "@(Model?.VocabNote?.Replace("\"","\\\"").Replace("\r","").Replace("\n","") ?? "")";
    var container = document.getElementById('vocabPills');
    if (!raw || !container) return;
    raw.split('|').forEach(function(item) {
        item = item.trim();
        if (!item) return;
        var pill = document.createElement('span');
        pill.className = 'vocab-pill';
        var eqIdx = item.indexOf('=');
        if (eqIdx > -1) {
            var k = item.substring(0, eqIdx).trim();
            var v = item.substring(eqIdx + 1).trim();
            pill.innerHTML = '<span class="vk">' + k + '</span><span class="veq">=</span><span class="vv">' + v + '</span>';
        } else {
            pill.innerHTML = '<span class="vk">' + item + '</span>';
        }
        container.appendChild(pill);
    });
})();

/* ─── 영어 공개 ─── */
function revealEnglish() {
    var front = document.getElementById('frontArea');
    var back  = document.getElementById('backArea');
    var hint  = document.getElementById('tapHint');
    if (!back || back.classList.contains('visible')) return;
    if (hint) { hint.style.opacity='0'; setTimeout(function(){ hint.style.display='none'; }, 200); }
    if (front) { front.style.cursor='default'; front.removeAttribute('onclick'); }
    back.classList.add('visible');
    setTimeout(function() { back.scrollIntoView({ behavior:'smooth', block:'nearest' }); }, 100);
}

/* ─── 발음 듣기 ─── */
function speak(btn) {
    var text = "@(Model?.EnglishText?.Replace("\"","\\\"") ?? "")";
    if (!text) return;
    var lbl = btn.querySelector('.speak-label');
    var utt = new SpeechSynthesisUtterance(text);
    utt.lang = 'en-US'; utt.rate = 0.9;
    btn.classList.add('speaking');
    lbl.textContent = '재생 중…';
    utt.onend = function() { btn.classList.remove('speaking'); lbl.textContent = '발음 듣기'; };
    speechSynthesis.cancel();
    speechSynthesis.speak(utt);
}

/* ─── 진도바 ─── */
(function() {
    var fill = document.getElementById('progFill');
    var text = document.getElementById('progText');
    if (!fill || !text) return;
    fetch('/DailyEnglish/Progress')
        .then(function(r){ return r.json(); })
        .catch(function(){ return null; })
        .then(function(d) {
            if (!d) return;
            // 읽은 비율로 진도 바 채움, 텍스트는 미읽음/전체
            var readCnt = d.total - d.unread;
            var pct = d.total > 0 ? Math.round(readCnt / d.total * 100) : 0;
            fill.style.width = pct + '%';
            text.textContent = '안읽음 ' + d.unread + ' / ' + d.total;
        });
})();

/* ─── 드로어 ─── */
function openDrawer() {
    document.getElementById('drawer').classList.add('open');
    document.getElementById('overlay').classList.add('open');
}
function closeDrawer() {
    document.getElementById('drawer').classList.remove('open');
    document.getElementById('overlay').classList.remove('open');
}
document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeDrawer(); });
</script>

</body>
</html>
