@model List<StockBulletinBoard.Models.DailyEnglishVideo>

<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Daily English — 영상 목록</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

:root {
    --bg:      #f0f4ff;
    --white:   #ffffff;
    --primary: #4f46e5;
    --pri2:    #6366f1;
    --pri-lt:  #eef2ff;
    --pri-md:  #c7d2fe;
    --text:    #1e293b;
    --text2:   #475569;
    --muted:   #94a3b8;
    --border:  #e2e8f0;
    --danger:  #ef4444;
    --dan-lt:  #fee2e2;
    --red:     #dc2626;
}

html, body { min-height:100vh; background:var(--bg); font-family:'Inter',sans-serif; color:var(--text); }
body::before {
    content:''; position:fixed; inset:0; pointer-events:none;
    background: radial-gradient(ellipse 65% 45% at 5% 0%, rgba(99,102,241,.07), transparent 55%);
}
a { text-decoration:none; color:inherit; }

/* ── PAGE ── */
.page {
    position:relative; max-width:1100px; margin:0 auto;
    padding: clamp(24px,5vw,44px) clamp(14px,4vw,28px) 80px;
}

/* ── 헤더 ── */
.topbar { display:flex; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; gap:14px; margin-bottom: clamp(20px,4vw,32px); animation: fadeDown .5s ease both; }
.eyebrow { font-size:11px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:var(--primary); margin-bottom:4px; display:flex; align-items:center; gap:6px; }
.eyebrow::before { content:''; display:inline-block; width:20px; height:1.5px; background:var(--primary); border-radius:2px; }
.page-title { font-size: clamp(22px,5vw,30px); font-weight:700; color:var(--text); letter-spacing:-.02em; }
.back-link {
    display:inline-flex; align-items:center; gap:6px;
    font-size:13px; font-weight:600; color:var(--primary);
    padding:8px 14px; border-radius:10px;
    border:1.5px solid var(--pri-md); background:var(--pri-lt);
    transition:all .18s;
}
.back-link:hover { background:var(--pri-md); }

/* ── 등록 폼 ── */
.add-card {
    background:var(--white); border-radius:20px;
    border:1.5px solid var(--border);
    box-shadow:0 4px 20px rgba(0,0,0,.05);
    padding: clamp(18px,3.5vw,28px) clamp(16px,3vw,28px);
    margin-bottom: clamp(20px,4vw,32px);
    animation: riseUp .55s cubic-bezier(.22,1,.36,1) .1s both;
    position:relative; overflow:hidden;
}
.add-card::before {
    content:''; position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg,var(--primary),var(--pri2),#818cf8);
    border-radius:20px 20px 0 0;
}
.add-title { font-size:14px; font-weight:700; color:var(--text2); margin-bottom:14px; display:flex; align-items:center; gap:7px; }
.add-fields { display:grid; grid-template-columns:1fr 2fr auto; gap:10px; align-items:end; }
.field-group { display:flex; flex-direction:column; gap:5px; }
.field-group label { font-size:11.5px; font-weight:700; color:var(--muted); letter-spacing:.06em; text-transform:uppercase; }
.field-group input {
    padding: clamp(10px,2vw,12px) 14px;
    background:var(--bg); border:1.5px solid var(--border); border-radius:12px;
    color:var(--text); font-family:'Inter',sans-serif; font-size:14px;
    outline:none; transition:border-color .2s, box-shadow .2s; min-height:46px;
}
.field-group input:focus { border-color:var(--primary); background:var(--white); box-shadow:0 0 0 3px rgba(99,102,241,.1); }
.field-group input::placeholder { color:var(--muted); }
.btn-add {
    display:inline-flex; align-items:center; justify-content:center; gap:7px;
    padding:0 22px; min-height:46px; border-radius:12px;
    border:none; cursor:pointer;
    background:linear-gradient(135deg,var(--primary),var(--pri2));
    color:#fff; font-size:14px; font-weight:700;
    box-shadow:0 4px 14px rgba(99,102,241,.28); transition:all .2s;
    white-space:nowrap;
}
.btn-add:hover { transform:translateY(-2px); box-shadow:0 8px 20px rgba(99,102,241,.36); }
.btn-add:active { transform:scale(.98); }

/* ── 영상 그리드 ── */
.video-grid {
    display:grid;
    grid-template-columns: repeat(auto-fill, minmax(240px,1fr));
    gap: clamp(12px,2.5vw,18px);
    animation: fadeIn .6s ease .2s both;
}
.video-card {
    background:var(--white); border-radius:18px;
    border:1.5px solid var(--border);
    overflow:hidden;
    box-shadow:0 2px 12px rgba(0,0,0,.05);
    transition:transform .2s, box-shadow .2s, border-color .2s;
    display:flex; flex-direction:column;
}
.video-card:hover { transform:translateY(-3px); box-shadow:0 8px 28px rgba(99,102,241,.14); border-color:var(--pri-md); }

/* 썸네일 */
.vc-thumb {
    position:relative; aspect-ratio:16/9; overflow:hidden; background:#f1f5f9;
    cursor:pointer; display:block;
}
.vc-thumb img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .3s; }
.video-card:hover .vc-thumb img { transform:scale(1.04); }
.vc-play {
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    background:rgba(15,20,40,.35); opacity:0; transition:opacity .2s;
}
.video-card:hover .vc-play { opacity:1; }
.play-ico {
    width:52px; height:52px; border-radius:50%;
    background:rgba(255,255,255,.92); display:flex; align-items:center; justify-content:center;
    font-size:22px; box-shadow:0 4px 20px rgba(0,0,0,.25);
}

/* 카드 바디 */
.vc-body { padding:12px 14px 14px; flex:1; display:flex; flex-direction:column; gap:8px; }
.vc-title {
    font-size:13.5px; font-weight:700; color:var(--text); line-height:1.4;
    overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
}
.vc-meta { display:flex; align-items:center; justify-content:space-between; margin-top:auto; }
.vc-id {
    display:inline-flex; align-items:center; gap:4px;
    font-size:11px; font-weight:600; color:var(--muted);
    background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:2px 7px;
}
.vc-date { font-size:11px; color:var(--muted); }

/* 카드 액션 버튼 */
.vc-actions { display:flex; gap:8px; padding:0 14px 14px; }
.btn-play {
    flex:1; display:flex; align-items:center; justify-content:center; gap:6px;
    padding:9px; border-radius:10px;
    border:none; cursor:pointer;
    background:linear-gradient(135deg,var(--primary),var(--pri2));
    color:#fff; font-size:13px; font-weight:700;
    box-shadow:0 3px 10px rgba(99,102,241,.25); transition:all .18s; text-decoration:none;
}
.btn-play:hover { transform:translateY(-1px); box-shadow:0 6px 16px rgba(99,102,241,.35); }
.btn-vdel {
    display:flex; align-items:center; justify-content:center; gap:4px;
    padding:9px 13px; border-radius:10px;
    background:var(--dan-lt); border:1.5px solid #fecaca; color:var(--red);
    font-size:13px; font-weight:700; cursor:pointer; transition:all .18s;
}
.btn-vdel:hover { background:#fca5a5; border-color:#f87171; color:#fff; }

/* 빈 상태 */
.empty-state {
    grid-column:1/-1; text-align:center; padding:60px 20px;
    color:var(--muted);
}
.empty-state .ei { font-size:48px; margin-bottom:14px; }
.empty-state p { font-size:14px; font-weight:500; }

/* 개수 배지 */
.count-badge {
    display:inline-flex; align-items:center; gap:6px;
    font-size:12px; font-weight:700; color:var(--primary);
    background:var(--pri-lt); border-radius:8px; padding:4px 10px;
    margin-bottom:14px;
}

@@keyframes fadeDown { from{opacity:0;transform:translateY(-10px)} to{opacity:1;transform:translateY(0)} }
@@keyframes riseUp   { from{opacity:0;transform:translateY(18px) scale(.98)} to{opacity:1;transform:translateY(0) scale(1)} }
@@keyframes fadeIn   { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }

@@media (max-width:560px) {
    .add-fields { grid-template-columns:1fr; }
    .btn-add { width:100%; }
}
</style>
</head>
<body>
<div class="page">

    <!-- 헤더 -->
    <div class="topbar">
        <div>
            <div class="eyebrow">Daily English</div>
            <h1 class="page-title">📹 영상 목록</h1>
        </div>
        <a href="/DailyEnglish" class="back-link">← 학습으로</a>
    </div>

    <!-- 등록 폼 -->
    <div class="add-card">
        <div class="add-title">➕ 새 영상 등록</div>
        <form method="post" action="/DailyEnglish/VideoAdd">
            @Html.AntiForgeryToken()
            <div class="add-fields">
                <div class="field-group">
                    <label>YouTube ID / URL</label>
                    <input type="text" name="youTubeId" placeholder="YCFg0FqOSNA 또는 전체 URL" required />
                </div>
                <div class="field-group">
                    <label>제목</label>
                    <input type="text" name="title" placeholder="영상 제목을 입력하세요" required />
                </div>
                <button type="submit" class="btn-add">▶ 등록</button>
            </div>
        </form>
    </div>

    <!-- 개수 -->
    @if (Model != null && Model.Any())
    {
        <div class="count-badge">📹 총 @(@Model.Count)개 영상</div>
    }

    <!-- 영상 그리드 -->
    <div class="video-grid">
        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div class="ei">🎬</div>
                <p>등록된 영상이 없습니다.<br />위 폼에서 YouTube 영상을 등록해 보세요!</p>
            </div>
        }
        else
        {
            @foreach (var v in Model)
            {
                <div class="video-card">
                    <!-- 썸네일 클릭 → 재생 페이지 -->
                    <a href="/DailyEnglish/VideoPlay/@v.Id" class="vc-thumb">
                        <img src="@v.ThumbnailUrl"
                             alt="@v.Title"
                             onerror="this.onerror=null;this.src='https://img.youtube.com/vi/@v.YouTubeId/default.jpg';" />
                        <div class="vc-play">
                            <div class="play-ico">▶</div>
                        </div>
                    </a>

                    <div class="vc-body">
                        <div class="vc-title">@v.Title</div>
                        <div class="vc-meta">
                            <span class="vc-id">@v.YouTubeId</span>
                            <span class="vc-date">@v.CreatedAt.ToString("yy.MM.dd")</span>
                        </div>
                    </div>

                    <div class="vc-actions">
                        <a href="/DailyEnglish/VideoPlay/@v.Id" class="btn-play">▶ 재생</a>
                        <form method="post" action="/DailyEnglish/VideoDelete"
                              onsubmit="return confirm('@v.Title 을(를) 삭제할까요?')" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@v.Id" />
                            <button type="submit" class="btn-vdel">✕</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>

</div>
</body>
</html>
