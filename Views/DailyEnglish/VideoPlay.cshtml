@model StockBulletinBoard.Models.DailyEnglishVideo

<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@Model.Title — Daily English</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

:root {
    --bg:      #f0f4ff;
    --white:   #ffffff;
    --primary: #4f46e5;
    --pri2:    #6366f1;
    --pri-lt:  #eef2ff;
    --pri-md:  #c7d2fe;
    --text:    #1e293b;
    --text2:   #475569;
    --muted:   #94a3b8;
    --border:  #e2e8f0;
}

html, body {
    min-height:100vh; background:var(--bg);
    font-family:'Inter',sans-serif; color:var(--text);
}
body::before {
    content:''; position:fixed; inset:0; pointer-events:none;
    background: radial-gradient(ellipse 65% 45% at 5% 0%, rgba(99,102,241,.07), transparent 55%);
}

/* ── PAGE ── */
.page {
    position:relative; max-width:900px; margin:0 auto;
    padding: clamp(24px,5vw,44px) clamp(14px,4vw,24px) 80px;
    animation: riseUp .55s cubic-bezier(.22,1,.36,1) both;
}

/* ── 상단 네비 ── */
.nav-bar {
    display:flex; align-items:center; justify-content:space-between;
    flex-wrap:wrap; gap:12px;
    margin-bottom: clamp(18px,3.5vw,28px);
}
.back-btn {
    display:inline-flex; align-items:center; gap:7px;
    font-size:13px; font-weight:600; color:var(--primary);
    padding:9px 16px; border-radius:10px;
    border:1.5px solid var(--pri-md); background:var(--pri-lt);
    transition:all .18s; cursor:pointer;
}
.back-btn:hover { background:var(--pri-md); }
.nav-title {
    font-size: clamp(14px,3vw,16px); font-weight:700; color:var(--text2);
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    max-width:500px;
}

/* ── 플레이어 카드 ── */
.player-card {
    background:var(--white); border-radius: clamp(16px,3vw,24px);
    border:1.5px solid var(--border);
    box-shadow:0 4px 28px rgba(99,102,241,.10);
    overflow:hidden;
    position:relative;
}
.player-card::before {
    content:''; position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg,var(--primary),var(--pri2),#818cf8);
}

/* 16:9 아이프레임 래퍼 */
.iframe-wrap {
    position:relative; width:100%; padding-bottom:56.25%;
    background:#000;
}
.iframe-wrap iframe {
    position:absolute; inset:0; width:100%; height:100%;
    border:none;
}

/* 하단 정보 바 */
.info-bar {
    padding: clamp(14px,3vw,20px) clamp(16px,3.5vw,24px);
    display:flex; align-items:flex-start; justify-content:space-between;
    flex-wrap:wrap; gap:12px;
}
.video-title {
    font-size: clamp(16px,3.5vw,20px); font-weight:700; color:var(--text);
    line-height:1.35; flex:1; min-width:0;
}
.vid-meta { display:flex; align-items:center; gap:10px; flex-shrink:0; flex-wrap:wrap; }
.vid-id-chip {
    display:inline-flex; align-items:center; gap:5px;
    background:var(--pri-lt); color:var(--primary); border-radius:8px;
    padding:4px 10px; font-size:11px; font-weight:700; white-space:nowrap;
}
.vid-date { font-size:12px; color:var(--muted); font-weight:500; }

/* 하단 버튼 바 */
.action-bar {
    display:flex; gap:10px; flex-wrap:wrap;
    padding: 0 clamp(16px,3.5vw,24px) clamp(16px,3vw,20px);
}
.btn-yt {
    display:inline-flex; align-items:center; gap:7px;
    padding:10px 18px; border-radius:12px;
    background:#ff0000; border:none; color:#fff;
    font-size:13px; font-weight:700; cursor:pointer;
    transition:all .18s; text-decoration:none;
    box-shadow:0 3px 12px rgba(255,0,0,.25);
}
.btn-yt:hover { transform:translateY(-1px); box-shadow:0 6px 16px rgba(255,0,0,.35); }
.btn-list {
    display:inline-flex; align-items:center; gap:7px;
    padding:10px 18px; border-radius:12px;
    border:1.5px solid var(--border); background:transparent; color:var(--text2);
    font-size:13px; font-weight:600; cursor:pointer; transition:all .18s;
}
.btn-list:hover { background:var(--bg); border-color:var(--primary); color:var(--primary); }

@@keyframes riseUp { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }
</style>
</head>
<body>
<div class="page">

    <!-- 네비 -->
    <div class="nav-bar">
        <a href="/DailyEnglish/Video" class="back-btn">← 목록으로</a>
        <div class="nav-title">📹 @Model.Title</div>
    </div>

    <!-- 플레이어 카드 -->
    <div class="player-card">

        <!-- YouTube 임베드 -->
        <div class="iframe-wrap">
            <iframe
                src="https://www.youtube.com/embed/@Model.YouTubeId?autoplay=1&rel=0&modestbranding=1"
                title="@Model.Title"
                allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                allowfullscreen>
            </iframe>
        </div>

        <!-- 제목 + 메타 -->
        <div class="info-bar">
            <div class="video-title">@Model.Title</div>
            <div class="vid-meta">
                <span class="vid-id-chip">▶ @Model.YouTubeId</span>
                <span class="vid-date">@Model.CreatedAt.ToString("yyyy.MM.dd")</span>
            </div>
        </div>

        <!-- 버튼 -->
        <div class="action-bar">
            <a href="https://www.youtube.com/watch?v=@Model.YouTubeId"
               target="_blank" rel="noopener" class="btn-yt">
                ▶ YouTube에서 보기
            </a>
            <a href="/DailyEnglish/Video" class="btn-list">☰ 목록</a>
        </div>

    </div>
</div>
</body>
</html>
