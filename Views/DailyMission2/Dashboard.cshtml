<script>
(function () {
    // ── 포인트 카운트업 ──
    var ptEl = document.getElementById('dqPtNum');
    if (ptEl) {
        var target = @total, dur = 1000, start = null;
        function countUp(ts) {
            if (!start) start = ts;
            var p    = Math.min((ts - start) / dur, 1);
            var ease = 1 - Math.pow(1 - p, 3);
            ptEl.textContent = Math.round(ease * target).toLocaleString('ko-KR');
            if (p < 1) requestAnimationFrame(countUp);
        }
        requestAnimationFrame(countUp);
    }

    // ── SVG 링 애니메이션 (CSS 트랜지션 트리거) ──
    var prog = document.getElementById('dqRingProg');
    if (prog) {
        var targetOff = parseFloat(prog.getAttribute('data-target-offset'));
        // 렌더 후 한 프레임 뒤에 offset 적용 → CSS transition 발동
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                prog.style.strokeDashoffset = targetOff;
            });
        });
    }
})();
</script>

