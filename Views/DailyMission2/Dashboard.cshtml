        <style>
            /* 위아래 여백은 이 화면의 다른 카드와 같은 규칙(아래 16px)을 쓴다.
               위쪽 여백은 앞 카드의 margin-bottom 이 이미 만들어 준다. */
            .gift-banner {
                display: flex; align-items: center; gap: 16px;
                text-decoration: none; color: inherit;
                background: linear-gradient(135deg, #F59E0B, #D97706);
                border-radius: 16px; padding: 20px 18px; margin: 0 0 16px;
                min-height: 144px;
                box-shadow: 0 6px 18px rgba(217,119,6,.28);
                transition: box-shadow .18s, transform .18s;
            }
            .gift-banner:hover { box-shadow: 0 10px 26px rgba(217,119,6,.36); transform: translateY(-1px); }
            .gift-banner:active { transform: translateY(0); }

            .gift-tx { flex: 1; min-width: 0; color: #fff; text-align: left; }
            .gift-t  { display: block; font-size: 18px; font-weight: 900; letter-spacing: -.3px; }
            .gift-s  { display: block; font-size: 13px; margin-top: 7px; line-height: 1.5; color: rgba(255,255,255,.9); }
            .gift-r  { flex: 0 0 auto; text-align: right; color: #fff; white-space: nowrap; }
            .gift-c  { display: block; font-size: 26px; font-weight: 900; line-height: 1; font-variant-numeric: tabular-nums; }
            .gift-c u { text-decoration: none; font-size: 11px; font-weight: 700; margin-left: 4px; color: rgba(255,255,255,.85); }
            .gift-go {
                display: inline-block; font-size: 12px; font-weight: 800; margin-top: 12px;
                color: #fff; background: rgba(255,255,255,.2); border-radius: 999px; padding: 6px 13px;
            }

            /* 모바일 : 좁은 폭에서 좌우로 나누면 글이 눌린다.
               위아래로 쌓고, 크레딧과 버튼을 한 줄에 나란히 둔다. */
            @@media (max-width: 560px) {
                .gift-banner {
                    flex-direction: column; align-items: stretch;
                    gap: 14px; min-height: 0; padding: 18px 16px;
                }
                .gift-tx { text-align: left; }
                .gift-t  { font-size: 16.5px; word-break: keep-all; }
                .gift-s  { font-size: 12.5px; margin-top: 5px; word-break: keep-all; }
                .gift-r  {
