﻿@* _Dm2Nav.cshtml *@
@model BulletinBoard.Models.DailyMission2.DailyMission2DashboardVM
@using System.Globalization

@{
    var d = Model.SelectedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    var page = (ViewBag.DM2Page ?? "").ToString().ToLowerInvariant();

    // ✅ 언어 유지 (ko/en/al)
    var lang = (ViewBag.Lang ?? "ko").ToString().ToLowerInvariant();
    if (lang != "ko" && lang != "en" && lang != "al") { lang = "ko"; }

    // ✅ 이동은 항상 허용(저장만 막는게 UX 좋음)
    bool canAct = Model.IsActionable;

    // ✅ 현재 페이지면 숨기기(빈 문자열 반환)
    string activeOrHide(string p) => (page == p) ? "dm2NavBtn dm2Hidden" : "dm2NavBtn";

    // ✅ 완료 상태면 버튼을 흐리게
    string withDone(string baseCls, bool done) => done ? (baseCls + " dm2DoneLink") : baseCls;

    // ✅ date + lang 같이 붙이는 헬퍼
    string U(string baseUrl)
    {
        var join = baseUrl.Contains("?") ? "&" : "?";
        return $"{baseUrl}{join}date={d}&lang={lang}";
    }
}

<style>
    /* ================================
           DM2 NAV (Center + Mission Colors)
           - MissionCard와 "동일 팔레트"로 맞춤
           ================================ */

    .dm2NavRow {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        margin-top: 10px;
        max-width: 980px;
        margin-left: auto;
        margin-right: auto;
    }

    .dm2NavBtn {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3px;
        text-align: center;
        padding: 12px 16px;
        border-radius: 16px;
        border: 1px solid rgba(226,232,240,.95);
        /* 기본(미션 홈/기타) */
        background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.92));
        box-shadow: 0 10px 22px rgba(15,23,42,.08), inset 0 1px 0 rgba(255,255,255,.85);
        font-weight: 950;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease, filter .15s ease;
    }

        /* ✅ 버튼 하단 상태 텍스트 */
        .dm2NavBtn .dm2NavSub {
            display: block;
            margin-top: 3px;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.1;
            opacity: .78;
        }

        /* -------------------------
           ✅ 미션별 색(카드와 동일 팔레트)
           - word: sky
           - quiz: purple
           - pray: mint
           - recite: peach
           ------------------------- */

        .dm2NavBtn.word {
            border-color: rgba(56,189,248,.28);
            background: linear-gradient(135deg, rgba(56,189,248,.14), rgba(255,255,255,.92));
        }

        .dm2NavBtn.quiz {
            border-color: rgba(139,92,246,.26);
            background: linear-gradient(135deg, rgba(139,92,246,.12), rgba(255,255,255,.92));
        }

        .dm2NavBtn.pray {
            border-color: rgba(16,185,129,.24);
            background: linear-gradient(135deg, rgba(16,185,129,.12), rgba(255,255,255,.92));
        }

        .dm2NavBtn.recite {
            border-color: rgba(251,146,60,.26);
            background: linear-gradient(135deg, rgba(251,146,60,.12), rgba(255,255,255,.92));
        }

    /* ✅ 완료된 버튼은 색/볼륨을 흐리게 */
    .dm2DoneLink {
        opacity: .58;
        filter: saturate(.75);
        box-shadow: 0 8px 18px rgba(15,23,42,.06), inset 0 1px 0 rgba(255,255,255,.85);
    }

    .dm2NavBtn:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(15,23,42,.12), inset 0 1px 0 rgba(255,255,255,.9);
        filter: saturate(1.02);
    }

    /* ✅ 완료 버튼 hover는 기본 hover보다 약하게(우선 적용) */
    .dm2NavBtn.dm2DoneLink:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 22px rgba(15,23,42,.08), inset 0 1px 0 rgba(255,255,255,.9);
        filter: saturate(.92);
    }

    /* ✅ 눌리는 느낌 */
    .dm2NavBtn:active {
        transform: translateY(0);
        box-shadow: 0 6px 14px rgba(15,23,42,.10), inset 0 2px 4px rgba(0,0,0,.08);
    }

    /* ✅ 현재 페이지 링크는 숨김 */
    .dm2Hidden {
        display: none !important;
    }

    /* ✅ 잠김 안내 뱃지(이동은 허용, 저장만 제한) */
    .dm2LockBadge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 999px;
        font-weight: 950;
        font-size: 12.5px;
        border: 1px dashed rgba(148,163,184,.70);
        background: rgba(241,245,249,.75);
        color: rgba(15,23,42,.86);
        box-shadow: 0 8px 18px rgba(15,23,42,.06), inset 0 1px 0 rgba(255,255,255,.8);
    }

    .dm2DoneBadge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 999px;
        font-weight: 950;
        font-size: 12.5px;
        border: 1px solid rgba(34,197,94,.28);
        background: rgba(34,197,94,.12);
        color: rgba(20,83,45,.96);
        box-shadow: 0 8px 18px rgba(15,23,42,.06), inset 0 1px 0 rgba(255,255,255,.75);
    }

    /* ✅ 홈 버튼 컬러 */
    .dm2NavBtn.home {
        border-color: rgba(148,163,184,.35);
        background: linear-gradient(135deg, rgba(226,232,240,.65), rgba(255,255,255,.95));
    }

</style>

<div class="dm2NavRow">

    <!-- ✅ 홈으로 가기 -->
    <a class="dm2NavBtn home" href="/">
        🏠 홈
        <span class="dm2NavSub">메인으로 이동</span>
    </a>
    <a class="dm2NavBtn" href="@U("/DailyMission2")">
        🎯 미션 홈<br />
         <span class="dm2NavSub">미션홈으로</span> 
    </a>

    <a class="@withDone(activeOrHide("word") + " word", Model.DayStatus.WordDone)" href="@U("/DailyMission2/Word")">
        📖 말씀<br />
        <span class="dm2NavSub">@(Model.DayStatus.WordDone ? "미션 완료" : "미션 진행중")</span>
    </a>

    <a class="@withDone(activeOrHide("quiz") + " quiz", Model.DayStatus.QuizDone)" href="@U("/DailyMission2/Quiz")">
        🧠 퀴즈<br />
        <span class="dm2NavSub">@(Model.DayStatus.QuizDone ? "미션 완료" : "미션 진행중")</span>
    </a>

    <a class="@withDone(activeOrHide("pray") + " pray", Model.DayStatus.PrayDone)" href="@U("/DailyMission2/Pray")">
        🙏 기도<br />
        <span class="dm2NavSub">@(Model.DayStatus.PrayDone ? "미션 완료" : "미션 진행중")</span>
    </a>

    <a class="@withDone(activeOrHide("recite") + " recite", Model.DayStatus.ReciteDone)" href="@U("/DailyMission2/Recite")">
        🗣️ 암송<br />
        <span class="dm2NavSub">@(Model.DayStatus.ReciteDone ? "미션 완료" : "미션 진행중")</span>
    </a>

    @* ✅ 저장 제한 안내(이동은 가능) *@
    @if (!canAct)
    {
        <span class="dm2LockBadge" title="수행은 최근 3일만 가능">🔒 수행은 최근 3일만</span>
    }

    @* @if ((ViewBag.DM2Done as bool?) == true)
    {
        <span class="dm2DoneBadge">완료 ✓</span>
    } *@
</div>
