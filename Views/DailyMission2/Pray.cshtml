@functions {
    string S(object v) { try { return v == null ? "" : v.ToString(); } catch { return ""; } }

    object G(dynamic o, params string[] names)
    {
        if (o == null) return null;
        var t = (object)o;
        var tp = t.GetType();
        foreach (var n in names)
        {
            var p = tp.GetProperty(n);
            if (p != null) return p.GetValue(t);
        }
        return null;
    }
}


<div class="block">
    <div class="sectionTitle">🙏 오늘의 성품기도</div>

    @if (prayRow != null && prayRow?.PrayPhraseData != null)
    {
        var title = S(G(prayRow.PrayPhraseData, "PrayTitle", "Title"));
        var c1 = S(G(prayRow.PrayPhraseData, "PrayContent1", "Content1", "Body1"));
        var c2 = S(G(prayRow.PrayPhraseData, "PrayContent2", "Content2", "Body2"));
        var c3 = S(G(prayRow.PrayPhraseData, "PrayContent3", "Content3", "Body3"));

        <div class="prayTitle">@(!string.IsNullOrWhiteSpace(title) ? title : "오늘의 기도")</div>

        @* c2(자녀가 자기 자신을 위해 드리는 기도)는 화면에 노출하지 않는다 *@
        <div class="textBox">@BulletinBoard.Helpers.PrayTextHelper.MarkNamesInline(c1)</div>
@*             @if (!string.IsNullOrWhiteSpace(c1))
            {
            }
            @if (!string.IsNullOrWhiteSpace(c2))
            {
                @c2
            }
            @if (!string.IsNullOrWhiteSpace(c3))
            {
                @c3
            } *@
    }
    else
    {
        <div class="mini">※ (관리자) PrayPhraseData가 없습니다. (ViewBag.TodayPrayPhraseRow.PrayPhraseData)</div>
    }
</div>



@functions {
    string GetRangeLabel(eBibles b)
    {
        if (b == null) return "";
        var s = !string.IsNullOrWhiteSpace(b.JanZulString) ? b.JanZulString : b.JanZulStringOnly;
        return s ?? "";
    }

    string GetWholeBibleText(eBibles b)
    {
        if (b == null) return "";
        return b.BibleText ?? "";
    }
}

<div class="block">
    <div class="toggleTitle sectionTitle" onclick="toggleBlock(this)">📖 오늘의 성경본문 (펼치기 ▶)</div>
    <div style="display:none; margin-top:10px;">

        <div class="bibleHead">
            <div class="bibleRef">
                @(!string.IsNullOrWhiteSpace(rangeLabel) ? rangeLabel : "오늘의 말씀")
            </div>
            <div class="bibleHint">※ 본문은 절 단위로 표시됩니다</div>
        </div>

        <div class="bibleBox">
            @if (verses != null && verses.Count > 0)
            {
                foreach (var vv in verses)
                {
                    // vv 구조: vv.zul / vv.BibleData (프로젝트 기준)
                    var no = vv.zul;
                    var tx = vv.BibleData;
                    if (string.IsNullOrWhiteSpace(tx)) { continue; }

                    <div class="verseRow">
                        <div class="vNo">@(no > 0 ? $"{no}절" : "절")</div>
                        <div class="vText">@tx</div>
                    </div>
                }
            }
            else
            {
                <div class="verseRow">
                    <div class="vNo">본문</div>
                    <div class="vText">@wholeText</div>
                </div>
            }
        </div>

    </div>
</div>


