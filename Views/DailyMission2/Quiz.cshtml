            <script>
                (function () {
                    const qtype = "@qType";

                    function getSelectedRadioValue(name) {
                        const els = document.getElementsByName(name);
                        for (let i = 0; i < els.length; i++) if (els[i].checked) return els[i].value;
                        return "";
                    }

                    function setBtnState(id, isOpen) {
                        const btn = document.querySelector(`[aria-controls="${id}"]`);
                        if (!btn) return;

                        btn.setAttribute("aria-expanded", isOpen.toString());

                        const base =
                            (id === "bgBox") ? "📚 배경" :
                            (id === "hintBox") ? "🧠 힌트" :
                            "";

                        btn.innerText = (isOpen) ? `▼ ${base}` : `▶ ${base}`;
                    }

                    // ✅ 배타 토글: 하나 열면 다른 하나는 자동으로 닫힘
                    window.toggleExclusive = function (id) {
                        const ids = ["bgBox", "hintBox"];

                        // 존재하는 박스만 대상으로
                        const existing = ids.filter(x => document.getElementById(x));

                        // 목표 박스
                        const target = document.getElementById(id);
                        if (!target) return;

                        const targetIsOpen = (target.style.display !== "none" && target.style.display !== "");

                        // 1) 일단 전부 닫기
                        existing.forEach(x => {
                            const el = document.getElementById(x);
                            if (el) el.style.display = "none";
                            setBtnState(x, false);
                        });

                        // 2) 방금 누른게 "닫혀있던 상태"였으면 열기 (열려있던 거면 닫힌 채 유지)
                        if (!targetIsOpen) {
                            target.style.display = "block";
                            setBtnState(id, true);
                        }
                    }

                    document.addEventListener('DOMContentLoaded', function () {
                        const btn = document.getElementById('btnSubmit');
                        if (!btn) return;

                        btn.addEventListener('click', function () {
                            let answer = "";

                            if (qtype === "s") answer = (document.getElementById('AnswerText')?.value || "").trim();
                            else answer = getSelectedRadioValue("AnswerRadio");

                            if (!answer) { alert("답을 입력(선택)해 주세요!"); return; }

                            if (qtype === "s") answer = answer.replace(/\s+/g, "");

                            document.getElementById('answerQ').value = answer;
                            document.getElementById('quizForm').submit();
                        });
                    });
                })();
            </script>
        }




