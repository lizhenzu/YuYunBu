@* ✅ 팝업(공용 Partial 재사용) *@
@await Html.PartialAsync("~/Views/DailyMission2/Partials/_OkPopup.cshtml", new { Message = okPopupMsg, AutoCloseSeconds = @ConstatsCommon.popupAutoCloseSeconds, RedirectUrl = awardUrl, RedirectLabel = "선물 선택" })
<script>
    // ✅ 공용 토글: secHead / sectionTitle 둘 다 지원
    function toggleBlock(titleEl) {
        const body = titleEl.nextElementSibling;
        if (!body) return;

        const isOpen = body.style.display !== 'none';
        if (isOpen) {
            body.style.display = 'none';
            // 헤더 내부 텍스트에 ▶/▼가 있으면 자연스럽게만 변경
            if (titleEl.innerText.indexOf('▼') >= 0) titleEl.innerText = titleEl.innerText.replace('▼', '▶');
        } else {
            body.style.display = 'block';
            if (titleEl.innerText.indexOf('▶') >= 0) titleEl.innerText = titleEl.innerText.replace('▶', '▼');
        }
    }
</script>
