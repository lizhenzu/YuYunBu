@using System.Globalization
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model BulletinBoard.Models.DailyMission2.UserDailyPointsVM

@{
    Layout = "_Layout_Mission2_New";
    ViewData["Title"] = "일자별 미션 수행이력";

    var fromStr = Model.FromDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var toStr = Model.ToDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    // ✅ (임시) 상단 Hero에서 필요한 값들 — 프로젝트 실제 타입/필드명이 다르면 맞춰서 교체하세요.
    // 모르는 값은 임의로 넣었습니다.
    dynamic __UserInfos = new
    {
        ProfilePicturePath = @ConstatsCommon.representFaceImage,
        UserId = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserId.ToString()) as string,
        FullName = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserFullName.ToString()) as string,
        UserName = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserName.ToString()) as string
    };

    if (ViewData["LoginUserName"] == null)
    {
        ViewData["LoginUserName"] = __UserInfos.UserName; // 임시로 동일하게(로그인 유저=본인) 처리
    }
}

<style>
    /* ✅ HERO */
    .hero {
        border-radius: 22px;
        padding: 18px 16px;
        background: linear-gradient(135deg, rgba(34,197,94,.14), rgba(59,130,246,.10));
        border: 1px solid rgba(15,23,42,.08);
        box-shadow: 0 14px 28px rgba(15,23,42,.08);
        margin-bottom: 12px;
    }

    .titleRow { display:flex; flex-direction:column; gap:8px; }

    .badge {
        display:inline-flex;
        align-items:center;
        gap:6px;
        width: fit-content;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(255,255,255,.75);
        border: 1px solid rgba(15,23,42,.10);
        font-weight: 1000;
        font-size: 12px;
    }

    .hero h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 1000;
        letter-spacing: -.2px;
    }
    .hero h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 900;
        opacity: .85;
    }

    .profileRow{
        display:flex;
        align-items:center;
        gap: 10px;
        margin-top: 6px;
    }

    .avatarWrap{
        width: 52px; height: 52px;
        border-radius: 999px;
        overflow: hidden;
        border: 2px solid rgba(255,255,255,.75);
        box-shadow: 0 10px 20px rgba(15,23,42,.10);
        background: rgba(255,255,255,.8);
        flex: 0 0 auto;
        cursor: pointer;
    }
    .avatar{
        width: 100%;
        height: 100%;
        object-fit: cover;
        display:block;
    }

    .nameBox .name{
        margin: 0;
        font-weight: 1000;
        font-size: 15px;
    }
    .nameBox .mini{
        margin: 2px 0 0 0;
        font-size: 12px;
        font-weight: 900;
        opacity: .75;
    }

    .hint{
        margin-top: 12px;
        padding: 12px 12px;
        border-radius: 16px;
        background: rgba(255,255,255,.75);
        border: 1px dashed rgba(15,23,42,.16);
        font-weight: 900;
        line-height: 1.35;
    }

    /* ✅ 기존 스타일 */
    .box {
        background: rgba(255,255,255,.85);
        border: 1px solid rgba(15,23,42,.08);
        border-radius: 18px;
        padding: 14px;
        box-shadow: 0 10px 22px rgba(15,23,42,.08);
    }

    .row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: end;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .field label {
            font-size: 12px;
            opacity: .75;
            font-weight: 800;
        }

        .field input {
            height: 40px;
            border-radius: 12px;
            border: 1px solid rgba(15,23,42,.14);
            padding: 0 10px;
            font-weight: 800;
            background: white;
            min-width: 160px;
        }

    .btn {
        height: 40px;
        border-radius: 12px;
        border: 1px solid rgba(15,23,42,.14);
        background: white;
        padding: 0 12px;
        font-weight: 900;
        cursor: pointer;
    }

        .btn.primary {
            background: rgba(34,197,94,.12);
            border-color: rgba(34,197,94,.28);
        }

        .btn.gray {
            background: rgba(100,116,139,.10);
            border-color: rgba(100,116,139,.22);
        }

    .tableWrap {
        overflow: auto;
       /*  border-radius: 14px; */
        border: 1px solid rgba(15,23,42,.10);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 760px;
        background: white;
    }

    th, td {
        padding: 10px 10px;
        border-bottom: 1px solid rgba(15,23,42,.08);
        text-align: center;
    }

    th {
        background: rgba(15,23,42,.04);
        font-weight: 1000;
    }

    td.left {
        text-align: left;
        font-weight: 900;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 26px;
        padding: 0 8px;
        border-radius: 999px;
        font-weight: 1000;
        border: 1px solid rgba(15,23,42,.12);
        background: rgba(255,255,255,.8);
    }

    .sumGrid {
        display: grid;
        grid-template-columns: repeat(5, minmax(120px, 1fr));
        gap: 10px;
        margin-top: 12px;
    }

    .sumCard {
        border: 1px solid rgba(15,23,42,.10);
        border-radius: 16px;
        padding: 10px;
        background: rgba(255,255,255,.75);
    }

        .sumCard .k {
            font-size: 12px;
            opacity: .7;
            font-weight: 900;
        }

        .sumCard .v {
            font-size: 18px;
            font-weight: 1000;
            margin-top: 4px;
        }


        /* ✅ 모바일 최적화 */
@@media (max-width: 768px) {

    /* 테이블 최소폭 제거 */
    table {
        min-width: 100% !important;
        font-size: 12px;
    }

    th, td {
        padding: 6px 4px;
        white-space: nowrap;
    }

    /* pill 크기 축소 */
    .pill {
        min-width: 26px;
        height: 22px;
        font-size: 11px;
        padding: 0 6px;
    }

    /* 합계 카드 grid → 2열로 */
    .sumGrid {
        grid-template-columns: repeat(2, 1fr);
    }

    .sumCard .v {
        font-size: 15px;
    }
}
    /* ✅ 날짜 이동 버튼 */
    .dateBtn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(34,197,94,.12);
        border: 1px solid rgba(34,197,94,.30);
        font-weight: 900;
        font-size: 12px;
        color: #14532d;
        text-decoration: none;
        cursor: pointer;
        transition: all .15s ease;
    }

        .dateBtn:hover {
            background: rgba(34,197,94,.20);
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(15,23,42,.12);
        }

        .dateBtn:active {
            transform: translateY(0);
            box-shadow: none;
        }

    /* 모바일에서 살짝 작게 */
    @@media (max-width: 768px) {
        .dateBtn

    {
        padding: 4px 8px;
        font-size: 11px;
    }

    }

/* 아주 작은 폰 (아이폰 SE급) */
@@media (max-width: 420px) {

    table {
        font-size: 11px;
    }

    th, td {
        padding: 5px 3px;
    }

    .pill {
        font-size: 10px;
        min-width: 22px;
    }
}
/* ✅ 포인트가 0일 때 pill 투명 처리 */
.pill.zero {
    background: transparent !important;
    border-color: transparent !important;
    color: rgba(15,23,42,.45);
}

</style>

<!-- ✅ 추가: HERO 상단 -->
<div class="hero">
    <div class="titleRow">
        <div class="badge">✨ 오늘의 미션 체크!</div>
        <h1>@ConstatsCommon.MainKeyTitle</h1>
        <h2>일일 미션 수행 현황</h2>

        <div class="profileRow">
            <div class="avatarWrap">
                <img src="@__UserInfos.ProfilePicturePath"
                     onclick="ManageUserInfo('@__UserInfos.UserId')"
                     alt="Profile Picture"
                     loading="lazy"
                     class="avatar" />
            </div>
            <div class="nameBox">
                <p class="name">@($"{__UserInfos.FullName}님")</p>
                <p class="mini">말씀 습관이 쑥쑥! 🌱</p>
            </div>
        </div>
    </div>
 
</div>

<div class="box">
    <div class="row">
        <button class="btn gray pushRight" style="margin-left: auto;"
                onclick="location.href='/DailyMission2'">
            미션홈
        </button>
    </div>
</div>

<div style="height:12px;"></div>

<div class="box">
    <div class="tableWrap">
        <table>
            <thead>
                <tr>
                    <th style="text-align:left;">날짜</th>
                    <th>말씀(2)</th>
                    <th>퀴즈(1)</th>
                    <th>기도(2)</th>
                    <th>암송(1)</th>
                    <th>합계</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows == null || Model.Rows.Count == 0)
                {
                    <tr>
                        <td class="left" colspan="7">데이터가 없습니다.</td>
                    </tr>
                }
                else
                {
                    foreach (var r in Model.Rows)
                    {
                        var d = r.DateBy.ToString("MM월dd일(ddd)", CultureInfo.GetCultureInfo("ko-KR"));
                        var rawDate = r.DateBy.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
                        <tr>
                            <td class="left">
                                <a class="dateBtn"
                                   href="/DailyMission2?date=@rawDate"
                                   title="@rawDate 로 이동">
                                    @d
                                </a>
                            </td>
                      <td>
    <span class="pill @(r.WordPoint == 0 ? "zero" : "")">
        @(r.WordPoint == 0 ? "" : r.WordPoint.ToString())
    </span>
</td>

<td>
    <span class="pill @(r.QuizPoint == 0 ? "zero" : "")">
        @(r.QuizPoint == 0 ? "" : r.QuizPoint.ToString())
    </span>
</td>

<td>
    <span class="pill @(r.PrayPoint == 0 ? "zero" : "")">
        @(r.PrayPoint == 0 ? "" : r.PrayPoint.ToString())
    </span>
</td>

<td>
    <span class="pill @(r.RecitePoint == 0 ? "zero" : "")">
        @(r.RecitePoint == 0 ? "" : r.RecitePoint.ToString())
    </span>
</td>

<td>
    <span class="pill @(r.TotalPoint == 0 ? "zero" : "")">
        @(r.TotalPoint == 0 ? "" : r.TotalPoint.ToString())
    </span>
</td>


                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="sumGrid">
        <div class="sumCard"><div class="k">말씀 합</div><div class="v">@Model.SumWord</div></div>
        <div class="sumCard"><div class="k">퀴즈 합</div><div class="v">@Model.SumQuiz</div></div>
        <div class="sumCard"><div class="k">기도 합</div><div class="v">@Model.SumPray</div></div>
        <div class="sumCard"><div class="k">암송 합</div><div class="v">@Model.SumRecite</div></div>
        <div class="sumCard"><div class="k">총점</div><div class="v">@Model.SumTotal</div></div>
    </div>
</div>

<script>
    // ✅ (임시) 프로젝트에 실제 함수가 있으면 이 함수 제거하고 기존 함수 사용하세요.
    function ManageUserInfo(userId) {
        // 예: location.href = '/User/Manage?userId=' + encodeURIComponent(userId);
        alert('ManageUserInfo: ' + userId);
    }

    function goSearch() {
        const from = document.getElementById('from').value;
        const to = document.getElementById('to').value;
        const isAdmin = @Model.IsAdmin.ToString().ToLower();

        let userName = '';
        if (isAdmin) {
            userName = document.getElementById('userName').value.trim();
        }

        const qs = new URLSearchParams();
        if (userName) qs.set('userName', userName);
        if (from) qs.set('from', from);
        if (to) qs.set('to', to);

        location.href = '/DailyMission2/UserDailyPoints?' + qs.toString();
    }
</script>
