@using BulletinBoard.Common
@using BulletinBoard.Helpers
@*  ══════════════════════════════════════════════════════════════
    도전! 성경말씀 허브 — 두 버전 고르기 (/Bible2/Welcome 과 같은 구성)
    · 지금 쓰던 버전 /DailyMission2/Index · 새 버전 /DailyMission4/Index
    · 버전 선택 클릭수(DM2HubClickLog)는 Basic · SuperAdmin 계정에게만 보인다.
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;

    string hubTitle = ConstatsCommon.MainKeyTitle;   // 예: 도전!!! 성경말씀
    int joinCount   = ViewBag.TodayJoinCount is int _j ? _j : 0;
    int yearPoint   = ViewBag.YearTotalPoint is int _y ? _y : 0;

    var stats = ViewBag.HubClickStats as BulletinBoard.Models.DailyMission2.DM2HubClickStats;
    bool canSeeStats = ViewBag.IsHubStatsViewer is bool _s && _s;

    var kNow = DateHelper.GetKoreaNow();
    string[] dayKor = { "일", "월", "화", "수", "목", "금", "토" };
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>@hubTitle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* ── DailyMission4 밝은 흰색 버전 (2026-10-03 시안 확정) ── */
        *, *::before, *::after { box-sizing: border-box; }
        :root { --blue: #2F80ED; --soft: #EAF2FD; --ink: #111827; --tx: #374151; --dim: #9CA3AF; --dim2: #6B7280; --line: #EEF0F3; --grey: #F4F6F9; }
        body { margin: 0; background: #FFFFFF; color: var(--tx); font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; }
        a { text-decoration: none; color: inherit; }

        .wrapIn { max-width: 560px; margin: 0 auto; padding: 0 16px 40px; }

        .top { display: flex; align-items: center; justify-content: space-between; padding: 14px 0 12px; border-bottom: 1px solid var(--line); font-size: 13px; color: var(--dim2); }
        .top b { font-weight: 700; color: var(--tx); }
        .top a:hover { color: var(--blue); }

        .k { font-size: 12px; font-weight: 800; letter-spacing: .02em; color: var(--blue); margin-top: 22px; }
        .T { font-weight: 800; font-size: 26px; line-height: 1.35; letter-spacing: -.02em; color: var(--ink); margin: 6px 0 0; word-break: keep-all; }

        .ask { margin: 26px 0 0; padding-top: 18px; border-top: 1px solid var(--line); font-size: 16px; font-weight: 800; color: var(--ink); }
        .askSub { font-size: 13px; color: var(--dim2); line-height: 1.75; margin: 6px 0 0; word-break: keep-all; border: 0; padding: 0; }
        .askSub b { font-weight: 700; color: var(--ink); }

        /* 두 버전 칸 */
        .pair { display: grid; grid-template-columns: 1fr; gap: 0; }
        .big { position: relative; display: flex; align-items: center; gap: 12px; margin-top: 12px; padding: 16px; border-radius: 16px; transition: transform .12s; }
        .big:active { transform: scale(.98); }
        .big .tx { flex: 1; min-width: 0; }
        .big .tg { font-size: 11.5px; font-weight: 800; letter-spacing: 0; }
        .big .nm { font-family: inherit; font-size: 19px; font-weight: 800; color: var(--ink); margin-top: 2px; }
        .big .ds { font-size: 12.5px; margin-top: 3px; line-height: 1.6; }
        .big em { font-style: normal; font-family: inherit; font-weight: 300; font-size: 22px; line-height: 1; transition: transform .15s; }
        .big:hover em { transform: translateX(3px); }
        .big.cur { background: var(--grey); border: 0; }
        .big.cur .tg, .big.cur .ds { color: var(--dim2); }
        .big.cur em { color: var(--dim); }
        .big.new { background: var(--soft); border: 0; box-shadow: inset 0 0 0 2px var(--blue); color: var(--tx); }
        .big.new .tg, .big.new em { color: var(--blue); }
        .big.new .ds { color: var(--dim2); }
        .big.new .badge { position: absolute; right: 14px; top: -10px; background: var(--blue); color: #fff; font-size: 10.5px; font-weight: 800; letter-spacing: 0; padding: 3px 10px; border-radius: 999px; }

        /* 관리자 전용 클릭수 */
        .hubst { margin-top: 18px; padding: 14px; border: 0; border-radius: 14px; background: var(--grey); }
        .hubst .hd { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
        .hubst .only { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 800; letter-spacing: 0; color: var(--blue); }
        .hubst .only::before { display: none; }
        .hubst .seg { display: inline-flex; gap: 4px; border: 0; flex: none; }
        .hubst .seg button { font-family: inherit; font-size: 11.5px; padding: 3px 10px; border: 0; border-radius: 999px; background: #fff; color: var(--dim2); cursor: pointer; }
        .hubst .seg button.on { background: var(--blue); color: #fff; }
        .hubst .row { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-top: 10px; font-size: 12px; color: var(--dim2); }
        .hubst .row b { font-family: inherit; font-weight: 300; font-size: 24px; color: var(--ink); margin-right: 3px; font-variant-numeric: tabular-nums; }
        .hubst .row .r { text-align: right; }
        .hubst .row .r b { color: var(--blue); }
        .hubst .bar { display: flex; height: 8px; margin-top: 8px; background: #E1E6EE; border-radius: 4px; overflow: hidden; }
        .hubst .bar i { display: block; transition: width .25s; }
        .hubst .bar .o { background: #B6BDC9; }
        .hubst .bar .w { background: var(--blue); box-shadow: none; }
        .hubst .ft { display: flex; justify-content: space-between; font-size: 11px; color: var(--dim); margin-top: 6px; font-family: inherit; font-variant-numeric: tabular-nums; }
        .hubst .none { font-size: 12px; color: var(--dim); margin-top: 10px; }

        /* 의견 보내기 */
        .fb { display: flex; align-items: center; gap: 12px; margin-top: 24px; padding: 16px 2px; border: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
        .fb:hover { background: none; }
        .fb .tx { flex: 1; min-width: 0; }
        .fb .tg { font-size: 11.5px; font-weight: 800; letter-spacing: 0; color: var(--blue); }
        .fb .nm { font-family: inherit; font-size: 17px; font-weight: 800; color: var(--ink); margin-top: 2px; }
        .fb .ds { font-size: 12.5px; color: var(--dim2); margin-top: 3px; line-height: 1.6; word-break: keep-all; }
        .fb em { font-style: normal; font-family: inherit; font-weight: 300; font-size: 20px; color: #7FA3DB; }

        .links { display: flex; justify-content: center; gap: 20px; margin-top: 16px; font-size: 13px; color: var(--dim2); flex-wrap: wrap; }
        .links a { font-weight: 700; }
        .links a:hover { color: var(--blue); }
        .quote { text-align: center; font-family: inherit; font-size: 12.5px; color: var(--dim); margin-top: 14px; }

        /* 이동 대기 카드 — 항상 맨 위에 그린다 */
        .wait { position: fixed; inset: 0; z-index: 2147483000; background: rgba(17,24,39,.40); display: none; align-items: center; justify-content: center; padding: 20px; isolation: isolate; }
        .wait.show { display: flex; }

        /* 카드가 뜨면 : 아래 화면은 더 누를 수 없고, 누름 · 올림 효과도 멈춘다 (효과가 서로 엉키지 않게) */
        a.big, a.fb { -webkit-tap-highlight-color: transparent; }
        body.waiting { overflow: hidden; }
        body.waiting .wrapIn { pointer-events: none; }
        body.waiting .big:hover em { transform: none; }
        /* 고른 카드만 '고름' 표시 */
        .big.picking { outline: 2px solid var(--blue); outline-offset: -2px; }
        .big.picking::after { content: "고르는 중"; position: absolute; left: 16px; bottom: 6px; font-size: 10.5px; font-weight: 800; letter-spacing: 0; color: var(--blue); }
        .wait .card { width: 100%; max-width: 260px; background: #FFFFFF; text-align: center; padding: 26px 18px 22px; border-radius: 18px; box-shadow: 0 16px 40px rgba(17,24,39,.28); }
        .wait .sp { width: 36px; height: 36px; margin: 0 auto; border: 3px solid #E8ECF2; border-top-color: var(--blue); border-radius: 50%; animation: spin .8s linear infinite; }
        .wait .t { font-family: inherit; font-size: 16px; font-weight: 800; color: var(--ink); margin-top: 16px; }
        .wait .t span { color: var(--blue); animation: dots 1.2s infinite; }
        .wait .t span:nth-child(2) { animation-delay: .2s; }
        .wait .t span:nth-child(3) { animation-delay: .4s; }
        .wait .s { font-size: 12.5px; color: var(--dim2); margin-top: 5px; }
        @@keyframes spin { to { transform: rotate(360deg); } }
        @@keyframes dots { 0%, 20% { opacity: .2; } 50% { opacity: 1; } 100% { opacity: .2; } }
    </style>
</head>
<body>
<div class="wrapIn">

    <div class="top">
        <span><a href="/">홈</a> › <b>@hubTitle</b></span>
        <span>@kNow.ToString("M월 d일") @(dayKor[(int)kNow.DayOfWeek])요일</span>
    </div>
    <div class="k">DAILY MISSION</div>
    <h1 class="T">@(hubTitle)에<br>오신 것을 환영합니다</h1>
  
    @* ── 두 버전 ── *@
    <div class="ask">어느 화면으로 할까요?</div>
    <p class="askSub">
        <b>새 버전이 나왔어요.</b> 한번 써 보세요.
        지금 쓰던 화면도 그대로 쓸 수 있고, <b>기록과 점수는 두 버전이 함께</b> 쓰니 어느 쪽으로 해도 괜찮아요.
    </p>
    <div class="pair">
        <a class="big cur" href="/DailyMission2/Index" data-v="old">
            <div class="tx">
                <div class="tg">지금 쓰던 버전</div>
                <div class="nm">@hubTitle</div>
                <div class="ds">익숙한 화면 그대로 사용하기</div>
            </div>
            <em>›</em>
        </a>
        <a class="big new" href="/DailyMission4/Index" data-v="new">
            <span class="badge">NEW</span>
            <div class="tx">
                <div class="tg">새 버전</div>
                <div class="nm">새 @hubTitle</div>
                <div class="ds">원하는 폰트로 맞추고, 눈의 부담은 덜어보세요.</div>
            </div>
            <em>→</em>
        </a>
    </div>

    @* ── 버전 선택 클릭수 (Basic · SuperAdmin 계정만) ── *@
    @if (canSeeStats)
    {
        <section class="hubst" aria-label="버전 선택 클릭수 (관리자만 보여요)">
            <div class="hd">
                <span class="only">관리자만 보여요 · 버전 선택</span>
                @if (stats != null)
                {
                    <span class="seg" role="group" aria-label="기간">
                        <button type="button" class="on" data-p="all">전체</button><button type="button" data-p="today">오늘</button><button type="button" data-p="week">7일</button>
                    </span>
                }
            </div>

            @if (stats == null)
            {
                <div class="none">클릭 기록 표(DM2HubClickLog)가 아직 없어요 — SQL/CreateDM2HubClickLog.sql 을 실행해 주세요.</div>
            }
            else
            {
                var periods = new (string Key, BulletinBoard.Models.DailyMission2.DM2HubClickPeriod P)[]
                    { ("all", stats.All), ("today", stats.Today), ("week", stats.Week) };

                foreach (var (key, p) in periods)
                {
                    <div class="per" data-p="@key" hidden="@(key != "all")">
                        <div class="row">
                            <span><b>@p.OldClicks</b>회 · 쓰던 버전</span>
                            <span class="r"><b>@p.NewClicks</b>회 · 새 버전</span>
                        </div>
                        <div class="bar" role="img" aria-label="쓰던 버전 @(p.OldPct)% · 새 버전 @(p.NewPct)%">
                            @if (p.Total > 0)
                            {
                                <i class="o" style="width:@(p.OldPct)%"></i><i class="w" style="width:@(p.NewPct)%"></i>
                            }
                        </div>
                        <div class="ft">
                            <span>@(p.Total > 0 ? p.OldPct + "%" : "–") · @(p.OldUsers)명</span>
                            <span>@(p.NewUsers)명 · @(p.Total > 0 ? p.NewPct + "%" : "–")</span>
                        </div>
                    </div>
                }
            }
        </section>
    }


    @* ── 의견 보내기 (크게) ── *@
    <a class="fb" href="/Board/Create2?boardName=Anonymous">
        
        <div class="tx">
            <div class="tg">여러분의 의견</div>
            <div class="nm">개선사항 보내기</div>
            <div class="ds">더 나은 @(hubTitle)을 위해 좋았던 점, 불편한 점을 알려 주세요. 이름을 남기지 않아도 돼요.</div>
        </div>
        <em>→</em>
    </a>

         <nav class="links">
            <a href="/Home/Index">홈으로</a>
        </nav>

    <div class="quote">말씀을 읽는 것이 복입니다 — 요한계시록 1:3</div>
</div>

<form id="hubClickForm" hidden>@Html.AntiForgeryToken()</form>

<div class="wait" id="wait" role="status" aria-live="polite">
    <div class="card">
        <div class="sp" aria-hidden="true"></div>
        <div class="t">잠시만 기다려 주세요<span>.</span><span>.</span><span>.</span></div>
        <div class="s" id="waitMsg">화면을 불러오고 있어요</div>
    </div>
</div>

<script>
(function () {
    /* 기간 탭 (관리자 집계) */
    var seg = document.querySelector('.hubst .seg');
    if (seg) {
        seg.addEventListener('click', function (e) {
            var b = e.target.closest('button[data-p]');
            if (!b) return;
            seg.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); });
            document.querySelectorAll('.hubst .per').forEach(function (d) { d.hidden = d.dataset.p !== b.dataset.p; });
        });
    }

    /* 두 버전 버튼 — 클릭 기록(이동을 막지 않게 sendBeacon) + 대기 카드 */
    var box = document.getElementById('wait'), msg = document.getElementById('waitMsg');
    var tokenEl = document.querySelector('#hubClickForm input[name="__RequestVerificationToken"]');

    document.addEventListener('click', function (e) {
        if (e.defaultPrevented || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        var a = e.target.closest('a[href]');
        if (!a) return;
        var raw = (a.getAttribute('href') || '').trim();
        if (!raw || raw.charAt(0) === '#' || /^(javascript|mailto|tel):/i.test(raw)) return;

        var url;
        try { url = new URL(a.href, location.href); } catch (_) { return; }
        if (url.origin !== location.origin) return;

        /* 어느 버전을 골랐는지 기록 */
        var v = a.getAttribute('data-v');
        if (v && tokenEl) {
            try {
                var fd = new FormData();
                fd.append('v', v);
                fd.append('__RequestVerificationToken', tokenEl.value);
                if (navigator.sendBeacon) navigator.sendBeacon('/DailyMission2/HubClick', fd);
                else fetch('/DailyMission2/HubClick', { method: 'POST', body: fd, keepalive: true });
            } catch (err) { }
        }

        /* 카드를 먼저 그린 뒤 이동 (아이폰 Safari 대응) */
        e.preventDefault();
        if (document.body.classList.contains('waiting')) return;   // 두 번 눌러도 한 번만

        msg.textContent = url.pathname === '/' ? '홈으로 이동하고 있어요' : '화면을 불러오고 있어요';
        /* 고른 카드에 표시를 남기고, 아래 화면의 누름 · 올림 효과는 멈춘다 */
        var picked = a.closest('.big');
        if (picked) picked.classList.add('picking');
        if (a.blur) a.blur();
        document.body.classList.add('waiting');
        box.classList.add('show');

        requestAnimationFrame(function () {
            requestAnimationFrame(function () { setTimeout(function () { window.location.href = url.href; }, 30); });
        });
    });

    /* 뒤로 가기로 돌아왔을 때 원래대로 */
    window.addEventListener('pageshow', function () {
        box.classList.remove('show');
        document.body.classList.remove('waiting');
        document.querySelectorAll('.big.picking').forEach(function (x) { x.classList.remove('picking'); });
    });
})();
</script>
</body>
</html>
