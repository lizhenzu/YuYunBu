@using BulletinBoard.Common
@using BulletinBoard.Helpers
@*  ══════════════════════════════════════════════════════════════
    도전! 성경말씀 허브 — 두 버전 고르기 (/Bible2/Welcome 과 같은 구성)
    · 지금 쓰던 버전 /DailyMission2/Index · 새 버전 /DailyMission4/Index
    · 버전 선택 클릭수(DM2HubClickLog)는 Basic · SuperAdmin 계정에게만 보인다.
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;

    string hubTitle = ConstatsCommon.MainKeyTitle;   // 예: 도전!!! 성경말씀
    int joinCount   = ViewBag.TodayJoinCount is int _j ? _j : 0;
    int yearPoint   = ViewBag.YearTotalPoint is int _y ? _y : 0;

    var stats = ViewBag.HubClickStats as BulletinBoard.Models.DailyMission2.DM2HubClickStats;
    bool canSeeStats = ViewBag.IsHubStatsViewer is bool _s && _s;

    var kNow = DateHelper.GetKoreaNow();
    string[] dayKor = { "일", "월", "화", "수", "목", "금", "토" };
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#16181C" />
    <title>@hubTitle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@300;400;500&family=Inter:wght@200;300;400;500&family=Gothic+A1:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        :root {
            --bg: #F7F6F3; --tx: #16181C; --dim: #83868C; --dim2: #5C5F66;
            --rule: #E2E0DB; --line: #E7E5E1; --acc: #9A7B4F; --mark: #EDE5D8;
            --card: #FFFFFF; --head: #16181C; --headtx: #F7F6F3; --headk: #C9AE82; --headdim: #9A9690;
        }
        body { margin: 0; background: var(--bg); color: var(--tx); font-family: "Gothic A1", sans-serif; }
        a { text-decoration: none; color: inherit; }

        .wrapIn { max-width: 760px; margin: 0 auto; padding: 0 20px 40px; }
        @@media (min-width: 769px) { .wrapIn { padding: 0 40px 48px; } }

        .top { height: 56px; display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--dim); }
        .top b { font-weight: 400; color: var(--tx); }
        .top a:hover { color: var(--acc); }

        .cross { font-family: "Noto Serif KR", serif; font-size: 30px; color: var(--acc); line-height: 1; margin-top: 8px; }
        .k { font-size: 10px; font-weight: 600; letter-spacing: .24em; color: var(--acc); margin-top: 14px; }
        .T { font-family: "Noto Serif KR", serif; font-weight: 400; font-size: 27px; line-height: 1.4; margin: 6px 0 0; word-break: keep-all; }
        .sub { font-size: 13.5px; color: var(--dim2); margin-top: 6px; line-height: 1.7; }

        /* 오늘 현황 */
        .today { display: flex; align-items: center; gap: 12px; margin-top: 18px; padding: 12px 14px; background: var(--card); box-shadow: 0 6px 16px -12px rgba(22,24,28,.35); }
        .today .em { font-size: 22px; flex: none; }
        .today .tx { flex: 1; min-width: 0; font-size: 13px; line-height: 1.5; }
        .today .tx b { font-family: "Inter", sans-serif; font-weight: 400; font-size: 16px; color: var(--acc); margin-right: 2px; }
        .today .tx small { display: block; font-size: 11px; color: var(--dim); }
        .today em { font-style: normal; font-size: 12px; border-bottom: 1px solid var(--acc); white-space: nowrap; flex: none; }

        .ask { font-family: "Noto Serif KR", serif; font-size: 16px; margin: 26px 0 6px; }
        .askSub { font-size: 12.5px; color: var(--dim2); line-height: 1.75; margin: 0 0 12px; word-break: keep-all;
                  border-left: 2px solid var(--acc); padding-left: 12px; }
        .askSub b { font-weight: 700; color: var(--tx); }

        /* 큰 버튼 2개 */
        .pair { display: grid; grid-template-columns: 1fr; gap: 10px; }
        @@media (min-width: 769px) { .pair { grid-template-columns: 1fr 1.25fr; } }
        .big { position: relative; display: flex; align-items: center; gap: 14px; padding: 22px 20px; }
        .big .tx { flex: 1; min-width: 0; }
        .big .tg { font-size: 10px; font-weight: 700; letter-spacing: .18em; }
        .big .nm { font-family: "Noto Serif KR", serif; font-size: 21px; margin-top: 5px; }
        .big .ds { font-size: 12.5px; margin-top: 4px; line-height: 1.6; }
        .big em { font-style: normal; font-family: "Inter", sans-serif; font-weight: 200; font-size: 34px; line-height: 1; transition: transform .15s; }
        .big:hover em { transform: translateX(3px); }
        .big.cur { background: var(--card); border: 1px solid var(--rule); }
        .big.cur .tg, .big.cur .ds { color: var(--dim); }
        .big.cur em { color: #A9A59D; }
        .big.cur:hover { border-color: var(--dim); }
        .big.new { background: linear-gradient(135deg,#FFF8E9,#FDF1D8); border: 1.5px solid #C9AE82; color: var(--tx); }
        .big.new .tg, .big.new em { color: #9A7B4F; }
        .big.new .ds { color: #7A6A50; }
        .big.new .badge { position: absolute; right: 0; top: 0; background: #9A7B4F; color: #FDF1D8; font-size: 9.5px; font-weight: 700; letter-spacing: .1em; padding: 3px 8px; }


        /* 관리자 전용 클릭수 */
        .hubst { margin-top: 10px; padding: 12px 14px; border: 1px dashed #C9AE82; background: var(--card); }
        .hubst .hd { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
        .hubst .only { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 700; letter-spacing: .14em; color: var(--acc); }
        .hubst .only::before { content: ""; width: 5px; height: 5px; background: var(--acc); }
        .hubst .seg { display: inline-flex; border: 1px solid var(--rule); flex: none; }
        .hubst .seg button { font-family: inherit; font-size: 11px; padding: 2px 9px; border: 0; background: none; color: var(--dim); cursor: pointer; }
        .hubst .seg button.on { background: var(--tx); color: var(--bg); }
        .hubst .row { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-top: 10px; font-size: 12px; color: var(--dim2); }
        .hubst .row b { font-family: "Inter", sans-serif; font-weight: 300; font-size: 24px; color: var(--tx); margin-right: 3px; font-variant-numeric: tabular-nums; }
        .hubst .row .r { text-align: right; }
        .hubst .row .r b { color: var(--acc); }
        .hubst .bar { display: flex; height: 8px; margin-top: 8px; background: var(--rule); }
        .hubst .bar i { display: block; transition: width .25s; }
        .hubst .bar .o { background: #A9A59D; }
        .hubst .bar .w { background: var(--head); box-shadow: inset 0 2px 0 #D9C29B; }
        .hubst .ft { display: flex; justify-content: space-between; font-size: 11px; color: var(--dim); margin-top: 8px; font-family: "Inter", sans-serif; font-variant-numeric: tabular-nums; }
        .hubst .none { font-size: 12px; color: var(--dim); margin-top: 10px; }

        /* 새 버전 장점 */
        .adv { background: var(--card); border-top: 2px solid #D9C29B; padding: 16px 20px 6px; margin-top: 10px; }
        .adv .h { font-size: 10px; font-weight: 700; letter-spacing: .2em; color: var(--acc); }
        .adv .ht { font-family: "Noto Serif KR", serif; font-size: 17px; margin-top: 4px; }
        .adv ul { list-style: none; margin: 10px 0 0; padding: 0; }
        @@media (min-width: 769px) { .adv ul { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; } }
        .adv li { display: flex; gap: 12px; padding: 12px 0; border-top: 1px solid var(--line); }
        .adv li > i { flex: none; width: 34px; height: 34px; display: grid; place-items: center; font-style: normal; background: var(--bg); font-family: "Noto Serif KR", serif; color: var(--acc); font-size: 14px; }
        .adv li b { display: block; font-weight: 600; font-size: 13.5px; }
        .adv li span { display: block; font-size: 12.5px; color: var(--dim2); line-height: 1.65; margin-top: 2px; word-break: keep-all; }
        .fsdemo { display: inline-flex !important; gap: 4px; margin-top: 6px; }
        .fsdemo s { text-decoration: none; font-size: 10.5px; border: 1px solid var(--rule); padding: 2px 7px; color: var(--dim); }
        .fsdemo s.on { background: var(--mark); border-color: #D9C9AE; color: var(--acc); font-weight: 600; }

        /* 의견 보내기 (크게) */
        .fb { display: flex; align-items: center; gap: 14px; margin-top: 28px; padding: 22px 20px; border: 1px solid var(--tx); }
        .fb:hover { background: var(--card); }
        .fb > i { flex: none; width: 46px; height: 46px; display: grid; place-items: center; font-style: normal; background: var(--head); color: #D9C29B; font-family: "Noto Serif KR", serif; font-size: 20px; }
        .fb .tx { flex: 1; min-width: 0; }
        .fb .tg { font-size: 10px; font-weight: 700; letter-spacing: .2em; color: var(--acc); }
        .fb .nm { font-family: "Noto Serif KR", serif; font-size: 19px; margin-top: 4px; }
        .fb .ds { font-size: 12.5px; color: var(--dim2); margin-top: 4px; line-height: 1.6; word-break: keep-all; }
        .fb em { font-style: normal; font-family: "Inter", sans-serif; font-weight: 200; font-size: 30px; color: var(--acc); }

        .links { display: flex; justify-content: center; gap: 20px; margin-top: 18px; font-size: 12.5px; color: var(--dim); flex-wrap: wrap; }
        .links a:hover { color: var(--acc); }
        .quote { text-align: center; font-family: "Noto Serif KR", serif; font-size: 12.5px; color: var(--acc); margin-top: 18px; }

        /* 이동 대기 카드 — 항상 맨 위에 그린다 */
        .wait { position: fixed; inset: 0; z-index: 2147483000; background: rgba(22,24,28,.55); display: none; align-items: center; justify-content: center; padding: 20px; isolation: isolate; }
        .wait.show { display: flex; }

        /* 카드가 뜨면 : 아래 화면은 더 누를 수 없고, 누름 · 올림 효과도 멈춘다 (효과가 서로 엉키지 않게) */
        a.big, a.fb { -webkit-tap-highlight-color: transparent; }
        body.waiting { overflow: hidden; }
        body.waiting .wrapIn { pointer-events: none; }
        body.waiting .big:hover em { transform: none; }
        body.waiting .big.cur:hover { border-color: var(--rule); }
        body.waiting .fb:hover { background: none; }
        /* 고른 카드만 '고름' 표시 */
        .big.picking { outline: 2px solid var(--acc); outline-offset: -2px; }
        .big.picking::after { content: "고르는 중"; position: absolute; left: 20px; bottom: 8px; font-size: 10px; font-weight: 700; letter-spacing: .14em; color: var(--acc); }
        .wait .card { width: 100%; max-width: 260px; background: var(--bg); text-align: center; padding: 28px 18px 22px; }
        .wait .sp { width: 34px; height: 34px; margin: 0 auto; border: 2px solid var(--rule); border-top-color: var(--acc); border-radius: 50%; animation: spin .8s linear infinite; }
        .wait .t { font-family: "Noto Serif KR", serif; font-size: 17px; margin-top: 16px; }
        .wait .t span { animation: dots 1.2s infinite; }
        .wait .t span:nth-child(2) { animation-delay: .2s; }
        .wait .t span:nth-child(3) { animation-delay: .4s; }
        .wait .s { font-size: 12px; color: var(--dim); margin-top: 6px; }
        @@keyframes spin { to { transform: rotate(360deg); } }
        @@keyframes dots { 0%, 20% { opacity: .2; } 50% { opacity: 1; } 100% { opacity: .2; } }
    </style>
</head>
<body>
<div class="wrapIn">

    <div class="top">
        <span><a href="/">홈</a> › <b>@hubTitle</b></span>
        <span>@kNow.ToString("M월 d일") @(dayKor[(int)kNow.DayOfWeek])요일</span>
    </div>
    <div class="k">DAILY MISSION</div>
    <h1 class="T">@(hubTitle)에<br>오신 것을 환영합니다</h1>
  
    @* ── 두 버전 ── *@
    <div class="ask">어느 화면으로 할까요?</div>
    <p class="askSub">
        <b>새 버전이 나왔어요.</b> 한번 써 보세요.
        지금 쓰던 화면도 그대로 쓸 수 있고, <b>기록과 점수는 두 버전이 함께</b> 쓰니 어느 쪽으로 해도 괜찮아요.
    </p>
    <div class="pair">
        <a class="big cur" href="/DailyMission2/Index" data-v="old">
            <div class="tx">
                <div class="tg">지금 쓰던 버전</div>
                <div class="nm">@hubTitle</div>
                <div class="ds">익숙한 화면 그대로 사용하기</div>
            </div>
            <em>›</em>
        </a>
        <a class="big new" href="/DailyMission4/Index" data-v="new">
            <span class="badge">NEW</span>
            <div class="tx">
                <div class="tg">새 버전</div>
                <div class="nm">새 @hubTitle</div>
                <div class="ds">더 편하게 하도록 새로 꾸몄어요</div>
            </div>
            <em>→</em>
        </a>
    </div>

    @* ── 버전 선택 클릭수 (Basic · SuperAdmin 계정만) ── *@
    @if (canSeeStats)
    {
        <section class="hubst" aria-label="버전 선택 클릭수 (관리자만 보여요)">
            <div class="hd">
                <span class="only">관리자만 보여요 · 버전 선택</span>
                @if (stats != null)
                {
                    <span class="seg" role="group" aria-label="기간">
                        <button type="button" class="on" data-p="all">전체</button><button type="button" data-p="today">오늘</button><button type="button" data-p="week">7일</button>
                    </span>
                }
            </div>

            @if (stats == null)
            {
                <div class="none">클릭 기록 표(DM2HubClickLog)가 아직 없어요 — SQL/CreateDM2HubClickLog.sql 을 실행해 주세요.</div>
            }
            else
            {
                var periods = new (string Key, BulletinBoard.Models.DailyMission2.DM2HubClickPeriod P)[]
                    { ("all", stats.All), ("today", stats.Today), ("week", stats.Week) };

                foreach (var (key, p) in periods)
                {
                    <div class="per" data-p="@key" hidden="@(key != "all")">
                        <div class="row">
                            <span><b>@p.OldClicks</b>회 · 쓰던 버전</span>
                            <span class="r"><b>@p.NewClicks</b>회 · 새 버전</span>
                        </div>
                        <div class="bar" role="img" aria-label="쓰던 버전 @(p.OldPct)% · 새 버전 @(p.NewPct)%">
                            @if (p.Total > 0)
                            {
                                <i class="o" style="width:@(p.OldPct)%"></i><i class="w" style="width:@(p.NewPct)%"></i>
                            }
                        </div>
                        <div class="ft">
                            <span>@(p.Total > 0 ? p.OldPct + "%" : "–") · @(p.OldUsers)명</span>
                            <span>@(p.NewUsers)명 · @(p.Total > 0 ? p.NewPct + "%" : "–")</span>
                        </div>
                    </div>
                }
            }
        </section>
    }


    @* ── 의견 보내기 (크게) ── *@
    <a class="fb" href="/Board/Create2?boardName=Anonymous">
        
        <div class="tx">
            <div class="tg">여러분의 의견</div>
            <div class="nm">개선사항 보내기</div>
            <div class="ds">더 나은 @(hubTitle)을 위해 좋았던 점, 불편한 점을 알려 주세요. 이름을 남기지 않아도 돼요.</div>
        </div>
        <em>→</em>
    </a>

         <nav class="links">
            <a href="/Home/Index">홈으로</a>
        </nav>

    <div class="quote">말씀을 읽는 것이 복입니다 — 요한계시록 1:3</div>
</div>

<form id="hubClickForm" hidden>@Html.AntiForgeryToken()</form>

<div class="wait" id="wait" role="status" aria-live="polite">
    <div class="card">
        <div class="sp" aria-hidden="true"></div>
        <div class="t">잠시만 기다려 주세요<span>.</span><span>.</span><span>.</span></div>
        <div class="s" id="waitMsg">화면을 불러오고 있어요</div>
    </div>
</div>

<script>
(function () {
    /* 기간 탭 (관리자 집계) */
    var seg = document.querySelector('.hubst .seg');
    if (seg) {
        seg.addEventListener('click', function (e) {
            var b = e.target.closest('button[data-p]');
            if (!b) return;
            seg.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); });
            document.querySelectorAll('.hubst .per').forEach(function (d) { d.hidden = d.dataset.p !== b.dataset.p; });
        });
    }

    /* 두 버전 버튼 — 클릭 기록(이동을 막지 않게 sendBeacon) + 대기 카드 */
    var box = document.getElementById('wait'), msg = document.getElementById('waitMsg');
    var tokenEl = document.querySelector('#hubClickForm input[name="__RequestVerificationToken"]');

    document.addEventListener('click', function (e) {
        if (e.defaultPrevented || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        var a = e.target.closest('a[href]');
        if (!a) return;
        var raw = (a.getAttribute('href') || '').trim();
        if (!raw || raw.charAt(0) === '#' || /^(javascript|mailto|tel):/i.test(raw)) return;

        var url;
        try { url = new URL(a.href, location.href); } catch (_) { return; }
        if (url.origin !== location.origin) return;

        /* 어느 버전을 골랐는지 기록 */
        var v = a.getAttribute('data-v');
        if (v && tokenEl) {
            try {
                var fd = new FormData();
                fd.append('v', v);
                fd.append('__RequestVerificationToken', tokenEl.value);
                if (navigator.sendBeacon) navigator.sendBeacon('/DailyMission2/HubClick', fd);
                else fetch('/DailyMission2/HubClick', { method: 'POST', body: fd, keepalive: true });
            } catch (err) { }
        }

        /* 카드를 먼저 그린 뒤 이동 (아이폰 Safari 대응) */
        e.preventDefault();
        if (document.body.classList.contains('waiting')) return;   // 두 번 눌러도 한 번만

        msg.textContent = url.pathname === '/' ? '홈으로 이동하고 있어요' : '화면을 불러오고 있어요';
        /* 고른 카드에 표시를 남기고, 아래 화면의 누름 · 올림 효과는 멈춘다 */
        var picked = a.closest('.big');
        if (picked) picked.classList.add('picking');
        if (a.blur) a.blur();
        document.body.classList.add('waiting');
        box.classList.add('show');

        requestAnimationFrame(function () {
            requestAnimationFrame(function () { setTimeout(function () { window.location.href = url.href; }, 30); });
        });
    });

    /* 뒤로 가기로 돌아왔을 때 원래대로 */
    window.addEventListener('pageshow', function () {
        box.classList.remove('show');
        document.body.classList.remove('waiting');
        document.querySelectorAll('.big.picking').forEach(function (x) { x.classList.remove('picking'); });
    });
})();
</script>
</body>
</html>
