@using BulletinBoard.Common
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model List<BulletinBoard.Models.DailyMission2.AwardUserClaimRow>

     
@{
    Layout = "_Layout_Mission2_New";
    int cYear = (int)(ViewBag.cYear ?? DateHelper.GetKoreaNow().Year);
}

<link rel="stylesheet" href="/css/mission2/awardDash.css" />

<div class="awardWrap">
    <div class="head">
        <div class="title">
            📜 시상 히스토리(대시보드2)
            <div class="sub">@cYear 년 전체 (Delivered 포함)</div>
        </div>
        <div class="actions">
            <a class="btn ghost" href="/DailyMission2Award/Dashboard?year=@cYear">대시보드로</a>
            <a class="btn ghost" href="/DailyMission2Award/MyAwards">내 시상 내역</a>
        </div>
    </div>

    <div class="card">
        <div class="tableWrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>UserName</th>
                        <th>연도</th>
                        <th>단계</th>
                        <th>Status</th>
                        <th>선택 상품ID</th>
                        <th>선택일</th>
                        <th>생성</th>
                        <th>수정</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr><td colspan="9" class="empty">기록이 없어요.</td></tr>
                }
                else
                {
                    foreach (var row in Model)
                    {
                        <tr>
                            <td class="mono">@row.Id</td>
                            <td>@row.UserName</td>
                            <td class="mono">@row.cYear</td>
                            <td class="mono">@row.AwardLevel</td>
                            <td>
                                @if ((row.Status ?? "").Equals("Eligible", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge warn">Eligible</span>
                                }
                                else if ((row.Status ?? "").Equals("Selected", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge ok">Selected</span>
                                }
                                else if ((row.Status ?? "").Equals("Delivered", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge done">Delivered</span>
                                }
                                else
                                {
                                    <span class="badge">@row.Status</span>
                                }
                            </td>
                            <td class="mono">@((row.SelectedProductID.HasValue) ? row.SelectedProductID.Value.ToString() : "-")</td>
                            <td class="mono">@((row.SelectedDT.HasValue) ? row.SelectedDT.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                            <td class="mono">@row.InsertDT.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="mono">@row.UpdateDT.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
