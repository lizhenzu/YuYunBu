@using BulletinBoard.Common
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model BulletinBoard.Models.DailyMission2.AwardPickGiftsVM
@using System
@using System.Collections.Generic

@{
    Layout = "_Layout_Mission2_New";
    bool isAdmin = Model?.IsAdmin ?? false;

    // ✅ 현재 URL (팝업에서 "다음에/3일/7일 숨기기" 눌렀을 때 되돌아갈 곳)
    var returnUrl = (Context?.Request?.Path.ToString() ?? "")
                  + (Context?.Request?.QueryString.ToString() ?? "");

    // ✅ 공용 팝업 메시지(있다면)
    // - Peek: 다음 요청에서 TempData가 사라지는 부작용 방지(선택)
    var okPopupMsg = TempData.Peek("DM2_OK_POPUP")?.ToString() ?? "";
}

<link rel="stylesheet" href="/css/mission2/awardDash.css" />

<style>
    .pickWrap {
        max-width: 980px;
        margin: 0 auto;
        padding: 16px;
    }

    .pickHead {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .pickTitle {
        font-weight: 950;
        font-size: 20px;
    }

    .pickSub {
        margin-top: 6px;
        color: rgba(71,85,105,.92);
        font-weight: 900;
        font-size: 13px;
        line-height: 1.35;
    }

    .pickBadge {
        display: inline-block;
        margin-top: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(59,130,246,.10);
        border: 1px solid rgba(59,130,246,.25);
        font-weight: 950;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    @@media (max-width: 900px) {
        .grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 620px) {
        .grid { grid-template-columns: 1fr; }
    }

    .card2 {
        border: 1px solid rgba(226,232,240,.95);
        background: rgba(255,255,255,.98);
        border-radius: 18px;
        padding: 14px;
        box-shadow: 0 16px 40px rgba(15,23,42,.08);
        overflow: hidden;
    }

    /* ✅ 이미지 */
    .pImgWrap {
        width: 100%;
        aspect-ratio: 4 / 3;
        border-radius: 14px;
        overflow: hidden;
        background: rgba(241,245,249,.9);
        border: 1px solid rgba(226,232,240,.95);
        margin-bottom: 10px;
    }
    .pImg {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .pName {
        font-weight: 950;
        font-size: 16px;
    }

    .pDesc {
        margin-top: 8px;
        color: rgba(15,23,42,.75);
        font-weight: 800;
        font-size: 13px;
        line-height: 1.35;
        white-space: pre-line;
    }

    .pMeta {
        margin-top: 10px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(226,232,240,.95);
        background: rgba(248,250,252,.95);
        font-weight: 950;
        font-size: 12px;
        color: rgba(15,23,42,.85);
    }

    .btnSel {
        margin-top: 12px;
        width: 100%;
        padding: 12px 14px;
        border-radius: 16px;
        border: 1px solid rgba(34,197,94,.35);
        background: linear-gradient(135deg, rgba(34,197,94,.92), rgba(16,185,129,.92));
        color: #fff;
        font-weight: 950;
        cursor: pointer;
    }

    .btnSel:active { transform: translateY(1px); }

    .topBtns {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .topBtns a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 12px;
        border-radius: 14px;
        border: 1px solid rgba(226,232,240,.95);
        background: rgba(248,250,252,.95);
        font-weight: 950;
        color: rgba(15,23,42,.9);
        text-decoration: none;
    }
</style>

<div class="pickWrap">
    <div class="pickHead">
        <div>
            <div class="pickTitle">🎁 선물 선택</div>
            <div class="pickSub">
                @Model.cYear 년 · <b>@Model.AwardLevel</b>점 레벨 선물 고르기<br />
            </div>
            <div class="pickBadge">현재 레벨: @Model.AwardLevel 점</div>
        </div>

        <div class="topBtns">
            <a href="/DailyMission2Award/PickGiftsDone?year=@Model.cYear">✅ 나의 선물함</a>
            <a href="/DailyMission2?date=@(DateHelper.GetKoreaNow().ToString("yyyy-MM-dd"))">🏠 미션으로</a>
        </div>
    </div>

    @if (Model.Items == null || Model.Items.Count == 0)
    {
        <div class="card2">
            <div style="font-weight:950">표시할 상품이 없어요.</div>
            <div class="pDesc">
                이 레벨의 예산(@Model.AmountOfMoney 원) 미만 상품이 등록되어 있는지 확인해 주세요.
            </div>
        </div>
    }
    else
    {
        <div class="grid">
            @foreach (var p in Model.Items)
            {
                <div class="card2">
                    <!-- ✅ 상품 이미지: /images/AwardItem/{ProductID}.jpg -->
                    <div class="pImgWrap">
                        <img class="pImg"
                             src="/images/AwardItem/@(@p.ProductID).jpg"
                             alt="@p.ProductName"
                             loading="lazy"
                             onerror="this.closest('.pImgWrap').style.display='none';" />
                    </div>

                    <div class="pName">[@p.ProductID] @p.ProductName</div>
                    <div class="pDesc">@((p.ProductDescription ?? "").Trim())</div>

                    <div class="pMeta">
                        @if (isAdmin)
                        {
                            <span class="pill">💰 @p.UnitPrice 원</span>
                        }
                        <span class="pill">⭐ @Model.AwardLevel 점 레벨</span>
                    </div>

                    <form method="post" action="/DailyMission2Award/PickGiftsSelect">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="cYear" value="@Model.cYear" />
                        <input type="hidden" name="awardLevel" value="@Model.AwardLevel" />
                        <input type="hidden" name="productId" value="@p.ProductID" />
                        <button type="submit" class="btnSel"
                                onclick="return confirm('[@Model.AwardLevel 점] 선물을 이걸로 선택할까요?');">
                            ✅ 이 선물로 선택하기
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</div>

@* ✅ 공용 OK 팝업(있다면) - PickGifts 화면에서는 RedirectUrl 필요 없음 *@
@{
    // ✅ anonymous type 대신 Dictionary로 넘겨서 RuntimeBinderException 방지
    var popupModel = new Dictionary<string, object>
    {
        ["Message"] = okPopupMsg,
        ["RedirectUrl"] = "",       // PickGifts에서는 이동버튼 숨김
        ["ReturnUrl"] = returnUrl,  // 숨김 후 돌아올 URL
        ["AutoCloseSeconds"] = 0    // 숨김 버튼 UX 때문에 자동닫기 OFF
    };
}
@await Html.PartialAsync("~/Views/DailyMission2/Partials/_OkPopup.cshtml", popupModel)
