    /* ── 페이지 전체 읽음/취소 (AJAX 토글, 반복 가능) ── */
    window.markPageAjax = async function () {
        var btn = document.getElementById('completeMega');
        if (!btn || btn.disabled) return;
        btn.disabled = true;
        showLoading();
        try {
            /* JSON 전송 — application/json은 UTF-8이 보장되어 한글 깨짐 없음 */
            var res = await fetch('/DailyMission4/ToggleBibleRange', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json; charset=utf-8',
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json',
                    'RequestVerificationToken': getToken()
                },
                body: JSON.stringify({
                    bibleText: BIBLE_TEXT,
                    fromJang:  FROM_JANG,
                    fromZul:   FROM_ZUL,
                    toJang:    TO_JANG,
                    toZul:     TO_ZUL
                }),
                credentials: 'same-origin'
            });

            if (!res.ok) {
                console.error('ToggleBibleRange HTTP', res.status);
                return;   /* finally 에서 btn 복구 */
            }

            var json = null;
            try { json = await res.json(); } catch(pe) { console.error('JSON parse error', pe); }
            if (!json || !json.ok) { console.error('ToggleBibleRange ok=false', json); return; }

            /* ── UI 업데이트 ── */
            document.querySelectorAll('.verse-card-r').forEach(function (card) {
                var vid = card.dataset.verseId;
                var rb  = document.getElementById('vr-' + vid);
                if (json.isRead) {
                    card.classList.add('is-read');
                    if (rb) { rb.textContent = '✓'; rb.classList.add('done'); rb.classList.remove('unread'); }
                } else {
                    card.classList.remove('is-read');
                    if (rb) { rb.textContent = '✓'; rb.classList.remove('done'); rb.classList.add('unread'); }
                }
            });
            checkDone();

            /* ── 전체 통독률 갱신 (비동기, 실패해도 무시) ── */
            refreshOverallProgress();

        } catch (e) {
            console.error('markPageAjax error', e);
        } finally {
            /* 성공·실패·예외 모든 경우에 반드시 복구 */
            hideLoading();
            btn.disabled = false;
        }
    };

    /* ── 전체 통독률 카드 갱신 ── */
    async function refreshOverallProgress() {
        try {
