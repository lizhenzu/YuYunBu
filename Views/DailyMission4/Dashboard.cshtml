    .qz.hm .hGo { background: rgba(255,255,255,.78); border-radius: 999px; padding: 3px 10px; white-space: nowrap; }
    .qz.hm a.hM.next { box-shadow: inset 0 0 0 2.5px var(--hBlue); }
    .qz.hm a.hM.next .hGo { background: var(--hBlue); color: #fff; }
    .qz.hm a.hM.ok  { opacity: .62; }
    .qz.hm a.hM.off { opacity: .5; }
    .qz.hm .hStamp { position: absolute; right: 8px; top: 8px; width: 44px; height: 44px; border-radius: 50%; border: 2.5px solid #2F7A52; color: #2F7A52; background: rgba(255,255,255,.7);
                     display: grid; place-items: center; font-weight: 800; font-size: 12px; transform: rotate(-12deg); }

    /* 달력 — 가는 줄, 오늘은 파란 테두리, 네 가지 다 한 날은 연한 파랑 */
    .qz.hm .hCalNav { display: inline-flex; gap: 14px; }
    .qz.hm .hCalNav a { color: var(--hDim2); text-decoration: none; font-size: 18px; line-height: 1; }
    .qz.hm .hCalG { display: grid; grid-template-columns: repeat(7, 1fr); margin-top: 8px; }
    .qz.hm .hCalWd { text-align: center; font-size: 10.5px; color: var(--hDim); padding: 4px 0 6px; }
    .qz.hm a.hCalD { display: block; text-align: center; padding: 6px 0 5px; border-top: 1px solid var(--hLine); font-size: 14px; color: var(--hTx); text-decoration: none; -webkit-tap-highlight-color: transparent; }
    .qz.hm .hCalP { display: block; font-size: 10px; color: var(--hDim); margin-top: 1px; }
    .qz.hm a.hCalD.mute { color: #D1D5DB; } .qz.hm a.hCalD.mute .hCalP { color: #E5E7EB; }
    .qz.hm a.hCalD.has .hCalP { color: var(--hBlue); font-weight: 800; }
    .qz.hm a.hCalD.full { background: var(--hBlueSoft); border-radius: 8px; }
    .qz.hm a.hCalD.today { box-shadow: inset 0 0 0 2px var(--hBlue); border-radius: 8px; font-weight: 800; }
    .qz.hm a.hCalD.sel { background: var(--hSoft); border-radius: 8px; }
    .qz.hm .hLeg { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; font-size: 10.5px; color: var(--hDim); }
    .qz.hm .hLeg i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 4px; vertical-align: -1px; }

    /* 더 보기 — 글자 + 화살표 줄 */
    .qz.hm .hMore { margin-top: 10px; }
    .qz.hm .hMore a { display: flex; justify-content: space-between; align-items: center; padding: 13px 2px; border-top: 1px solid var(--hLine); font-size: 15px; font-weight: 700; color: var(--hInk); text-decoration: none; -webkit-tap-highlight-color: transparent; }
    .qz.hm .hMore a:last-child { border-bottom: 1px solid var(--hLine); }
    .qz.hm .hMore a i { font-style: normal; color: var(--hNoBlue); font-size: 16px; }
    .qz.hm .hMore a.hl { color: var(--hBlue); }
    @@media (prefers-reduced-motion: reduce) { .qz.hm a.hM { transition: none; } }
</style>

<div class="qz hm">
    <div class="qzBody">

        <div class="qzBar">
            <div><a class="qzHome" href="/">@ConstatsCommon.ToHome</a></div>
            <div class="qzDate">@dPretty</div>
        </div>
        <div class="qzProg"><i style="width:100%"></i></div>

        @if (!string.IsNullOrWhiteSpace(toast))
        {
            <div class="qzLock">@toast</div>
        }

        @* ── 인사 — "도전! 성경말씀"은 작은 파란 글자 (누르면 예전 디자인 DailyMission2 로 간다) ── *@
        <div class="hPg">
            <div class="hK"><a href="/DailyMission2/Index">@ConstatsCommon.MainKeyTitle</a></div>
            <div class="hKs">"거룩한 습관 만들기" 프로그램에 오심을 환영해요.</div>
        </div>
        <div class="hI">
            @if (isPast)
            {
                <h2>@dateKo</h2>
                <div class="hD">이 날은 네 가지 중 @(doneCnt)가지를 했어요</div>
            }
            else
            {
                <h2>@(displayName)님, 안녕하세요</h2>
                <div class="hD">
                    @dateKo
                    @if (streak > 0)
                    {
                        <text> · </text><b>@(streak)일째 이어오는 중</b>
                    }
                </div>
            }
        </div>

        @if (isPast)
        {
            <div class="qzLock" style="margin-top:16px">
                <b>@Model.SelectedDate.ToString("M월 d일", new CultureInfo("ko-KR"))</b>을 보고 있어요<br>
                오늘 · 어제 · 그저께만 할 수 있어요<br>
                <a class="qzHome" style="line-height:2.4;color:var(--hBlue)" href="/DailyMission4?date=@today.ToString("yyyy-MM-dd")">오늘로 이동 →</a>
            </div>
        }

        @* ── 나의 기록 — 인사 바로 아래. 예전 구성(진행 원 · 올해 총 포인트 · 7일 막대 · 네 칸 기록)을 밝은 톤으로 ── *@
        <div class="hSh first">나의 기록</div>

        <div class="hTop">
            <div class="hRing" role="img" aria-label="@(isPast ? "이 날" : "오늘") 미션 4개 중 @(doneCnt)개 완료">
                <svg viewBox="0 0 36 36" aria-hidden="true">
                    <circle cx="18" cy="18" r="15" fill="none" stroke="#E8ECF2" stroke-width="3.6" />
                    <circle cx="18" cy="18" r="15" fill="none" stroke="#2F80ED" stroke-width="3.6" stroke-linecap="round"
                            stroke-dasharray="@_ringLen.ToString("0.0", CultureInfo.InvariantCulture)"
                            stroke-dashoffset="@_ringOff.ToString("0.0", CultureInfo.InvariantCulture)" />
                </svg>
                <span class="hRingC"><b>@doneCnt/4</b><small>@(isPast ? "이 날 미션" : "오늘 미션")</small></span>
            </div>
            <div class="hSum">
                <div class="hSumL">올해 총 포인트</div>
                <div class="hSumV">@total.ToString("N0")<u>점</u></div>
                <div class="hSumT">@(isPast ? "이 날" : "오늘") <b>+@(_dayPt)</b>점 받았어요</div>
            </div>
        </div>

        <div class="hChd">
            <span class="hChT">최근 7일 <b>@(_week7Sum)점</b></span>
            <span class="hChM">하루 최대 @(_dayMax)점</span>
        </div>
        <div class="hBars">
            @foreach (var _day in _days7)
            {
                int  _p     = PointOf(_day);
                bool _isEnd = _day == _endDay;
                bool _all   = AllDoneOf(_day);
                int  _h     = (int)Math.Round(Math.Min(_p, _dayMax) * 100.0 / _dayMax);
                string _lab = _day == today ? "오늘" : _wk[(int)_day.DayOfWeek];
                <a class="hBar @(_isEnd ? "end" : "") @(_all ? "all" : "") @(_p == 0 ? "zero" : "")"
                   href="/DailyMission4?date=@_day.ToString("yyyy-MM-dd")" title="@_day.ToString("M/d") · @(_p)점">
                    <b>@_p</b>
                    <i style="height:@(_p == 0 ? "2px" : _h + "%")"></i>
                    <em>@_lab<small>@_day.Day</small></em>
                </a>
            }
        </div>
        <div class="hLg">
            <span><i style="background:#2F80ED"></i>@(isPast ? "보고 있는 날" : "오늘")</span>
            <span><i style="background:#8DB5F3"></i>네 가지 다 한 날</span>
            <span><i style="background:#CFE0FA"></i>그 외</span>
        </div>

        <div class="hFacts">
            <div><div class="k">이어온 날</div><div class="v">@streak<u>일</u></div></div>
            <div><div class="k">이달 수행</div><div class="v">@monthDone<u>/@monthElapsed</u></div></div>
            <div><div class="k">이달 점수</div><div class="v">@monthPoint.ToString("N0")<u>점</u></div></div>
            <div><div class="k">네 가지 다 한 날</div><div class="v">@_allDoneMonth<u>일</u></div></div>
        </div>
        @* 마일스톤 막대는 선물을 위한 것이라 학생에게만 보여 준다. *@
        @if (isStudent && integrated > 0)
        {
            <div class="hGift">
                <div class="h">
                    <span>통합 @integrated.ToString("N0")점</span>
                    @if (!canPickGift && nextMilestone > 0)
                    {
                        <span>다음 선물까지 <b>@needPoint.ToString("N0")점</b></span>
                    }
                    else
                    {
                        <span>@(nextMilestone > 0 ? nextMilestone.ToString("N0") + "점" : "최고 단계")</span>
                    }
                </div>
                <div class="pb"><i style="width:@((int)Math.Round(giftFill * 100))%"></i></div>
            </div>
        }

        @* ── 선물 고를 수 있음 ── *@
        @if (canPickGift)
        {
            <a class="hPick" href="/StudentPointDashboard4/MyGiftBox3">
                <b>선물을 고를 수 있어요</b>
                <span>@giftCredit.ToString("N0") credit · 고르러 가기 →</span>
            </a>
        }

        @* ── 네 가지를 다 하면 "오늘 완료" 도장 ── *@
        @if (!isPast && doneCnt == 4)
        {
            <div class="hParty">
                <div class="hSeal">오늘<br />완료</div>
                <b>오늘 네 가지 모두 했어요</b>
                <span>+@(_dayPt)점@(streak > 1 ? $" · {streak}일째 이어서 하고 있어요" : "")</span>
            </div>
        }

        @* ── 오늘의 미션 카드 4장 ── *@
        <div class="hMs">
            @for (int _i = 0; _i < missions.Length; _i++)
            {
                var m = missions[_i];
                bool _off = !canAct || !m.Has;
                string _cls = $"hM {_tone[_i]}" + (m.Done ? " ok" : "") + (_off && !m.Done ? " off" : "") + (m.No == _nextNo ? " next" : "");
                <a class="@_cls" href="@m.Href">
                    @if (m.Done) { <span class="hStamp">완료</span> }
                    <span class="hNo">@m.No</span>
                    <span class="hN">@m.Title</span>
                    <span class="hS">
                        @if (!m.Has) { <text>준비된 내용이 없어요</text> }
                        else
                        {
                            if (!string.IsNullOrWhiteSpace(m.Sub2)) { <span>@m.Sub2</span> }
                            if (!string.IsNullOrWhiteSpace(m.Sub)) { <span>@m.Sub</span> }
                        }
                    </span>
                    @if (!string.IsNullOrWhiteSpace(m.Note)) { <span class="hNote">@m.Note</span> }
                    <span class="hP">
                        <span>@(m.Done ? "+" : "")@(m.Point)점</span>
                        @if (!m.Done && !_off) { <span class="hGo">@_go[_i] ›</span> }
                    </span>
                </a>
            }
        </div>

        @* ── 이달의 달력 ── *@
        <div class="hSh">
            <span>@monthFirst.ToString("yyyy년 M월", new CultureInfo("ko-KR"))</span>
            <span class="hCalNav">
                <a href="/DailyMission4?date=@monthFirst.AddMonths(-1).ToString("yyyy-MM-dd")" title="지난달">←</a>
                <a href="/DailyMission4?date=@monthFirst.AddMonths(1).ToString("yyyy-MM-dd")" title="다음달">→</a>
            </span>
        </div>
        <div class="hCalG">
            @foreach (var wd in weekDayNames)
            {
                <div class="hCalWd">@wd</div>
            }
            @for (int i = 0; i < gridCells; i++)
            {
                var day     = gridStart.AddDays(i);
                var inMonth = (day.Month == monthFirst.Month);
                var pt      = inMonth ? PointOf(day) : 0;
                var full    = inMonth && AllDoneOf(day);
                var isToday = (day.Date == today);
                var isSel   = (day.Date == Model.SelectedDate.Date) && !isToday;

                var cls = (inMonth ? "" : "mute ") + (pt > 0 ? "has " : "")
                        + (full ? "full " : "") + (isToday ? "today " : "") + (isSel ? "sel" : "");

                <a class="hCalD @cls" href="/DailyMission4?date=@day.ToString("yyyy-MM-dd")">
                    @day.Day
                    <span class="hCalP">@(pt > 0 ? pt.ToString() : "–")</span>
                </a>
            }
        </div>
        <div class="hLeg">
            <span><i style="box-shadow:inset 0 0 0 2px #2F80ED"></i>오늘</span>
            <span><i style="background:#EAF2FD"></i>네 가지 모두</span>
            <span>숫자 = 그날 받은 점수</span>
        </div>

        @* ── 우리 가족 ── *@
        @await Html.PartialAsync("~/Views/DailyMission4/Partials/_FamilyTreeBone.cshtml")

        @* ── 더 보기 ── *@
        <div class="hSh">더 보기</div>
        <div class="hMore">
            @* 더 보기의 선물 링크는 누구에게나 보여 준다. (관리자·부모도 선물함에서 가족팀 선물을 본다)
               학생 전용으로 묶는 것은 위쪽 '선물을 고를 수 있어요' 줄뿐이다. *@
            @if (needPickAward)
            {
                <a class="hl" href="@awardPickUrl"><span>선물 고르기 · 레벨 달성!</span><i>→</i></a>
            }
            <a href="/StudentPointDashboard4/MyGiftBox3"><span>나의 선물함</span><i>→</i></a>
            <a href="/DailyMission4/ParticipantPersons"><span>참여자</span><i>→</i></a>
            <a href="/DailyMission4/ParticipantTeams"><span>가족팀</span><i>→</i></a>
            <a href="/DailyMission4/UserMonthlyPoints?userName=@ViewData["UserName"]"><span>월별 이력</span><i>→</i></a>
            <a href="/DailyMission4/UserDailyPoints?userName=@ViewData["UserName"]"><span>일자별 이력</span><i>→</i></a>
            <a href="/Board/Create2?boardName=Anonymous"><span>불편·개선 접수</span><i>→</i></a>
            @if (isSuperAdmin)
            {
                <a href="/DailyMission4/DeleteClickHistory"><span>관리자 · 이력 삭제</span><i>→</i></a>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync(
    "~/Views/DailyMission4/Partials/_OkPopup.cshtml",
    new {
        Message          = okPopupMsg,
        RedirectUrl      = awardUrl,
        ReturnUrl        = returnUrl,
        AutoCloseSeconds = 10,
        ShowActions      = true
    }
)

<script src="/js/GlobalCookie.js"></script>
<script>
    (function () {
        // 접힘 줄 (우리 가족)
        document.querySelectorAll('.qz [data-fold]').forEach(function (b) {
            b.addEventListener('click', function () {
                var box = document.getElementById(b.dataset.fold);
                if (!box) return;
                box.hidden = !box.hidden;
                var mark = b.querySelector('b');
                if (mark) { mark.textContent = box.hidden ? '＋' : '−'; }
            });
        });
    })();
</script>

