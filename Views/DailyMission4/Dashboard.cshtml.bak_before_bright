@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@model BulletinBoard.Models.DailyMission2.DailyMission2DashboardVM
@using System.Globalization

@*  ══════════════════════════════════════════════════════════════
    미션 홈 — Bone 스킨

    호텔 객실에 놓인 "오늘의 일정표" 를 생각하고 짰다.
      프로그램 안내 → 인사 → 이번 주 띠 → 오늘 할 일 네 줄
      → 나의 기록 → 달력 → 우리 가족 → 더 보기

    · 오늘 할 일은 01~04 번호가 붙은 한 줄짜리 항목이다.
      각 줄에 그 미션의 '오늘 내용'(말씀 제목·기도 제목 …)을 같이 적는다.
      들어가 보지 않아도 오늘 무엇을 하는지 알 수 있어야 한다.
    · 달력은 날짜마다 '그날 받은 점수'를 숫자로 적는다.
      네 가지를 다 한 날은 칸 전체를 옅은 브라스로 칠해 한눈에 세게 한다.
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = "_Layout_Mission3";

    ViewBag.DM2Page = "dash";
    ViewBag.DM2Done = false;

    var d       = Model.SelectedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var dPretty = Model.SelectedDate.ToString("yyyy.MM.dd", CultureInfo.InvariantCulture)
                  + " " + Model.SelectedDate.ToString("ddd", new CultureInfo("en-US")).ToUpperInvariant();
    var dateKo  = Model.SelectedDate.ToString("M월 d일 (ddd)", new CultureInfo("ko-KR"));
    var toast   = (ViewBag.Toast ?? "").ToString();

    bool canAct = Model.IsActionable;
    int  total  = Model.YearPoint?.YearTotalPoint ?? 0;

    string UrlWithDate(string baseUrl) => $"{baseUrl}?date={d}";

    var okPopupMsg   = TempData["DM2_OK_POPUP"] as string;
    var awardUrl     = TempData["DM2_AWARD_URL"] as string;
    var awardPickUrl = TempData.Peek("DM2_AWARD_URL") as string;
    bool needPickAward = !string.IsNullOrWhiteSpace(awardPickUrl);
    var returnUrl = (Context?.Request?.Path.ToString() ?? "") + (Context?.Request?.QueryString.ToString() ?? "");

    var st = Model.DayStatus;

    bool mWord   = st?.WordDone   ?? false;
    bool mQuiz   = st?.QuizDone   ?? false;
    bool mPray   = st?.PrayDone   ?? false;
    bool mRecite = st?.ReciteDone ?? false;
    int  doneCnt = (mWord ? 1 : 0) + (mQuiz ? 1 : 0) + (mPray ? 1 : 0) + (mRecite ? 1 : 0);

    var fullName    = (ViewData["UserFullName"] as string ?? "").Trim();
    var displayName = !string.IsNullOrEmpty(fullName) ? fullName : Model.UserName;

    var ptMap   = Model.CalendarDayPointMap ?? new Dictionary<string, int>();
    var doneMap = Model.CalendarAllDoneMap  ?? new Dictionary<string, bool>();

    int  PointOf(DateTime day) => ptMap.TryGetValue(day.ToString("yyyy-MM-dd"), out var p) ? p : 0;
    bool AllDoneOf(DateTime day) => doneMap.TryGetValue(day.ToString("yyyy-MM-dd"), out var b) && b;

    // ── 이어온 날 : 오늘(또는 어제)부터 거꾸로 세어, 점수가 있는 날이 몇 날 이어졌는지 ──
    var today = Model.Today.Date;
    int streak = 0;
    {
        // 오늘 아직 안 했더라도 어제까지 이어온 것은 끊긴 것이 아니다.
        var cursor = PointOf(today) > 0 ? today : today.AddDays(-1);
        while (PointOf(cursor) > 0 && streak < 400)
        {
            streak++;
            cursor = cursor.AddDays(-1);
        }
    }

    // ── 이달 수행 : 이번 달에 점수가 있는 날 / 오늘까지 지난 날 ──
    var monthFirst = new DateTime(Model.SelectedDate.Year, Model.SelectedDate.Month, 1);
    var monthLast  = monthFirst.AddMonths(1).AddDays(-1);
    int monthDone = 0, monthElapsed = 0, monthPoint = 0;
    for (var day = monthFirst; day <= monthLast; day = day.AddDays(1))
    {
        if (day > today) { break; }
        monthElapsed++;
        var p = PointOf(day);
        if (p > 0) { monthDone++; monthPoint += p; }
    }

    // ── 각 미션의 '오늘 내용' ──
    var _wr = ViewBag.TodayWordToReadRow as BulletinBoard.Models.DailyMission2.TodayWordDetailResult;
    bool hasWord = Model.Content?.TodayWordToReadId != null;
    // 말씀 제목과 성경 구절은 각각 한 줄로 보여 준다 (길면 줄 끝에서 … 로 자름)
    string wordSub = (_wr == null) ? "" : (_wr.BibleSubject ?? "");
    string wordRef = (_wr == null) ? "" :
        $"{_wr.BibleText} {SharedComm.MakeBibleSerialJangZul(_wr.BibleText, _wr.FromJang, _wr.FromZul, _wr.ToJang, _wr.ToZul)}".Trim();

    var  quiz        = Model.Content?.Quiz;
    bool hasQuiz     = quiz?.QuestionId != null;
    bool quizCorrect = st?.QuizCorrect ?? false;
    int  quizTry     = st?.QuizTryCntMax ?? 0;

    bool hasPray = Model.Content?.PrayPhraseId != null;
    dynamic _pr = ViewBag.TodayPrayPhraseRow;
    string praySub = "";
    if (_pr != null && _pr?.PrayPhraseData != null)
    {
        try { praySub = (_pr.PrayPhraseData.PrayTitle ?? "").ToString(); } catch { }
    }

    bool hasRecite = Model.Content?.WeeklyWordToReadId != null;

    var user         = await AuthService.GetSignedUser(User);
    var isSignedIn   = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));

    // 지난 날짜를 보고 있으면 '오늘 할 일'이 아니라 '그 날의 기록'이다.
    bool isPast = Model.IsOtherDate || !canAct;

    // ── 선물 (MyGiftBox 와 같은 기준) ──
    //   통합 점수 = 미션 + 출석 + 세계관 + 감사 + 전도×50
    //   100점을 채울 때마다 마일스톤이 오르고, 마일스톤마다 크레딧(원)이 쌓인다.
    //   쓸 수 있는 크레딧 = 쌓인 크레딧 − 이미 고른 선물 값
    int ToInt(object v) { try { return v == null ? 0 : Convert.ToInt32(v); } catch { return 0; } }

    int  integrated   = ToInt(ViewBag.GiftIntegrated);
    int  giftCredit   = ToInt(ViewBag.GiftAvailableCredit);

    // 선물은 학생만 고를 수 있다. 학생이 아니면 선물 관련은 한 글자도 내보내지 않는다.
    bool isStudent    = (ViewBag.GiftIsStudent is bool bStu) && bStu;
    bool canPickGift  = isStudent && (ViewBag.GiftHasAffordable is bool b2) && b2 && giftCredit > 0;

    // 다음 마일스톤(100점 단위)까지 남은 점수. 상한 2000점을 넘으면 더 오르지 않는다.
    const int MilestoneCap = 2000;
    int nextMilestone = (integrated >= MilestoneCap) ? 0 : ((integrated / 100) + 1) * 100;
    int needPoint     = nextMilestone > 0 ? (nextMilestone - integrated) : 0;
    double giftFill   = nextMilestone > 0 ? ((integrated % 100) / 100.0) : 1.0;

    var missions = new[]
    {
        new {
            No = "01", Title = "말씀", Sub = wordSub, Sub2 = wordRef, Point = 2,
            Href = UrlWithDate("/DailyMission4/Word"),
            Done = mWord, Has = hasWord, Note = (string)null
        },
        new {
            No = "02", Title = "퀴즈", Sub = "오늘 말씀에서 한 문제", Sub2 = (string)null, Point = 1,
            Href = UrlWithDate("/DailyMission4/Quiz"),
            Done = mQuiz, Has = hasQuiz,
            Note = (canAct && !quizCorrect && quizTry == 1) ? "한 번 더 도전할 수 있어요"
                 : (canAct && !quizCorrect && quizTry >= 2) ? "오늘은 두 번 도전했어요" : (string)null
        },
        new {
            No = "03", Title = "기도", Sub = praySub, Sub2 = (string)null, Point = 2,
            Href = UrlWithDate("/DailyMission4/Pray"),
            Done = mPray, Has = hasPray, Note = (string)null
        },
        new {
            No = "04", Title = "암송", Sub = "이번 주 암송 구절", Sub2 = (string)null, Point = 1,
            Href = UrlWithDate("/DailyMission4/Recite"),
            Done = mRecite, Has = hasRecite, Note = (string)null
        }
    };

    // ── 이번 주 띠 : 선택일이 든 주의 일요일부터 7일 ──
    var weekStart = Model.SelectedDate.Date.AddDays(-(int)Model.SelectedDate.DayOfWeek);
    var weekDayNames = new[] { "일", "월", "화", "수", "목", "금", "토" };

    // ── 달력 : 1일이 든 주의 일요일부터 채운다 ──
    var gridStart = monthFirst.AddDays(-(int)monthFirst.DayOfWeek);
    int gridCells = (int)Math.Ceiling((monthLast - gridStart).TotalDays + 1) ;
    gridCells = (int)(Math.Ceiling(gridCells / 7.0) * 7);
}

