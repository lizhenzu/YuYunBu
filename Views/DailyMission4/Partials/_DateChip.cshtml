@model DateTime
@*  ── 제목 옆 달력 쪽지 : 2026.09 / 14 / 월요일 ── *@
@{
    string[] _wk = { "일요일", "월요일", "화요일", "수요일", "목요일", "금요일", "토요일" };
}
<style>
    .qz .qzTitleRow { display: flex; align-items: flex-start; gap: 14px; }
    .qz .qzTitleRow > .qzTitleTx { flex: 1 1 auto; min-width: 0; }
    .qz .qzCal { flex: 0 0 auto; width: 60px; border: 1px solid var(--rule, #E2E0DB); background: #fff; text-align: center; margin-top: 4px; }
    .qz .qzCalM { font-family: "Inter", sans-serif; font-size: 10px; letter-spacing: .08em; background: var(--tx, #16181C); color: var(--bg, #F7F6F3); padding: 3px 0; }
    .qz .qzCalD { font-family: "Inter", sans-serif; font-weight: 300; font-size: 26px; line-height: 1.1; padding-top: 3px; color: var(--tx, #16181C); }
    .qz .qzCalW { font-size: 10.5px; font-weight: 600; color: var(--acc, #9A7B4F); padding-bottom: 5px; }
    .qz .qzCalW.sun { color: #B4531F; }
    .qz .qzCalW.sat { color: #3B6EA8; }
</style><div class="qzCal" aria-label="@Model.ToString("yyyy년 M월 d일") @_wk[(int)Model.DayOfWeek]">
    <div class="qzCalM">@Model.ToString("yyyy.MM")</div>
    <div class="qzCalD">@Model.Day</div>
    <div class="qzCalW @((int)Model.DayOfWeek == 0 ? "sun" : (int)Model.DayOfWeek == 6 ? "sat" : "")">@_wk[(int)Model.DayOfWeek]</div>
</div>
