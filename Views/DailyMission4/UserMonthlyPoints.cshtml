@using System.Globalization
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model BulletinBoard.Models.DailyMission2.UserDailyPointsVM

@*  ══════════════════════════════════════════════════════════════
    월별 포인트 — Bone 스킨

    달력은 미션 홈(/DailyMission4)의 달력과 같은 규칙을 쓴다.
      · 숫자 = 그날 받은 점수, 안 한 날은 –
      · 네 가지를 다 한 날은 칸 전체를 옅은 브라스로 칠한다
    아래 미션별 합계는 막대로 '얼마나 채웠는지'까지 보여 준다.
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = "_Layout_Mission3";
    ViewData["Title"] = "월별 포인트";

    var monthStart = new DateTime(Model.FromDate.Year, Model.FromDate.Month, 1);
    var monthEnd   = monthStart.AddMonths(1).AddDays(-1);

    var today = DateHelper.GetKoreaNow().Date;

    // 달력 그리드 (일요일 시작)
    int startOffset = (int)monthStart.DayOfWeek;
    var gridStart   = monthStart.AddDays(-startOffset);
    int totalCells  = (int)Math.Ceiling(((monthEnd - gridStart).TotalDays + 1) / 7.0) * 7;

    var rows = Model.Rows ?? new List<BulletinBoard.Models.DailyMission2.UserDailyPointRow>();

    // 날짜별 합계 · 날짜별 미션 수행 개수
    var map     = rows.GroupBy(x => x.DateBy.Date).ToDictionary(g => g.Key, g => g.Sum(x => x.TotalPoint));
    var doneMap = rows.GroupBy(x => x.DateBy.Date).ToDictionary(
        g => g.Key,
        g => (g.Sum(x => x.WordPoint)   > 0 ? 1 : 0)
           + (g.Sum(x => x.QuizPoint)   > 0 ? 1 : 0)
           + (g.Sum(x => x.PrayPoint)   > 0 ? 1 : 0)
           + (g.Sum(x => x.RecitePoint) > 0 ? 1 : 0));

    int PointOf(DateTime d)  => map.TryGetValue(d.Date, out var p) ? p : 0;
    int DoneCntOf(DateTime d) => doneMap.TryGetValue(d.Date, out var c) ? c : 0;

    // 이 달에 지난 날(오늘까지) · 그중 수행한 날
    int elapsed = 0, actedDays = 0;
    for (var day = monthStart; day <= monthEnd; day = day.AddDays(1))
    {
        if (day > today) { break; }
        elapsed++;
        if (PointOf(day) > 0) { actedDays++; }
    }
    if (elapsed == 0) { elapsed = (int)((monthEnd - monthStart).TotalDays) + 1; }

    // 미션별 : 합계 · 수행한 날 수 · 하루 배점
    int wordDays   = rows.Count(x => x.WordPoint   > 0);
    int quizDays   = rows.Count(x => x.QuizPoint   > 0);
    int prayDays   = rows.Count(x => x.PrayPoint   > 0);
    int reciteDays = rows.Count(x => x.RecitePoint > 0);

    var missions = new[]
    {
        new { No = "01", Name = "말씀", Sum = Model.SumWord,   Days = wordDays,   Per = 2 },
        new { No = "02", Name = "퀴즈", Sum = Model.SumQuiz,   Days = quizDays,   Per = 1 },
        new { No = "03", Name = "기도", Sum = Model.SumPray,   Days = prayDays,   Per = 2 },
        new { No = "04", Name = "암송", Sum = Model.SumRecite, Days = reciteDays, Per = 1 }
    };

    string U(int year, int month)
        => $"/DailyMission4/UserMonthlyPoints?userName={Uri.EscapeDataString(Model.UserName ?? "")}&year={year}&month={month}";

    string DayLink(DateTime d) => $"/DailyMission4?date={d:yyyy-MM-dd}";

    var prev = monthStart.AddMonths(-1);
    var next = monthStart.AddMonths(1);

    // 월 탭에서 '점수가 있는 달'을 진하게 하려면 그 달 데이터가 필요하다.
    // 여기서는 지금 보고 있는 달만 알 수 있으므로, 지난 달은 모두 같은 밝기로 둔다.
    var weekDayNames = new[] { "일", "월", "화", "수", "목", "금", "토" };
}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;700;800&display=swap">
<link rel="stylesheet" href="/css/mission3/bone.css" asp-append-version="true">

<style>
    /* ── DailyMission4 밝은 흰색 버전 (2026-10-03 시안 확정) ── */
    body { background: #FFFFFF; }
    .qz.pt4 { --pBlue: #2F80ED; --pSoft: #EAF2FD; --pInk: #111827; --pTx: #374151; --pDim: #9CA3AF; --pDim2: #6B7280; --pLine: #EEF0F3; --pGrey: #F4F6F9;
              background: #FFFFFF; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; color: var(--pTx); }
    .qz.pt4 .qzBody { background: #FFFFFF; }
    .qz.pt4 .qzBar { border-bottom-color: var(--pLine); }
    .qz.pt4 .qzProg { display: none; }

    .qz .mpK { margin-top: 20px; font-size: 12px; font-weight: 800; color: var(--pBlue); letter-spacing: .02em; }
    .qz .mpSeg { display: flex; gap: 22px; margin-top: 14px; border-bottom: 1px solid var(--pLine); }
    .qz .mpSeg a { padding: 10px 0 11px; text-decoration: none; font-size: 15px; font-weight: 700; color: var(--pDim); margin-bottom: -1px; border-bottom: 2.5px solid transparent; -webkit-tap-highlight-color: transparent; }
    .qz .mpSeg a.on { color: var(--pInk); border-bottom-color: var(--pBlue); }

    /* 월 제목 · 이동 */
    .qz .mpHead { display: flex; justify-content: space-between; align-items: flex-end; gap: 14px; margin-top: 20px; padding-bottom: 0; border-bottom: 0; }
    .qz .mpTitle { font-family: inherit; font-weight: 800; font-size: 24px; line-height: 1.3; letter-spacing: -.02em; color: var(--pInk); }
    .qz .mpSub { margin-top: 3px; font-size: 13px; color: var(--pDim2); letter-spacing: 0; }
    .qz .mpNav { display: flex; gap: 0; flex: 0 0 auto; }
    .qz .mpNav a { font-family: inherit; font-size: 20px; font-weight: 400; color: var(--pDim2); text-decoration: none; padding: 0 0 0 14px; -webkit-tap-highlight-color: transparent; }
    .qz .mpNav a:hover { color: var(--pBlue); }

    /* 이달 총점 */
    .qz .mpTot { display: flex; justify-content: space-between; align-items: flex-end; gap: 14px; padding: 18px 0 0; border-bottom: 0; }
    .qz .mpTotL { font-size: 12px; font-weight: 400; letter-spacing: 0; color: var(--pDim); margin-bottom: 3px; }
    .qz .mpTotN { font-family: inherit; font-weight: 300; font-size: 36px; line-height: 1.05; letter-spacing: 0; color: var(--pInk); font-variant-numeric: tabular-nums; }
    .qz .mpTotN u { text-decoration: none; font-size: 14px; font-weight: 400; color: var(--pDim2); margin-left: 3px; }
    .qz .mpTotR { text-align: right; flex: 0 0 auto; white-space: nowrap; }
    .qz .mpTotRV { font-family: inherit; font-weight: 300; font-size: 22px; color: var(--pBlue); font-variant-numeric: tabular-nums; }

    /* 월 탭 1~12 */
    .qz .mpTabs { display: grid; grid-template-columns: repeat(12, 1fr); margin-top: 20px; border-bottom: 1px solid var(--pLine); }
    .qz .mpTabs a { text-align: center; padding: 10px 0 11px; text-decoration: none; font-family: inherit; font-size: 13px; font-weight: 400; color: var(--pDim);
                    position: relative; margin-bottom: -1px; border-bottom: 2.5px solid transparent; font-variant-numeric: tabular-nums; -webkit-tap-highlight-color: transparent; }
    .qz .mpTabs a:hover { color: var(--pTx); }
    .qz .mpTabs a.on { color: var(--pBlue); font-weight: 800; border-bottom-color: var(--pBlue); }
    .qz .mpTabs a.on::before { display: none; }

    /* 달력 (미션 홈과 같은 규칙) */
    .qz .mpCal { margin-top: 14px; }
    .qz .mpCalG { display: grid; grid-template-columns: repeat(7, 1fr); }
    .qz .mpCalWd { font-size: 10.5px; font-weight: 400; letter-spacing: 0; color: var(--pDim); padding: 4px 0 6px; text-align: center; }
    .qz .mpCalD { height: auto; display: block; padding: 6px 0 5px; gap: 0; position: relative; text-align: center; text-decoration: none; border-top: 1px solid var(--pLine); -webkit-tap-highlight-color: transparent; }
    .qz .mpCalN { display: block; font-family: inherit; font-size: 14px; font-weight: 400; color: var(--pTx); font-variant-numeric: tabular-nums; }
    .qz .mpCalP { display: block; margin-top: 1px; font-family: inherit; font-size: 10px; font-weight: 400; color: var(--pDim); font-variant-numeric: tabular-nums; }
    .qz .mpCalD.has .mpCalP { color: var(--pBlue); font-weight: 800; }
    .qz .mpCalD.full { background: var(--pSoft); border-radius: 8px; }
    .qz .mpCalD.full .mpCalN { color: var(--pTx); font-weight: 400; }
    .qz .mpCalD.mute .mpCalN { color: #D1D5DB; }
    .qz .mpCalD.today { box-shadow: inset 0 0 0 2px var(--pBlue); border-radius: 8px; }
    .qz .mpCalD.today .mpCalN { font-weight: 800; }
    .qz .mpCalD.today::before { display: none; }
    .qz .mpCalLeg { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 8px; font-size: 10.5px; color: var(--pDim); letter-spacing: 0; }
    .qz .mpCalLeg span { display: flex; align-items: center; gap: 4px; }
    .qz .mpCalLeg i { width: 10px; height: 10px; display: block; border: 0; border-radius: 3px; }

    /* 미션별 합계 */
    .qz.pt4 .qzLabel { margin: 26px 0 0 !important; padding-top: 16px; border-top: 1px solid var(--pLine); font-size: 16px; font-weight: 800; letter-spacing: 0; color: var(--pInk); }
    .qz .mpRow { display: flex; align-items: center; gap: 11px; padding: 13px 0; border-bottom: 1px solid var(--pLine); }
    .qz .mpNo { font-family: inherit; font-size: 13px; font-weight: 800; color: #7FA3DB; width: 20px; flex: 0 0 auto; }
    .qz .mpName { font-family: inherit; font-size: 15px; font-weight: 700; color: var(--pInk); width: 38px; flex: 0 0 auto; }
    .qz .mpBarWrap { flex: 1 1 auto; min-width: 0; }
    .qz .mpBar { display: block; height: 5px; border-radius: 3px; background: #E8ECF2; overflow: hidden; }
    .qz .mpBar i { display: block; height: 5px; border-radius: 3px; background: var(--pBlue); }
    .qz .mpMeta { display: flex; justify-content: space-between; gap: 8px; font-size: 11px; color: var(--pDim); margin-top: 5px; letter-spacing: 0; }
    .qz .mpV { font-family: inherit; font-weight: 300; font-size: 19px; color: var(--pInk); width: 56px; text-align: right; flex: 0 0 auto; font-variant-numeric: tabular-nums; }
    .qz .mpV u { text-decoration: none; font-size: 10.5px; color: var(--pDim); margin-left: 1px; }
</style>

<div class="qz pt4">
    <div class="qzBody">

        <div class="qzBar">
            <div>
                <a class="qzHome" href="/">@ConstatsCommon.ToHome</a><span class="qzHomeSep">·</span><a class="qzHome" href="/DailyMission4">미션홈</a>
            </div>
            <div class="qzDate">@(Model.UserName ?? "")</div>
        </div>
        <div class="qzProg"><i style="width:100%"></i></div>

        <div class="mpK">@ConstatsCommon.MainKeyTitle</div>
        <div class="mpSeg">
            <a class="on" href="@U(monthStart.Year, monthStart.Month)">월별</a>
            <a href="/DailyMission4/UserDailyPoints?userName=@Uri.EscapeDataString(Model.UserName ?? "")">일자별</a>
        </div>

        @* ── 월 제목 · 이동 ── *@
        <div class="mpHead">
            <div>
                <div class="mpTitle">@monthStart.ToString("yyyy년 M월", new CultureInfo("ko-KR"))</div>
                <div class="mpSub">
                    @Model.FromDate.ToString("M월 d일", new CultureInfo("ko-KR"))
                    ~ @Model.ToDate.ToString("M월 d일", new CultureInfo("ko-KR"))
                </div>
            </div>
            <div class="mpNav">
                <a href="@U(prev.Year, prev.Month)" title="지난달">←</a>
                <a href="@U(next.Year, next.Month)" title="다음달">→</a>
            </div>
        </div>

        @* ── 이달 총점 ── *@
        <div class="mpTot">
            <div>
                <div class="mpTotL">이달 총점</div>
                <div class="mpTotN">@Model.SumTotal.ToString("N0")<u>점</u></div>
            </div>
            <div class="mpTotR">
                <div class="mpTotL">수행한 날</div>
                <div class="mpTotRV">@actedDays / @elapsed</div>
            </div>
        </div>

        @* ── 월 탭 ── *@
        <div class="mpTabs">
            @for (int m = 1; m <= 12; m++)
            {
                <a class="@(m == monthStart.Month ? "on" : "")" href="@U(monthStart.Year, m)">@m</a>
            }
        </div>

        @* ── 달력 ── *@
        <div class="mpCal">
            <div class="mpCalG">
                @foreach (var wd in weekDayNames)
                {
                    <div class="mpCalWd">@wd</div>
                }
                @for (int i = 0; i < totalCells; i++)
                {
                    var day     = gridStart.AddDays(i).Date;
                    var inMonth = (day.Month == monthStart.Month && day.Year == monthStart.Year);
                    var pt      = inMonth ? PointOf(day) : 0;
                    var full    = inMonth && DoneCntOf(day) >= 4;
                    var isToday = (day == today);

                    var cls = (inMonth ? "" : "mute ") + (pt > 0 ? "has " : "")
                            + (full ? "full " : "") + (isToday ? "today" : "");

                    if (inMonth)
                    {
                        <a class="mpCalD @cls" href="@DayLink(day)" title="@day.ToString("yyyy-MM-dd") 미션으로 이동">
                            <span class="mpCalN">@day.Day</span>
                            <span class="mpCalP">@(pt > 0 ? pt.ToString() : "–")</span>
                        </a>
                    }
                    else
                    {
                        <div class="mpCalD @cls">
                            <span class="mpCalN">@day.Day</span>
                            <span class="mpCalP">&nbsp;</span>
                        </div>
                    }
                }
            </div>
            <div class="mpCalLeg">
                <span><i style="box-shadow:inset 0 0 0 2px #2F80ED"></i>오늘</span>
                <span><i style="background:#EAF2FD"></i>네 가지 모두</span>
                <span>숫자 = 그날 점수</span>
            </div>
        </div>

        @* ── 미션별 합계 ── *@
        <div class="qzLabel">미션별 합계</div>
        @foreach (var m in missions)
        {
            int max = m.Per * elapsed;                       // 이 달에 받을 수 있었던 최대 점수
            int pct = max > 0 ? (int)Math.Round(m.Sum * 100.0 / max) : 0;
            if (pct > 100) { pct = 100; }

            <div class="mpRow">
                <span class="mpNo">@m.No</span>
                <span class="mpName">@m.Name</span>
                <span class="mpBarWrap">
                    <span class="mpBar"><i style="width:@(pct)%"></i></span>
                    <span class="mpMeta">
                        <span>@(m.Days)일 수행</span>
                        <span>최대 @(max)점</span>
                    </span>
                </span>
                <span class="mpV">@m.Sum<u>점</u></span>
            </div>
        }
    </div>
</div>
