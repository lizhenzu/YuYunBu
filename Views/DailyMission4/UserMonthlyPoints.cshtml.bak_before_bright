@using System.Globalization
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model BulletinBoard.Models.DailyMission2.UserDailyPointsVM

@*  ══════════════════════════════════════════════════════════════
    월별 포인트 — Bone 스킨

    달력은 미션 홈(/DailyMission4)의 달력과 같은 규칙을 쓴다.
      · 숫자 = 그날 받은 점수, 안 한 날은 –
      · 네 가지를 다 한 날은 칸 전체를 옅은 브라스로 칠한다
    아래 미션별 합계는 막대로 '얼마나 채웠는지'까지 보여 준다.
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = "_Layout_Mission3";
    ViewData["Title"] = "월별 포인트";

    var monthStart = new DateTime(Model.FromDate.Year, Model.FromDate.Month, 1);
    var monthEnd   = monthStart.AddMonths(1).AddDays(-1);

    var today = DateHelper.GetKoreaNow().Date;

    // 달력 그리드 (일요일 시작)
    int startOffset = (int)monthStart.DayOfWeek;
    var gridStart   = monthStart.AddDays(-startOffset);
    int totalCells  = (int)Math.Ceiling(((monthEnd - gridStart).TotalDays + 1) / 7.0) * 7;

    var rows = Model.Rows ?? new List<BulletinBoard.Models.DailyMission2.UserDailyPointRow>();

    // 날짜별 합계 · 날짜별 미션 수행 개수
    var map     = rows.GroupBy(x => x.DateBy.Date).ToDictionary(g => g.Key, g => g.Sum(x => x.TotalPoint));
    var doneMap = rows.GroupBy(x => x.DateBy.Date).ToDictionary(
        g => g.Key,
        g => (g.Sum(x => x.WordPoint)   > 0 ? 1 : 0)
           + (g.Sum(x => x.QuizPoint)   > 0 ? 1 : 0)
           + (g.Sum(x => x.PrayPoint)   > 0 ? 1 : 0)
           + (g.Sum(x => x.RecitePoint) > 0 ? 1 : 0));

    int PointOf(DateTime d)  => map.TryGetValue(d.Date, out var p) ? p : 0;
    int DoneCntOf(DateTime d) => doneMap.TryGetValue(d.Date, out var c) ? c : 0;

    // 이 달에 지난 날(오늘까지) · 그중 수행한 날
    int elapsed = 0, actedDays = 0;
    for (var day = monthStart; day <= monthEnd; day = day.AddDays(1))
    {
        if (day > today) { break; }
        elapsed++;
        if (PointOf(day) > 0) { actedDays++; }
    }
    if (elapsed == 0) { elapsed = (int)((monthEnd - monthStart).TotalDays) + 1; }

    // 미션별 : 합계 · 수행한 날 수 · 하루 배점
    int wordDays   = rows.Count(x => x.WordPoint   > 0);
    int quizDays   = rows.Count(x => x.QuizPoint   > 0);
    int prayDays   = rows.Count(x => x.PrayPoint   > 0);
    int reciteDays = rows.Count(x => x.RecitePoint > 0);

    var missions = new[]
    {
        new { No = "01", Name = "말씀", Sum = Model.SumWord,   Days = wordDays,   Per = 2 },
        new { No = "02", Name = "퀴즈", Sum = Model.SumQuiz,   Days = quizDays,   Per = 1 },
        new { No = "03", Name = "기도", Sum = Model.SumPray,   Days = prayDays,   Per = 2 },
        new { No = "04", Name = "암송", Sum = Model.SumRecite, Days = reciteDays, Per = 1 }
    };

    string U(int year, int month)
        => $"/DailyMission4/UserMonthlyPoints?userName={Uri.EscapeDataString(Model.UserName ?? "")}&year={year}&month={month}";

    string DayLink(DateTime d) => $"/DailyMission4?date={d:yyyy-MM-dd}";

    var prev = monthStart.AddMonths(-1);
    var next = monthStart.AddMonths(1);

    // 월 탭에서 '점수가 있는 달'을 진하게 하려면 그 달 데이터가 필요하다.
    // 여기서는 지금 보고 있는 달만 알 수 있으므로, 지난 달은 모두 같은 밝기로 둔다.
    var weekDayNames = new[] { "일", "월", "화", "수", "목", "금", "토" };
}

<link rel="stylesheet" href="/css/mission3/bone.css" asp-append-version="true">

<style>
    /* 월별 포인트 전용 — 공통 규칙은 /css/mission3/bone.css 에 있다. */

    /* ── 프로그램 안내 ── */
    .qz .mpPgm { padding: 2px 0 18px; border-bottom: 1px solid var(--rule); margin-bottom: 18px; }
    .qz .mpPgmK { font-size: 10px; font-weight: 600; letter-spacing: .26em; color: var(--acc); margin-bottom: 9px; }
    .qz .mpPgmT {
        font-family: "Noto Serif KR", serif; font-weight: 400;
        font-size: 20px; line-height: 1.45; letter-spacing: -.01em;
    }
    .qz .mpPgmS { font-size: 11.5px; color: var(--dim); line-height: 1.7; margin-top: 7px; }

    /* ── 월 제목 · 이동 ── */
    .qz .mpHead {
        display: flex; justify-content: space-between; align-items: flex-end; gap: 14px;
        padding-bottom: 18px; border-bottom: 1px solid var(--rule);
    }
    .qz .mpTitle { font-family: "Noto Serif KR", serif; font-weight: 400; font-size: 25px; line-height: 1.3; }
    .qz .mpSub { font-size: 11.5px; color: var(--dim); margin-top: 6px; letter-spacing: .02em; }
    .qz .mpNav { display: flex; gap: 2px; flex: 0 0 auto; }
    .qz .mpNav a {
        font-family: "Inter", sans-serif; font-size: 14px; font-weight: 200;
        color: var(--dim); text-decoration: none; padding: 0 8px;
    }
    .qz .mpNav a:hover { color: var(--acc); }

    /* ── 이달 총점 ── */
    .qz .mpTot {
        display: flex; justify-content: space-between; align-items: flex-end; gap: 14px;
        padding: 22px 0 20px; border-bottom: 1px solid var(--rule);
    }
    .qz .mpTotL { font-size: 9.5px; font-weight: 600; letter-spacing: .18em; color: var(--dim); margin-bottom: 9px; }
    .qz .mpTotN {
        font-family: "Inter", sans-serif; font-weight: 200; font-size: 48px; line-height: .9;
        letter-spacing: -.02em; font-variant-numeric: tabular-nums;
    }
    .qz .mpTotN u { text-decoration: none; font-size: 13px; font-weight: 400; color: var(--dim); margin-left: 3px; }
    .qz .mpTotR { text-align: right; flex: 0 0 auto; white-space: nowrap; }
    .qz .mpTotRV {
        font-family: "Inter", sans-serif; font-weight: 300; font-size: 18px;
        color: var(--acc); font-variant-numeric: tabular-nums;
    }

    /* ── 월 탭 1~12 ── */
    .qz .mpTabs { display: grid; grid-template-columns: repeat(12, 1fr); border-bottom: 1px solid var(--rule); }
    .qz .mpTabs a {
        text-align: center; padding: 12px 0 13px; text-decoration: none;
        font-family: "Inter", sans-serif; font-size: 11.5px; font-weight: 300;
        color: var(--dim); position: relative; font-variant-numeric: tabular-nums;
    }
    .qz .mpTabs a:hover { color: var(--tx); }
    .qz .mpTabs a.on { color: var(--tx); font-weight: 500; }
    .qz .mpTabs a.on::before {
        content: ""; position: absolute; top: -1px; left: 4px; right: 4px;
        height: 2px; background: var(--acc);
    }

    /* ── 달력 (미션 홈과 같은 규칙) ── */
    .qz .mpCal { margin-top: 22px; }
    .qz .mpCalG { display: grid; grid-template-columns: repeat(7, 1fr); }
    .qz .mpCalWd {
        font-size: 9px; font-weight: 600; letter-spacing: .1em;
        color: var(--dim); padding: 0 0 10px; text-align: center;
    }
    .qz .mpCalD {
        height: 46px; display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 4px; position: relative; text-decoration: none; border-top: 1px solid #EFEDE8;
    }
    .qz .mpCalN {
        font-family: "Inter", sans-serif; font-size: 12.5px; font-weight: 300;
        color: var(--dim2); font-variant-numeric: tabular-nums;
    }
    .qz .mpCalP {
        font-family: "Inter", sans-serif; font-size: 10px; font-weight: 500;
        color: var(--rule); font-variant-numeric: tabular-nums;
    }
    .qz .mpCalD.has .mpCalP { color: var(--acc); }
    .qz .mpCalD.full { background: var(--mark); }
    .qz .mpCalD.full .mpCalN { color: var(--tx); font-weight: 400; }
    .qz .mpCalD.mute .mpCalN { color: #D8D5CE; }
    .qz .mpCalD.today::before {
        content: ""; position: absolute; inset: 2px 4px;
        border: 1px solid var(--acc); pointer-events: none;
    }
    .qz .mpCalLeg {
        display: flex; gap: 16px; align-items: center; flex-wrap: wrap;
        margin-top: 13px; font-size: 10px; color: var(--dim); letter-spacing: .06em;
    }
    .qz .mpCalLeg span { display: flex; align-items: center; gap: 6px; }
    .qz .mpCalLeg i { width: 12px; height: 12px; display: block; border: 1px solid var(--rule); }

    /* ── 미션별 합계 (막대) ── */
    .qz .mpRow {
        display: flex; align-items: center; gap: 12px;
        padding: 13px 0; border-bottom: 1px solid var(--rule);
    }
    .qz .mpNo { font-family: "Inter", sans-serif; font-size: 11px; color: var(--dim); width: 18px; flex: 0 0 auto; }
    .qz .mpName { font-family: "Noto Serif KR", serif; font-size: 16px; width: 42px; flex: 0 0 auto; }
    .qz .mpBarWrap { flex: 1 1 auto; min-width: 0; }
    .qz .mpBar { height: 2px; background: var(--rule); }
    .qz .mpBar i { display: block; height: 2px; background: var(--acc); }
    .qz .mpMeta {
        display: flex; justify-content: space-between; gap: 8px;
        font-size: 10px; color: var(--dim); margin-top: 7px; letter-spacing: .04em;
    }
    .qz .mpV {
        font-family: "Inter", sans-serif; font-weight: 300; font-size: 19px;
        width: 54px; text-align: right; flex: 0 0 auto; font-variant-numeric: tabular-nums;
    }
    .qz .mpV u { text-decoration: none; font-size: 10px; color: var(--dim); margin-left: 2px; }

    @@media (max-width: 560px) {
        .qz .mpTotN { font-size: 40px; }
        .qz .mpTitle { font-size: 22px; }
        .qz .mpName { font-size: 15px; width: 36px; }
        .qz .mpV { font-size: 17px; width: 48px; }
        .qz .mpTabs a { font-size: 11px; }
    }
</style>

<div class="qz">
    <div class="qzBody">

        <div class="qzBar">
            <div>
                <a class="qzHome" href="/">@ConstatsCommon.ToHome</a><span class="qzHomeSep">·</span><a class="qzHome" href="/DailyMission4">미션홈</a>
            </div>
            <div class="qzDate">@(Model.UserName ?? "")</div>
        </div>
        <div class="qzProg"><i style="width:100%"></i></div>

        @* ── 프로그램 안내 ── *@
        <div class="mpPgm">
            <div class="mpPgmK">@ConstatsCommon.MainKeyTitle</div>
            <div class="mpPgmT">@ConstatsCommon.MainKeyTitle</div>
            <div class="mpPgmS">한 달 동안 쌓아 온 기록이에요</div>
        </div>

        @* ── 월 제목 · 이동 ── *@
        <div class="mpHead">
            <div>
                <div class="mpTitle">@monthStart.ToString("yyyy년 M월", new CultureInfo("ko-KR"))</div>
                <div class="mpSub">
                    @Model.FromDate.ToString("M월 d일", new CultureInfo("ko-KR"))
                    ~ @Model.ToDate.ToString("M월 d일", new CultureInfo("ko-KR"))
                </div>
            </div>
            <div class="mpNav">
                <a href="@U(prev.Year, prev.Month)" title="지난달">←</a>
                <a href="@U(next.Year, next.Month)" title="다음달">→</a>
            </div>
        </div>

        @* ── 이달 총점 ── *@
        <div class="mpTot">
            <div>
                <div class="mpTotL">이달 총점</div>
                <div class="mpTotN">@Model.SumTotal.ToString("N0")<u>점</u></div>
            </div>
            <div class="mpTotR">
                <div class="mpTotL">수행한 날</div>
                <div class="mpTotRV">@actedDays / @elapsed</div>
            </div>
        </div>

        @* ── 월 탭 ── *@
        <div class="mpTabs">
            @for (int m = 1; m <= 12; m++)
            {
                <a class="@(m == monthStart.Month ? "on" : "")" href="@U(monthStart.Year, m)">@m</a>
            }
        </div>

        @* ── 달력 ── *@
        <div class="mpCal">
            <div class="mpCalG">
                @foreach (var wd in weekDayNames)
                {
                    <div class="mpCalWd">@wd</div>
                }
                @for (int i = 0; i < totalCells; i++)
                {
                    var day     = gridStart.AddDays(i).Date;
                    var inMonth = (day.Month == monthStart.Month && day.Year == monthStart.Year);
                    var pt      = inMonth ? PointOf(day) : 0;
                    var full    = inMonth && DoneCntOf(day) >= 4;
                    var isToday = (day == today);

                    var cls = (inMonth ? "" : "mute ") + (pt > 0 ? "has " : "")
                            + (full ? "full " : "") + (isToday ? "today" : "");

                    if (inMonth)
                    {
                        <a class="mpCalD @cls" href="@DayLink(day)" title="@day.ToString("yyyy-MM-dd") 미션으로 이동">
                            <span class="mpCalN">@day.Day</span>
                            <span class="mpCalP">@(pt > 0 ? pt.ToString() : "–")</span>
                        </a>
                    }
                    else
                    {
                        <div class="mpCalD @cls">
                            <span class="mpCalN">@day.Day</span>
                            <span class="mpCalP">&nbsp;</span>
                        </div>
                    }
                }
            </div>
            <div class="mpCalLeg">
                <span><i style="border-color:var(--acc)"></i>오늘</span>
                <span><i style="background:var(--mark);border-color:var(--mark)"></i>네 가지 모두</span>
                <span style="color:var(--acc)">숫자 = 그날 점수</span>
            </div>
        </div>

        @* ── 미션별 합계 ── *@
        <div class="qzLabel" style="margin-top:28px">미션별 합계</div>
        @foreach (var m in missions)
        {
            int max = m.Per * elapsed;                       // 이 달에 받을 수 있었던 최대 점수
            int pct = max > 0 ? (int)Math.Round(m.Sum * 100.0 / max) : 0;
            if (pct > 100) { pct = 100; }

            <div class="mpRow">
                <span class="mpNo">@m.No</span>
                <span class="mpName">@m.Name</span>
                <span class="mpBarWrap">
                    <span class="mpBar"><i style="width:@(pct)%"></i></span>
                    <span class="mpMeta">
                        <span>@(m.Days)일 수행</span>
                        <span>최대 @(max)점</span>
                    </span>
                </span>
                <span class="mpV">@m.Sum<u>점</u></span>
            </div>
        }
    </div>
</div>
