@model BulletinBoard.Models.DailyMission2.DailyMission2DashboardVM
@using System
@using System.Globalization
@using BulletinBoard.Common;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http;
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@*  ══════════════════════════════════════════════════════════════
    말씀 미션 — DailyMission4 밝은 흰색 버전 (2026-10-03 시안 확정)
      제목 → 01 오늘 이야기(앞부분 + "이야기 더 보기") → 02 성경 읽기(글자 링크) → 03 어떻게 읽었나요?(위아래 두 줄)
    · 카드 · 테두리 없이 연한 회색 줄로만 나눈다.  강조색은 맑은 파랑 한 가지, 다 한 것은 초록.
    · "혼자 읽었어요" · "부모님께 읽어드렸어요" 각 1점 — 둘 중 하나만 해도 말씀 미션 완료 (WordDone = ToMe || ToParent)
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = "_Layout_Mission3";

    var d = Model.SelectedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var toast = (ViewBag.Toast ?? "").ToString();
    bool canAct = Model.IsActionable;

    ViewBag.DM2Page = "word";
    ViewBag.DM2Done = Model.DayStatus?.WordDone ?? false;

    var okPopupMsg = TempData["DM2_OK_POPUP"] as string;
}

@functions {
    string S(object v) => v == null ? "" : v.ToString();
}

@{
    var st = Model.DayStatus;
    bool doneToMe     = st?.Word_ToMe ?? false;
    bool doneToParent = st?.Word_ToParent ?? false;
    bool wordDone     = doneToMe || doneToParent;
    int  gotPoint     = (doneToMe ? 1 : 0) + (doneToParent ? 1 : 0);

    dynamic wordRow = ViewBag.TodayWordToReadRow;
    bool hasId = Model.Content?.TodayWordToReadId != null;

    var synopsis     = S(wordRow?.synopsis);
    var bibleSummary = S(wordRow?.BibleSummary);
    var storyText    = !string.IsNullOrWhiteSpace(synopsis) ? synopsis : bibleSummary;

    string bibleText = S(wordRow?.BibleText);
    string bibleRef  = wordRow == null ? "" : $"{bibleText} {SharedComm.MakeBibleSerialJangZul(wordRow?.BibleText, wordRow?.FromJang, wordRow?.FromZul, wordRow?.ToJang, wordRow?.ToZul)}".Trim();
    string fromJang  = S(wordRow?.FromJang);
    string readLabel = string.IsNullOrWhiteSpace(fromJang) ? $"{bibleText} 읽으러 가기" : $"{bibleText} {fromJang}장 읽으러 가기";
    string dateKo    = Model.SelectedDate.ToString("M월 d일 (ddd)", new CultureInfo("ko-KR"));
}

<link rel="stylesheet" href="/css/mission3/bone.css" asp-append-version="true">

<style>
    /* ── 밝은 흰색 버전 : 이 화면만 (공통 bone.css 위에 덮어쓴다) ── */
    body { background: #FFFFFF; }
    .qz.wd { --wBlue: #2F80ED; --wGreen: #16A34A; --wGreenD: #15803D; --wInk: #111827; --wTx: #374151; --wDim: #9CA3AF; --wDim2: #6B7280; --wLine: #EEF0F3; --wSoft: #F4F6F9;
             background: #FFFFFF; font-family: "Gothic A1", "Malgun Gothic", system-ui, sans-serif; }
    .qz.wd .qzBody { background: #FFFFFF; }
    .qz.wd .qzBar { border-bottom-color: var(--wLine); }
    .qz.wd .qzProg { display: none; }
    .qz.wd .qzLock { background: #F3F7FD; color: var(--wDim2); border: 0; }

    .qz.wd .wK { font-size: 12px; font-weight: 800; color: var(--wBlue); margin-top: 18px; letter-spacing: .02em; }
    .qz.wd .wTtl { display: flex; gap: 14px; align-items: flex-start; margin-top: 10px; }
    .qz.wd .wTtl h2 { margin: 0; font-size: 23px; font-weight: 800; line-height: 1.35; color: var(--wInk); letter-spacing: -.02em; word-break: keep-all; }
    .qz.wd .wRef { font-size: 13px; color: var(--wDim2); margin-top: 4px; }
    .qz.wd .wSt { font-size: 12.5px; color: var(--wDim2); margin-top: 6px; }
    .qz.wd .wSt b { color: var(--wGreen); font-weight: 800; }
    .qz.wd .wEmpty { margin-top: 26px; padding: 26px 0; text-align: center; color: var(--wDim2); font-size: 14px; border-top: 1px solid var(--wLine); border-bottom: 1px solid var(--wLine); }

    /* 01 · 02 · 03 세 칸 — 연한 회색 줄로만 나눈다 */
    /* 번호는 제목 줄에만 — 아래 내용은 번호 자리를 비우지 않고 왼쪽 끝부터 (2026-10-03) */
    .qz.wd .wSec { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 10px; align-items: baseline; padding: 18px 0 16px; border-top: 1px solid var(--wLine); }
    .qz.wd .wSec > div { display: contents; }
    .qz.wd .wSec > div > :not(.wH) { grid-column: 1 / -1; }
    /* 제목 줄(날짜 칩) 바로 아래 가로선은 여유 있게 띄운다 */
    .qz.wd .wTtl + .wSec { margin-top: 26px; }
    .qz.wd .wNo { font-weight: 900; font-size: 17px; color: #7FA3DB; letter-spacing: .02em; }
    .qz.wd .wSec.done .wNo { color: #6FBF8B; }
    .qz.wd .wH { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; font-size: 16px; font-weight: 800; color: var(--wInk); }
    .qz.wd .wH small { font-size: 11.5px; font-weight: 600; color: var(--wDim); white-space: nowrap; }
    .qz.wd .wSec.done .wH small { color: var(--wGreen); }

    .qz.wd .wStory { margin: 8px 0 0; font-size: 15.5px; line-height: 1.9; color: var(--wTx); word-break: keep-all; white-space: pre-line; }
    .qz.wd .wStory.clip { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .qz.wd .wMore { justify-self: start; text-align: left; margin-top: 4px; padding: 4px 0; border: 0; background: none; font: inherit; font-size: 12.5px; font-weight: 700; color: var(--wBlue); cursor: pointer; }

    .qz.wd a.wLnk { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-top: 10px; padding-bottom: 8px; border-bottom: 2px solid var(--wBlue);
                    color: var(--wBlue); font-size: 15.5px; font-weight: 800; text-decoration: none; -webkit-tap-highlight-color: transparent; }
    .qz.wd a.wLnk em { font-style: normal; font-size: 17px; }
    .qz.wd a.wLnk:active { opacity: .7; }

    /* 03 어떻게 읽었나요? — 위아래 두 줄, 한 줄 문장 */
    .qz.wd .wPick { display: grid; gap: 8px; margin-top: 10px; }
    .qz.wd .wPick form { margin: 0; }
    .qz.wd .wPk { width: 100%; display: flex; align-items: center; gap: 10px; padding: 13px 14px; border: 0; border-radius: 14px; background: #EAF7EF;
                  font: inherit; text-align: left; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: background .15s; }
    .qz.wd .wPk:active { background: #DDF1E4; }
    .qz.wd .wPk b { flex: 1; min-width: 0; font-size: 15.5px; font-weight: 800; color: #1F2937; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .qz.wd .wPk .pt { flex: none; font-size: 12.5px; font-weight: 800; color: var(--wBlue); white-space: nowrap; }
    .qz.wd .wPk.on { background: var(--wSoft); cursor: default; }
    .qz.wd .wPk.on b { color: var(--wDim2); }
    .qz.wd .wPk.on .pt { color: var(--wGreenD); }
    .qz.wd .wPk[disabled]:not(.on) { opacity: .5; cursor: default; }
    .qz.wd .wNote { margin-top: 8px; font-size: 12px; color: var(--wDim); text-align: center; }
    @@media (prefers-reduced-motion: reduce) { .qz.wd .wPk { transition: none; } }
</style>

<div class="qz wd">
    <div class="qzBody">

        <div class="qzBar">
            <div><a class="qzHome" href="/">@ConstatsCommon.ToHome</a><span class="qzHomeSep">·</span><a class="qzHome" href="/DailyMission4">미션홈</a></div>
            @await Html.PartialAsync("~/Views/DailyMission4/Partials/_FontSizeCtl.cshtml")
        </div>
        <div class="qzProg"><i style="width:100%"></i></div>

        @if (!canAct)
        {
            <div class="qzLock"><b>다른 날짜의 미션이에요</b><br>오늘 · 어제 · 그저께만 할 수 있어요</div>
        }
        @if (!string.IsNullOrWhiteSpace(toast))
        {
            <div class="qzLock">@toast</div>
        }

        <div class="wK">오늘의 말씀</div>

        @if (!hasId || wordRow == null)
        {
            <div class="wEmpty">이 날짜(@dateKo)에는 말씀이 없어요</div>
        }
        else
        {
            <div class="wTtl">
                @* 날짜 칩은 기존 디자인(검은 머리 2026.10 · 큰 숫자 · 파란 토요일) 그대로 *@
                @await Html.PartialAsync("~/Views/DailyMission4/Partials/_DateChip.cshtml", Model.SelectedDate)
                <div>
                    <h2>@S(wordRow?.BibleSubject)</h2>
                    <div class="wRef">@bibleRef</div>
                </div>
            </div>

            @* ── 01 오늘 이야기 ── *@
            @if (!string.IsNullOrWhiteSpace(storyText))
            {
                <div class="wSec @(wordDone ? "done" : "")">
                    <span class="wNo">01</span>
                    <div>
                        <div class="wH">오늘 이야기<small>@(wordDone ? "읽음" : "30초")</small></div>
                        <p class="wStory clip" id="wStory">@storyText</p>
                        <button type="button" class="wMore" id="wMore" aria-controls="wStory" aria-expanded="false">이야기 더 보기 ＋</button>
                    </div>
                </div>
            }

            @* ── 02 성경 읽기 ── *@
            <div class="wSec @(wordDone ? "done" : "")">
                <span class="wNo">02</span>
                <div>
                    <div class="wH">성경 읽기<small>@bibleRef</small></div>
                    <a class="wLnk" href="/DailyMission4/BibleRead?date=@d">@(wordDone ? readLabel.Replace("읽으러 가기", "다시 읽기") : readLabel)<em>→</em></a>
                </div>
            </div>

            @* ── 03 어떻게 읽었나요? — 각 1점, 하나만 해도 완료 ── *@
            <div class="wSec @(wordDone ? "done" : "")">
                <span class="wNo">03</span>
                <div>
                    <div class="wH">어떻게 읽었나요?<small>@(wordDone ? "눌렀어요" : "눌러서 알려 주세요")</small></div>
                    <div class="wPick">
                        <form method="post" action="/DailyMission4/SaveWord">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="date" value="@d" />
                            <input type="hidden" name="todayWordToReadId" value="@Model.Content.TodayWordToReadId.Value" />
                            <input type="hidden" name="toMe" value="true" />
                            <button type="submit" class="wPk @(doneToMe ? "on" : "")" @((canAct && !doneToMe) ? "" : "disabled")>
                                <b>혼자 읽었어요</b><span class="pt">@(doneToMe ? "✓ 완료 +1점" : "1점")</span>
                            </button>
                        </form>
                        <form method="post" action="/DailyMission4/SaveWord">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="date" value="@d" />
                            <input type="hidden" name="todayWordToReadId" value="@Model.Content.TodayWordToReadId.Value" />
                            <input type="hidden" name="toParent" value="true" />
                            <button type="submit" class="wPk @(doneToParent ? "on" : "")" @((canAct && !doneToParent) ? "" : "disabled")>
                                <b>부모님께 읽어드렸어요</b><span class="pt">@(doneToParent ? "✓ 완료 +1점" : "1점")</span>
                            </button>
                        </form>
                    </div>
                    @* 완료 뒤에는 안내 문구를 두지 않는다 — 누른 줄의 "✓ 완료 +1점"만 남긴다 *@
                    @if (!wordDone)
                    {
                        <div class="wNote">둘 중 하나만 눌러도 미션 완료예요 · 둘 다 하면 2점</div>
                    }
                </div>
            </div>

        }
    </div>

    @await Html.PartialAsync("~/Views/DailyMission4/Partials/_Dm2Nav.cshtml", Model)
</div>

@{
    var awardUrl = TempData["DM2_AWARD_URL"]?.ToString();
}
@await Html.PartialAsync("~/Views/DailyMission4/Partials/_OkPopup.cshtml", new { Message = okPopupMsg, AutoCloseSeconds = @ConstatsCommon.popupAutoCloseSeconds, RedirectUrl = awardUrl, RedirectLabel = "선물 선택" })

<script>
    (function () {
        // 오늘 이야기 — 앞부분(3줄)만 보여 주고 "이야기 더 보기"로 펼친다. 짧으면 버튼을 숨긴다.
        var p = document.getElementById('wStory'), b = document.getElementById('wMore');
        if (!p || !b) return;
        function fits() { return p.scrollHeight <= p.clientHeight + 2; }
        if (fits()) { b.hidden = true; p.classList.remove('clip'); return; }
        b.addEventListener('click', function () {
            var open = p.classList.toggle('clip') === false;
            b.textContent = open ? '이야기 접기 －' : '이야기 더 보기 ＋';
            b.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
    })();
</script>
