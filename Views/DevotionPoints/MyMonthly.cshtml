@using BulletinBoard.Models
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 + 아이 눈높이 (큰 글씨 · 큰 숫자)
    // 아이 본인 화면 — 지금까지 모은 점수 + 올해 12달 막대
    var backUrl = "/StudentPointDashboard4/Index"; // 학생 포인트 대시보드
    var now = DateHelper.GetKoreaNow();
    var myName = HttpContextAccessor.HttpContext?.Session.GetString(HttpContextSessionCategory.UserFullName.ToString());
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>내 감사 점수</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* DailyMission4 밝은 흰색 버전 + 아이 눈높이(큰 글씨 · 큰 숫자) — 색은 직접 지정한다 */
        * { box-sizing: border-box; }
        html, body { margin: 0; }
        body { background: #FFFFFF; color: #374151; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: inherit; text-decoration: none; }
        .sh { max-width: 720px; margin: 0 auto; padding: 0 20px; }

        .hdTop { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 0 10px; border-bottom: 1px solid #EEF0F3; font-size: 12px; color: #9CA3AF; }
        .hdTop a { color: #374151; }
        .hdTop a:hover { color: #2F80ED; }
        .hdK { margin-top: 18px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
        .who { margin-top: 6px; font-size: 16px; color: #6B7280; }
        .who b { color: #111827; font-weight: 800; font-size: 24px; letter-spacing: -.02em; margin-right: 4px; }
        .tot { margin-top: 14px; font-size: 14px; color: #9CA3AF; }
        .tot b { display: block; margin-top: 2px; font-weight: 300; font-size: 76px; line-height: 1.1; color: #2F80ED; font-variant-numeric: tabular-nums; }
        .tot b small { font-size: 22px; color: #9CA3AF; margin-left: 4px; }

        .sec { margin-top: 22px; padding-top: 16px; border-top: 1px solid #EEF0F3; }
        .sec h2 { margin: 0; font-size: 18px; font-weight: 800; color: #111827; }
        .sec p { margin: 4px 0 0; font-size: 14px; color: #9CA3AF; }
        .kb { display: grid; grid-template-columns: repeat(12, 1fr); gap: 5px; margin-top: 16px; }
        .kb div { display: flex; flex-direction: column; justify-content: flex-end; align-items: stretch; gap: 4px; height: 150px; }
        .kb em { font-style: normal; font-size: 12px; color: #6B7280; text-align: center; min-height: 14px; font-variant-numeric: tabular-nums; }
        .kb i { display: block; background: #CFE0FA; border-radius: 5px 5px 0 0; min-height: 3px; }
        .kb i.o { background: #EEF0F3; }
        .kb span { font-size: 12px; color: #9CA3AF; text-align: center; padding-top: 3px; border-top: 2px solid transparent; }
        .kb div.now i { background: #2F80ED; }
        .kb div.now em, .kb div.now span { color: #2F80ED; font-weight: 800; }
        .kb div.now span { border-top-color: #2F80ED; }
        .msg { margin-top: 22px; padding: 16px 18px; border-radius: 12px; background: #EAF2FD; font-size: 16px; line-height: 1.7; color: #2B5FA8; }
        .msg b { font-weight: 800; }
        .back { margin-top: 18px; padding: 15px; display: block; text-align: center; border-radius: 999px; background: #F4F6F9; font-size: 15px; font-weight: 700; color: #6B7280; }
        .back:hover { color: #2F80ED; }
        .wait { color: #9CA3AF; }
        .pft { margin-top: 20px; padding: 14px 0 40px; border-top: 1px solid #EEF0F3; font-size: 11.5px; color: #9CA3AF; }
    </style>
</head>
<body>
    <header class="sh">
        <div class="hdTop"><a href="@backUrl">‹ 내 포인트로</a><span>말씀과 일기노트</span></div>
        <div class="hdK">잠실새내 유년부 입니다.</div>
        <div class="who"><b>@(string.IsNullOrWhiteSpace(myName) ? "나" : myName)</b>의 감사 점수</div>
        <div class="tot">지금까지 모은 점수<b><span id="total">…</span><small>점</small></b></div>
    </header>

    <main class="sh">
        <section class="sec">
            <h2>@(now.Year)년 달마다 모은 점수</h2>
            <p>진한 파란 막대가 이번 달이에요.</p>
            <div class="kb" id="bars">
                @for (int m = 1; m <= 12; m++)
                {
                    <div class="@(m == now.Month ? "now" : "")"><em></em><i class="o"></i><span>@(m == 1 ? "1월" : m.ToString())</span></div>
                }
            </div>
        </section>
        <div class="msg" id="msg"><span class="wait">점수를 불러오고 있어요…</span></div>
        <a class="back" href="@backUrl">내 포인트 화면으로</a>
    </main>

<script>
(function () {
    const YEAR = '@now.Year', MONTH = @now.Month;
    const pad = m => String(m).padStart(2, '0');

    fetch('/DevotionPoints/MyTotal', { credentials: 'include' })
        .then(r => r.json())
        .then(j => { document.getElementById('total').textContent = (j && j.ok) ? (j.totalPoints ?? 0) : '0'; })
        .catch(() => { document.getElementById('total').textContent = '0'; });

    fetch('/DevotionPoints/MyMonthlyData?months=24', { credentials: 'include' })
        .then(r => r.json())
        .then(j => draw((j && j.ok) ? (j.rows || []) : []))
        .catch(() => draw([]));

    function draw(rows) {
        const by = {};
        rows.forEach(r => { by[r.ym ?? r.Ym] = Number(r.points ?? r.Points) || 0; });
        const pts = Array.from({ length: 12 }, (_, i) => by[`${YEAR}-${pad(i + 1)}`] || 0);
        const max = Math.max(1, ...pts);
        document.querySelectorAll('#bars > div').forEach((d, i) => {
            const future = i + 1 > MONTH;
            d.querySelector('em').textContent = future ? '' : pts[i];
            const bar = d.querySelector('i');
            bar.classList.toggle('o', future || pts[i] === 0);
            bar.style.height = (future || pts[i] === 0) ? '3px' : Math.max(4, Math.round(pts[i] / max * 124)) + 'px';
        });

        const cur = pts[MONTH - 1];
        const last = MONTH > 1 ? pts[MONTH - 2] : (by[`${Number(YEAR) - 1}-12`] || 0);
        let text;
        if (cur === 0) text = '이번 달은 아직 점수가 없어요.<br>말씀을 읽고 감사일기를 써 볼까요?';
        else if (cur > last) text = `이번 달 <b>${cur}점</b>을 모았어요.<br>지난달보다 <b>${cur - last}점</b> 더 많아요!`;
        else if (cur === last) text = `이번 달 <b>${cur}점</b>을 모았어요.<br>지난달만큼 잘하고 있어요!`;
        else text = `이번 달 <b>${cur}점</b>을 모았어요.<br>조금만 더 하면 지난달(${last}점)만큼 돼요!`;
        document.getElementById('msg').innerHTML = text;
    }
})();
</script>
</body>
</html>
