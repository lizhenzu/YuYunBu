@*
    포인트 아래 탭 — 입력 · 현황·순위  (DailyMission4 밝은 흰색 버전 — 색은 직접 지정한다)
    ViewData["PointTab"] : "entry" | "status"
    ViewData["PointYm"]  : 지금 보고 있는 달 (탭을 옮겨도 같은 달 유지)
*@
@{
    var tab = ViewData["PointTab"] as string ?? "";
    var ym = ViewData["PointYm"] as string ?? "";
    var q = string.IsNullOrEmpty(ym) ? "" : $"?ym={ym}";
}
<style>
    .ptTabs { position: fixed; left: 0; right: 0; bottom: 0; z-index: 900; background: #FFFFFF; border-top: 1px solid #EEF0F3; padding-bottom: env(safe-area-inset-bottom); }
    .ptTabs nav { max-width: 760px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; height: 54px; }
    .ptTabs a { position: relative; display: flex; align-items: center; justify-content: center; font-size: 13.5px; color: #9CA3AF; }
    .ptTabs a:hover { color: #2F80ED; }
    .ptTabs a.on { color: #2F80ED; font-weight: 800; }
    .ptTabs a.on::before { content: ""; position: absolute; top: -1px; left: 30%; right: 30%; height: 2px; border-radius: 999px; background: #2F80ED; }
    body { padding-bottom: calc(54px + env(safe-area-inset-bottom)); }
</style>
<div class="ptTabs">
    <nav aria-label="포인트 메뉴">
        <a href="/DevotionPoints/Home@(q)" class="@(tab == "entry" ? "on" : "")">입력</a>
        <a href="/DevotionPoints/Status@(q)" class="@(tab == "status" ? "on" : "")">현황·순위</a>
    </nav>
</div>
