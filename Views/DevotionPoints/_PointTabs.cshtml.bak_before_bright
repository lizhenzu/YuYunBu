@*
    포인트 아래 탭 — 입력 · 현황·순위
    ViewData["PointTab"] : "entry" | "status"
    ViewData["PointYm"]  : 지금 보고 있는 달 (탭을 옮겨도 같은 달 유지)
*@
@{
    var tab = ViewData["PointTab"] as string ?? "";
    var ym = ViewData["PointYm"] as string ?? "";
    var q = string.IsNullOrEmpty(ym) ? "" : $"?ym={ym}";
}
<style>
    .ptTabs { position: fixed; left: 0; right: 0; bottom: 0; z-index: 900; background: var(--card); border-top: 1px solid var(--rule); padding-bottom: env(safe-area-inset-bottom); }
    .ptTabs nav { max-width: 760px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; height: 58px; }
    .ptTabs a { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; font-size: 11px; color: var(--dim); }
    .ptTabs a i { font-style: normal; font-family: "Inter", sans-serif; font-weight: 200; font-size: 19px; line-height: 1; }
    .ptTabs a.on { color: var(--tx); font-weight: 600; }
    .ptTabs a.on::before { content: ""; position: absolute; top: -1px; left: 30%; right: 30%; height: 2px; background: var(--acc); }
    body { padding-bottom: calc(58px + env(safe-area-inset-bottom)); }
</style>
<div class="ptTabs">
    <nav aria-label="포인트 메뉴">
        <a href="/DevotionPoints/Home@(q)" class="@(tab == "entry" ? "on" : "")"><i>＋</i>입력</a>
        <a href="/DevotionPoints/Status@(q)" class="@(tab == "status" ? "on" : "")"><i>≡</i>현황·순위</a>
    </nav>
</div>
