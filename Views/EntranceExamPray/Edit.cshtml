@model BulletinBoard.Models.EntranceExamPrays.EntranceExamPray
@using BulletinBoard.Common
@{
    Layout = null;
    bool isNew = Model == null || Model.PrayId <= 0;
    var err = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>@(isNew ? "기도문 등록" : "기도문 수정") · 수험생을 위한 기도문</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* ── DailyMission4 밝은 흰색 버전 (2026-10-03 시안 확정) ── */
        *, *::before, *::after { box-sizing: border-box; }
        :root { --blue: #2F80ED; --soft: #EAF2FD; --ink: #111827; --tx: #374151; --dim: #9CA3AF; --dim2: #6B7280; --line: #EEF0F3; --grey: #F4F6F9; --red: #D9534F; }
        body { margin: 0; background: #FFFFFF; color: var(--tx); font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-text-size-adjust: 100%; }
        a { color: inherit; text-decoration: none; }
        .sh { max-width: 680px; margin: 0 auto; padding: 0 16px 40px; }

        .hdTop { display: flex; justify-content: space-between; align-items: center; padding: 14px 0 12px; border-bottom: 1px solid var(--line); font-size: 13px; color: var(--dim2); }
        .hdTop a { font-weight: 700; color: var(--tx); }
        .hdTop a:hover { color: var(--blue); }
        .hdTop .sep { margin: 0 6px; color: #D1D5DB; }
        .hdTop > span:last-child { color: var(--dim); }
        .hdK { margin-top: 20px; font-size: 12px; font-weight: 800; color: var(--blue); }
        .hdT { margin: 6px 0 0; font-size: 24px; font-weight: 800; letter-spacing: -.02em; color: var(--ink); }
        .hdS { margin-top: 4px; font-size: 13px; color: var(--dim2); line-height: 1.6; }

        .flash-err { margin-top: 16px; padding: 11px 14px; border-radius: 12px; background: #FDEEEE; color: var(--red); font-size: 13px; }

        .sec { margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--line); }
        .secT { font-size: 16px; font-weight: 800; color: var(--ink); }
        .secT small { margin-left: 4px; font-size: 11.5px; font-weight: 600; color: var(--dim); }
        .field { margin-top: 14px; }
        .field-row { display: grid; grid-template-columns: 1fr; gap: 0; }
        @@media (min-width: 560px) { .field-row { grid-template-columns: 1fr 1fr; gap: 0 14px; } }
        .field-lb { display: block; margin-bottom: 4px; font-size: 12px; color: var(--dim2); }
        .field-in, .field-ta { width: 100%; border: 0; border-radius: 12px; background: var(--grey); color: var(--ink); padding: 12px 13px; font: inherit; font-size: 14.5px; }
        .field-ta { min-height: 280px; line-height: 1.8; resize: vertical; }
        .field-in:focus, .field-ta:focus { outline: 0; background: #fff; box-shadow: inset 0 0 0 2px var(--blue); }
        .field-hint { margin-top: 5px; font-size: 11.5px; line-height: 1.7; color: var(--dim); }
        .field-hint b { color: var(--dim2); font-weight: 700; }

        .radio-row { display: flex; gap: 6px; flex-wrap: wrap; }
        .radio-opt { cursor: pointer; }
        .radio-opt input { position: absolute; opacity: 0; width: 0; height: 0; }
        .radio-opt span { display: inline-block; padding: 9px 15px; border-radius: 999px; background: var(--grey); color: var(--dim2); font-size: 13px; font-weight: 700; }
        .radio-opt input:checked + span { background: var(--blue); color: #fff; }
        .radio-opt input:focus-visible + span { box-shadow: 0 0 0 2px var(--soft), 0 0 0 4px var(--blue); }

        .btn-row { display: flex; gap: 8px; margin-top: 26px; }
        .btn { display: grid; place-items: center; height: 48px; border: 0; border-radius: 14px; background: var(--grey); color: var(--dim2); font: inherit; font-size: 15px; font-weight: 700; cursor: pointer; }
        .btn-main { flex: 1; background: var(--blue); color: #fff; font-weight: 800; }
        .btn-main:hover { background: #1F6FDB; }
        .btn-sub { width: 96px; }
        .del { display: block; margin-top: 14px; text-align: center; font-size: 13px; font-weight: 700; color: var(--red); }
    </style>
</head>
<body>

<div class="sh">

    <div class="hdTop">
        <span><a href="/EntranceExamPray/List">목록</a><span class="sep">›</span><a href="/EntranceExamPray/Index">오늘의 기도문</a></span>
        <span>관리자</span>
    </div>

    <div class="hdK">수험생을 위한 기도</div>
    <h1 class="hdT">@(isNew ? "새 기도문 등록" : "기도문 수정")</h1>
    <div class="hdS">
        @if (isNew) { <text>순서 번호가 작을수록 순환에서 먼저 나옵니다.</text> }
        else        { <text>조회수와 좋아요 수는 수정해도 그대로 유지됩니다.</text> }
    </div>

    @if (!string.IsNullOrEmpty(err)) { <div class="flash-err">@err</div> }

    <form method="post" action="/EntranceExamPray/Save">
        @Html.AntiForgeryToken()
        <input type="hidden" name="PrayId" value="@(Model?.PrayId ?? 0)" />

        <div class="sec">
            <div class="secT">기도문 내용</div>

            <div class="field">
                <label class="field-lb" for="Title">기도 제목</label>
                <input class="field-in" id="Title" name="Title" maxlength="200" required
                       value="@(Model?.Title ?? "")"
                       placeholder="예) 수능 전날 밤에" />
            </div>

            <div class="field">
                <label class="field-lb" for="PrayText">기도문</label>
                <textarea class="field-ta" id="PrayText" name="PrayText" required rows="20"
                          placeholder="기도문을 입력해 주세요. 줄바꿈은 그대로 표시됩니다.">@(Model?.PrayText ?? "")</textarea>
                <div class="field-hint">
                    줄바꿈이 화면에 그대로 나타납니다.
                    이름을 넣어 기도할 자리는 <b>**○○(이)**</b> 로 적으면 화면에서 강조로 표시됩니다.
                </div>
            </div>
        </div>

        <div class="sec">
            <div class="secT">성경 구절<small>(선택)</small></div>
            <div class="field">
                <label class="field-lb" for="BibleRef">구절 표기</label>
                <input class="field-in" id="BibleRef" name="BibleRef" maxlength="100"
                       value="@(Model?.BibleRef ?? "")" placeholder="예) 빌립보서 4:6" />
            </div>
            <div class="field">
                <label class="field-lb" for="BibleText">구절 본문</label>
                <input class="field-in" id="BibleText" name="BibleText" maxlength="1000"
                       value="@(Model?.BibleText ?? "")" placeholder="구절 내용을 입력해 주세요" />
            </div>
        </div>

        <div class="sec">
            <div class="secT">노출 설정</div>
            <div class="field-row">
                <div class="field">
                    <label class="field-lb" for="SortOrder">순서 번호</label>
                    <input class="field-in" id="SortOrder" name="SortOrder" type="number" min="0" step="1"
                           value="@(Model?.SortOrder ?? 0)" />
                    <div class="field-hint">작을수록 먼저 나옵니다.</div>
                </div>
                <div class="field">
                    <label class="field-lb">사용 여부</label>
                    <div class="radio-row">
                        <label class="radio-opt">
                            <input type="radio" name="UseYN" value="Y"
                                   checked="@(Model == null || !string.Equals(Model.UseYN, "N", StringComparison.OrdinalIgnoreCase))" />
                            <span>사용</span>
                        </label>
                        <label class="radio-opt">
                            <input type="radio" name="UseYN" value="N"
                                   checked="@(Model != null && string.Equals(Model.UseYN, "N", StringComparison.OrdinalIgnoreCase))" />
                            <span>숨김</span>
                        </label>
                    </div>
                    <div class="field-hint">숨김은 목록에서도 사라집니다.</div>
                </div>
            </div>

            @* 특정한 날에만 읽는 기도문은 매일 순환에서 빼 둡니다.
               목록에는 그대로 남아 필요한 날 직접 골라 읽습니다. *@
            <div class="field">
                <label class="field-lb">매일 순환</label>
                <div class="radio-row">
                    <label class="radio-opt">
                        <input type="radio" name="RotateYN" value="Y"
                               checked="@(Model == null || !string.Equals(Model.RotateYN, "N", StringComparison.OrdinalIgnoreCase))" />
                        <span>매일 순환에 포함</span>
                    </label>
                    <label class="radio-opt">
                        <input type="radio" name="RotateYN" value="N"
                               checked="@(Model != null && string.Equals(Model.RotateYN, "N", StringComparison.OrdinalIgnoreCase))" />
                        <span>그날에만 읽기</span>
                    </label>
                </div>
                <div class="field-hint">
                    “그날에만 읽기”는 오늘의 기도문으로 나오지 않습니다. 목록의 <b>그날에 읽는 기도문</b>에 모여
                    필요한 날 직접 골라 읽습니다. (예: 수능 날 아침에, 면접을 앞두고)
                </div>
            </div>
        </div>

        <div class="btn-row">
            <button type="submit" class="btn btn-main">@(isNew ? "등록하기" : "저장하기")</button>
            <a class="btn btn-sub" href="/EntranceExamPray/List">취소</a>
        </div>
        @if (!isNew)
        {
            <a class="del" href="/EntranceExamPray/Delete?PrayId=@Model.PrayId">삭제</a>
        }
    </form>

</div>

</body>
</html>
