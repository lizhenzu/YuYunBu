@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model IEnumerable<BulletinBoard.Models.ExerciseSummary>
@{
    Layout = null;
}
@{

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}


<!doctype html>
<html lang="ko" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>운동 목록 • 카드형 반응형</title>
    <style>
        :root {
            --bg: #0b0e14;
            --card: #101623;
            --muted: #94a3b8;
            --text: #e5e7eb;
            --accent: #60a5fa;
            --accent-2: #a78bfa;
            --ring: #1f2937;
            color-scheme: dark light;
        }

        [data-theme="light"] {
            --bg: #f7f8fa;
            --card: #ffffff;
            --muted: #6b7280;
            --text: #111827;
            --accent: #2563eb;
            --accent-2: #7c3aed;
            --ring: #e5e7eb;
        }

        * {
            box-sizing: border-box
        }

        html, body {
            height: 100%
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font: 16px/1.5 system-ui, -apple-system, Segoe UI, Roboto, Noto Sans, "Apple SD Gothic Neo", "맑은 고딕", Arial, sans-serif;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px 16px
        }

        header {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .title {
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -.2px
        }

        .search {
            display: flex;
            gap: 10px;
            align-items: center;
            width: 100%;
            max-width: 520px;
            background: var(--card);
            border: 1px solid var(--ring);
            border-radius: 12px;
            padding: 8px 12px;
        }

            .search input {
                flex: 1;
                border: 0;
                outline: none;
                background: transparent;
                color: inherit;
                font-size: 16px
            }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px,1fr));
            gap: 16px;
        }

        .card {
            background: var(--card);
            border: 1px solid var(--ring);
            border-radius: 5px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: transform .15s ease, box-shadow .2s ease, border-color .2s ease;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 24px rgba(0,0,0,.15);
                border-color: rgba(99,102,241,.35)
            }

        .thumb {
            position: relative;
            aspect-ratio: 16/10;
            background: linear-gradient(135deg, rgba(99,102,241,.2), rgba(96,165,250,.2));
            display: block;
        }
/*
            .thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
*/
            .thumb img {
                width: 100%;
                height: auto; /* 기존 height: 100% 제거 */
                object-fit: contain; /* cover → contain으로 변경 */
                display: block;
            }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            background: rgba(99,102,241,.1);
            color: var(--text);
            border: 1px solid var(--ring);
        }

            .badge .dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--accent);
            }

        .body {
            padding: 14px 14px 6px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .name {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: -.2px;
            margin: 0
        }

        .muted {
            color: var(--muted);
            font-size: 14px
        }

        .chips {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 2px
        }

        .chip {
            padding: 2px 8px;
            border-radius: 5px;
            border: 1px solid var(--ring);
            background: transparent;
            font-size: 12px;
            color: var(--muted)
        }

        .footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px 14px;
            gap: 10px
        }

        .btn {
            appearance: none;
            border: 1px solid var(--ring);
            background: transparent;
            color: var(--text);
            padding: 8px 12px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600
        }

            .btn.primary {
                background: linear-gradient(135deg, var(--accent), var(--accent-2));
                color: white;
                border: 0
            }

            .btn:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 2px
            }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0,0,0,0);
            border: 0
        }

        @@media (max-width:480px) {
            .title {
                font-size: 20px
            }
        }
    </style>

 <style>

        /* header를 상단 고정 + 반투명 배경으로 */
        header {
            position: sticky;
            top: 0;
            z-index: 50;
            /*background: color-mix(in srgb, var(--card) 90%, transparent);*/
            backdrop-filter: saturate(1.05) blur(6px);
/*            border-bottom: 1px solid var(--ring);
*/            padding-top: 10px; /* 상단 고정된 느낌을 위해 살짝 여백 */
            padding-bottom: 10px;
        }

        /* 검색 + 상단 홈 버튼 묶음 컨테이너 */
        .header-actions {
            display: flex;
            flex-direction: column; /* 세로 배치 */
            align-items: center; /* 가로 중앙 */
            gap: 10px;
            flex-wrap: wrap;
        }

        /* 상/하단 공용 고스트 버튼 */
        .btn-ghost {
            appearance: none;
            border: 1px solid var(--ring);
            background: transparent;
            color: var(--text);
            padding: 8px 12px;
            border-radius: 10px;
            font-weight: 700;
            text-decoration: none;
        }

            .btn-ghost:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 2px;
            }

        /* 푸터 스타일 */
        .site-footer {
            margin-top: 28px;
            border-top: 1px solid var(--ring);
            background: var(--card);
        }

        .footer-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .footer-text {
            color: var(--muted);
            font-size: 14px;
        }


 </style>
</head>
<body>
    <div class="container">
        <header>
            <div class="title">맨손 무산소 운동</div>
            <label class="search" aria-label="운동 검색">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" /></svg>
                <input id="q" type="search" placeholder="운동명 검색 (예: 스쿼트)" />
            </label>
        </header>

        <div style="text-align:center; margin:20px 0;">
            <a asp-controller="Home" asp-action="Index" class="btn-ghost" aria-label="홈으로 가기">홈으로 가기</a>
        </div>


        <section class="grid" id="cards">
            <!-- Card: Squat -->
            @{
                var index = 1; // 순차 번호 시작
            }
            @if (Model != null && Model.Any())
            {
                foreach (var x in Model)
                {
                    <article class="card"
                             data-search="@($"{x.ExerciseId} {x.Name} {(x.NameEn ?? "").Replace("_", " ")} {(x.IsAnaerobic ? "무산소" : "유산소")} 난이도:{x.Difficulty} {x.Description} {x.PrescriptionNotes}")">

                        <a class="thumb" asp-controller="Exercise" asp-action="Detail" asp-route-id="@x.ExerciseId" aria-label="스쿼트 상세 보기">
                            <img src="/images/Health/TypeA/@(@x.NameEn).png" alt="스쿼트 이미지" loading="lazy" onerror="this.parentElement.style.background='linear-gradient(135deg,#e5e7eb,#cbd5e1)'; this.remove();" />
                        </a>
                        <div class="body">
                            <h3 class="name">@index. @x.Name <span class="muted">(@x.NameEn.Replace("_"," "))</span></h3>
                            <p class="muted">@x.Description</p>
                            <div class="chips">
                                <span class="chip">난이도: @x.Difficulty</span>
                                <span class="chip">유형: @(x.IsAnaerobic ? "무산소" : "유산소")</span>
                                <span class="chip">가이드: @x.PrescriptionNotes</span>
                            </div>
                        </div>
@*                        <div class="footer">
                            <span class="badge"><span class="dot"></span> 추천 12분</span>
                            <a class="btn primary" href="#">자세 보기</a>
                        </div>
*@                    </article>
                    index++; // 다음 번호
                }
            }
        </section>

    </div>

    <script>
        function filterCards(q) {
            const tokens = (q || '').toLowerCase().trim().split(/\s+/).filter(Boolean);
            const cards = document.querySelectorAll('#cards .card');

            if (tokens.length === 0) {
                cards.forEach(c => c.style.display = '');
                return;
            }

            cards.forEach(c => {
                const hay = (c.getAttribute('data-search') || c.textContent || '').toLowerCase();
                const visible = tokens.every(t => hay.includes(t));
                c.style.display = visible ? '' : 'none';
            });
        }

        // 안전하게 이벤트 연결 (부분 렌더링/스코프 이슈 방지)
        document.addEventListener('DOMContentLoaded', function () {
            const q = document.getElementById('q');
            if (q) q.addEventListener('input', e => filterCards(e.target.value));
        });
    </script>


    <script>
        // 다크모드 자동 토글 (선호도 따라)
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
//        document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', 'light');
    </script>
    <div style="text-align:center; margin:5px 0;">
        <a asp-controller="Home" asp-action="Index" class="btn-ghost" aria-label="홈으로 가기">홈으로 가기</a>
    </div>

    <footer class="site-footer" style="text-align:center;">
        <div class="footer-inner" style="text-align:center;">
            <span class="footer-text">© @DateHelper.GetKoreaNow().Year @ChurchName · @DepartmentName</span>
        </div>
    </footer>
</body>
</html>
`