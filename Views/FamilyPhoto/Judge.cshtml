@model BulletinBoard.Models.FamilyPhoto.FamilyPhotoAdminVM
@using BulletinBoard.Common
@using BulletinBoard.Helpers
@using BulletinBoard.Models.FamilyPhoto
@using J = BulletinBoard.Models.FamilyPhoto.FamilyPhotoJudging

@*  AI 리뷰 보드 — 2026-10-06 시안 확정.  예전 "결과 보기"(Result) + "AI 심사평"(시상식)을 하나로 합쳤다.
    · 점수 · 등수 · 시상대 · 근소한 차이는 화면에서 모두 뺐다 — 참여 위주
    · 사진마다 AI 칭찬 한마디(FamilyPhotoJudging.Praise) + 별명 배지 하나 (그 사진이 가장 빛난 항목 — 점수는 배지 고르는 데만 쓴다)
    · ❤️ 좋아요 수는 남긴다 · 스티커 🥰😂👍🙏 (사진마다 기기 하나에 하나, 다시 누르면 뗀다) — 표는 SQL/FamilyPhotoSticker_20261006.sql
    · 관리자가 아니면 숨긴 사진 · 숨긴 가족은 보이지 않는다
    · 이전 화면은 Judge.cshtml.bak_before_reviewboard *@

@{
    Layout = null;
    string ib = ViewBag.ImgBase as string ?? "";
    bool isStaff = ViewBag.IsStaff == true;
    var stk = ViewBag.Stickers as FamilyPhotoStickerVM ?? new FamilyPhotoStickerVM();

    // ── 카카오톡 · 메신저 공유 미리보기 (Open Graph) ──
    string ogDomain = (ViewBag.Domain as string ?? "https://www.jamsilkids.com").TrimEnd('/');
    string ogUrl    = ViewBag.FullURL as string ?? $"{ogDomain}/FamilyPhoto/Judge";
    // 2026-10-07 L안 "손글씨 칭찬 쪽지" (민트).  이전: family-photo-review.png (A안 리뷰 카드) · family-photo-judge.png (점수표) — 파일은 그대로 둔다.
    //   이미지를 바꾸면 v 를 올린다 (카톡 캐시)
    string ogImage  = $"{ogDomain}/images/og/family-photo-review-note.png?v=2026100701";
    string ogTitle  = "우리 가족 사진 · AI 리뷰 보드";
    string ogDesc   = "AI가 사진 한 장 한 장에 따뜻한 리뷰를 남겼어요. 마음에 드는 사진에 스티커를 붙여 주세요!";

    // PhotoId → (사진, 가족)  — 관리자가 아니면 숨긴 것은 뺀다
    var photoMap = new Dictionary<int, (FamilyPhotoPhotoVM P, FamilyPhotoEntryVM E)>();
    foreach (var e in Model.Entries)
    {
        if (e.IsHidden && !isStaff) continue;
        foreach (var p in e.Photos)
        {
            if (p.IsHidden && !isStaff) continue;
            photoMap[p.PhotoId] = (p, e);
        }
    }
    var reviews = J.Scores.Where(s => photoMap.ContainsKey(s.PhotoId)).OrderBy(s => s.No).ToList();
    int pending = photoMap.Keys.Count(id => !J.Scores.Any(s => s.PhotoId == id));
    var families = reviews.Select(s => photoMap[s.PhotoId].E).GroupBy(e => e.EntryId).Select(g => g.First().FamilyName)
                          .OrderBy(n => n, StringComparer.Create(new System.Globalization.CultureInfo("ko-KR"), false)).ToList();

    // 별명 배지 — 항목마다 (점수 / 만점) 비율이 가장 큰 것 하나
    var badges = new[] {
        (Key: "tg", Emoji: "🤝", Title: "꼭 붙어 있는 가족",  C1: "#5B8DEF", C2: "#8FB3F5"),
        (Key: "cs", Emoji: "🌕", Title: "추석 그 자체",       C1: "#E3A23A", C2: "#F3C772"),
        (Key: "fc", Emoji: "😆", Title: "웃음 폭발",          C1: "#EC6A84", C2: "#F5A3B4"),
        (Key: "st", Emoji: "📖", Title: "이야기가 있는 한 장", C1: "#4E9A78", C2: "#86C3A5"),
        (Key: "cr", Emoji: "📸", Title: "작품 같은 한 장",     C1: "#7C6FD8", C2: "#AFA6EC"),
    };
    //   만점 비율로만 고르면 한 배지에 몰려서, "전체 사진 평균보다 얼마나 더 높은가"로 고른다 — 그 사진이 남달리 빛난 항목
    double[] Vals(FamilyPhotoJudgeScore s) => new double[] { s.Together, s.Chuseok, s.Face, s.Story, s.Craft };
    var avg = Enumerable.Range(0, 5).Select(i => J.Scores.Count == 0 ? 1 : Math.Max(0.1, J.Scores.Average(x => Vals(x)[i]))).ToArray();
    //   그래도 한쪽에 몰리지 않게 배지마다 정원(사진 수 / 5 + 1)을 두고, 남달리 빛난 정도가 큰 짝부터 차례로 나눈다
    var badgeOf = new Dictionary<int, int>();
    int cap = reviews.Count / badges.Length + 1;
    var used = new int[badges.Length];
    foreach (var pair in reviews.SelectMany(s => Enumerable.Range(0, badges.Length).Select(i => (s.No, I: i, R: Vals(s)[i] / avg[i])))
                                .OrderByDescending(x => x.R).ThenBy(x => x.No).ThenBy(x => x.I))
    {
        if (badgeOf.ContainsKey(pair.No) || used[pair.I] >= cap) continue;
        badgeOf[pair.No] = pair.I; used[pair.I]++;
    }
    int[] Cnt(int photoId) => stk.Counts.TryGetValue(photoId, out var a) ? a : new int[FamilyPhotoStickerVM.Emojis.Length];
    int MineOf(int photoId) => stk.Mine.TryGetValue(photoId, out var k) ? k : -1;
    string Th(FamilyPhotoPhotoVM p) => ib + (string.IsNullOrEmpty(p.ThumbPath) ? p.FilePath : p.ThumbPath);
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex" />
<title>@ogTitle</title>
<meta name="description" content="@ogDesc" />
<meta property="og:type"        content="website" />
<meta property="og:site_name"   content="잠실새내교회 유년부" />
<meta property="og:title"       content="@ogTitle" />
<meta property="og:description" content="@ogDesc" />
<meta property="og:url"         content="@ogUrl" />
<meta property="og:image"       content="@ogImage" />
<meta property="og:image:secure_url" content="@ogImage" />
<meta property="og:image:type"  content="image/png" />
<meta property="og:image:width"  content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt"   content="@ogTitle" />
<meta property="og:locale"      content="ko_KR" />
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content="@ogTitle" />
<meta name="twitter:description" content="@ogDesc" />
<meta name="twitter:image"       content="@ogImage" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800&family=Jua&family=Gowun+Batang:wght@400;700&display=swap" />
<style>
    /* 2026-10-07 민트로 (홈 카드 · 카톡 이미지와 같은 색).  이전 파랑 · 노랑은 Judge.cshtml.bak_before_mint
       --blue · --moon 이름은 그대로 두고 값만 민트로 바꿨다 */
    :root { --bg: #F3F8F6; --paper: #FFFFFF; --ink: #111827; --tx: #374151; --dim: #5B7A70; --line: #DCEEE7;
            --blue: #12A883; --soft: #E9F8F2; --moon: #14B88F; --moonbg: #F2FBF8; --moontx: #0E9F7E; --heart: #F0506E; }
    body { background: linear-gradient(180deg, #E6F7F0 0, var(--bg) 360px) no-repeat, var(--bg); }
    * { box-sizing: border-box; }
    html, body { margin: 0; }
    body { background: var(--bg); color: var(--tx); font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-text-size-adjust: 100%; -webkit-font-smoothing: antialiased; }
    a { color: inherit; }
    button { font: inherit; }
    .rb { max-width: 560px; margin: 0 auto; padding: 14px 16px 40px; }
    .back { display: inline-block; font-size: 13px; font-weight: 700; color: #374151; text-decoration: none; }

    .hd { text-align: center; padding: 14px 0 4px; }
    .bot { flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--moon); display: grid; place-items: center;
           font-family: "Jua", sans-serif; font-size: 13px; color: #FFFFFF; box-shadow: 0 0 0 3px #D5F3E9; }
    .hd .bot { margin: 0 auto; width: 52px; height: 52px; font-size: 18px; }
    .hd h1 { margin: 10px 0 0; font-size: 22px; font-weight: 800; color: var(--ink); text-wrap: balance; }
    .hd p { margin: 5px 0 0; font-size: 13.5px; color: var(--dim); line-height: 1.6; word-break: keep-all; }

    .tally { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px; }
    .tally div { background: var(--paper); border: 1px solid var(--line); border-radius: 8px; padding: 10px 4px; text-align: center; font-size: 12px; color: var(--dim); }
    .tally b { display: block; font-size: 20px; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
    .msg { margin-top: 12px; padding: 10px 12px; border-radius: 8px; background: var(--moonbg); font-size: 12.5px; line-height: 1.6; color: var(--moontx); }

    .chips { display: flex; gap: 6px; margin: 16px -16px 0; padding: 0 16px; overflow-x: auto; scrollbar-width: none; }
    .chips::-webkit-scrollbar { display: none; }
    .chips button { flex: none; border: 1px solid var(--line); background: var(--paper); color: var(--tx); border-radius: 999px; padding: 7px 12px; font-size: 13px; font-weight: 700; cursor: pointer; }
    .chips button.on { background: var(--blue); border-color: var(--blue); color: #fff; }

    .feed { display: grid; gap: 12px; margin-top: 12px; }
    .rv { background: var(--paper); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
    .rv[hidden] { display: none; }
    .pic { position: relative; display: block; aspect-ratio: 4 / 3; background: #EEF1F5; overflow: hidden; }
    .pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
    .badge { position: absolute; left: 10px; top: 10px; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,.95); color: var(--ink);
             font-size: 12.5px; font-weight: 800; box-shadow: 0 1px 4px rgba(0,0,0,.14); }
    .like { position: absolute; right: 10px; top: 10px; padding: 4px 9px; border-radius: 999px; background: rgba(255,255,255,.95); color: var(--heart); font-size: 12.5px; font-weight: 800; }
    .hid { position: absolute; left: 10px; bottom: 10px; padding: 3px 8px; border-radius: 999px; background: #B4531F; color: #fff; font-size: 11px; font-weight: 800; }
    .in { padding: 12px 14px 14px; }
    .fam { font-size: 12.5px; color: var(--dim); } .fam b { color: var(--ink); font-weight: 800; }
    .cap { font-size: 12.5px; color: var(--dim); margin-top: 2px; word-break: keep-all; }
    .bub { display: flex; gap: 10px; align-items: flex-start; margin-top: 10px; }
    .bub .bot { width: 28px; height: 28px; font-size: 11px; }
    .say { flex: 1; min-width: 0; background: var(--moonbg); border: 1px solid #D5EFE6; border-radius: 4px 14px 14px 14px; padding: 10px 12px; }
    .say p { margin: 0; font-family: "Gowun Batang", serif; font-size: 15px; line-height: 1.7; color: var(--ink); word-break: keep-all; }
    .stk { display: flex; gap: 6px; margin-top: 12px; }
    .stk button { flex: 1; display: flex; align-items: center; justify-content: center; gap: 4px; border: 1px solid var(--line); background: var(--paper);
                  border-radius: 999px; padding: 7px 0; font-size: 16px; cursor: pointer; transition: transform .12s; -webkit-tap-highlight-color: transparent; }
    .stk button span { font-size: 12.5px; font-weight: 800; color: var(--dim); font-variant-numeric: tabular-nums; }
    .stk button.me { background: var(--soft); border-color: #9EDCC6; } .stk button.me span { color: var(--blue); }
    .stk button:active { transform: scale(.92); }
    .stk button:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
    .stk.busy button { opacity: .6; }
    .staff { margin-top: 10px; padding: 8px 10px; border-radius: 8px; background: #FBF1EC; border-left: 3px solid #B4531F; font-size: 12px; line-height: 1.6; color: #5C5550; word-break: keep-all; }
    .staff b { color: #B4531F; }
    .pop { position: absolute; z-index: 9999; pointer-events: none; font-size: 22px; animation: rbUp .7s ease-out forwards; }
    @@keyframes rbUp { to { transform: translateY(-40px) scale(1.3); opacity: 0; } }
    .toast { position: fixed; left: 50%; bottom: calc(20px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); z-index: 9999; background: #111827; color: #fff;
             font-size: 13px; padding: 9px 14px; border-radius: 999px; opacity: 0; transition: opacity .2s; pointer-events: none; white-space: nowrap; }
    .toast.on { opacity: 1; }

    .thanks { margin-top: 18px; padding: 16px 14px; border-radius: 8px; background: var(--paper); border: 1px dashed #D1D5DB; text-align: center; font-size: 13.5px; line-height: 1.7; color: var(--dim); }
    .thanks b { color: var(--ink); }
    .fams { display: flex; justify-content: center; gap: 4px; flex-wrap: wrap; margin-top: 8px; }
    .fams span { padding: 3px 9px; border-radius: 999px; background: var(--bg); font-size: 12px; font-weight: 700; color: var(--tx); }
    .foot { margin-top: 24px; display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; font-size: 13px; }
    .foot a { color: #374151; text-decoration: none; font-weight: 700; }
    .foot a:hover { color: var(--blue); }
    @@media (prefers-reduced-motion: reduce) { .pop { animation: none; display: none; } .stk button { transition: none; } }
</style>
</head>
<body>
<form id="rbAf" style="display:none">@Html.AntiForgeryToken()</form>

<div class="rb">
    <a class="back" href="/">← @ConstatsCommon.ToHome</a>

    <header class="hd">
        <div class="bot">AI</div>
        <h1>우리 가족 사진 리뷰 보드</h1>
        <p>AI가 @(reviews.Count)장을 한 장씩 보고 칭찬을 남겼어요.<br />마음에 드는 사진에 스티커를 붙여 주세요!</p>
    </header>

    <div class="tally">
        <div><b>@families.Count</b>가족 참여</div>
        <div><b>@reviews.Count</b>장 리뷰</div>
        <div><b id="rbTotal">@stk.Total.ToString("N0")</b>스티커</div>
    </div>

    @if (pending > 0)
    {
        <div class="msg">AI가 아직 보지 못한 새 사진이 @(pending)장 있어요. 리뷰를 남긴 사진만 보여요.</div>
    }

    <div class="chips" id="rbChips" role="tablist" aria-label="별명 배지로 모아 보기">
        <button type="button" class="on" data-f="all">전체 @reviews.Count</button>
        @for (int b = 0; b < badges.Length; b++)
        {
            int c = badgeOf.Values.Count(v => v == b);
            if (c == 0) { continue; }
            <button type="button" data-f="@badges[b].Key">@badges[b].Emoji @badges[b].Title @c</button>
        }
    </div>

    <div class="feed" id="rbFeed">
        @foreach (var s in reviews)
        {
            var ph = photoMap[s.PhotoId];
            var bd = badges[badgeOf[s.No]];
            var cnt = Cnt(s.PhotoId);
            int mine = MineOf(s.PhotoId);
            <article class="rv" id="p@(s.No)" data-b="@bd.Key">
                <a class="pic" href="@(ib + ph.P.FilePath)" target="_blank" rel="noopener" aria-label="@(s.No)번 사진 크게 보기"
                   style="background:linear-gradient(135deg,@bd.C1,@bd.C2)">
                    <img src="@Th(ph.P)" alt="@ph.E.FamilyName 가족 사진" loading="lazy" decoding="async" onerror="this.remove()" />
                    <span class="badge">@bd.Emoji @bd.Title</span>
                    @if (ph.P.LikeCount > 0) { <span class="like">❤️ @ph.P.LikeCount.ToString("N0")</span> }
                    @if (isStaff && (ph.P.IsHidden || ph.E.IsHidden)) { <span class="hid">숨긴 사진 · 관리자만 보임</span> }
                </a>
                <div class="in">
                    <div class="fam"><b>@ph.E.FamilyName</b> · No.@s.No</div>
                    @if (!string.IsNullOrWhiteSpace(ph.P.Caption)) { <div class="cap">“@ph.P.Caption”</div> }
                    <div class="bub">
                        <div class="bot" aria-hidden="true">AI</div>
                        <div class="say"><p>@s.Praise</p></div>
                    </div>
                    @if (stk.Available)
                    {
                        <div class="stk" data-pid="@s.PhotoId" role="group" aria-label="스티커 붙이기">
                            @for (int k = 0; k < FamilyPhotoStickerVM.Emojis.Length; k++)
                            {
                                <button type="button" data-k="@k" class="@(mine == k ? "me" : "")" aria-pressed="@(mine == k ? "true" : "false")">@FamilyPhotoStickerVM.Emojis[k]<span>@cnt[k]</span></button>
                            }
                        </div>
                    }
                    @if (isStaff && !string.IsNullOrWhiteSpace(s.StaffNote))
                    {
                        <div class="staff"><b>관리자 참고</b> · @s.StaffNote</div>
                    }
                </div>
            </article>
        }
    </div>

    <div class="thanks">
        <b>함께해 주신 모든 가족, 고마워요 🙏</b><br />사진 한 장 한 장이 유년부의 추석이 되었어요.
        <div class="fams">
            @foreach (var f in families) { <span>@f</span> }
        </div>
    </div>

    <div class="foot">
        @if (isStaff) { <a href="/FamilyPhoto/Admin">관리 화면 →</a> }
        <a href="/FamilyPhoto">사진 갤러리 →</a>
        <a href="/">@ConstatsCommon.ToHome →</a>
    </div>
</div>
<div class="toast" id="rbToast" role="status" aria-live="polite"></div>

<script>
    (function () {
        var emojis = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(FamilyPhotoStickerVM.Emojis));
        var token = document.querySelector('#rbAf input[name="__RequestVerificationToken"]');
        var toastEl = document.getElementById('rbToast'), toastT = null;
        function toast(t) { toastEl.textContent = t; toastEl.classList.add('on'); clearTimeout(toastT); toastT = setTimeout(function () { toastEl.classList.remove('on'); }, 1600); }

        // 배지로 모아 보기
        var chips = document.getElementById('rbChips');
        chips.addEventListener('click', function (e) {
            var b = e.target.closest('button'); if (!b) return;
            chips.querySelectorAll('button').forEach(function (x) { x.classList.toggle('on', x === b); });
            var f = b.getAttribute('data-f');
            document.querySelectorAll('#rbFeed .rv').forEach(function (r) { r.hidden = !(f === 'all' || r.getAttribute('data-b') === f); });
        });

        // 스티커
        function total() {
            var t = 0; document.querySelectorAll('.stk button span').forEach(function (s) { t += parseInt(s.textContent, 10) || 0; });
            document.getElementById('rbTotal').textContent = t.toLocaleString();
        }
        function pop(btn, k) {
            var r = btn.getBoundingClientRect(), s = document.createElement('span');
            s.className = 'pop'; s.textContent = emojis[k];
            s.style.left = (r.left + r.width / 2 - 11 + window.scrollX) + 'px'; s.style.top = (r.top - 6 + window.scrollY) + 'px';
            document.body.appendChild(s); setTimeout(function () { s.remove(); }, 700);
        }
        document.getElementById('rbFeed').addEventListener('click', function (e) {
            var btn = e.target.closest('.stk button'); if (!btn) return;
            var box = btn.closest('.stk'); if (box.classList.contains('busy')) return;
            var k = parseInt(btn.getAttribute('data-k'), 10);
            box.classList.add('busy');
            var fd = new FormData(); fd.append('photoId', box.getAttribute('data-pid')); fd.append('kind', k);
            if (token) fd.append('__RequestVerificationToken', token.value);
            fetch('/FamilyPhoto/Sticker', { method: 'POST', body: fd, credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (j) {
                    if (j.counts) box.querySelectorAll('button').forEach(function (b, i) { b.querySelector('span').textContent = j.counts[i] || 0; });
                    if (!j.ok) { toast(j.msg || '잠시 후 다시 눌러 주세요.'); return; }
                    box.querySelectorAll('button').forEach(function (b, i) { b.classList.toggle('me', i === j.mine); b.setAttribute('aria-pressed', i === j.mine ? 'true' : 'false'); });
                    if (j.mine >= 0) pop(btn, j.mine);
                    total();
                })
                .catch(function () { toast('잠시 후 다시 눌러 주세요.'); })
                .finally(function () { box.classList.remove('busy'); });
        });

        // 주소 끝이 #p17 이면 그 사진으로
        var m = /^#p(\d+)$/.exec(location.hash);
        if (m) { var el = document.getElementById('p' + m[1]); if (el) el.scrollIntoView({ block: 'start' }); }
    })();
</script>
</body>
</html>
