@model BulletinBoard.Models.FamilyPhoto.FamilyPhotoAdminVM
@using BulletinBoard.Common
@using BulletinBoard.Helpers
@using BulletinBoard.Models.FamilyPhoto
@using J = BulletinBoard.Models.FamilyPhoto.FamilyPhotoJudging

@*  AI 심사위원 평가 — 사진 한 장씩 (가족 단위 아님).  2026-09-30 B안 "추석 밤 시상식" 디자인.
    점수 · 칭찬은 Models/FamilyPhoto/FamilyPhotoJudging.cs.  사진 · 가족명 · 캡션은 DB 에서 PhotoId 로 잇는다. *@

@{
    Layout = null;
    string ib = ViewBag.ImgBase as string ?? "";   // 사진 주소 앞머리 (보통 빈 값)
    bool isStaff = ViewBag.IsStaff == true;         // 관리자 참고 메모 · 관리 링크는 관리자에게만

    // ── 카카오톡 · 메신저 공유 미리보기 (Open Graph) — 2026-09-30 C안 "심사표" 이미지 ──
    string ogDomain = (ViewBag.Domain as string ?? "https://www.jamsilkids.com").TrimEnd('/');
    string ogUrl    = ViewBag.FullURL as string ?? $"{ogDomain}/FamilyPhoto/Judge";
    string ogImage  = $"{ogDomain}/images/og/family-photo-judge.png?v=2026093001";   // 이미지를 바꾸면 v 를 올린다 (카톡 캐시)
    string ogTitle  = "우리 가족 사진 콘테스트 · AI 심사평";
    string ogDesc   = "AI 심사위원이 사진 한 장씩 점수와 따뜻한 칭찬을 남겼어요";

    // PhotoId → (사진, 가족)
    var photoMap = new Dictionary<int, (FamilyPhotoPhotoVM P, FamilyPhotoEntryVM E)>();
    foreach (var e in Model.Entries)
        foreach (var p in e.Photos)
            photoMap[p.PhotoId] = (p, e);

    var allJudged = J.Scores.Where(s => photoMap.ContainsKey(s.PhotoId)).OrderBy(s => s.No).ToList();
    // 교사 가족 (2026-10-01) — 순위 · 시상대 · 대상에는 넣지 않고, 부문상(추석분위기 · 웃음 · 아이디어)만 받을 수 있다.
    var scores   = allJudged.Where(s => !J.ExcludedEntryIds.Contains(photoMap[s.PhotoId].E.EntryId)).ToList();   // 순위에 오르는 사진
    var excluded = allJudged.Where(s =>  J.ExcludedEntryIds.Contains(photoMap[s.PhotoId].E.EntryId)).ToList();   // 교사 가족 사진

    // 좋아요 점수 (20점) — 순위에 오르는 사진 중 가장 많이 받은 사진 기준 비례 (교사 사진은 기준에 넣지 않고, 20점을 넘지 않게).
    //   화면을 열 때마다 지금 좋아요 수로 다시 계산
    int maxLikes = scores.Count == 0 ? 0 : scores.Max(s => photoMap[s.PhotoId].P.LikeCount);
    var likesOf = allJudged.ToDictionary(s => s.No, s => photoMap[s.PhotoId].P.LikeCount);
    var likePtOf = allJudged.ToDictionary(s => s.No, s => Math.Min(J.MaxLike, J.LikePoints(likesOf[s.No], maxLikes)));
    var totalOf = allJudged.ToDictionary(s => s.No, s => Math.Round(s.JudgeTotal + likePtOf[s.No], 1));
    string N1(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    // 순위 — 가족 단위 (2026-09-30) : 가족마다 점수가 가장 높은 사진 한 장만 순위에 오른다.
    //   같은 가족의 나머지 사진은 점수만 보이고 순위 · 시상대에는 오르지 않는다 (extraNos).
    //   같은 점수는 같은 등수.  바로 위 사진과 2점 이내면 "근소한 차이"
    var byScore = scores.OrderByDescending(s => totalOf[s.No]).ThenBy(s => s.No).ToList();
    var seenFam = new HashSet<int>();
    var ranked  = byScore.Where(s => seenFam.Add(photoMap[s.PhotoId].E.EntryId)).ToList();
    var extraNos = byScore.Select(s => s.No).Except(ranked.Select(s => s.No)).ToHashSet();
    var rankOf = new Dictionary<int, int>();
    var nearOf = new Dictionary<int, string>();
    for (int i = 0; i < ranked.Count; i++)
    {
        var s = ranked[i];
        rankOf[s.No] = (i > 0 && totalOf[ranked[i - 1].No] == totalOf[s.No]) ? rankOf[ranked[i - 1].No] : i + 1;
        if (i > 0)
        {
            double gap = totalOf[ranked[i - 1].No] - totalOf[s.No];
            if (gap == 0) nearOf[s.No] = "동점";
            else if (gap <= J.NearGap) nearOf[s.No] = "근소한 차이";
        }
    }
    // 부문 추천 — 한 가족은 한 번만.  시상대(1·2·3등)에 오른 가족은 부문 상에서 빠진다.
    //   대상 = 1등.  나머지 상은 시상대에 없는 가족(교사 가족 포함) 중에서 그 항목 점수가 가장 높은 사진.
    var awards = new List<FamilyPhotoJudgeAward>();
    var awardedEntries = ranked.Take(3).Select(s => photoMap[s.PhotoId].E.EntryId).ToHashSet();
    foreach (var def in J.Awards)
    {
        if (def.Key == "total")
        {
            if (ranked.Count > 0)
                awards.Add(def with { No = ranked[0].No, Reason = $"심사 점수와 좋아요를 더한 합산 점수가 가장 높아요. {ranked[0].Praise}" });
            continue;
        }
        Func<FamilyPhotoJudgeScore, double> key = def.Key switch
        {
            "chuseok" => s => s.Chuseok,
            "face"    => s => s.Face,
            "story"   => s => s.Story,
            _         => s => totalOf[s.No],
        };
        int max = def.Key switch { "chuseok" => J.MaxChuseok, "face" => J.MaxFace, "story" => J.MaxStory, _ => 100 };
        var pick = allJudged.Where(s => !awardedEntries.Contains(photoMap[s.PhotoId].E.EntryId))
                         .OrderByDescending(key).ThenByDescending(s => totalOf[s.No]).ThenBy(s => s.No)
                         .FirstOrDefault();
        if (pick == null) continue;
        awardedEntries.Add(photoMap[pick.PhotoId].E.EntryId);
        string reason = def.Key == "total"
            ? $"심사 점수와 좋아요를 더한 합산 점수가 가장 높아요. {pick.Praise}"
            : $"{def.Label} {N1(key(pick))}/{max}점 · {pick.Praise}";
        awards.Add(def with { No = pick.No, Reason = reason });
    }
    var awardOf = awards.GroupBy(a => a.No).ToDictionary(g => g.Key, g => g.ToList());

    // 아직 심사하지 않은 사진 (새로 올라온 것)
    var judgedIds = J.Scores.Select(s => s.PhotoId).ToHashSet();
    int pending = photoMap.Keys.Count(id => !judgedIds.Contains(id));

    string Pct(int v, int max) => (v * 100.0 / max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
    string PctD(double v, int max) => (v * 100.0 / max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex" />
<title>@ogTitle</title>
<meta name="description" content="@ogDesc" />
@* ── 카카오톡 · 메신저 공유 미리보기 ── *@
<meta property="og:type"        content="website" />
<meta property="og:site_name"   content="잠실새내교회 유년부" />
<meta property="og:title"       content="@ogTitle" />
<meta property="og:description" content="@ogDesc" />
<meta property="og:url"         content="@ogUrl" />
<meta property="og:image"       content="@ogImage" />
<meta property="og:image:secure_url" content="@ogImage" />
<meta property="og:image:type"  content="image/png" />
<meta property="og:image:width"  content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt"   content="@ogTitle" />
<meta property="og:locale"      content="ko_KR" />
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content="@ogTitle" />
<meta name="twitter:description" content="@ogDesc" />
<meta name="twitter:image"       content="@ogImage" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Gothic+A1:wght@400;600;800&family=Jua&display=swap" />
<style>
    /* ══════════════════════════════════════════════════════════════
       B안 "추석 밤 시상식" (2026-09-30 확정)
       남색 밤하늘 머리 + 보름달 · 1·2·3등 시상대 · 부문 상 3칸 · 사진 두 줄 격자 → 누르면 심사평 펼침
       ══════════════════════════════════════════════════════════════ */
    :root {
        --bg: #F7F3EC; --ink: #2A2320; --dim: #7A6E66; --line: #E6DED2; --paper: #FFFFFF;
        --night: #1F2547; --night2: #34305E; --moon: #F6C84B; --moonTx: #8A5A10;
        --navy: #2F3A56; --rose: #D9486A; --heart: #F0506E;
        --c1: #2F6FA8; --c2: #C9822E; --c3: #D9486A; --c4: #5B7F6A; --c5: #7C8594; --c6: #F0506E;
        --f-disp: "Jua", "Gothic A1", sans-serif;
        --f-serif: "Gowun Batang", "Noto Serif KR", serif;
        --f-body: "Gothic A1", "Malgun Gothic", system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; }
    body { background: var(--bg); color: var(--ink); font-family: var(--f-body); -webkit-text-size-adjust: 100%; }
    a { color: inherit; }
    .jb { max-width: 760px; margin: 0 auto; }

    /* ── 머리 : 추석 밤 ── */
    .sky { position: relative; overflow: hidden; color: #fff; text-align: center; padding: 22px 16px 0;
           background: linear-gradient(180deg, var(--night) 0%, var(--night2) 100%); }
    .sky .stars { position: absolute; inset: 0; pointer-events: none;
        background-image: radial-gradient(2px 2px at 12% 18%, #FFF3C4 50%, transparent 51%), radial-gradient(1.5px 1.5px at 30% 8%, #FFF3C4 50%, transparent 51%),
                          radial-gradient(2px 2px at 78% 14%, #FFF3C4 50%, transparent 51%), radial-gradient(1.5px 1.5px at 90% 38%, #FFF3C4 50%, transparent 51%),
                          radial-gradient(1.5px 1.5px at 8% 52%, #FFF3C4 50%, transparent 51%), radial-gradient(2px 2px at 62% 30%, #FFF3C4 50%, transparent 51%); opacity: .8; }
    .sky .bar { position: relative; display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #C9C6E4; }
    .sky .bar a { text-decoration: none; color: #C9C6E4; }
    .moon { position: relative; width: 96px; height: 96px; border-radius: 50%; margin: 14px auto 0; display: grid; place-items: center;
            background: radial-gradient(circle at 42% 38%, #FFF6CF, var(--moon)); box-shadow: 0 0 44px rgba(246,200,75,.45);
            font-family: var(--f-disp); color: var(--moonTx); font-size: 19px; line-height: 1.1; }
    .kick { position: relative; font-size: 10.5px; letter-spacing: .24em; color: var(--moon); margin-top: 14px; }
    .sky h1 { position: relative; font-family: var(--f-serif); font-weight: 700; font-size: 27px; margin: 6px 0 0; text-wrap: balance; }
    .sky .sum { position: relative; font-size: 11.5px; color: #C9C6E4; margin-top: 7px; line-height: 1.6; }
    .crit { position: relative; display: flex; flex-wrap: wrap; justify-content: center; gap: 5px; margin-top: 10px; }
    .crit span { font-size: 10.5px; padding: 3px 9px; border-radius: 999px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18); color: #E7E5F5; white-space: nowrap; }
    .crit span.h { color: #FFC2CF; border-color: rgba(240,80,110,.5); }

    /* ── 시상대 ── */
    .pod { position: relative; display: grid; grid-template-columns: 1fr 1.2fr 1fr; align-items: end; gap: 8px; margin: 22px auto 0; max-width: 460px; }
    .pod button { all: unset; cursor: pointer; display: block; text-align: center; -webkit-tap-highlight-color: transparent; }
    .pod button:focus-visible .av { outline: 3px solid #fff; outline-offset: 3px; }
    .pod .av { position: relative; width: 78%; aspect-ratio: 1; margin: 0 auto; border-radius: 50%; border: 3px solid #fff; overflow: hidden; background: rgba(255,255,255,.12); }
    .pod .av img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pod .g .av { width: 90%; border-color: var(--moon); box-shadow: 0 0 0 5px rgba(246,200,75,.28); }
    .pod button { position: relative; }
    .pod .crown { position: absolute; left: 50%; top: -24px; transform: translateX(-50%) rotate(-8deg); font-size: 26px; z-index: 1; filter: drop-shadow(0 2px 3px rgba(0,0,0,.3)); }
    .pod .n { color: #fff; font-size: 11px; margin-top: 6px; line-height: 1.3; }
    .pod .n b { display: block; font-family: var(--f-disp); font-weight: 400; font-size: 20px; }
    .pod .n i { font-style: normal; color: #C9C6E4; }
    .pod .st { margin-top: 8px; border-radius: 10px 10px 0 0; font-family: var(--f-disp); font-size: 24px; display: grid; place-items: center; }
    .pod .g .st { height: 74px; background: linear-gradient(#F6C84B, #D9A22B); color: #6B4A08; }
    .pod .s .st { height: 54px; background: linear-gradient(#DCE1EA, #AEB6C4); color: #3C4454; }
    .pod .b .st { height: 40px; background: linear-gradient(#E9B48A, #C58A5E); color: #5A3418; }

    .main { padding: 0 14px 30px; }

    /* ── 부문 상 3칸 ── */
    .aw { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px; }
    .aw button { all: unset; cursor: pointer; background: var(--paper); border-radius: 14px; padding: 10px 6px 11px; text-align: center; box-shadow: 0 4px 14px rgba(31,37,71,.1); }
    .aw button:focus-visible { outline: 3px solid var(--navy); }
    .aw .th { width: 54px; height: 54px; border-radius: 50%; overflow: hidden; margin: 0 auto; position: relative; background: #EFE9DF; }
    .aw .th img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .aw .e { position: absolute; right: -2px; bottom: -2px; font-size: 18px; }
    .aw .t { font-family: var(--f-disp); font-size: 14px; margin-top: 6px; }
    .aw .s { font-size: 10.5px; color: var(--dim); margin-top: 2px; }

    .sec { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin: 24px 2px 10px; }
    .sec h2 { font-family: var(--f-serif); font-weight: 700; font-size: 17px; margin: 0; }
    .sec small { font-size: 10.5px; color: var(--dim); }
    .msg { margin-top: 14px; padding: 10px 12px; border-radius: 10px; background: #FFF6DC; font-size: 12px; line-height: 1.6; }

    /* ── 사진 격자 ── */
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    @@media (min-width: 640px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .cd { all: unset; cursor: pointer; display: block; background: var(--paper); border-radius: 16px; overflow: hidden; box-shadow: 0 2px 10px rgba(0,0,0,.06); -webkit-tap-highlight-color: transparent; }
    .cd:focus-visible { outline: 3px solid var(--navy); outline-offset: 2px; }
    .cd .th { position: relative; aspect-ratio: 1; background: #EFE9DF; }
    .cd .th img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .rkb { position: absolute; left: 7px; top: 7px; background: rgba(31,37,71,.86); color: #fff; font-family: var(--f-disp); font-size: 13px; border-radius: 999px; padding: 2px 9px; }
    .rkb.top { background: var(--moon); color: #6B4A08; }
    .awb { position: absolute; right: 6px; top: 6px; display: flex; gap: 2px; font-size: 17px; filter: drop-shadow(0 1px 2px rgba(0,0,0,.3)); }
    .cd .in { padding: 9px 10px 11px; }
    .cd .sc { display: flex; justify-content: space-between; align-items: baseline; }
    .cd .sc b { font-family: var(--f-disp); font-weight: 400; font-size: 23px; color: var(--navy); }
    .cd .sc b small { font-family: var(--f-body); font-size: 10px; color: var(--dim); margin-left: 2px; }
    .cd .sc span { font-size: 11px; color: var(--heart); white-space: nowrap; }
    .ring { display: flex; gap: 3px; margin-top: 5px; }
    .ring i { flex: 1; height: 5px; border-radius: 3px; }
    .cd .nm { font-size: 10.5px; color: var(--dim); margin-top: 7px; }
    .near { font-size: 9.5px; color: var(--rose); background: #FCE8EC; border-radius: 999px; padding: 1px 6px; margin-left: 4px; white-space: nowrap; }
    .cd p { margin: 5px 0 0; font-size: 11.5px; line-height: 1.55; color: #4A4540; word-break: keep-all;
            display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    /* 작은 사진 오는 동안 반짝이는 자리 */
    .sh { background: linear-gradient(100deg, #EFE9DF 30%, #F9F6F0 50%, #EFE9DF 70%) 0 0 / 200% 100%; animation: jbShim 1.4s linear infinite; }
    .sh.ok { animation: none; }
    img.fade { opacity: 0; transition: opacity .3s ease; }
    img.fade.ok { opacity: 1; }
    @@keyframes jbShim { from { background-position: 100% 0; } to { background-position: -100% 0; } }

    /* ── 평가 제외 ── */
    .exl { background: var(--paper); border-radius: 14px; border: 1px dashed var(--line); }
    .ex { display: flex; gap: 10px; padding: 9px 10px; border-bottom: 1px dashed var(--line); }
    .ex:last-child { border-bottom: 0; }
    .ex .th { width: 54px; height: 54px; flex: none; border-radius: 10px; overflow: hidden; }
    .ex .th img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ex .n { font-size: 11px; color: var(--dim); }
    .ex .p { font-size: 12px; color: #4A4540; line-height: 1.55; margin-top: 2px; word-break: keep-all; }

    .foot { margin-top: 28px; padding-top: 14px; border-top: 1px solid var(--line); display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; font-size: 11.5px; }
    .foot a { color: var(--dim); text-decoration: none; }
    .foot a:hover { color: var(--rose); }

    /* ── 펼친 심사평 (아래에서 올라오는 판) ── */
    .mask { position: fixed; inset: 0; z-index: 9000; background: rgba(20,22,40,.72); display: none; align-items: flex-end; justify-content: center; }
    .mask.on { display: flex; }
    .sheet { position: relative; width: 100%; max-width: 560px; max-height: 94vh; overflow-y: auto; background: var(--paper); border-radius: 20px 20px 0 0;
             padding-bottom: env(safe-area-inset-bottom, 0px); animation: jbUp .28s cubic-bezier(.2,.9,.3,1); overscroll-behavior: contain; }
    @@media (min-width: 640px) { .mask { align-items: center; } .sheet { border-radius: 20px; max-height: 90vh; } }
    @@keyframes jbUp { from { transform: translateY(40px); opacity: .4; } to { transform: none; opacity: 1; } }
    .sheet .top { position: sticky; top: 0; z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 10px 12px; background: var(--navy); color: #fff; }
    .sheet .top b { font-family: var(--f-disp); font-weight: 400; font-size: 18px; }
    .sheet .top span { font-size: 11px; color: #D5D8E6; }
    .sheet .top .x { all: unset; cursor: pointer; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; font-size: 18px; background: rgba(255,255,255,.14); }
    .pic { position: relative; background: #EFE9DF; display: flex; justify-content: center; min-height: 0; }
    .pic img { display: block; max-width: 100%; max-height: 62vh; object-fit: contain; transition: opacity .35s ease; }
    .pic.ld { min-height: 280px; }
    .pic.ld img { opacity: 0; }
    .ldr { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; pointer-events: none; font-size: 11.5px; color: var(--dim); }
    .pic:not(.ld):not(.err) .ldr { display: none; }
    .ldr i { width: 36px; height: 36px; border-radius: 50%; border: 3px solid #E2DCCF; border-top-color: var(--navy); border-right-color: var(--heart); animation: jbSpin .85s linear infinite; }
    .pic.err { min-height: 160px; }
    .pic.err .ldr i { display: none; }
    @@keyframes jbSpin { to { transform: rotate(360deg); } }
    .sheet .bd { padding: 14px 16px 18px; }
    .sheet .awl { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 8px; }
    .sheet .awl span { font-size: 11px; font-weight: 800; padding: 3px 9px; border-radius: 999px; background: #FFF4D6; color: #8A6317; border: 1px solid #F1DFA8; }
    .q { font-family: var(--f-serif); font-size: 15.5px; line-height: 1.75; word-break: keep-all; }
    .q::before { content: "“"; color: var(--rose); font-size: 28px; line-height: 0; vertical-align: -10px; margin-right: 2px; }
    .who { font-size: 11px; color: var(--dim); margin-top: 8px; line-height: 1.6; word-break: keep-all; }
    .tot { display: flex; align-items: baseline; gap: 8px; margin-top: 14px; }
    .tot b { font-family: var(--f-disp); font-weight: 400; font-size: 40px; color: var(--navy); line-height: 1; }
    .tot span { font-size: 11.5px; color: var(--dim); }
    .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 10px; }
    .tiles div { background: var(--bg); border-radius: 12px; padding: 8px 6px 7px; text-align: center; font-size: 10.5px; color: var(--dim); }
    .tiles b { display: block; font-family: var(--f-disp); font-weight: 400; font-size: 19px; color: var(--ink); }
    .tiles u { display: block; height: 4px; border-radius: 2px; background: #E6DED2; margin-top: 5px; overflow: hidden; text-decoration: none; }
    .tiles u i { display: block; height: 100%; }
    .tiles .hh b { color: var(--heart); }
    .staff { margin-top: 12px; padding: 9px 11px; border-radius: 10px; background: #FBF1EC; border-left: 3px solid #B4531F; font-size: 11.5px; line-height: 1.6; color: #5C5550; word-break: keep-all; }
    .staff b { color: #B4531F; }
    .nav { display: flex; gap: 8px; margin-top: 16px; }
    .nav button { all: unset; cursor: pointer; flex: 1; text-align: center; padding: 11px 0; border-radius: 12px; font-size: 12.5px; font-weight: 800; background: var(--bg); color: var(--navy); }
    .nav button:focus-visible { outline: 3px solid var(--navy); }
    .nav button[disabled] { opacity: .35; cursor: default; }
    .det { display: none; }

    @@media (prefers-reduced-motion: reduce) {
        .sh, .ldr i, .sheet { animation: none; }
        img.fade, .pic img { transition: none; }
    }
</style>
</head>
<body>

@{
    string Th(FamilyPhotoPhotoVM p) => ib + (string.IsNullOrEmpty(p.ThumbPath) ? p.FilePath : p.ThumbPath);
    string Ring(FamilyPhotoJudgeScore s, int i, double v, int max, string color)
        => $"background:linear-gradient(90deg,{color} {PctD(v, max)},#E8E2D8 {PctD(v, max)})";
    var podium = ranked.Take(3).ToList();
    var sideAwards = awards.Where(a => a.Key != "total").ToList();
}

<div class="jb">
    <header class="sky">
        <div class="stars"></div>
        <div class="bar">
            <a href="/FamilyPhoto">← 가족 사진</a>
            <span>@J.JudgedAt.Replace("-", ".")</span>
        </div>
        <div class="moon">AI<br />심사평</div>
        <div class="kick">CHUSEOK FAMILY PHOTO</div>
        <h1>우리 가족 사진 시상식</h1>
        <div class="sum">사진 @(allJudged.Count)장 · 심사 80 + ❤️ 좋아요 20 · 교사 가족 사진은 부문상만</div>
        <div class="crit">
            <span>함께함 @J.MaxTogether</span><span>추석 분위기 @J.MaxChuseok</span><span>아이 표정 @J.MaxFace</span><span>이야기 @J.MaxStory</span><span>완성도 @J.MaxCraft</span><span class="h">❤️ 좋아요 @J.MaxLike</span>
        </div>

        @if (podium.Count > 0)
        {
            <div class="pod">
                @foreach (var (s, cls) in new[] { (podium.ElementAtOrDefault(1), "s"), (podium.ElementAtOrDefault(0), "g"), (podium.ElementAtOrDefault(2), "b") })
                {
                    if (s == null) { <div></div> continue; }
                    var ph = photoMap[s.PhotoId];
                    <button type="button" class="@cls" data-open="@s.No" aria-label="@(rankOf[s.No])위 No.@(s.No) 심사평 보기">
                        @if (cls == "g") { <span class="crown" aria-hidden="true">👑</span> }
                        <div class="av sh">
                            <img class="fade" src="@Th(ph.P)" alt="" loading="lazy" decoding="async" />
                        </div>
                        <div class="n"><b>@N1(totalOf[s.No])</b>No.@s.No <i>@ph.E.FamilyName</i></div>
                        <div class="st">@rankOf[s.No]</div>
                    </button>
                }
            </div>
        }
    </header>

    <main class="main">
        @if (sideAwards.Count > 0)
        {
            <div class="aw">
                @foreach (var a in sideAwards)
                {
                    var s = allJudged.First(x => x.No == a.No);
                    var ph = photoMap[s.PhotoId];
                    <button type="button" data-open="@a.No" aria-label="@a.Title No.@a.No 심사평 보기">
                        <div class="th sh"><img class="fade" src="@Th(ph.P)" alt="" loading="lazy" decoding="async" /></div>
                        <div class="t">@a.Emoji @a.Title</div>
                        <div class="s">No.@a.No · @ph.E.FamilyName</div>
                    </button>
                }
            </div>
        }

        @if (pending > 0)
        {
            <div class="msg">아직 심사하지 않은 새 사진이 @(pending)장 있어요. 심사를 마친 사진만 보여요.</div>
        }

        @foreach (var grp in new[] {
            (Title: "가족 순위", Sub: "가족마다 가장 높은 사진 한 장 · 누르면 심사평이 펼쳐져요", List: ranked),
            (Title: "함께 올린 사진", Sub: "같은 가족의 다른 사진 · 순위에는 오르지 않아요", List: byScore.Where(x => extraNos.Contains(x.No)).ToList()),
            (Title: "교사 가족 사진", Sub: "순위에는 오르지 않고 부문상만 받을 수 있어요", List: excluded.OrderByDescending(x => totalOf[x.No]).ThenBy(x => x.No).ToList()) })
        {
        if (grp.List.Count == 0) { continue; }
        <div class="sec"><h2>@grp.Title</h2><small>@grp.Sub</small></div>
        <div class="grid">
            @foreach (var s in grp.List)
            {
                var ph = photoMap[s.PhotoId];
                int r = rankOf.TryGetValue(s.No, out var rr) ? rr : 0;   // 0 = 같은 가족의 다른 사진 (순위 없음)
                bool teacher = J.ExcludedEntryIds.Contains(ph.E.EntryId);
                string rLabel = r > 0 ? $"{r}위" : teacher ? "교사 가족 · 순위 제외" : "함께 올린 사진";
                awardOf.TryGetValue(s.No, out var myAwards);
                <button type="button" class="cd" id="p@(s.No)" data-open="@s.No" aria-label="@rLabel No.@(s.No) 심사평 보기">
                    <div class="th sh">
                        <img class="fade" src="@Th(ph.P)" alt="@(s.No)번 사진" loading="lazy" decoding="async" />
                        @if (r > 0) { <span class="rkb @(r <= 3 ? "top" : "")">@(r)위</span> }
                        @if (myAwards != null) { <span class="awb">@foreach (var a in myAwards) { <span>@a.Emoji</span> }</span> }
                    </div>
                    <div class="in">
                        <div class="sc"><b>@N1(totalOf[s.No])<small>점</small></b><span>❤️ @likesOf[s.No]</span></div>
                        <div class="ring">
                            <i style="@Ring(s, 1, s.Together, J.MaxTogether, "var(--c1)")"></i>
                            <i style="@Ring(s, 2, s.Chuseok, J.MaxChuseok, "var(--c2)")"></i>
                            <i style="@Ring(s, 3, s.Face, J.MaxFace, "var(--c3)")"></i>
                            <i style="@Ring(s, 4, s.Story, J.MaxStory, "var(--c4)")"></i>
                            <i style="@Ring(s, 5, s.Craft, J.MaxCraft, "var(--c5)")"></i>
                            <i style="@Ring(s, 6, likePtOf[s.No], J.MaxLike, "var(--c6)")"></i>
                        </div>
                        <div class="nm">No.@s.No · @ph.E.FamilyName @if (nearOf.TryGetValue(s.No, out var nr)) { <span class="near">@nr</span> }</div>
                        <p>@s.Praise</p>
                    </div>
                </button>

                @* 펼친 심사평에 들어갈 내용 — 판을 열 때 복사해서 쓴다 *@
                <div class="det" id="d@(s.No)" data-title="No.@s.No" data-sub="@rLabel@(nearOf.TryGetValue(s.No, out var nr3) ? " · " + nr3 : "")">
                    <div class="pic ld">
                        <div class="ldr" aria-hidden="true"><i></i><span>사진을 불러오는 중이에요…</span></div>
                        <a href="@(ib + ph.P.FilePath)" target="_blank" rel="noopener"><img data-src="@(ib + ph.P.FilePath)" alt="@(s.No)번 사진" /></a>
                    </div>
                    <div class="bd">
                        @if (myAwards != null) { <div class="awl">@foreach (var a in myAwards) { <span>@a.Emoji @a.Title</span> }</div> }
                        <div class="q">@s.Praise</div>
                        <div class="who">
                            @ph.E.FamilyName · @(ph.P.Slot)번째 사진
                            @if (!string.IsNullOrWhiteSpace(ph.P.Caption)) { <br /><span>“@ph.P.Caption”</span> }
                        </div>
                        <div class="tot"><b>@N1(totalOf[s.No])</b><span>/ 100점 · 심사 @s.JudgeTotal + 좋아요 @N1(likePtOf[s.No])</span></div>
                        <div class="tiles">
                            <div><b>@s.Together</b>함께함 /@J.MaxTogether<u><i style="width:@Pct(s.Together, J.MaxTogether);background:var(--c1)"></i></u></div>
                            <div><b>@s.Chuseok</b>추석 /@J.MaxChuseok<u><i style="width:@Pct(s.Chuseok, J.MaxChuseok);background:var(--c2)"></i></u></div>
                            <div><b>@s.Face</b>표정 /@J.MaxFace<u><i style="width:@Pct(s.Face, J.MaxFace);background:var(--c3)"></i></u></div>
                            <div><b>@s.Story</b>이야기 /@J.MaxStory<u><i style="width:@Pct(s.Story, J.MaxStory);background:var(--c4)"></i></u></div>
                            <div><b>@s.Craft</b>완성도 /@J.MaxCraft<u><i style="width:@Pct(s.Craft, J.MaxCraft);background:var(--c5)"></i></u></div>
                            <div class="hh"><b>@N1(likePtOf[s.No])</b>❤️ @(likesOf[s.No])개 /@J.MaxLike<u><i style="width:@PctD(likePtOf[s.No], J.MaxLike);background:var(--c6)"></i></u></div>
                        </div>
                        @if (isStaff && !string.IsNullOrWhiteSpace(s.StaffNote))
                        {
                            <div class="staff"><b>관리자 참고</b> · @s.StaffNote</div>
                        }
                        @if (isStaff && (ph.P.IsHidden || ph.E.IsHidden))
                        {
                            <div class="staff"><b>관리자 참고</b> · 갤러리에서 숨긴 사진이에요.</div>
                        }
                    </div>
                </div>
            }
        </div>
        }

        <div class="foot">
            @if (isStaff) { <a href="/FamilyPhoto/Admin">관리 화면 →</a> }
            <a href="/FamilyPhoto">갤러리 →</a>
            <a href="/">@ConstatsCommon.ToHome →</a>
        </div>
    </main>
</div>

<div class="mask" id="jbMask" aria-hidden="true">
    <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="jbTitle">
        <div class="top">
            <div><b id="jbTitle"></b> <span id="jbSub"></span></div>
            <button type="button" class="x" id="jbClose" aria-label="닫기">✕</button>
        </div>
        <div id="jbBody"></div>
        <div class="bd" style="padding-top:0">
            <div class="nav"><button type="button" id="jbPrev">‹ 이전 사진</button><button type="button" id="jbNext">다음 사진 ›</button></div>
        </div>
    </div>
</div>

<script>
    (function () {
        // 작은 사진 — 다 오면 반짝임을 멈추고 스르르
        function thumbDone(img) { img.classList.add('ok'); var b = img.closest('.sh'); if (b) b.classList.add('ok'); }
        document.querySelectorAll('img.fade').forEach(function (img) {
            if (img.complete) { thumbDone(img); return; }
            img.addEventListener('load', function () { thumbDone(img); });
            img.addEventListener('error', function () { thumbDone(img); });
        });

        // 펼친 심사평 — 순위 순서로 이전 / 다음
        var order = [].map.call(document.querySelectorAll('.grid .cd'), function (b) { return b.getAttribute('data-open'); });
        var mask = document.getElementById('jbMask'), body = document.getElementById('jbBody');
        var title = document.getElementById('jbTitle'), sub = document.getElementById('jbSub');
        var prev = document.getElementById('jbPrev'), next = document.getElementById('jbNext');
        var cur = null, lastFocus = null;

        function loadBig(root) {
            var pic = root.querySelector('.pic'), img = pic && pic.querySelector('img');
            if (!img) return;
            function ok() { pic.classList.remove('ld'); }
            function bad() { pic.classList.remove('ld'); pic.classList.add('err'); var t = pic.querySelector('.ldr span'); if (t) t.textContent = '사진을 불러오지 못했어요 · 눌러서 원본 보기'; }
            img.addEventListener('load', ok); img.addEventListener('error', bad);
            img.src = img.getAttribute('data-src');
            if (img.complete && img.naturalWidth > 0) ok();
        }
        function open(no, push) {
            var d = document.getElementById('d' + no);
            if (!d) return;
            if (!mask.classList.contains('on')) lastFocus = document.activeElement;
            cur = String(no);
            body.innerHTML = d.innerHTML;
            title.textContent = d.getAttribute('data-title');
            sub.textContent = d.getAttribute('data-sub');
            loadBig(body);
            var i = order.indexOf(cur);
            prev.disabled = i <= 0; next.disabled = i < 0 || i >= order.length - 1;
            mask.classList.add('on'); mask.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            mask.querySelector('.sheet').scrollTop = 0;
            document.getElementById('jbClose').focus();
            if (push !== false) { try { history.replaceState(null, '', '#p' + no); } catch (e) { } }
        }
        function close() {
            mask.classList.remove('on'); mask.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = ''; body.innerHTML = ''; cur = null;
            try { history.replaceState(null, '', location.pathname + location.search); } catch (e) { }
            if (lastFocus) lastFocus.focus();
        }
        function step(dir) { var i = order.indexOf(cur) + dir; if (i >= 0 && i < order.length) open(order[i]); }

        document.querySelectorAll('[data-open]').forEach(function (b) {
            b.addEventListener('click', function () { open(b.getAttribute('data-open')); });
        });
        document.getElementById('jbClose').addEventListener('click', close);
        mask.addEventListener('click', function (e) { if (e.target === mask) close(); });
        prev.addEventListener('click', function () { step(-1); });
        next.addEventListener('click', function () { step(1); });
        document.addEventListener('keydown', function (e) {
            if (!mask.classList.contains('on')) return;
            if (e.key === 'Escape') close();
            else if (e.key === 'ArrowLeft') step(-1);
            else if (e.key === 'ArrowRight') step(1);
        });

        // 주소 끝이 #p17 이면 그 사진을 바로 펼친다
        var m = /^#p(\d+)$/.exec(location.hash);
        if (m) open(m[1], false);
    })();
</script>
</body>
</html>
