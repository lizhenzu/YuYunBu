@model BulletinBoard.Models.FamilyPhoto.FamilyPhotoResultVM
@using BulletinBoard.Common
@using BulletinBoard.Helpers
@using BulletinBoard.Models.FamilyPhoto
@using Cfg = BulletinBoard.Models.FamilyPhoto.FamilyPhotoContestConfig

@*  결과 — 발표(10/4 주일 또는 관리자 「발표하기」) 뒤 누구나.  그 전엔 "곧 발표" (관리자는 ?preview=true 로 미리보기).
    2026-10-01 새 디자인 — AI 심사평(Judge)과 같은 "추석 밤" 옷.
    순위 = 가족 사진 좋아요 합계 (교사 가족 포함).  같은 합계는 같은 등수, 다음 가족은 차례로 (1 · 2 · 2 · 3).
    가족 카드 사진을 누르면 크게 보고 좌우로 넘긴다.  사진이 오는 동안은 반짝이는 대기 카드 + 동그라미. *@

@{
    Layout = null;
    var now = DateHelper.GetKoreaNow();
    bool isStaff = ViewBag.IsStaff == true;
    bool show = Model.IsPublished || Model.IsPreview;
    var bn = ViewBag.Banner as FamilyPhotoBannerVM ?? new FamilyPhotoBannerVM();
    int daysLeft = Math.Max(0, (Cfg.AnnounceDay.Date - DateHelper.GetKoreaToday()).Days);

    // 등수 — 같은 합계는 같은 등수, 다음은 차례로 (dense)
    var rankOf = new Dictionary<int, int>();
    int rk = 0, prev = -1;
    foreach (var e in Model.Ranking)
    {
        if (e.LikeTotal != prev) { rk++; prev = e.LikeTotal; }
        rankOf[e.EntryId] = rk;
    }
    int maxLike = Model.Ranking.Count == 0 ? 0 : Model.Ranking.Max(e => e.LikeTotal);
    List<FamilyPhotoEntryVM> AtRank(int r) => Model.Ranking.Where(e => rankOf[e.EntryId] == r).ToList();
    FamilyPhotoPhotoVM? Best(FamilyPhotoEntryVM e) => e.Photos.OrderByDescending(p => p.LikeCount).ThenBy(p => p.Slot).FirstOrDefault();
    string Th(FamilyPhotoPhotoVM p) => string.IsNullOrEmpty(p.ThumbPath) ? p.FilePath : p.ThumbPath;
    string Pct(int v, int max) => max <= 0 ? "0%" : (v * 100.0 / max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
    string ShortName(string n) => n.EndsWith("네") ? n[..^1] : n;
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>좋아요 결과 발표 — @Cfg.Title</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Gothic+A1:wght@400;600;800&family=Jua&display=swap" />
<style>
    :root {
        --bg: #F7F3EC; --ink: #2A2320; --dim: #7A6E66; --line: #E6DED2; --paper: #FFFFFF;
        --night: #1F2547; --night2: #34305E; --moon: #F6C84B; --navy: #2F3A56; --heart: #F0506E; --rose: #D9486A;
        --f-disp: "Jua", "Gothic A1", sans-serif;
        --f-serif: "Gowun Batang", "Noto Serif KR", serif;
        --f-body: "Gothic A1", "Malgun Gothic", system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; }
    body { background: var(--bg); color: var(--ink); font-family: var(--f-body); -webkit-text-size-adjust: 100%; }
    a { color: inherit; }
    .rs { max-width: 760px; margin: 0 auto; }

    /* ── 머리 : 추석 밤 ── */
    .sky { position: relative; overflow: hidden; color: #fff; text-align: center; padding: 20px 16px 0; background: linear-gradient(180deg, var(--night), var(--night2)); }
    .sky.wait { padding-bottom: 26px; }
    .stars { position: absolute; inset: 0; pointer-events: none; opacity: .8;
        background-image: radial-gradient(2px 2px at 12% 18%, #FFF3C4 50%, transparent 51%), radial-gradient(1.5px 1.5px at 30% 8%, #FFF3C4 50%, transparent 51%),
                          radial-gradient(2px 2px at 78% 14%, #FFF3C4 50%, transparent 51%), radial-gradient(1.5px 1.5px at 90% 38%, #FFF3C4 50%, transparent 51%),
                          radial-gradient(1.5px 1.5px at 8% 52%, #FFF3C4 50%, transparent 51%), radial-gradient(2px 2px at 62% 30%, #FFF3C4 50%, transparent 51%); }
    .bar { position: relative; display: flex; justify-content: space-between; font-size: 11px; color: #C9C6E4; }
    .bar a { text-decoration: none; color: #C9C6E4; }
    .moon { position: relative; width: 88px; height: 88px; border-radius: 50%; margin: 12px auto 0; display: grid; place-items: center; font-size: 36px;
            background: radial-gradient(circle at 42% 38%, #FFF6CF, var(--moon)); box-shadow: 0 0 44px rgba(246,200,75,.45); }
    .kick { position: relative; font-size: 10.5px; letter-spacing: .24em; color: var(--moon); margin-top: 12px; }
    .sky h1 { position: relative; font-family: var(--f-serif); font-weight: 700; font-size: 26px; margin: 6px 0 0; text-wrap: balance; }
    .sky .sum { position: relative; font-size: 11.5px; color: #C9C6E4; margin-top: 6px; line-height: 1.6; }
    .stats { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; max-width: 420px; margin: 14px auto 0; }
    .stats div { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.16); border-radius: 12px; padding: 8px 4px; font-size: 10.5px; color: #D5D3EA; }
    .stats b { display: block; font-family: var(--f-disp); font-weight: 400; font-size: 22px; color: #fff; }
    .stats .h b { color: #FFB3C3; }
    .pv { position: relative; margin: 12px auto 0; max-width: 420px; background: rgba(240,80,110,.18); border: 1px solid rgba(240,80,110,.45); color: #FFD3DC; border-radius: 10px; padding: 7px 10px; font-size: 11.5px; }

    /* ── 시상대 (가족) ── */
    .pod { position: relative; display: grid; grid-template-columns: 1fr 1.2fr 1fr; align-items: end; gap: 8px; max-width: 460px; margin: 22px auto 0; }
    .pod > div { position: relative; text-align: center; }
    .pod .av { width: 78%; aspect-ratio: 1; border-radius: 50%; border: 3px solid #fff; margin: 0 auto; overflow: hidden; background: rgba(255,255,255,.12); }
    .pod .av img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pod .g .av { width: 90%; border-color: var(--moon); box-shadow: 0 0 0 5px rgba(246,200,75,.28); }
    .pod .stack { display: flex; justify-content: center; }
    .pod .stack .av { width: 44%; margin: 0 0 0 -14%; border-width: 2px; }
    .pod .stack .av:first-child { margin-left: 0; }
    .pod .crown { position: absolute; left: 50%; top: -24px; transform: translateX(-50%) rotate(-8deg); font-size: 26px; z-index: 1; filter: drop-shadow(0 2px 3px rgba(0,0,0,.3)); }
    .pod .tie { display: inline-block; font-size: 9.5px; background: var(--heart); color: #fff; border-radius: 999px; padding: 1px 7px; margin-bottom: 5px; white-space: nowrap; }
    .pod .n { color: #fff; font-size: 11px; margin-top: 6px; line-height: 1.35; word-break: keep-all; }
    .pod .n b { display: block; font-family: var(--f-disp); font-weight: 400; font-size: 15px; }
    .pod .n em { font-style: normal; color: #FFB3C3; }
    .pod .st { margin-top: 8px; border-radius: 10px 10px 0 0; font-family: var(--f-disp); font-size: 22px; display: grid; place-items: center; }
    .pod .g .st { height: 70px; background: linear-gradient(#F6C84B, #D9A22B); color: #6B4A08; }
    .pod .s .st { height: 50px; background: linear-gradient(#DCE1EA, #AEB6C4); color: #3C4454; }
    .pod .b .st { height: 38px; background: linear-gradient(#E9B48A, #C58A5E); color: #5A3418; }

    .main { padding: 14px 14px 30px; }
    .gift { display: flex; gap: 10px; align-items: center; background: #FFF6DC; border-radius: 14px; padding: 11px 13px; font-size: 12px; line-height: 1.6; word-break: keep-all; }
    .gift b { font-size: 22px; }
    .sec { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin: 22px 2px 10px; }
    .sec h2 { font-family: var(--f-serif); font-weight: 700; font-size: 17px; margin: 0; }
    .sec small { font-size: 10.5px; color: var(--dim); }

    /* ── 가족 카드 ── */
    .fc { background: var(--paper); border-radius: 16px; padding: 11px; box-shadow: 0 2px 10px rgba(0,0,0,.06); margin-bottom: 10px; }
    .fc .hd { display: flex; align-items: center; gap: 10px; }
    .fc .rk { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font-family: var(--f-disp); font-size: 17px; background: var(--bg); color: var(--navy); flex: none; }
    .fc .rk.r1 { background: var(--moon); color: #6B4A08; } .fc .rk.r2 { background: #DCE1EA; color: #3C4454; } .fc .rk.r3 { background: #E9B48A; color: #5A3418; }
    .fc .nm { flex: 1; min-width: 0; font-family: var(--f-disp); font-size: 16.5px; word-break: keep-all; }
    .fc .nm small { display: block; font-family: var(--f-body); font-size: 10.5px; color: var(--dim); margin-top: 1px; }
    .fc .lk { font-family: var(--f-disp); font-size: 20px; color: var(--heart); white-space: nowrap; }
    .fc .lbar { height: 6px; border-radius: 3px; background: #F1ECE4; margin-top: 9px; overflow: hidden; }
    .fc .lbar i { display: block; height: 100%; background: linear-gradient(90deg, #FF9BB0, var(--heart)); border-radius: 3px; }
    .fc .ths { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 9px; }
    .fc .th { all: unset; cursor: zoom-in; position: relative; aspect-ratio: 1; border-radius: 11px; overflow: hidden; display: block; -webkit-tap-highlight-color: transparent; }
    .fc .th:focus-visible { outline: 3px solid var(--navy); outline-offset: 2px; }
    .fc .th img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .fc .th .c { position: absolute; left: 5px; bottom: 5px; font-size: 10px; background: rgba(255,255,255,.94); color: var(--heart); border-radius: 999px; padding: 1px 7px; font-weight: 800; }

    /* 대기 카드 — 사진이 오는 동안 반짝이는 자리 + 동그라미 */
    .ld { background: linear-gradient(100deg, #EFE9DF 30%, #F9F6F0 50%, #EFE9DF 70%) 0 0 / 200% 100%; animation: rsShim 1.4s linear infinite; }
    .ld::before { content: ""; position: absolute; left: 50%; top: 50%; width: 24px; height: 24px; margin: -12px 0 0 -12px; border-radius: 50%;
                  border: 3px solid #E2DCCF; border-top-color: var(--navy); border-right-color: var(--heart); animation: rsSpin .85s linear infinite; }
    .pod .ld::before { width: 20px; height: 20px; margin: -10px 0 0 -10px; }
    .ld.ok { animation: none; background: none; }
    .ld.ok::before { display: none; }
    img.fade { opacity: 0; transition: opacity .3s ease; }
    img.fade.ok { opacity: 1; }
    @@keyframes rsShim { from { background-position: 100% 0; } to { background-position: -100% 0; } }
    @@keyframes rsSpin { to { transform: rotate(360deg); } }

    /* ── 발표 전 ── */
    .cd { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; max-width: 420px; margin: 16px auto 0; }
    .cd div { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.16); border-radius: 12px; padding: 9px 0; color: #D5D3EA; font-size: 10.5px; }
    .cd b { display: block; font-family: var(--f-disp); font-weight: 400; font-size: 28px; color: #fff; }
    .blur { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; max-width: 420px; margin: 14px auto 0; }
    .blur span { aspect-ratio: 1; border-radius: 10px; overflow: hidden; }
    .blur img { width: 100%; height: 100%; object-fit: cover; display: block; filter: blur(5px); transform: scale(1.1); opacity: .85; }
    .btns { position: relative; display: grid; gap: 8px; max-width: 420px; margin: 16px auto 0; }
    .btn { display: block; padding: 13px 0; border-radius: 12px; background: var(--heart); color: #fff; font-weight: 800; font-size: 13.5px; text-align: center; text-decoration: none; }
    .btn.line { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.25); color: #fff; }
    .btn.light { background: var(--paper); color: var(--navy); border: 1px solid var(--line); }

    .foot { margin-top: 26px; padding-top: 14px; border-top: 1px solid var(--line); display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; font-size: 11.5px; }
    .foot a { color: var(--dim); text-decoration: none; }
    .foot a:hover { color: var(--rose); }

    /* ── 사진 크게 보기 ── */
    .lb { position: fixed; inset: 0; z-index: 9000; background: rgba(16,18,34,.94); display: none; flex-direction: column; justify-content: center; align-items: center; padding: 14px; padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px)); }
    .lb.on { display: flex; }
    .lb .in { width: 100%; max-width: 560px; }
    .lb .tp { display: flex; justify-content: space-between; align-items: center; color: #fff; font-size: 12px; gap: 10px; }
    .lb .tp b { font-family: var(--f-disp); font-weight: 400; font-size: 18px; }
    .lb .x { all: unset; cursor: pointer; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.16); font-size: 17px; }
    .lb .big { position: relative; margin-top: 10px; border-radius: 12px; overflow: hidden; min-height: 240px; display: flex; justify-content: center; align-items: center; background: #26293F; }
    .lb .big img { display: block; max-width: 100%; max-height: 68vh; object-fit: contain; transition: opacity .3s ease; }
    .lb .big.ld { min-height: 300px; }
    .lb .big.ld img { opacity: 0; }
    .lb .big .msg { position: absolute; left: 0; right: 0; top: 50%; margin-top: 24px; text-align: center; color: #A9A6CC; font-size: 11.5px; pointer-events: none; }
    .lb .big:not(.ld) .msg { display: none; }
    .lb .inf { color: #fff; margin-top: 10px; font-size: 12.5px; line-height: 1.6; min-height: 20px; word-break: keep-all; }
    .lb .inf em { font-style: normal; color: #FFB3C3; font-weight: 800; }
    .lb .dots { display: flex; justify-content: center; gap: 6px; margin-top: 8px; }
    .lb .dots i { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,.35); }
    .lb .dots i.on { background: #fff; }
    .lb .nav { display: flex; gap: 8px; margin-top: 10px; }
    .lb .nav button { all: unset; cursor: pointer; flex: 1; text-align: center; padding: 11px 0; border-radius: 12px; background: rgba(255,255,255,.12); color: #fff; font-size: 12.5px; font-weight: 800; }
    .lb .nav button[disabled] { opacity: .3; cursor: default; }
    .lb button:focus-visible { outline: 3px solid #fff; }

    @@media (prefers-reduced-motion: reduce) {
        .ld, .ld::before { animation: none; }
        img.fade, .lb .big img { transition: none; }
    }
</style>
</head>
<body>

<div class="rs">
@if (!show)
{
    @* ═════════════ 발표 전 ═════════════ *@
    <header class="sky wait">
        <div class="stars"></div>
        <div class="bar"><a href="/FamilyPhoto">← 가족 사진</a><span>@now.ToString("yyyy.MM.dd")</span></div>
        <div class="moon">🌕</div>
        <div class="kick">COMING SOON</div>
        <h1>@(Cfg.AnnounceDay.Month)월 @(Cfg.AnnounceDay.Day)일 주일에 발표해요</h1>
        <div class="sum">좋아요는 발표 전까지 언제든 누를 수 있어요. 우리 가족 사진에 응원을 모아 주세요.</div>
        <div class="cd">
            <div><b>@daysLeft</b>@(daysLeft == 0 ? "오늘 발표" : "일 남음")</div>
            <div><b>@bn.EntryCount</b>가족</div>
            <div><b>@bn.PhotoCount</b>사진</div>
        </div>
        @if (bn.Thumbs.Count > 0)
        {
            <div class="blur" aria-hidden="true">
                @foreach (var t in bn.Thumbs) { <span><img src="@t.ThumbPath" alt="" loading="lazy" decoding="async" /></span> }
            </div>
        }
        <div class="btns">
            <a class="btn" href="/FamilyPhoto">❤️ 좋아요 누르러 가기</a>
            <a class="btn line" href="/FamilyPhoto/Judge">AI 심사평 먼저 보기</a>
            @if (isStaff) { <a class="btn line" href="/FamilyPhoto/Result?preview=true">결과 미리보기 (관리자)</a> }
        </div>
    </header>
}
else
{
    @* ═════════════ 결과 ═════════════ *@
    var g1 = AtRank(1); var g2 = AtRank(2); var g3 = AtRank(3);
    <header class="sky">
        <div class="stars"></div>
        <div class="bar"><a href="/FamilyPhoto">← 가족 사진</a><span>@now.ToString("yyyy.MM.dd")</span></div>
        <div class="moon">❤️</div>
        <div class="kick">CHUSEOK FAMILY PHOTO · RESULT</div>
        <h1>좋아요 결과 발표</h1>
        <div class="sum">함께 나눈 사진, 고마워요</div>
        <div class="stats">
            <div><b>@Model.EntryCount</b>가족</div>
            <div><b>@Model.PhotoCount</b>사진</div>
            <div class="h"><b>@Model.LikeTotal</b>❤️ 좋아요</div>
        </div>
        @if (Model.IsPreview && !Model.IsPublished)
        {
            <div class="pv">관리자 미리보기예요 — 아직 발표 전이라 다른 사람에게는 보이지 않아요.</div>
        }

        @if (g1.Count > 0)
        {
            <div class="pod">
                @foreach (var (grp, cls, no) in new[] { (g2, "s", 2), (g1, "g", 1), (g3, "b", 3) })
                {
                    if (grp.Count == 0) { <div></div> continue; }
                    <div class="@cls">
                        @if (grp.Count > 1) { <span class="tie">공동 @(no)등 · @(grp.Count)가족</span> }
                        @if (cls == "g" && grp.Count == 1) { <span class="crown" aria-hidden="true">👑</span> }
                        <div class="@(grp.Count > 1 ? "stack" : "")">
                            @foreach (var e in grp.Take(3))
                            {
                                var b = Best(e);
                                <div class="av ld">@if (b != null) { <img class="fade" src="@Th(b)" alt="" loading="lazy" decoding="async" /> }</div>
                            }
                        </div>
                        <div class="n"><b>@(grp.Count == 1 ? grp[0].FamilyName : string.Join(" · ", grp.Take(3).Select(e => ShortName(e.FamilyName))) + (grp.Count > 3 ? " 외" : ""))</b><em>❤️ @grp[0].LikeTotal</em></div>
                        <div class="st">@no</div>
                    </div>
                }
            </div>
        }
    </header>

    <main class="main">
        <div class="gift"><b>🎁</b><div>좋아요를 많이 받은 가족에게 <strong>주일 예배 때</strong> 작은 선물을 드려요. 함께해 주신 모든 가족에게 감사해요!</div></div>

        <div class="sec"><h2>가족별 결과</h2><small>사진을 누르면 크게 봐요</small></div>
        @foreach (var e in Model.Ranking)
        {
            int r = rankOf[e.EntryId];
            int same = Model.Ranking.Count(x => rankOf[x.EntryId] == r);
            var photos = e.Photos.OrderBy(p => p.Slot).ToList();
            <section class="fc" data-fam="@e.FamilyName">
                <div class="hd">
                    <span class="rk @(r <= 3 ? "r" + r : "")">@r</span>
                    <span class="nm">@e.FamilyName<small>사진 @(photos.Count)장@(same > 1 ? $" · 공동 {r}등" : "")</small></span>
                    <span class="lk">❤️ @e.LikeTotal</span>
                </div>
                <div class="lbar"><i style="width:@Pct(e.LikeTotal, maxLike)"></i></div>
                <div class="ths">
                    @for (int i = 0; i < photos.Count; i++)
                    {
                        var p = photos[i];
                        <button type="button" class="th ld" data-i="@i" data-src="@p.FilePath" data-cap="@(p.Caption ?? "")" data-likes="@p.LikeCount" aria-label="@e.FamilyName @(i + 1)번째 사진 크게 보기">
                            <img class="fade" src="@Th(p)" alt="" loading="lazy" decoding="async" />
                            <span class="c">❤️ @p.LikeCount</span>
                        </button>
                    }
                </div>
            </section>
        }

        <div class="btns" style="max-width:none">
            <a class="btn light" href="/FamilyPhoto/Judge">AI 심사평 보러 가기 →</a>
        </div>

        <div class="foot">
            @if (isStaff) { <a href="/FamilyPhoto/Admin">관리 화면 →</a> }
            <a href="/FamilyPhoto">갤러리 →</a>
            <a href="/">@ConstatsCommon.ToHome →</a>
        </div>
    </main>

    <div class="lb" id="rsLb" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="rsTitle">
        <div class="in">
            <div class="tp"><div><b id="rsTitle"></b> · <span id="rsCnt"></span></div><button type="button" class="x" id="rsClose" aria-label="닫기">✕</button></div>
            <div class="big ld" id="rsBig"><img id="rsImg" alt="" /><div class="msg" id="rsMsg">사진을 불러오는 중이에요…</div></div>
            <div class="inf" id="rsInf"></div>
            <div class="dots" id="rsDots"></div>
            <div class="nav"><button type="button" id="rsPrev">‹ 이전</button><button type="button" id="rsNext">다음 ›</button></div>
        </div>
    </div>
}
</div>

<script>
    (function () {
        // 작은 사진 — 다 오면 대기 카드를 걷는다
        function done(img) { img.classList.add('ok'); var b = img.closest('.ld'); if (b) b.classList.add('ok'); }
        document.querySelectorAll('img.fade').forEach(function (img) {
            if (img.complete) { done(img); return; }
            img.addEventListener('load', function () { done(img); });
            img.addEventListener('error', function () { done(img); });
        });

        // 사진 크게 보기 — 그 가족 사진을 좌우로
        var lb = document.getElementById('rsLb');
        if (!lb) return;
        var big = document.getElementById('rsBig'), img = document.getElementById('rsImg'), msg = document.getElementById('rsMsg');
        var title = document.getElementById('rsTitle'), cnt = document.getElementById('rsCnt'), inf = document.getElementById('rsInf'), dots = document.getElementById('rsDots');
        var prev = document.getElementById('rsPrev'), next = document.getElementById('rsNext');
        var list = [], idx = 0, fam = '', lastFocus = null;

        function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
        function show(i) {
            idx = i; var t = list[i];
            big.classList.add('ld'); big.classList.remove('ok'); msg.textContent = '사진을 불러오는 중이에요…';
            img.onload = function () { big.classList.remove('ld'); };
            img.onerror = function () { big.classList.remove('ld'); msg.textContent = '사진을 불러오지 못했어요'; big.classList.add('ld'); big.classList.add('ok'); };
            img.src = t.src;
            if (img.complete && img.naturalWidth > 0) big.classList.remove('ld');
            title.textContent = fam; cnt.textContent = (i + 1) + ' / ' + list.length;
            inf.innerHTML = (t.cap ? '“' + esc(t.cap) + '” · ' : '') + '<em>❤️ ' + esc(t.likes) + '</em>';
            dots.innerHTML = list.map(function (_, k) { return '<i' + (k === i ? ' class="on"' : '') + '></i>'; }).join('');
            prev.disabled = i <= 0; next.disabled = i >= list.length - 1;
        }
        function open(card, i) {
            fam = card.getAttribute('data-fam');
            list = [].map.call(card.querySelectorAll('.th'), function (b) {
                return { src: b.getAttribute('data-src'), cap: b.getAttribute('data-cap'), likes: b.getAttribute('data-likes') };
            });
            lastFocus = document.activeElement;
            lb.classList.add('on'); lb.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden';
            show(i);
            document.getElementById('rsClose').focus();
        }
        function close() {
            lb.classList.remove('on'); lb.setAttribute('aria-hidden', 'true'); document.body.style.overflow = '';
            img.removeAttribute('src');
            if (lastFocus) lastFocus.focus();
        }
        document.querySelectorAll('.fc .th').forEach(function (b) {
            b.addEventListener('click', function () { open(b.closest('.fc'), parseInt(b.getAttribute('data-i'), 10)); });
        });
        document.getElementById('rsClose').addEventListener('click', close);
        lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
        prev.addEventListener('click', function () { if (idx > 0) show(idx - 1); });
        next.addEventListener('click', function () { if (idx < list.length - 1) show(idx + 1); });
        document.addEventListener('keydown', function (e) {
            if (!lb.classList.contains('on')) return;
            if (e.key === 'Escape') close();
            else if (e.key === 'ArrowLeft' && idx > 0) show(idx - 1);
            else if (e.key === 'ArrowRight' && idx < list.length - 1) show(idx + 1);
        });
        // 휴대폰 — 좌우로 밀어서 넘기기
        var sx = null;
        big.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; }, { passive: true });
        big.addEventListener('touchend', function (e) {
            if (sx === null) return; var dx = e.changedTouches[0].clientX - sx; sx = null;
            if (dx < -40 && idx < list.length - 1) show(idx + 1); else if (dx > 40 && idx > 0) show(idx - 1);
        });
    })();
</script>
</body>
</html>
