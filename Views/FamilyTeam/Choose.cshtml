@using BulletinBoard.Common
@using BulletinBoard.Services
@*  ══════════════════════════════════════════════════════════════
    1단계 (팀이 없을 때 첫 화면) — 2026-11-08
    · "아직 소속된 팀이 없어요" → [기존 팀에 참가할래요] / [새 팀을 만들래요]
    · 참가 = ?step=join (Join.cshtml), 만들기 = ?step=make (MakeType.cshtml)
    · 받은 초대가 있으면 참가 화면으로 안내한다
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;
    var invites = ViewBag.Invites as List<FamilyRequestInfo> ?? new List<FamilyRequestInfo>();
    bool isStudent = ViewBag.IsStudent is bool s && s;
    string? msg = ViewBag.Msg as string;
    bool msgOk  = ViewBag.MsgOk is bool b && b;
    string? roleBlocked = ViewBag.RoleBlocked as string;   // 교사 · 임원이면 그 역할 이름 — 팀에 못 들어간다
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>팀 구성</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/family-team.css" asp-append-version="true">
</head>
<body>
<div class="ft">
    <div class="ft-top">
        <span><a href="/">@ConstatsCommon.ToHome</a> › <a href="/DailyMission2/Welcome">@ConstatsCommon.MainKeyTitle</a> › <b>팀 구성</b></span>
    </div>

    @await Html.PartialAsync("_FamilyGreeting")
    @if (!string.IsNullOrEmpty(roleBlocked))
    {
        @* 역할 기준 — 교사 · 임원은 가족팀 · 친구팀에 들어가지 않는다 *@
        <div class="ft-none">
            <b>@roleBlocked 역할은 팀에 들어가지 않아요</b>
            <span>가족팀은 학생과 학부모가, 친구팀은 학생끼리 만들어요.<br />역할이 바뀌었다면 정보 관리의 "역할 변경"에서 요청해 주세요.</span>
        </div>
        @if (!string.IsNullOrEmpty(msg))
        {
            <div class="ft-msg @(msgOk ? "ok" : "")" role="status">@msg</div>
        }
    }
    else
    {
    <div class="ft-none">
        <b>아직 소속된 팀이 없어요</b>
        <span>미션을 함께 하려면 팀이 필요해요.<br />이미 있는 팀에 참가하거나, 새 팀을 만들어 주세요.</span>
    </div>
    <h1 class="ft-h1">어떻게 할까요?</h1>

    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="ft-msg @(msgOk ? "ok" : "")" role="status">@msg</div>
    }

    @if (invites.Count > 0)
    {
        <a class="ft-msg ok" href="/FamilyTeam/Index?step=join" style="display:block;text-decoration:none"><b>받은 초대가 @invites.Count 건 있어요.</b> 눌러서 확인해 보세요 ›</a>
    }

    <a class="ft-pick" href="/FamilyTeam/Index?step=join">
        <span class="t"><b>기존 팀에 참가할래요</b><small>이미 만들어진 팀을 이름으로 찾아요</small></span>
        <i>›</i>
    </a>
    <a class="ft-pick fr" href="/FamilyTeam/Index?step=make">
        <span class="t"><b>새 팀을 만들래요</b><small>우리 팀이 아직 없어요</small></span>
        <i>›</i>
    </a>

    @if (isStudent)
    {
        <div class="ft-msg warn"><b>학생은 가족팀과 친구팀 중 한 곳에만</b> 들어갈 수 있어요. 한 팀에 들어가면 다른 팀에는 들어갈 수 없어요.</div>
    }
    else
    {
        <p class="ft-sub">한 사람은 한 팀에만 들어갈 수 있어요.</p>
    }
    }

    <div class="ft-lk" style="margin-top:26px"><a href="/DailyMission2/Welcome" style="flex:1">미션 시작 화면으로</a><i>›</i></div>
</div>
</body>
</html>
