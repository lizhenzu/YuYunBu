@using BulletinBoard.Common
@using BulletinBoard.Services
@*  ══════════════════════════════════════════════════════════════
    4단계 · 내 팀 만들기 (?type=family|friend&create=true) — 2026-11-08
    · 팀 이름은 "○○○네 가족팀" 으로 자동 (방장 이름), 나중에 팀 화면에서 바꿀 수 있다
    · 가족팀은 관계를 고른다. 친구팀은 고르지 않는다
    · 팀 찾기(참가)는 Join.cshtml, 종류 고르기는 MakeType.cshtml
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;
    var rels    = ViewBag.Relations as (string Key, int Role, string Label)[] ?? FamilyTeamService.Relations;
    string? msg = ViewBag.Msg as string;
    bool msgOk  = ViewBag.MsgOk is bool b && b;

    string mode = (ViewBag.Mode as string) ?? FamilyTeamService.TypeFamily;
    bool friend = mode == FamilyTeamService.TypeFriend;
    string word = friend ? "친구팀" : "가족팀";

    bool isStudent = ViewBag.IsStudent is bool st && st;
    string? pendingTeamName = ViewBag.PendingTeam as string;   // 가입 신청을 보내 둔 팀
    string myName = (ViewBag.HiName as string) ?? "";
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>내 @word 만들기</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/family-team.css" asp-append-version="true">
</head>
<body>
<div class="ft">
    <div class="ft-top">
        <span><a href="/">@ConstatsCommon.ToHome</a> › <a href="/DailyMission2/Welcome">@ConstatsCommon.MainKeyTitle</a> › <a href="/FamilyTeam/Index">팀 구성</a> › <b>@word 만들기</b></span>
    </div>

    @await Html.PartialAsync("_FamilyGreeting")
    <h1 class="ft-h1">내 @word 만들기</h1>
    <p class="ft-sub">내가 방장이 되고, 나중에 @(friend ? "친구를" : "가족을") 초대할 수 있어요.</p>

    @if (isStudent)
    {
        <div class="ft-msg warn"><b>학생은 가족팀과 친구팀 중 한 곳에만</b> 들어갈 수 있어요. 한 팀에 들어가면 다른 팀에는 들어갈 수 없어요.</div>
    }

    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="ft-msg @(msgOk ? "ok" : "")" role="status">@msg</div>
    }

    @if (pendingTeamName != null)
    {
        <div class="ft-msg info"><b>@pendingTeamName</b>에 가입 신청 중이라 지금은 팀을 만들 수 없어요. 신청을 취소한 뒤 만들어 주세요.</div>
        <div style="margin-top:12px"><a class="ft-btn g w" href="/FamilyTeam/Index?step=join">신청 확인하러 가기</a></div>
    }
    else
    {
        <form method="post" asp-action="Create" class="ft-box">
            @Html.AntiForgeryToken()
            <input type="hidden" name="type" value="@mode" />
            <div class="ft-nmp">
                <small>팀 이름 (방장 이름으로 자동)</small>
                <b>@(myName.Length > 0 ? myName : "내 이름")네 @word</b>
                <small>만든 뒤 팀 화면에서 언제든 바꿀 수 있어요. 같은 이름이 있으면 숫자가 붙어요.</small>
            </div>
            @if (!friend)
            {
            <div class="ft-q">나는 이 팀의…</div>
            <div class="ft-chips">
                @for (int i = 0; i < rels.Length; i++)
                {
                    <label><input type="radio" name="relation" value="@rels[i].Key" required /><span>@rels[i].Label</span></label>
                }
            </div>
            }
            <div style="margin-top:16px"><button class="ft-btn p w" type="submit">@word 만들기</button></div>
        </form>
        <a class="ft-back" href="/FamilyTeam/Index?step=join">이미 만들어진 팀이 있는지 먼저 찾아볼래요</a>
    }

    <div class="ft-lk" style="margin-top:26px"><a href="/FamilyTeam/Index?step=make" style="flex:1">팀 종류 다시 고르기</a><i>›</i></div>
</div>
</body>
</html>
