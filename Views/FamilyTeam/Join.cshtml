@using BulletinBoard.Common
@using BulletinBoard.Services
@*  ══════════════════════════════════════════════════════════════
    2단계 · 기존 팀에 참가하기 (?step=join) — 2026-11-08
    · 팀에 있는 사람 이름으로 찾는다 (가족팀 · 친구팀 같이 — 결과에 종류가 표시된다)
    · 받은 초대 / 이미 만들어진 팀 목록 / 가입 신청 · 취소
    · 찾는 팀이 없으면 → 새 팀 만들기(?step=make). 다른 팀에 신청 중이면 막는다
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;
    var famTeams = ViewBag.TeamsFamily as List<FamilyTeamBrief> ?? new List<FamilyTeamBrief>();
    var frTeams  = ViewBag.TeamsFriend as List<FamilyTeamBrief> ?? new List<FamilyTeamBrief>();
    var invites  = ViewBag.Invites as List<FamilyRequestInfo> ?? new List<FamilyRequestInfo>();
    var rels     = ViewBag.Relations as (string Key, int Role, string Label)[] ?? FamilyTeamService.Relations;
    string? msg  = ViewBag.Msg as string;
    bool msgOk   = ViewBag.MsgOk is bool b && b;

    var all = famTeams.Select(t => (T: t, Mode: FamilyTeamService.TypeFamily))
                      .Concat(frTeams.Select(t => (T: t, Mode: FamilyTeamService.TypeFriend)))
                      .ToList();

    // 한 번에 한 팀에만 신청할 수 있다
    bool hasPendingApply = all.Any(x => x.T.RequestId != 0);
    string? pendingTeamName = all.FirstOrDefault(x => x.T.RequestId != 0).T?.Name;
    string relsJson = System.Text.Json.JsonSerializer.Serialize(rels.Select(r => new { k = r.Key, l = r.Label }));
    string makeUrl = "/FamilyTeam/Index?step=make";
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>기존 팀에 참가하기</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/family-team.css" asp-append-version="true">
</head>
<body>
<div class="ft">
    <div class="ft-top">
        <span><a href="/">@ConstatsCommon.ToHome</a> › <a href="/DailyMission2/Welcome">@ConstatsCommon.MainKeyTitle</a> › <a href="/FamilyTeam/Index">팀 구성</a> › <b>팀 참가</b></span>
    </div>

    @await Html.PartialAsync("_FamilyGreeting")
    <h1 class="ft-h1">어느 팀에 들어갈까요?</h1>
    <p class="ft-sub">팀에 있는 사람 이름을 찾으면, 그분이 속한 팀을 보여 줘요.</p>

    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="ft-msg @(msgOk ? "ok" : "")" role="status">@msg</div>
    }

    @if (pendingTeamName != null)
    {
        <div class="ft-msg info"><b>@pendingTeamName</b>에 가입 신청 중이에요. 팀원이 수락하면 들어가요. 신청을 취소하면 다른 팀을 찾거나 새로 만들 수 있어요.</div>
    }

    @* ── 받은 초대 ── *@
    @if (invites.Count > 0)
    {
        <div class="ft-sh"><span>받은 초대</span><small>@invites.Count 건</small></div>
        @foreach (var inv in invites)
        {
            bool friend = inv.TeamType == FamilyTeamService.TypeFriend;
            <div class="ft-row" style="align-items:flex-start">
                <div class="l">
                    <div class="ft-nm">@inv.TeamName<span class="ft-kind @(friend ? "fr" : "")">@(friend ? "친구팀" : "가족팀")</span></div>
                    <div class="ft-mem">@inv.FromFullName 님이 @(friend ? "" : inv.RelLabel + "(으)로 ")초대했어요</div>
                    <div class="ft-mem">@string.Join(" · ", inv.MemberNames)</div>
                </div>
                <div class="ft-acts">
                    <form method="post" asp-action="DeclineInvite">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@inv.Id" /><button class="ft-btn g" type="submit">거절</button></form>
                    <form method="post" asp-action="AcceptInvite">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@inv.Id" /><button class="ft-btn p" type="submit">들어가기</button></form>
                </div>
            </div>
        }
    }

    <div class="ft-sh"><span>팀에 있는 사람 이름으로 찾기</span></div>
    <div id="ftSearch" data-mode="ALL" data-invite="0" data-apply="1" data-solo="" data-blocked="@(hasPendingApply ? "1" : "0")" data-rels="@relsJson" data-create-url="@makeUrl">
        <div style="margin-top:12px"><input id="ftQ" class="ft-in" type="search" placeholder="팀에 있는 사람 이름을 두 글자 이상 입력" autocomplete="off" aria-label="찾을 사람 이름" /></div>
        <div id="ftRes" class="ft-res" aria-live="polite"></div>
    </div>

    @* ── 이미 만들어진 팀 (둘러보기) ── *@
    <div class="ft-sh"><span>이미 만들어진 팀</span><small>@all.Count 개</small></div>
    @if (all.Count == 0)
    {
        <div class="ft-empty">아직 만들어진 팀이 없어요.</div>
    }
    @foreach (var x in all)
    {
        var t = x.T;
        bool fr = x.Mode == FamilyTeamService.TypeFriend;
        <div class="ft-row" style="align-items:flex-start">
            <div class="l">
                <div class="ft-nm">@t.Name<span class="ft-kind @(fr ? "fr" : "")">@(fr ? "친구팀" : "가족팀")</span></div>
                <div class="ft-mem">@string.Join(" · ", t.MemberNames)</div>
                @if (t.RequestId == 0 && hasPendingApply)
                {
                    <button class="ft-btn g" type="button" disabled aria-disabled="true" style="margin-top:8px;opacity:.55;cursor:not-allowed">가입 신청</button>
                    <div class="ft-mem" style="margin-top:4px">다른 팀에 신청 중이에요. 그 신청을 취소하면 신청할 수 있어요.</div>
                }
                else if (t.RequestId == 0)
                {
                    <details class="ft-ap">
                        <summary><span class="ft-btn p" style="margin-top:8px;display:inline-block">가입 신청</span></summary>
                        <form class="box" method="post" asp-action="Apply">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="teamId" value="@t.Id" />
                            <input type="hidden" name="type" value="@x.Mode" />
                            @if (!fr)
                            {
                            <div class="ft-q" style="margin-top:0">나는 이 팀의…</div>
                            <div class="ft-chips">
                                @for (int i = 0; i < rels.Length; i++)
                                {
                                    <label><input type="radio" name="relation" value="@rels[i].Key" required checked="@(rels.Length == 1)" /><span>@rels[i].Label</span></label>
                                }
                            </div>
                            }
                            <div style="margin-top:12px"><button class="ft-btn p w" type="submit">신청 보내기</button></div>
                            <div class="ft-mem" style="margin-top:8px">@(fr ? "방장이" : "팀원 한 명이") 수락하면 바로 팀원이 돼요. 30일 안에 수락이 없으면 사라져요.</div>
                        </form>
                    </details>
                }
            </div>
            @if (t.RequestId != 0)
            {
                <form method="post" asp-action="Cancel">@Html.AntiForgeryToken()<input type="hidden" name="type" value="@x.Mode" /><input type="hidden" name="requestId" value="@t.RequestId" /><button class="ft-btn g" type="submit">신청 보냄 · 취소</button></form>
            }
        </div>
    }

    @* 찾는 팀이 없으면 → 새 팀 만들기. 다른 팀에 가입 신청 중이면 막는다 *@
    <div class="ft-mk @(hasPendingApply ? "dis" : "")">
        <b>찾는 팀이 없나요?</b>
        <span>아직 팀이 만들어지지 않았다면 내가 먼저 만들 수 있어요.</span>
        @if (hasPendingApply)
        {
            <span class="ft-btn g w" style="margin-top:12px;opacity:.6">가입 신청을 취소하면 만들 수 있어요</span>
        }
        else
        {
            <a class="ft-btn p w" href="@makeUrl" style="margin-top:12px">새 팀 만들기</a>
        }
    </div>

    <div class="ft-lk" style="margin-top:26px"><a href="/FamilyTeam/Index" style="flex:1">처음으로</a><i>›</i></div>
</div>
<script src="/js/family-team-search.js" asp-append-version="true"></script>
</body>
</html>
