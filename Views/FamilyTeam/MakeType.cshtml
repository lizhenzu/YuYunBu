@using BulletinBoard.Common
@*  ══════════════════════════════════════════════════════════════
    3단계 · 어떤 팀을 만들까요? (?step=make) — 2026-11-08
    · 가족팀 / 친구팀 중 하나를 고르면 만들기 화면(?type=…&create=true)으로 간다
    · 친구팀은 학생만 — 학생이 아니면 카드를 잠근다
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;
    bool isStudent = ViewBag.IsStudent is bool s && s;
    string? msg = ViewBag.Msg as string;
    bool msgOk = ViewBag.MsgOk is bool b && b;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>어떤 팀을 만들까요?</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/family-team.css" asp-append-version="true">
</head>
<body>
<div class="ft">
    <div class="ft-top">
        <span><a href="/">@ConstatsCommon.ToHome</a> › <a href="/DailyMission2/Welcome">@ConstatsCommon.MainKeyTitle</a> › <a href="/FamilyTeam/Index">팀 구성</a> › <b>새 팀 만들기</b></span>
    </div>

    @await Html.PartialAsync("_FamilyGreeting")
    <h1 class="ft-h1">어떤 팀을 만들까요?</h1>
    @if (isStudent)
    {
        <div class="ft-msg warn"><b>학생은 가족팀과 친구팀 중 한 곳에만</b> 들어갈 수 있어요. 한 팀에 들어가면 다른 팀에는 들어갈 수 없어요.</div>
    }
    else
    {
        <p class="ft-sub">한 사람은 한 팀에만 들어갈 수 있어요.</p>
    }

    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="ft-msg @(msgOk ? "ok" : "")" role="status">@msg</div>
    }

    <a class="ft-pick" href="/FamilyTeam/Index?type=family&create=true">
        <span class="t"><b>가족팀</b><small>가족끼리 · 인원 제한 없음</small></span>
        <i>›</i>
    </a>

    @if (isStudent)
    {
        <a class="ft-pick fr" href="/FamilyTeam/Index?type=friend&create=true">
            <span class="t"><b>친구팀</b><small>학생 친구와 둘이서 · 최대 2명</small></span>
            <i>›</i>
        </a>
    }
    else
    {
        <div class="ft-pick fr off" aria-disabled="true">
            <span class="t"><b>친구팀</b><small>학생만 만들 수 있어요</small></span>
        </div>
    }

    <div class="ft-msg info">고르면 다음 화면에서 <b>"내 이름 + 네 가족팀"</b>처럼 방장 이름으로 팀이 만들어져요. 나중에 이름을 바꿀 수 있어요.</div>

    <div class="ft-lk" style="margin-top:26px"><a href="/FamilyTeam/Index" style="flex:1">처음으로</a><i>›</i></div>
</div>
</body>
</html>
