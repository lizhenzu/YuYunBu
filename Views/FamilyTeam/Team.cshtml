@model BulletinBoard.Services.FamilyTeamDetail
@using BulletinBoard.Common
@using BulletinBoard.Services
@using BulletinBoard.Services.Abstract
@*  ══════════════════════════════════════════════════════════════
    우리 가족팀 (팀이 있을 때) — 카톡 방식
    · 팀 이름 · 올해 팀 점수 · 팀 트리(기존 가계도 그대로) · 받은 가입 신청(수락/거절)
    · 구성원(방장만 다른 구성원을 내보낼 수 있다) · 가족 초대하기(이름 검색) · 보낸 초대 · 팀 탈퇴
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;
    var rels   = ViewBag.Relations as (string Key, int Role, string Label)[] ?? FamilyTeamService.Relations;
    string? msg = ViewBag.Msg as string;
    bool msgOk  = ViewBag.MsgOk is bool b && b;
    var tree = ViewBag.FamilyTree as FamilyTreeVM;
    int sum  = tree?.Members.Sum(m => m.YearPoint) ?? 0;
    // 내 팀에 나 혼자이고 시상 기록이 없으면 다른 팀에 신청할 수 있다 (신청하면 내 팀은 지워진다)
    bool isSolo = Model.Members.Count == 1 && !Model.HasAwardRecord;
    string relsJson = System.Text.Json.JsonSerializer.Serialize(rels.Select(r => new { k = r.Key, l = r.Label }));
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>@Model.TeamName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/family-team.css" asp-append-version="true">
    <style>
        .qz .ftb { margin-top: 18px; }
        .ft-res .ft-row .st { font-size: 12px; color: var(--dim2); }
    </style>
</head>
<body>
<div class="ft">
    <div class="ft-top">
        <span><a href="/">@ConstatsCommon.ToHome</a> › <a href="/DailyMission2/Welcome">@ConstatsCommon.MainKeyTitle</a> › <b>가족팀</b></span>
    </div>

    @await Html.PartialAsync("_FamilyGreeting")
    <h1 class="ft-h1">@Model.TeamName</h1>
    <p class="ft-sub">우리 가족팀 · 구성원 @Model.Members.Count 명</p>
    <details class="ft-ap" style="margin-top:8px">
        <summary><span class="ft-btn g">팀 이름 바꾸기</span></summary>
        <form class="box" method="post" asp-action="Rename">
            @Html.AntiForgeryToken()
            <input class="ft-in" name="teamName" value="@Model.TeamName" maxlength="@FamilyTeamService.MaxTeamNameLength" aria-label="팀 이름" style="background:#fff" />
            <div style="margin-top:10px"><button class="ft-btn p w" type="submit">이름 저장</button></div>
            <div class="ft-mem" style="margin-top:8px">팀원 누구나 바꿀 수 있어요. 이름을 바꿔도 점수와 시상 기록은 그대로예요.</div>
        </form>
    </details>

    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="ft-msg @(msgOk ? "ok" : "")" role="status">@msg</div>
    }

    <div class="ft-kv">
        <div><small>올해 팀 점수</small><b>@sum.ToString("N0")</b></div>
        <div><small>구성원</small><b>@Model.Members.Count</b></div>
    </div>

    @* ── 팀 트리 : 미션 홈과 같은 가계도 ── *@
    <div class="qz">
        @await Html.PartialAsync("~/Views/DailyMission4/Partials/_FamilyTreeBone.cshtml")
    </div>

    @* ── 받은 가입 신청 ── *@
    <div class="ft-sh"><span>받은 가입 신청</span><small>@Model.Requests.Count 건</small></div>
    @if (Model.Requests.Count == 0)
    {
        <div class="ft-empty">들어오고 싶다는 신청이 없어요.</div>
    }
    @foreach (var r in Model.Requests)
    {
        <div class="ft-row">
            <div class="l">
                <div class="ft-nm">@r.TargetFullName</div>
                <div class="ft-mem">우리 팀의 <b>@r.RelLabel</b>(으)로 신청했어요</div>
            </div>
            <div class="ft-acts">
                <form method="post" asp-action="DeclineRequest">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@r.Id" /><button class="ft-btn g" type="submit">거절</button></form>
                <form method="post" asp-action="AcceptRequest">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@r.Id" /><button class="ft-btn p" type="submit">수락</button></form>
            </div>
        </div>
    }

    @* ── 구성원 ── *@
    <div class="ft-sh"><span>구성원</span></div>
    @foreach (var m in Model.Members)
    {
        <div class="ft-row" style="align-items:flex-start">
            <div class="l">
                <div class="ft-nm">@m.FullName@if (m.IsMe) {<i style="font-style:normal;font-size:11px;color:var(--blue);margin-left:6px">나</i>}@if (string.Equals(m.UserName, Model.CreatorUserName, StringComparison.OrdinalIgnoreCase)) {<i style="font-style:normal;font-size:11px;color:var(--dim2);margin-left:6px">방장</i>}</div>
                @{ bool canChange = m.IsMe || Model.IsCreator; }
                @if (canChange && !Model.HasAwardRecord)
                {
                    @* 관계 칩을 누르면 이 줄 아래로 펼쳐진다 (본인 · 방장) *@
                    <details class="ft-ap ft-rel">
                        <summary><span class="ft-rchip">@m.RelLabel <i>▾</i></span></summary>
                        <form class="box" method="post" asp-action="ChangeRelation">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="targetUserName" value="@m.UserName" />
                            <div class="ft-q" style="margin-top:0">@(m.IsMe ? "나는" : m.FullName + "님은") 우리 가족의…</div>
                            <div class="ft-chips">
                                @foreach (var r2 in rels)
                                {
                                    <label><input type="radio" name="relation" value="@r2.Key" checked="@(r2.Key == m.RelKey)" required /><span>@r2.Label</span></label>
                                }
                            </div>
                            <div style="margin-top:12px"><button class="ft-btn p w" type="submit">관계 저장</button></div>
                        </form>
                    </details>
                }
                else if (canChange)
                {
                    @* 시상 기록이 있으면 관계를 바꿀 수 없다 — 칩은 보이되 눌리지 않게 *@
                    <span class="ft-rchip off" title="시상 기록이 있는 팀은 관계를 바꿀 수 없어요">@m.RelLabel</span>
                }
                else
                {
                    <div class="ft-mem">@m.RelLabel</div>
                }
            </div>
            @if (Model.IsCreator && !m.IsMe && Model.HasAwardRecord)
            {
                @* 시상 기록이 있으면 구성원을 내보낼 수 없다 — 버튼은 보이되 눌리지 않게 *@
                <button class="ft-btn d" type="button" disabled aria-disabled="true" style="opacity:.5;cursor:not-allowed" title="시상 기록이 있는 팀은 구성원을 내보낼 수 없어요">내보내기</button>
            }
            else if (Model.IsCreator && !m.IsMe)
            {
                <form method="post" asp-action="Kick" data-confirm="@(m.FullName)님을 팀에서 내보낼까요?|내보내도 그분의 점수는 그대로예요.|내보내기">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="targetUserName" value="@m.UserName" />
                    <button class="ft-btn d" type="submit">내보내기</button>
                </form>
            }
        </div>
    }

    @* ── 이름 조회 · 가족 초대 ── *@
    <div class="ft-sh"><span>이름 조회 · 가족 초대</span></div>
    <p class="ft-sub" style="margin-top:8px">이름을 찾으면 그 사람이 속한 팀과 구성원을 보여 줘요. 팀이 없는 분은 초대할 수 있어요. 상대가 로그인해서 승인해야 팀에 들어와요.</p>
    @if (isSolo)
    {
        <p class="ft-sub" style="margin-top:6px">가족이 이미 팀을 만들었다면 그 팀에 가입 신청하세요. 신청하면 내가 만든 팀은 바로 삭제돼요.</p>
    }
    <form id="invForm" method="post" asp-action="Invite">
        @Html.AntiForgeryToken()
        <input type="hidden" name="targetUserName" id="invTarget" value="" />
        <div class="ft-q">초대받는 분은 우리 팀의…</div>
        <div class="ft-chips">
            @for (int i = 0; i < rels.Length; i++)
            {
                <label><input type="radio" name="relation" value="@rels[i].Key" required /><span>@rels[i].Label</span></label>
            }
        </div>
    </form>
    <div id="ftSearch" data-mode="FAMILY" data-invite="1" data-apply="@(isSolo ? "1" : "0")" data-solo="@(isSolo ? Model.TeamName : "")" data-blocked="0" data-rels="@relsJson">
        <div style="margin-top:12px"><input id="ftQ" class="ft-in" type="search" placeholder="이름을 두 글자 이상 입력" autocomplete="off" aria-label="찾을 사람 이름" /></div>
        <div id="ftRes" class="ft-res" aria-live="polite"></div>
    </div>

    @if (Model.Invites.Count > 0)
    {
        <div class="ft-sh"><span>보낸 초대</span><small>@Model.Invites.Count 건</small></div>
        @foreach (var r in Model.Invites)
        {
            <div class="ft-row">
                <div class="l">
                    <div class="ft-nm">@r.TargetFullName</div>
                    <div class="ft-mem">@(r.RelLabel)(으)로 초대 · @r.FromFullName 님이 보냄 · 30일 뒤 사라져요</div>
                </div>
                <form method="post" asp-action="Cancel">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@r.Id" /><button class="ft-btn g" type="submit">취소</button></form>
            </div>
        }
    }

    @* ── 탈퇴 : 방장(처음 만든 사람)은 나갈 수 없다. 혼자이고 시상 기록이 없을 때만 탈퇴하며 팀이 지워진다 ── *@
    <div style="margin-top:32px;padding-top:18px;border-top:1px solid var(--line);text-align:center">
        @if (Model.HasAwardRecord)
        {
            @* 시상 기록이 있으면 누구도 탈퇴할 수 없다 — 버튼은 보이되 눌리지 않게 *@
            <button class="ft-btn g" type="button" disabled aria-disabled="true" style="opacity:.55;cursor:not-allowed">팀 탈퇴</button>
            <div class="ft-mem" style="margin-top:8px">시상 기록이 있는 팀은 탈퇴할 수 없어요. 문의가 필요하면 관리자에게 알려 주세요.</div>
        }
        else if (Model.IsCreator && !isSolo)
        {
            <div class="ft-mem">방장은 팀에서 나갈 수 없어요. 팀 삭제는 관리자에게 문의해 주세요.</div>
        }
        else if (Model.IsCreator)
        {
            <form method="post" asp-action="Leave" data-confirm="팀에서 나갈까요?|혼자이고 시상 기록이 없어서 나갈 수 있어요. 나가면 팀이 삭제돼요.|탈퇴">
                @Html.AntiForgeryToken()
                <button class="ft-btn g" type="submit">팀 탈퇴 (팀 삭제)</button>
            </form>
        }
        else
        {
            <form method="post" asp-action="Leave" data-confirm="팀에서 나갈까요?|나가도 내 점수는 그대로예요.|탈퇴">
                @Html.AntiForgeryToken()
                <button class="ft-btn g" type="submit">팀 탈퇴</button>
            </form>
        }
    </div>
</div>

<script src="/js/qb-confirm.js" asp-append-version="true"></script>
<script src="/js/family-team-search.js" asp-append-version="true"></script>
<script>
(function () {
    // 내보내기 · 탈퇴는 한 번 더 묻는다  (data-confirm = "제목|설명|확인 버튼 글자")
    document.addEventListener('submit', async function (e) {
        var f = e.target.closest('form[data-confirm]');
        if (!f || f.dataset.ok === '1') return;
        e.preventDefault();
        var p = f.dataset.confirm.split('|');
        var r = await window.qbConfirm(true, [p[0], p[1] || ''], '', p[2] || '확인', '취소');
        if (r === 'y') { f.dataset.ok = '1'; f.submit(); }
    });
})();
</script>
</body>
</html>
