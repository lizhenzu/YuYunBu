@model BulletinBoard.Models.FileUploadViewModel

@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService

@*@{
    Layout = "_Layout_File";
}*@

@{
    ViewData["Title"] = "파일 업로드";

    var WeeklyWordToReadIDObject =  Context.Session.GetString(HTTPSessionKey.WeeklyWordToReadID.ToString());

    int WeeklyWordToReadID = 0;

    if (WeeklyWordToReadIDObject != null)
    {
        WeeklyWordToReadID = int.Parse(WeeklyWordToReadIDObject);
    }

}

<style>


    body {
    padding-top: 20px;
    }

    h2 {
    color: #007bff;
    margin-bottom: 20px;
    }

    .form-group {
    margin-bottom: 15px;
    }

    input[type="file"] {
    padding: 5px;
    }

    .btn-primary {
    background-color: #007bff;
    border-color: #007bff;
    }

    .btn-primary:hover {
    background-color: #0056b3;
    border-color: #0056b3;
    }
</style>
<h2>@ViewData["Title"]</h2>

<form asp-action="Upload" asp-controller="FileUpload" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="SelectedCategory" class="control-label"></label>
        <select asp-for="SelectedCategory" class="form-control" asp-items="@Model.Categorys" style="height: auto;">
            <option value="">Select Gender</option>
        </select>
    </div>
 

    <input type="hidden" id="YYear" name="YYear" value="@Model.YYear" />
    <input type="hidden" id="MMonth" name="MMonth" value="@Model.MMonth" />
    <input type="hidden" id="WWeek" name="WWeek" value="@Model.WWeek" />
    <input type="hidden" id="Id" name="Id" value="@Model.Id" />
    <input type="hidden" id="WeeklyWordToReadID" name="WeeklyWordToReadID" value="@WeeklyWordToReadID" />

    <div class="form-group">
        <label asp-for="FileKoreanName" class="control-label"></label>
        <input asp-for="FileKoreanName" class="form-control" />
        <span asp-validation-for="FileKoreanName" class="text-danger"></span>
    </div>
 
    <div class="form-group">
        <label asp-for="UploadedFile1" class="control-label"></label>
        <input asp-for="UploadedFile1" type="file" class="form-control" />
        <span asp-validation-for="UploadedFile1" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="UploadedFile2" class="control-label"></label>
        <input asp-for="UploadedFile2" type="file" class="form-control" />
        <span asp-validation-for="UploadedFile2" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="UploadedFile3" class="control-label"></label>
        <input asp-for="UploadedFile3" type="file" class="form-control" />
        <span asp-validation-for="UploadedFile3" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="UploadedFile4" class="control-label"></label>
        <input asp-for="UploadedFile4" type="file" class="form-control" />
        <span asp-validation-for="UploadedFile4" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="UploadedFile5" class="control-label"></label>
        <input asp-for="UploadedFile5" type="file" class="form-control" />
        <span asp-validation-for="UploadedFile5" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="UploadedFile6" class="control-label"></label>
        <input asp-for="UploadedFile6" type="file" class="form-control" />
        <span asp-validation-for="UploadedFile6" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="UploadedFile7" class="control-label"></label>
        <input asp-for="UploadedFile7" type="file" class="form-control" />
        <span asp-validation-for="UploadedFile7" class="text-danger"></span>
    </div> 
    <div class="form-group">
        <input type="submit" value="업로드" class="btn btn-primary" />
    </div>
</form>
<button onclick="redirectToPage('/WeeklyWordToRead/WeeklyWordToReadDetailList')">공과목록</button>
<button onclick="redirectToPage('/WeeklyReport/IndexByID?Id=@WeeklyWordToReadID')">공과본문으로가기</button>


<script>
    function redirectToPage(URL) {
        window.location.href = URL;
    }
</script>
@if (ViewBag.Message != null)
{
    <div class="alert alert-success">
        @ViewBag.Message
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


        