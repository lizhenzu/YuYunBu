@model BulletinBoard.Models.HealingAndRestorationPrays.HealingAndRestorationPray
@using BulletinBoard.Helpers
@using BulletinBoard.Common
@*  ══════════════════════════════════════════════════════════════
    치유와 회복 기도문 한 편 보기 — 밝은 흰색 (수험생 기도문 · pray-bright.css 와 같은 결)
    · 2026-10-11 시안 확정 — 흰 머리 + 파란 날짜, 본문 아래 2×2 알약 버튼 + 한 줄 전폭 "검증"(관리자만)
    · 검증은 부부 기도와 같은 방식: 누르면 연초록 "검증완료"(다시 눌리지 않음), 수정하면 다시 "검증 전"
    · 이전 화면(Bone 먹색)은 Detail.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;
    bool isSuper     = ViewBag.IsSuperAdmin is bool _s && _s;
    bool verifyReady = ViewBag.VerifyReady is bool _vr && _vr;
    DateTime kNow = ViewBag.TodayKst is DateTime _k ? _k : DateHelper.GetKoreaNow();
    string[] dayKor = { "일", "월", "화", "수", "목", "금", "토" };
    string dayStr = $"{dayKor[(int)kNow.DayOfWeek]}요일";

    var msg = TempData["Msg"] as string;

    // ── 공유 미리보기 — 이 기도문 제목이 보이게 ─────────────
    string ogDomain = (ViewBag.Domain as string ?? "").TrimEnd('/');
    string ogUrl    = $"{ogDomain}/HealingAndRestorationPray/Detail?PrayId={Model.PrayId}";
    string ogImage  = $"{ogDomain}/images/og/healing-restoration-pray.png";
    string ogTitle  = "치유와 회복을 위한 기도문";
    string ogDesc   = string.IsNullOrWhiteSpace(Model.Title) ? "아픈 이를 위해 함께 기도해요" : Model.Title;

    DateTime? touched = Model.UpdatedAt ?? (Model.CreatedAt == DateTime.MinValue ? (DateTime?)null : Model.CreatedAt);
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>@Model.Title · 치유와 회복을 위한 기도문</title>
    <meta name="description" content="@ogDesc" />

    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="@ogTitle" />
    <meta property="og:title"       content="@ogTitle" />
    <meta property="og:description" content="@ogDesc" />
    <meta property="og:url"         content="@ogUrl" />
    <meta property="og:image"       content="@ogImage" />
    <meta property="og:image:secure_url" content="@ogImage" />
    <meta property="og:image:type"  content="image/png" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"   content="@ogTitle" />
    <meta property="og:locale"      content="ko_KR" />
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content="@ogTitle" />
    <meta name="twitter:description" content="@ogDesc" />
    <meta name="twitter:image"       content="@ogImage" />

    <link rel="stylesheet" href="/css/mission3/bone.css" asp-append-version="true">
<style>
    :root { --fs: 1; }
    body { margin: 0; background: #F7F6F3; }

    .qz .epFs { display: flex; border: 1px solid var(--rule); }
    .qz .epFs button { background: none; border: 0; color: var(--dim); padding: 3px 8px; cursor: pointer; line-height: 1.4; }

    .qz .epHead { background: var(--tx); color: var(--bg); margin: 0 calc(var(--pad) * -1); padding: 30px var(--pad) 26px; }
    .qz .epK { font-size: 10px; font-weight: 600; letter-spacing: .26em; color: #C9AE82; }
    .qz .epH1 { font-weight: 400; font-size: 25px; line-height: 1.4; margin: 10px 0 0; color: var(--bg); word-break: keep-all; text-wrap: balance; }
    .qz .epDate { font-weight: 200; font-size: 44px; line-height: 1; margin-top: 18px; color: #D9C29B; font-variant-numeric: tabular-nums; }
    .qz .epDate small { font-size: 12px; font-weight: 400; color: #9A9690; margin-left: 8px; }

    .qz .epFlash { margin-top: 18px; padding: 11px 14px; font-size: 12.5px; }

    .qz .epBody { font-size: calc(15.5px * var(--fs)); line-height: 1.95; color: #2A2C30; margin: 24px 0 0; white-space: pre-line; word-break: keep-all; }
    .qz .epBody .nm { color: inherit; font-weight: 500; background: linear-gradient(transparent 60%, var(--mark) 60%); padding: 0 2px; }
    .qz .epQuote { border-left: 2px solid var(--acc); padding: 2px 0 2px 14px; margin-top: 24px; }
    .qz .epVr { font-size: 10px; font-weight: 600; letter-spacing: .16em; color: var(--acc); }
    .qz .epVt { font-size: calc(13.5px * var(--fs)); line-height: 1.9; color: var(--dim2); margin: 8px 0 0; word-break: keep-all; }

    @@media print { .qzBar, .hrAct { display: none !important; } }
</style>
    <link rel="stylesheet" href="/css/pray-bright.css" asp-append-version="true">
<style>
    /* ── 이 화면만 — 수정일 · 아래 버튼(부부 기도와 같은 2×2 + 한 줄 전폭 검증) ── */
    .qz .hrStamp { margin-top: 14px; text-align: right; font-size: 11px; color: #9CA3AF; font-variant-numeric: tabular-nums; }
    .qz .hrAct { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
    .qz .hrAct a { flex: 1 1 calc(50% - 4px); min-width: 0; height: 46px; border-radius: 14px; display: grid; place-items: center;
                   font-size: 14px; font-weight: 800; background: #EAF2FD; color: #2F80ED; text-decoration: none; }
    .qz .hrAct a:hover { background: #DCEAFB; }
    .qz .hrAct .vf { flex: 1 1 100%; margin: 0; }
    .qz .hrAct .vb { width: 100%; height: 46px; border: 0; border-radius: 14px; font: inherit; font-size: 14px; font-weight: 800;
                     background: #EAF2FD; color: #2F80ED; cursor: pointer; }
    .qz .hrAct .vb:hover:not(:disabled) { background: #DCEAFB; }
    .qz .hrAct .vb:disabled { background: #E8F6EE; color: #1B7A4B; cursor: default; }
    .qz .hrAct .vby { flex: 1 1 100%; margin-top: -2px; text-align: center; font-size: 11px; color: #9CA3AF; font-variant-numeric: tabular-nums; }
</style>
</head>
<body>

<div class="qz">
    <div class="qzBody">

        <div class="qzBar">
            <div>
                <a class="qzHome" href="/">@ConstatsCommon.ToHome</a><span class="qzHomeSep">·</span><a class="qzHome" href="/HealingAndRestorationPray/Index">오늘의 기도</a>
            </div>
            <div class="epFs" role="group" aria-label="기도문 글자 크기">
                <button type="button" id="pfsDn" onclick="stepPFs(-1)" aria-label="글자 작게">가−</button>
                <button type="button" id="pfsPct" onclick="setPFs('m')" aria-label="글자 크기 100%로 되돌리기" title="100%로 되돌리기">100%</button>
                <button type="button" id="pfsUp" onclick="stepPFs(1)" aria-label="글자 크게">가+</button>
            </div>
        </div>

        <header class="epHead">
            <div class="epK">치유와 회복을 위한 기도문</div>
            <h1 class="epH1">@Model.Title</h1>
            <div class="epDate">@kNow.ToString("MM.dd")<small>@dayStr</small></div>
        </header>

        @if (!string.IsNullOrEmpty(msg)) { <div class="epFlash">@msg</div> }

        <article>
            <p class="epBody">@PrayTextHelper.MarkNames(Model.PrayText)</p>

            @if (!string.IsNullOrWhiteSpace(Model.BibleText) || !string.IsNullOrWhiteSpace(Model.BibleRef))
            {
                <div class="epQuote">
                    @if (!string.IsNullOrWhiteSpace(Model.BibleRef))
                    {
                        <div class="epVr">@Model.BibleRef</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.BibleText))
                    {
                        <p class="epVt">@Model.BibleText</p>
                    }
                </div>
            }
        </article>

        @if (touched.HasValue)
        {
            <div class="hrStamp">@(Model.UpdatedAt.HasValue ? "수정일" : "등록일") @touched.Value.ToString("yyyy-MM-dd")</div>
        }

        <div class="hrAct">
            <a href="/HealingAndRestorationPray/Index">오늘의 기도</a>
            <a href="/">@ConstatsCommon.ToHome</a>
            @if (isSuper)
            {
                @* 목록 · 수정 · 검증은 기도 관리자(Basic · SuperAdmin 계정)만 *@
                <a href="/HealingAndRestorationPray/List">목록</a>
                <a href="/HealingAndRestorationPray/Edit?PrayId=@Model.PrayId">수정</a>

                @* 검증 — 한 줄 전폭. 끝나면 연초록 "검증완료" 로 바뀌고 눌러지지 않는다. 표에 검증 칸이 생기기 전에는 숨긴다 *@
                if (verifyReady)
                {
                    <form class="vf" method="post" action="/HealingAndRestorationPray/Verify">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PrayId" value="@Model.PrayId" />
                        @if (Model.IsVerified)
                        {
                            <button type="button" class="vb" disabled>검증완료</button>
                        }
                        else
                        {
                            <button type="submit" class="vb">검증</button>
                        }
                    </form>
                    @if (Model.IsVerified && Model.VerifiedDT.HasValue)
                    {
                        <div class="vby">@Model.VerifiedDT.Value.ToString("yyyy-MM-dd HH:mm")@(string.IsNullOrWhiteSpace(Model.VerifiedBy) ? "" : " · " + Model.VerifiedBy)</div>
                    }
                }
            }
        </div>

    </div>
</div>

<script>
/* 기도문 글자 크기 — 가− 100% 가+ (다른 기도문 화면과 같은 저장 키 ppFs · 단계 s/m/l/xl) */
(function () {
    var MAP = { s: 0.90, m: 1, l: 1.18, xl: 1.36 }, ORD = ['s', 'm', 'l', 'xl'];
    window.setPFs = function (k, silent) {
        if (!MAP[k]) k = 'm';
        document.documentElement.style.setProperty('--fs', MAP[k]);
        var pct = document.getElementById('pfsPct'); if (pct) pct.textContent = Math.round(MAP[k] * 100) + '%';
        var ix = ORD.indexOf(k);
        var dn = document.getElementById('pfsDn'), up = document.getElementById('pfsUp');
        if (dn) dn.disabled = ix <= 0;
        if (up) up.disabled = ix >= ORD.length - 1;
        window.__pfsKey = k;
        if (!silent) { try { localStorage.setItem('ppFs', k); } catch (e) { } }
    };
    window.stepPFs = function (d) {
        var ix = ORD.indexOf(window.__pfsKey || 'm') + d;
        setPFs(ORD[Math.max(0, Math.min(ORD.length - 1, ix))]);
    };
    var saved = 'm';
    try { saved = localStorage.getItem('ppFs') || 'm'; } catch (e) { }
    setPFs(saved, true);
})();
</script>

</body>
</html>
