@model BulletinBoard.Models.HealingAndRestorationPrays.HealingAndRestorationPray
@*  ══════════════════════════════════════════════════════════════
    치유와 회복 기도문 등록 · 수정 — 밝은 흰색 (관리자 전용, pray-bright.css 와 같은 결)
    · 2026-10-11 시안 확정 — 둥근 흰 입력칸 + 파란 포커스, 사용/숨김 알약 토글
    · 검증된 기도문을 열면 맨 위에 "저장하면 검증이 풀려요" 안내 (부부 기도와 같은 규칙)
    · Create 와 Edit 가 함께 쓴다. 이전 화면(Bone 먹색)은 Edit.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;
    bool isNew = Model == null || Model.PrayId <= 0;
    var err = TempData["Error"] as string;
    bool useN = Model != null && string.Equals(Model.UseYN, "N", StringComparison.OrdinalIgnoreCase);
    bool verifyReady = ViewBag.VerifyReady is bool _vr && _vr;
    bool wasVerified = !isNew && verifyReady && Model != null && Model.IsVerified;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>@(isNew ? "기도문 등록" : "기도문 수정") · 치유와 회복을 위한 기도문</title>
    <link rel="stylesheet" href="/css/mission3/bone.css" asp-append-version="true">
    <link rel="stylesheet" href="/css/pray-bright.css" asp-append-version="true">
<style>
    /* ── 머리 ── */
    .qz .edHead { padding: 20px 0 0; }
    .qz .edK { font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
    .qz .edH1 { margin: 6px 0 0; font-size: 24px; font-weight: 800; letter-spacing: -.02em; line-height: 1.35; color: #111827; }
    .qz .edS { margin-top: 8px; font-size: 12.5px; color: #6B7280; }

    .qz .edFlash { margin-top: 16px; padding: 11px 14px; border-radius: 12px; background: #FDEEEE; color: #D9534F; font-size: 12.5px; }
    .qz .edWarn { margin-top: 14px; padding: 11px 14px; border-radius: 12px; background: #FFF7E6; color: #B45309; font-size: 12.5px; line-height: 1.6; }
    .qz .edWarn b { color: #92400E; font-weight: 800; }

    /* ── 칸 묶음 ── */
    .qz .edSec { display: flex; justify-content: space-between; align-items: baseline; margin-top: 22px; padding-top: 14px; border-top: 1px solid #EEF0F3; }
    .qz .edSecT { font-size: 15px; font-weight: 800; color: #111827; }
    .qz .edSecS { font-size: 11px; font-weight: 700; color: #9CA3AF; }

    .qz .edField { margin-top: 14px; }
    .qz .edLb { display: block; margin-bottom: 6px; font-size: 12px; font-weight: 800; color: #6B7280; }
    .qz .edIn, .qz .edTa {
        width: 100%; box-sizing: border-box; font: inherit; font-size: 14px; color: #111827;
        background: #fff; border: 1px solid #E1E6EE; border-radius: 12px; padding: 11px 12px; outline: none;
    }
    .qz .edTa { font-size: 14.5px; line-height: 1.9; resize: vertical; min-height: 360px; }
    .qz .edIn:focus, .qz .edTa:focus { border-color: #2F80ED; box-shadow: 0 0 0 3px #EAF2FD; }
    .qz .edHint { margin-top: 6px; font-size: 11.5px; color: #9CA3AF; }

    .qz .edRow { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    /* 사용 / 숨김 — 알약 토글 */
    .qz .edRadio { display: flex; gap: 4px; padding: 3px; border-radius: 999px; background: #F4F6F9; }
    .qz .edRadio label { flex: 1; text-align: center; padding: 9px 0; border-radius: 999px; font-size: 13px; font-weight: 700; color: #6B7280; cursor: pointer; }
    .qz .edRadio input { position: absolute; opacity: 0; pointer-events: none; }
    .qz .edRadio label:has(input:checked) { background: #fff; color: #2F80ED; box-shadow: 0 1px 3px rgba(17,24,39,.1); }
    .qz .edRadio label:has(input:focus-visible) { outline: 2px solid #2F80ED; outline-offset: 1px; }

    /* ── 아래 버튼 ── */
    .qz .edActs { display: flex; gap: 8px; margin-top: 24px; }
    .qz .edBtn {
        flex: 1; height: 46px; display: grid; place-items: center; border: 0; border-radius: 14px;
        font: inherit; font-size: 14px; font-weight: 800; background: #F4F6F9; color: #6B7280; text-decoration: none; cursor: pointer;
    }
    .qz .edBtn:hover { color: #2F80ED; }
    .qz .edBtn.ink { flex: 2; background: #2F80ED; color: #fff; }
    .qz .edBtn.ink:hover { background: #1F6FDB; color: #fff; }
    .qz .edBtn.del { background: #FDEEEE; color: #D9534F; }
    .qz .edBtn.del:hover { color: #C0392B; }

    @@media (max-width: 420px) { .qz .edRow { grid-template-columns: 1fr; } }
</style>
</head>
<body>

<div class="qz">
    <div class="qzBody">

        <div class="qzBar">
            <div>
                <a class="qzHome" href="/HealingAndRestorationPray/List">목록</a><span class="qzHomeSep">·</span><a class="qzHome" href="/HealingAndRestorationPray/Index">오늘의 기도</a>
            </div>
            <div class="qzDate">관리자</div>
        </div>

        <header class="edHead">
            <div class="edK">치유와 회복을 위한 기도 · 관리자</div>
            <h1 class="edH1">@(isNew ? "새 기도문 등록" : "기도문 수정")</h1>
            <div class="edS">@(isNew ? "순서 번호가 작을수록 순환에서 먼저 나와요" : "조회수는 수정해도 그대로 유지돼요")</div>
        </header>

        @if (!string.IsNullOrEmpty(err)) { <div class="edFlash">@err</div> }

        @if (wasVerified)
        {
            <div class="edWarn">이 기도문은 <b>검증완료</b> 상태예요. 저장하면 검증이 풀려 <b>다시 검증</b>해야 해요.</div>
        }

        <form method="post" action="/HealingAndRestorationPray/Save">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PrayId" value="@(Model?.PrayId ?? 0)" />

            <div class="edSec"><span class="edSecT">기도문 내용</span><span class="edSecS">필수</span></div>

            <div class="edField">
                <label class="edLb" for="Title">기도 제목</label>
                <input class="edIn" id="Title" name="Title" maxlength="200" required
                       value="@(Model?.Title ?? "")" placeholder="예) 수술을 앞둔 분을 위하여" />
            </div>

            <div class="edField">
                <label class="edLb" for="PrayText">기도문</label>
                <textarea class="edTa" id="PrayText" name="PrayText" required rows="20"
                          placeholder="기도문을 입력해 주세요">@(Model?.PrayText ?? "")</textarea>
                <div class="edHint">줄바꿈이 화면에 그대로 나타나요 · **이름** 처럼 감싸면 파랗게 표시돼요</div>
            </div>

            <div class="edSec"><span class="edSecT">성경 구절</span><span class="edSecS">선택</span></div>

            <div class="edField">
                <label class="edLb" for="BibleRef">구절 표기</label>
                <input class="edIn" id="BibleRef" name="BibleRef" maxlength="100"
                       value="@(Model?.BibleRef ?? "")" placeholder="예) 시편 23:4" />
            </div>
            <div class="edField">
                <label class="edLb" for="BibleText">구절 본문</label>
                <input class="edIn" id="BibleText" name="BibleText" maxlength="1000"
                       value="@(Model?.BibleText ?? "")" placeholder="구절 내용을 입력해 주세요" />
            </div>

            <div class="edSec"><span class="edSecT">노출 설정</span><span class="edSecS"></span></div>

            <div class="edRow">
                <div class="edField">
                    <label class="edLb" for="SortOrder">순서 번호</label>
                    <input class="edIn" id="SortOrder" name="SortOrder" type="number" min="0" step="1"
                           value="@(Model?.SortOrder ?? 0)" />
                    <div class="edHint">작을수록 먼저 나와요</div>
                </div>
                <div class="edField">
                    <span class="edLb">사용 여부</span>
                    <div class="edRadio" role="radiogroup" aria-label="사용 여부">
                        <label><input type="radio" name="UseYN" value="Y" checked="@(!useN)" />사용</label>
                        <label><input type="radio" name="UseYN" value="N" checked="@useN" />숨김</label>
                    </div>
                    <div class="edHint">숨김은 순환에서 빠져요</div>
                </div>
            </div>

            <div class="edActs">
                <button type="submit" class="edBtn ink">@(isNew ? "등록하기" : "저장하기")</button>
                <a class="edBtn" href="/HealingAndRestorationPray/List">취소</a>
                @if (!isNew)
                {
                    <a class="edBtn del" href="/HealingAndRestorationPray/Delete?PrayId=@Model!.PrayId">삭제</a>
                }
            </div>
        </form>

    </div>
</div>

</body>
</html>
