</head>
@{
    int maxLimitHelpDeskHorizontal = 4;

    var todayDateHelpDeskHorizontal = DateHelper.GetTodayDateDayString(maxLimitHelpDeskHorizontal);

    // 문자열을 생성합니다.
    string formattedHelpDeskHorizontal = $"/images/home/HelpDesk/horizontal/HelpDesk_horizontal_{todayDateHelpDeskHorizontal}.webp";

}
<body>

    <!-- Header Section -->
    
    <!-- Banner Image Below Header -->
  @*  <img src="@formattedHelpDeskHorizontal" alt="Header Image" style="width: 100%; height: auto; margin: 0;">
*@

    <div class="container card-container">

        <header>
            <h1>게시판(톡!톡!)</h1>
        </header>

        <!-- 게시글 카드 -->
        <div class="card">
            <div class="card-header">
                <h3>@Model.Board.Title</h3>
                <h4>@Model.Board.Content</h4>
                <small class="text-muted">작성일: @Model.Board.CreatedDate</small>
            </div>
        @*    <div class="card-body">
                <p>@Model.Board.Content</p>
            </div>*@
        </div>

        <!-- 댓글 영역 -->
        <h3 class="mt-4">댓글</h3>
        <ul class="list-unstyled">
            @foreach (var comment in Model.Comments.Where(c => c.ParentCommentId == null))
            {
                <li>
                    @Html.Partial("_CommentPartial", comment)
                </li>
            }
        </ul>

        <!-- 댓글 입력 -->
        <div class="card mt-4">
            <div class="card-body">
                <h4>댓글 달기</h4>
                <textarea id="commentContent" class="form-control" rows="3" placeholder="댓글을 입력하세요"></textarea>
                <button class="btn btn-primary mt-2" onclick="submitComment(@Model.Board.Id)">댓글 등록</button>
            </div>
        </div>
    </div>
    <footer>
        <div class="footer-links">
            <a href="/">Home</a>
            <a href="/HelpDesk/Index2">목록으로</a>
        </div>
    </footer>
    <script>
        function showReplyForm(commentId) {
            document.getElementById('replyForm-' + commentId).style.display = 'block';
        }

        function submitComment(boardId) {
            var content = document.getElementById('commentContent').value;
            $.post('/HelpDesk/AddComment', { boardId: boardId, content: content }, function () {
                location.reload();
            });
        }

        function submitReply(boardId, parentCommentId) {
            var content = document.getElementById('replyContent-' + parentCommentId).value;
            $.post('/HelpDesk/AddComment', { boardId: boardId, content: content, parentCommentId: parentCommentId }, function () {
                location.reload();
            });
        }
    </script>

</body>
</html>
