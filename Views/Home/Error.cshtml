@{
    ViewData["Title"] = "Error";
    Layout = "_Layout"; // 프로젝트 상황에 맞게, 또는 null
}

<h2>오류가 발생했습니다.</h2>
<p>요청 처리 중 문제가 발생했습니다.</p>

@if (ViewBag.ErrorPath != null)
{
    <p><b>Path:</b> @ViewBag.ErrorPath</p>
}
@if (ViewBag.ErrorMessage != null)
{
    <p><b>Message:</b> @ViewBag.ErrorMessage</p>
}