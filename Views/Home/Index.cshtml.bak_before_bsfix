    <script src="/js/GlobalCookie.js"></script>

    <script>
        (function () {
            if ("serviceWorker" in navigator) {
                window.addEventListener("load", function () {
                    navigator.serviceWorker.register("/service-worker.js").catch(function () { });
                });
            }

            var ua = navigator.userAgent || "";
            var isIOS = /iphone|ipad|ipod/i.test(ua);
            var isStandaloneIOS = (window.navigator.standalone === true);

            var installBtn = document.getElementById("pwaInstallBtn");
            var howToBtn = document.getElementById("pwaHowToBtn");

            var isStandalone = window.matchMedia && window.matchMedia("(display-mode: standalone)").matches;
            if (isStandalone || isStandaloneIOS) {
                if (installBtn) installBtn.style.display = "none";
                if (howToBtn) howToBtn.style.display = "none";
                return;
            }

            if (isIOS) {
                if (howToBtn) howToBtn.style.display = "inline-flex";
                return;
            }

            var deferredPrompt = null;

            window.addEventListener("beforeinstallprompt", function (e) {
                e.preventDefault();
                deferredPrompt = e;

                if (installBtn) installBtn.style.display = "inline-flex";
            });

            if (installBtn) {
                installBtn.addEventListener("click", async function () {
                    if (!deferredPrompt) return;

                    deferredPrompt.prompt();
                    try { await deferredPrompt.userChoice; } catch (e) { }
                    deferredPrompt = null;
                    installBtn.style.display = "none";
                });
            }
        })();
    </script>

    <script>
        function wrGetAntiToken() {
            var form = document.getElementById('wrAntiForm');
            if (!form) return '';
            var input = form.querySelector('input[name="__RequestVerificationToken"]');
            return input ? input.value : '';
        }

        async function wrDefer(days) {
            try {
                if (days === 3 || days === 7) {
                    var token = wrGetAntiToken();
                    await fetch('/Home/DeferVBSParticipationSurveyGuide?days=' + encodeURIComponent(days), {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'RequestVerificationToken': token
                        },
                        body: ''
                    });
                }
            } catch (e) { }

            var back = document.getElementById('wrGuideBack');
            if (back) back.style.display = 'none';
        }
    </script>

    <script>
        (function () {
            var cta = document.querySelector('.mainCta');
            if (!cta) return;

            var milestone = parseInt(cta.getAttribute('data-milestone') || '0', 10) || 0;
            var justReached = (cta.getAttribute('data-justreached') === '1');

            var key = 'BB_GB_LAST_MILESTONE';
            var last = parseInt(localStorage.getItem(key) || '0', 10) || 0;

            var shouldFire = false;

            if (justReached && milestone >= 100) {
                shouldFire = true;
            } else if (milestone >= 100 && milestone > last) {
                shouldFire = true;
            }

            if (milestone >= 100) localStorage.setItem(key, String(milestone));
            if (!shouldFire) return;

            var layer = cta.querySelector('.gbConfetti');
            if (!layer) return;

            var count = 28;
            for (var i = 0; i < count; i++) {
                var p = document.createElement('i');
                var left = Math.random() * 100;
                var delay = Math.random() * 0.18;
                var dur = 0.95 + Math.random() * 0.55;
                var w = 8 + Math.random() * 8;
                var h = 10 + Math.random() * 12;

                p.style.left = left + '%';
                p.style.animationDelay = delay + 's';
                p.style.animationDuration = dur + 's';
                p.style.width = w + 'px';
                p.style.height = h + 'px';

                layer.appendChild(p);
            }

            setTimeout(function () {
                layer.innerHTML = '';
            }, 1800);
        })();
    </script>

