@{
    // =========================================================
    // ✅ GOLDEN-BELL CTA 상태(포인트/선물/마일스톤)
    // =========================================================
    int integratedTotal = 0;

    if (ViewBag.IntegratedTotal is int vi)
    {
        integratedTotal = vi;
    }
    else
    {
        int vParsed = 0;
        var s = (ViewBag.IntegratedTotal ?? "").ToString();
        if (!string.IsNullOrWhiteSpace(s) && int.TryParse(s, out vParsed))
            integratedTotal = vParsed;
    }

    bool giftAvailable = false;
    if (ViewBag.GiftAvailable is bool gb)
    {
        giftAvailable = gb;
    }
    else
    {
        bool gbParsed = false;
        var s = (ViewBag.GiftAvailable ?? "").ToString();
        if (!string.IsNullOrWhiteSpace(s) && bool.TryParse(s, out gbParsed))
            giftAvailable = gbParsed;
    }

    bool milestoneJustReached = false;
    if (ViewBag.MilestoneJustReached is bool mj)
    {
        milestoneJustReached = mj;
    }
    else
    {
        bool mjParsed = false;
        var s = (ViewBag.MilestoneJustReached ?? "").ToString();
        if (!string.IsNullOrWhiteSpace(s) && bool.TryParse(s, out mjParsed))
            milestoneJustReached = mjParsed;
    }

    bool reached100 = integratedTotal >= 100;
    int currentMilestone = integratedTotal > 0 ? (integratedTotal / 100) * 100 : 0;
    bool isMilestone = (integratedTotal >= 100 && integratedTotal % 100 == 0);
}

