        .hmBtn:hover, .hmBtn:focus-visible { background: #F4F6F9; outline: none; }

        /* 서랍 */
        .hmScrim { position: fixed; inset: 0; z-index: 9990; background: rgba(17,24,39,.45); opacity: 0; transition: opacity .2s; }
