    <script>
    (function () {
        var openBtn = document.getElementById('hmOpen'), drawer = document.getElementById('hmDrawer'),
            scrim = document.getElementById('hmScrim'), closeBtn = document.getElementById('hmClose');
        if (!openBtn || !drawer) return;
        var isOpen = false, pushed = false;
        function open() {
            if (isOpen) return; isOpen = true;
            scrim.hidden = false; requestAnimationFrame(function () { scrim.classList.add('on'); drawer.classList.add('on'); });
            drawer.setAttribute('aria-hidden', 'false'); openBtn.setAttribute('aria-expanded', 'true');
            document.body.classList.add('hmLock');
            try { history.pushState({ hm: 1 }, ''); pushed = true; } catch (e) { pushed = false; }   // 휴대폰 뒤로가기로 닫기
            setTimeout(function () { closeBtn.focus(); }, 60);
        }
        function close(fromPop) {
            if (!isOpen) return; isOpen = false;
            scrim.classList.remove('on'); drawer.classList.remove('on');
            drawer.setAttribute('aria-hidden', 'true'); openBtn.setAttribute('aria-expanded', 'false');
            document.body.classList.remove('hmLock');
            setTimeout(function () { if (!isOpen) scrim.hidden = true; }, 220);
            if (pushed && !fromPop) { pushed = false; history.back(); }
            pushed = false;
            openBtn.focus();
        }
        openBtn.addEventListener('click', open);
        closeBtn.addEventListener('click', function () { close(false); });
        scrim.addEventListener('click', function () { close(false); });
        document.addEventListener('keydown', function (e) {
            if (!isOpen) return;
            if (e.key === 'Escape') { close(false); return; }
            if (e.key === 'Tab') {   // 서랍 안에서만 이동
                var f = drawer.querySelectorAll('a[href], button:not([disabled])'); if (!f.length) return;
                var first = f[0], last = f[f.length - 1];
                if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
                else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
            }
        });
        window.addEventListener('popstate', function () { if (isOpen) close(true); });
        // 메뉴를 눌러 이동할 때는 서랍 기록을 남기지 않는다
        drawer.addEventListener('click', function (e) {
            var a = e.target.closest('a[href]'); if (!a || !pushed) return;
            e.preventDefault(); var href = a.getAttribute('href');
            pushed = false; isOpen = false; history.back();
            setTimeout(function () { location.href = href; }, 30);
        });
    })();
