          @{
              var bibleCompleted = _bibleUsers;
              var bibleCountMap  = ViewBag.BibleCompletedCountMap as Dictionary<string, int> ?? new Dictionary<string, int>();
              var _bcMap   = ViewBag.BibleCompletionMap as Dictionary<string, List<(int Round, DateTime Date)>>;
              var _pickMap = ViewBag.BibleGiftPickMap as Dictionary<string, BibleReadingThrough.Models.BibleGift.BibleGiftPickVM>;
          }
          @if (bibleCompleted != null && bibleCompleted.Count > 0)
          {
          <section class="btC">
              <div class="btKick">📖 <a class="btLink" href="/Bible2/Welcome" title="@ConstatsCommon.ReadBibleAllTitleButton 으로 가기">@ConstatsCommon.ReadBibleAllTitleButton <span class="ar">→</span></a></div>
              <div class="btHd">
                  <div class="t">완독을 축하해요!</div>
              </div>
              <div class="btSub">성경 100% 완독을 달성한 친구예요 🎉</div>

              @foreach (var u in bibleCompleted)
              {
                  bool isMyCard  = isSignedIn && user != null && user.Id == u.UserId;
                  int prevCount  = bibleCountMap.ContainsKey(u.UserId) ? bibleCountMap[u.UserId] : 0;
                  int totalCount = prevCount + 1;

                  // 회차별 날짜 — 지난 회차는 BibleCompletionLog, 이번 회차는 마지막 읽은 날(MAX ReadDate)
                  var _rounds = (_bcMap != null && _bcMap.ContainsKey(u.UserId)) ? _bcMap[u.UserId] : new List<(int Round, DateTime Date)>();
                  var _lastRead = u.ReadDate.Date;
                  var _dates = new Dictionary<int, DateTime>();
                  foreach (var r in _rounds) { _dates[r.Round] = r.Date.Date; }
                  _dates[totalCount] = _lastRead;
                  for (int r = 1; r <= totalCount; r++) { if (!_dates.ContainsKey(r)) { _dates[r] = _lastRead; } }
                  int lastGap = totalCount > 1 ? (int)(_dates[totalCount] - _dates[totalCount - 1]).TotalDays : 0;

                  double bEdge  = 100.0 / (totalCount * 2);
                  double bFill  = totalCount <= 1 ? 0 : (totalCount - 1) * (100.0 - 2 * bEdge) / (totalCount - 1);
                  double bVfill = totalCount <= 1 ? 0 : 100;
                  string photo  = (u.ProfilePicturePath ?? "").Trim();
                  bool hasPhoto = !string.IsNullOrWhiteSpace(photo) && !photo.Contains("people_01.webp");

                  <div class="btP">
                      <div class="btPHd">
                          <div class="btWho">
                              <div class="btAv">@if (hasPhoto) { <img src="@photo" alt="" loading="lazy" onerror="this.remove()" /> } else { <text>📖</text> }</div>
                              <div>
                                  <div class="n">@(u.LastName)@(u.FirstName)<small>@(totalCount)독 완료</small></div>
                                  <div class="s">
                                      @(totalCount == 1 ? "완독" : "최근 완독") <b>@_dates[totalCount].ToString("yyyy.MM.dd")</b>
                                      @if (false) { <text>· @(totalCount - 1)독 뒤 @(lastGap.ToString("N0"))일</text> }
                                  </div>
                              </div>
                          </div>
                          @if (isMyCard)
                          {
                              <a href="/Bible/ResetProgress?userId=@u.UserId" class="btHide">숨기기</a>
                          }
                          else
                          {
                              <span class="btHide">숨기기</span>
                          }
                      </div>

                      <div class="btTL" style="grid-template-columns: repeat(@totalCount, 1fr); --edge: @(bEdge.ToString("0.##"))%; --hfill: @(bFill.ToString("0.##"))%; --vfill: @(bVfill.ToString("0.#"))%;">
                          <div class="fill"></div>
                          @for (int d = 0; d < totalCount; d++)
                          {
                              int  roundNo   = d + 1;
                              bool isCurrent = (d == totalCount - 1);
                              BibleReadingThrough.Models.BibleGift.BibleGiftPickVM _pick = null;
                              if (_pickMap != null && u.UserId != null)
                                  _pickMap.TryGetValue(BibleReadingThrough.Models.BibleGift.BibleGiftKeys.Of(u.UserId, roundNo), out _pick);
                              string ndCls = (isCurrent && _pick == null) ? "now" : "done";

                              <div class="btN @ndCls">
                                  <div class="hdr">
                                      <div class="pt">@(roundNo)독 @if (isCurrent) { <span class="new">NEW</span> }</div>
                                      @* 날짜는 마지막(이번) 독에만 — 지난 독은 회차만 *@
                                      @if (isCurrent)
                                      {
                                          <div class="kind">@_dates[roundNo].ToString("yyyy.MM.dd")</div>
                                      }
                                      else
                                      {
                                          <div class="kind">완료</div>
                                      }
                                  </div>
                                  @if (_pick != null)
                                  {
                                      string stCls = _pick.Status switch { "DELIVERED" => "done", "PURCHASED" => "buy", _ => "pick" };
                                      if (canManageGifts)
                                      {
                                          @* 관리자만 — 선물 칸을 누르면 통합 선물 관리로 (사진 크게 보기는 그 화면에서) *@
                                          <a class="btB gift lnk" href="/StudentPointDashboard4/AdminPurchaseList" title="관리자 — 통합 선물 관리로">
                                              <img src="@_pick.ImageUrl" alt="@_pick.ProductName"
                                                   onerror="this.onerror=null;this.src='/images/icon/gift_default.png';this.style.opacity='.5';" />
                                              <div><div class="gn">@_pick.ProductName</div><span class="st @stCls">@_pick.StatusLabel</span></div>
                                          </a>
                                      }
                                      else
                                      {
                                          <div class="btB gift">
