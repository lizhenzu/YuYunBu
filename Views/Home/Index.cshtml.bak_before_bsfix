          @* ── 선물 고를 수 있음 (②안 크림색 + 달성 도장, 문구 "가안") ──────────────
             조건은 HasAffordableGift 다. "팝업을 봤는지"(eval.Show)와 무관하게 고를 수 있는 동안 계속 보인다.
             학생이 아니면 서비스에서 이미 false 로 온다.
             · 도장     : 달성한 나의 도토리 단계 (100점 단위, 최대 2,000점)
             · 제목     : "나의 도토리 N점에 도달했어요!"
             · 설명     : "선물을 고를 수 있어요 · 쌓은 X credit으로 …"  (크레딧은 문장 안)
             · 막대     : 다음 100점 단계까지 남은 점수
             카드 안이 아니라 밖에 두는 이유 : 카드 전체가 이미 링크라 중첩되면 안 된다. *@
          @{
              int _giftCredit = ViewBag.GiftCredit is int _gc ? _gc : 0;
              const int _giftCap = 2000;
              int _giftMs     = Math.Min(_giftCap, Math.Max(0, integratedTotal) / 100 * 100);
              bool _giftTop   = integratedTotal >= _giftCap;
              int _giftNext   = _giftTop ? 0 : _giftMs + 100;
              int _giftRemain = _giftTop ? 0 : Math.Max(0, _giftNext - integratedTotal);
              int _giftPct    = _giftTop ? 100 : (int)Math.Round((integratedTotal - _giftMs) * 100.0 / 100);

              // ── 2026-09-26 개선: 고른 선물 + 진행 타임라인(골랐어요 → 선생님 구매 → 주일 전달) + 지난 선물 ──
              //    데이터: ViewBag.MyGiftTimeline (HomeController — 나의 개인 선물 주문, 가족팀·가족합산 제외)
              var _giftDraft = ViewBag.GiftCurrentDraft as BulletinBoard.Services.Abstract.GiftOrderVM;
              var _giftMyTl  = ViewBag.MyGiftTimeline as BulletinBoard.ViewModels.Home.GiftTimelineKidVM;
              var _giftItems = _giftMyTl?.Items ?? new List<BulletinBoard.ViewModels.Home.GiftTimelineItemVM>();

              // 지금 진행 중인 선물: 신청중(가장 최근) → 없으면 구매완료(가장 최근)
              var _giftCur = _giftItems.Where(i => i.Status == "DRAFT").OrderByDescending(i => i.CreatedAt).FirstOrDefault()
                          ?? _giftItems.Where(i => i.Status == "PURCHASED").OrderByDescending(i => i.PurchasedAt ?? i.CreatedAt).FirstOrDefault();
              // 목록 조회가 실패해도 신청중 선물은 선물함 값으로 보여 준다
              if (_giftCur == null && _giftDraft != null)
                  _giftCur = new BulletinBoard.ViewModels.Home.GiftTimelineItemVM
                  {
                      Milestone = _giftDraft.Milestone, ProductID = _giftDraft.ProductID, ProductName = _giftDraft.ProductName,
                      Status = "DRAFT", CreatedAt = _giftDraft.CreatedAt, CreditCost = _giftDraft.CreditCostSnapshot
                  };
              bool _giftIsReq = _giftCur?.Status == "DRAFT";
              bool _giftIsBuy = _giftCur?.Status == "PURCHASED";
              var _giftPast = _giftItems.Where(i => i.Status == "HIDDEN").OrderBy(i => i.Milestone).ThenBy(i => i.CreatedAt).ToList();

              // 전달일은 저장되지 않으므로 "이번 주일" 예정으로만 보여 준다 (오늘이 주일이면 오늘)
              var _giftToday  = DateHelper.GetKoreaToday();
              var _giftSunday = _giftToday.AddDays((7 - (int)_giftToday.DayOfWeek) % 7);
              var _giftInv    = System.Globalization.CultureInfo.InvariantCulture;   // "M/d" 가 "9-27" 로 바뀌지 않게

              // 버튼: 신청중 → 선물함에서 변경 / 고를 수 있음 → 고르기 / 구매완료만 → 선물함 보기
              string _giftHref, _giftGo; bool _giftGhost = false;
              if (_giftIsReq)        { _giftHref = "/StudentPointDashboard4/MyGiftBox3"; _giftGo = "선물 변경하기 ›"; }
              else if (giftAvailable) { _giftHref = "/StudentPointDashboard4/GiftSelect?type=point&returnTo=home"; _giftGo = _giftCur == null ? "선물 고르기 ›" : "새 선물 고르기 ›"; }
              else                   { _giftHref = "/StudentPointDashboard4/MyGiftBox3"; _giftGo = "선물함 보기 ›"; _giftGhost = true; }
          }
          @if (giftAvailable || _giftCur != null)
          {
              @* 로그인한 아이 본인에게만 보이는 카드.
                 고를 수 있으면 선물함을 거치지 않고 바로 고르는 화면으로 (저장하면 returnTo=home 으로 홈에 돌아온다).
                 신청중이면 선물함(MyGiftBox3)에서 바꾸게 하고, 구매가 끝나면 바꿀 수 없으니 선물함 보기로. *@
              <a class="gcb" href="@_giftHref" aria-label="@_giftGo.TrimEnd('›', ' ')">
                  @if (_giftMs > 0)
                  {
                      <span class="gcb-stamp" aria-hidden="true">
                          <span class="gcb-stamp-n">@(_giftMs.ToString("N0"))점</span>
                          <span class="gcb-stamp-l">달성</span>
                      </span>
                  }
                  <span class="gcb-body">
                      <span class="gcb-k">🎁 나의 선물함</span>
                      <span class="gcb-t">
                          @if (_giftMs > 0)
                          {
                              <text>@ConstatsCommon.myDoToRi <mark>@(_giftMs.ToString("N0"))점</mark>에 도달했어요!</text>
                          }
                          else
                          {
                              <text>선물을 고를 수 있어요!</text>
                          }
                      </span>
                  </span>

                  @if (_giftCur != null)
                  {
                      @* 내가 고른 선물 + 지금 상태 *@
                      <span class="gcb-pick">
                          <span class="gcb-im"><img src="/images/AwardItem/@(_giftCur.ProductID).jpg" alt="" loading="lazy" onerror="this.parentNode.classList.add('noimg');this.remove();" /></span>
                          <span class="gcb-px">
                              <span class="gcb-pl">내가 고른 선물</span>
                              <span class="gcb-pn">@_giftCur.ProductName</span>
                              <span class="gcb-pm">
                                  @if (_giftCur.Milestone > 0) { <b>@(_giftCur.Milestone.ToString("N0"))</b><text>점 선물</text> }
                                  @if (_giftCur.Milestone > 0 && _giftCur.CreditCost > 0) { <text> · </text> }
                                  @if (_giftCur.CreditCost > 0) { <b>@(_giftCur.CreditCost.ToString("N0"))</b><text> credit</text> }
                              </span>
                          </span>
                          <span class="gcb-bdg @(_giftIsBuy ? "buy" : "req")">@(_giftIsBuy ? "구매완료" : "신청중")</span>
                      </span>

                      @* 진행 타임라인 — PC 가로 · 휴대폰 세로 *@
                      <span class="gcb-steps">
                          <span class="gcb-st ok">
                              <span class="d">✓</span><span class="h">선물 골랐어요</span><span class="w">@_giftCur.CreatedAt.ToString("M/d", _giftInv)</span>
                          </span>
                          @if (_giftIsBuy)
                          {
                              <span class="gcb-st ok">
                                  <span class="d">✓</span><span class="h">선생님이 구매했어요</span><span class="w">@(_giftCur.PurchasedAt?.ToString("M/d", _giftInv) ?? "")</span>
                              </span>
                              <span class="gcb-st cur buy">
                                  <span class="d"></span><span class="h">주일 예배 때 전달</span><span class="w">@_giftSunday.ToString("M/d", _giftInv) 예정</span>
                              </span>
                          }
                          else
                          {
                              <span class="gcb-st cur req">
                                  <span class="d"></span><span class="h">선생님이 확인·구매</span><span class="w">기다리는 중</span>
                              </span>
                              <span class="gcb-st todo">
                                  <span class="d"></span><span class="h">주일 예배 때 전달</span><span class="w"></span>
                              </span>
                          }
                      </span>
                      <span class="gcb-now">
                          @if (_giftIsBuy)
                          {
                              <text>지금: <b>선물이 준비됐어요!</b> @(_giftSunday == _giftToday ? "오늘" : "이번 주일(" + _giftSunday.ToString("M/d", _giftInv) + ")") 예배 시간에 받아요 🎉</text>
                          }
                          else
                          {
                              <text>지금: <b>선생님이 고른 선물을 확인하고 있어요.</b> 확인 전까지는 다른 선물로 바꿀 수 있어요.</text>
                          }
                      </span>
                  }
                  else
                  {
                      @* 아직 안 골랐을 때 *@
                      <span class="gcb-pick empty">
                          <span class="gcb-im">🎁</span>
                          <span class="gcb-px">
                              <span class="gcb-pl">아직 고른 선물이 없어요</span>
                              <span class="gcb-pn">@(_giftMs > 0 ? _giftMs.ToString("N0") + "점 선물을 골라 보세요" : "원하는 선물을 골라 보세요")</span>
                              <span class="gcb-pm">
                                  @if (_giftCredit > 0) { <text>쌓은 </text><b>@_giftCredit.ToString("N0")</b><text> credit으로 고를 수 있어요</text> }
                                  else { <text>쌓은 크레딧으로 고를 수 있어요</text> }
                              </span>
                          </span>
                      </span>
                      <span class="gcb-chips" aria-hidden="true">
                          <span>📖 성경말씀</span><span>📒 미션북</span><span>🌼 감사</span><span>⛪ 출석</span>
                      </span>
                  }
                  <span class="gcb-foot">
                      <span class="gcb-bar-wrap">
                          <span class="gcb-bar"><i style="width:@(Math.Clamp(_giftPct, 0, 100))%"></i></span>
                          <span class="gcb-bar-t">
                              @if (_giftTop)
