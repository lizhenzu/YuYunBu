          @* ── @ConstatsCommon.MainKeyTitle 카드 ── *@
          @{
              var _dm2Word = ViewBag.DM2TodayWord as BulletinBoard.Models.DailyMission2.TodayWordDetailResult;
              var _dm2Map  = ViewBag.DM2DoneMap  as Dictionary<string, bool>;
              var _dm2Now  = DateHelper.GetKoreaNow().Date;
              string _dm2Scripture = _dm2Word != null
                  ? BulletinBoard.Common.SharedComm.MakeBibleSerialJangZul(
                        _dm2Word.BibleText, _dm2Word.FromJang, _dm2Word.FromZul, _dm2Word.ToJang, _dm2Word.ToZul)
                  : "";
              // 마지막 수행일 계산 (최근 30일 내 done=true 최신 날짜)
              DateTime? _dm2LastDone = null;
              if (_dm2Map != null)
              {
                  for (int _di = 0; _di <= 30; _di++)
                  {
                      var _dk = _dm2Now.AddDays(-_di).ToString("yyyy-MM-dd");
                      if (_dm2Map.TryGetValue(_dk, out var _dv) && _dv)
                      {
                          _dm2LastDone = _dm2Now.AddDays(-_di);
                          break;
                      }
                  }
              }
              string _dm2DateStr = _dm2LastDone == null ? "수행 기록 없음"
                  : _dm2LastDone.Value == _dm2Now          ? "오늘"
                  : _dm2LastDone.Value == _dm2Now.AddDays(-1) ? "어제"
                  : $"{(_dm2Now - _dm2LastDone.Value).Days}일 전";
          }
          @{
              int _dm2Total = ViewBag.DM2BiblePoint is int _it ? _it : 0;
              // 연간 진행 위치: 2/1 ~ 12/31
              var _dm2Start   = new DateTime(_dm2Now.Year, 2, 1);
              var _dm2End     = new DateTime(_dm2Now.Year, 12, 31);
              int _dm2TotalDays   = (int)(_dm2End - _dm2Start).TotalDays + 1;   // 전체 일수
              int _dm2ElapsedDays = (int)(_dm2Now - _dm2Start).TotalDays + 1;   // 경과 일수
              _dm2ElapsedDays = Math.Max(1, Math.Min(_dm2ElapsedDays, _dm2TotalDays));
              int _dm2Pct = (int)Math.Round(_dm2ElapsedDays * 100.0 / _dm2TotalDays);
              int _dm2JoinCount = ViewBag.DM2TodayJoinCount is int _jc ? _jc : 0;
              // 수치 노출 대상: basic 계정 · SuperAdmin
              bool _showStats = ViewBag.ShowHomeStats is bool _ss && _ss;
