        <!-- ④-0 달콤한 도토리 도장카드 (성장 단계형) -->
        @if (isSignedIn && integratedTotal >= 0)
        {
            int _acornPer = 100;
            int _totalSlots = 17;
            int _filled = Math.Min(integratedTotal / _acornPer, _totalSlots);
            bool _hasPartial = integratedTotal % _acornPer != 0 && _filled < _totalSlots;
            int _rem = integratedTotal % _acornPer;
            int _nextPts = _rem == 0 ? _acornPer : _acornPer - _rem;

            // 현재 단계
            string _stageKey = _filled <= 3 ? "seed" : _filled <= 8 ? "sprout" : _filled <= 12 ? "tree" : "forest";

            // 진행바 상태
            bool _seedDone   = _filled >= 4;
            bool _sproutDone = _filled >= 9;
            bool _treeDone   = _filled >= 13;
            bool _forestDone = _filled >= 17;
            string _seedSt   = _seedDone   ? "done" : _stageKey == "seed"   ? "active" : "locked";
            string _sproutSt = _sproutDone ? "done" : _stageKey == "sprout" ? "active" : "locked";
            string _treeSt   = _treeDone   ? "done" : _stageKey == "tree"   ? "active" : "locked";
            string _forestSt = _forestDone ? "done" : _stageKey == "forest" ? "active" : "locked";
            string _conn1 = _seedDone   ? (_sproutSt != "locked" ? "done" : "half") : "locked";
            string _conn2 = _sproutDone ? (_treeSt   != "locked" ? "done" : "half") : "locked";
            string _conn3 = _treeDone   ? (_forestSt != "locked" ? "done" : "half") : "locked";

            // 현재 단계 진행률
            int _stageStart = _stageKey == "seed" ? 0 : _stageKey == "sprout" ? 400 : _stageKey == "tree" ? 900 : 1300;
            int _stageEnd   = _stageKey == "seed" ? 400 : _stageKey == "sprout" ? 900 : _stageKey == "tree" ? 1300 : 1700;
            int _stagePct   = _stageEnd > _stageStart ? Math.Min(100, (integratedTotal - _stageStart) * 100 / (_stageEnd - _stageStart)) : 100;

            // 하단 메시지
            string _stageEmoji = _stageKey == "seed" ? "🌱" : _stageKey == "sprout" ? "🌿" : "🌲";
            string _acornMsg   = integratedTotal >= 1700 ? "🎉 숲 단계 완성! 최고예요!"
                : integratedTotal == 0 ? "도토리 모으기를 시작해볼까요! 💪"
                : $"{_stageEmoji} 다음 도토리까지 {_nextPts}점 남았어요!";
            string _msgCls = integratedTotal >= 1700 ? "done-msg"
                : _stageKey == "seed" ? "seed-msg" : _stageKey == "sprout" ? "sprout-msg"
                : _stageKey == "tree" ? "tree-msg" : "forest-msg";

            // 단계 정의: (key, emoji, name, range, secCls, slotCls, startIdx, endIdx, c1, c2, c3, stemColor, capColor)
            var _stages = new (string key, string emoji, string name, string range, string secCls, string slotCls, int si, int ei, string c1, string c2, string c3, string sc, string cc)[]
            {
                ("seed",   "🌰", "씨앗", "1 ~ 400점",      "sec-seed",   "slot-seed-filled",    0,  3, "#fde68a", "#f59e0b", "#b45309", "#4a2c0a", "#3b1700"),
                ("sprout", "🌱", "새싹", "401 ~ 900점",     "sec-sprout", "slot-sprout-filled",  4,  8, "#d1fae5", "#4ade80", "#16a34a", "#166534", "#14532d"),
                ("tree",   "🌿", "나무", "901 ~ 1,300점",   "sec-tree",   "slot-tree-filled",    9, 12, "#bbf7d0", "#22c55e", "#15803d", "#14532d", "#052e16"),
                ("forest", "🌲", "숲",   "1,301 ~ 1,700점", "sec-forest", "slot-forest-filled", 13, 16, "#6ee7b7", "#059669", "#064e3b", "#052e16", "#022c22"),
            };

                // ── B안: 지금 단계를 크게 + 네 칸 막대 ──
                var _gStages = new (string key, string name, string emoji, int from, int to)[]
                {
                    ("seed",   "씨앗", "🌰",    0,  400),
                    ("sprout", "새싹", "🌱",  400,  900),
                    ("tree",   "나무", "🌿",  900, 1300),
                    ("forest", "숲",   "🌲", 1300, 1700),
                };
                int _gIdx = Array.FindIndex(_gStages, x => x.key == _stageKey);
                var _gNow = _gStages[_gIdx];
                bool _gAllDone = integratedTotal >= 1700;
                string[] _gTitles = { "씨앗으로 자라는 중", "새싹으로 자라는 중", "나무로 자라는 중", "숲으로 자라는 중" };
                string _gTitle = _gAllDone ? "숲까지 모두 자랐어요" : _gTitles[_gIdx];
                string _gNext  = _gAllDone ? "최고 단계에 도착했어요"
                               : _gIdx < 3 ? $"{_gStages[_gIdx + 1].name}까지 {(_gNow.to - integratedTotal):N0}점"
                               : $"숲 완성까지 {(_gNow.to - integratedTotal):N0}점";
            @* 도토리 성장일지 카드(.agc)는 2026-10-04 맨 위 인사 카드(<header class="hero">) 안으로 합쳤다(A안) — 같은 계산식이 거기에 있다 *@

            @* 도토리 성장일지 카드 바로 아래 — 본인 생일이 다가온 학생에게만 보인다 *@
            @await Html.PartialAsync("_Banner_NotifyPersonelHappyComingBirthday")

            @* ── 마일스톤 달성 선물 알림 (stamp card 바로 아래) ──
               위쪽 성경말씀 카드 아래에 '선물을 고를 수 있어요' 배너가 이미 떠 있으면
               같은 말을 두 번 하는 셈이라 여기서는 내보내지 않는다. *@
            @if (milestoneJustReached && !giftAvailable)
