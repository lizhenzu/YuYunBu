<body>
    @* ── 맨 위 고정 바 + 햄버거(☰) 메뉴 (2026-10-05 A안 확정: 오른쪽 서랍 · 목록형 · 4묶음) ──
       · 예전 홈 아래쪽 메뉴 버튼 11개(menuGroupBox)를 옮겼다.  누가 보는지는 예전과 같은 조건(MenuAllowed · isSuperAdmin)
       · 닫기: ✕ · 바깥 누르기 · ESC · 휴대폰 뒤로가기 *@
    @{
        var hmIcon = new Dictionary<string, string>
        {
            ["word"]    = "<path d=\"M4 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H4z\"/><path d=\"M20 5h-4a2 2 0 0 0-2 2\"/>",
            ["music"]   = "<path d=\"M9 18V5l11-2v13\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><circle cx=\"17\" cy=\"16\" r=\"3\"/>",
            ["lesson"]  = "<rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2\"/><path d=\"M9 7h6M9 11h6M9 15h4\"/>",
            ["pray"]    = "<path d=\"M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z\"/>",
            ["chat"]    = "<path d=\"M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z\"/>",
            ["photo"]   = "<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><circle cx=\"9\" cy=\"10\" r=\"2\"/><path d=\"M21 16l-5-5-8 8\"/>",
            ["event"]   = "<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/>",
            ["vote"]    = "<path d=\"M8 12l3 3 5-6\"/><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"/>",
            ["gift"]    = "<rect x=\"3\" y=\"8\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M3 12h18M12 8v13\"/><path d=\"M12 8c-2-4-6-4-6-1s6 1 6 1 6 2 6-1-4-3-6 1z\"/>",
            ["memo"]    = "<path d=\"M4 4h16v12H8l-4 4z\"/><path d=\"M8 9h8M8 12h5\"/>",
            ["teacher"] = "<circle cx=\"12\" cy=\"7\" r=\"4\"/><path d=\"M5 21v-1a7 7 0 0 1 14 0v1\"/>",
            ["box"]     = "<path d=\"M3 7l9-4 9 4-9 4z\"/><path d=\"M3 7v10l9 4 9-4V7\"/>",
            ["clock"]   = "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/>",
        };
        var hmTint = new Dictionary<string, string>
        {
            ["word"] = "#EAF7EF", ["music"] = "#F1EEFD", ["lesson"] = "#FFF6E0", ["pray"] = "#FDF2F4",
            ["chat"] = "#EAF2FD", ["photo"] = "#FDEFF6", ["event"] = "#FFF1E6", ["vote"] = "#EEF1F5",
            ["gift"] = "#FDEEEE", ["memo"] = "#F4F6F9", ["teacher"] = "#E6F7F5", ["box"] = "#FFF6E0", ["clock"] = "#EEF1F5",
        };

        // 묶음별 메뉴 — (아이콘, 이름, 설명, 주소, 보이는가)
        var hmGroups = new List<(string Name, List<(string Ic, string Title, string Desc, string Url)> Items)>
        {
            ("말씀 · 예배", new List<(string, string, string, string)>()),
            ("함께하기",    new List<(string, string, string, string)>()),
            ("안내",        new List<(string, string, string, string)>()),
            ("교사 · 관리", new List<(string, string, string, string)>()),
        };
        if (MenuAllowed(urlMissionToday))       hmGroups[0].Items.Add(("word",   "말씀·미션",   "매일 말씀 읽기와 미션",            urlMissionToday));
        if (MenuAllowed(urlPraiseHub))          hmGroups[0].Items.Add(("music",  "예배 콘텐츠", "찬양 · 설교 · 예배 자료",          urlPraiseHub));
        if (MenuAllowed(urlWeeklyWordToRead))   hmGroups[0].Items.Add(("lesson", "주일공과",    "이번 주 공과와 암송",              urlWeeklyWordToRead));
                                                hmGroups[0].Items.Add(("pray",   "기도",        "자녀 · 부부 · 치유 · 수험생 기도", "/PrayHome/Index"));
        if (MenuAllowed(urlNotice))             hmGroups[1].Items.Add(("chat",   "소통공간",    "공지와 게시판",                    urlNotice));
        if (MenuAllowed(urlAlbum))              hmGroups[1].Items.Add(("photo",  "사진·영상",   "예배와 행사 앨범",                 urlAlbum));
        if (MenuAllowed(urlApplyEvent))         hmGroups[1].Items.Add(("event",  "이벤트",      "행사 신청과 안내",                 urlApplyEvent));
                                                hmGroups[1].Items.Add(("vote",   "실시간투표",  "지금 진행 중인 투표",              "/hanmadi"));
                                                hmGroups[2].Items.Add(("gift",   "시상·선물 가이드", "도토리 · 완독 선물 안내",     "/Admin/LifeGuide"));
                                                hmGroups[2].Items.Add(("memo",   "개선사항 · 불편사항 접수", "의견을 남겨 주세요",  "/Board/Create2?boardName=Anonymous"));
        if (MenuAllowed(urlAdminTeacherOnly))   hmGroups[3].Items.Add(("teacher","교사전용",    "교사에게만 보여요",                urlAdminTeacherOnly));
        if (isSuperAdmin)                       hmGroups[3].Items.Add(("box",    "자료실",      "SuperAdmin",                       "/ResourceBox/index"));
        if (MenuAllowed(urlIndexComplex) && isSuperAdmin)
                                                hmGroups[3].Items.Add(("clock",  "예전 화면",   "SuperAdmin",                       urlIndexComplex));

        string hmBrand = string.IsNullOrWhiteSpace(ChurchName) ? "교회 포털" : ChurchName;

        // 오늘 날짜 · 요일 (한국 시간)
        var hmNow = DateHelper.GetKoreaNow();
        string[] hmDow = { "일", "월", "화", "수", "목", "금", "토" };
        string hmDateText = $"{hmNow.Year}년 {hmNow.Month}월 {hmNow.Day}일 {hmDow[(int)hmNow.DayOfWeek]}요일";
        bool hmSunday = hmNow.DayOfWeek == DayOfWeek.Sunday;
    }
    @* 2026-10-05: ☰ 는 왼쪽(서랍도 왼쪽에서 열림), 오늘 날짜 · 요일은 오른쪽 끝.  교회 이름(잠실새내 유년부)은 뺐다.
       ☰ 오른쪽 빈자리는 다음 기능용으로 비워 둔다(hmSlot) *@
    @* 2026-10-05: 검색 엔진용 본문 제목 — 화면에는 보이지 않는다(스크린리더에는 읽힌다) *@
    <h1 style="position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">잠실새내교회 유년부 (대한예수교장로회 잠실새내교회 주일학교)</h1>
    <header class="hmBar">
        <div class="hmBarIn">
            <button type="button" class="hmBtn" id="hmOpen" aria-label="전체 메뉴 열기" aria-controls="hmDrawer" aria-expanded="false">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
            </button>
            @* 2026-10-05: ☰ 오른쪽 빈자리에 교단 + 교회 이름 (교단은 작게, 교회는 조금 크게) *@
            @* 2026-10-05: 누르면 교회 홈페이지(새 창).  파란 글씨 + ↗ 로 "밖으로 이동"을 알린다 *@
            <a class="hmChurch" href="https://www.saenae.org/" target="_blank" rel="noopener noreferrer" aria-label="@(string.IsNullOrWhiteSpace(ChurchName) ? "잠실새내" : ChurchName)교회 홈페이지로 이동 (새 창)">
                <small>대한예수교장로회</small>
                <b>@(string.IsNullOrWhiteSpace(ChurchName) ? "잠실새내" : ChurchName)교회<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></b>
            </a>
            <div class="hmSlot"></div>
            <div class="hmDate @(hmSunday ? "sun" : "")" aria-label="오늘 @hmDateText"><small>@(hmNow.Year)년</small><b>@(hmNow.Month)월 @(hmNow.Day)일</b><span>@(hmDow[(int)hmNow.DayOfWeek])요일</span></div>
        </div>
    </header>

    <div class="hmScrim" id="hmScrim" hidden></div>
    <aside class="hmDrawer" id="hmDrawer" role="dialog" aria-modal="true" aria-label="전체 메뉴" aria-hidden="true">
        <div class="hmHead">
            <img class="hmAv" src="@profileImgSrc" alt="" width="46" height="46" onerror="this.onerror=null;this.src='@ConstatsCommon.representFaceImage'" />
            <div class="hmWho">
                @if (isSignedIn)
                {
                    <b>@(string.IsNullOrWhiteSpace(userFullName) ? "내 정보" : userFullName + " 님")</b>
                    <a href="@profileClickUrl">내 정보 · 사진 변경 ›</a>
                }
                else
                {
                    <b>안녕하세요</b>
                    <a href="@profileClickUrl">로그인하고 시작하기 ›</a>
                }
            </div>
            <button type="button" class="hmX" id="hmClose" aria-label="메뉴 닫기">✕</button>
        </div>

        <nav class="hmBody" aria-label="메뉴 목록">
            @foreach (var g in hmGroups.Where(x => x.Items.Count > 0))
            {
                <div class="hmSec">@g.Name</div>
                @foreach (var m in g.Items)
                {
                    <a class="hmIt" href="@m.Url">
                        <span class="hmIc" style="background:@hmTint[m.Ic]"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#374151" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(hmIcon[m.Ic])</svg></span>
                        <span class="hmTx"><b>@m.Title</b><small>@m.Desc</small></span>
                        <span class="hmG" aria-hidden="true">›</span>
                    </a>
                }
            }
        </nav>

        <div class="hmFoot">
            @if (isSignedIn)
            {
                <a class="p" href="@profileClickUrl">정보 관리</a>
                <form method="post" action="/Account/Logout" class="hmOut">
                    @Html.AntiForgeryToken()
                    <button type="submit">로그아웃</button>
                </form>
            }
            else
            {
                <a class="p" href="@profileClickUrl">로그인</a>
            }
        </div>
    </aside>

    <style>
        /* 맨 위 고정 바 */
        .hmBar { position: sticky; top: 0; z-index: 900; background: rgba(255,255,255,.92); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
                 border-bottom: 1px solid #E2E8F0; padding-top: env(safe-area-inset-top, 0px); font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; }
