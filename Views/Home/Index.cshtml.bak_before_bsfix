        .hmDrawer { position: fixed; top: 0; left: 0; bottom: 0; z-index: 9991; width: 86%; max-width: 360px; background: #fff;
                    transform: translateX(-100%); transition: transform .26s cubic-bezier(.2,.8,.2,1); visibility: hidden;
                    display: flex; flex-direction: column; box-shadow: 12px 0 30px rgba(17,24,39,.18);
                    padding-top: env(safe-area-inset-top, 0px); font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; color: #374151; text-align: left; }
        .hmDrawer.on { transform: none; visibility: visible; }
        .hmHead { display: flex; align-items: center; gap: 12px; padding: 16px 14px 14px 16px; border-bottom: 1px solid #EEF0F3; }
        .hmAv { flex: none; width: 46px; height: 46px; border-radius: 50%; object-fit: cover; background: #E5E7EB; box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px #E2E8F0; }
        .hmWho { flex: 1; min-width: 0; }
        .hmWho b { display: block; font-size: 16px; font-weight: 800; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .hmWho a { font-size: 12px; font-weight: 700; color: #2F80ED; text-decoration: none; }
