        .hmFoot a, .hmFoot button { width: 100%; display: block; text-align: center; padding: 11px 0; border: 0; border-radius: 10px; font: inherit; font-size: 13px; font-weight: 800; background: #F4F6F9; color: #374151; text-decoration: none; cursor: pointer; }
