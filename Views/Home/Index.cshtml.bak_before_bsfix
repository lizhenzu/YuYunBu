          @await Html.PartialAsync("_BibleGiftBanner")

          @* ══════════════════════════════════════════════════════════════
             축하해요 — 요약 카드 (2026-10-04 시안 A안 확정)
             · 도토리 선물 · 가족팀 마일스톤 · 성경 완독 세 카드를 한 장으로 모아 이름 · 선물 · 상태만 짧게
             · 묶음마다 「자세히」를 누르면 예전 카드(타임라인 · 선물 사진 · 관리자 링크)가 그대로 펼쳐진다
             · 대상자가 없는 묶음은 빠지고, 셋 다 없으면 카드가 나오지 않는다.  이전 화면은 Index.cshtml.bak_before_celebrate
             ══════════════════════════════════════════════════════════════ *@
          @{
              string CelSt(string? s) => (s ?? "").ToUpperInvariant() switch
              {
                  "HIDDEN" or "DELIVERED" => "전달완료",
                  "PURCHASED"             => "구매완료",
                  _                       => "신청중",
              };
              string CelCls(string label) => label switch { "전달완료" => "ok", "구매완료" => "buy", _ => "ask" };
              string CelInit(string? n) => string.IsNullOrWhiteSpace(n) ? "?" : n.Trim().Substring(n.Trim().Length >= 2 ? 1 : 0, 1);
              // 이름은 성과 이름을 붙여서 ("김 한결" → "김한결")
              string CelName(string? n) => System.Text.RegularExpressions.Regex.Replace(n ?? "", @"\s+", "");
              // 학생 · 교사 · 기타 (StudentPointTotalRankService.ToRoleLabel 과 같은 기준)
              string CelRole(string? rc) => (rc ?? "").Trim().ToUpperInvariant() switch
              {
                  "T1001" or "STU" or "STUDENT" or "S" => "학생",
                  "T1002" or "T1003" or "T1004" or "T1005" or "T1006" or "T1008" or "T1009" or "T1010" or "T1013"
                      or "T1015" or "T1016" or "T1017" or "T1018" or "T1019" or "T1020" or "T1099" or "TCH" or "TEACHER" or "T" => "교사",
                  _ => "기타",
              };

              // ① 도토리 선물 — 신청중 · 구매완료 선물이 있는 친구 (로그인한 사람에게만 데이터가 온다)
              var celKids = (ViewBag.GiftTimelineKids as List<BulletinBoard.ViewModels.Home.GiftTimelineKidVM>) ?? new List<BulletinBoard.ViewModels.Home.GiftTimelineKidVM>();
              var celGiftRows = celKids.Select(k =>
              {
                  var it = k.Items.Where(i => i.Status == "DRAFT" || i.Status == "PURCHASED").OrderByDescending(i => i.Milestone).FirstOrDefault()
                           ?? k.Items.OrderByDescending(i => i.Milestone).FirstOrDefault();
                  return (Name: CelName(k.DisplayName), Role: CelRole(k.RoleCode), Photo: k.Photo, Point: it?.Milestone ?? 0, Gift: it?.ProductName ?? "", St: CelSt(it?.Status));
              }).ToList();

              // ② 가족팀 마일스톤 — _FamilyMilestoneBlock 과 같은 조건 (도달한 시상 단계 중 아직 전달 안 된 것이 있는 팀)
              var celFm = (ViewBag.FamilyMilestones as List<BulletinBoard.Services.Abstract.FamilyMilestoneDisplayVM>) ?? new List<BulletinBoard.Services.Abstract.FamilyMilestoneDisplayVM>();
              var celTeamRows = celFm.GroupBy(r => r.FamilyTeamId)
                  .Where(g => g.Any(r => string.Equals(r.MilestoneType, "AWARD", StringComparison.OrdinalIgnoreCase)
                                      && !string.Equals(r.GiftStatus, "HIDDEN", StringComparison.OrdinalIgnoreCase)))
                  .Select(g =>
                  {
                      var f = g.First();
