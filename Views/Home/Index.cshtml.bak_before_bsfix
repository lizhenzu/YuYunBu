<style>
@@keyframes navSpin { to { transform:rotate(360deg); } }
</style>
<script>
(function(){
  function showNavLoading(){ document.getElementById('navLoadingOverlay').style.display='flex'; }
  window.showNavLoading = showNavLoading;
  // .menuBtn — 메뉴 버튼
  document.querySelectorAll('.menuBtn').forEach(function(el){
    el.addEventListener('click', function(){ showNavLoading(); });
  });

  // ── 홈의 모든 링크·버튼 — 실제로 다른 화면으로 넘어갈 때만 자동으로 보여준다
  //    (data-no-loading 붙은 요소, #·javascript:·mailto:·tel:, 새 탭으로 열리는 링크는 제외)
  document.addEventListener('click', function (e) {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    var a = e.target.closest('a[href]');
    if (!a || a.hasAttribute('data-no-loading')) return;
    var href = a.getAttribute('href') || '';
    if (!href || href.charAt(0) === '#') return;
    if (href.indexOf('javascript:') === 0 || href.indexOf('mailto:') === 0 || href.indexOf('tel:') === 0) return;
    if (a.target === '_blank' || a.hasAttribute('download')) return;
    showNavLoading();
  }, false);

  // 눌러서 넘어가는 폼(구매/취소 등) — confirm()에서 취소하면 보여주지 않는다
  document.addEventListener('submit', function (e) {
    if (e.defaultPrevented) return;
    var f = e.target;
    if (!f || f.hasAttribute('data-no-loading') || f.getAttribute('target') === '_blank') return;
    showNavLoading();
  }, false);
  // 뒤로가기/앞으로가기로 돌아왔을 때 오버레이 숨기기
  window.addEventListener('pageshow', function(e){
    document.getElementById('navLoadingOverlay').style.display='none';

    // 뒤로가기 캐시(bfcache)로 복원되면 서버에 묻지 않고 예전 화면이 그대로 보인다.
    // 선물을 고르거나 취소하고 돌아오면 옛 상태가 남으므로 이때만 다시 불러온다.
    var byBack = e.persisted;
    if (!byBack) {
      try {
        var nav = performance.getEntriesByType('navigation')[0];
        byBack = !!nav && nav.type === 'back_forward';
      } catch (err) { }
    }
    if (byBack) { location.reload(); }
  });
})();
</script>

@* ── 홈 카드 모서리 통일 (2026-10-04) — 모두 "말씀 찾기" 카드와 같은 8px ──
   · 아래 CSS 는 게스트 화면에서 보이는 카드들, 그 아래 스크립트는 로그인해야 보이는 카드(생일 · 선물 · 가족팀 등)까지
     "카드 폭(컨테이너의 85% 이상) · 배경 또는 테두리가 있는 바깥 상자"만 골라 같은 값으로 맞춘다. 안쪽 버튼 · 작은 상자는 그대로.
   · 값을 바꾸려면 --home-card-r 하나만 고치면 된다. *@
<style>
    :root { --home-card-r: 8px; }
    .container .hero, .container .hero.heroD, .container .worship-banner, .container .bible-search-zone,
    .container .dm2-card, .container .bc1-card, .container .fprCard, .container .cardBtn, .container .nbtops-shell,
    .container .fpc, .container .menuGroupBox, .container .quickBtn, .container .fmT, .container .btC,
    .container .bgBanner, .container .today-birthday-banner, .container .ms-gift-banner, .container .tpCard, .container .mbCard, .container .hcCard { border-radius: var(--home-card-r) !important; }
</style>
<script>
(function () {
    var box = document.querySelector('.container'); if (!box) return;
    var R = getComputedStyle(document.documentElement).getPropertyValue('--home-card-r').trim() || '8px';
    var W = box.getBoundingClientRect().width;
    function isCard(el, cs, r) {
        if (cs.position === 'fixed' || cs.display === 'none') return false;
        var hasBg = cs.backgroundColor !== 'rgba(0, 0, 0, 0)' || cs.backgroundImage !== 'none';
        var hasBd = parseFloat(cs.borderTopWidth) > 0;
        return (hasBg || hasBd) && r.width >= W * 0.85 && r.height > 40;
    }
    function walk(el, depth) {
        for (var i = 0; i < el.children.length; i++) {
            var ch = el.children[i];
            if (ch.tagName === 'SCRIPT' || ch.tagName === 'STYLE') continue;
            var cs = getComputedStyle(ch), r = ch.getBoundingClientRect();
            if (r.width === 0 && r.height === 0) continue;
            if (isCard(ch, cs, r)) { ch.style.borderRadius = R; continue; }   // 바깥 카드만 — 안쪽은 건드리지 않음
            if (depth < 5) walk(ch, depth + 1);
        }
    }
    walk(box, 0);
})();
</script>

