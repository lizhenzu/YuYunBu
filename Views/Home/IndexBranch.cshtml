@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor


@{
    Layout = null;
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());

}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ChurchName · @DepartmentName</title>
    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: Arial, sans-serif;
            background: url('/images/home/David.webp') no-repeat center center fixed;
            background-size: cover;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .content {
            width: 300px; 
            text-align: center;
            color: white;
            background-color: rgba(0, 0, 0, 0.7); 
            padding: 15px; 
            border-radius: 10px;
            overflow: auto; 
        }

      .button {
            background-color: #4CAF50; /* Green */
            border: none;
            color: white;
            padding: 15px 32px;
            text-align: center;
            text-decoration: none;
            display: block; /* Makes the button expand to the width of the container */
            font-size: 16px;
            margin: 10px 0; /* Adds space between buttons */
            cursor: pointer;
            border-radius: 10px;
            font-size: 18px;
            font-weight: bold;
            box-shadow: 3px 3px 10px rgba(0, 0, 0, 0.2);
        }
        .vertical-image {
            width: 100%; 
            max-width: 200px; 
            height: auto; 
            margin: 20px 0; 
        }

        .badge {
            background: white; 
            display: inline-block;
            padding: 10px;
            margin: 10px 0;
            border-radius: 10px;
            position: relative; 
            color: black; 
            box-shadow: 0 0 10px rgba(0,0,0,0.8);
            font-size: 20px; /* 폰트 크기 조정 */
            word-wrap: break-word; /* 단어 단위로 줄바꿈 허용 */
        }
            .text {
        font-size: 20px;
        line-height: 1.5;
        margin-top: 20px;
        color:white;
        font-weight: bold;
    }
        .characters {
        background-image: url('/images/mission/jesus.png'); /* 캐릭터 이미지 URL */
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
        height: 180px; /* 캐릭터 이미지 높이 */
    }
        .badge:before {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%; 
            margin-left: -10px;
            border-width: 10px;
            border-style: solid;
            border-color: white transparent transparent transparent;
        }

        .login-btn {
            background-color: #9e1a20;
            font-size: 18px;
            font-weight: bold;
        }

    </style>
</head>
<body>
    <div class="content">
        <div class="badge">
            <h2>@DepartmentName 최고의 미션</h2>
            <h3 style="margin:0px;">@ConstatsCommon.MainKeyTitle</h3>
        </div>
         <div class="characters"></div>
            <p>미션속으로 들어가 볼가요!</p> 
        <a href="/Home/MissionMainBoard" class="button login-btn">미션수행하러 가기</a>
        @*        <a href="/Intro/WhatChallenge2014" class="button">도전 성경 말씀?</a>*@
        <a href="/" class="button">Home</a>
    </div>
</body>
</html>
