@using BulletinBoard.Common;
@using BulletinBoard.Models;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model BulletinBoard.Models.TodayCheckCompositeData
@{
    Layout = null;
}

@{
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
    var sessionValue = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserFullName.ToString());

}

@{
    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    var isBasic = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Basic));
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <link rel="manifest" href="/manifest.json">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    @{
        // 페이지 타이틀 조합
        var pageTitle = $"{ChurchName} {DepartmentName}";
        var seoTitle = $"{ChurchName} {DepartmentName}";
        var seoDescription = $"{ChurchName} {DepartmentName} 홈페이지입니다. 말씀 읽기, 공과, 찬양, 기도, 앨범 등 어린이를 위한 신앙 프로그램을 제공합니다.";
        var seoKeywords = $"{ChurchName} {DepartmentName}, 유년부, 어린이부, 교회학교, 성경읽기, 도전 성경말씀, 찬양, 공과, 기도";
    }

    <!-- 기본 제목/설명 (검색엔진용) -->
    <title>@seoTitle</title>
    <meta name="description" content="@seoDescription" />
    <meta name="keywords" content="@seoKeywords" />

    <!-- 네이버 서치어드바이저 사이트 인증 -->
    <!-- content 값은 네이버 Search Advisor에서 발급받은 값으로 반드시 교체하세요 -->
    <meta name="naver-site-verification" content="bb98fab82831db1dbb0439fa1686f7743f808191" />


    <!-- Canonical URL (대표 주소) -->
    <link rel="canonical" href="@ViewBag.FullURL" />

    <!-- SNS/카카오톡 공유용 OG 태그 -->
    <meta property="og:title" content="@seoTitle">
    <meta property="og:description" content="@seoDescription">
    <meta property="og:image" content="@ViewBag.FullURL/images/home/welcome/welcome_01.webp">
    <meta property="og:url" content="@ViewBag.FullURL">
    <meta property="og:type" content="website">

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js')
                .then(function (registration) {
                    console.log('Service Worker registered with scope:', registration.scope);
                }).catch(function (error) {
                    console.log('Service Worker registration failed:', error);
                });
        }
    </script>

    
    <style>
