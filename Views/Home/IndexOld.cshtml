<script>
    function closeModal(hide) {
        document.querySelector('.modal').style.display = 'none';
        document.querySelector('.modal-overlay').style.display = 'none';
    }
    function setHideModal() {
        const hideForDays = document.getElementById('hideForDays').checked;
        const hideForToday = document.getElementById('hideForToday').checked;
        const now = new Date();

        if (hideForDays) {
            const date = new Date();
            date.setDate(now.getDate() + 31);
            localStorage.setItem('hideModalUntil', date);
        } else if (hideForToday) {
            const tomorrow = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
            localStorage.setItem('hideModalUntil', tomorrow);
        } else {
            localStorage.removeItem('hideModalUntil');
        }

        closeModal(false);
    }
    function checkModalDisplay() {
        const hideUntil = new Date(localStorage.getItem('hideModalUntil'));
        const now = new Date();

        if (now < hideUntil) {
            return;
        }
        document.querySelector('.modal').style.display = 'block';
        showPlayModal();
    }
</script>

<script>
    let modal = document.getElementById("modalBox");
    let img = document.getElementById("img01");
    let captionText = document.getElementById("caption");
    let span = document.getElementsByClassName("closeBox")[0];
    let images = ['/images/OnePoint/OnePoint01_crop.webp',
        '/images/OnePoint/OnePoint02_crop.webp',
        '/images/OnePoint/OnePoint03_crop.webp',
        '/images/OnePoint/OnePoint04_crop.webp',
        '/images/OnePoint/OnePoint05_crop.webp',
        '/images/OnePoint/OnePoint06_crop.webp',
        '/images/OnePoint/OnePoint07_crop.webp',
        '/images/OnePoint/OnePoint08_crop.webp'];
    let captions = [
        "꿈미 '원포인트 통합 교육' 철학",
        "가정",
        "교회",
        "학교가",
        "같은 성경 본문을 중심으로",
        "묵상하고 예배를 드리는",
        "통합적 접근",
        "방법 입니다."
    ];

    let currentIndex = 0;

    function showPlayModal() {
        modal.style.display = "block";
        document.querySelector('.modal-overlay').style.display = 'block';
        changeImage();
    }

    function changeImage() {
        img.src = images[currentIndex];
        captionText.innerHTML = captions[currentIndex];
        currentIndex = (currentIndex + 1) % images.length;
        setTimeout(changeImage, 3000);
    }

    span.onclick = function () {
        modal.style.display = "none";
        document.querySelector('.modal-overlay').style.display = 'none';
    }

    window.onload = function () {
        // checkModalDisplay();
    }
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const hideTodayForBonusQuizAlarm = getCookie('hideTodayForBonusQuizAlarm');
        const hide7DaysForBonusQuizAlarm = getCookie('hide7DaysForBonusQuizAlarm');

        //hideTodayForBonusQuizAlarm 또는 hide7DaysForBonusQuizAlarm 쿠키가 없을 때만 팝업을 표시
        // if (!hideTodayForBonusQuizAlarm && !hide7DaysForBonusQuizAlarm) {
        //    document.getElementById('popup-background').style.display = 'flex'; // 팝업 표시
        //    document.body.style.overflow = 'hidden'; // 스크롤 비활성화
        // }
    });

    function handleCheckbox(cookieName, days) {
        setCookie(cookieName, 'true', days); // 쿠키 설정
        document.getElementById('popup-background').style.display = 'none'; // 팝업 숨김
        document.body.style.overflow = 'auto'; // 스크롤 다시 활성화
    }

    // 쿠키 설정 함수
    function setCookie(name, value, days) {
        const date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000)); // 쿠키 만료 시간 설정
        const expires = "expires=" + date.toUTCString();
        document.cookie = name + "=" + value + ";" + expires + ";path=/"; // 쿠키 설정
    }

    // 쿠키 가져오기 함수
    function getCookie(name) {
        const cname = name + "=";
        const decodedCookie = decodeURIComponent(document.cookie);
        const ca = decodedCookie.split(';');
        for (let i = 0; i < ca.length; i++) {
            let c = ca[i].trim();
            if (c.indexOf(cname) === 0) {
                return c.substring(cname.length, c.length);
            }
        }
        return ""; // 쿠키가 없으면 빈 문자열 반환
    }
</script>

