@model BulletinBoard.Models.TodayCheckCompositeData
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "미션 수행";
    Layout = null;

    int maxLimitPray = 13;
    int maxLimitQuiz = 12;
    int maxLimitRecite = 12;
    int maxLimitWord = 29;

    var todayDatePray = DateHelper.GetTodayDateDayString(maxLimitPray);
    var todayDateQuiz = DateHelper.GetTodayDateDayString(maxLimitQuiz);
    var todayDateRecite = DateHelper.GetTodayDateDayString(maxLimitRecite);
    var todayDateWord = DateHelper.GetTodayDateDayString(maxLimitWord);

    string formattedModResultDataPray = $"/images/mission/pray/pray_{todayDatePray}.webp";
    string formattedModResultDataQuiz = $"/images/mission/quiz/quiz_{todayDateQuiz}.webp";
    string formattedModResultDataRecite = $"/images/mission/recite/recite_{todayDateRecite}.webp";
    string formattedModResultDataWord = $"/images/mission/word/word_{todayDateWord}.webp";

    var UserId = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserId.ToString()) as string;

    CheckPoint _CheckPoint = ViewBag._CheckPoint as CheckPoint;
    string baseDayDiff = (string)ViewData["baseDayDiff"];

    int totalTodayPoint = Model.TodayWordToReadCountToParent + Model.TodayWordToReadCountToMe + Model.WeeklyWordToReadCount
        + Model.PrayPhraseCountToMe + Model.PrayPhraseCountToParent + Model.PrayPhraseCountToFriend + Model.QuestionCount;

    int totalAllPoint = Model.TodayWordToReadCountToParent_All + Model.TodayWordToReadCountToMe_All + Model.WeeklyWordToReadCount_All
        + Model.PrayPhraseCountToMe_All + Model.PrayPhraseCountToParent_All + Model.PrayPhraseCountToFriend_All + Model.QuestionCount_All;

    string userName = await AuthService.GetUserName(User);

    UserSettingsCookie __UserSettingsCookie = ViewBag._UserSettingsCookie as UserSettingsCookie;
    bool showPopupCookieValue = (__UserSettingsCookie != null);

    var sessionWorkDT = Context.Session.GetString(DateKind.WorkDT.ToString());
    var sessionTodayDT = Context.Session.GetString(DateKind.TodayDT.ToString());

    DateTime todayDT = BulletinBoard.Common.SharedComm.GetToday();
    DateTime missionDT = todayDT;

    if (sessionWorkDT != null) { missionDT = DateTime.Parse(sessionWorkDT); }
    if (sessionTodayDT != null) { todayDT = DateTime.Parse(sessionTodayDT); }

    string TodayMesssage = $"오늘은 {BulletinBoard.Common.SharedComm.GetTodayStringKor()} 입니다.";
    string UserFullName = ViewData[HttpContextSessionCategory.UserFullName.ToString()] as string;
    var UserName = ViewData[HttpContextSessionCategory.UserName.ToString()] as string;

    // ✅ 스탬프(미션 완료/달력 완료)
    int stampMaxLimit = 9;
    var stampDate = DateHelper.GetTodayDateDayString(stampMaxLimit);
    string missioncompleted = $"/images/mission/missioncompletedstamp/rorate/missionCompletedStamp_rotate_{stampDate}.png";

    string Total_All_Desc = $"{@Model.Total_All}점";
    string Total_All_Desc_Reach1000 = SharedComm.HowMuchItTakes(1000, @Model.Total_All);
    string Total_All_Desc_Reach1500 = SharedComm.HowMuchItTakes(1500, @Model.Total_All);
    string Total_All_Desc_Reach_MAX = SharedComm.HowMuchItTakes(@ViewBag.maxAwardLevel, @Model.Total_All);

    string RoleCode = ViewData["RoleCode"] as string;
    bool rerachPoint = ViewBag.PointAwardUserExists;

    // ✅ 파셜에서 쓰던 값
    TodayCollectQuestion todayCollectQuestion = ViewBag.todayCollectQuestion as TodayCollectQuestion;

    string todayDString = BulletinBoard.Common.SharedComm.GetTodayString();
    string MissionMesssage = $"{missionDT.Month}월{missionDT.Day}일자 미션을 보고 계시네요.";

    // ✅ 상태 계산
    int sumWord = (Model?.TodayWordToReadCountToMe ?? 0) + (Model?.TodayWordToReadCountToParent ?? 0);
    bool doneWord = sumWord > 0;

    bool quizFailed = (todayCollectQuestion?.questionProcessStatus?.Result == "f");
    int quizTryCnt = (todayCollectQuestion?.questionProcessStatus?.TryCnt ?? 0);
    bool quizHardFailed = quizFailed && quizTryCnt > 1;
    bool doneQuiz = (Model?.QuestionCount ?? 0) > 0;

    int sumPray = (Model?.PrayPhraseCountToMe ?? 0) + (Model?.PrayPhraseCountToParent ?? 0) + (Model?.PrayPhraseCountToFriend ?? 0);
    bool donePray = sumPray > 0;

    int sumWeekly = (Model?.WeeklyWordToReadCount ?? 0);
    bool doneRecite = sumWeekly > 0;

    // ✅ 카드별 포인트(원하시면 실제 점수 규칙으로 조정 가능)
    int pWord = doneWord ? 2 : 0;
    int pQuiz = doneQuiz ? 1 : 0;
    int pPray = donePray ? 2 : 0;
    int pRecite = doneRecite ? 1 : 0;
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>미션 수행</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jua&family=Noto+Sans+KR:wght@400;600;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/ButtonBase7.css">
    <link rel="stylesheet" href="/css/ColorBase7.css">
    <script src="/js/ProcessBar73.js"></script>

    <style>
        :root {
            --bg0: #f6fbff;
            --bg1: #f3fff7;
            --card: #ffffff;
            --ink: #0f172a;
            --muted: #475569;
            --line: #e2e8f0;
            --brand: #22c55e;
            --brand2: #10b981;
            --sky: #38bdf8;
            --vio: #8b5cf6;
            --rose: #fb7185;
            --amber: #f59e0b;
            --shadow: 0 14px 40px rgba(15, 23, 42, .10);
            --shadow2: 0 8px 18px rgba(15, 23, 42, .08);
            --r-xl: 26px;
            --r-lg: 18px;
            --r-md: 14px;
            --max: 980px;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            /* font-family: "Noto Sans KR", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; */
            color: var(--ink);
            background: radial-gradient(900px 600px at 10% 0%, rgba(56,189,248,.22), transparent 60%), radial-gradient(900px 700px at 90% 10%, rgba(34,197,94,.20), transparent 60%), radial-gradient(700px 600px at 55% 110%, rgba(251,113,133,.12), transparent 60%), linear-gradient(180deg, var(--bg0), var(--bg1));
        }

        .page {
            min-height: 100%;
            padding: 18px 14px 28px;
        }

        .shell {
            max-width: var(--max);
            margin: 0 auto;
        }

        /* ✅ 상단 */
        .topbar {
            display: flex;
            gap: 14px;
            align-items: stretch;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .hero {
            flex: 1 1 auto;
            background: linear-gradient(135deg, rgba(56,189,248,.14), rgba(34,197,94,.12));
            border: 1px solid rgba(226,232,240,.9);
            border-radius: var(--r-xl);
            padding: 16px;
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
            min-width: 0;
        }

            .hero::before {
                content: "";
                position: absolute;
                inset: -2px;
                background: radial-gradient(420px 260px at 10% 10%, rgba(56,189,248,.18), transparent 60%), radial-gradient(420px 260px at 90% 20%, rgba(34,197,94,.18), transparent 60%);
                pointer-events: none;
            }

            .hero h1 {
                margin: 0;
                font-size: 22px;
                font-weight: 900;
                letter-spacing: -.2px;
                position: relative;
            }

            .hero p {
                margin: 6px 0 0;
                color: var(--muted);
                font-weight: 800;
                font-size: 13px;
                position: relative;
                line-height: 1.35;
            }

        /* ✅ chipRow를 2덩어리로 구분 */
        .chipRow {
            margin-top: 10px;
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
            position: relative;
        }

        @@media (min-width: 640px) {
            .chipRow {
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                align-items: start;
            }
        }

        .chipGroup {
            padding: 12px;
            border-radius: 20px;
            border: 1px solid rgba(226,232,240,.95);
            background: rgba(255,255,255,.72);
            box-shadow: var(--shadow2);
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-content: flex-start;
            min-width: 0;
        }

        .chipGroupTitle {
            width: 100%;
            font-weight: 950;
            font-size: 13px;
            color: rgba(15,23,42,.78);
            margin-bottom: 2px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .chipGroupGoal {
            background: linear-gradient(135deg, rgba(139,92,246,.10), rgba(56,189,248,.10));
            border-color: rgba(139,92,246,.16);
        }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border-radius: 999px;
            border: 1px solid rgba(226,232,240,.95);
            background: rgba(255,255,255,.88);
            box-shadow: var(--shadow2);
            font-weight: 950;
            font-size: 13px;
            color: rgba(15,23,42,.92);
            min-width: 0;
        }

            .chip small {
                font-weight: 950;
                color: rgba(71,85,105,.95);
                min-width: 0;
            }

        .chipGoal {
            background: rgba(255,255,255,.92);
            border-color: rgba(139,92,246,.18);
        }

            .chipGoal small {
                display: block;
                margin-top: 2px;
                font-weight: 950;
                color: rgba(71,85,105,.92);
            }

        .chipGoalMax {
            background: linear-gradient(135deg, rgba(245,158,11,.16), rgba(251,113,133,.10));
            border-color: rgba(245,158,11,.22);
        }

        /* ✅ 모바일에서는 기존처럼 가로/세로 전환 */
        @@media (max-width: 860px) {
            .topbar {
                flex-direction: column;
            }
        }

        /* ✅ 섹션 */
        .section {
            margin-top: 14px;
            background: rgba(255,255,255,.72);
            border: 1px solid rgba(226,232,240,.95);
            border-radius: var(--r-xl);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .sectionHead {
            padding: 14px 16px 10px;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 10px;
            background: linear-gradient(135deg, rgba(56,189,248,.10), rgba(34,197,94,.08));
        }

            .sectionHead h2 {
                margin: 0;
                font-size: 16px;
                font-weight: 950;
            }

            .sectionHead .hint {
                color: var(--muted);
                font-weight: 900;
                font-size: 12.5px;
            }

        /* ✅ 모바일에서 hint를 다음 줄로 */
        @@media (max-width: 520px) {
            .sectionHead {
                flex-direction: column;
                align-items: flex-start;
                gap: 6px;
            }

                .sectionHead .hint {
                    width: 100%;
                    text-align: left;
                }
        }

        /* ✅ 캘린더 */
        .calendarWrap {
            padding: 12px 12px 16px;
            background: rgba(255,255,255,.60);
        }

        .calendar {
            width: 100%;
            border-collapse: separate;
            border-spacing: 8px;
        }

            .calendar th {
                padding: 10px 8px;
                font-size: 13px;
                font-weight: 950;
                color: rgba(15,23,42,.85);
                background: rgba(255,255,255,.92);
                border: 1px solid rgba(226,232,240,.95);
                border-radius: 14px;
            }

            .calendar td {
                height: 54px;
                text-align: center;
                font-weight: 950;
                background: rgba(255,255,255,.92);
                border: 1px solid rgba(226,232,240,.95);
                border-radius: 16px;
                cursor: pointer;
                position: relative;
                transition: transform .12s ease, box-shadow .12s ease;
                box-shadow: 0 6px 14px rgba(15,23,42,.06);
            }

                .calendar td:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 10px 20px rgba(15,23,42,.10);
                }

                .calendar td.isOut {
                    color: rgba(100,116,139,.85);
                    background: rgba(255,255,255,.70);
                }

                .calendar td.isToday {
                    outline: 3px solid rgba(56,189,248,.35);
                    background: linear-gradient(135deg, rgba(56,189,248,.10), rgba(34,197,94,.08));
                }

            .calendar .dayBadge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 34px;
                height: 34px;
                border-radius: 999px;
                background: rgba(34,197,94,.12);
                border: 1px solid rgba(34,197,94,.22);
            }

        .calendar-icon {
            position: absolute;
            right: 6px;
            bottom: 6px;
            width: 26px;
            opacity: .95;
        }

        /* ✅ 공용 카드 */
        .container {
            max-width: var(--max);
            margin: 14px auto 0;
        }

        .reward-card,
        .mission-card,
        .logout-card,
        .home-card,
        .delete-card {
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(226,232,240,.95) !important;
            border-radius: var(--r-xl);
            box-shadow: var(--shadow);
            padding: 16px;
            margin: 14px 0;
            text-align: left;
        }

        .mission-title {
            /* font-family: "Jua", "Noto Sans KR", sans-serif; */
            font-size: 18px;
            font-weight: 900;
            margin: 0;
            color: rgba(15,23,42,.92);
        }

        .mission-desc {
            margin-top: 8px;
            color: var(--muted);
            font-size: 13.5px;
            font-weight: 900;
            line-height: 1.45;
            margin-bottom: 10px;
        }

        .missionEmoji {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            border: 1px solid rgba(226,232,240,.95);
            background: linear-gradient(135deg, rgba(251,191,36,.18), rgba(34,197,94,.14));
            box-shadow: var(--shadow2);
            flex: 0 0 auto;
        }

        .statusPill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 10px;
            border-radius: 999px;
            font-weight: 950;
            font-size: 12.5px;
            border: 1px solid rgba(226,232,240,.95);
            box-shadow: var(--shadow2);
            white-space: nowrap;
        }

        .pillDone {
            background: linear-gradient(135deg, rgba(34,197,94,.18), rgba(16,185,129,.12));
            color: rgba(20,83,45,.96);
            border-color: rgba(34,197,94,.28);
        }

        .pillTodo {
            background: linear-gradient(135deg, rgba(245,158,11,.18), rgba(251,191,36,.12));
            color: rgba(124,45,18,.92);
            border-color: rgba(245,158,11,.28);
        }

        .pillFail {
            background: linear-gradient(135deg, rgba(251,113,133,.20), rgba(244,63,94,.12));
            color: rgba(153,27,27,.95);
            border-color: rgba(244,63,94,.26);
        }

        .cuteSticker {
            margin-top : 20px;
            position: relative;
            padding: 10px 12px;
            border-radius: 16px;
            border: 1px dashed rgba(148,163,184,.55);
            background: rgba(241,245,249,.70);
            color: rgba(15,23,42,.82);
            font-weight: 900;
            font-size: 13px;
            line-height: 1.35;
            /* ✅ 요청: 모바일/PC 모두 가운데 정렬 */
            text-align: center;
        }

            .cuteSticker::before {
                content: "💬";
                position: absolute;
                top: -12px;
                font-size: 18px;
                filter: drop-shadow(0 6px 10px rgba(2,6,23,.10));
                /* ✅ 가운데로 이동 */
                left: 50%;
                transform: translateX(-50%);
            }

        /* ✅ 상단 우측 “포인트 스티커” */
        .pointSticker {
            flex: 0 0 auto;
            padding: 10px 12px;
            border-radius: 18px;
            background: linear-gradient(135deg, rgba(139,92,246,.12), rgba(56,189,248,.10));
            border: 1px solid rgba(226,232,240,.95);
            box-shadow: var(--shadow2);
            font-weight: 950;
            text-align: center;
            min-width: 104px;
        }

            .pointSticker b {
                display: block;
                font-size: 16px;
                /* font-family: "Jua","Noto Sans KR",sans-serif; */
            }

            .pointSticker small {
                display: block;
                margin-top: 2px;
                font-size: 12px;
                color: rgba(71,85,105,.90);
                font-weight: 900;
            }

        /* ✅ 버튼 */
        .buttonCommon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 14px !important;
            border-radius: 16px !important;
            border: 1px solid rgba(226,232,240,.95) !important;
            background: rgba(255,255,255,.92);
            cursor: pointer;
            font-weight: 950 !important;
            box-shadow: 0 10px 22px rgba(15,23,42,.10);
            transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
            user-select: none;
        }

            .buttonCommon:hover {
                transform: translateY(-1px);
                box-shadow: 0 14px 28px rgba(15,23,42,.12);
            }

            .buttonCommon:active {
                transform: translateY(0px);
            }

        .colorBaseSoftTeal,
        .colorBaseDeepTeal,
        .colorBaseForestGreen,
        .colorBaseWasabiGreen,
        .colorBaseHome {
            background: linear-gradient(135deg, rgba(34,197,94,.92), rgba(16,185,129,.92)) !important;
            color: white !important;
            border-color: rgba(34,197,94,.20) !important;
        }

        .colorBasePastelRed {
            background: linear-gradient(135deg, rgba(251,113,133,.92), rgba(244,63,94,.92)) !important;
            color: white !important;
            border-color: rgba(244,63,94,.22) !important;
        }

        .colorBaseGoldenOrange {
            background: linear-gradient(135deg, rgba(245,158,11,.92), rgba(251,191,36,.92)) !important;
            color: white !important;
            border-color: rgba(245,158,11,.22) !important;
        }

        .colorBasePaleSilver {
            background: rgba(241,245,249,.95) !important;
            color: rgba(15,23,42,.88) !important;
        }

        /* 로딩 */
        .loading-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.32);
            display: none;
            z-index: 9999;
        }

        .loading-box {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(226,232,240,.95);
            box-shadow: var(--shadow);
            border-radius: 18px;
            padding: 16px 22px;
            font-weight: 950;
            color: rgba(15,23,42,.88);
            min-width: 220px;
            text-align: center;
            animation: pop .25s ease;
        }

        @@keyframes pop {
            from {
                opacity: 0;
                transform: translate(-50%,-50%) scale(.96);
            }

            to {
                opacity: 1;
                transform: translate(-50%,-50%) scale(1);
            }
        }

        /* 팝업 */
        .popup-background {
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.40);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 99999;
            padding: 16px;
        }

        .popup {
            width: min(560px, 96vw);
            border-radius: 24px;
            overflow: hidden;
            background: rgba(255,255,255,.98);
            border: 1px solid rgba(226,232,240,.95);
            box-shadow: 0 26px 70px rgba(15,23,42,.28);
        }

        .popup-header {
            padding: 16px 16px 12px;
            background: linear-gradient(135deg, rgba(245,158,11,.14), rgba(34,197,94,.12));
            text-align: center;
        }

            .popup-header h2 {
                margin: 0;
                font-size: 20px;
                font-weight: 950;
            }

            .popup-header h3 {
                margin: 6px 0 0;
                font-size: 14px;
                color: var(--muted);
                font-weight: 900;
            }

        .popup-content {
            padding: 14px 16px;
            text-align: center;
            color: rgba(15,23,42,.86);
            font-weight: 900;
        }

            .popup-content p {
                margin: 6px 0;
            }

        .popup-checkboxes {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: space-between;
            padding: 12px 14px 16px;
            background: rgba(241,245,249,.70);
            border-top: 1px solid rgba(226,232,240,.95);
        }

            .popup-checkboxes label {
                font-weight: 950;
                color: rgba(15,23,42,.84);
                display: flex;
                gap: 8px;
                align-items: center;
                padding: 10px 12px;
                border-radius: 16px;
                border: 1px solid rgba(226,232,240,.95);
                background: rgba(255,255,255,.92);
                cursor: pointer;
                box-shadow: 0 10px 20px rgba(15,23,42,.08);
            }

        .no-select {
            user-select: none;
        }

        .foot {
            margin-top: 14px;
            text-align: center;
            color: rgba(71,85,105,.85);
            font-weight: 900;
            font-size: 12.5px;
        }

        /* ✅ 카드 블럭 가운데 배치 공통 */
        .centerBlock {
            width: min(720px, 100%);
            margin: 14px auto;
            text-align: center;
        }

        /* ✅ 로그아웃 / 홈 카드 내부 요소 가운데 정렬 */
        .logout-card, .home-card {
            text-align: center;
        }

            .logout-card .buttonCommon, .home-card .buttonCommon {
                margin-left: auto;
                margin-right: auto;
            }

        /* ✅ 로그아웃 + 홈 2열 배치 래퍼 */
        .bottomRow {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-top: 14px;
        }

        @@media (max-width: 640px) {
            .bottomRow {
                grid-template-columns: 1fr;
            }
        }

        .bottomRow .logout-card,
        .bottomRow .home-card {
            width: 100%;
            margin: 0;
        }

        /* ✅ hero 내부 버튼 영역 */
        .heroActions {
            margin-top: 12px;
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
        }

        /* ✅ 태블릿/데스크탑: 3개 가로 배치 */
