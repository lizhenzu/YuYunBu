                   ✅ 4) 암송
                   ============================================================ *@
                <div class="mission-card">
                    <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:10px; margin-top:2px;">
                        <div style="display:flex; gap:10px; min-width:0;">
                            <div class="missionEmoji">📝</div>
                            <div style="min-width:0;">
                                <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                                    <div class="mission-title">말씀 암송</div>

                                    @if (doneRecite)
                                    {
                                        <div class="statusPill pillDone">✅ 미션 완료!</div>
                                    }
                                    else
                                    {

                                        <div class="statusPill pillTodo">⏳ 미션 미완료!</div>
                                    }
                                </div>
                            </div>
                        </div>

                      @*   <div class="pointSticker">
                            <b>@(doneRecite ? $"+{pRecite}P" : "+1P")</b>
                            <small>@(doneRecite ? "획득했어요!" : "하면 받아요!")</small>
                        </div> *@
                    </div>

                    @if (doneRecite)
                    {
                        <div class="cuteSticker">우와! 말씀을 외웠어요 🌟 <b>암송 마스터</b> 스티커!</div>
                    }
                    else
                    {

                        <div class="cuteSticker">한 줄씩! 천천히!<br />🐢 <b>가리고 말해보기</b>로 쉽게 암송해요!</div>
                    }

                    <div class="mission-desc">하나님의 말씀을 외워보아요!</div>

                    <div class="missionActions">
                        @if (doneRecite)
                        {
                            <div class="buttonCommon colorBasePaleSilver" style="padding:20px;" onclick="location.href='/DailyMission/WeeklyWordToRead'">
                                암송 하기 (다시 보기)
                            </div>
                        }
                        else
                        {
                            <div class="buttonCommon colorBaseForestGreen" style="padding:20px;" onclick="location.href='/DailyMission/WeeklyWordToRead'">
                                암송 하기
                            </div>
                        }
                    </div>
                </div>

            </div>

            @if (await AuthService.IsSignedIn(User) && (await AuthService.IsInRole(await AuthService.GetSignedUser(User), nameof(Roles.SuperAdmin))))
            {
                <div class="delete-card centerBlock">
                    <div class="mission-title">🗑 삭제</div>
                    <div class="mission-desc">나의 포인트를 삭제합니다.</div>
                    <div class="missionActions">
                        <div class="buttonCommon colorBasePastelRed" style="padding:20px;" onclick="location.href='/DailyMission/DeleteClickHistory'">삭제하기</div>
                    </div>
                </div>
            }

            <div class="bottomRow">
                <div class="logout-card">
                    <div class="mission-title">🔒 로그아웃</div>
                    <div class="mission-desc">안전하게 로그아웃하세요.</div>
                    <div class="missionActions">
                        <div class="buttonCommon colorBaseGoldenOrange" style="padding:20px;"
                             onclick="document.querySelector('form').submit();">
                            로그아웃
                        </div>
                    </div>
                </div>

                <div class="home-card">
                    <div class="mission-title">🏠 홈으로 이동</div>
                    <div class="mission-desc">처음 화면으로 돌아가기</div>
                    <div class="missionActions">
                        <div class="buttonCommon colorBaseHome" style="padding:20px;"
                             onclick="location.href='/'">
                            홈으로
                        </div>
                    </div>
                </div>
            </div>

            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" style="display:none;">
                <button type="submit">이동</button>
            </form>

            <!-- ✅ 팝업 -->
            <div class="popup-background" id="popup-background">
                <div class="popup">
                    <div class="popup-header">
                        <h2>🎉 축하드려요!!!</h2>
                        <h3>시상 포인트에 도달 하셨어요.</h3>
                    </div>
                    <div class="popup-content">
                        <p>이 페이지 중간에 <b>‘🎁 선물선택하기’</b> 박스에서</p>
                        <p><b>‘선물선택’</b> 버튼을 눌러서 선물을 선택해 보세요 😊</p>
                    </div>
                    <div class="popup-checkboxes">
                        <label><input type="checkbox" id="hideToday" onclick="handleCheckbox('hideToday', 1)"> 오늘 하루 안보기</label>
                        <label><input type="checkbox" id="hide7Days" onclick="handleCheckbox('hide7Days', 7)"> 7일간 안보기</label>
                    </div>
                </div>
            </div>

            <div class="foot">© Bible · Mission</div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var shouldShowPopup = false;
            var shouldShowPopupCookie = false;

            @{
                    bool shouldShow = false;
                    if (rerachPoint) { shouldShow = true; }
            }

            shouldShowPopup = @(shouldShow.ToString().ToLower());
            shouldShowPopupCookie = @(showPopupCookieValue.ToString().ToLower());

            if (shouldShowPopup) {
                if (shouldShowPopupCookie == false) {
                    document.getElementById('popup-background').style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                }
            }
        });

        function handleCheckbox(cookieName, days) {
            setCookie(cookieName, 'true', days);
            document.getElementById('popup-background').style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        function setCookie(name, value, days) {
            const data = {
                UserId: "@UserId",
                cookieName: "@CookieKey.MissionMainBoard_HideDay.ToString()",
                cookieValue: "true",
                cookieDays: days
            };
            doProcess(data, 'UpsertUserCookieSettings', 'n');

            const date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
            const expires = "expires=" + date.toUTCString();
            document.cookie = name + "=" + value + ";" + expires + ";path=/";
        }
    </script>
</body>
</html>
