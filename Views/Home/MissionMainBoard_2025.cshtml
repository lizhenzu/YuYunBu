    <script>
        function showLoading() {
            // Show the loading overlay and apply animations
            document.getElementById('loadingOverlay').style.display = 'block';
            document.body.style.pointerEvents = 'none'; // Disable all inputs
        }

        function hideLoading() {
            // Hide the loading overlay and remove input blocking
            document.getElementById('loadingOverlay').style.display = 'none';
            document.body.style.pointerEvents = 'auto'; // Re-enable inputs
        }
        function goBack() {
            window.history.back();
        }

    </script>
    <script>

        function getFirstDayOfWeek(year, month) {
            // 해당 년월의 1일 날짜 객체 생성 (month는 0부터 시작하므로 -1 필요 없음)
            let firstDay = new Date(year, month - 1, 1);

            // 1일부터 시작하여 토요일을 찾음
            while (firstDay.getDay() !== 6) { // getDay()가 6이면 토요일
                firstDay.setDate(firstDay.getDate() + 1);
            }

            // 찾은 토요일의 주 첫날(일요일) 계산
            let sunday = new Date(firstDay);
            sunday.setDate(sunday.getDate() - 6);

            // 일자만 반환
            return sunday.getDate();
        } 
        function goToPage(url) {
            showLoading();
            window.location.href = url;
        }
        function formatDate(firstDay, dayCount) {
            // firstDay 변수를 Date 객체로 변환합니다.
            const firstDate = new Date(firstDay);

            console.log(firstDay); 

            // 새로운 날짜를 생성하기 위해 firstDate의 년, 월을 가져옵니다.
            const year = firstDate.getFullYear();
            const month = String(firstDate.getMonth() + 1).padStart(2, '0'); // 월은 0부터 시작하므로 +1을 해줍니다.

            // dayCount 값을 사용하여 일자를 설정합니다.
            const day = String(dayCount).padStart(2, '0');

            // 새로운 날짜 형식의 문자열을 반환합니다.
            return `${year}-${month}-${day}`;
        }

        function formatDate2(year, month, day) {
            // 월과 일이 한 자리 숫자인 경우 두 자리로 포맷 (예: 01, 09)
            const formattedMonth = String(month).padStart(2, '0');
            const formattedDay = String(day).padStart(2, '0');
            // 원하는 형식으로 반환
            return `${year}-${formattedMonth}-${formattedDay}`;
        }
        function generateCalendar() {
            const year = @todayDT.Year;
            const month = @todayDT.Month;
            const toDayDay = @todayDT.Day; 
            const homeworkInput = "@ViewData["MonString"]";
            const homeworkDays = homeworkInput.split(',').map(num => parseInt(num.trim())).filter(num => !isNaN(num));

            const firstDay = new Date(year, month - 1, 1).getDay();
            const daysInMonth = new Date(year, month, 0).getDate();

            let calendarHTML = `
                                <thead>
                                    <tr>
                                        <th>일</th>
                                        <th>월</th>
                                        <th>화</th>
                                        <th>수</th>
                                        <th>목</th>
                                        <th>금</th>
                                        <th>토</th>
                                    </tr>
                                </thead>
                                <tbody>
                            `;

            let dayCount = 1;
            let dayCountNext = 0;
            let prevDay = getFirstDayOfWeek(year, month );
            for (let i = 0; i < 6; i++) {
                calendarHTML += "<tr>";
                for (let j = 0; j < 7; j++) {
                    if (i === 0 && j < firstDay) {
                        let valueVariDay = formatDate2(year, month - 1, prevDay);
                        calendarHTML += "<td style='color:gray;' onclick=goToPage('/Home/goWorkDT?workDT=" + valueVariDay + "')>" + prevDay + "</td>";
                        prevDay = prevDay + 1;
                    } else if (dayCount > daysInMonth) {
                        dayCountNext = dayCountNext + 1;
                        let valueVariDay = formatDate2(year, month + 1, dayCountNext);
                        calendarHTML += "<td style='color:gray;' onclick=goToPage('/Home/goWorkDT?workDT=" + valueVariDay + "')>" + dayCountNext + "</td>";
                    } else {
                        let homeworkMark = homeworkDays.includes(dayCount) ? "<img src='@missioncompleted' class='calendar-icon'>" : "";
                    
                        let valueVariDay = formatDate2(year, month, dayCount);
                        calendarHTML += "<td onclick=goToPage('/Home/goWorkDT?workDT=" + valueVariDay + "')>";

                        if (toDayDay == dayCount) {
                            calendarHTML += "<div class='mis11us'><span>" + dayCount + "</span></div>";
                        }
                        else
                        {
                            calendarHTML += "<span>" + dayCount + "</span>";
                        }
                        calendarHTML += homeworkMark + "</td>";
                        dayCount++;
                    }
                }
                calendarHTML += "</tr>";
                if (dayCount > daysInMonth) break;
            }

            calendarHTML += "</tbody>";
            document.getElementById('calendar').innerHTML = calendarHTML;
        }

        window.onload = generateCalendar;
    </script>
</head>
