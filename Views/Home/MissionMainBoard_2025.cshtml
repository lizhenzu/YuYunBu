                </h2>
                <h3>
                   시상포인트에 도달 하셨어요.
                </h3>
            </div>

            <!-- 영역 2 -->
            <div class="popup-content">
                <p>이 페이지 중간에 '🎁 선물선택하기' 박스에서 </p>
                <p>'선물선택' 버튼을 눌러서 선물을 선택해 보세요.^^</p>
            </div>

            <!-- 영역 3 -->
            <div class="popup-checkboxes">
                <label><input type="checkbox" id="hideToday" onclick="handleCheckbox('hideToday', 1)"> 오늘 하루 안보기</label>
                <label><input type="checkbox" id="hide7Days" onclick="handleCheckbox('hide7Days', 7)"> 7일간 안보기</label>
            </div>
        </div>
    </div>
 
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const hideToday = getCookie('hideToday');
            const hide7Days = getCookie('hide7Days');
             
            var shouldShowPopup = false;
            var shouldShowPopupCookie = false;

     
        @{
            bool shouldShow = false;

            // 시상 대상이면서 선물 미선택 시 팝업 표시
            if (rerachPoint)
            {
                shouldShow = true;
            }
        }
            shouldShowPopup = @(shouldShow.ToString().ToLower());
            shouldShowPopupCookie = @(showPopupCookieValue.ToString().ToLower());

            if (shouldShowPopup) {
                if (shouldShowPopupCookie == false) { // cookie에 값이 없으면 
                    document.getElementById('popup-background').style.display = 'flex'; // 팝업 표시
                    document.body.style.overflow = 'hidden'; // 스크롤 비활성화
                }
            }

        });

        function handleCheckbox(cookieName, days) {
            setCookie(cookieName, 'true', days); // 쿠키 설정
            document.getElementById('popup-background').style.display = 'none'; // 팝업 숨김
            document.body.style.overflow = 'auto'; // 스크롤 다시 활성화
        }

        // 쿠키 설정 함수
        function setCookie(name, value, days) {
            const data = {
                UserId: "@UserId",
                cookieName: "@CookieKey.MissionMainBoard_HideDay.ToString()",
                cookieValue: "true",
                cookieDays: days
            };
            console.log(data);
            doProcess(data, 'UpsertUserCookieSettings','n');
            const date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000)); // 쿠키 만료 시간 설정
            const expires = "expires=" + date.toUTCString();
            document.cookie = name + "=" + value + ";" + expires + ";path=/"; // 쿠키 설정
        }

        // 쿠키 가져오기 함수
        function getCookie(name) {
            const cname = name + "=";
            const decodedCookie = decodeURIComponent(document.cookie);
            const ca = decodedCookie.split(';');
            for (let i = 0; i < ca.length; i++) {
                let c = ca[i].trim();
                if (c.indexOf(cname) === 0) {
                    return c.substring(cname.length, c.length);
                }
            }
            return ""; // 쿠키가 없으면 빈 문자열 반환
        }
    </script>


</body>
</html>