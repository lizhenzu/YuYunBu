@using BulletinBoard.Helpers
@*  ══════════════════════════════════════════════════════════════
    수능날 안내 화면 — 2026-11-19
    · 특별 기도 날(Helpers/TodayFeaturedPray)에 홈에 처음 들어오면 보인다 (같은 브라우저 하루 한 번)
    · 버튼 두 개: 수험생 기도문(TodayFeaturedPray.Url) / 유년부 홈("/")
    · 백업: Views/Home/Index.cshtml.bak_before_suneung (이 화면을 넣기 전 홈)
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;
    var slToday = DateHelper.GetKoreaToday();
    string[] slDow = { "일", "월", "화", "수", "목", "금", "토" };
    string slDate = $"{slToday:yyyy년 M월 d일} {slDow[(int)slToday.DayOfWeek]}요일";
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#EAF2FD" />
    <meta name="robots" content="noindex" />
    <title>오늘은 수능날이에요 · 잠실새내교회 유년부</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; min-height: 100dvh; display: flex; align-items: center; justify-content: center;
               background: #EAF2FD; font-family: "Noto Sans KR", "Malgun Gothic", "Apple SD Gothic Neo", system-ui, sans-serif;
               color: #111827; padding: 24px; }
        .card { width: 100%; max-width: 360px; background: #fff; border-radius: 22px; box-shadow: 0 10px 30px rgba(47,128,237,.15);
                padding: 34px 24px 26px; text-align: center; }
        .dd { display: inline-block; background: #2F80ED; color: #fff; font-weight: 800; font-size: 13px; letter-spacing: .06em;
              padding: 6px 14px; border-radius: 99px; }
        .ic { font-size: 44px; margin: 18px 0 6px; }
        h1 { font-size: 23px; line-height: 1.45; margin: 6px 0 0; font-weight: 800; word-break: keep-all; }
        .s { margin: 12px 0 0; font-size: 14.5px; line-height: 1.7; color: #4B5563; word-break: keep-all; }
        .date { margin-top: 10px; font-size: 12.5px; color: #9CA3AF; }
        .btns { display: flex; flex-direction: column; gap: 12px; margin-top: 28px; }
        .b { display: block; padding: 17px 16px; border-radius: 14px; font-size: 17px; font-weight: 800; text-decoration: none; }
        .b:focus-visible { outline: 3px solid #93C5FD; outline-offset: 2px; }
        .p { background: #2F80ED; color: #fff; box-shadow: 0 6px 16px rgba(47,128,237,.35); }
        .p:active { background: #2266C6; }
        .p small { display: block; font-size: 12.5px; font-weight: 500; opacity: .9; margin-top: 3px; }
        .g { background: #fff; color: #2F80ED; border: 1.5px solid #BFD7FA; }
        .g:active { background: #F3F8FE; }
        .f { margin-top: 18px; font-size: 11.5px; color: #9CA3AF; }
    </style>
</head>
<body>
    <main class="card" role="main">
        <span class="dd">D-DAY · 오늘 수능</span>
        <div class="ic" aria-hidden="true">🙏</div>
        <h1>오늘은 수능날이에요</h1>
        <p class="s">시험장으로 향하는 수험생들을 위해<br />함께 기도해 주세요</p>
        <div class="date">@slDate</div>
        <div class="btns">
            <a class="b p" href="@TodayFeaturedPray.Url">수험생 위해 기도하러 가기<small>오늘의 기도문 읽기</small></a>
            <a class="b g" href="/">유년부 홈으로 가기</a>
        </div>
        <div class="f">잠실새내교회 유년부</div>
    </main>
</body>
</html>
