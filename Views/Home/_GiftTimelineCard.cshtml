@using BulletinBoard.ViewModels.Home


@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IUserUiPreferenceService PrefSvc

@using BulletinBoard.Common;
@using BulletinBoard.Models;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;


@model bool
@*
    홈 "축하해 주세요~~" — 도토리 선물 점수 타임라인 (2026-09-26 확정 시안)
    · 아이마다 몇 점에 무슨 선물을 신청했는지 + 최종 상태 하나 (신청중 · 구매완료 · 전달완료)
    · 전체 유저가 보는 공개 카드 — 신청중·구매완료 선물이 있는 친구만 (나의 선물은 Index 의 "나의 선물함" 카드)
    · 지금 점수 표시 (다음 선물 칸은 NextPoint 가 있을 때만 — 지금은 컨트롤러가 넣지 않음)
    · PC(640px 이상)는 가로 타임라인, 휴대폰은 세로 타임라인
    Model = isStaff (관리자 → 링크)
*@
@{
    bool isStaff = Model;
    var kids = ViewBag.GiftTimelineKids as List<GiftTimelineKidVM> ?? new List<GiftTimelineKidVM>();
    const int FirstShow = 3;
    const string PickUrl = "/StudentPointDashboard4/GiftSelect?type=point&returnTo=home";
    const string AdminUrl = "/StudentPointDashboard4/AdminPurchaseList";   // 관리자만 — 선물 칸을 누르면 이동
}
@functions {
    // 한 아이의 칸들: 받은 선물 · (나) 안 고른 단계 · 다음 선물 — 점수 순
    record Step(int Point, string Kind, GiftTimelineItemVM? Item);   // Kind: item · todo · next

    static List<Step> Steps(GiftTimelineKidVM k)
    {
        var s = k.Items.Select(i => new Step(i.Milestone, "item", i)).ToList();
        if (k.PendingMilestone is int pm) s.Add(new Step(pm, "todo", null));
        s = s.OrderBy(x => x.Point).ToList();
        if (k.NextPoint is int np && np > k.Total) s.Add(new Step(np, "next", null));
        return s;
    }
    static (string css, string text) St(string status) => status switch
    {
        "HIDDEN"    => ("done", "전달완료"),
        "PURCHASED" => ("buy", "구매완료"),
        _           => ("req", "신청중")
    };
    static string N(int v) => v.ToString("N0");

    // ── 날짜 (2026-09-26) — 선물 칸에는 최종 상태의 날짜 하나만, 글자 없이 "09/21" ──
    //    전달완료 → 전달일 (DeliveredAt 은 2026-09-26 부터 저장 — 그 전 선물은 구매일, 그것도 없으면 신청일)
    //    구매완료 → 구매일 · 신청중 → 신청일.  색(주황·파랑·초록)으로 어떤 날짜인지 구분한다
    static DateTime FinalDate(GiftTimelineItemVM i) => i.Status switch
    {
        "HIDDEN"    => i.DeliveredAt ?? i.PurchasedAt ?? i.CreatedAt,
        "PURCHASED" => i.PurchasedAt ?? i.CreatedAt,
        _           => i.CreatedAt
    };
    static string D(DateTime d) => d.Year == DateHelper.GetKoreaNow().Year
        ? d.ToString("M/d", System.Globalization.CultureInfo.InvariantCulture)         // 앞의 0 없이 "6/9" · InvariantCulture — "/" 가 "-" 로 바뀌지 않게
        : d.ToString("yyyy.M/d", System.Globalization.CultureInfo.InvariantCulture);

    // 소요일수 — 앞 선물을 신청한 날 → 이 선물을 신청한 날 (점수에 닿은 날은 따로 저장되지 않아 신청일로 잰다)
    static string? Gap(List<Step> steps, int i)
    {
        if (i <= 0 || i >= steps.Count) return null;
        var a = steps[i - 1].Item; var b = steps[i].Item;
        if (a == null || b == null) return null;
        int d = (b.CreatedAt.Date - a.CreatedAt.Date).Days;
        if (d < 0) return null;
        return d == 0 ? "같은 날" : $"{d}일";
    }
}

@* 한 아이의 타임라인 (가로 + 세로 — 화면 폭으로 하나만 보인다) *@
@{
    async Task Kid(GiftTimelineKidVM k, string extraCss)
    {
        var steps = Steps(k);
        int n = Math.Max(1, steps.Count);
        int lastHit = steps.FindLastIndex(s => s.Kind != "next");
        var next = steps.FirstOrDefault(s => s.Kind == "next");
        double t = 0;
        if (lastHit >= 0 && next != null && next.Point > steps[lastHit].Point)
            t = Math.Clamp((k.Total - steps[lastHit].Point) / (double)(next.Point - steps[lastHit].Point), 0, 1);
        int anchor = Math.Max(0, lastHit);
        string pos = (anchor + t).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        string nn = n.ToString();
        var cItems = steps.Where(x => x.Kind == "item" && x.Item != null).ToList();   // 휴대폰 축소판 칸

        <div class="kid @extraCss">
            <div class="kTop">
                <div class="av"><img src="@k.Photo" alt="@k.DisplayName" onerror="this.onerror=null;this.src='/images/icon/people/people_01.webp';" onclick="openPhotoModal(this.src, this.alt)" /></div>
                <div class="who">
                    <b>@k.DisplayName@if (k.IsMe) {<span class="me">나</span>}</b>
                    <div class="s">@(k.ClassLabel == null ? "" : k.ClassLabel + " · ")지금 <b>@N(k.Total)</b>점</div>
                </div>
            </div>

            @* 휴대폰 축소판 (2026-09-27) — 가족팀 마일스톤 축소판(.fmCs)과 같은 박스 : 점수 · 사진 · 선물 · 상태.  "상세히"를 누르면 세로 타임라인 *@
            <div class="cmp" style="grid-template-columns: repeat(@(Math.Max(1, Math.Min(cItems.Count, 4))), 1fr);">
                @foreach (var cs in cItems)
                {
                    var (ccss, ctext) = St(cs.Item!.Status);
                    <div class="cbox">
                        <div class="p">@N(cs.Point)</div>
                        <div class="im"><img src="/images/AwardItem/@(cs.Item.ProductID).jpg" alt="" loading="lazy" onerror="this.parentNode.classList.add('noimg');this.remove();" /></div>
                        <div class="cn">@cs.Item.ProductName</div>
                        <span class="bdg @ccss">@ctext</span>
                    </div>
                }
            </div>

            @* PC: 가로 *@
            <div class="hz" style="--n:@nn">
                <div class="axis">
                    @if (lastHit >= 0) { <div class="fill" style="width:calc(@pos * 100% / @nn)"></div>
                                         <span class="now" style="left:calc((@pos + .5) * 100% / @nn)">지금 @N(k.Total)</span> }
                    @for (int i = 0; i < steps.Count; i++)
                    {
                        var s = steps[i];
                        var gap = Gap(steps, i);   // 앞 점수와의 가운데(= 이 칸의 왼쪽 끝) 선 위에
                        <div class="ms @(s.Kind == "next" ? "next" : "hit")">@if (gap != null) {<span class="gap">@gap</span>}<div class="dot"></div><div class="p">@N(s.Point)점</div></div>
                    }
                </div>
                <div class="boxes">
                    @foreach (var s in steps) { await Box(s, k, false); }
                </div>
            </div>

            @* 휴대폰: 세로 *@
            <div class="vt">
                @for (int i = 0; i < steps.Count; i++)
                {
                    var s = steps[i];
                    bool hit = s.Kind != "next";
                    bool isFirst = i == 0;
                    bool isLast = i == steps.Count - 1;
                    bool nowAfter = i == lastHit;   // 이 칸 다음에 "지금" 줄
                    string cls = (hit ? "hit" : "next") + (isFirst ? " first" : "") + (isLast && !nowAfter ? " last" : "")
                               + (hit && !isFirst ? " up" : "") + (hit ? " dn" : "");
                    var vgap = Gap(steps, i);
                    if (vgap != null)
                    {
                        // 앞 칸과 이 칸 사이 — 걸린 날 수
                        <div class="vr vgap up dn">
                            <div class="pt"></div>
                            <div class="rail"><span class="gap">@vgap</span></div>   @* 선 위에 걸쳐서 *@
                        </div>
                    }
                    <div class="vr @cls">
                        <div class="pt">@N(s.Point)<small>점</small></div>
                        <div class="rail"><span class="dot"></span></div>
                        @{ await Box(s, k, true); }
                    </div>
                    @if (nowAfter)
                    {
                        <div class="vr nowRow up @(isLast ? "last" : "")">
                            <div class="pt"></div>
                            <div class="rail"><span class="dot"></span></div>
                            <span class="lbl">지금 @N(k.Total)점</span>
                        </div>
                    }
                }
            </div>
        </div>
    }

    async Task Box(Step s, GiftTimelineKidVM k, bool vertical)
    {
        if (s.Kind == "item" && s.Item != null)
        {
            var (css, text) = St(s.Item.Status);
            if (isStaff)
            {
                // 관리자만 — 선물 칸을 누르면 관리자 선물 구매 목록으로 (예전 "관리자 →" 버튼 대신)
                <a class="gb @css lnk" href="@AdminUrl" title="관리자 — 선물 구매 목록으로">@{ await BoxIn(s.Item, css, text, vertical, false); }</a>
            }
            else
            {
                <div class="gb @css">@{ await BoxIn(s.Item, css, text, vertical, true); }</div>
            }
        }
        else if (s.Kind == "todo")
        {
            <div class="gb todo">
                @if (vertical) { <div class="tx"><div class="nm">아직 안 골랐어요</div></div> } else { <div class="nm">아직 안 골랐어요</div> }
                <a class="go" href="@PickUrl">선물 고르기 →</a>
            </div>
        }
        else
        {
            <div class="gb next">
                @if (vertical) { <div class="tx"><div class="nm">다음 선물</div></div> } else { <div class="nm">다음 선물</div> }
                <span class="sub">@N(s.Point - k.Total)점 남았어요</span>
            </div>
        }
    }

    // 선물 칸 속 — 사진 · 이름 · 상태 · 날짜.  zoom=false(관리자 링크)면 사진을 눌러도 크게 보기 대신 링크로 간다
    async Task BoxIn(GiftTimelineItemVM item, string css, string text, bool vertical, bool zoom)
    {
        await Task.CompletedTask;
        <div class="im">
            @if (zoom)
            {
                <img src="/images/AwardItem/@(item.ProductID).jpg" alt="@item.ProductName" onerror="this.parentNode.classList.add('noimg');this.remove();" onclick="openPhotoModal(this.src, this.alt)" />
            }
            else
            {
                <img src="/images/AwardItem/@(item.ProductID).jpg" alt="@item.ProductName" onerror="this.parentNode.classList.add('noimg');this.remove();" />
            }
        </div>
        if (vertical)
        {
            <div class="tx"><div class="nm">@item.ProductName</div></div>
            <div class="side"><span class="bdg @css">@text</span><span class="dt @css">@D(FinalDate(item))</span></div>
        }
        else
        {
            <div class="nm">@item.ProductName</div>
            <span class="bdg @css">@text</span>
            <span class="dt @css">@D(FinalDate(item))</span>
        }
    }
}

@if (kids.Count > 0)
