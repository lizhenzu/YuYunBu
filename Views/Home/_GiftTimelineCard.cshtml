    .gtl .cmp, .gtl .gtlMore { display: none; }
    .gtl .gtlMore { flex: none; font: inherit; font-size: 11.5px; font-weight: 800; color: #b45309; background: #FFF7E8; border: 1px solid #FBD9A0;
                    border-radius: 999px; padding: 5px 10px; cursor: pointer; white-space: nowrap; }
    .gtl .gtlMore.on { background: #b45309; color: #fff; border-color: #b45309; }
    /* 가족팀 마일스톤 축소판(.fmCs)과 같은 모양 — 칸마다 점수 · 사진 · 선물 · 상태를 세로로 */
    .gtl .cmp { gap: 6px; margin-top: 10px; }
    .gtl .cmp .cbox { border-radius: 12px; border: 1px solid #fde68a; background: #fffbeb; padding: 7px 5px; text-align: center;
                      display: flex; flex-direction: column; align-items: center; gap: 2px; min-width: 0; }
    .gtl .cmp .cbox .p { font-family: "Inter", sans-serif; font-size: 11px; font-weight: 800; color: #0f172a; }
    .gtl .cmp .cbox .im { width: 26px; height: 26px; border-radius: 7px; overflow: hidden; background: #fff; display: grid; place-items: center; font-size: 14px; }
    .gtl .cmp .cbox .im img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .gtl .cmp .cbox .im.noimg::before { content: "🎁"; }
    .gtl .cmp .cbox .cn { font-size: 11px; font-weight: 800; color: #1e293b; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .gtl .cmp .cbox .bdg { font-size: 9.5px; padding: 1px 6px; }

    @@media (max-width: 639px) {
        .gtl .hz { display: none; }
        .gtl .vt { display: none; }
        .gtl .cmp { display: grid; }
        .gtl .gtlMore { display: inline-flex; }
        /* 상세히 — 카드 오른쪽 맨 위(키커 줄)로 올려 제목 · 설명이 가로폭을 다 쓰게 */
        .gtl { position: relative; }
        .gtl .gtlMore { position: absolute; top: 10px; right: 10px; font-size: 11px; padding: 4px 9px; }
        .gtl .hd { margin-top: 10px; }   /* 버튼(키커 줄) 아래로 제목을 내려 겹치지 않게 — 아래 가족팀 카드와 같게 */
        .gtl.open .vt { display: block; }     /* 상세히 — 지금 모습(세로 타임라인) */
        .gtl.open .cmp { display: none; }
        .gtl .kid { margin-top: 10px; padding-top: 10px; }
    }

    .gtl .more { display: none; }
    .gtl.all .more { display: block; }
    .gtl .ft { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 12px; padding-top: 10px; border-top: 1px dashed #E2E8F0; font-size: 11.5px; color: #475569; }
    .gtl .ft b { color: #1F2A22; }
    .gtl .ft button { border: 0; background: none; font: inherit; font-weight: 800; color: #b45309; cursor: pointer; padding: 4px 0; }
</style>

@* ⚠️ 나의 선물은 여기서 보여 주지 않는다 — 본인 전용 "🎁 나의 선물함" 카드(Index.cshtml .gcb)에서 보여 준다 (2026-09-26) *@

@if (kids.Count > 0)
{
    <section class="gtl" id="gtlFriends">
        <div class="kick">🎁 @ConstatsCommon.myDoToRi 선물</div>
        <div class="hd">
            <div><div class="t">축하해 주세요~~</div><div class="s">@ConstatsCommon.myDoToRi 점수에 도달해 선물을 받는 친구들이에요.</div></div>
            @* "관리자 →" 버튼은 없앴다 — 관리자는 선물 칸을 누르면 같은 곳으로 간다 (2026-09-26) *@
            @* 휴대폰에서만 — 축소판 ↔ 지금 모습 *@
            <button type="button" class="gtlMore" aria-expanded="false"
                    onclick="var c=document.getElementById('gtlFriends'),o=c.classList.toggle('open');this.textContent=o?'접기 ▴':'상세히 ▾';this.classList.toggle('on',o);this.setAttribute('aria-expanded',o);">상세히 ▾</button>
        </div>
        @for (int i = 0; i < kids.Count; i++)
        {
            await Kid(kids[i], (i == 0 ? "first" : "") + (i >= FirstShow ? " more" : ""));
        }
        <div class="ft">
            <span>선물은 <b>주일 예배 시간</b>에 전달돼요</span>
            @if (kids.Count > FirstShow)
            {
                <button type="button" onclick="var c=document.getElementById('gtlFriends');c.classList.toggle('all');this.textContent=c.classList.contains('all')?'▲ 접기':'▼ @(kids.Count)명 모두 보기';">▼ @(kids.Count)명 모두 보기</button>
            }
        </div>
    </section>
}
}
