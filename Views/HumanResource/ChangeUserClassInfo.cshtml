@using BulletinBoard.Common;
@model UserInfo

@*  ══════════════════════════════════════════════════════════════
    부서 정보 변경 ④ 학년·반 — 2026-10-04 시안 확정 (DailyMission4 밝은 흰색 · 공용 wwwroot/css/quiz-bright.css)
    · 폼 이름 · 검증 · 저장 주소(ChangeUserClassInfoProcess) · hidden 값은 그대로
    · 이전 화면은 ChangeUserClassInfo.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>학년·반 입력</title>
    <link rel="stylesheet" href="/css/quiz-bright.css" asp-append-version="true">
    <style>
        body { margin: 0; background: #FFFFFF; }
        .dp-in { text-align: right; }
    </style>
</head>
<body>

<div class="qb-wait" id="loadingOverlay"><div class="box"><div class="sp"></div>저장하는 중이에요<small>잠시만 기다려 주세요</small></div></div>

<div class="qb">

    <div class="qb-top">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/HumanResource/ManageUserInfo?UserId=@Model.UserId">정보 관리</a><span class="sep">›</span>학년·반</span>
        <span>DEPT</span>
    </div>

    <div class="qb-k">STEP 3</div>
    <h1 class="qb-h1">학년과 반을 입력해 주세요</h1>
    <div class="qb-sub">@Model.FullName 님 · 현재 @ViewData["DeptNM"]의 @(ViewData["RoleNM"])을(를) 선택하셨어요.</div>
    <div class="dp-steps"><i class="on"></i><i class="on"></i><i class="on"></i></div>

    <form action="/HumanResource/ChangeUserClassInfoProcess" method="POST" onsubmit="return beforeSubmit(this);">
        <div asp-validation-summary="All"></div>

        <div class="qb-f">
            <label asp-for="ClassYear"></label>
            <input asp-for="ClassYear" placeholder="@Html.DisplayNameFor(model => model.ClassYear)" class="qb-in dp-in" />
            <span asp-validation-for="ClassYear" class="error"></span>
        </div>
        <div class="qb-f">
            <label asp-for="ClassBan"></label>
            <input asp-for="ClassBan" placeholder="@Html.DisplayNameFor(model => model.ClassBan)" class="qb-in dp-in" />
            <span asp-validation-for="ClassBan" class="error"></span>
        </div>

        <input type="hidden" id="UserId" name="UserId" value="@Model.UserId" />
        <input type="hidden" id="DeptCode" name="DeptCode" value="@ViewData["DeptCode"]" />
        <input type="hidden" id="DeptNM" name="DeptNM" value="@ViewData["DeptNM"]" />
        <input type="hidden" id="RoleCode" name="RoleCode" value="@ViewData["RoleCode"]" />
        <input type="hidden" id="RoleNM" name="RoleNM" value="@ViewData["RoleNM"]" />

        <button type="submit" class="qb-submit">저장</button>
    </form>

    <div class="qb-btns">
        <a class="qb-btn g" href="/HumanResource/ChangeUseRoleMain?UserId=@Model.UserId&DeptCode=@Model.DeptCode&DeptNM=@Model.DeptNM">이전 화면</a>
        <a class="qb-btn g" href="/HumanResource/ManageUserInfo?UserId=@Model.UserId">취소</a>
    </div>

    <div class="qb-ft">
        <span>4 / 4</span>
        <span><a href="/">@ConstatsCommon.ToHome</a></span>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
@await Html.PartialAsync("_ValidationScriptsPartial")
<script>
    function beforeSubmit(form) {
        if (window.jQuery && jQuery.fn.valid && !jQuery(form).valid()) return false;
        document.getElementById('loadingOverlay').classList.add('on');
        return true;
    }
    window.addEventListener('pageshow', function () { document.getElementById('loadingOverlay').classList.remove('on'); });
</script>
</body>
</html>
