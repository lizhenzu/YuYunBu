@using BulletinBoard.Common;
@model IEnumerable<BulletinBoard.Models.CodeData>

@*  ══════════════════════════════════════════════════════════════
    부서 정보 변경 ② 부서 선택 — 2026-10-04 시안 확정 (DailyMission4 밝은 흰색 · 공용 wwwroot/css/quiz-bright.css)
    · 선택 이동 주소(ChangeUseRoleMain)는 그대로.  이전 화면은 ChangeUserDeptInfoMain.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
    UserInfo __UserInfos = ViewData["userInfo"] as UserInfo;
    int no = 0;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>부서 선택</title>
    <link rel="stylesheet" href="/css/quiz-bright.css" asp-append-version="true">
    <style>body { margin: 0; background: #FFFFFF; }</style>
</head>
<body>
<div class="qb">

    <div class="qb-top">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/HumanResource/ManageUserInfo?UserId=@__UserInfos.UserId">정보 관리</a><span class="sep">›</span>부서 선택</span>
        <span>DEPT</span>
    </div>

    <div class="qb-k">STEP 1</div>
    <h1 class="qb-h1">부서를 선택해 주세요</h1>
    <div class="qb-sub">@__UserInfos.FullName 님이 속할 부서를 골라요.</div>
    <div class="dp-steps"><i class="on"></i><i></i><i></i></div>

    @foreach (var item in Model)
    {
        no++;
        <a class="qb-row" href="/HumanResource/ChangeUseRoleMain?UserId=@__UserInfos.UserId&DeptCode=@item.MinorCD&DeptNM=@item.MinorNM">
            <span class="n">@no.ToString("00")</span>
            <span class="t"><b>@item.MinorNM</b></span>
            <span class="g">›</span>
        </a>
    }

    <div class="qb-ft">
        <span>2 / 4</span>
        <span><a href="/HumanResource/ChangeUserDeptInfoIntro?UserId=@__UserInfos.UserId">이전 화면</a><a href="/">@ConstatsCommon.ToHome</a></span>
    </div>
</div>
</body>
</html>
