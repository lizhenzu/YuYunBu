@using BulletinBoard.Common;
@model BulletinBoard.Models.UserInfo

@*  ══════════════════════════════════════════════════════════════
    부서 정보 변경 ⑤ 결과 — 2026-10-04 시안 확정 (DailyMission4 밝은 흰색 · 공용 wwwroot/css/quiz-bright.css)
    · 이전 화면은 ChangeUserDeptInfoProcessResult.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>부서 정보 변경 완료</title>
    <link rel="stylesheet" href="/css/quiz-bright.css" asp-append-version="true">
    <style>body { margin: 0; background: #FFFFFF; }</style>
</head>
<body>
<div class="qb">

    <div class="qb-top">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/HumanResource/ManageUserInfo?UserId=@Model.UserId">정보 관리</a><span class="sep">›</span>변경 완료</span>
        <span>DEPT</span>
    </div>

    <div class="qb-k">DONE</div>
    <h1 class="qb-h1">부서 정보를 바꿨어요</h1>

    <div class="dp-done">@Model.FullName 님의 정보를 저장했어요</div>

    @await Html.PartialAsync("_Display_Dept_Info", Model)

    <div class="qb-btns">
        <a class="qb-btn g" href="/">@ConstatsCommon.ToHome</a>
        <a class="qb-btn p" href="/HumanResource/ManageUserInfo?UserId=@Model.UserId">정보 관리</a>
    </div>

    <div class="qb-ft">
        <span>변경 완료</span>
        <span><a href="/">@ConstatsCommon.ToHome</a></span>
    </div>
</div>
</body>
</html>
