@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@model BulletinBoard.Models.UserInfo
@inject IAuthService AuthService

@{
    Layout = null;

    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    var isBasic = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Basic));

    bool isStaff = (isSuperAdmin || isAdmin);
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>정보 관리</title>

    <style>
        :root {
            --bg0: #F4F7FF;
            --bg1: #FFFFFF;
            --card: #FFFFFF;
            --card2: #F8FAFF;
            --line: rgba(99,102,241,.14);
            --text: #1E2433;
            --muted: #6B7280;
            --muted2: #9CA3AF;
            --accent: #6366F1;
            --accent2: #38BDF8;
            --danger: #F43F5E;
            --amber: #F59E0B;
            --shadow: 0 22px 60px rgba(99,102,241,.14);
            --radius: 26px;
            --radius2: 18px;
            --sans: system-ui, -apple-system, Segoe UI, Roboto, "Noto Sans KR", Arial, sans-serif;
            --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            font-family: var(--sans);
            color: var(--text);
            background: radial-gradient(1100px 650px at 8% 8%, rgba(99,102,241,.10), transparent 55%), radial-gradient(900px 600px at 92% 16%, rgba(56,189,248,.12), transparent 55%), radial-gradient(900px 700px at 60% 95%, rgba(244,63,94,.06), transparent 55%), linear-gradient(180deg, var(--bg1), var(--bg0));
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 18px 12px;
        }

        .wrap {
            width: min(980px, 100%);
            display: grid;
            grid-template-columns: 360px 1fr;
            gap: 14px;
        }

        @@media (max-width: 900px) {
            body

        {
            align-items: flex-start;
        }

        .wrap {
            grid-template-columns: 1fr;
        }

        }

        .panel {
            border: 1px solid var(--line);
            background: linear-gradient(180deg, #FFFFFF, #FAFBFF);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            position: relative;
        }

            .panel::before {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(800px 260px at 20% 0%, rgba(99,102,241,.06), transparent 60%), radial-gradient(800px 260px at 90% 10%, rgba(56,189,248,.06), transparent 60%);
                pointer-events: none;
            }

        .panelInner {
            position: relative;
            padding: 16px;
        }

        /* ===== Left: Profile ===== */
        .heroTop {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: 999px;
            border: 1px solid var(--line);
            background: var(--card2);
            color: var(--muted);
            font-size: 12px;
            user-select: none;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 0 3px rgba(99,102,241,.14);
        }

            .dot.admin {
                background: var(--accent2);
                box-shadow: 0 0 0 3px rgba(56,189,248,.16);
            }

            .dot.super {
                background: var(--danger);
                box-shadow: 0 0 0 3px rgba(244,63,94,.14);
            }

        .profile {
            margin-top: 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 10px;
        }

        .avatar {
            width: 156px;
            height: 156px;
            border-radius: 999px;
            border: 1px solid var(--line);
            background: var(--card2);
            box-shadow: 0 18px 50px rgba(99,102,241,.18);
            overflow: hidden;
            position: relative;
        }

            .avatar::after {
                content: "";
                position: absolute;
                inset: -2px;
                background: conic-gradient(from 210deg, rgba(99,102,241,.45), rgba(56,189,248,.40), rgba(244,63,94,.28), rgba(99,102,241,.45));
                filter: blur(18px);
                opacity: .28;
                z-index: 0;
            }

            .avatar img {
                position: relative;
                z-index: 1;
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .name {
            margin: 0;
            font-size: 18px;
            font-weight: 950;
            letter-spacing: -.3px;
            color: var(--text);
        }

        .sub {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
        }

        .quick {
            margin-top: 14px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .qbtn {
            border: 1px solid var(--line);
            background: var(--card2);
            color: var(--text);
            padding: 12px 12px;
            border-radius: 16px;
            font-weight: 900;
            font-size: 13px;
            cursor: pointer;
            transition: transform .12s ease, background .12s ease, border-color .12s ease, box-shadow .12s ease;
            user-select: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

            .qbtn:hover {
                transform: translateY(-1px);
                background: #FFFFFF;
                border-color: rgba(99,102,241,.30);
                box-shadow: 0 12px 28px rgba(99,102,241,.16);
            }

            .qbtn .arr {
                width: 30px;
                height: 30px;
                border-radius: 999px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #FFFFFF;
                font-weight: 1000;
                background: linear-gradient(135deg, var(--accent), var(--accent2));
                box-shadow: 0 14px 32px rgba(99,102,241,.30);
            }

        /* ===== Right: Menu Sections ===== */
        .header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

            .header h1 {
                margin: 0;
                font-size: 18px;
                font-weight: 950;
                letter-spacing: -.3px;
                color: var(--text);
            }

            .header p {
                margin: 4px 0 0;
                color: var(--muted);
                font-size: 13px;
            }

        .sections {
            margin-top: 14px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .section {
            border-radius: 22px;
            border: 1px solid var(--line);
            background: var(--card2);
            overflow: hidden;
        }

        .sectionHead {
            padding: 12px 14px;
            border-bottom: 1px solid var(--line);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background: rgba(99,102,241,.04);
        }

            .sectionHead .t {
                font-size: 13px;
                font-weight: 950;
                letter-spacing: -.2px;
                color: var(--text);
            }

            .sectionHead .m {
                font-size: 12px;
                color: var(--muted);
            }

        .grid {
            padding: 12px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }
        @@media (max-width: 560px) {
            .grid

        {
            grid-template-columns: 1fr;
        }

        .quick {
            grid-template-columns: 1fr;
        }

        }

        .card {
            position: relative;
            border-radius: 18px;
            border: 1px solid var(--line);
            background: linear-gradient(180deg, #FFFFFF, #FBFCFF);
            cursor: pointer;
            transition: transform .12s ease, border-color .12s ease, background .12s ease, box-shadow .12s ease;
            overflow: hidden;
            user-select: none;
        }

            .card:hover {
                transform: translateY(-1px);
                border-color: rgba(99,102,241,.30);
                box-shadow: 0 14px 34px rgba(99,102,241,.14);
            }

        .cardIn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
        }

        .emojiBox {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            border: 1px solid var(--line);
            background: linear-gradient(135deg, rgba(99,102,241,.12), rgba(56,189,248,.12));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            line-height: 1;
            flex: 0 0 auto;
        }

        .txt {
            min-width: 0;
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .txt strong {
                font-size: 13px;
                font-weight: 950;
                letter-spacing: -.2px;
                color: var(--text);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .txt span {
                font-size: 12px;
                color: var(--muted);
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
                line-height: 1.35;
            }

        .go {
            width: 38px;
            height: 38px;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-weight: 1000;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            box-shadow: 0 14px 32px rgba(99,102,241,.26);
            border: 1px solid rgba(255,255,255,.30);
            flex: 0 0 auto;
        }

        /* ===== Emphasis blocks ===== */
        .dangerLine {
            border-color: rgba(244,63,94,.26);
            background: rgba(244,63,94,.05);
        }

            .dangerLine .go {
                background: linear-gradient(135deg, var(--danger), var(--amber));
            }

        /* ===== Footer bar ===== */
        .footerBar {
            margin-top: 12px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .fbtn {
            flex: 1 1 140px;
            border: 1px solid var(--line);
            background: var(--card2);
            color: var(--text);
            padding: 12px 12px;
            border-radius: 16px;
            font-weight: 950;
            font-size: 13px;
            cursor: pointer;
            transition: transform .12s ease, background .12s ease, border-color .12s ease, box-shadow .12s ease;
            user-select: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

            .fbtn:hover {
                transform: translateY(-1px);
                background: #FFFFFF;
                border-color: rgba(99,102,241,.30);
                box-shadow: 0 12px 28px rgba(99,102,241,.14);
            }

            .fbtn.home .arr {
                background: linear-gradient(135deg, var(--accent2), var(--accent));
            }

            .fbtn.logout {
                border-color: rgba(244,63,94,.28);
                background: rgba(244,63,94,.06);
            }

                .fbtn.logout .arr {
                    background: linear-gradient(135deg, var(--danger), var(--amber));
                }

        .arr {
            width: 30px;
            height: 30px;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-weight: 1000;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            box-shadow: 0 14px 32px rgba(99,102,241,.28);
        }
    </style>
</head>

<body>
    <div class="wrap">

        <!-- LEFT: 프로필 + 빠른 액션 -->
        <aside class="panel">
            <div class="panelInner">

                <div class="heroTop">
                    <div class="badge">
                        <span class="dot @(isSuperAdmin ? "super" : (isAdmin ? "admin" : ""))"></span>
                        @if (isSuperAdmin)
                        {
                            <text>권한 <strong style="color:var(--text);font-weight:900;">SuperAdmin</strong></text>
                        }
                        else if (isAdmin)
                        {

                            <text>권한 <strong style="color:var(--text);font-weight:900;">Admin</strong></text>
                        }
                        else
                        {

                            <text>권한 <strong style="color:var(--text);font-weight:900;">Basic</strong></text>
                        }
                    </div>

                    <div class="badge">
                        <span class="dot"></span>
                        <span>Updated <strong style="color:var(--text);font-weight:900;">@DateHelper.GetKoreaNow().ToString("yyyy-MM-dd")</strong></span>
                    </div>
                </div>

                <div class="profile">
                    <div class="avatar" title="프로필 사진">
                        <img id="myImage" src="@Model.ProfilePicturePath" alt="Profile Picture">
                    </div>

                    <h2 class="name">@Model.FullName</h2>
                    <p class="sub">내 정보 관리 · 빠른 설정</p>
                </div>

                <div class="quick">
                    <button class="qbtn" type="button" onclick="go('/HumanResource/ModifyHRPhoto?UserId=@Model.UserId')">
                        사진 정보 수정 <span class="arr">➜</span>
                    </button>
 
                </div>

               
                    <div class="quick" style="margin-top:10px;">
                        <button class="qbtn" type="button" onclick="go('/Profile/Edit')">
                            나의 정보 수정 <span class="arr">➜</span>
                        </button>
                         @if (isStaff)
                {
                        <button class="qbtn" type="button" onclick="go('/HumanResource/ChangeUserDeptInfoIntro?UserId=@Model.UserId')">
                            부서 정보 수정 <span class="arr">➜</span>
                        </button>
                }
                    </div>
                 
            </div>
        </aside>

        <!-- RIGHT: 메뉴들 -->
        <main class="panel">
            <div class="panelInner">

                <div class="sections">

                    @if (isStaff)
                    {
                        <section class="section">
                            <div class="sectionHead">
                                <div class="t">@ConstatsCommon.MainKeyTitle 시상/점수</div>
                                <div class="m">관리자 기능</div>
                            </div>
                            <div class="grid">
                                <div class="card dangerLine" onclick="go('/CheckPoint/ExpectedAward')">
                                    <div class="cardIn">
                                        <div class="emojiBox">🎯</div>
                                        <div class="txt">
                                            <strong>시상금 시뮬레이션</strong>
                                            <span>예상 시상금/점수 시뮬레이션</span>
                                        </div>
                                        <div class="go">➜</div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    @if (isStaff)
                    {
                        <section class="section">
                            <div class="sectionHead">
                                <div class="t">관리자 메뉴</div>
                                <div class="m">권한 필요</div>
                            </div>
                            <div class="grid">
                                <div class="card dangerLine" onclick="go('/Admin/Index')">
                                    <div class="cardIn">
                                        <div class="emojiBox">🛠️</div>
                                        <div class="txt">
                                            <strong>관리자메뉴</strong>
                                            <span>전체 관리자 패널로 이동</span>
                                        </div>
                                        <div class="go">➜</div>
                                    </div>
                                </div>

                                <div class="card" onclick="go('/Present/AwardItemAdmin')">
                                    <div class="cardIn">
                                        <div class="emojiBox">🎁</div>
                                        <div class="txt">
                                            <strong>선물아이템관리</strong>
                                            <span>선물 등록/수정/삭제 관리</span>
                                        </div>
                                        <div class="go">➜</div>
                                    </div>
                                </div>
                                <div class="card" onclick="go('/Present/AdminUpcomingBirthdays')">
                                    <div class="cardIn">
                                        <div class="emojiBox">🎂</div>
                                        <div class="txt">
                                            <strong>생일자 선물관리</strong>
                                            <span>다가오는 생일자 선물/이벤트 관리</span>
                                        </div>
                                        <div class="go">➜</div>
                                    </div>
                                </div>
                                <div class="card" onclick="go('/StudentPointDashboard4/AdminPurchaseList?kind=Bible')">
                                    <div class="cardIn">
                                        <div class="emojiBox">📖</div>
                                        <div class="txt">
                                            <strong>통합선물관리</strong>
                                            <span>완독 선물 선택/구매/전달 관리</span>
                                        </div>
                                        <div class="go">➜</div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    @if (isSuperAdmin)
                    {
                        <section class="section">
                            <div class="sectionHead">
                                <div class="t">SuperAdmin 전용</div>
                                <div class="m">민감 기능</div>
                            </div>
                            <div class="grid">
                                <div class="card dangerLine" onclick="go('/JuManNa/IndexGroupByYYYYMM')">
                                    <div class="cardIn">
                                        <div class="emojiBox">📖</div>
                                        <div class="txt">
                                            <strong>말씀정리</strong>
                                            <span>월별 그룹/정리 화면</span>
                                        </div>
                                        <div class="go">➜</div>
                                    </div>
                                </div>
                                <div class="card dangerLine" onclick="go('/SuperAdminAnomaly/Index')">
                                    <div class="cardIn">
                                        <div class="emojiBox">🚨</div>
                                        <div class="txt">
                                            <strong>이상징후</strong>
                                            <span>이상데이터관리 화면</span>
                                        </div>
                                        <div class="go">➜</div>
                                    </div>
                                </div>
                                <div class="card dangerLine" onclick="go('/DailyMission2FamilyAdmin')">
                                    <div class="cardIn">
                                        <div class="emojiBox">👥</div>
                                        <div class="txt">
                                            <strong>팀구성</strong>
                                            <span>도전성경팀구성</span>
                                        </div>
                                        <div class="go">➜</div>
                                    </div>
                                </div>

                                <div class="card dangerLine" onclick="go('/Present/ListPresent?productDisplayOpton=managePrice')">
                                    <div class="cardIn">
                                        <div class="emojiBox">🏷️</div>
                                        <div class="txt">
                                            <strong>상품등록</strong>
                                            <span>상품/가격 관리 화면</span>
                                        </div>
                                        <div class="go">➜</div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    <div class="footerBar">                  
                        <button class="fbtn logout" type="button" onclick="logoutNow()">
                            로그아웃 <span class="arr">⎋</span>
                        </button>
                        <button class="fbtn home" type="button" onclick="go('/')">
                            Home <span class="arr">➜</span>
                        </button>

                    </div>

                </div>
            </div>
        </main>

    </div>

    <!-- 기존 로그아웃 폼 유지 -->
    <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
          style="display:none;">
        <button type="submit">로그아웃</button>
    </form>

    <script>
        function go(url){ window.location.href = url; }

        function logoutNow(){
            const f = document.getElementById('logoutForm');
            if(f) f.submit();
        }

        // 프로필 이미지 캐시 무력화 (최신 이미지 반영)
        function loadLatestImage() {
            const imageElement = document.getElementById('myImage');
            const timestamp = new Date().getTime();
            imageElement.src = `@Model.ProfilePicturePath?${timestamp}`;
        }
        window.onload = loadLatestImage;
    </script>
</body>
</html>
