@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@model UserInfo
@inject IAuthService AuthService

@{
    Layout = null;
}





<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Camera Capture and Crop</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f4f4f4;
            flex-direction: column;
        }

        #image-circle {
            width: 240px;
            height: 240px;
            border-radius: 50%;
            border: 4px solid #3b3f45;
            overflow: hidden;
            margin-top: 20px;
            background-color: #2b2f34;
        }

        #cropped-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        #camera-stream {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }

        #capture-button, #start-camera {
            position: absolute;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            padding: 12px 24px;
            font-size: 18px;
            cursor: pointer;
            background-color: #e74c3c;
            color: white;
            border: none;
            border-radius: 30px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            transition: background-color 0.3s;
        }

        #start-camera {
            background-color: #3498db;
        }

            #capture-button:hover, #start-camera:hover {
                background-color: #c0392b;
            }

        #buttons-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
        }

        #save-button, #cancel-button, #select-photo-button {
            padding: 12px 24px;
            font-size: 16px;
            cursor: pointer;
            background-color: #2ecc71;
            color: white;
            border: none;
            border-radius: 5px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            transition: background-color 0.3s;
        }

        #cancel-button {
            background-color: #2ecc71;
        }

        #select-photo-button {
            background-color: #9b59b6;
        }

            #save-button:hover, #cancel-button:hover, #select-photo-button:hover {
                background-color: #27ae60;
            }

        #cropper-container {
            display: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
            background-color: rgba(0, 0, 0, 0.8);
        }

        #captured-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        #crop-image {
            position: absolute;
            bottom: 120px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            padding: 12px 24px;
            font-size: 18px;
            cursor: pointer;
            background-color: #16a085;
            color: white;
            border: none;
            border-radius: 30px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

        @@media screen and (max-width: 600px) {
            #image-circle {
                width: 180px;
                height: 180px;
            }

            #capture-button, #start-camera, #crop-image {
                padding: 10px 20px;
                font-size: 16px;
            }

            #save-button, #cancel-button, #select-photo-button {
                padding: 10px 20px;
                font-size: 16px;
            }

            body, html {
                font-size: 14px;
            }
        }
    </style>

    <style>

        .title {
            font-size: 24px;
            font-weight: bold;
        }

        .circle-containe11r {
            position: relative;
            width: 300px;
            height: 300px;
        }

        .circle-container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 300px;
            height: 300px;
            position: relative;
        }

        .camera-icon {
            position: absolute;
            right: 35px;
            bottom: 35px;
            width: 50px;
            height: 50px;
            background: url('https://fonts.gstatic.com/s/i/materialiconsoutlined/camera/v9/24px.svg') no-repeat center center;
            background-size: contain;
            cursor: pointer;
        }

    </style>

    <style>
        .toast-popup {
            display: none;
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 80%;
            max-width: 300px;
            background-color: #fff;
            border: 1px solid #ccc;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            overflow: hidden;
        }

            .toast-popup.active {
                display: block;
            }

            .toast-popup div {
                padding: 15px;
                text-align: center;
                cursor: pointer;
                border-bottom: 1px solid #ddd;
            }

                .toast-popup div:last-child {
                    border-bottom: none;
                }

                .toast-popup div:hover {
                    background-color: #f0f0f0;
                }

        .button-group {
            margin-top: 20px;
            display: flex;
            gap: 10px;
        }

            .button-group button {
                padding: 10px 20px;
                font-size: 16px;
                cursor: pointer;
                border: none;
                border-radius: 5px;
                background-color: #007bff;
                color: white;
            }

                .button-group button.cancel {
                    background-color: #00BCD4;
                }


        .no-select {
            user-select: none; /* 기본 브라우저 지원 */
            -moz-user-select: none; /* Firefox */
            -webkit-user-select: none; /* Safari 및 Chrome */
            -ms-user-select: none; /* Internet Explorer/Edge */
        }
    </style>

    <style>
        /* Overlay for dark background */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5); /* Dark background */
            display: none;
            z-index: 9999;
        }

        /* Centered horizontal message box with animation */
        .loading-box {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: white;
            padding: 20px 70px; /* Padding adjusted for horizontal layout */
            font-size: 18px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            opacity: 0;
            animation: fadeIn 0.5s forwards, pulse 1.5s infinite ease-in-out; /* Fade in and pulse animation */
            white-space: nowrap; /* Ensure text stays in a single line */
        }

        /* Pulse effect */
        @@keyframes pulse {
            0% {
                transform: translate(-50%, -50%) scale(1);
            }

            50% {
                transform: translate(-50%, -50%) scale(1.05);
            }

            100% {
                transform: translate(-50%, -50%) scale(1);
            }
        }

        /* Fade in effect */
        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

    </style>

<style>
        @@media (max-width: 768px) {
            .camera-icon {
 
                right: 55px;
                bottom: 55px;
  
            }
        }
</style>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
</head>
<body>
    <!-- Loading overlay and message box -->
    <div id="loadingOverlay" class="loading-overlay">
        <div class="loading-box">처리중입니다</div>
    </div>


    <div class="title">사진 정보 변경</div>
  

    <div class="circle-container">
        <div id="image-circle" style="border-radius: 50%; object-fit: cover;border: 3.5px solid #ffffff; box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);">
            <img id="cropped-image" src="@Model.ProfilePicturePath" alt="Cropped Image">
        </div>
        <div class="camera-icon" onclick="toggleToastPopup()"></div>
    </div>

    <h2>@Model.FullName</h2>

    <div id="buttons-container">
        <button id="save-button">저장</button>
        <button id="cancel-button">이전 화면</button>
        <input type="file" id="photo-input" accept="image/*" style="display:none;">
    </div>

    <video id="camera-stream" autoplay playsinline style="display:none;"></video>
    <canvas id="capture-canvas" style="display:none;"></canvas>
    <button id="capture-button" style="display:none;">Capture</button>

    <div id="cropper-container">
        <img id="captured-image" src="" alt="Captured Image">
        <button id="crop-image">Crop Image</button>
    </div>
    <div class="toast-popup no-select">
        <div onclick="selectPhoto()">사진선택</div>
        <div onclick="startCamera()">사진촬영</div>
        <div onclick="cancelToast()">취소</div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script>
        let cameraStream = null;
        let videoElement = document.getElementById('camera-stream');
        let canvasElement = document.getElementById('capture-canvas');
        let croppedImageElement = document.getElementById('cropped-image');
        let cropperContainer = document.getElementById('cropper-container');
        let capturedImageElement = document.getElementById('captured-image');
        let cropper = null;

        function resetCamera() {

            document.getElementById('capture-button').style.display = 'none';
            document.getElementById('cropper-container').style.display = 'none';
            videoElement.style.display = 'none';
        }



        document.getElementById('capture-button').addEventListener('click', function () {
            let context = canvasElement.getContext('2d');
            canvasElement.width = videoElement.videoWidth;
            canvasElement.height = videoElement.videoHeight;
            context.drawImage(videoElement, 0, 0, canvasElement.width, canvasElement.height);
            let dataURL = canvasElement.toDataURL();
            capturedImageElement.src = dataURL;

            // Stop the camera stream and show the captured image
            videoElement.style.display = 'none';
            document.getElementById('capture-button').style.display = 'none';
            cropperContainer.style.display = 'block';
            cameraStream.getTracks().forEach(track => track.stop());

            // Initialize Cropper.js
            if (cropper) {
                cropper.destroy();
            }
            cropper = new Cropper(capturedImageElement, {
                aspectRatio: 1,
                viewMode: 1
            });
        });

        document.getElementById('crop-image').addEventListener('click', function () {
            let croppedCanvas = cropper.getCroppedCanvas();
            croppedImageElement.src = croppedCanvas.toDataURL();
            cropperContainer.style.display = 'none';
            resetCamera();  // Reset to allow new capture
        });

        document.getElementById('cancel-button').addEventListener('click', function () {
            window.location.href = '/HumanResource/ManageUserInfo?UserId=@Model.UserId&PersonId=@Model.PersonId';
        });

        //document.getElementById('save-button').addEventListener('click', function () {
        //    let link = document.createElement('a');
        //    link.href = croppedImageElement.src;
        //    link.download = 'cropped-image.png';
        //    link.click();
        //});


        document.getElementById('save-button').addEventListener('click', function () {
            let croppedImage = croppedImageElement.src;

            // Remove the data URL header (e.g. "data:image/png;base64,")
            let base64Data = croppedImage.split(',')[1];
            showLoading();
            // Send the base64-encoded image to the server
            fetch('/HumanResource/UploadProfilePicture', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ ProfilePicture: base64Data, UserId: '@Model.UserId' })
            })
                .then(response => response.json())
                .then(data => {
                    hideLoading();
                    if (data.success) {
                        redirectToPage('/HumanResource/ManageUserInfo?UserId=@Model.UserId');
                        // alert('Profile picture updated successfully!');
                    } else {
                        alert('Failed to update profile picture.');
                    }
                })
                .catch(error => {
                    hideLoading();
                    redirectToPage('/HumanResource/ManageUserInfo?UserId=@Model.UserId');
                    console.error('Error:', error);
                });
        });


        document.getElementById('photo-input').addEventListener('change', function (event) {
            let file = event.target.files[0];
            if (file) {
                let reader = new FileReader();
                reader.onload = function (e) {
                    capturedImageElement.src = e.target.result;

                    // Hide Start Camera button during crop


                    // Display cropper in full-screen mode
                    cropperContainer.style.display = 'block';

                    // Initialize Cropper.js for the selected image
                    if (cropper) {
                        cropper.destroy();
                    }
                    cropper = new Cropper(capturedImageElement, {
                        aspectRatio: 1,
                        viewMode: 1
                    });
                };
                reader.readAsDataURL(file);
            }
        });
    </script>

    <script>
        function toggleToastPopup() {
            var toastPopup = document.querySelector('.toast-popup');
            toastPopup.classList.toggle('active');
        }

        function selectPhoto() {
            document.getElementById('photo-input').click();
            toggleToastPopup();
        }

        async function startCamera() {
            cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
            videoElement.srcObject = cameraStream;
            videoElement.style.display = 'block';
            document.getElementById('capture-button').style.display = 'block';

            toggleToastPopup();
        }

        function cancelToast() {
            toggleToastPopup();
        }
        function goBack() {
            window.history.back();
        }
    </script>

    <script>
        async function loadProfilePicture() {
            const userId = '@Model.UserId';  // Replace this with the actual user ID
            showLoading();
            try {
                const response = await fetch(`/HumanResource/GetProfilePicture?userId=${userId}`);
                if (response.ok) {
                    // Get the image as a blob
                    const blob = await response.blob();

                    // Create a URL for the blob and set it as the image source
                    const imageUrl = URL.createObjectURL(blob);
                    document.getElementById('cropped-image').src = imageUrl;
                    hideLoading();
                } else {
                    hideLoading();
                    console.error('Failed to load profile picture');
                }
            } catch (error) {
                hideLoading();
                console.error('Error:', error);
            }
        }

        // Call the function to load the profile picture when the page loads
      //  window.onload = loadProfilePicture;
    </script>
    <script>
        function showLoading() {
            // Show the loading overlay and apply animations
            document.getElementById('loadingOverlay').style.display = 'block';
            document.body.style.pointerEvents = 'none'; // Disable all inputs
        }

        function hideLoading() {
            // Hide the loading overlay and remove input blocking
            document.getElementById('loadingOverlay').style.display = 'none';
            document.body.style.pointerEvents = 'auto'; // Re-enable inputs
        }

    </script>
    <script>
        function redirectToPage(URL) {
            window.location.href = URL;
        }
        function reloadPage() {
            location.reload();
        }
    </script>

    <script>
        function loadLatestImage() {
            const imageElement = document.getElementById('cropped-image');
            const timestamp = new Date().getTime(); // 현재 시간을 밀리초로 가져옴
            imageElement.src = `@Model.ProfilePicturePath?${timestamp}`;
        }

        // 페이지 로드 시 실행 또는 필요할 때 호출
        window.onload = loadLatestImage;
                // 이미지 업데이트가 필요할 때 loadLatestImage() 호출 가능
    </script>
</body>
</html>
