@using BulletinBoard.Common;
@model List<UserInfo>

@*  ══════════════════════════════════════════════════════════════
    미배정 회원 배정 — 2026-11-08 시안 확정 (SuperAdmin 전용 · DailyMission4 밝은 흰색 · 공용 quiz-bright.css)
    · 대상: ① 부서가 없는 회원  ② 학생·교사인데 학년·반이 없는 회원
    · 저장: /HumanResource/UnassignedMembersSave (기존 ChangeUserClassInfoProcess 와 같은 순서·같은 저장 함수)
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
    var roles = (List<CodeData>)ViewData["Roles"];
    var years = (List<int>)ViewData["Years"];
    var bans  = (List<int>)ViewData["Bans"];
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>미배정 회원 배정</title>
    <link rel="stylesheet" href="/css/quiz-bright.css" asp-append-version="true">
    <style>
        body { margin: 0; background: #FFFFFF; }
        .ua-sum { display: flex; gap: 8px; margin: 12px 0; }
        .ua-sum div { flex: 1; border-radius: 10px; padding: 10px 12px; font-size: 12px; }
        .ua-sum b { display: block; font-size: 22px; font-weight: 800; margin-top: 2px; }
        .ua-sum .w { background: #FFF4E0; color: #9A5B00; }
        .ua-sum .g { background: #E8F6EC; color: #1E7A3C; }
        .ua-row { border-top: 1px solid #E8EBF0; padding: 12px 0; }
        .ua-nm { font-size: 16px; font-weight: 700; }
        .ua-nm small { font-weight: 400; color: #8A93A0; margin-left: 6px; font-size: 12px; }
        .ua-sel { display: flex; gap: 8px; margin-top: 8px; }
        .ua-sel select { flex: 1; min-width: 0; height: 40px; border: 1px solid #D9DEE6; border-radius: 10px; padding: 0 8px; background: #fff; font-size: 14px; }
        .ua-cls { display: none; }
        .ua-ft { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
        .ua-err { flex: 1; font-size: 13px; color: #D13B3B; }
        .ua-save { height: 38px; padding: 0 18px; border: 0; border-radius: 10px; background: #2F7BF5; color: #fff; font-weight: 700; font-size: 14px; }
        .ua-save[disabled] { opacity: .5; }
        .ua-empty { display: none; padding: 28px 0; text-align: center; color: #8A93A0; font-size: 14px; }
        .ua-find { width: 100%; box-sizing: border-box; height: 40px; border: 1px solid #D9DEE6; border-radius: 10px; padding: 0 12px; font-size: 14px; }
    </style>
</head>
<body>
<div class="qb">

    <div class="qb-top">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/HumanResource/ManageUserInfo">정보 관리</a><span class="sep">›</span>미배정 회원</span>
        <span>SuperAdmin</span>
    </div>

    <div class="qb-k">ASSIGN</div>
    <h1 class="qb-h1">미배정 회원 배정</h1>
    <div class="qb-sub">가입은 했지만 역할 · 학년반이 비어 있는 분들이에요.</div>

    <div class="ua-sum">
        <div class="w">미배정<b id="uaCnt">@Model.Count</b></div>
        <div class="g">이번에 배정<b id="uaDone">0</b></div>
    </div>

    <input class="ua-find" id="uaQ" placeholder="이름으로 찾기" oninput="uaFilter()" />

    <div id="uaList">
        @for (int i = 0; i < Model.Count; i++)
        {
            var m = Model[i];
            bool hasCls = m.ClassYear > 0 && m.ClassBan > 0;
            <div class="ua-row" data-uid="@m.UserId" data-name="@m.FullName" id="r@(i)">
                <div class="ua-nm">@m.FullName<small>@m.UserName</small></div>
                <div class="ua-sel">
                    <select id="r_@(i)" aria-label="역할" onchange="uaRole(@i)">
                        <option value="">역할 선택</option>
                        @foreach (var r in roles) { <option value="@r.MinorCD" selected="@(r.MinorCD == m.RoleCode)">@r.MinorNM</option> }
                    </select>
                </div>
                <div class="ua-sel ua-cls" id="c@(i)">
                    <select id="y@(i)" aria-label="학년">
                        <option value="">학년</option>
                        @foreach (var y in years) { <option value="@y" selected="@(hasCls && y == m.ClassYear)">@(y)학년</option> }
                    </select>
                    <select id="b@(i)" aria-label="반">
                        <option value="">반</option>
                        @foreach (var b in bans) { <option value="@b" selected="@(hasCls && b == m.ClassBan)">@(b)반</option> }
                    </select>
                </div>
                <div class="ua-ft"><span class="ua-err" id="e@(i)"></span><button type="button" class="ua-save" id="s@(i)" onclick="uaSave(@i)">저장</button></div>
            </div>
        }
    </div>
    <div class="ua-empty" id="uaEmpty">모두 배정했어요. 새로 가입하면 여기에 나타나요.</div>

    <div class="qb-ft">
        <span>저장하면 목록에서 사라져요</span>
        <span><a href="/">@ConstatsCommon.ToHome</a></span>
    </div>
</div>

<script>
    var uaDone = 0;
    function uaNeedClass(v) { return v === 'T1001' || v === 'T1002'; }
    function uaRole(i) {
        document.getElementById('c' + i).style.display = uaNeedClass(document.getElementById('r_' + i).value) ? 'flex' : 'none';
    }
    function uaCount() {
        var n = document.querySelectorAll('#uaList .ua-row').length;
        document.getElementById('uaCnt').textContent = n;
        document.getElementById('uaDone').textContent = uaDone;
        document.getElementById('uaEmpty').style.display = n ? 'none' : 'block';
    }
    function uaFilter() {
        var q = document.getElementById('uaQ').value.trim();
        document.querySelectorAll('#uaList .ua-row').forEach(function (r) {
            r.style.display = (r.dataset.name || '').indexOf(q) > -1 ? '' : 'none';
        });
    }
    function uaSave(i) {
        var row = document.getElementById('r' + i), err = document.getElementById('e' + i), btn = document.getElementById('s' + i);
        var r = document.getElementById('r_' + i).value;
        var y = document.getElementById('y' + i).value, b = document.getElementById('b' + i).value;
        err.textContent = '';
        if (!r) { err.textContent = '역할을 골라 주세요'; return; }
        if (uaNeedClass(r) && (!y || !b)) { err.textContent = '학년과 반을 골라 주세요'; return; }
        btn.disabled = true;
        var fd = new FormData();
        fd.append('UserId', row.dataset.uid); fd.append('RoleCode', r);
        fd.append('ClassYear', uaNeedClass(r) ? y : 0); fd.append('ClassBan', uaNeedClass(r) ? b : 0);
        fetch('/HumanResource/UnassignedMembersSave', { method: 'POST', body: fd, credentials: 'same-origin' })
            .then(function (x) {
                var ct = x.headers.get('content-type') || '';
                if (x.redirected || ct.indexOf('json') < 0) { throw new Error('응답 ' + x.status + (x.redirected ? ' (로그인·권한 화면으로 이동됨)' : '')); }
                return x.json();
            })
            .then(function (j) {
                if (j.ok) { row.remove(); uaDone++; uaCount(); }
                else { err.textContent = j.message || '저장하지 못했어요'; btn.disabled = false; }
            })
            .catch(function (e) { err.textContent = '저장하지 못했어요 · ' + (e && e.message ? e.message : ''); btn.disabled = false; });
    }
    document.querySelectorAll('#uaList .ua-row').forEach(function (_, i) { uaRole(i); });
    uaCount();
</script>
</body>
</html>
