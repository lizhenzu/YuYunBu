@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@model IEnumerable<BulletinBoard.Models.CodeData>
@inject IAuthService AuthService

@{
    Layout = null; 
}


<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personal Information Management</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #fff;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .container {
            /*   background-color: #fff;*/
            padding: 20px;
            border-radius: 8px;
            /*   box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);*/
            width: 400px;
            text-align: center;
        }

        h1 {
            color: #333;
            margin-bottom: 20px;
        }

        .profile-pic {
            width: 170px;
            height: 170px;
            border-radius: 50%;
            margin-bottom: 10px;
            object-fit: cover;
        }

        .section-title {
            font-size: 18px;
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .buttons {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

            .buttons button {
                padding: 10px 20px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                margin: 5px;
                font-size: 16px;
                background-color: #4CAF50;
                color: white;
            }
    </style>
</head>
<body>

    <div class="container">
        <h2>주일학교 생일자</h2>
        <h4>부서를 선택해 주세요</h4>
        <div class="buttons" style="flex-wrap: wrap;">
            @foreach (var item in Model)
            {
                <button type="button" style="background-color:#00C853;" onclick="window.location.href='/HumanResource/addressBookDetailBirthDay?DeptCode=@item.MinorCD&RankQueryOptionData=None&ClassYear=0&ClassBan=0';">@item.MinorNM </button>
            }
        </div>

        <div class="buttons">
            <button type="button" onclick="window.location.href='/';">Home</button>
            <button type="button" onclick="document.querySelector('form').submit();">로그아웃</button>
        </div>
    </div>
    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" style="display: none;">
        <button type="submit" class="mission-button ">이동</button>
    </form>
     
</body>
</html>
