@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());

}
<style>
    .button-container {
        display: flex;
        justify-content: center;
        margin: 20px 0;
    }

    /* 이쁜 버튼 스타일 */
    .pretty-button {
        padding: 10px 20px;
        background-color: #007bff; /* 버튼 색상 */
        color: white; /* 텍스트 색상 */
        border: none; /* 테두리 제거 */
        border-radius: 5px; /* 둥근 모서리 */
        cursor: pointer; /* 커서 스타일 변경 */
        font-size: 16px; /* 텍스트 크기 */
        transition: background-color 0.3s ease; /* 호버 효과 */
    }

        .pretty-button:hover {
            background-color: #0056b3; /* 버튼 호버 색상 */
        }


    .jumbotron {
        background-color: #f8f8f8;
        border-radius: 0.5em;
        padding: 2em;
        text-align: center;
    }
</style>

<br />

<div class="jumbotron">
    <h3>@($"{@ChurchName} · {@DepartmentName}")에 오심을 환영합니다!</h3>
    @if (await AuthService.IsSignedIn(User))
    {
        <p>@await AuthService.GetUserName(User) 님</p>
    } 
</div>
<div class="button-container">
    <form action="/Account/Login" method="get">
        <button type="submit" class="pretty-button">로그인</button>
    </form>
</div>
<div class="button-container">
    <form action="/Manual/Index" method="get">
        <button type="submit" class="pretty-button">운영안</button>
    </form>
</div>

