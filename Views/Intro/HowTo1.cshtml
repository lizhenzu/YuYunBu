@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService

<style>
    .local-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin-top: 50px;
    }

    .button {
        background-color: #4CAF50; /* Green */
        border: none;
        color: white;
        padding: 20px 20px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 20px;
        margin: 4px 2px;
        cursor: pointer;
        width: 310px;
        border-radius: 12px;
        transition: background-color 0.2s, transform 0.2s;
    }

        .button:hover {
            background-color: #45a049;
            transform: scale(1.05);
        }

    .jumbotron {
        background-color: #f8f8f8;
        border-radius: 0.5em;
        padding: 2em;
        text-align: center;
    }
</style> 
<br />
@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = "원포인트 적용방안", TitleBody = "매일 말씀과 함께"})

 
<div class="card">
    <div class="card-body">
        <ul>
            <li>방법</li>
            <ul>
                <li>홈페이지에 접속후 "매일성경 말씀읽기" 읽기</li>
                <li>말씀 읽고 버튼 누루면 포인트 부여</li>
            </ul>
            <li>효과</li>
            <ul>
                <li>매일 말씀을 묵상하는 거룩한 습관 유도</li>
                <li>주일설교 말씀의 전후 맥락을 알게 되어 예배 집중 유도</li>
                <li>부모, 주일학교 선생님들까지 매일성경QT 참여 유도 가능</li>
            </ul>
        </ul>
    </div>
</div>

