@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService

<style>
    .local-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin-top: 50px;
    }

    .button {
        background-color: #4CAF50; /* Green */
        border: none;
        color: white;
        padding: 20px 20px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 20px;
        margin: 4px 2px;
        cursor: pointer;
        width: 310px;
        border-radius: 12px;
        transition: background-color 0.2s, transform 0.2s;
    }

        .button:hover {
            background-color: #45a049;
            transform: scale(1.05);
        }

    .jumbotron {
        background-color: #f8f8f8;
        border-radius: 0.5em;
        padding: 2em;
        text-align: center;
    }
</style>
<br />
@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = "원포인트 적용방안", TitleBody = "매주 말씀암송"})

<div class="card">
    <div class="card-body">
        <ul>
            <li>방법</li>
            <ul>
                <li>홈페이지에 접속후 "말씀암송" 외우기</li>
                <li>말씀 암송후 버튼 누루면 포인트 부여</li>
            </ul>
            <li>효과</li>
            <ul>
                <li>**영적 성장**: 성경 암송은 하나님의 말씀을 깊이 이해하고 반추할 기회를 제공합니다. </li>
                <li>**기억력 강화**: 정기적으로 성경 구절을 암송하는 것은 기억력을 향상시킨다.</li>
                <li>**위안과 평화**: 어려운 시기나 도전적인 상황에서 성경 구절을 상기시키는 것은 큰 위안과 평화를 제공할 수 있습니다.</li>
                <li>**결정과 선택에 대한 지침**: 성경 암송은 일상 생활에서 중요한 결정과 선택을 할 때 도덕적이고 윤리적인 지침을 제공합니다.</li>
                <li>**영적 전쟁에서의 도구**: 성경은 "영의 검"으로 비유됩니다(에베소서 6:17). 암송한 성경 구절은 유혹과 영적 공격을 막는 데 강력한 도구가 될 수 있습니다.</li>
            </ul>
        </ul>
    </div>
</div>

@await Html.PartialAsync("_PublishNavigationButton_1",new NavigationButtonInfo{ goPrev = "'/Intro/HowTo1'" , goList = "'/Intro/Index'" , goNext = "'/Intro/HowTo3'"})