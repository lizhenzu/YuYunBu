@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService

<style>
    .local-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin-top: 50px;
    }

    .button {
        background-color: #4CAF50; /* Green */
        border: none;
        color: white;
        padding: 20px 20px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 20px;
        margin: 4px 2px;
        cursor: pointer;
        width: 310px;
        border-radius: 12px;
        transition: background-color 0.2s, transform 0.2s;
    }

        .button:hover {
            background-color: #45a049;
            transform: scale(1.05);
        }

    .jumbotron {
        background-color: #f8f8f8;
        border-radius: 0.5em;
        padding: 2em;
        text-align: center;
    }
</style> 
<br />
@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = "원포인트 적용방안", TitleBody = "매일 기도 생활화"})

<div class="card">
    <div class="card-body">
        <ul>
            <li>MIP 성품기도</li>
            <ul>
                <li>홈페이지에 접속후 "성풍기도" 따라 기도 하기</li>
                <li>부모들이 아이들과 함께 성품 기도 후 "아멘"으로 홈피 버튼 클릭하면 포인트 부여</li>
            </ul>
            <li>효과</li>
            <ul>
                <li>기도 생활화 유도</li>
                <li>하나님의 응답으로 아이들이 거룩한 성품을 갖게 됨</li>
            </ul>
        </ul>
    </div>
</div>

@await Html.PartialAsync("_PublishNavigationButton_1",new NavigationButtonInfo{ goPrev = "'/Intro/HowTo2'" , goList = "'/Intro/Index'" , goNext = "'/Intro/HowTo4'"})