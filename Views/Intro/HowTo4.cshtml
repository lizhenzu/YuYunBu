@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService

<style>
    .local-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin-top: 50px;
    }

    .button {
        background-color: #4CAF50; /* Green */
        border: none;
        color: white;
        padding: 20px 20px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 20px;
        margin: 4px 2px;
        cursor: pointer;
        width: 310px;
        border-radius: 12px;
        transition: background-color 0.2s, transform 0.2s;
    }

        .button:hover {
            background-color: #45a049;
            transform: scale(1.05);
        }

    .jumbotron {
        background-color: #f8f8f8;
        border-radius: 0.5em;
        padding: 2em;
        text-align: center;
    }
</style> 
<br />
@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = "원포인트 적용방안", TitleBody = "매일성경 기반 성경퀴즈"}) 

<div class="card">
    <div class="card-body">
        <ul>
            <li>방법</li>
            <ul>
                <li>홈페이지에 접속후 "성경퀴즈" 문제 풀기</li>
                <li>부모들이 아이들과 함께 성경퀴즈 맞추면 포인트 부여</li>
            </ul>
            <li>효과</li>
            <ul>
                <li>**성경 지식 강화**: 성경 퀴즈는 참가자들에게 성경의 다양한 부분을 학습하고 복습할 기회를 제공합니다.</li>
                <li>**기억력 향상**: 성경 퀴즈를 통해 특정 구절이나 사건들을 기억하려고 노력함으로써 기억력이 자연스럽게 향상될 수 있습니다.</li>
                <li>**영적 성장의 촉진**: 성경 퀴즈를 통해 학습한 내용은 개인의 영적 성장을 촉진하는 데 중요한 역할을 할 수 있습니다.</li>
            </ul>
        </ul>
    </div>
</div>

@await Html.PartialAsync("_PublishNavigationButton_1",new NavigationButtonInfo{ goPrev = "'/Intro/HowTo3'" , goList = "'/Intro/Index'" , goNext = "'/Intro/HowTo5'"})