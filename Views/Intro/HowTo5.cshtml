@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService

<style>
    .local-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin-top: 50px;
    }

    .button {
        background-color: #4CAF50; /* Green */
        border: none;
        color: white;
        padding: 20px 20px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 20px;
        margin: 4px 2px;
        cursor: pointer;
        width: 310px;
        border-radius: 12px;
        transition: background-color 0.2s, transform 0.2s;
    }

        .button:hover {
            background-color: #45a049;
            transform: scale(1.05);
        }

    .jumbotron {
        background-color: #f8f8f8;
        border-radius: 0.5em;
        padding: 2em;
        text-align: center;
    }
</style> 
<br />
@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = "원포인트 적용방안", TitleBody = "예배 활성화"})

<div class="card">
    <div class="card-body">
        <ul>
            <li>심방(가정예베)</li>
            <ul>
                <li>심방예배 드림 (전도사님 주관하여 월1회 또는 분기1회)</li>
                <ul>
                    <li>담임샘/교육팀샘/집행부샘들중 참석 가능한 분들이 동반</li>
                    <li>매일성경QT에 명기된 가정예배를 각 가정에 전파 </li>
