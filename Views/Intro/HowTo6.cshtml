@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService

<style>
    .local-body {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        margin-top: 50px;
    }

    .button {
        background-color: #4CAF50; /* Green */
        border: none;
        color: white;
        padding: 20px 20px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 20px;
        margin: 4px 2px;
        cursor: pointer;
        width: 310px;
        border-radius: 12px;
        transition: background-color 0.2s, transform 0.2s;
    }

        .button:hover {
            background-color: #45a049;
            transform: scale(1.05);
        }

    .jumbotron {
        background-color: #f8f8f8;
        border-radius: 0.5em;
        padding: 2em;
        text-align: center;
    }
</style> 
