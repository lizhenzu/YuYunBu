@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());

}

  <!DOCTYPE html>
  <html lang="ko">
  <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ChurchName · @DepartmentName</title>
<style>
  body, html {
      margin: 0;
      padding: 0;
      color: #333;
      
  }
  
  .container {
        justify-content: space-around;
        padding: 20px;
        padding-top: 10px;
        /* display: flex;*/
        justify-content: center;
        align-items: center;
      
  }
  
  .card {
      background-color: #f4f4f4;
      padding: 10px;
      border-radius: 10px;
      text-align: center;
            box-shadow: 3px 3px 10px rgba(0, 0, 0, 0.2);
      margin: 10px;
  }
  
  .icon {
      background-repeat: no-repeat;
      background-size: cover;
      height: 150px;
      margin-bottom: 20px;
  }
  
  .gps {
      background-image: url('/images/OnePoint/OnePoint05_crop.webp');
  }
  
  .mobile {
      background-image: url('/images/OnePoint/OnePoint04_crop.webp');
  }

        .mobile2 {
            background-image: url('/images/OnePoint/KakaoTalk_20240515_162338647_02.webp');
        }

        .city {
      background-image: url('/images/OnePoint/OnePoint06_crop.webp');
  }  

  .goHome {
            background-image: url('/images/home/goHome/goHome.webp');
  }
  
  button {
      border: none;
      padding: 10px;
      width: 100%;
      border-radius: 5px;
      background-color: orange;
      color: white;
      cursor: pointer;
  }
  
  button:hover {
      background-color: darkorange;
  }

</style>
  </head>
  <body>
  <div class="container">
      <div class="card">
          <div class="icon gps"></div>
          <h2>원포인트 개요</h2>
          <p>'꿈미(꿈이 있는 미래)'의 원포인트에 대한 철학소개와 적용방안 자료(텍스트)가 있습니다.</p>
          <button onclick="sendPostRequest('/Intro/Index1')">이동하기</button>
      </div>
      <div class="card">
          <div class="icon mobile"></div>
          <h2>원포인트 소개/적용</h2>
          <p>'꿈미(꿈이 있는 미래)'의 원포인트에 대한 철학소개와 적용방안 자료(동영상)가 있습니다.</p>
            <button onclick="sendPostRequest('https://youtu.be/d9utPcDiPRw')">이동하기</button>
      </div>
        <div class="card">
            <div class="icon mobile2"></div>
            <h2>원포인트 모바일 프로그램</h2>
            <p>'꿈미(꿈이 있는 미래)'의 원포인트에 실제 모바일 프로그램 자료(동영상)가 있습니다.</p>
            <button onclick="sendPostRequest('https://youtu.be/ngjFK4LxOrY')">이동하기</button>
        </div>
        <div class="card">
          <div class="icon city"></div>
          <h2>적용방법 및 효과</h2>
          <p>'꿈미(꿈이 있는 미래)'의 원포인트에 적용방법및 효과에대한 설명자료가 있습니다.</p>
           <button onclick="sendPostRequest('/Intro/HowTo1')">이동하기</button>
      </div>
      <div class="card">
          <div class="icon goHome"></div>
          <h2>Home으로 돌아가기</h2>
          <button onclick="sendPostRequest('/')">Home</button>
      </div>
  </div>

  <script>
    function sendPostRequest(url) {
        window.location.href = url;
    }
</script> 
  </body>
  </html>
 