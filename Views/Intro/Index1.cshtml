@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService
<style>

    .one-body {
        display: flex;
        justify-content: center;
        align-items: center;
        /*height: 550vh;*/
        margin: 0;
    }

    .section {
        width: 100%;
        padding: 50px;
    }

    .circles {
        position: relative;
        height: 300px; /* 원들이 배치될 충분한 높이 */
        display: flex;
        justify-content: center;
        align-items: center;
    }


    .circle {
        width: 100px;
        height: 100px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        border-radius: 50%;
        background: radial-gradient(circle at 50% 50%, #FFFFFF 0%, #AAAAAA 100%);
        box-shadow: 0px 0px 10px 0px #000000;
        position: absolute;
    }

    #circle1 {
        color: #FF0000; /* 빨간색 */
        top: calc(50% - 100px); /* 기존 중앙에서 100px 위로 */
        left: 50%;
        transform: translate(-50%, -50%);
    }

    #circle2 {
        color: #00FF00; /* 초록색 */
        bottom: calc(50px + 63px); /* 기존 위치에서 123px 위로 */
        left: calc(50% - 145px); /* 중심에서 좌측으로 이동 */
        transform: translateY(50%);
    }

    #circle3 {
        color: #0000FF; /* 파란색 */
        bottom: calc(50px + 63px); /* 기존 위치에서 123px 위로 */
        right: calc(50% - 145px); /* 중심에서 우측으로 이동 */
        transform: translateY(50%);
    }

    .circle span {
        font-size: 24px;
        font-weight: bold;
    }

    .circle p {
        position: absolute;
        bottom: -50px;
        width: 200px;
        font-size: 12px;
        color: #333;
        text-align: center;
        top: 115px; /* 원의 높이 100px + 45px 여백 */
    }

    /*@@media (max-width: 768px) {
        .circles {
            flex-direction: column;
            height: 600px;
        }

        .circle {
            position: static;
            margin: 10px auto;
        }

        #circle1, #circle2, #circle3 {
            transform: none;
        }
    }*/
</style>
<br />
@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = "", TitleBody = "부모님께 협조말씀"})

<p></p>
<div class="card">
    <div class="card-body">
        <p>안녕하세요.</p>
        <p>잠실새내교회 주일학교 주일학교 부모님들께 인사드립니다.</p>
        <p>저희 주일학교는 소중한 자녀들이 주님의 제자이자 귀한 자녀로 성장할 수 있도록 '꿈미(꿈이 있는 미래)'라는 원포인트 통합 교육 철학을 바탕으로, 모바일 프로그램을 마련했습니다.</p>
        <p>이 프로그램은 '드림웨이브'와 '매일성경' 교재를 활용하여, 말씀 암송, 기도, 퀴즈 등 다양한 활동을 통해 아이들이 신앙 안에서 자랄 수 있도록 돕고자 합니다.</p>
        <p>또한, 참여와 노력에 따라 포인트를 부여하고, 정기적으로 시상함으로써 아이들에게 도전을 장려하고 용기를 북돋아주고자 합니다.</p>
        <p>이 프로그램은 부모님들의 적극적인 관심과 협조가 필요합니다.</p>
        <p>소중한 자녀들이 믿음 안에서 건강하게 성장할 수 있도록 함께 동행해 주시길 부탁드립니다.</p>
        <p>감사합니다.</p>
    </div>
</div>
<br />

@await Html.PartialAsync("_PublishNavigationButton_1",new NavigationButtonInfo{ goPrev = null, goList = "'/Intro/Index'", goNext = "'/Intro/Index2'"})
