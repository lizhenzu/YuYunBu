@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService
<style>

    .one-body {
        display: flex;
        justify-content: center;
        align-items: center;
        /*height: 550vh;*/
        margin: 0;
    }

    .section {
        width: 100%;
        padding: 50px;
    }

    .circles {
        position: relative;
        height: 300px; /* 원들이 배치될 충분한 높이 */
        display: flex;
        justify-content: center;
        align-items: center;
    }


    .circle {
        width: 100px;
        height: 100px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        border-radius: 50%;
        background: radial-gradient(circle at 50% 50%, #FFFFFF 0%, #AAAAAA 100%);
        box-shadow: 0px 0px 10px 0px #000000;
        position: absolute;
    }

    #circle1 {
        color: #FF0000; /* 빨간색 */
        top: calc(50% - 100px); /* 기존 중앙에서 100px 위로 */
        left: 50%;
        transform: translate(-50%, -50%);
    }

    #circle2 {
        color: #00FF00; /* 초록색 */
        bottom: calc(50px + 63px); /* 기존 위치에서 123px 위로 */
        left: calc(50% - 145px); /* 중심에서 좌측으로 이동 */
        transform: translateY(50%);
    }

    #circle3 {
        color: #0000FF; /* 파란색 */
        bottom: calc(50px + 63px); /* 기존 위치에서 123px 위로 */
        right: calc(50% - 145px); /* 중심에서 우측으로 이동 */
        transform: translateY(50%);
    }

    .circle span {
        font-size: 24px;
        font-weight: bold;
    }

    .circle p {
        position: absolute;
        bottom: -50px;
        width: 200px;
        font-size: 12px;
        color: #333;
        text-align: center;
        top: 115px; /* 원의 높이 100px + 45px 여백 */
    }

    /*@@media (max-width: 768px) {
        .circles {
            flex-direction: column;
            height: 600px;
        }

        .circle {
            position: static;
            margin: 10px auto;
        }

        #circle1, #circle2, #circle3 {
            transform: none;
        }
    }*/
</style>
<br />
@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = "", TitleBody = "원 포인트 기반 교육 정의"})

<p></p>
