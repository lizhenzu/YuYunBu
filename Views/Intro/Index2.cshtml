<div id="div3" class="section circles">
    <div class="circle" id="circle1">
        <span>O</span>
        <p><strong>O</strong>ne Point for All Ages</p>
    </div>
    <div class="circle" id="circle2">
        <span>N</span>
        <p><strong>N</strong>etworking Home, Church and School</p>
    </div>
    <div class="circle" id="circle3">
        <span>E</span>
        <p><strong>E</strong>quipping the Next Generation</p>
