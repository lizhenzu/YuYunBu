@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService

<link rel="stylesheet" href="/css/intro.css">

<style>
 /* 화살표 스타일 */
#B::after {
    content: '';
    position: absolute;
    top: 48%;
    left: 100%;
    width: calc(20% + 2px); /* Extend arrow to nearly reach A */
    height: 5px;
    background: black;
    transform-origin: 0% 50%;
    transform: rotate(0deg);
}

#B::before {
    content: '';
    position: absolute;
    top: 44px; /* Center the arrowhead vertically */
    left: calc(80% + 36.5px); /* Position arrowhead right at the end of the line */
    border: solid black;
    border-width: 0 3px 3px 0;
    padding: 3px;
    transform: rotate(320deg);
    transform-origin: 0% 50%;
}

 


#D::after {
    content: '';
    position: absolute;
    top: 48%;
    right: 100%;
    width: calc(20% + 1px); /* Extend arrow to nearly reach A */
    height: 5px;
    background: black;
    transform-origin: 100% 50%;
    transform: rotate(0deg); /* Reverse direction */
}
         
#D::before {
    content: '';
    position: absolute;
    top: 44.4px; /* Center the arrowhead vertically */
    right: calc(100% + 22px); /* Position arrowhead right at the end of the line */
    border: solid black;
    border-width: 0 3px 3px 0;
    padding: 3px;
    transform: rotate(135deg); /* Adjust arrowhead orientation */
    transform-origin: 100% 50%;
}


</style>


<style>

    /* 화살표 녹슥 영영스타일 */
    #C::after {
        content: '';
        position: absolute;
        left: 47.8%;
        top: 100%;
        width: 5px;
        height: calc(22% + 1px); /* Extend arrow to nearly reach A */
        background: black;
        transform-origin: center top;
        transform: rotate(0deg); /* Arrow pointing downwards */
    }

    #C::before {
        content: '';
        position: absolute;
        left: 48.3px; /* Center the arrowhead horizontally */
        top: calc(74% + 44px); /* Position arrowhead right at the end of the line */
        border: solid black;
        border-width: 3px 3px 0 0;
        padding: 5px;
        transform: rotate(135deg); /* Adjust arrowhead orientation */
        transform-origin: 50% 0%;
    }

</style>

<br />
@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = $"매일 같은 성경 본문 기반", TitleBody = "부모와 자녀가 매일 하나의 말씀을 묵상"})

<div class="local-body">
    <div class="local-container">

        <div id="A" class="box">(매일성경)<br>성경본문</div>
        <div id="B" class="box">새벽기도</div>
        <div id="C" the class="box">(QT)<br/>아침묵상<br />말씀읽기</div>
        <div id="D" the class="box">성경퀴즈</div>
    </div>
</div>

@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = $"Encourage", TitleBody = "말씀읽기, 성경퀴즈 수행하면 각각 포인트 +1 부여"})


<br />
<p><strong>설명문</strong></p>
<div class="card">
    <div class="card-body">
        <p>현재 저희 교회에서는 새벽기도와 개인 묵상 시간(QT)에 "매일성경" 교재를 사용하여 동일한 성경 본문을 중심으로 이미 진행하고 있습니다.</p>
        <p>이는 전 교인이 하나의 교재와 본문을 통해 새벽기도와 QT를 함께하고 있다는 것을 의미합니다.</p>
        <p>이와 같은 통합적 접근을 주일학교에도 적용하기 위해, 저희는 부모와 자녀가 같은 본문을 묵상하도록 유도하며, 여기에 성경퀴즈를 도입하고자 합니다.</p>
        <p>부모님이 QT로 공부하는 본문을 기반으로 성경퀴즈를 출제하여, 아이들이 그 본문을 읽고 퀴즈를 풀도록 합니다.</p>
        <p>퀴즈를 맞춘 아이들에게는 포인트를 부여함으로써, 성경 공부에 대한 동기를 부여하고, 부모와 자녀가 같은 말씀을 공유하며 더 깊은 대화와 연결을 경험할 수 있도록 합니다.</p>
        <p>이러한 접근은 가정 내에서의 신앙 교육을 강화하고, 세대 간의 신앙 계승을 촉진하는 데 중요한 역할을 할 것입니다.</p>
    </div>
</div>

@await Html.PartialAsync("_PublishNavigationButton_1",new NavigationButtonInfo{ goPrev = "'/Intro/Index2'", goList = "'/Intro/Index'", goNext = "'/Intro/Index4'"})