@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService


<link rel="stylesheet" href="/css/intro.css">

<style>
    /* 화살표 스타일 */
    #B::after {
        content: '';
        position: absolute;
        top: 48%;
        left: 100%;
        width: calc(20% + 2px); /* Extend arrow to nearly reach A */
        height: 5px;
        background: black;
        transform-origin: 0% 50%;
        transform: rotate(0deg);
    }

    #B::before {
        content: '';
        position: absolute;
        top: 44px; /* Center the arrowhead vertically */
        left: calc(80% + 36.5px); /* Position arrowhead right at the end of the line */
        border: solid black;
        border-width: 0 3px 3px 0;
        padding: 3px;
        transform: rotate(320deg);
        transform-origin: 0% 50%;
    }
 
    #D::after {
        content: '';
        position: absolute;
        top: 48%;
        right: 100%;
        width: calc(20% + 1px); /* Extend arrow to nearly reach A */
        height: 5px;
        background: black;
        transform-origin: 100% 50%;
        transform: rotate(0deg); /* Reverse direction */
    }

    #D::before {
        content: '';
        position: absolute;
        top: 44.4px; /* Center the arrowhead vertically */
        right: calc(100% + 22px); /* Position arrowhead right at the end of the line */
        border: solid black;
        border-width: 0 3px 3px 0;
        padding: 3px;
        transform: rotate(135deg); /* Adjust arrowhead orientation */
        transform-origin: 100% 50%;
    }

</style>

<style>

    /* 화살표 녹슥 영영스타일 */
    #C::after {
        content: '';
        position: absolute;
        left: 47.8%;
        top: 100%;
        width: 5px;
        height: calc(22% + 1px); /* Extend arrow to nearly reach A */
        background: black;
        transform-origin: center top;
        transform: rotate(0deg); /* Arrow pointing downwards */
    }

    #C::before {
        content: '';
        position: absolute;
        left: 48.3px; /* Center the arrowhead horizontally */
        top: calc(74% + 44px); /* Position arrowhead right at the end of the line */
        border: solid black;
        border-width: 3px 3px 0 0;
        padding: 5px;
        transform: rotate(135deg); /* Adjust arrowhead orientation */
        transform-origin: 50% 0%;
    }

</style>
<br />
@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = $"주일 성경 본문 기반", TitleBody = "부모와 자녀가 가정예배 및 성경 암송"})

<div class="local-body">
    <div class="local-container">

        <div id="A" class="box">(매일성경)<br />(드림웨이브)<br />성경본문</div>
        <div id="B" class="box">주일설교</div>
        <div id="C" the class="box">가정예배</div>
        <div id="D" the class="box">성경암송</div>
    </div>
</div>

@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = $"Encourage", TitleBody = "성경암송 포인트 +1 부여"})

<br />
<p><strong>설명문</strong></p>
<div class="card">
    <div class="card-body">
        <p>현재 주일학교에서는 매주 주일학교 예배의 말씀 본문과 매주 주일 가정 예배의 본문 말씀이 같습니다.</p>
        <p>이는 아이들이 주일에 그리고 가정에서 같은 성경 본문을 두 번 접함으로써 말씀을 더 깊이 이해하고 기억하는 데 도움을 줍니다.</p>
        <p>이러한 반복 접근법에 더해서, 저희 주일학교는 '드림웨이브' 교재의 성경 암송 부분을 일주일 동안 암송하게 하고자 하니다.</p>
        <p>이 성경 암송을  통해 아이들은 성경 본문을 더 깊이 체화하고, 가정에서의 신앙 생활에도 더 적극적으로 참여하게 됩니다.</p>
    </div>
</div>

