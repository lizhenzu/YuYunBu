@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService

<link rel="stylesheet" href="/css/intro.css">

 

<style>

    /* 화살표 녹슥 영영스타일 */
    #C::after {
        content: '';
        position: absolute;
        left: 47.8%;
        top: 100%;
        width: 5px;
        height: calc(22% + 1px); /* Extend arrow to nearly reach A */
        background: black;
        transform-origin: center top;
        transform: rotate(0deg); /* Arrow pointing downwards */
    }

    #C::before {
        content: '';
        position: absolute;
        left: 48.3px; /* Center the arrowhead horizontally */
        top: calc(74% + 44px); /* Position arrowhead right at the end of the line */
        border: solid black;
        border-width: 3px 3px 0 0;
        padding: 5px;
        transform: rotate(135deg); /* Adjust arrowhead orientation */
        transform-origin: 50% 0%;
    }

</style>
<br />
@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = $"매일 MIP 성품기도", TitleBody = "부모와 자녀가 같이 기도"})

<div class="local-body">
    <div class="local-container">

        <div id="A" class="box">매일 기도</div>
        <div id="C" the class="box">MIP성품기도</div>
    </div>
</div>

@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = $"Encourage", TitleBody = "기도 포인트 +1 부여"})
<br />
<p><strong>설명문</strong></p>
<div class="card">
    <div class="card-body">
        <p>현재 잠실새내교회에서는 부모님을 중심으로 'MIP 성품기도'가 진행되고 있습니다.</p>
        <p>이 기도는 특정 성품에 초점을 맞추어 기도함으로써, 그리스도인으로서의 영적 강화하는 것을 목표로 합니다.</p>
        <p>이에 주일학교에서는 부모님들이 진행하는 성품기도를 아이들에게도 적용하고자 합니다.</p>
        <p>부모님과 함께 성품기도를 진행한 아이들에게는 포인트를 부여하여, 이를 통해 기도의 중요성을 인식하고, 신앙생활에 보다 적극적으로 참여하도록 격려하고자 합니다.</p>
        <p>이런 방식은 아이들이 기도를 통해 개인적으로 그리고 가족과 함께 성장하며, 신앙 안에서 강화될 수 있는 기회를 제공합니다.</p>
        <p>이를 통해 아이들은 기도하는 습관을 자연스럽게 배우고, 신앙생활의 기초를 탄탄히 다질 수 있습니다.</p>
    </div>
</div>
@await Html.PartialAsync("_PublishNavigationButton_1",new NavigationButtonInfo{ goPrev = "'/Intro/Index4'", goList = "'/Intro/Index'", goNext = "'/Intro/Index6'"})