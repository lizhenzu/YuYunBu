@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService
<style>
    .containerA {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1px;
    }

    .pillar {
        width: 200px;
        height: 35px;
        background-color: #45B39D;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 5px 0; /* 간격 조정 */
        box-shadow: 0 6px 8px rgba(0,0,0,0.3); /* 3D 효과 강화 */
        border-radius: 4px; /* 박스의 모서리를 둥글게 */
    }


    .horizontal-bar {
        width: 300px;
        height: 40;
        background-color: #FF007F;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 15px;
    }

    .horizontal-bar-2 {
        width: 300px;
        height: 40;
        background-color: #FF007F;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 14px;
    }


    .vertical-bars-container {
        display: flex;
        width: 300px;
        position: relative;
        justify-content: space-between;
    }

    .vertical-bar {
        height: 370px;
        width: 40px;
        background-color: #2ecc71;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 14px;
        flex-direction: column;
    }

    .vertical-text {
        writing-mode: vertical-lr;
    }

    .bars-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 60%;
        gap: 5px; /* 줄어든 간격 */
    }

    .bar {
        width: 100%;
        height: 30px;
        background-color: #e74c3c;
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 16px;
        position: relative;
    }

    .arrow {
        display: block;
        width: 0;
        height: 0;
        margin: 5px auto; /* 화살표와 가로 막대 사이의 간격 조정 */
        border-style: solid;
        border-width: 10px 10px 0 10px;
        border-color: #e74c3c transparent transparent transparent;
        position: relative;
    }

        .arrow:after {
            content: "";
            display: block;
            position: absolute;
            top: 10px; /* 화살표 머리 부분 아래로 위치 조정 */
            left: -10px; /* 꼬리가 화살표 중앙에 오도록 조정 */
            border-width: 0 10px 10px 10px;
            border-style: solid;
            border-color: transparent transparent #e74c3c transparent;
            width: 0;
            height: 0;
        }

    .container1 {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* 화살표 */
    .DownArrow {
        width: -10px;
        height: 0;
        border-left: 10px solid transparent; /* 화살표의 두께 조정 */
        border-right: 10px solid transparent; /* 화살표의 두께 조정 */
        border-top: 10px solid #1ebe41; /* 화살표 색상 및 두께 조정 */
    }

    /* 화살표 본체와 꼬리 */
    .UpArrow {
        width: 20px;
        height: 10px;
        background-color: #1ebe41;
        clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
        box-shadow: 0 5px 10px rgba(0,0,0,0.2); /* 3D effect */
    }

    /* 화살표 꼬리 */
    .DownArrowTailBeam {
        width: 10px; /* 꼬리 두께 조정 */
        height: 7px; /* 꼬리 길이 조정 */
        background-color: #1ebe41;
        margin: 0 auto; /* 중앙 정렬 */
        box-shadow: 2px 2px 4px rgba(0,0,0,0.2); /* 꼬리에도 약간의 3D 효과 추가 */
    }

    .UpArrowTailBeam {
        width: 10px;
        height: 7px; /* Adjust based on the distance between C and B */
        background-color: #1ebe41;
        margin: 0 auto; /* 중앙 정렬 */
        box-shadow: 2px 2px 4px rgba(0,0,0,0.2); /* 꼬리에도 약간의 3D 효과 추가 */
    }


        /* 3D press effect on click */
        .box:active {
            transform: translateY(10px);
            box-shadow: 0 5px 10px rgba(0,0,0,0.2);
        }

</style>
<br />
@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = "원포인트", TitleBody = "전체 흐름도"})
<div class="containerA">
    <div class="horizontal-bar pillar">매일성경</div>
    <div class="vertical-bars-container">
        <div class="vertical-bar pillar"><div class="vertical-text">매일 하나의 말씀으로</div></div>
        <div class="container1">
            <div class="pillar">새벽기도</div>
            <div class="DownArrowTailBeam"></div>
            <div class="DownArrow"></div>
            <div class="pillar">말씀읽기</div>
            <div class="DownArrowTailBeam"></div>
            <div class="DownArrow"></div>
            <div class="pillar">성경퀴즈</div>

            <div class="pillar">MIP성품기도</div>

            <div class="pillar">가정예배(주일)</div>
            <div class="UpArrow"></div>
            <div class="UpArrowTailBeam"></div>
            <div class="pillar">말씀암송</div>
            <div class="UpArrow"></div>
            <div class="UpArrowTailBeam"></div>
            <div class="pillar">주일공과</div>
        </div>
        <div class="vertical-bar pillar"><div class="vertical-text">자녀와 부모님이 함께하는</div></div>
    </div>
    <div class="horizontal-bar pillar">드림웨이브(꿈미,공과)</div>
</div>
<br />
<p><strong>설명문</strong></p>
<div class="card">
    <div class="card-body">
        <p>전체적인 것을 그림으로 도식화 하면 이와 같습니다.</p>
        <p>'매일성경'와 '드림웨이브' 교재를 활용하여 부모와 자녀가 매일 동일한 성경 본문을 읽고, 기도하고, 퀴즈를 푸며, 말씀을 암송하게 하도록 유도하는 프로그램을 운영하고자 합니다. </p>
        <p>이러한 접근은 부모와 자녀가 같은 성경 본문을 공유함으로써, 가정 내에서 신앙적 연결고리를 강화하고, 신앙 교육을 가정으로 확장하는 데 큰 도움이 됩니다.</p>
        <p>또한, 이를 통해 자녀들은 신앙에 대한 깊은 이해와 적용 능력을 자연스럽게 키울 수 있습니다.</p>
        <p>이 프로그램을 주일학교 아이들이 신앙생활의 기본을 탄탄히 다지고, 가정에서도 부모와 함께 신앙을 나누는 소중한 시간을 가질 수 있기를 기도 합니다.</p>
    </div>
</div>

@await Html.PartialAsync("_PublishNavigationButton_1",new NavigationButtonInfo{ goPrev = "'/Intro/Index5'", goList = "'/Intro/Index'", goNext = "'/Intro/Index7'"})