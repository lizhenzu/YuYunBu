@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{

    Layout = null;
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());

}
 
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ChurchName · @DepartmentName</title>
    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: Arial, sans-serif;
            background: url('/images/home/welcome/welcome_01.webp') no-repeat center center fixed;
            background-size: cover;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .content {
            width: 300px;
            text-align: center;
            color: white;
            background-color: rgba(0, 0, 0, 0.8); /* Semi-transparent black background */
            padding: 20px;
            border-radius: 10px;
        }

        .button {
            background-color: #4CAF50; /* Green */
            border: none;
            color: white;
            padding: 15px 32px;
            text-align: center;
            text-decoration: none;
            display: block; /* Makes the button expand to the width of the container */
            font-size: 16px;
            margin: 10px 0; /* Adds space between buttons */
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="content">
        <h2>도1전 성경 말씀  소개</h2>
        <h3>1. 소개자료 기입</h3>
        <h3>2. 소개자료 기입</h3>
        <h3>3. 소개자료 기입</h3>
        <h3>4. 소개자료 기입</h3>
        <h3>5. 소개자료 기입</h3>
        <a href="/Home/IndexBranch" class="button">출발 [@ConstatsCommon.MainKeyTitle]</a>
        <a href="/" class="button">Home</a>
    </div>
</body>
</html>