@using BulletinBoard.Common;
@model IEnumerable<BulletinBoard.Models.JuManNaYYYYMM>

@*  ══════════════════════════════════════════════════════════════
    매일성경 말씀 정리 — 월 목록 — 2026-10-04 시안 확정 (DailyMission4 밝은 흰색 · quiz-bright.css + jumanna-bright.css)
    · 최근 달이 위.  보기 방식 이름: 최소 → 본문만, 약식 → 주제까지, 상세 → 전체 내용, 날짜S → 영상 구간 (주소 · option 값은 그대로)
    · 배경 음악 버튼(외부 bensound 음악)은 시안대로 뺐다
    · 이전 화면은 IndexGroupByYYYYMM.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
    var months = (Model ?? Enumerable.Empty<BulletinBoard.Models.JuManNaYYYYMM>())
                 .OrderByDescending(m => m.YYYYMMCodeString).ToList();

    // "2026-10" → "2026년 10월"
    string MonthLabel(BulletinBoard.Models.JuManNaYYYYMM m)
    {
        var p = (m.YYYYMMCodeString ?? "").Split('-');
        return p.Length == 2 && int.TryParse(p[0], out var y) && int.TryParse(p[1], out var mm) ? $"{y}년 {mm}월" : m.YYYYMMDsiaplyString;
    }
    int no = 0;

    // 새 달 일괄 입력 — 기본값은 마지막 달의 다음 달 (없으면 이번 달, KST)
    string nextYm = BulletinBoard.Helpers.DateHelper.GetKoreaNow().ToString("yyyy-MM");
    if (months.Count > 0 && DateTime.TryParse(months[0].YYYYMMCodeString + "-01", out var lastFirst))
    {
        nextYm = lastFirst.AddMonths(1).ToString("yyyy-MM");
    }
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>말씀 정리</title>
    <link rel="stylesheet" href="/css/quiz-bright.css" asp-append-version="true">
    <link rel="stylesheet" href="/css/jumanna-bright.css" asp-append-version="true">
    <style>body { margin: 0; background: #FFFFFF; }</style>
</head>
<body>
<div class="qb">

    <div class="qb-top">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/HumanResource/ManageUserInfo#g4">정보 관리</a><span class="sep">›</span>말씀 정리</span>
        <span>WORD</span>
    </div>

    <div class="qb-k">DAILY WORD</div>
    <h1 class="qb-h1">매일성경 말씀 정리</h1>
    <div class="qb-sub">달을 고르고, 보고 싶은 방식을 눌러 주세요</div>

    <div class="qb-sec">새 달 일괄 입력<small>있는 달이면 수정, 없으면 새로 추가</small></div>
    <form class="jm-newmo" method="get" action="/JuManNa/MonthlyBulk">
        <input type="month" name="YYYYMM" value="@nextYm" class="qb-in" required aria-label="일괄 입력할 달" />
        <button type="submit" class="jm-pill p">월별일괄</button>
    </form>

    <div class="qb-sec">달<small>최근 달이 위에</small></div>

    @if (months.Count == 0)
    {
        <div class="qb-empty">등록된 말씀이 없어요</div>
    }

    @foreach (var item in months)
    {
        no++;
        string ym = item.YYYYMMCodeString;
        <div class="jm-mo">
            <div class="h"><span class="n">@no.ToString("00")</span><b>@MonthLabel(item)</b><small>말씀 @(item.DC)개</small></div>
            <div class="op">
                <a class="jm-pill p" href="/JuManNa/MonthlyBulk?YYYYMM=@ym">월별일괄</a>
                <a class="jm-pill" href="/JuManNa/IndexQueryByYYYYMM?option=Minimal&YYYYMM=@ym">본문만</a>
                <a class="jm-pill" href="/JuManNa/IndexQueryByYYYYMM?option=Rough&YYYYMM=@ym">주제까지</a>
                <a class="jm-pill" href="/JuManNa/IndexQueryByYYYYMM?option=Detail&YYYYMM=@ym">전체 내용</a>
                <a class="jm-pill s" href="/JuManNa/IndexQueryByYYYYMM?option=DetailSerail&YYYYMM=@ym"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4l13 8-13 8z" /></svg>영상 구간</a>
            </div>
        </div>
    }

    <div class="qb-ft">
        <span>말씀 정리</span>
        <span><a href="/HumanResource/ManageUserInfo#g4">정보 관리</a><a href="/">@ConstatsCommon.ToHome</a></span>
    </div>
</div>
</body>
</html>
