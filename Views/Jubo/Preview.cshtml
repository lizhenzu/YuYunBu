@model BulletinBoard.Models.Jubo.JuboPreviewViewModel
@{
    Layout = null;
    ViewData["Title"] = "주보 미리보기";
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/jubo.css" />

    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
            background: #E8EDF2;
            overflow-x: hidden;
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: "Pretendard", "Noto Sans KR", "Malgun Gothic", sans-serif;
            color: #1E293B;
        }

        .standalone-jubo-page {
            width: 100%;
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, rgba(255,255,255,0.72), transparent 28%),
                radial-gradient(circle at top right, rgba(255,255,255,0.55), transparent 22%),
                linear-gradient(180deg, #F7FAFC 0%, #E8EDF2 100%);
        }

        .jubo-print-toolbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            width: 100%;
            display: flex;
            flex-wrap: wrap;
            gap: 0.7rem;
            align-items: center;
            padding: 1rem 1.25rem;
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(148, 163, 184, 0.18);
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        }

        .jubo-print-toolbar .btn-jubo,
        .jubo-template-badge,
        .jubo-published-badge {
            flex: 0 0 auto;
        }

        .jubo-print-root {
            width: 100%;
            max-width: 100%;
            margin: 0;
            padding: 1rem 1rem 2rem;
        }

        .jubo-screen-preview {
            width: 100%;
        }

        .jubo-print-sheet-container {
            display: none;
        }

        @@media (min-width: 768px) {
            .jubo-print-toolbar {
                padding: 1rem 1.5rem;
            }

            .jubo-print-root {
                padding: 1.25rem 1.5rem 2.5rem;
            }
        }

        @@media (min-width: 1200px) {
            .jubo-print-toolbar {
                padding-left: 2rem;
                padding-right: 2rem;
            }

            .jubo-print-root {
                padding-left: 2rem;
                padding-right: 2rem;
            }
        }

        @@media print {
            @@page {
                size: A4 landscape;
                margin: 8mm;
            }

            html, body {
                background: #fff !important;
                width: 100%;
                height: auto;
                overflow: visible !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            body {
                margin: 0 !important;
                padding: 0 !important;
            }

            .standalone-jubo-page {
                background: #fff !important;
                min-height: auto !important;
            }

            .jubo-print-toolbar {
                display: none !important;
            }

            .jubo-print-root {
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
            }

            .jubo-screen-preview {
                display: none !important;
            }

            .jubo-print-sheet-container {
                display: block !important;
                width: 100% !important;
            }

            .jubo-print-sheet-grid {
                display: grid !important;
                grid-template-columns: 1fr 1fr !important;
                gap: 8mm !important;
                align-items: stretch !important;
                width: 100% !important;
            }

            .jubo-print-item {
                display: block !important;
                width: 100% !important;
                min-width: 0 !important;
                break-inside: avoid !important;
                page-break-inside: avoid !important;
                overflow: hidden !important;
            }

            .jubo-print-item > * {
                width: 100% !important;
                max-width: 100% !important;
                min-height: 0 !important;
                margin: 0 !important;
                box-shadow: none !important;
            }

            .jubo-print-item:nth-child(2n) {
                break-after: page;
                page-break-after: always;
            }

            .jubo-print-item:last-child {
                break-after: auto !important;
                page-break-after: auto !important;
            }

            .jubo-print-item .jubo-paper,
            .jubo-print-item .jubo-sheet,
            .jubo-print-item .jubo-card,
            .jubo-print-item .jubo-page,
            .jubo-print-item .jubo-layout,
            .jubo-print-item .jubo-frame {
                width: 100% !important;
                max-width: 100% !important;
                min-height: 0 !important;
                height: auto !important;
                transform: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="standalone-jubo-page">
        <div class="jubo-print-toolbar">
            <a href="/Jubo/Edit/@Model.Id" class="btn-jubo btn-jubo-edit">← 편집으로</a>
            <a href="/Jubo/Preview/@Model.Id?half=top" class="btn-jubo btn-jubo-preview">👁 上 (1·2페이지)</a>
            <a href="/Jubo/Preview/@Model.Id?half=bottom" class="btn-jubo btn-jubo-preview" style="background:linear-gradient(135deg,#7C3AED,#6D28D9); color:#fff;">👁 下 (3·4페이지)</a>
            <a href="/Jubo/Print/@Model.Id" target="_blank" class="btn-jubo btn-jubo-print">🖨 출력 페이지 열기</a>
            <button type="button"
                    class="btn-jubo btn-jubo-save"
                    onclick="printTwoUp()">
                🖨 직접 인쇄
            </button>
            <button type="button"
                    class="btn-jubo btn-jubo-attend"
                    onclick="createSnapshot(@Model.Id)">
                📸 스냅샷 저장
            </button>

            <span class="jubo-template-badge" style="padding:0.45rem 0.9rem;">
                @(Model.TemplateType == "Normal" ? "⛪ 일반" :
                  Model.TemplateType == "PalmSunday" ? "🌿 종려주일" : "🥚 부활절")
            </span>

            @if (Model.IsPublished)
            {
                <span class="jubo-published-badge published" style="font-size:0.8rem; padding:0.4rem 0.9rem;">✅ 발행됨</span>
            }
            else
            {
                <span class="jubo-published-badge draft" style="font-size:0.8rem; padding:0.4rem 0.9rem;">✏️ 작성 중</span>
            }
        </div>

        <div class="jubo-print-root">
            <div id="screenPreview" class="jubo-screen-preview">
                @if (Model.TemplateType == "PalmSunday")
                {
                    @await Html.PartialAsync("_Template_PalmSunday", Model)
                }
                else if (Model.TemplateType == "Easter")
                {
                    @await Html.PartialAsync("_Template_Easter", Model)
                }
                else
                {
                    @await Html.PartialAsync("_Template_Normal", Model)
                }
            </div>

            <div id="printSheetContainer" class="jubo-print-sheet-container"></div>
        </div>
    </div>

    <script src="~/js/jubo.js"></script>

    <script>
        // ── half 파라미터 처리: top=1·2페이지만 표시, bottom=3·4페이지만 표시 ──
        (function () {
            var half = new URLSearchParams(window.location.search).get('half');
            if (!half) return;

            function filterAndLayout() {
                var pages = document.querySelectorAll('#screenPreview .jubo-a4-page');

                // 1) 해당되지 않는 페이지 숨김
                pages.forEach(function (page, idx) {
                    if (half === 'top'    && idx >= 2) page.style.display = 'none';
                    if (half === 'bottom' && idx <  2) page.style.display = 'none';
                });

                // 2) 보이는 2페이지를 가로 2열 나란히 배치 (한 화면에 표시)
                var preview = document.getElementById('screenPreview');
                if (!preview) return;

                preview.style.display = 'grid';
                preview.style.gridTemplateColumns = '1fr 1fr';
                preview.style.gap = '1rem';
                preview.style.alignItems = 'start';

                // 각 페이지 너비를 컨테이너에 맞게 100% 로 재설정
                pages.forEach(function (page) {
                    if (page.style.display === 'none') return;
                    page.style.width = '100%';
                    page.style.minHeight = 'auto';
                    page.style.margin = '0';
                });
            }

            // DOM 준비 즉시 실행 (깜빡임 방지)
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', filterAndLayout);
            } else {
                filterAndLayout();
            }
        })();

        (function () {
            const ROOT_ID = "screenPreview";
            const PRINT_CONTAINER_ID = "printSheetContainer";

            function getPrintableElements() {
                const root = document.getElementById(ROOT_ID);
                if (!root) return [];

                const preferredSelectors = [
                    ".jubo-sheet",
                    ".jubo-paper",
                    ".jubo-card",
                    ".jubo-page",
                    ".print-page",
                    ".jubo-layout",
                    ".jubo-frame"
                ];

                for (const selector of preferredSelectors) {
                    const found = Array.from(root.querySelectorAll(selector));
                    if (found.length >= 1) {
                        return found;
                    }
                }

                const directChildren = Array.from(root.children || []).filter(x => x.nodeType === 1);
                if (directChildren.length >= 1) {
                    return directChildren;
                }

                return [root];
            }

            function buildPrintTwoUp() {
                const printContainer = document.getElementById(PRINT_CONTAINER_ID);
                if (!printContainer) return;

                printContainer.innerHTML = "";

                const elements = getPrintableElements();
                const grid = document.createElement("div");
                grid.className = "jubo-print-sheet-grid";

                elements.forEach((el) => {
                    const item = document.createElement("div");
                    item.className = "jubo-print-item";

                    const clone = el.cloneNode(true);

                    clone.removeAttribute("id");
                    clone.querySelectorAll("[id]").forEach(node => node.removeAttribute("id"));

                    item.appendChild(clone);
                    grid.appendChild(item);
                });

                printContainer.appendChild(grid);
            }

            window.printTwoUp = function () {
                buildPrintTwoUp();
                window.print();
            };

            window.addEventListener("beforeprint", buildPrintTwoUp);
        })();
    </script>
</body>
</html>