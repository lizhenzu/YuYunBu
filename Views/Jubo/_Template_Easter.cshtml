@model BulletinBoard.Models.Jubo.JuboPreviewViewModel
@using BulletinBoard.Models.Jubo
@{
    var attend = Model.Attendance;
    string WeekDay(DateTime d) => new[] {"일","월","화","수","목","금","토"}[(int)d.DayOfWeek];
}

<!-- ═══════════════════════════════ PAGE 1 · COVER (Easter) ══════════════════ -->
<div class="jubo-a4-page tpl-easter">
    <div class="page-cover">
        <div class="cover-top-deco"></div>

        <div class="dot-pattern"
             style="position:absolute; inset:0; opacity:0.4; pointer-events:none;"></div>

        <!-- Easter deco -->
        <div style="position:absolute; top:20px; left:15px; font-size:3.5rem; opacity:0.25; animation:floatCloud 6s ease-in-out infinite;">🥚</div>
        <div style="position:absolute; top:50px; right:20px; font-size:3rem; opacity:0.2; animation:floatCloud 5s ease-in-out infinite reverse;">🐣</div>
        <div style="position:absolute; bottom:160px; left:15px; font-size:2.5rem; opacity:0.2; animation:floatCloud 7s ease-in-out infinite;">🌸</div>
        <div style="position:absolute; bottom:140px; right:20px; font-size:2.5rem; opacity:0.2; animation:floatCloud 4s ease-in-out infinite reverse;">🦋</div>
        <div style="position:absolute; top:210px; left:25px; font-size:2rem; opacity:0.15;">✝️</div>

        <div class="cover-decoration" style="position:relative; z-index:1; padding-top:2rem;">
            <div class="cover-church-name" style="color:rgba(255,255,255,0.9);">✝️ 주일학교 주보</div>
            <div style="text-align:center; margin-bottom:0.5rem;">
                <span class="cover-season-tag" style="background:rgba(249,168,212,0.35); border-color:rgba(249,168,212,0.5);">
                    🥚 부활절 특별호
                </span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Season) && Model.Season != "부활절")
            {
                <div style="text-align:center;">
                    <span class="cover-season-tag">🌸 @Model.Season</span>
                </div>
            }
            <div class="cover-decoration-circles" style="margin-top:0.8rem;">
                <span class="cover-circle"></span>
                <span class="cover-circle"></span>
                <span class="cover-circle"></span>
                <span class="cover-circle"></span>
                <span class="cover-circle"></span>
            </div>
        </div>

        <div class="cover-main" style="position:relative; z-index:1;">
            <div class="cover-big-emoji">🥚</div>
            <h1 class="cover-title">@Model.Title</h1>

            <div style="display:flex; justify-content:center; margin-bottom:1.5rem;">
                <div class="cover-date-box" style="background:rgba(255,255,255,0.92);">
                    <div class="cover-date-label" style="color:#DB2777; letter-spacing:1px;">부활절</div>
                    <div class="cover-date-value">@Model.JuboDate.ToString("yyyy년 MM월 dd일")</div>
                    <div class="cover-date-weekday">@WeekDay(Model.JuboDate)요일 · 주일 예배</div>
                </div>
            </div>

            <!-- Resurrection message -->
            <div style="background:rgba(253,230,138,0.3); backdrop-filter:blur(4px);
                        border-radius:16px; padding:0.9rem 1.4rem; text-align:center;
                        border:1px solid rgba(253,230,138,0.5); margin-bottom:1rem;">
                <div style="font-size:0.75rem; color:rgba(255,255,255,0.85); font-weight:700;
                             letter-spacing:1px; margin-bottom:0.3rem;">🌅 부활의 기쁨</div>
                <div style="font-size:1rem; font-weight:700; color:white;
                             text-shadow:0 1px 4px rgba(0,0,0,0.15); line-height:1.5;">
                    예수님이 살아나셨어요! 🎉<br/>
                    <span style="font-size:0.85rem; font-weight:500;">할렐루야!</span>
                </div>
            </div>

            <!-- Banner Image -->
            <div style="margin-top:0.5rem;
                        border-radius:18px; overflow:visible;
                        filter: drop-shadow(0 8px 18px rgba(0,0,0,0.28)) drop-shadow(0 2px 6px rgba(0,0,0,0.18));
                        transform: perspective(600px) rotateX(1.5deg);
                        transform-origin: center bottom;">
                <div style="border-radius:18px; overflow:hidden;
                            box-shadow:
                                0 2px 0 1px rgba(255,255,255,0.55) inset,
                                0 -2px 0 1px rgba(0,0,0,0.12) inset,
                                0 12px 32px rgba(0,0,0,0.25),
                                0 4px 10px rgba(0,0,0,0.15),
                                0 1px 3px rgba(0,0,0,0.10);
                            border: 2px solid rgba(255,255,255,0.70);">
                    <img src="/images/jubo/jubo.jpg" alt="유년부 주보"
                         style="width:100%; display:block; height:auto;" />
                </div>
            </div>

            <!-- Church Staff Info (Fixed) -->
            <div style="background:rgba(255,255,255,0.90); backdrop-filter:blur(8px);
                        border-radius:16px; padding:0.7rem 1rem; margin-top:0.4rem;
                        box-shadow:0 4px 18px rgba(0,0,0,0.09);
                        border:1px solid rgba(255,255,255,0.7);">
                <div style="text-align:center; font-size:0.63rem; font-weight:800; color:#64748B;
                            letter-spacing:1.5px; margin-bottom:0.45rem; padding-bottom:0.3rem;
                            border-bottom:1px dashed rgba(148,163,184,0.4);">
                    ✝️ 잠실새내교회 유년부 &nbsp;·&nbsp; 매주 주일 오전 10시
                </div>
                <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:3px 6px; margin-bottom:0.35rem;">
                    <div style="font-size:0.61rem; color:#475569; white-space:nowrap;"><span style="font-weight:800;color:#1E293B;">교장</span> 박영석 목사</div>
                    <div style="font-size:0.61rem; color:#475569; white-space:nowrap;"><span style="font-weight:800;color:#1E293B;">부장</span> 유민종</div>
                    <div style="font-size:0.61rem; color:#475569; white-space:nowrap;"><span style="font-weight:800;color:#1E293B;">회계</span> 채정훈</div>
                    <div style="font-size:0.61rem; color:#475569; white-space:nowrap;"><span style="font-weight:800;color:#1E293B;">부감</span> 김연선</div>
                    <div style="font-size:0.61rem; color:#475569; white-space:nowrap;"><span style="font-weight:800;color:#1E293B;">서기</span> 김은경</div>
                    <div style="font-size:0.61rem; color:#475569; white-space:nowrap;"><span style="font-weight:800;color:#1E293B;">영상</span> 송종훈</div>
                    <div style="font-size:0.61rem; color:#475569; white-space:nowrap;"><span style="font-weight:800;color:#1E293B;">촬영</span> 김주찬</div>
                    <div style="font-size:0.61rem; color:#475569; white-space:nowrap;"><span style="font-weight:800;color:#1E293B;">반주</span> 이찬영</div>
                </div>
                <div style="font-size:0.6rem; color:#64748B; margin-bottom:2px;">
                    <span style="font-weight:800;color:#334155;">찬양율동</span>&nbsp; 정소희 · 서은희 · 김연준 선생님
                </div>
                <div style="font-size:0.6rem; color:#64748B; margin-bottom:0.4rem;">
                    <span style="font-weight:800;color:#334155;">보&nbsp;&nbsp;&nbsp;&nbsp;조</span>&nbsp; 이상윤 · 송민혁 · 박정진 선생님
                </div>
                <div style="border-top:1px dashed rgba(148,163,184,0.4); padding-top:0.3rem; text-align:center;">
                    <div style="font-size:0.59rem; color:#94A3B8; line-height:1.6;">
                        서울시 송파구 석촌호수로 102 잠실새내교회 비전센터 3층
                    </div>
                    <div style="font-size:0.59rem; color:#94A3B8;">www.jamsilkids.com</div>
                </div>
            </div>
        </div>

        <div class="cover-bottom-wave">
            <svg viewBox="0 0 900 80" preserveAspectRatio="none">
                <path d="M0,50 C100,10 250,70 400,30 C550,-10 700,60 900,40 L900,80 L0,80 Z"
                      fill="#FFF1F2" opacity="0.95"/>
            </svg>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════ PAGE 2 ════════════════════════════════════ -->
<div class="jubo-a4-page tpl-easter">
    <div class="page-content">
        <div class="content-top-bar"></div>
        <div class="content-inner">
            <div style="text-align:center; margin-bottom:1.5rem; padding-bottom:0.8rem;
                        border-bottom:3px dotted #FBCFE8;">
                <span style="font-size:0.8rem; color:#DB2777; font-weight:700; letter-spacing:2px;">
                    🥚 부활절 · @Model.JuboDate.ToString("yyyy.MM.dd")
                </span>
            </div>

            @{ var worship = Model.GetBlock(JuboBlockTypes.WorshipOrder); }
            @if (worship != null)
            {
                <div class="jubo-content-block">
                    <div class="jubo-content-block-header block-header-WorshipOrder">
                        <span style="font-size:1.2rem;">🙏</span>
                        <span>@worship.BlockTitle</span>
                    </div>
                    <div class="jubo-content-block-body">@worship.BlockContent</div>
                </div>
            }

            @{
                var prayerTeam  = Model.GetBlock(JuboBlockTypes.NextWeekPrayerTeam);
                var streetEvang = Model.GetBlock(JuboBlockTypes.NextWeekStreetEvangelism);
                bool showNextWeek = (prayerTeam  != null && prayerTeam.IsVisible  && !string.IsNullOrWhiteSpace(prayerTeam.BlockContent))
                                 || (streetEvang != null && streetEvang.IsVisible && !string.IsNullOrWhiteSpace(streetEvang.BlockContent));
            }
            @if (showNextWeek)
            {
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.6rem; margin-bottom:0.5rem;">
                    @if (prayerTeam != null && prayerTeam.IsVisible && !string.IsNullOrWhiteSpace(prayerTeam.BlockContent))
                    {
                        <div class="jubo-content-block" style="margin-bottom:0;">
                            <div class="jubo-content-block-header block-header-Birthday"
                                 style="background:linear-gradient(135deg,#EDE9FE,#DDD6FE);">
                                <span style="font-size:1.1rem;">🙌</span>
                                <span style="color:#5B21B6;">@(prayerTeam.BlockTitle ?? "다음주 대표기도반")</span>
                            </div>
                            <div class="jubo-content-block-body"
                                 style="background:linear-gradient(to bottom,#FAF5FF,#F3E8FF);
                                        font-size:0.88rem; line-height:1.8;">
                                @prayerTeam.BlockContent
                            </div>
                        </div>
                    }
                    @if (streetEvang != null && streetEvang.IsVisible && !string.IsNullOrWhiteSpace(streetEvang.BlockContent))
                    {
                        <div class="jubo-content-block" style="margin-bottom:0;">
                            <div class="jubo-content-block-header block-header-ParentNotice"
                                 style="background:linear-gradient(135deg,#FEE2E2,#FECACA);">
                                <span style="font-size:1.1rem;">🚶</span>
                                <span style="color:#991B1B;">@(streetEvang.BlockTitle ?? "다음주 노방전도반")</span>
                            </div>
                            <div class="jubo-content-block-body"
                                 style="background:linear-gradient(to bottom,#FFF5F5,#FEE2E2);
                                        font-size:0.88rem; line-height:1.8;">
                                @streetEvang.BlockContent
                            </div>
                        </div>
                    }
                </div>
            }

            @{ var scripture = Model.GetBlock(JuboBlockTypes.ScriptureText); }
            @if (scripture != null)
            {
                <div class="jubo-content-block">
                    <div class="jubo-content-block-header block-header-ScriptureText">
                        <span style="font-size:1.2rem;">📖</span>
                        <span>@scripture.BlockTitle</span>
                    </div>
                    <div class="jubo-content-block-body"
                         style="background:linear-gradient(to bottom,#FFF9F0,#FFFBEB); font-style:italic;">
                        @scripture.BlockContent
                    </div>
                </div>
            }

            <div style="text-align:center; margin-top:auto; padding-top:1rem;
                        color:#FBCFE8; font-size:0.8rem; letter-spacing:3px;">🥚 ✦ 🐣 ✦ 🥚</div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════ PAGE 3 ════════════════════════════════════ -->
<div class="jubo-a4-page tpl-easter">
    <div class="page-content" style="background:linear-gradient(180deg,#FFF1F2 0%,#FFFBEB 50%,#F0FFF4 100%);">
        <div class="content-top-bar"></div>
        <div class="content-inner">
            <div style="text-align:center; margin-bottom:1.2rem; padding-bottom:0.8rem;
                        border-bottom:3px dotted #FBCFE8;">
                <span style="font-size:0.8rem; color:#DB2777; font-weight:700; letter-spacing:2px;">
                    ✨ 말씀 · 사명 · 공지
                </span>
            </div>

            @{ var memory = Model.GetBlock(JuboBlockTypes.MemoryVerse); }
            @if (memory != null)
            {
                <div class="jubo-content-block">
                    <div class="jubo-content-block-header block-header-MemoryVerse">
                        <span style="font-size:1.2rem;">✨</span>
                        <span>@memory.BlockTitle</span>
                    </div>
                    <div class="jubo-content-block-body"
                         style="background:linear-gradient(to bottom,#FEF3C7,#FFFBEB);
                                font-size:1rem; font-weight:600; text-align:center; line-height:1.8;">
                        @memory.BlockContent
                    </div>
                </div>
            }

            @{ var mission = Model.GetBlock(JuboBlockTypes.MissionGuide); }
            @if (mission != null)
            {
                <div class="jubo-content-block">
                    <div class="jubo-content-block-header block-header-MissionGuide">
                        <span style="font-size:1.2rem;">🚀</span>
                        <span>@mission.BlockTitle</span>
                    </div>
                    <div class="jubo-content-block-body">@mission.BlockContent</div>
                </div>
            }

            @{ var events = Model.GetBlock(JuboBlockTypes.EventAnnouncements); }
            @if (events != null)
            {
                <div class="jubo-content-block">
                    <div class="jubo-content-block-header block-header-EventAnnouncements">
                        <span style="font-size:1.2rem;">📢</span>
                        <span>@events.BlockTitle</span>
                    </div>
                    <div class="jubo-content-block-body">@events.BlockContent</div>
                </div>
            }

            <div style="text-align:center; margin-top:auto; padding-top:1rem;
                        color:#FBCFE8; font-size:0.8rem; letter-spacing:3px;">🌸 ✦ 🦋 ✦ 🌸</div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════ PAGE 4 ════════════════════════════════════ -->
<div class="jubo-a4-page tpl-easter">
    <div class="page-content" style="background:linear-gradient(180deg,#FFFBEB 0%,#FFF1F2 50%,#F0FFF4 100%);">
        <div class="content-top-bar"></div>
        <div class="content-inner">
            <div style="text-align:center; margin-bottom:1.2rem; padding-bottom:0.8rem;
                        border-bottom:3px dotted #FBCFE8;">
                <span style="font-size:0.8rem; color:#DB2777; font-weight:700; letter-spacing:2px;">
                    🎂 생일 · 📊 출석 · 📢 공지
                </span>
            </div>

            @{ var birthday = Model.GetBlock(JuboBlockTypes.Birthday); }
            @if (birthday != null)
            {
                <div class="jubo-content-block">
                    <div class="jubo-content-block-header block-header-Birthday">
                        <span style="font-size:1.2rem;">🎂</span>
                        <span>@birthday.BlockTitle</span>
                    </div>
                    <div class="jubo-content-block-body">@birthday.BlockContent</div>
                </div>
            }

            @if (attend != null && attend.Classes.Any())
            {
                var _wks = attend.WeeksCount > 0 ? attend.WeeksCount : 1;
                <div class="jubo-content-block">
                    <div class="jubo-content-block-header block-header-WorshipOrder">
                        <span style="font-size:1.2rem;">📊</span>
                        <span>이번 주 출석 현황</span>
                    </div>
                    <div class="jubo-content-block-body" style="padding:0.35rem 0.5rem; line-height:1.1;">
                        <div class="jubo-attend-total-box" style="margin-bottom:5px;">
                            <div class="attend-total-item">
                                <div class="attend-total-num">@attend.TotalCount</div>
                                <div class="attend-total-lbl">👥 총원</div>
                            </div>
                            <div class="attend-total-item">
                                <div class="attend-total-num" style="color:#10B981;">@attend.TotalPresent</div>
                                <div class="attend-total-lbl">✅ 출석</div>
                            </div>
                            <div class="attend-total-item">
                                <div class="attend-total-num" style="color:#EF4444;">@attend.TotalAbsent</div>
                                <div class="attend-total-lbl">❌ 결석</div>
                            </div>
                            <div class="attend-total-item">
                                <div class="attend-total-num" style="color:#D97706;">@attend.TotalNewComer</div>
                                <div class="attend-total-lbl">🌟 새친구</div>
                            </div>
                        </div>
                        <div class="jubo-attend-detail-grid">
                            @foreach (var cls in attend.Classes)
                            {
                                var _stuList = cls.Students.OrderByDescending(s => s.IsPresent).ThenBy(s => s.StudentName).ToList();
                                var _present = cls.Students.Count(s => s.IsPresent);
                                <div class="jubo-attend-detail-card">
                                    <div class="jubo-attend-detail-head">
                                        <span>@cls.ClassName</span>
                                        <span style="color:#DB2777;">@_present/@(cls.TotalCount)</span>
                                    </div>
                                    @for (int _si = 0; _si < _stuList.Count; _si++)
                                    {
                                        var stu = _stuList[_si];
                                        var _isNew5 = stu.IsNewComer && stu.NewComerVisitCount < 5;
                                        var _badge = _isNew5 ? $"{stu.NewComerVisitCount}회" : $"{stu.YearPresentCount}/{_wks}";
                                        var _rate  = _wks > 0 ? (double)stu.YearPresentCount / _wks : 0;
                                        var _bCls  = _isNew5 ? "mid" : (_rate >= 0.8 ? "good" : (_rate >= 0.5 ? "mid" : "bad"));
                                        <div class="jubo-attend-stu-row">
                                            <span class="jubo-attend-stu-num">@(_si + 1)</span>
                                            <span class="jubo-attend-stu-name @(stu.IsPresent ? "present" : "")">@stu.StudentName</span>
                                            <span class="jubo-attend-stu-badge @_bCls">@_badge</span>
                                            <span class="jubo-attend-stu-mark">@(stu.IsPresent ? "●" : "")</span>
                                        </div>
                                    }
                                    <div class="jubo-attend-detail-foot">출석 @_present · 결석 @(cls.TotalCount - _present)</div>
                                </div>
                            }
                        </div>
                        <div class="jubo-attend-weeks-note">※ 이름 옆: 올해출석/@(_wks)주 (새친구=방문횟수)</div>
                    </div>
                </div>
            }

            @{ var parentNotice = Model.GetBlock(JuboBlockTypes.ParentNotice); }
            @if (parentNotice != null)
            {
                <div class="jubo-content-block">
                    <div class="jubo-content-block-header block-header-ParentNotice">
                        <span style="font-size:1.2rem;">👨‍👩‍👧‍👦</span>
                        <span>@parentNotice.BlockTitle</span>
                    </div>
                    <div class="jubo-content-block-body">@parentNotice.BlockContent</div>
                </div>
            }

            @{ var giftNotice = Model.GetBlock(JuboBlockTypes.GiftNotice); }
            @if (giftNotice != null)
            {
                <div class="jubo-content-block">
                    <div class="jubo-content-block-header block-header-GiftNotice">
                        <span style="font-size:1.2rem;">🎁</span>
                        <span>@giftNotice.BlockTitle</span>
                    </div>
                    <div class="jubo-content-block-body">@giftNotice.BlockContent</div>
                </div>
            }

            <div style="text-align:center; margin-top:1rem; padding-top:0.5rem;
                        border-top:2px dotted #FBCFE8; font-size:0.7rem; color:#FCA5A5; letter-spacing:1px;">
                🥚 @Model.JuboDate.ToString("yyyy.MM.dd") 부활절 주일학교 주보 · 할렐루야!
            </div>
        </div>
    </div>
</div>
