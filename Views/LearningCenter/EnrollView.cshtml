@model BulletinBoard.Models.OpicData

@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor


@{
    Layout = null;

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Quiz</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            color: #333;
        }

        header {
            background-color: #282c34;
            color: white;
            text-align: center;
            padding: 20px 0;
            font-size: 2.5rem;
            font-weight: bold;
        }

        .container {
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }

        input[type="text"], textarea {
            width: calc(100% - 20px);
            padding: 10px;
            margin: 0 auto;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 1rem;
            display: block;
        }

        textarea {
            resize: vertical;
            height: 100px;
        }

        .buttons {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

            .buttons button {
                padding: 10px 20px;
                border: none;
                border-radius: 5px;
                cursor: pointer;
                font-size: 1rem;
                color: white;
            }

        .save-button {
            background-color: #28a745;
        }

        .cancel-button {
            background-color: #dc3545;
        }

        footer {
            background-color: #282c34;
            color: white;
            text-align: center;
            padding: 10px 0;
            margin-top: 40px;
        }

        @@media (max-width: 768px) {
            header {
                font-size: 2rem;
            }

            input[type="text"], textarea {
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>

    <header>
       Edit English Interview 
    </header>


    <form asp-action="EnrollViewProcess" method="post" class="verse-form" style="padding: 5px;box-shadow: 0 0px 0px rgba(0, 0, 0, 0.2);">
        <div class="form-group">
            <label asp-for="PageNo"></label>
            <input type="text" id="PageNo" name="PageNo" asp-for="PageNo" class="form-control" placeholder=@Html.DisplayNameFor(model => model.PageNo)>
        </div>

        <div class="form-group">
            <label asp-for="Question"></label>
            <textarea id="Question" name="Question" asp-for="Question" class="form-control" rows="6" autofocus placeholder=@Html.DisplayNameFor(model => model.KeyWord1Desc)></textarea>
        </div>


        <div class="form-group">
            <label asp-for="KeyWord1"></label>
            <input type="text" id="KeyWord1" name="KeyWord1" asp-for="KeyWord1" class="form-control" placeholder=@Html.DisplayNameFor(model => model.KeyWord1)>
        </div>



        <div class="form-group">
            <label asp-for="KeyWord1Desc"></label>
            <textarea id="KeyWord1Desc" name="KeyWord1Desc" asp-for="KeyWord1Desc" class="form-control" rows="10" autofocus placeholder=@Html.DisplayNameFor(model => model.KeyWord1Desc)></textarea>
        </div>



        <div class="form-group">
            <label asp-for="KeyWord2"></label>
            <input type="text" id="KeyWord2" name="KeyWord2" asp-for="KeyWord2" class="form-control" placeholder=@Html.DisplayNameFor(model => model.KeyWord2)>
        </div>

        <div class="form-group">
            <label asp-for="KeyWord2Desc"></label>
            <textarea id="KeyWord2Desc" name="KeyWord2Desc" asp-for="KeyWord2Desc" class="form-control" rows="10" autofocus placeholder=@Html.DisplayNameFor(model => model.KeyWord2Desc)></textarea>
        </div>



        <div class="form-group">
            <label asp-for="KeyWord3"></label>
            <input type="text" id="KeyWord3" name="KeyWord3" asp-for="KeyWord3" class="form-control" placeholder=@Html.DisplayNameFor(model => model.KeyWord3)>
        </div>

        <div class="form-group">
            <label asp-for="KeyWord3Desc"></label>
            <textarea id="KeyWord3Desc" name="KeyWord3Desc" asp-for="KeyWord3Desc" class="form-control" rows="10" autofocus placeholder=@Html.DisplayNameFor(model => model.KeyWord3Desc)></textarea>
        </div>



        <div class="form-group">
            <label asp-for="KeyWord4"></label>
            <input type="text" id="KeyWord4" name="KeyWord4" asp-for="KeyWord4" class="form-control" placeholder=@Html.DisplayNameFor(model => model.KeyWord4)>
        </div>


        <div class="form-group">
            <label asp-for="KeyWord4Desc"></label>
            <textarea id="KeyWord4Desc" name="KeyWord4Desc" asp-for="KeyWord4Desc" class="form-control" rows="10" autofocus placeholder=@Html.DisplayNameFor(model => model.KeyWord4Desc)></textarea>
        </div>



        <div class="form-group">
            <label asp-for="Memo"></label>
            <textarea id="Memo" name="Memo" asp-for="Memo" class="form-control" rows="10" autofocus placeholder=@Html.DisplayNameFor(model => model.Memo)></textarea>
        </div>



        <div class="form-group">
            <label asp-for="BodyContents"></label>
            <textarea id="BodyContents" name="BodyContents" asp-for="BodyContents" class="form-control" rows="10" autofocus placeholder=@Html.DisplayNameFor(model => model.BodyContents)></textarea>
        </div>



        <div class="form-group">
            <label asp-for="Vocabulary"></label>
            <textarea id="Vocabulary" name="Vocabulary" asp-for="Vocabulary" class="form-control" rows="10" autofocus placeholder=@Html.DisplayNameFor(model => model.Vocabulary)></textarea>
        </div>
         
        <div class="buttons">
            <button class="save-button">Save</button>
            <button class="cancel-button">Cancel</button>
        </div>
    </form>


    <footer>
        &copy; 2024 Quiz Platform
    </footer>

</body>
</html>