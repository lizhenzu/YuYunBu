@model IEnumerable<BulletinBoard.Models.RepairHomePageDatas>

@{
    ViewData["Title"] = "List";
}

<style>

    .text-right {
        text-align: right;
    }

    .card-typeA-body {
        font-family: 'Arial', sans-serif;
        margin: 0;  
        display: flex;
        justify-content: center;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .card-typeA {
        background-color: white;
        width: 300px;
        margin: 3px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border-radius: 8px;
        overflow: hidden;
        transition: transform 0.2s;
    }

    .card-typeA:hover {
        transform: scale(1.05);
    }

    .card-typeA-content {
        padding: 5px;
    }

    .card-typeA-title {
        font-size: 20px;
        color: #333;
        margin-bottom: 5px;
    }

    .card-typeA-text {
        font-size: 16px;
        color: #666;
        line-height: 1.5;
    }
</style>

<div class="button-container-left">
    <a href="@Url.Action("/HelpDesk/Index")" class="btn btn-register pretty-button">등록</a>
</div>

<div class="card-typeA-body">
    @foreach (var item in Model)
    {
        <div class="card-typeA">
            <div class="card-typeA-content">
                <p class="card-typeA-text">제목 : @item.RequestContents </p>
                <p class="card-typeA-text">제목 : @item.InsertDT.ToString("yyyy-MM-dd") </p>
                <p class="card-typeA-text text-right">
                    @Html.ActionLink("수정", "ModifyWeeklyWordToRead", "HelpDesk", new { Id = item.Id}) |
                    @Html.ActionLink("삭제", "DeleteRepairHomePage", "HelpDesk", new { Id = item.Id})
                </p>
            </div>
        </div>
    }
</div> 