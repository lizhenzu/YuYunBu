@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@using System
@using System.Linq
@using System.Collections.Generic
@using BulletinBoard.Models   @* NoticeAttachment 네임스페이스가 다르면 여기만 맞춰주세요 *@
@model BulletinBoard.ViewModels.Notice.Notice

@{
    Layout = null;
    ViewData["Title"] = "공지 상세";

    // ✅ List로 캐스팅하지 말고 IEnumerable로 받기 (List/Array/IEnumerable 모두 안전)
    var attachments = (ViewBag.Attachments as IEnumerable<NoticeAttachment>)?.ToList() ?? new List<NoticeAttachment>();
    var author = !string.IsNullOrWhiteSpace(Model.AuthorName) ? Model.AuthorName : "관리자";

    string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int unit = 0;
        while (size >= 1024 && unit < units.Length - 1) { size /= 1024; unit++; }
        return unit == 0 ? $"{(long)size} {units[unit]}" : $"{size:0.#} {units[unit]}";
    }
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title - 공지사항</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* DailyMission4 밝은 흰색 버전 — 색은 직접 지정한다 */
        * { box-sizing: border-box; }
        html, body { margin: 0; }
        body { background: #FFFFFF; color: #374151; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: inherit; text-decoration: none; }
        .sh { max-width: 720px; margin: 0 auto; padding: 0 20px; }
        .hdTop { display: flex; justify-content: space-between; gap: 10px; padding: 12px 0 10px; border-bottom: 1px solid #EEF0F3; font-size: 12px; color: #9CA3AF; }
        .hdTop a { color: #374151; }
        .hdTop a:hover { color: #2F80ED; }
        .hdTop .sep { margin: 0 6px; color: #D1D5DB; }
        .hdK { margin-top: 18px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; font-variant-numeric: tabular-nums; }
        .hdT { margin: 6px 0 0; font-size: 24px; font-weight: 800; line-height: 1.35; letter-spacing: -.02em; color: #111827; word-break: keep-all; overflow-wrap: anywhere; }
        .hdS { margin-top: 6px; font-size: 12px; color: #9CA3AF; }
        .hdS b { font-weight: 700; color: #6B7280; }

        .tb { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 14px; }
        .tb form { margin: 0; display: contents; }
        .nbtn { font-family: inherit; font-size: 12.5px; font-weight: 700; padding: 8px 14px; border: 0; border-radius: 999px; background: #F4F6F9; color: #6B7280; cursor: pointer; }
        .nbtn:hover { color: #2F80ED; }
        .nbtn.dan { background: #FBEFE7; color: #B4531F; }
        .nbtn.dan:hover { background: #F7E3D5; color: #B4531F; }

        .pop { margin-top: 14px; padding: 10px 14px; border-radius: 12px; background: #EAF2FD; font-size: 13px; color: #2B5FA8; }
        .pop b { font-weight: 800; }

        .body { margin-top: 16px; padding-top: 18px; border-top: 1px solid #EEF0F3; }
        .ct { font-size: 15.5px; line-height: 1.9; color: #374151; word-break: keep-all; overflow-wrap: anywhere; }
        .ct :is(img, video, iframe) { max-width: 100%; height: auto; border-radius: 12px; }
        .ct a { color: #2F80ED; text-decoration: underline; }
        .ct p { margin: 0 0 1em; }

        .sec { margin-top: 26px; padding-top: 16px; border-top: 1px solid #EEF0F3; }
        .secH { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
        .secT { font-size: 16px; font-weight: 800; color: #111827; }
        .secN { font-size: 12px; color: #9CA3AF; }
        .empty { padding: 24px 0 8px; font-size: 13.5px; color: #9CA3AF; }
        .fl { list-style: none; margin: 6px 0 0; padding: 0; }
        .fl li { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 0; border-bottom: 1px solid #EEF0F3; font-size: 14px; }
        .fl li:last-child { border-bottom: 0; }
        .fl .n { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; color: #2F80ED; }
        .fl .n:hover { color: #1F6FDB; }
        .fl .s { flex: none; font-size: 12px; color: #9CA3AF; }

        .ft { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 24px; padding: 14px 0 40px; border-top: 1px solid #EEF0F3; font-size: 11.5px; color: #9CA3AF; }
        .ft a { color: #6B7280; }
        .ft a:hover { color: #2F80ED; }
    </style>
</head>
<body>
    <header class="sh">
        <div class="hdTop">
            <span><a href="@Url.Action("Index", "Home")">← @ConstatsCommon.ToHome</a><span class="sep">·</span><a href="@Url.Action("Index", "Notice")">공지사항</a></span>
            <span>No. @Model.Id</span>
        </div>
        <div class="hdK">@Model.CreatedAt.ToString("yyyy.MM.dd")</div>
        <h1 class="hdT">@Model.Title</h1>
        <div class="hdS"><b>@author</b><span class="sep"> · </span>조회 @Model.ViewCount.ToString("N0")</div>
        <div class="tb">
            <a class="nbtn" href="@Url.Action("Index", "Notice")">목록</a>
            <a class="nbtn" href="@Url.Action("Edit", "Notice", new { id = Model.Id })">수정</a>
            <form asp-controller="Notice" asp-action="Delete" method="post" onsubmit="return confirm('이 공지를 삭제하시겠습니까?');">
                <input name="id" type="hidden" value="@Model.Id" />
                <button type="submit" class="nbtn dan">삭제</button>
            </form>
        </div>
    </header>

    <main class="sh">
        @if (Model.IsPopup && Model.PopupUntil.HasValue)
        {
            <div class="pop">팝업 표시 기간 · <b>@Model.PopupUntil.Value.ToString("yyyy.MM.dd")</b> 까지</div>
        }

        <article class="body">
            <div class="ct">@Html.Raw((Model.Content ?? string.Empty).Replace("\n", "<br />"))</div>
        </article>

        <section class="sec">
            <div class="secH">
                <span class="secT">첨부파일</span>
                <span class="secN">@attachments.Count 개</span>
            </div>
            @if (attachments.Any())
            {
                <ul class="fl">
                    @foreach (var att in attachments)
                    {
                        <li>
                            <a class="n" href="@Url.Action("DownloadAttachment", "Notice", new { id = att.Id })" title="@att.OriginalName">@att.OriginalName</a>
                            <span class="s">@FormatBytes(att.FileSize)</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="empty">첨부파일이 없습니다.</div>
            }
        </section>

        <div class="ft">
            <a href="@Url.Action("Index", "Notice")">← 공지 목록</a>
            <a href="@Url.Action("Index", "Home")">@ConstatsCommon.ToHome</a>
        </div>
    </main>
</body>
</html>
