@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());

}


<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ChurchName · @DepartmentName</title>

    <style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: #F9F9F9;
    }

    .container2 {
        width: 98%;
        max-width: 600px; /* Optional: to limit the width on larger screens */
        background-color: white;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        border-radius: 10px;
        overflow: hidden;
        margin-top: 20px;
        padding: 20px;
    }

        .button {
            margin: 5px 0;
        }
        .container {
            width: 375px;
            background-color: white;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            border-radius: 10px;
            overflow: hidden;
            margin-top: 20px;
        }
    .header {
        text-align: center;
        padding: 20px;
        background-color: #4CAF50;
        color: white;
    }

    .header h1, .header h3, .header h4 {
        margin: 10px 0;
    }

    .buttons {
        display: flex;
        padding: 20px 0;
            flex-direction: column;
        margin-bottom: 5.5px;
    }

        .buttons2 {
            display: flex;
            justify-content: space-between;
            padding: 20px 0;
            margin: 3px;
            margin-bottom: 5.5px;
            gap: 7px;
        }

    .button {
        flex: 1;
        padding: 10px;
        margin-left: 5px;
            margin-right: 5px;
            text-align: center;
        border-radius: 5px;
        cursor: pointer;
        background-color: #E8E8FF;
    }

    .button.choice {
        background-color: #FFEB3B; /* Yellow */
    }

    .button.subjective {
        background-color: #2196F3; /* Blue */
        color: white;
    }

    .button.back {
                background-color: #E8E8FF;
        color: black;
    }

    .button.main {
        background-color: #4CAF50; /* Green */
        color: white;
    }

    .button.home {
        background-color: #00BCD4; /* Cyan */
        color: white;
    }

    .error {
        color: red;
        font-size: 0.9em;
        margin-top: 5px;
    }

    @@media (max-width: 600px) {     

        .button {
            margin: 5px 0;
        }
    }
</style>

</head>
<body>
    <div class="container">
        <div class="header">
            <h1>퀴즈 등록</h1>
            <h3>퀴즈 등록 방법 선택</h3>
            <h4>출제일자 : @ViewBag.WhenDate</h4>
        </div>
        <div class="buttons">
            <div class="button choice" onclick="location.href='/Question/BranchQuestionType?WhenDate=@ViewBag.WhenDate'">퀴즈 새로 등록하기</div>
            <div class="button subjective" onclick="location.href='/Question/FromTemplate?WhenDate=@ViewBag.WhenDate'">퀴즈뱅크에서 퀴즈 가져오기</div>
        </div>
        <div class="buttons2">
            <div class="button back" onclick="history.back()">이전</div>
            <div class="button main" onclick="location.href='/Question/Index'">퀴즈메인</div>
            <div class="button home" onclick="location.href='/'">Home</div>
        </div>
    </div>
</body>
</html>