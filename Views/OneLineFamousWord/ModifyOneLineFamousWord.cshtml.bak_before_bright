@model BulletinBoard.Models.OneLineFamousWords
@{
    Layout = null;
    string TitleKey = "명구 수정";
}



<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@TitleKey</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: #F9F9F9;
        }

        .container2 {
            width: 98%;
            max-width: 600px; /* Optional: to limit the width on larger screens */
            background-color: white;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            border-radius: 10px;
            overflow: hidden;
            margin-top: 20px;
            padding: 20px;
        }

        .container {
            width: 375px;
            background-color: white;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            border-radius: 10px;
            overflow: hidden;
            margin-top: 20px;
        }

        .header {
            text-align: center;
            padding: 20px;
            background-color: #4CAF50;
            color: white;
        }

            .header h1, .header h3, .header h4 {
                margin: 10px 0;
            }

        .form-group {
            margin-bottom: 15px;
        }

            .form-group label {
                display: block;
                margin-bottom: 5px;
            }

            .form-group input[type="text"], .form-group textarea {
                width: 100%;
                padding: 10px;
                border: 1px solid #ccc;
                border-radius: 5px;
            }

            .form-group textarea {
                height: 100px;
            }

            .form-group .radio-group {
                display: flex;
                justify-content: space-around;
                margin-top: 10px;
            }

                .form-group .radio-group label {
                    display: flex;
                    align-items: center;
                }

        .buttons {
            display: flex;
            padding: 20px 0;
            flex-direction: column;
            margin-bottom: 5.5px;
        }

        .button {
            flex: 1;
            padding: 10px;
            margin: 5px;
            text-align: center;
            border-radius: 5px;
            cursor: pointer;
            background-color: #E8E8FF;
        }

        .buttons2 {
            display: flex;
            justify-content: space-between;
            padding: 20px 0;
            margin: 3px;
            margin-bottom: 5.5px;
            gap: 7px;
        }



        .button.enroll {
            background-color: #00C853;
            color: white;
        }

        .button.back {
            background-color: #E8E8FF;
            color: black;
        }

        .button.main {
            background-color: #4CAF50; /* Green */
            color: white;
        }

        .button.home {
            background-color: #00BCD4; /* Cyan */
            color: white;
        }

        .error {
            color: red;
            font-size: 0.9em;
            margin-top: 5px;
        }

        .form-group {
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

            .form-group label {
                width: 100%;
                text-align: left; /* Maintain original left alignment for labels */
                margin-bottom: 5px;
            }

            .form-group textarea, .form-group input[type="text"] {
                width: 96%;
                padding: 10px;
                border: 1px solid #ccc;
                border-radius: 5px;
                box-sizing: border-box;
                display: block;
                margin: auto; /* Center align the text area and input elements */
            }

            .form-group .radio-group {
                display: flex;
                justify-content: space-around; /* Ensure space between radio buttons */
                margin-top: 10px;
                align-items: center;
                width: 100%; /* Ensure the radio buttons span the full width */
            }

                .form-group .radio-group label {
                    display: flex;
                    align-items: center;
                    margin-right: 10px; /* Add margin to space out radio buttons */
                }

        @@media (max-width: 600px) {
            .buttons2 {
            }

            .button {
                margin: 5px 0;
            }
        }

    </style>


</head>

<body>
    <div class="container">
        <div class="header">
            <h1>@TitleKey</h1>
            <h4>이전 수정일자 : @Model.updateDT.ToString("yyyy-MM-dd")</h4>

        </div>
        <form asp-action="ModifyOneLineFamousWordProcess" method="post">


            <div class="form-group">
                <label asp-for="OneLineText"></label>
                <textarea id="OneLineText" name="OneLineText" asp-for="OneLineText" class="form-control" rows="30" autofocus></textarea>
                <span asp-validation-for="OneLineText" class="text-danger"></span>
            </div>

            

            <div class="buttons">

                <button type="submit" class="button enroll">@TitleKey</button>

            </div>
            <div class="buttons2"> 
                <div class="button main" onclick="location.href='/OneLineFamousWord/Index'">명구 Home</div>
                <div class="button home" onclick="location.href='/'">Home</div>
            </div>
            <input type="hidden" id="Id" name="Id" value="@Model.Id" />
        </form>
    </div>

    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>