@model BulletinBoard.Models.OpicData

<style>
 

    .button {
        margin: 5px 0;
    }

  

    .header {
        text-align: center;
        padding: 20px;
        background-color: #4CAF50;
        color: white;
    }

        .header h1, .header h3, .header h4 {
            margin: 10px 0;
        }

    .buttons {
        display: flex;
        padding: 20px 0;
        flex-direction: column;
        margin-bottom: 5.5px;
    }

    .buttons2 {
        display: flex;
        justify-content: space-between;
        padding: 20px 0;
        margin: 3px;
        margin-bottom: 5.5px;
        gap: 7px;
    }

    .button {
        flex: 1;
        padding: 10px;
        margin-left: 5px;
        margin-right: 5px;
        text-align: center;
        border-radius: 5px;
        cursor: pointer;
        background-color: #E8E8FF;
    }

        .button.choice {
            background-color: #FFEB3B; /* Yellow */
        }

        .button.subjective {
            background-color: #2196F3; /* Blue */
            color: white;
        }

        .button.back {
            background-color: #E8E8FF;
            color: black;
        }

        .button.main {
            background-color: #4CAF50; /* Green */
            color: white;
        }

        .button.home {
            background-color: #00BCD4; /* Cyan */
            color: white;
        }

    .error {
        color: red;
        font-size: 0.9em;
        margin-top: 5px;
    }

    @@media (max-width: 600px) {

        .button {
            margin: 5px 0;
        }
    }
</style>


<form asp-action="ModifyProcess" method="post" class="verse-form" style="padding: 5px;box-shadow: 0 0px 0px rgba(0, 0, 0, 0.2);">

    <div class="card-header-middle" style="background-color: white; color:black;">
        <h2>CNN 수정</h2>
    </div>

    <div class="form-header">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

@*    <div class="form-group">
        <label asp-for="PageNo"></label>
        <input asp-for="PageNo" class="Reciteonly-field" style="width: 100%;" />
        <span asp-validation-for="PageNo" class="text-danger"></span>
    </div>
 *@

    <div class="form-group">
        <label asp-for="Question"></label>
        <textarea id="Question" name="Question" asp-for="Question" class="form-control" rows="6" autofocus></textarea>
        <span asp-validation-for="Question" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="BodyContents"></label>
        <textarea id="BodyContents" name="BodyContents" asp-for="BodyContents" class="form-control" rows="12" autofocus></textarea>
        <span asp-validation-for="BodyContents" class="text-danger"></span>
    </div>

        <div class="form-group">
        <label asp-for="Vocabulary"></label>
        <textarea id="Vocabulary" name="Vocabulary" asp-for="Vocabulary" class="form-control" rows="12" autofocus></textarea>
        <span asp-validation-for="Vocabulary" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Memo"></label>
        <textarea id="Memo" name="Memo" asp-for="Memo" class="form-control" rows="12" autofocus></textarea>
        <span asp-validation-for="Memo" class="text-danger"></span>
    </div>


    <input type="hidden" id="Id" name="Id" value="@Model.Id" />
    <input type="hidden" id="PageNo" name="PageNo" value="@Model.PageNo" />
    <div class="form-group">
        <button type="submit" class="btn-submit">제출</button>
    </div>

    <div class="form-group">
        <a href="/Opic/DetailList?Kind=@ViewBag.Kind'" class="btn btn-submit">목록</a>
    </div>
    <div class="form-group">
        <a href="/" class="btn btn-submit">Home</a>
    </div>
</form>
 
 
 
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial") 
}



