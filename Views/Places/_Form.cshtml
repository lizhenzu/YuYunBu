@using BulletinBoard.Models

@model PlaceItemInput

<div class="form">
    <div class="row">
        <label>카테고리</label>
        <select asp-for="Category">
            @foreach (var c in CategoryOptions.All)
            {
                <option value="@c" selected="@(Model.Category==c)">@c</option>
            }
        </select>
        <span asp-validation-for="Category" class="err"></span>
    </div>
    <div class="row">
        <label>이름</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="err"></span>
    </div>
    <div class="row">
        <label>외부 링크(URL)</label>
        <input asp-for="ExternalUrl" placeholder="https://place.map.kakao.com/1056071624" />
        <span asp-validation-for="ExternalUrl" class="err"></span>
    </div>
    <div class="row">
        <label>주소</label>
        <input asp-for="Address" />
    </div>
    <div class="row">
        <label>태그</label>
        <input asp-for="Tags" placeholder="예: 가성비, 분위기" />
    </div>
    <div class="row">
        <label>썸네일 URL</label>
        <input asp-for="ThumbnailUrl" placeholder="(선택) 직접 썸네일 이미지 URL" />
    </div>
    <div class="row">
        <label>사용</label>
        <input asp-for="IsActive" type="checkbox" />
    </div>
</div>

<style>
    .form {
        display: grid;
        gap: 12px
    }

    .row {
        display: grid;
        gap: 6px
    }

    input, select {
        background: #0f1322;
        color: #e7e9f1;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 10px;
        padding: 10px 12px
    }

    label {
        font-size: 13px;
        color: #9aa3b2
    }

    .err {
        color: #ff8a8a;
        font-size: 12px
    }
</style>
