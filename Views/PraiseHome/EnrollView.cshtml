@model BulletinBoard.Models.PraiseContent

<form asp-action="EnrollViewProcess" method="post" class="verse-form">

    <div class="card-header-middle">
        <h2>찬양등록</h2> 
    </div>

    <div class="form-header">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

    @await Html.PartialAsync("_EnrollPraisePartial",Model)

    <div class="form-group">
        <button type="submit" class="btn-submit">제출</button>
    </div>
    <div class="form-group">
        <a href="@Url.Action("Index")" class="btn btn-submit">목록</a>
    </div>
</form>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial") 
}
