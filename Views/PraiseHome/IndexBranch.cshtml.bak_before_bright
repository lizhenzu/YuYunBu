@using BulletinBoard.Enums
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService

@{
    Layout = "_Layout_Mission";
    string keyWordTitle = "찬양";

    // ✅ 이동 URL (요청하신 값 그대로)
    var urlConti = "/PraiseHome/IndexQuery?kind=conti";
    var urlBlessing = "/PraiseHome/IndexQuery?kind=blessing";
    var urlHymn = "/PraiseHome/IndexQuery?kind=hymn";
    var urlCcm = "/PraiseHome/IndexQuery?kind=ccm";

    // ✅ 홈 URL (원하시면 Url.Action으로 교체 가능)
    var urlHome = "/";
}

<link rel="stylesheet" href="/css/missionCommon.css">
<link rel="stylesheet" href="/css/common.layer.css">

<style>
    :root {
        --bg1: #f7fbff;
        --bg2: #fff7fb;
        --bg3: #f7fff7;
        --line: rgba(15, 23, 42, .10);
        --ink: #0b1220;
        --muted: rgba(11,18,32,.60);
        --shadow: 0 20px 60px rgba(15, 23, 42, .12);
        --shadow2: 0 10px 24px rgba(15, 23, 42, .10);
        --mint: #26d7a7;
        --sky: #56b6ff;
        --rose: #ff7cc7;
        --sun: #ffd166;
        --focus: 0 0 0 4px rgba(86,182,255,.25);
    }

    /* ✅ 페이지 바탕 + 화면 가운데 정렬 */
    body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center; /* 세로 가운데 */
        justify-content: center; /* 가로 가운데 */
        padding: 20px 12px;
        color: var(--ink);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", Arial, sans-serif;
        background: radial-gradient(1200px 700px at 10% 10%, rgba(86,182,255,.20), transparent 60%), radial-gradient(900px 600px at 90% 15%, rgba(255,124,199,.18), transparent 55%), radial-gradient(900px 650px at 40% 90%, rgba(38,215,167,.18), transparent 55%), linear-gradient(135deg, var(--bg1), var(--bg2) 45%, var(--bg3));
    }

    /* ✅ pz-wrap을 column 컨테이너로 만들어 "아래로 쌓이게" */
    .pz-wrap {
        width: min(980px, 100%);
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* 히어로 */
    .pz-hero {
        position: relative;
        border-radius: 28px;
        padding: 22px 18px 18px;
        background: linear-gradient(135deg, rgba(255,255,255,.80), rgba(255,255,255,.65));
        border: 1px solid var(--line);
        box-shadow: var(--shadow);
        backdrop-filter: blur(12px);
        overflow: hidden;
    }

        .pz-hero::before {
            content: "";
            position: absolute;
            inset: -120px -120px auto auto;
            width: 280px;
            height: 280px;
            background: radial-gradient(circle at 30% 30%, rgba(255,124,199,.40), transparent 60%);
            transform: rotate(18deg);
            pointer-events: none;
        }

        .pz-hero::after {
            content: "";
            position: absolute;
            inset: auto auto -140px -140px;
            width: 320px;
            height: 320px;
            background: radial-gradient(circle at 60% 40%, rgba(38,215,167,.35), transparent 62%);
            transform: rotate(-12deg);
            pointer-events: none;
        }

    .pz-top {
        display: flex;
        gap: 14px;
        align-items: center;
        justify-content: space-between;
        position: relative;
        z-index: 2;
        flex-wrap: wrap;
    }

    .pz-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        background: rgba(255,255,255,.85);
        border: 1px solid var(--line);
        border-radius: 999px;
        box-shadow: var(--shadow2);
        user-select: none;
    }

    .pz-logo {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, rgba(86,182,255,.95), rgba(38,215,167,.95));
        color: white;
        font-weight: 800;
        letter-spacing: -0.5px;
        box-shadow: 0 10px 18px rgba(86,182,255,.18);
    }

    .pz-titlebox {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
    }

    .pz-title {
        font-size: 20px;
        font-weight: 900;
        letter-spacing: -0.6px;
    }

    .pz-sub {
        font-size: 13px;
        color: var(--muted);
        margin-top: 2px;
    }

    /* 카드 그리드 */
    .pz-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    @@media (max-width: 740px) {
        .pz-grid {
            grid-template-columns: 1fr;
        }

        .pz-title {
            font-size: 18px;
        }
    }

    /* 카드 버튼 */
    .pz-card {
        appearance: none;
        border: 1px solid rgba(15,23,42,.10);
        background: linear-gradient(180deg, rgba(255,255,255,.90), rgba(255,255,255,.72));
        border-radius: 22px;
        box-shadow: 0 16px 46px rgba(15,23,42,.12);
        padding: 14px;
        cursor: pointer;
        text-align: left;
        display: flex;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
        transition: transform .16s ease, box-shadow .16s ease;
        backdrop-filter: blur(10px);
        position: relative;
        overflow: hidden;
    }

        .pz-card:focus {
            outline: none;
            box-shadow: var(--shadow), var(--focus);
        }

        .pz-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 24px 70px rgba(15,23,42,.16);
        }

        .pz-card::before {
            content: "";
            position: absolute;
            inset: 0;
            opacity: .18;
            pointer-events: none;
            background: radial-gradient(500px 200px at 15% 15%, rgba(255,255,255,.95), transparent 60%);
        }

    /* 왼쪽 아이콘 */
    .pz-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .pz-ico {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,.55);
        background: rgba(255,255,255,.60);
        box-shadow: 0 12px 22px rgba(15,23,42,.10);
        overflow: hidden;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
    }

        .pz-ico img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .pz-text {
        min-width: 0;
    }

    .pz-k {
        font-size: 12px;
        color: rgba(11,18,32,.58);
        font-weight: 800;
        letter-spacing: -0.2px;
        margin-bottom: 2px;
    }

    .pz-action {
        font-size: 16px;
        font-weight: 900;
        letter-spacing: -0.4px;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pz-desc {
        margin-top: 4px;
        font-size: 12px;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* 오른쪽 화살표 */
    .pz-go {
        width: 44px;
        height: 44px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.65);
        background: rgba(255,255,255,.70);
        box-shadow: 0 10px 18px rgba(15,23,42,.10);
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        transition: transform .16s ease;
        position: relative;
        overflow: hidden;
    }

        .pz-go::before {
            content: "";
            position: absolute;
            inset: 0;
            opacity: .35;
            background: radial-gradient(circle at 30% 30%, rgba(86,182,255,.55), transparent 62%);
            pointer-events: none;
        }

    .pz-card:hover .pz-go {
        transform: rotate(-8deg) scale(1.05);
    }

    .pz-arrow {
        width: 18px;
        height: 18px;
        border-right: 3px solid rgba(11,18,32,.55);
        border-bottom: 3px solid rgba(11,18,32,.55);
        transform: rotate(-45deg);
        margin-left: -2px;
    }

    /* 카드별 포인트 */
    .pz-card.mint {
        border-color: rgba(38,215,167,.35);
    }

    .pz-card.sun {
        border-color: rgba(255,209,102,.40);
    }

    .pz-card.sky {
        border-color: rgba(86,182,255,.40);
    }

    .pz-card.rose {
        border-color: rgba(255,124,199,.38);
    }

    /* ✅ 홈으로 가기 (pz-wrap "아래"에 위치하도록 wrap 안에 넣을 것) */
    .pz-home {
        display: flex;
        justify-content: center;
    }

    .pz-home-btn {
        appearance: none;
        border: 1px solid rgba(15,23,42,.12);
        background: linear-gradient(135deg, rgba(86,182,255,.22), rgba(38,215,167,.18));
        color: var(--ink);
        border-radius: 999px;
        padding: 12px 16px;
        font-weight: 900;
        letter-spacing: -0.3px;
        cursor: pointer;
        box-shadow: var(--shadow2);
        transition: transform .16s ease, box-shadow .16s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .pz-home-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        .pz-home-btn:focus {
            outline: none;
            box-shadow: var(--shadow), var(--focus);
        }

    .pz-home-ico {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        background: rgba(255,255,255,.78);
        border: 1px solid rgba(255,255,255,.65);
        display: grid;
        place-items: center;
        box-shadow: 0 10px 18px rgba(15,23,42,.08);
    }
</style>

<div class="pz-wrap">
    <!-- ✅ HERO -->
    <section class="pz-hero" aria-label="찬양 메인">
        <div class="pz-top">
            <div class="pz-badge">
                <div class="pz-logo">♪</div>
                <div class="pz-titlebox">
                    <div class="pz-title">오늘도 기쁨으로 찬양해요 🎶</div>
                    <div class="pz-sub">주일학교 · 유년부 친구들과 함께 듣는 찬양 모음</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ✅ MENU CARDS -->
    <section class="pz-grid" aria-label="찬양 메뉴">
        <button type="button" class="pz-card mint" onclick="go('@urlConti')">
            <div class="pz-left">
                <div class="pz-ico">
                    <img src="/images/ICON/praise/praise_01.webp" alt="찬양" loading="lazy" />
                </div>
                <div class="pz-text">
                    <div class="pz-k">찬양</div>
                    <h3 class="pz-action">찬양(주일학교) 듣기</h3>
                    <div class="pz-desc">신나는 율동 · 함께 부르는 찬양</div>
                </div>
            </div>
            <div class="pz-go" aria-hidden="true"><div class="pz-arrow"></div></div>
        </button>

        <button type="button" class="pz-card sun" onclick="go('@urlBlessing')">
            <div class="pz-left">
                <div class="pz-ico">
                    <img src="/images/ICON/praise/praise_02.webp" alt="축복송" loading="lazy" />
                </div>
                <div class="pz-text">
                    <div class="pz-k">축복송</div>
                    <h3 class="pz-action">축복송(주일학교) 듣기</h3>
                    <div class="pz-desc">서로를 축복하며 마음을 따뜻하게</div>
                </div>
            </div>
            <div class="pz-go" aria-hidden="true"><div class="pz-arrow"></div></div>
        </button>

        <button type="button" class="pz-card sky" onclick="go('@urlHymn')">
            <div class="pz-left">
                <div class="pz-ico">
                    <img src="/images/ICON/praise/praise_03.webp" alt="찬송가" loading="lazy" />
                </div>
                <div class="pz-text">
                    <div class="pz-k">찬송가</div>
                    <h3 class="pz-action">찬송가 듣기</h3>
                    <div class="pz-desc">은혜로운 가사 · 찬송의 고백</div>
                </div>
            </div>
            <div class="pz-go" aria-hidden="true"><div class="pz-arrow"></div></div>
        </button>

        <button type="button" class="pz-card rose" onclick="go('@urlCcm')">
            <div class="pz-left">
                <div class="pz-ico">
                    <img src="/images/ICON/praise/praise_04.webp" alt="CCM" loading="lazy" />
                </div>
                <div class="pz-text">
                    <div class="pz-k">CCM</div>
                    <h3 class="pz-action">CCM 듣기</h3>
                    <div class="pz-desc">요즘 감성 · 밝고 은혜로운 CCM</div>
                </div>
            </div>
            <div class="pz-go" aria-hidden="true"><div class="pz-arrow"></div></div>
        </button>
    </section>

    <!-- ✅ HOME 버튼: pz-wrap "아래 가운데" -->
    <div class="pz-home">
        <button type="button" class="pz-home-btn" onclick="go('@urlHome')">
            <span class="pz-home-ico">🏠</span>
            홈으로 가기
        </button>
    </div>
</div>

<script>
    function go(url) {
        window.location.href = url;
    }
</script>
