@using BulletinBoard.Common;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@inject IAuthService AuthService

@{
    Layout = "_Layout_Mission";
    string keyWordTitle = "기도";
}
@{
    var todayDate = DateHelper.GetTodayDateDayString();

    // 문자열을 생성합니다.
    string formattedModResultData = $"pray_{todayDate}.webp";

}
<link rel="stylesheet" href="/css/missionCommon.css">
<link rel="stylesheet" href="/css/missionC.css">
<link rel="stylesheet" href="/css/common.layer.css">
<style>
    body {
        background-size: cover;
        margin: 0;
        padding: 0;
        color: #333;
        display: flex;
    }

</style>

<style>
    .icon-container {
        margin-top: 40px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-background {
        background: white;
        width: 65px;
        height: 65px;
        position: absolute;
        top: -36px;
        left: 50%;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        border-radius: 50%;
        transform: translateX(-35px);
        z-index: 1; /* Behind the icon but in front of card background */
    }

    .icon-foreground {
        background: #0d792d;
        width: 59px;
        height: 59px;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        border-radius: 50%;
        position: absolute;
        top: -33px;
        left: 50%;
        transform: translateX(-32px);
        z-index: 3; /* Above all */
    }

    .button-hyperlink {
        border: none;
        color: white;
        text-align: center;
        text-decoration: none;
        display: block; /* Makes the button expand to the width of the container */
        font-size: 18px;
        margin: 10px 0; /* Adds space between buttons */
        cursor: pointer;
    }
</style>

<style>

    .image-container {
        border: 3.5px solid #ffffff;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
        width: 100%; /* 컨테이너의 너비에 맞춥니다 */
        height: auto; /* 이미지의 비율에 따라 높이 조정 */
        display: block; /* 이미지를 블록 요소로 만듭니다 */
        align-items: center;
        justify-content: center;
        margin: auto; /* 자동 마진을 사용하여 중앙 정렬 */
        margin-bottom: 10px; /* 자동 마진을 사용하여 중앙 정렬 */
        max-width: 800px;
    }
</style>

<style>
    .local-new-body {
        font-family: Arial, sans-serif;
        padding: 20px;
        background: #f0f0f0;
    }

    .button {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px;
        margin-bottom: 10px;
        color: white;
        border-radius: 10px;
        font-size: 16px;
        position: relative;
        transition: transform 0.3s ease;
    }

        .button:hover {
            transform: scale(1.05);
        }

    .icon {
        font-size: 24px;
        width: 70px;
        height: 70px;
        border: 3px solid #ffffff;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        border-radius: 35px;
    }

    .circle {
        width: 40px;
        height: 40px;
        background-color: white;
        border-radius: 50%;
        color: #333;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 3px 3px 5px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
        cursor: pointer;
        background: url('/images/ICON/Arrow/toGo2.webp') no-repeat center center; /* 이미지 경로 수정 필요 */
        background-size: contain; /* 이미지가 원 안에 맞게 조절됩니다 */
    }

    .circle2 {
        width: 40px;
        height: 40px;
        background-color: white;
        border-radius: 50%;
        color: #333;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 3px 3px 5px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
        cursor: pointer;
        background: url('/images/ICON/smile/toGoSmile001.webp') no-repeat center center; /* 이미지 경로 수정 필요 */
        background-size: contain; /* 이미지가 원 안에 맞게 조절됩니다 */
    }

    .circleCompleted {
        width: 60px;
        height: 60px;
        background-color: white;
        border-radius: 50%;
        color: #333;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 3px 3px 5px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
        cursor: pointer;
        background: url('/images/ICON/stamp/completed-stamp.png') no-repeat center center; /* 이미지 경로 수정 필요 */
        background-size: contain; /* 이미지가 원 안에 맞게 조절됩니다 */
        z-index: 100;
    }


    .circle:hover {
        box-shadow: 0 0 20px rgba(0, 123, 255, 0.8);
        transform: rotate(90deg);
    }
     
</style>

 <link rel="stylesheet" href="/css/color.css">

<div class="container" style="max-width: 600px;">
    <div class="icon-container">
        <div class="icon-background"></div>
        <div class="icon-foreground">
            <span class="material-icons">@keyWordTitle</span>
        </div>
    </div>
    <div class="image-container">
        <img src="/images/pray/@formattedModResultData" alt="Descriptive Alt Text" style="width: 100%; height: auto;">
    </div>
    @await Html.PartialAsync("_Publish_AdminContents", new AdminPanelContents() { KeyText = "중보기도"     , BackGroundColor = "color_AquaMarine" , RepreImage = "/images/ICON/pray/toGoPary001.webp", ActionText ="중보기도" , ActionURL = "/PrayFriends/PrayFriend"})
    @await Html.PartialAsync("_Publish_AdminContents", new AdminPanelContents() { KeyText = "교재기도"     , BackGroundColor = "color_Yellow" , RepreImage = "/images/ICON/pray/toGoPary002.webp", ActionText ="기도교재(Book)기반 기도" , ActionURL = "/PrayHome/Index"})

    @await Html.PartialAsync("_Publish_MissionBar_GoMainHome")

</div>


<script>
    function redirectToPage(URL) {
        window.location.href = URL;
    }
</script>


 