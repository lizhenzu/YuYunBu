@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@*  ══════════════════════════════════════════════════════════════
    예배 콘텐츠 — 2026-10-04 시안 확정 (DailyMission4 밝은 흰색 · 번호 목록, 기도홈 · 주일공과와 같은 결)
    이전 화면(색 카드 3개 · 이모지)은 Branch.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());

    // 버튼 3개 (주소 그대로)
    var urlPraise = "/PraiseHome/IndexBranch";          // 찬양
    var urlPray   = "/PrayHome/Index";                  // 기도
    var urlSermon = "/RhapsodyOfReality/DetailWords";   // 설교

    // 아래 네 가지는 /PrayHome/Index 로 옮겨져 이 화면에서는 사용하지 않습니다.
    //   · 내 반 · 동역교사 기도 /PrayHome/coClass
    //   · 중보기도              /PrayHome/Intercessory
    //   · 오늘하루 다짐 기도    /Prayer/Index
    //   · 치유와 회복 기도문    /HealingAndRestorationPray/Index
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>예배 콘텐츠</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        :root { --blue: #2F80ED; --soft: #EAF2FD; --ink: #111827; --tx: #374151; --dim: #9CA3AF; --dim2: #6B7280; --line: #EEF0F3; --grey: #F4F6F9; }
        body { margin: 0; background: #FFFFFF; color: var(--tx); font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-text-size-adjust: 100%; }
        a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }
        .sh { max-width: 760px; margin: 0 auto; padding: 0 16px 36px; }

        .hdTop { display: flex; justify-content: space-between; align-items: center; padding: 14px 0 12px; border-bottom: 1px solid var(--line); font-size: 13px; color: var(--dim2); }
        .hdTop a { font-weight: 700; color: var(--tx); }
        .hdTop a:hover { color: var(--blue); }
        .hdTop .sep { margin: 0 6px; color: #D1D5DB; }
        .hdTop > span:last-child { color: var(--dim); letter-spacing: .04em; }
        .hdK { margin-top: 20px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: var(--blue); }
        .hdT { margin: 6px 0 0; font-size: 24px; font-weight: 800; letter-spacing: -.02em; color: var(--ink); }
        .hdS { margin-top: 4px; font-size: 13px; color: var(--dim2); }

        .sec { margin-top: 22px; padding-top: 14px; border-top: 1px solid var(--line); font-size: 16px; font-weight: 800; color: var(--ink); }
        .row { display: flex; align-items: center; gap: 12px; padding: 14px 2px; border-bottom: 1px solid var(--line); }
        .row:last-of-type { border-bottom: 0; }
        .row .n { flex: none; width: 28px; font-size: 16px; font-weight: 800; color: #7FA3DB; }
        .row .t { flex: 1; min-width: 0; }
        .row .t b { display: block; font-size: 16px; font-weight: 800; color: var(--ink); transition: color .15s; }
        .row .t small { display: block; margin-top: 1px; font-size: 12.5px; color: var(--dim2); }
        .row .tags { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; }
        .row .tags span { font-size: 11px; font-weight: 700; color: var(--dim2); background: var(--grey); border-radius: 999px; padding: 2px 8px; }
        .row .g { flex: none; font-size: 18px; font-weight: 300; color: #7FA3DB; }
        .row:hover .t b, .row:hover .g { color: var(--blue); }

        .ft { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; margin-top: 20px; padding-top: 14px; border-top: 1px solid var(--line); font-size: 11.5px; color: var(--dim); }
        .ft a { color: var(--dim2); font-weight: 700; }
        .ft a:hover { color: var(--blue); }
    </style>
</head>
<body>
<div class="sh">

    <div class="hdTop">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span>예배 콘텐츠</span>
        <span>WORSHIP</span>
    </div>
    <div class="hdK">WORSHIP</div>
    <h1 class="hdT">예배 콘텐츠</h1>
    <div class="hdS">찬양 · 기도 · 설교를 한 곳에서 편하게 시작해요</div>

    <div class="sec">무엇을 할까요</div>

    <a class="row" href="@urlPraise">
        <span class="n">01</span>
        <span class="t"><b>찬양</b><small>하나님께 마음을 올려드리는 찬양</small><span class="tags"><span>콘티</span><span>CCM</span><span>찬송</span></span></span>
        <span class="g">›</span>
    </a>
    <a class="row" href="@urlPray">
        <span class="n">02</span>
        <span class="t"><b>기도</b><small>자녀 · 부부 · 치유 · 수험생 · 중보기도</small><span class="tags"><span>기도홈</span></span></span>
        <span class="g">›</span>
    </a>
    <a class="row" href="@urlSermon">
        <span class="n">03</span>
        <span class="t"><b>설교</b><small>말씀으로 하루를 세우고 믿음을 단단히</small><span class="tags"><span>말씀 묵상</span></span></span>
        <span class="g">›</span>
    </a>

    <div class="ft">
        <span>@ChurchName · @DepartmentName</span>
        <a href="/">@ConstatsCommon.ToHome</a>
    </div>

</div>
</body>
</html>
