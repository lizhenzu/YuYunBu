@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}

@{
    Layout = null;

    // ✅ 버튼 3개 (요청하신 주소 그대로)
    var urlPraise = "/PraiseHome/IndexBranch"; // 찬양
    var urlPray = "/PrayHome/Index";         // 기도
    var urlSermon = "/RhapsodyOfReality/DetailWords"; // 설교(외부)

    // 아래 네 가지는 /PrayHome/Index 로 옮겨져 이 화면에서는 사용하지 않습니다.
    //   · 내 반 · 동역교사 기도 /PrayHome/coClass
    //   · 중보기도              /PrayHome/Intercessory
    //   · 오늘하루 다짐 기도    /Prayer/Index
    //   · 치유와 회복 기도문    /HealingAndRestorationPray/Index
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>예배 콘텐츠</title>

    <style>
        /* =========================================================
                   BRIGHT THEME – Worship Hub (3 Buttons)
                   - 밝은 파스텔 + 글라스 + 또렷한 텍스트
                   ========================================================= */

        :root {
            --bg0: #ffffff;
            --bg1: #f7fbff;
            --bg2: #fff7fb;
            --bg3: #f7fff7;
            --card: rgba(255,255,255,.84);
            --card2: rgba(255,255,255,.95);
            --stroke: rgba(2, 6, 23, .08);
            --ink: #0b1220;
            --muted: rgba(11,18,32,.62);
            --blue1: #2563eb;
            --blue2: #60a5fa;
            --pink1: #ec4899;
            --pink2: #fda4af;
            --green1: #16a34a;
            --green2: #86efac;
            --shadow1: 0 18px 50px rgba(2, 6, 23, .08);
            --shadow2: 0 10px 28px rgba(2, 6, 23, .10);
            --r18: 18px;
            --r22: 22px;
            --r28: 28px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
            color: var(--ink);
            background: radial-gradient(900px 600px at 12% 10%, rgba(37,99,235,.12), transparent 60%), radial-gradient(900px 600px at 92% 14%, rgba(236,72,153,.10), transparent 60%), radial-gradient(900px 600px at 50% 115%, rgba(22,163,74,.10), transparent 60%), linear-gradient(180deg, var(--bg1), var(--bg2));
            min-height: 100vh;
        }

        .wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 22px 16px;
        }

        .shell {
            width: 100%;
            max-width: 880px;
        }

        /* 헤더 */
        .hero {
            position: relative;
            border-radius: var(--r28);
            padding: 18px 18px 14px;
            background: linear-gradient(135deg, rgba(255,255,255,.72), rgba(255,255,255,.92));
            border: 1px solid var(--stroke);
            box-shadow: var(--shadow1);
            overflow: hidden;
        }

            .hero::before {
                content: "";
                position: absolute;
                inset: -2px;
                background: radial-gradient(520px 260px at 0% 0%, rgba(37,99,235,.18), transparent 62%), radial-gradient(520px 260px at 100% 0%, rgba(236,72,153,.14), transparent 62%), radial-gradient(520px 260px at 60% 120%, rgba(22,163,74,.12), transparent 62%);
                pointer-events: none;
                opacity: .95;
            }

        .heroInner {
            position: relative;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 12px;
        }

        .title {
            font-size: 22px;
            font-weight: 950;
            letter-spacing: -.3px;
            line-height: 1.15;
            margin: 0;
        }

        .subtitle {
            margin-top: 8px;
            color: var(--muted);
            font-size: 13.5px;
            font-weight: 650;
        }

        .badge {
            flex: 0 0 auto;
            display: inline-flex;
            gap: 10px;
            align-items: center;
            padding: 10px 12px;
            border-radius: 999px;
            background: rgba(255,255,255,.70);
            border: 1px solid rgba(2,6,23,.08);
            box-shadow: 0 10px 26px rgba(2,6,23,.08);
            color: rgba(11,18,32,.78);
            font-size: 13px;
            font-weight: 850;
            backdrop-filter: blur(10px);
            white-space: nowrap;
        }

            .badge .spark {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: rgba(37,99,235,.90);
                box-shadow: 0 6px 14px rgba(37,99,235,.22);
            }

        /* 버튼 그리드 */
        .grid {
            margin-top: 14px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .card {
            position: relative;
            border-radius: var(--r22);
            background: rgba(255,255,255,.78);
            border: 1px solid rgba(2,6,23,.08);
            box-shadow: var(--shadow1);
            overflow: hidden;
            backdrop-filter: blur(12px);
            transform: translateY(0);
            transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
        }

            .card::before {
                content: "";
                position: absolute;
                inset: 0;
                pointer-events: none;
                opacity: .95;
            }

        .btn {
            width: 100%;
            border: 0;
            background: transparent;
            color: var(--ink);
            cursor: pointer;
            text-align: left;
            padding: 18px 16px;
            display: flex;
            gap: 14px;
            align-items: center;
            position: relative;
        }

        .icon {
            width: 58px;
            height: 58px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            flex: 0 0 auto;
            background: rgba(255,255,255,.86);
            border: 1px solid rgba(2,6,23,.08);
            box-shadow: 0 10px 20px rgba(2,6,23,.08);
        }

        .text {
            min-width: 0;
        }

        .label {
            font-size: 18px;
            font-weight: 950;
            letter-spacing: -.2px;
            line-height: 1.15;
        }

        .desc {
            margin-top: 6px;
            color: var(--muted);
            font-size: 13.5px;
            font-weight: 650;
            line-height: 1.35;
        }

        .meta {
            margin-top: 10px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .pill {
            padding: 7px 10px;
            border-radius: 999px;
            border: 1px solid rgba(2,6,23,.08);
            background: rgba(255,255,255,.76);
            font-size: 12.5px;
            font-weight: 850;
            color: rgba(11,18,32,.82);
        }

        .chev {
            margin-left: auto;
            font-size: 20px;
            opacity: .9;
        }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow2);
            filter: brightness(1.02);
        }

        .btn:focus {
            outline: 3px solid rgba(37,99,235,.22);
            outline-offset: 4px;
            border-radius: calc(var(--r22) - 2px);
        }

        /* 테마별 */
        .theme-praise::before {
            background: radial-gradient(320px 200px at 18% 20%, rgba(236,72,153,.20), transparent 62%), radial-gradient(320px 200px at 90% 15%, rgba(37,99,235,.14), transparent 62%);
        }

        .theme-praise .icon {
            background: linear-gradient(135deg, rgba(236,72,153,.16), rgba(96,165,250,.12));
            border-color: rgba(236,72,153,.20);
        }

        .theme-pray::before {
            background: radial-gradient(320px 200px at 18% 20%, rgba(22,163,74,.18), transparent 62%), radial-gradient(320px 200px at 90% 15%, rgba(96,165,250,.12), transparent 62%);
        }

        .theme-pray .icon {
            background: linear-gradient(135deg, rgba(22,163,74,.14), rgba(134,239,172,.12));
            border-color: rgba(22,163,74,.20);
        }

        .theme-sermon {
            grid-column: 1 / -1;
        }

            .theme-sermon::before {
                background: radial-gradient(520px 220px at 12% 15%, rgba(37,99,235,.16), transparent 62%), radial-gradient(520px 220px at 92% 20%, rgba(168,85,247,.12), transparent 62%);
            }

            .theme-sermon .icon {
                background: linear-gradient(135deg, rgba(37,99,235,.14), rgba(168,85,247,.10));
                border-color: rgba(37,99,235,.20);
            }

        .foot {
            margin-top: 14px;
            text-align: center;
            color: rgba(11,18,32,.55);
            font-size: 12.5px;
            font-weight: 650;
        }

        @@media (max-width: 720px) {
            .heroInner {
                flex-direction: column;
                align-items: flex-start;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            .theme-sermon {
                grid-column: auto;
            }
        }
    </style>
</head>

<body>
    <div class="wrap">
        <div class="shell">

            <header class="hero">
                <div class="heroInner">
                    <div>
                        <h1 class="title">예배 콘텐츠</h1>
                        <div class="subtitle">찬양 · 기도 · 설교를 한 곳에서 편하게 시작해요</div>
                    </div>
                    <div class="badge" onclick="location.href='/'">
                        <span class="spark"></span>
                        <span>Home</span>
                        <span style="opacity:.65;">·</span>
                        <span>홈으로 이동</span>
                    </div>
                </div>
            </header>

            <section class="grid">

                <!-- ✅ 찬양 -->
                <div class="card theme-praise">
                    <button class="btn" type="button" onclick="location.href='@urlPraise'">
                        <div class="icon">🎶</div>
                        <div class="text">
                            <div class="label">찬양</div>
                            <div class="desc">하나님께 마음을 올려드리는 찬양을 시작해요</div>
                            <div class="meta">
                                <span class="pill">🎵 콘티</span>
                                <span class="pill">✨ CCM</span>
                                <span class="pill">📖 찬송</span>
                            </div>
                        </div>
                        <div class="chev">→</div>
                    </button>
                </div>

                <!-- ✅ 기도 -->
                <div class="card theme-pray">
                    <button class="btn" type="button" onclick="location.href='@urlPray'">
                        <div class="icon">🙏</div>
                        <div class="text">
                            <div class="label">기도</div>
                            <div class="desc">오늘의 기도제목을 붙잡고 함께 기도해요</div>
                            <div class="meta">
                                <span class="pill">🧡 중보</span>
                            </div>
                        </div>
                        <div class="chev">→</div>
                    </button>
                </div>
                @* 아래 네 카드는 /PrayHome/Index 로 옮겨져 이 화면에서는 제거했습니다.
                   · 내 반 · 동역교사 기도 → /PrayHome/coClass
                   · 중보기도              → /PrayHome/Intercessory
                   · 오늘하루 다짐 기도    → /Prayer/Index
                   · 치유와 회복 기도문    → /HealingAndRestorationPray/Index        *@

                <!-- ✅ 설교 (외부 링크) -->
                <div class="card theme-sermon">
                    <button class="btn" type="button" onclick="location.href='@urlSermon'">
                        <div class="icon">🎙️</div>
                        <div class="text">
                            <div class="label">설교</div>
                            <div class="desc">말씀으로 하루를 세우고, 믿음을 단단히 해요</div>
                            <div class="meta">
                                <span class="pill">📖 말씀 묵상</span>
                            </div>
                        </div>
                        <div class="chev">→</div>
                    </button>
                </div>

            </section>

            <div class="foot">@ChurchName · @DepartmentName</div>

        </div>
    </div>
</body>
</html>
