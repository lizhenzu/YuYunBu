@model BulletinBoard.Models.TodayPray
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = null;

    ViewBag.Title = "기도문 수정";
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>기도문 수정</title>
    <style>
        body {
            background-color: #f0f4f8;
            font-family: 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
   
        }

        .form-container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            padding: 5px;
            border-radius: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        h2 {
            text-align: center;
            color: #2e7d32;
            margin-bottom: 20px;
        }

        label {
            font-weight: bold;
            display: block;
            margin-top: 20px;
        }

        input[type="text"], textarea {
            width: 100%;
            padding: 10px;
            margin-top: 8px;
            border-radius: 10px;
            border: 1px solid #ccc;
            resize: vertical;
        }

        .readonly {
            background-color: #f5f5f5;
        }

        .btn-save {
            background-color: #43a047;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 30px;
            margin-top: 30px;
            cursor: pointer;
            font-size: 1em;
        }

            .btn-save:hover {
                background-color: #388e3c;
            }
    </style>
</head>
<body>
    <div class="form-container">
        <h2>기도문 수정</h2>

        <form asp-action="ModifyPrayProcess" asp-controller="PrayHome" method="post">
            <input type="hidden" name="PrayID" value="@Model.PrayID" />

            <label>노출 날짜</label>
            <input type="text" value="@Model.ExposeDate.ToString("yyyy-MM-dd")" class="readonly" readonly />

            <label for="Subject">주제</label>
            <input type="text" name="Subject" id="Subject" value="@Model.Subject" required />

            <label for="PrayTEXTData">기도문 내용</label>
            <textarea name="PrayTEXTData" id="PrayTEXTData" rows="17" required>@Model.PrayTEXTData</textarea>

            <label for="Subject">성경</label>
            <input type="text" name="BibleText" id="BibleText" value="@Model.BibleText" required />
            <label for="Subject">성경내용</label>
            <input type="text" name="BibleTextData" id="BibleTextData" value="@Model.BibleTextData" required />

            <label for="Subject">publishYN</label>
            <input type="text" name="publishYN" id="publishYN" value="@Model.publishYN" required />

            <div style="text-align: right;">
                <button type="submit" class="btn-save">💾 저장하기</button>
            </div>
        </form>
    </div>
</body>
</html>
