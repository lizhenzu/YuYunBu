    <style>
        @@keyframes floatUp {
            from {
                opacity: 1;
                top: 0px;
            }

            to {
                opacity: 0;
                top: -30px;
            }
        }
    </style>

   
        <script>
            function goMakePrayerByName() {
                const el = document.getElementById('forWhomName');
                const name = (el?.value || '').trim();
                if (!name) {
                    alert('이름을 입력해 주세요.');
                    el?.focus();
                    return;
                }
                // 이름을 쿼리로 넘겨 DetailWords.cshtml 호출
                location.href = `/BessingChild/DetailWords?forWhom=${encodeURIComponent(name)}`;
            }

        // 입력창에서 Enter로도 실행되도록
        document.addEventListener('DOMContentLoaded', function () {
            const el = document.getElementById('forWhomName');
            if (el) {
                el.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        goMakePrayerByName();
                    }
                });
            }
        });
 

    </script>
</body>
</html>
