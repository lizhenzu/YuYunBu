@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}


<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="A modern, responsive website designed for elementary school students.">
    <meta name="keywords" content="responsive, elementary, fun, clean design, minimal">
    <title>@ChurchName · @DepartmentName</title>
    <style>
        /* General Styles */
        body {
            font-family: 'Helvetica Neue', sans-serif;
            background-color: #f8f9fa;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Header */
        header {
            background-color: #1a1a2e;
            color: white;
            padding: 20px 0;
            text-align: center;
        }

            header h1 {
                margin: 0;
                font-size: 2.5em;
            }

        /* Navigation */
        nav {
            display: flex;
            justify-content: center;
            background-color: #16213e;
            padding: 15px 0;
        }

            nav a {
                color: white;
                text-decoration: none;
                margin: 0 15px;
                font-size: 1.2em;
            }

                nav a:hover {
                    text-decoration: underline;
                }

        /* Main Banner */
        .banner {
            background-image: url('/images/home/welcome/welcome_03.png');
            background-size: cover;
            background-position: center;
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

            .banner h2 {
                font-size: 2em;
                background-color: rgba(0, 0, 0, 0.8);
                padding: 10px 20px;
                border-radius: 10px;
            }

        /* Content Section */
        .content {
            padding: 40px 0;
        }

            .content h3 {
                font-size: 2em;
                margin-bottom: 20px;
                text-align: center;
            }

            .content p {
                font-size: 1.2em;
                line-height: 1.5;
                text-align: center;
            }

        /* Call to Action Section */
        .cta {
            background-color: #1a1a2e;
            color: white;
            padding: 50px 20px;
            text-align: center;
            margin-top: 40px;
        }

            .cta button {
                background-color: #e94560;
                color: white;
                padding: 15px 30px;
                font-size: 1.2em;
                border: none;
                border-radius: 5px;
                cursor: pointer;
                transition: background-color 0.3s ease;
            }

                .cta button:hover {
                    background-color: #d42b4f;
                }

        /* Footer */
        footer {
            background-color: #16213e;
            color: white;
            text-align: center;
            padding: 20px 0;
        }

            footer p {
                margin: 0;
            }

        /* Responsive Design */
        @@media (max-width: 768px) {
            header h1 {
                font-size: 2em;
            }

            .banner h2 {
                font-size: 1.5em;
            }

            .content h3 {
                font-size: 1.5em;
            }

            .cta button {
                padding: 10px 20px;
                font-size: 1em;
            }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>@($"{@ChurchName} · {@DepartmentName}")입니다.</h1>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="/">Home</a>
        <a href="/Home/MissionMainBoard">@ConstatsCommon.MainKeyTitle</a>
        <a href="/PrayHome/PrayBan">기도대상자 보기</a>

    </nav>

    <!-- Banner Section -->
    <section class="banner">
        <h2>기도 & 기도 & 기도</h2>
    </section>

    <!-- Main Content Section -->
    <div class="container">
        <section class="content">
            <h3>‘기도똑딱이’ 란?</h3>
            <p>‘기도똑딱이’는 기도 대상자들을 위해 꾸준히 기도할 수 있도록 도와주는 작은 기도 도우미예요.</p>
            <p>기도 대상자들를 위해 기도한 후, ‘기도똑딱이 버튼’을 눌러 기도한 날짜를 기록할 수 있어요.</p>
            <p>이 기능은 기도를 잊지 않고 스스로 돌아보며 주기적으로 다시 기도할 수 있도록 도와줘요. 자동 알림은 없지만, 이 페이지에 다시 들어와 지난 기도 날짜를 확인하고, ‘다시 기도해야겠다!’는 마음으로 실천할 수 있게 해준답니다.</p>
            <p>또한, 내가 한 사람을 위해 몇 번이나 기도했는지도 확인할 수 있어서 기도의 마음을 더 따뜻하게 이어갈 수 있어요.</p>
            <p>
                ‘기도똑딱이’를 통해 정성스럽고 꾸준한 기도를 함께 이어가요.<br>
                여러분의 기도가 기도 대상자들에게 큰 힘이 될 거예요.<br>
                감사합니다💕
            </p>
        </section>
    </div>

 

    <!-- Footer -->
    <footer>
        @{
            string churchString = $"{@ChurchName} {@DepartmentName}.";

        }
        <p>&copy; 2024 @churchString All Rights Reserved.</p>
    </footer>
    <script>
        function goRegister() {
            window.location.href = "/Identity/Account/Register";
        }

    </script>
</body>
</html>
