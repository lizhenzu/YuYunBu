@model BulletinBoard.Models.PrayPhrase

<form asp-action="CreatePrayPhrase" method="post" class="verse-form">

    <div class="card-header-middle">
        <h2>성경암송구절 등록</h2>
    </div>

    <div class="form-header">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

    @await Html.PartialAsync("_PrayPhrasePartial",Model)

    <div class="form-group">
        <button type="submit" class="btn-submit">제출</button>
    </div>
    <div class="form-group">
        <a href="@Url.Action("PrayPhraseDetailList")" class="btn btn-submit">목록</a>
    </div>
</form>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial") 
}
