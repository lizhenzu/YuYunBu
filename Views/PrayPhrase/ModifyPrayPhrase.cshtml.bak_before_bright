@model BulletinBoard.Models.PrayPhrase
@using BulletinBoard.Common;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@inject IAuthService AuthService

@{
    Layout = null;
   // string JanZulString = SharedComm.MakeBibleSerialJangZul(@Model.BibleText, @Model.FromJang, @Model.FromZul, @Model.ToJang, @Model.ToZul);

}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>기도문 수정</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #f4f7f9;
            font-family: 'Noto Sans KR', sans-serif;
        }

        header {
            background-color: #4caf50;
            color: white;
            padding: 1.5rem;
            text-align: center;
            font-size: 2rem;
            font-weight: bold;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .container {
            max-width: 600px;
            margin: 10px auto;
            padding: 25px;
        }

        label {
            font-weight: 600;
        }

        .form-row {
            margin-bottom: 15px;
        }

        .btn-group {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-top: 25px;
        }

        .form-group {
            margin-top: 10px;
            margin-bottom: 10px;
        }

        .form-row {
            margin-top: 10px;
            margin-bottom: 10px;
        }

        button {
            width: 100%;
        }

        @@media (max-width: 480px) {
            .form-inline .form-control {
                width: 100%;
                margin-top: 5px;
            }
        }
    </style>
</head>
<body>

    <header>
        <h1>기도문 수정</h1> 
        <h5>@SharedComm.GetTodayToStringKor(Model.ExposeDate)</h5>
    </header>
    <form asp-action="UpdatePrayPhrase" method="post" class="verse-form">
        <div class="container">

            <div class="form-group">
                <label asp-for="PrayTitle"></label>
                <input asp-for="PrayTitle" class="form-control" autofocus />
                <span asp-validation-for="PrayTitle" class="text-danger"></span>
            </div> 
   
            <div class="form-group">
                <label asp-for="BibleTextToPray"></label>
                <input asp-for="BibleTextToPray" class="form-control" autofocus />
                <span asp-validation-for="BibleTextToPray" class="text-danger"></span>
            </div>


            <div class="form-row row mt-3">
                <div class="col">
                    <label>시작 장/절</label>
                    <div class="form-inline d-flex gap-2">
                        <input type="number" asp-for="BibleTextToPrayFromJang" class="form-control" autofocus placeholder="시작 장" />
                        <input type="number" asp-for="BibleTextToPrayFromZul" class="form-control" autofocus placeholder="시작 절" />
                    </div>
                </div>
                <div class="col">
                    <label>종료 장/절</label>
                    <div class="form-inline d-flex gap-2">
                        <input type="number" asp-for="BibleTextToPrayToJang" class="form-control" autofocus placeholder="종료 장" />
                        <input type="number" asp-for="BibleTextToPrayToZul" class="form-control" autofocus placeholder="종료 절" />
                    </div>
                </div>
            </div>


            <div class="form-group">
                <label asp-for="PrayContent1"></label>
                <textarea id="PrayContent1" name="PrayContent1" asp-for="PrayContent1" class="form-control" rows="15" autofocus></textarea>
                <span asp-validation-for="PrayContent1" class="text-danger"></span>
            </div>


            <div class="form-group">
                <input type="Hidden" id="Id" name="Id" class="form-control" value="@Model.Id" />
                <input type="Hidden" asp-for="ExposeDate" class="form-control" value="@Model.ExposeDate.ToString("yyyy-MM-dd")" />
            </div>

            <div class="btn-group">
                <button type="submit" class="btn btn-success" onclick="save()">저장</button>
                <button class="btn btn-secondary" onclick="goHome()">홈</button>
            </div>
        </div>
    </form>
    <script>
        function save() {
            const data = {
                bible: document.getElementById('bible').value,
                chapter: document.getElementById('chapter').value,
                url: document.getElementById('url').value,
                maxTime: {
                    min: document.getElementById('maxMinutes').value,
                    sec: document.getElementById('maxSeconds').value,
                },
                start: {
                    min: document.getElementById('startMin').value,
                    sec: document.getElementById('startSec').value
                },
                end: {
                    min: document.getElementById('endMin').value,
                    sec: document.getElementById('endSec').value
                }
            };
            console.log("저장할 데이터:", data);
            alert("데이터가 저장되었습니다 (콘솔 확인)");
        }

        function goHome() {
            window.location.href = "/";
        }
    </script>

</body>
</html>