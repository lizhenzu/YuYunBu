@model IEnumerable<BulletinBoard.Models.PrayPhrases>

@{
    ViewData["Title"] = "List";
}

<style>

    .text-right {
        text-align: right;
    }

</style>

<div class="button-container-left">
    <a href="@Url.Action("EnrollPrayPhrase")" class="btn btn-register pretty-button">성품기도구절등록</a>
</div>
 
<table class="table">
    <thead>
        <tr>
            <th nowrap class="text-right">@Html.DisplayNameFor(model => model.sequenceNo)</th>
            <th nowrap>@Html.DisplayNameFor(model => model.PrayContent1)</th> 
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td nowrap class="text-right" rowspan="6"> @Html.DisplayFor(modelItem => item.sequenceNo)</td> 
             </tr>
            <tr>
                <td nowrap>@Html.DisplayFor(modelItem => item.PrayTitle)</td>
            </tr>
            <tr>
                <td nowrap>@Html.DisplayFor(modelItem => item.PrayContent1)</td>
            </tr>
            <tr>
                <td nowrap>@Html.DisplayFor(modelItem => item.BibleTextToPray)</td>
            </tr>
            <tr>
                <td nowrap>@item.BibleTextToPrayFromJang.ToString():@item.BibleTextToPrayFromZul.ToString() ~ @item.BibleTextToPrayToJang.ToString():@item.BibleTextToPrayToZul.ToString() </td>
            </tr>
            <tr>
                <td nowrap class="text-right">
                    @Html.ActionLink("수정", "ModifyPrayPhrase", "PrayPhrase", new { Id = item.Id}) |
                    @Html.ActionLink("삭제", "DeletePrayPhrase", "PrayPhrase", new { Id = item.Id})
                </td>
            </tr>
        }
    </tbody>
</table>
 