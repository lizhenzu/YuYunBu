@model PrayPhrasesDetails

@{
    ViewData["Title"] = "List";
}

<style>

    .text-right {
        text-align: right;
    }

    .card-typeA-body {
        font-family: 'Arial', sans-serif;
        margin: 0;  
        display: flex;
        justify-content: center;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .card-typeA {
        background-color: white;
        width: 300px;
        margin: 3px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border-radius: 8px;
        overflow: hidden;
        transition: transform 0.2s;
    }

    .card-typeA:hover {
        transform: scale(1.05);
    }

    .card-typeA-content {
        padding: 5px;
    }

    .card-typeA-title {
        font-size: 20px;
        color: #333;
        margin-bottom: 5px;
    }

    .card-typeA-text {
        font-size: 16px;
        color: #666;
        line-height: 1.5;
    }
</style>

<div class="button-container-left">
    <a href="@Url.Action("EnrollPrayPhrase")" class="btn btn-register pretty-button">성품기도구절등록</a>
</div>


<div class="card-typeA-body">
    @foreach (var item in Model.PrayPhrasesDetailList)
    {
        <div class="card-typeA">
            <div class="card-typeA-content"> 
                <p class="card-typeA-text">성경구절 : @item.eBiblesData.BibleText @item.eBiblesData.FromJang:@item.eBiblesData.FromZul~@item.eBiblesData.ToJang:@item.eBiblesData.ToZul </p>
                <p class="card-typeA-text">성경조회 : @item.eBiblesData.eBibleDatas.Count.ToString()</p>
                <p class="card-typeA-text">기도제목 : @item.PrayPhrasesData.PrayTitle</p>
            </div>
        </div>

    }
</div> 