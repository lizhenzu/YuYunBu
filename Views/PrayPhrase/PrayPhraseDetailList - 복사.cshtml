@model IEnumerable<BulletinBoard.Models.PrayPhrases>

@{
    ViewData["Title"] = "List";
}

<style>

    .text-right {
        text-align: right;
    }

</style>

<div class="button-container-left">
    <a href="@Url.Action("EnrollPrayPhrase")" class="btn btn-register pretty-button">성품기도구절등록</a>
</div>
 
<table class="table">
    <thead>
        <tr>
            <th nowrap class="text-right">@Html.DisplayNameFor(model => model.sequenceNo)</th>
            <th nowrap>@Html.DisplayNameFor(model => model.PrayContent1)</th>
            <th nowrap>작업</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td nowrap class="text-right"> @Html.DisplayFor(modelItem => item.sequenceNo)</td>
                <td nowrap>@Html.DisplayFor(modelItem => item.PrayContent1)</td> 
                <td nowrap>
                    @Html.ActionLink("수정", "ModifyPrayPhrase", "PrayPhrase", new { Id = item.Id}) |
                    @Html.ActionLink("삭제", "DeletePrayPhrase", "PrayPhrase", new { Id = item.Id})
                </td> 
            </tr>
        }
    </tbody>
</table>
 