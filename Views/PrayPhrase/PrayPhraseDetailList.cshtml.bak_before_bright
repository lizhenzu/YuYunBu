                <div class="bible-text-line " style="text-align:left; white-space: pre-wrap;">기도내용 : @BulletinBoard.Helpers.PrayTextHelper.MarkNamesInline(item.PrayPhrasesData.PrayContent1)</div>
                <p class="card-typeA-text text-right" style="padding-right :20px;">
                    @Html.ActionLink("수정", "ModifyPrayPhrase", "PrayPhrase", new { Id = @item.PrayPhrasesData.Id})
                </p>
            </div>
        </div>

    }
    @if (await AuthService.IsSignedIn(User) && await AuthService.IsInRole(await AuthService.GetSignedUser(User), nameof(Roles.SuperAdmin)))
    {
        <div class="back-button">
            <a href="/Home/MissionMainBoard">Mission</a>
            <a href="/">Home</a>
        </div>
    }
    else
    {
        @*        <div class="back-button">
    <a href="/">Go Home</a>
    </div>*@
    }


</div>
