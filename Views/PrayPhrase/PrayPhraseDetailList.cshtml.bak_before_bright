            <a href="/PrayPhrase/RestorPrayPhrase?YYear=@Model.PrayPhrasesDetailList[3].PrayPhrasesData.ExposeDate.Year&MMonth=@Model.PrayPhrasesDetailList[1].PrayPhrasesData.ExposeDate.Month">@(Model.PrayPhrasesDetailList[1].PrayPhrasesData.ExposeDate.Month+0)월 복구</a>
            <a href="/PrayPhrase/RestorPrayPhrase?YYear=@Model.PrayPhrasesDetailList[3].PrayPhrasesData.ExposeDate.Year&MMonth=@(Model.PrayPhrasesDetailList[1].PrayPhrasesData.ExposeDate.Month+1)">@(Model.PrayPhrasesDetailList[1].PrayPhrasesData.ExposeDate.Month + 1)월 복구</a>
        </div>
        <div class="back-button">
