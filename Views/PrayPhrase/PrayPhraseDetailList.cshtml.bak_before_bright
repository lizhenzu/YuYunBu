            <a href="/">Home</a>
        </div>
    }
    else
    {
        @*        <div class="back-button">
    <a href="/">Go Home</a>
    </div>*@
    }
    @foreach (var item in Model.PrayPhrasesDetailList)
    {


        <div class="card" style="margin:3px;border: 4px solid #008000;">
            <div class="card-content">
                <div class="bible-text-line " style="text-align:center;   font-size: 1.7em; font-weight:bold;">기도일자 : @item.PrayPhrasesData.ExposeDate.ToString("yyyy-MM-dd")</div>
@*                <div class="bible-text-line " style="text-align:center">성경구절 : @SharedComm.MakeBibleSerialJangZul( @item.eBiblesData.BibleText,@item.eBiblesData.FromJang,@item.eBiblesData.FromZul ,@item.eBiblesData.ToJang, @item.eBiblesData.ToZul )</div>
*@                @await Html.PartialAsync("_PublisheBible43", item.eBiblesData)
