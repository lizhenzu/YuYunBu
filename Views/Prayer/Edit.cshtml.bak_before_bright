@using BulletinBoard.Helpers;
@using BulletinBoard.Models;
@using BulletinBoard.Common
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model PrayerArrow

@{
  Layout = null; /* 레이아웃 미사용 */
  ViewData["Title"] = "화살 기도 수정";
}
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"]</title>
  <style>
    :root{
      --bg:#f3fbf6; --card:#ffffff; --ink:#0f2a1a; --muted:#597366; --brand:#22c55e; --brand-600:#16a34a; --warn:#ef4444; --border:rgba(16,50,31,.12);
    }
    @@media (prefers-color-scheme: dark){
      :root{ --bg:#08130d; --card:#0e1a14; --ink:#eaf7f0; --muted:#9eb3a7; --brand:#4ade80; --brand-600:#22c55e; --warn:#f87171; --border:rgba(255,255,255,.14); }
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{margin:0; font-family: system-ui,-apple-system, Segoe UI, Roboto, 'Noto Sans KR', Arial, sans-serif; background:
      radial-gradient(900px 600px at 90% -10%, rgba(134,239,172,.24), transparent 60%),
      radial-gradient(700px 500px at -10% 0%, rgba(52,211,153,.18), transparent 55%),
      var(--bg); color:var(--ink);
    }
    .wrap{max-width:920px; margin:28px auto; padding:16px}
    .card{background:var(--card); border:1px solid var(--border); border-radius:20px; box-shadow:0 12px 30px rgba(0,0,0,.06); overflow:hidden}
    .head{display:flex; flex-wrap:wrap; gap:12px; align-items:center; padding:18px 20px; border-bottom:1px solid var(--border); background:linear-gradient(180deg, rgba(34,197,94,.10), transparent)}
    .title{font-size:20px; font-weight:800; margin:0}
    .sub{margin-left:auto; font-size:12px; color:var(--muted)}

    form{padding:20px}
    .grid{display:grid; grid-template-columns:1fr; gap:14px}
    @@media(min-width:760px){ .grid{grid-template-columns:1fr 2fr; gap:16px} }

    label{font-weight:700; font-size:14px; color:var(--muted)}
    input[type=text], input[type=number], textarea{
      width:100%; padding:12px; border:1px solid var(--border); border-radius:12px; background:transparent; color:inherit; font-size:15px; outline:none; transition:border-color .15s, box-shadow .15s
    }
    input:focus, textarea:focus{border-color:var(--brand); box-shadow:0 0 0 4px rgba(34,197,94,.15)}
    textarea{resize:vertical; min-height:90px}

    .checkbox{display:flex; align-items:center; gap:8px}
    .help{font-size:12px; color:var(--muted)}

    .actions{display:grid; grid-template-columns:1fr; gap:10px; margin-top:8px}
    @@media(min-width:560px){.actions{grid-template-columns:1fr 1fr}}
    .btn{display:inline-flex; justify-content:center; align-items:center; gap:8px; padding:12px 14px; border-radius:12px; font-weight:700; text-decoration:none; cursor:pointer; transition:transform .04s, box-shadow .15s, background .15s}
    .btn:active{transform:translateY(1px)}
    .btn-save{background:var(--brand); color:#fff; border:1px solid transparent}
    .btn-save:hover{background:var(--brand-600)}
    .btn-back{background:#e8f7ee; color:#065f46; border:1px solid var(--border)}

    .validation{grid-column:1 / -1; font-size:13px; color:var(--warn)}
    .toast{margin:14px 20px 0; padding:10px 12px; border-left:4px solid var(--brand); background:rgba(34,197,94,.10); border-radius:10px; color:var(--ink); font-size:14px}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="head">
        <h1 class="title">@ViewData["Title"]</h1>
        <div class="sub">@DateHelper.GetKoreaNow().ToString("yyyy.MM.dd") · DayIndex @Model?.DayIndex</div>
      </div>

      @if(TempData["msg"] != null){<div class="toast">@TempData["msg"]</div>}

      <form asp-action="Edit" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PrayerId" />
        <div class="grid">
          <label asp-for="DayIndex"></label>
          <div>
            <input asp-for="DayIndex" type="number" min="1" max="31" />
            <div class="help">1~31 사이 값 (노출 순환 기준)</div>
            <span asp-validation-for="DayIndex" class="validation"></span>
          </div>

          <label asp-for="Title"></label>
          <div>
            <input asp-for="Title" type="text" placeholder="예) 전심의 사랑" />
            <span asp-validation-for="Title" class="validation"></span>
          </div>

          <label asp-for="Line1"></label>
          <div>
            <textarea asp-for="Line1" placeholder="첫 번째 줄 기도문"></textarea>
            <span asp-validation-for="Line1" class="validation"></span>
          </div>

          <label asp-for="Line2"></label>
          <div>
            <textarea asp-for="Line2" placeholder="두 번째 줄 기도문"></textarea>
            <span asp-validation-for="Line2" class="validation"></span>
          </div>

          <label asp-for="Line3"></label>
          <div>
            <textarea asp-for="Line3" placeholder="세 번째 줄 기도문"></textarea>
            <span asp-validation-for="Line3" class="validation"></span>
          </div>

          <label>활성화</label>
          <div class="checkbox">
            <input asp-for="IsActive" type="checkbox" id="active" />
            <label for="active" class="help">체크 시 해당 일자에 노출됩니다.</label>
          </div>

          <div class="actions">
            <button type="submit" class="btn btn-save">저장</button>
            <a class="btn btn-back" href="@Url.Action("Index", new { day = Model.DayIndex })">돌아가기</a>
          </div>
        </div>
      </form>
    </div>
  </div>

  @section Scripts{
    <partial name="_ValidationScriptsPartial" />
  }
</body>
</html>
