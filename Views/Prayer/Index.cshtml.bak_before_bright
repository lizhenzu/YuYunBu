@using BulletinBoard.Models
@model PrayerArrow

@using BulletinBoard.Common
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null; /* 레이아웃 미사용 */
    ViewData["Title"] = "오늘의 다짐 기도";

    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));

    var kNow = DateHelper.GetKoreaNow();
    string[] dayKor = { "일", "월", "화", "수", "목", "금", "토" };
    string dateStr = $"{kNow:yyyy년 M월 d일} {dayKor[(int)kNow.DayOfWeek]}요일";

    var bodyLines = new List<string>();
    if (Model != null)
    {
        if (!string.IsNullOrWhiteSpace(Model.Line1)) bodyLines.Add(Model.Line1.Trim());
        if (!string.IsNullOrWhiteSpace(Model.Line2)) bodyLines.Add(Model.Line2.Trim());
        if (!string.IsNullOrWhiteSpace(Model.Line3)) bodyLines.Add(Model.Line3.Trim());
    }

    // 첫 줄이 이미 하나님을 부르며 시작하면 "주님," 을 따로 붙이지 않는다
    // (그대로 두면 "주님, / 주님, 끝까지 인내하게…" 처럼 겹친다)
    string[] callWords = { "주님", "하나님", "아버지", "예수님" };
    bool needOpening = bodyLines.Count > 0
                       && !callWords.Any(w => bodyLines[0].StartsWith(w, StringComparison.Ordinal));
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FAFBFF" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Dodum&family=Gowun+Batang:wght@400;700&display=swap" rel="stylesheet">

    <style>
        :root {
            /* 새벽 여명 — 밝은 테마 */
            --paper: #FAFBFF;
            --paper-2: #F2F4FE;
            --card: #FFFFFF;
            --ink: #2C3242;
            --ink-2: #495066;
            --muted: #7C8496;
            --line: #E6E9F6;
            --dawn: #E8963E;
            --dawn-dk: #C4741D;
            --dawn-tint: #FFF1DE;
            --indigo: #5B72C4;
            --indigo-dk: #43569E;
            --shadow-s: 0 1px 2px rgba(44,50,66,.06);
            --shadow-m: 0 6px 20px rgba(44,50,66,.09);
            --f-ui: "Gowun Dodum","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
            --f-read: "Gowun Batang","Nanum Myeongjo","Apple SD Gothic Neo",serif;
            --fs: 1;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--paper);
            background-image: radial-gradient(760px 340px at 50% -140px, #FFE9CC 0%, rgba(255,233,204,0) 72%), radial-gradient(620px 300px at 4% 170px, #E4E9FB 0%, rgba(228,233,251,0) 74%), radial-gradient(620px 300px at 98% 260px, #FDE6E6 0%, rgba(253,230,230,0) 74%);
            background-repeat: no-repeat;
            background-attachment: fixed;
            color: var(--ink);
            font-family: var(--f-ui);
            line-height: 1.6;
            -webkit-text-size-adjust: 100%;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* ── 상단 바 ───────────────────────── */
        .nbar {
            position: sticky;
            top: 0;
            z-index: 20;
            background: rgba(250,251,255,.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--line);
        }

        .nbar-in {
            max-width: 720px;
            margin: 0 auto;
            padding: 9px clamp(12px,4vw,20px);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nb-btn {
            flex: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            height: 34px;
            padding: 0 13px;
            border-radius: 999px;
            background: var(--card);
            border: 1px solid var(--line);
            box-shadow: var(--shadow-s);
            font-size: 13px;
            color: var(--ink-2);
        }

            .nb-btn:hover {
                border-color: var(--dawn);
                color: var(--dawn-dk);
            }

        .nb-mid {
            flex: 1 1 auto;
            min-width: 0;
            text-align: center;
            font-size: 12.5px;
            color: var(--muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* 글자 크기 3단 */
        .fsgrp {
            flex: none;
            display: flex;
            gap: 0;
            background: var(--paper-2);
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 3px;
        }

            .fsgrp button {
                width: 30px;
                height: 28px;
                border: 0;
                background: transparent;
                cursor: pointer;
                border-radius: 999px;
                color: var(--muted);
                font-family: var(--f-ui);
                line-height: 1;
                display: grid;
                place-items: center;
                transition: .14s;
            }

                .fsgrp button:nth-child(1) {
                    font-size: 11px;
                }

                .fsgrp button:nth-child(2) {
                    font-size: 13px;
                }

                .fsgrp button:nth-child(3) {
                    font-size: 16px;
                }

                .fsgrp button.on {
                    background: var(--card);
                    color: var(--dawn-dk);
                    box-shadow: var(--shadow-s);
                }

                .fsgrp button:hover {
                    color: var(--dawn-dk);
                }

        /* ── 레이아웃 ───────────────────────── */
        .wrap {
            max-width: 720px;
            margin: 0 auto;
            padding: 0 clamp(14px,4vw,22px) 92px;
        }

        /* ── 히어로 ───────────────────────── */
        .hero {
            padding: 30px 0 22px;
            text-align: center;
        }

        /* 지평선 위로 떠오르는 해 */
        .dawnMark {
            width: 108px;
            height: 58px;
            margin: 0 auto 15px;
            position: relative;
            overflow: hidden;
        }

            .dawnMark .sun {
                position: absolute;
                left: 50%;
                bottom: 8px;
                transform: translateX(-50%);
                width: 46px;
                height: 46px;
                border-radius: 50%;
                background: radial-gradient(circle at 50% 38%, #FFDCA6 0%, #FFC578 60%, #F5A94E 100%);
                box-shadow: 0 0 0 9px rgba(255,197,120,.20), 0 0 0 18px rgba(255,197,120,.10);
            }

            .dawnMark .horizon {
                position: absolute;
                left: 0;
                right: 0;
                bottom: 8px;
                height: 2px;
                border-radius: 999px;
                background: linear-gradient(90deg,rgba(91,114,196,0),var(--indigo),rgba(91,114,196,0));
                opacity: .55;
            }

        .chips {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 14px;
        }

        .chip {
            padding: 5px 11px;
            border-radius: 999px;
            font-size: 11.5px;
            border: 1px solid var(--line);
            background: var(--card);
            color: var(--ink-2);
            box-shadow: var(--shadow-s);
        }

        .chip-dawn {
            background: var(--dawn-tint);
            border-color: #F6DBB4;
            color: var(--dawn-dk);
        }

        .chip-day {
            background: #EDF0FD;
            border-color: #D5DCF6;
            color: var(--indigo-dk);
        }

        .hero-h1 {
            margin: 0;
            font-size: clamp(21px,5.2vw,30px);
            line-height: 1.34;
            letter-spacing: -.02em;
            color: var(--ink);
            word-break: keep-all;
            text-wrap: balance;
        }

        .hero-sub {
            margin-top: 10px;
            font-size: 13px;
            color: var(--muted);
        }

        .hero-rule {
            margin: 20px auto 0;
            width: 58px;
            height: 4px;
            border-radius: 999px;
            background: linear-gradient(90deg,var(--dawn),var(--indigo));
        }

        /* ── 카드 ───────────────────────── */
        .card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 22px;
            box-shadow: var(--shadow-m);
            overflow: hidden;
            margin-bottom: 18px;
        }

        .card-hd {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 15px 20px;
            border-bottom: 1px solid var(--line);
            background: linear-gradient(180deg,#FBFCFF,#FFFFFF);
        }

        .card-ico {
            width: 30px;
            height: 30px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            font-size: 16px;
            background: var(--dawn-tint);
        }

        .card-tt {
            font-size: 13.5px;
            color: var(--ink-2);
        }

        .card-bd {
            padding: 22px 20px 26px;
        }

        .pray-title {
            margin: 0;
            font-family: var(--f-ui);
            font-size: clamp(19px,4.4vw,25px);
            line-height: 1.4;
            letter-spacing: -.02em;
            color: var(--ink);
            word-break: keep-all;
            text-wrap: balance;
        }

        .title-rule {
            margin: 15px 0 20px;
            height: 1px;
            background: repeating-linear-gradient(90deg,var(--line) 0 7px,transparent 7px 13px);
        }

        /* ── 기도문 ───────────────────────── */
        .prayer {
            font-family: var(--f-read);
        }

        .p-open {
            margin: 0 0 16px;
        }

        .p-open, .p-close {
            font-size: calc(17px * var(--fs));
            line-height: 1.9;
            color: var(--ink-2);
        }

        .p-close {
            margin-top: 20px;
        }

            .p-close .amen {
                display: block;
                margin-top: 4px;
                color: var(--dawn-dk);
                font-weight: 700;
            }

        .p-lines {
            margin: 0;
            padding: 0;
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 13px;
        }

            .p-lines li {
                position: relative;
                padding: 13px 16px 13px 44px;
                border-radius: 14px;
                background: linear-gradient(180deg,#FCFCFF,#F7F9FF);
                border: 1px solid var(--line);
                font-size: calc(17px * var(--fs));
                line-height: 1.95;
                color: var(--ink);
                word-break: keep-all;
            }

                /* 화살 기도 — 한 줄마다 겨누는 표식 */
                .p-lines li::before {
                    content: "";
                    position: absolute;
                    left: 16px;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 16px;
                    height: 16px;
                    border-radius: 999px;
                    background: var(--dawn-tint);
                    border: 2px solid var(--dawn);
                    box-shadow: inset 0 0 0 3px #FFFFFF;
                }

        .note {
            margin-top: 16px;
            min-height: 18px;
            text-align: center;
            font-family: var(--f-ui);
            font-size: 12px;
            color: var(--dawn-dk);
        }

        .empty {
            padding: 52px 20px;
            text-align: center;
        }

        .empty-ico {
            font-size: 40px;
            margin-bottom: 12px;
        }

        .empty-tt {
            font-size: 16px;
            color: var(--ink-2);
        }

        /* ── 버튼 ───────────────────────── */
        .btn-row {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 14px;
        }

        .btn {
            appearance: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            height: 44px;
            padding: 0 20px;
            border-radius: 999px;
            border: 1px solid var(--line);
            background: var(--card);
            color: var(--ink-2);
            font-family: var(--f-ui);
            font-size: 14px;
            cursor: pointer;
            box-shadow: var(--shadow-s);
            transition: .16s;
        }

            .btn:hover {
                transform: translateY(-1px);
                box-shadow: var(--shadow-m);
                border-color: #D8DEF2;
            }

            .btn:active {
                transform: translateY(0);
            }

        .btn-dawn {
            min-width: 180px;
            background: linear-gradient(135deg,var(--dawn),#F2B463);
            border-color: transparent;
            color: #4A3208;
        }

        :focus-visible {
            outline: 3px solid var(--indigo);
            outline-offset: 2px;
        }

        @@media (max-width:420px) {
            .btn {
                height: 42px;
                padding: 0 16px;
                font-size: 13.5px;
            }

            .btn-dawn {
                min-width: 160px;
            }
        }

        @@media (prefers-reduced-motion:reduce) {
            * {
                transition: none !important;
            }
        }
    </style>
</head>
<body>

    <header class="nbar">
        <div class="nbar-in">
            <a class="nb-btn" href="@Url.Content("~/")">🏠 홈</a>
            <div class="nb-mid">@dateStr</div>
            <div class="fsgrp" role="group" aria-label="기도문 글자 크기">
                <button type="button" id="pfsS" onclick="setPFs('s')" aria-label="작게">가</button>
                <button type="button" id="pfsM" onclick="setPFs('m')" aria-label="보통">가</button>
                <button type="button" id="pfsL" onclick="setPFs('l')" aria-label="크게">가</button>
            </div>
        </div>
    </header>

    <div class="wrap">

        <section class="hero">
            <div class="dawnMark" aria-hidden="true">
                <span class="sun"></span>
                <span class="horizon"></span>
            </div>
            <div class="chips">
                <span class="chip chip-dawn">🏹 화살기도</span>
                @if (Model != null && Model.DayIndex > 0)
                {
                    <span class="chip chip-day">@(Model.DayIndex)일차</span>
                }
            </div>
            <h1 class="hero-h1">오늘의 다짐 기도</h1>
            <div class="hero-sub">짧지만 정확히 마음을 겨누는 기도 한 줄</div>
            <div class="hero-rule"></div>
        </section>

        @if (Model == null)
        {
            <div class="card">
                <div class="empty">
                    <div class="empty-ico">🌅</div>
                    <div class="empty-tt">등록된 기도문이 없어요</div>
                </div>
            </div>

            <div class="btn-row">
                <a class="btn btn-dawn" href="@Url.Content("~/")">🏠 홈으로</a>
            </div>
        }
        else
        {
            <article class="card">
                <div class="card-hd">
                    <div class="card-ico">🙏</div>
                    <span class="card-tt">오늘의 다짐</span>
                </div>
                <div class="card-bd">
                    <h2 class="pray-title">@(string.IsNullOrWhiteSpace(Model.Title) ? "제목 없음" : Model.Title)</h2>
                    <div class="title-rule"></div>

                    @* 복사 대상 — 이 영역의 글자만 클립보드로 옮긴다 *@
                    <div class="prayer" id="prayer-text">
                        @if (needOpening)
                        {
                            <p class="p-open">주님,</p>
                        }

                        @if (bodyLines.Count > 0)
                        {
                            <ul class="p-lines">
                                @foreach (var l in bodyLines)
                                {
                                    <li>@l</li>
                                }
                            </ul>
                        }

                        <p class="p-close">
                            예수님의 이름으로 기도드립니다.
                            <span class="amen">아멘.</span>
                        </p>
                    </div>

                    <div id="copy-note" class="note" aria-live="polite"></div>
                </div>
            </article>

            <div class="btn-row">
                <button class="btn btn-dawn" type="button" onclick="copyPrayer()">📋 전체 복사</button>
            </div>

            <div class="btn-row">
                <a class="btn" href="@Url.Content("~/")">🏠 홈으로</a>
                <a class="btn" href="/PrayHome/Index">🙏 기도홈</a>
                @if (isSuperAdmin || isAdmin)
                {
                    <a class="btn" href="@Url.Action("Edit", new { id = Model.PrayerId })">✏️ 수정</a>
                }
            </div>
        }

    </div>

    <script>
        /* 기도문 글자 크기 — 작게 / 보통 / 크게 */
        (function () {
            var MAP = { s: 0.90, m: 1, l: 1.18 };
            window.setPFs = function (k, silent) {
                if (!MAP[k]) k = 'm';
                document.documentElement.style.setProperty('--fs', MAP[k]);
                ['S', 'M', 'L'].forEach(function (x) {
                    var b = document.getElementById('pfs' + x);
                    if (b) b.classList.toggle('on', x.toLowerCase() === k);
                });
                if (!silent) { try { localStorage.setItem('prFs', k); } catch (e) { } }
            };
            function boot() {
                var saved = 'm';
                try { saved = localStorage.getItem('prFs') || 'm'; } catch (e) { }
                setPFs(saved, true);
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
            else boot();
        })();

        /* 기도문 전체 복사 */
        function copyPrayer() {
            var el = document.getElementById('prayer-text');
            var note = document.getElementById('copy-note');
            if (!el) return;

            var text = (el.innerText || el.textContent || '').replace(/\n{3,}/g, '\n\n').trim();

            function done(ok) {
                if (!note) return;
                note.textContent = ok ? '기도문을 복사했어요' : '복사하지 못했어요';
                setTimeout(function () { note.textContent = ''; }, 1800);
            }

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(fallback(text)); });
            } else {
                done(fallback(text));
            }

            /* clipboard API 를 쓸 수 없는 환경(비 HTTPS 등) 대비 */
            function fallback(t) {
                try {
                    var ta = document.createElement('textarea');
                    ta.value = t;
                    ta.setAttribute('readonly', '');
                    ta.style.position = 'fixed';
                    ta.style.top = '-1000px';
                    document.body.appendChild(ta);
                    ta.select();
                    var ok = document.execCommand('copy');
                    document.body.removeChild(ta);
                    return ok;
                } catch (e) { return false; }
            }
        }
    </script>
</body>
</html>
