@model BulletinBoard.Models.Prayer365.Prayer365EditVM
@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@using Cfg = BulletinBoard.Models.Prayer365.Prayer365Config

@*  365일 기도문 — 확인 · 오타 수정 (관리자).
    왼쪽 : Claude 교정 기록(원문 → 교정).  오른쪽 : 날짜 · 제목 · 구절 · 본문 고치기 + 검수 완료 → 저장 *@

@{
    Layout = null;
    var it = Model.Item;
    string label = Cfg.Label(Model.MonthDay);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>@label 기도문 — 확인 · 오타 수정</title>
    <partial name="_Prayer365Style" />
    <style>
        .h1 { font-family: "Noto Serif KR", serif; font-size: 21px; margin-top: 6px; }
        .edg { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 18px; margin-top: 16px; align-items: start; }
        @@media (max-width: 860px) { .edg { grid-template-columns: 1fr; } }
        .side { border: 1.5px dashed var(--acc); background: #fff; padding: 16px; }
        .side .t { font-size: 12.5px; color: var(--dim2); line-height: 1.7; }
        .fix { margin-top: 8px; background: var(--warnbg); border: 1px solid #E7D2C4; padding: 7px 9px; font-size: 12.5px; line-height: 1.6; word-break: keep-all; }
        .fix s { color: var(--dim); }
        .meta { margin-top: 12px; font-size: 11px; color: var(--dim); line-height: 1.7; }
        .fm { display: grid; gap: 12px; }
        .row2 { display: grid; grid-template-columns: 150px 1fr; gap: 10px; }
        @@media (max-width: 560px) { .row2 { grid-template-columns: 1fr; } }
        .fm label.l { display: block; font-size: 10.5px; font-weight: 600; letter-spacing: .12em; color: var(--dim); margin-bottom: 5px; }
        .in { width: 100%; font: inherit; font-size: 14px; padding: 10px 12px; border: 1px solid var(--rule); background: #fff; color: var(--tx); }
        .in:focus { outline: none; border-color: var(--acc); }
        .in[readonly] { background: var(--mark); color: var(--dim2); }
        textarea.in { min-height: 320px; line-height: 1.9; font-family: "Noto Serif KR", serif; resize: vertical; }
        textarea.in.tv { min-height: 76px; }
        .hint { font-size: 11.5px; color: var(--dim2); line-height: 1.7; }
        .acts { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; align-items: center; }
        .chk { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--dim2); }
        .chk input { width: 16px; height: 16px; accent-color: var(--ok); }
    </style>
</head>
<body>
<div class="pz wide">
    <div class="bar">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/Prayer365/Admin">365일 기도문 관리</a><span class="sep">›</span>@label</span>
        <span class="grp"><a class="nb" href="/Prayer365/Edit?md=@Model.Prev">← @Cfg.Label(Model.Prev)</a><a class="nb" href="/Prayer365/Edit?md=@Model.Next">@Cfg.Label(Model.Next) →</a></span>
    </div>

    <div class="kk" style="margin-top:20px">PRAYER 365 · 확인 · 오타 수정</div>
    <div class="h1">@label 기도문 @(it == null ? "— 비어 있음" : "")</div>

    @if (!string.IsNullOrWhiteSpace(Model.Toast)) { <div class="toast">@Model.Toast</div> }

    <div class="edg">
        <div class="side">
            <div class="kk" style="letter-spacing:.16em;margin-bottom:8px">CLAUDE 교정 기록</div>
            @if (it == null)
            {
                <div class="t">아직 이 날 기도문이 없어요.<br />대화창에 <b>날짜와 기도문 텍스트</b>를 올려 주시면 오타 · 이상한 문구만 고쳐서 넣어 드려요. 여기서 직접 적어 넣어도 돼요.</div>
            }
            else if (it.Fixes.Count == 0)
            {
                <div class="t">고친 곳이 없어요 — 올려 주신 그대로 넣었어요.</div>
            }
            else
            {
                <div class="t">있는 그대로 넣고 <b>@(it.Fixes.Count)곳</b>만 고쳤어요. 맞는지 확인해 주세요.</div>
                @foreach (var f in it.Fixes)
                {
                    <div class="fix"><s>@f.From</s> → <b>@f.To</b></div>
                }
            }
            @if (it != null)
            {
                <div class="meta">마지막 저장 @it.UpdatedAt.ToString("yyyy.MM.dd HH:mm", inv)@(string.IsNullOrWhiteSpace(it.UpdatedBy) ? "" : " · " + it.UpdatedBy)<br />
                    <a href="/Prayer365?md=@Model.MonthDay" target="_blank" rel="noopener">화면에서 보기 →</a></div>
            }
        </div>

        <form method="post" action="/Prayer365/Edit" class="fm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="md" value="@Model.MonthDay" />
            <div class="row2">
                <div><label class="l">날짜</label><input class="in" value="@label" readonly /></div>
                <div><label class="l">제목</label><input class="in" name="title" value="@it?.Title" maxlength="200" required /></div>
            </div>
            <div class="row2">
                <div><label class="l">성경 구절</label><input class="in" name="verseRef" value="@it?.VerseRef" maxlength="100" placeholder="시 18:1-2" /></div>
                <div><label class="l">구절 본문 (개역한글)</label><textarea class="in tv" name="verseText" maxlength="1000">@it?.VerseText</textarea></div>
            </div>
            <div>
                <label class="l">기도문 본문</label>
                <textarea class="in" name="body" required>@it?.Body</textarea>
                <div class="hint">문단은 줄바꿈으로 나눠요. 짧고 쉼표로 끝나는 줄(“사랑의 하나님,”)은 화면에서 금빛 호칭으로 보여요. 끝의 “아멘.”은 오른쪽에 따로 보여요.</div>
            </div>
            <div class="acts">
                <label class="chk"><input type="checkbox" name="isReviewed" value="true" @(it?.IsReviewed == true ? "checked" : "") /> 검수 완료 (오타 확인함)</label>
                <div class="grp">
                    <a class="nb" href="/Prayer365?md=@Model.MonthDay" target="_blank" rel="noopener">미리 보기</a>
                    <button class="nb pri" type="submit">저장</button>
                </div>
            </div>
        </form>
    </div>
</div>
</body>
</html>
