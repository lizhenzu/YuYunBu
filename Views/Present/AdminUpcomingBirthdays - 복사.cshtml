@model BulletinBoard.Models.UpcomingBirthdayListVM
@{
    Layout = null;
    ViewData["Title"] = "관리자 - 다가오는 생일자 (선물/발송 현황)";

    // ✅ 필터: 기본값 = all(전체)
    //   - all : 전체 보기
    //   - unsentOnly : "전달완료" 제외(= 전달안함만 보기)
    var filter = (Context?.Request?.Query["filter"].ToString() ?? "all").Trim().ToLowerInvariant();
    bool hideSent = filter == "unsentonly";

    // withinDays는 기존 그대로 사용(폼에서 넘어옴)
    var withinDays = Model.WithinDays;
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <style>
        /* ==============================
                                   Upcoming Birthday Admin - LIGHT THEME
                                   - 기능/구조 유지, 스타일만 밝게
                                   ============================== */

        :root {
            --bg0: #f7f9ff;
            --bg1: #eef2ff;
            --card: rgba(255,255,255,.86);
            --card2: rgba(255,255,255,.72);
            --line: rgba(15,23,42,.10);
            --txt: rgba(15,23,42,.92);
            --muted: rgba(15,23,42,.62);
            --muted2: rgba(15,23,42,.48);
            --okA: #16a34a;
            --okB: #86efac;
            --warnA: #f59e0b;
            --warnB: #ffd166;
            --priA: #2563eb;
            --priB: #22c55e;
            --dangerA: #ef4444;
            --dangerB: #fb7185;
            --radius: 18px;
            --radius2: 22px;
            --shadow: 0 18px 48px rgba(2,6,23,.10);
            --shadow2: 0 12px 28px rgba(2,6,23,.08);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: system-ui, -apple-system, Segoe UI, Roboto, "Noto Sans KR", Arial, sans-serif;
            color: var(--txt);
            background: radial-gradient(1100px 650px at 10% 0%, rgba(37,99,235,.14), transparent 58%), radial-gradient(1100px 650px at 110% 0%, rgba(34,197,94,.12), transparent 58%), linear-gradient(180deg, var(--bg0), var(--bg1));
            min-height: 100vh;
        }

        .wrap {
            max-width: 1120px;
            margin: 0 auto;
            padding: 16px 12px 60px;
        }

        /* Header */
        .topbar {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .headline {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .h-title {
            font-size: 20px;
            font-weight: 1000;
            letter-spacing: -.2px;
        }

        .h-meta {
            font-size: 13px;
            color: var(--muted);
            font-weight: 800;
        }

        .top-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        .btn {
            border: 0;
            cursor: pointer;
            border-radius: 14px;
            padding: 10px 14px;
            font-weight: 1000;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            user-select: none;
            box-shadow: 0 10px 22px rgba(2,6,23,.10);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--priA), #60a5fa);
            color: #ffffff;
        }

        .btn-ghost {
            background: rgba(255,255,255,.82);
            color: var(--txt);
            border: 1px solid var(--line);
            box-shadow: 0 8px 18px rgba(2,6,23,.06);
        }

        .btn-home {
            background: linear-gradient(135deg, rgba(22,163,74,.95), rgba(134,239,172,.95));
            color: #052e16;
        }

        /* ✅ 필터 버튼 active */
        .btn-active {
            background: linear-gradient(135deg, rgba(37,99,235,.18), rgba(96,165,250,.18));
            border: 1px solid rgba(37,99,235,.28) !important;
            box-shadow: 0 10px 22px rgba(37,99,235,.12);
        }

        /* Panel */
        .panel {
            border: 1px solid var(--line);
            border-radius: var(--radius2);
            background: linear-gradient(180deg, rgba(255,255,255,.78), rgba(255,255,255,.60));
            box-shadow: var(--shadow);
            overflow: hidden;
            backdrop-filter: blur(10px);
        }

        /* Filters */
        .filters {
            padding: 12px;
            border-bottom: 1px solid var(--line);
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
            background: rgba(255,255,255,.62);
        }

            .filters .label {
                font-size: 13px;
                color: var(--muted);
                font-weight: 1000;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .filters input[type=number] {
                width: 150px;
                padding: 10px 12px;
                border-radius: 14px;
                border: 1px solid rgba(15,23,42,.12);
                background: rgba(255,255,255,.92);
                color: var(--txt);
                outline: none;
                font-weight: 900;
                box-shadow: 0 8px 18px rgba(2,6,23,.05);
            }

        /* Cards grid */
        .cards {
            padding: 12px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        @@media (min-width: 760px) {
            .wrap {
                padding: 22px 16px 70px;
            }

            .h-title {
                font-size: 22px;
            }

            .grid {
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }
        }

        @@media (min-width: 1080px) {
            .grid {
                grid-template-columns: 1fr 1fr 1fr;
            }
        }

        .item {
            border: 1px solid rgba(15,23,42,.10);
            border-radius: var(--radius);
            background: rgba(255,255,255,.88);
            box-shadow: var(--shadow2);
            overflow: hidden;
            position: relative;
        }

            .item.sent-dim {
                opacity: .70;
                filter: grayscale(.08);
            }

        .item-top {
            padding: 12px 12px 10px;
            border-bottom: 1px solid rgba(15,23,42,.08);
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
            background: radial-gradient(700px 220px at 0% 0%, rgba(37,99,235,.08), transparent 60%), radial-gradient(700px 220px at 100% 0%, rgba(34,197,94,.08), transparent 60%), rgba(255,255,255,.66);
        }

        .user {
            display: flex;
            gap: 10px;
            min-width: 0;
            align-items: center;
        }

        .avatar {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            border: 1px solid rgba(15,23,42,.12);
            object-fit: cover;
            background: rgba(15,23,42,.03);
            flex-shrink: 0;
        }

        .u-text {
            min-width: 0;
        }

        .u-name {
            font-weight: 1000;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            letter-spacing: -.1px;
        }

        .u-sub {
            margin-top: 2px;
            font-size: 12px;
            color: var(--muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-weight: 900;
        }

        .u-birth {
            margin-top: 6px;
            font-size: 12px;
            color: var(--muted);
            font-weight: 1000;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        .muted {
            color: var(--muted2);
            font-weight: 900;
        }

        /* D-day */
        .dday {
            font-weight: 1000;
            padding: 4px 10px;
            border-radius: 999px;
            border: 1px solid rgba(15,23,42,.10);
            background: rgba(15,23,42,.04);
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
            color: rgba(15,23,42,.78);
        }

        .dday-0 {
            color: rgba(190, 18, 60, .92);
            border-color: rgba(190, 18, 60, .18);
            background: rgba(251, 113, 133, .14);
        }

        .dday-3 {
            color: rgba(120, 53, 15, .95);
            border-color: rgba(245, 158, 11, .22);
            background: rgba(245, 158, 11, .14);
        }

        .dday-7 {
            color: rgba(29, 78, 216, .95);
            border-color: rgba(37, 99, 235, .18);
            background: rgba(37, 99, 235, .12);
        }

        .dday-30 {
            color: rgba(20, 83, 45, .95);
            border-color: rgba(22, 163, 74, .16);
            background: rgba(22, 163, 74, .12);
        }

        /* Pill */
        .pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 1000;
            border: 1px solid rgba(15,23,42,.10);
            background: rgba(15,23,42,.04);
            white-space: nowrap;
            color: rgba(15,23,42,.78);
        }

        .pill-picked {
            background: rgba(37,99,235,.12);
            border-color: rgba(37,99,235,.18);
            color: rgba(29,78,216,.95);
        }

        .pill-unpicked {
            background: rgba(245,158,11,.12);
            border-color: rgba(245,158,11,.22);
            color: rgba(120,53,15,.95);
        }

        .pill-sent {
            background: rgba(22,163,74,.12);
            border-color: rgba(22,163,74,.18);
            color: rgba(20,83,45,.95);
        }

        .pill-unsent {
            background: rgba(245,158,11,.12);
            border-color: rgba(245,158,11,.22);
            color: rgba(120,53,15,.95);
        }

        /* Gift block */
        .item-body {
            padding: 12px;
            display: grid;
            grid-template-columns: 78px 1fr;
            gap: 12px;
            align-items: start;
        }

        .giftimg {
            width: 78px;
            height: 78px;
            border-radius: 16px;
            border: 1px solid rgba(15,23,42,.12);
            object-fit: cover;
            background: rgba(15,23,42,.03);
        }

        .zoomable {
            cursor: zoom-in;
            transition: transform .12s ease, box-shadow .12s ease, opacity .12s ease;
        }

            .zoomable:hover {
                transform: translateY(-1px);
                box-shadow: 0 10px 22px rgba(2,6,23,.12);
            }

            .zoomable:active {
                transform: translateY(0);
                opacity: .92;
            }

        .p-title {
            font-weight: 1000;
            line-height: 1.25;
            letter-spacing: -.1px;
            word-break: break-word;
        }

        .p-id {
            margin-left: 6px;
            color: var(--muted2);
            font-size: 12px;
            font-weight: 900;
        }

        .p-desc {
            margin-top: 8px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.45;
            word-break: break-word;
        }

        .p-meta {
            margin-top: 8px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        /* Actions */
        .item-foot {
            padding: 10px 12px 12px;
            border-top: 1px solid rgba(15,23,42,.08);
            display: flex;
            gap: 10px;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            background: rgba(255,255,255,.62);
        }

        .time {
            font-size: 12px;
            color: var(--muted);
            font-weight: 1000;
        }

        .actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            align-items: center;
        }

        .btn-mini {
            border: 0;
            cursor: pointer;
            border-radius: 12px;
            padding: 8px 10px;
            font-weight: 1000;
            font-size: 12px;
            white-space: nowrap;
            box-shadow: 0 10px 22px rgba(2,6,23,.10);
        }

        .btn-sent {
            background: linear-gradient(135deg, rgba(22,163,74,.95), rgba(134,239,172,.95));
            color: #052e16;
        }

        .btn-cancel {
            background: rgba(255,255,255,.86);
            color: var(--txt);
            border: 1px solid rgba(15,23,42,.12);
            box-shadow: 0 8px 18px rgba(2,6,23,.06);
        }

        /* ✅ 전달취소 버튼 – 밝은 테마에서도 강하게 */
        .btn-cancel-strong {
            background: linear-gradient(135deg, #ff6b6b, #ff3d81);
            color: #ffffff !important;
            border: 1px solid rgba(255,255,255,.35);
            filter: saturate(1.05);
            box-shadow: 0 12px 30px rgba(255, 61, 129, .35), 0 0 0 2px rgba(255, 107, 107, .18), 0 2px 0 rgba(255,255,255,.18) inset;
            text-shadow: 0 1px 0 rgba(0,0,0,.18);
        }

            .btn-cancel-strong:hover {
                background: linear-gradient(135deg, #ff7f7f, #ff5fa2);
                box-shadow: 0 14px 36px rgba(255, 61, 129, .42), 0 0 0 3px rgba(255, 107, 107, .22), 0 2px 0 rgba(255,255,255,.22) inset;
            }

            .btn-cancel-strong:active {
                transform: translateY(0);
                box-shadow: 0 8px 22px rgba(255, 61, 129, .28), 0 1px 0 rgba(255,255,255,.12) inset;
            }

        /* ✅ dim 상태에서도 버튼은 또렷하게 */
        .item.sent-dim .btn-cancel-strong {
            opacity: 1 !important;
            filter: none !important;
            transform: translateZ(0);
            position: relative;
            z-index: 2;
        }

        .btn-mini:disabled {
            opacity: .45;
            cursor: not-allowed;
            box-shadow: none;
        }

        .hint {
            margin-top: 8px;
            font-size: 12px;
            color: var(--muted2);
            font-weight: 900;
        }

        .empty {
            padding: 18px 12px;
            text-align: center;
            color: var(--muted);
            font-weight: 900;
        }

        /* ===== Image Modal (Light) ===== */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(2,6,23,.55);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 18px;
            z-index: 9999;
        }

            .modal-backdrop.open {
                display: flex;
            }

        .modal-panel {
            width: min(860px, 100%);
            border-radius: 20px;
            border: 1px solid rgba(15,23,42,.12);
            background: rgba(255,255,255,.96);
            box-shadow: 0 24px 60px rgba(2,6,23,.22);
            overflow: hidden;
            position: relative;
        }

        .modal-topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            border-bottom: 1px solid rgba(15,23,42,.10);
            background: rgba(255,255,255,.74);
        }

        .modal-title {
            font-weight: 1000;
            font-size: 13px;
            color: var(--muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .modal-close {
            appearance: none;
            border: 1px solid rgba(15,23,42,.12);
            cursor: pointer;
            border-radius: 12px;
            padding: 8px 10px;
            background: rgba(255,255,255,.92);
            color: var(--txt);
            font-weight: 1000;
        }

            .modal-close:hover {
                background: rgba(255,255,255,1);
            }

        .modal-body {
            padding: 14px;
        }

        .modal-img {
            width: 100%;
            height: auto;
            max-height: 78vh;
            object-fit: contain;
            border-radius: 14px;
            border: 1px solid rgba(15,23,42,.10);
            background: rgba(15,23,42,.03);
            display: block;
        }

        body.modal-lock {
            overflow: hidden;
        }

        /* focus */
        .btn:focus-visible,
        .btn-mini:focus-visible,
        input:focus-visible,
        a:focus-visible,
        button:focus-visible {
            outline: 2px solid rgba(37,99,235,.35);
            outline-offset: 2px;
            border-radius: 12px;
        }

        /* ===========================
                   ✅ Copy + Toast (NEW)
                   =========================== */

        .copyWrap {
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

        .copyBtn {
            border: 1px solid rgba(15,23,42,.12);
            background: rgba(255,255,255,.92);
            border-radius: 10px;
            padding: 2px 7px;
            cursor: pointer;
            font-size: 13px;
            line-height: 1;
            font-weight: 900;
            box-shadow: 0 8px 18px rgba(2,6,23,.06);
            flex: 0 0 auto;
            margin-top: 1px;
        }

            .copyBtn:hover {
                background: rgba(255,255,255,1);
                transform: translateY(-1px);
            }

            .copyBtn:active {
                transform: translateY(0);
                opacity: .92;
            }

        /* ✅ 원문 보관용 textarea 숨김 (따옴표/줄바꿈 안전) */
        .copySrc {
            position: absolute;
            left: -9999px;
            top: -9999px;
            width: 1px;
            height: 1px;
            opacity: 0;
        }

        /* ✅ Toast */
        .toast {
            position: fixed;
            left: 50%;
            bottom: 22px;
            transform: translateX(-50%) translateY(12px);
            background: rgba(15,23,42,.92);
            color: #fff;
            padding: 10px 14px;
            border-radius: 999px;
            font-weight: 1000;
            font-size: 13px;
            box-shadow: 0 14px 34px rgba(2,6,23,.22);
            border: 1px solid rgba(255,255,255,.14);
            opacity: 0;
            pointer-events: none;
            transition: opacity .18s ease, transform .18s ease;
            z-index: 99999;
            backdrop-filter: blur(10px);
        }

            .toast.show {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
    </style>
</head>

<body>
    <div class="wrap">

        <div class="topbar">
            <div class="headline">
                <div class="h-title">🎂 다가오는 생일자 (관리자)</div>
                <div class="h-meta">
                    <b>@Model.WithinDays</b>일 이내 생일자: 총 <b>@Model.TotalCount</b>명
                    <span style="color:rgba(15,23,42,.48);"> · 선물선택/발송 상태 포함</span>
                    @if (hideSent)
                    {
                        <span style="color:rgba(120,53,15,.90); font-weight:1000;"> · (전달완료 제외 중)</span>
                    }
                </div>
            </div>

            <div class="top-actions">
                <a href="/Present/AdminUpcomingBirthdays" class="btn btn-ghost">📋 전체 선택현황</a>
                <a href="/" class="btn btn-home">🏠 홈으로</a>
            </div>
        </div>

        <div class="panel">

            <!-- 기간 설정 + ✅ 필터 -->
            <form class="filters" method="get" action="/Present/AdminUpcomingBirthdays">
                <div class="label">기간</div>
                <input type="number" name="withinDays" value="@Model.WithinDays" min="0" max="365" />

                <!-- ✅ 새 필터 파라미터 -->
                <input type="hidden" name="filter" value="@filter" />

                <button class="btn btn-primary" type="submit">적용</button>

                <span style="width:1px; height:28px; background:rgba(15,23,42,.10); margin:0 4px;"></span>

                <!-- ✅ 필터 토글 -->
                <div class="label">보기</div>
                <a class="btn btn-ghost @(filter == "all" ? "btn-active" : "")"
                   href="/Present/AdminUpcomingBirthdays?withinDays=@withinDays&filter=all">
                    👀 전체 보기
                </a>
                <a class="btn btn-ghost @(filter == "unsentonly" ? "btn-active" : "")"
                   href="/Present/AdminUpcomingBirthdays?withinDays=@withinDays&filter=unsentOnly">
                    🚚 미처리 보기
                </a>
            </form>

            <!-- 카드형 리스트만 (PC/모바일 공통) -->
            <div class="cards">
                @if (Model.Rows == null || Model.Rows.Count == 0)
                {
                    <div class="empty">표시할 데이터가 없습니다.</div>
                }
                else
                {
                    <div class="grid">
                        @{
                            int loopCount = 0;

                            // ✅ 필터 적용: hideSent이면 r.IsSent == true는 제외
                            var rows = hideSent ? Model.Rows.Where(x => !x.IsSent).ToList() : Model.Rows;
                        }

                        @if (rows.Count == 0)
                        {
                            <div class="empty">현재 필터 조건에서 표시할 데이터가 없습니다.</div>
                        }
                        else
                        {
                            @foreach (var r in rows)
                            {
                                var u = r.User;
                                var fullName = u?.FullName ?? "(사용자 정보 없음)";
                                var userName = u?.UserName ?? (u?.UserId ?? "");
                                var classInfo = u != null ? $"{u.ClassYear}학년 {u.ClassBan}반" : "";
                                var avatar = !string.IsNullOrWhiteSpace(u?.ProfilePicturePath) ? u.ProfilePicturePath : "/images/common/no-image.jpg";

                                int bm = (u?.bMonth ?? 0);
                                int bd = (u?.bDay ?? 0);
                                var birthText = (bm >= 1 && bm <= 12 && bd >= 1 && bd <= 31) ? $"{bm}/{bd}" : "-";

                                // D-Day class
                                string ddayClass =
                                r.DDay <= 0 ? "dday-0" :
                                r.DDay <= 3 ? "dday-3" :
                                r.DDay <= 7 ? "dday-7" : "dday-30";

                                loopCount++;

                                var giftSrc = (r.ProductId.HasValue && r.ProductId.Value > 0)
                                ? $"/images/AwardItem/{r.ProductId.Value}.jpg"
                                : "/images/common/no-image.jpg";

                                bool canSendToggle = r.PickId.HasValue;

                                // ✅ 토글 버튼 문구/값
                                bool isSent = r.IsSent;
                                bool nextSentValue = !isSent; // 토글
                                string btnText = isSent ? "↩ 전달완료로 표시 취소" : "✅ 전달완료로 표시";
                                string btnClass = isSent ? "btn-cancel-strong" : "btn-sent";

                                <article class="item @(r.IsSent ? "sent-dim" : "")">
                                    <div class="item-top">
                                        <div class="user">
                                            <img class="avatar"
                                                 src="@avatar"
                                                 alt="profile"
                                                 onerror="this.onerror=null;this.src='/images/common/no-image.jpg';" />
                                            <div class="u-text">
                                                <div class="u-name">@loopCount. @fullName (@u?.RoleNM)</div>
                                                <div class="u-sub">
                                                    @userName
                                                    @(!string.IsNullOrWhiteSpace(classInfo) ? $" · {classInfo}" : "")
                                                </div>

                                                <div class="u-sub">
                                                    @u?.PhoneNumber
                                                </div>

                                                <div class="u-birth">
                                                    <span class="muted">생일:</span> @birthText
                                                    <span class="dday @ddayClass">🗓 D-(@r.DDay)</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end;">
                                            <span class="pill @(r.HasPickedGift ? "pill-picked" : "pill-unpicked")">
                                                @(r.HasPickedGift ? "🎁 선택완료" : "🎁 미선택")
                                            </span>
                                            <span class="pill @(r.IsSent ? "pill-sent" : "pill-unsent")">
                                                @(r.IsSent ? "🚚 전달완료" : "🚚 전달안함")
                                            </span>
                                        </div>
                                    </div>

                                    <div class="item-body">
                                        <img class="giftimg zoomable js-zoom"
                                             src="@giftSrc"
                                             alt="gift"
                                             data-title="@((r.ProductName ?? "선물 미선택") + (r.ProductId.HasValue ? $" (#{r.ProductId})" : ""))"
                                             onerror="this.onerror=null;this.src='/images/common/no-image.jpg';this.dataset.nozoom='1';" />

                                        <div>
                                            <div class="p-title">
                                                @if (!r.HasPickedGift)
                                                {
                                                    <span style="color:rgba(15,23,42,.60);">(아직 선물을 고르지 않았어요)</span>
                                                }
                                                else
                                                {
                                                    @r.ProductName
                                                    if (r.ProductId.HasValue)
                                                    {
                                                        <span class="p-id">(#@r.ProductId)</span>
                                                    }
                                                }
                                            </div>

                                            @* ✅ 추가 표시: ProductDescription / SourceType *@
                                            @if (r.HasPickedGift)
                                            {
                                                if (!string.IsNullOrWhiteSpace(r.ProductDescription))
                                                {
                                                    <div class="p-desc copyWrap">
                                                        <span>@r.ProductDescription</span>

                                                        <!-- ✅ 원문 안전 저장 -->
                                                        <textarea class="copySrc" aria-hidden="true" tabindex="-1">@r.ProductDescription</textarea>

                                                        <button type="button"
                                                                class="copyBtn"
                                                                onclick="copyText(this)"
                                                                title="설명 복사">
                                                            📋
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="p-desc" style="opacity:.7;">(설명 없음)</div>
                                                }

                                                <div class="p-meta">
                                                    <span class="pill" title="SourceType">
                                                        🏷 @(string.IsNullOrWhiteSpace(r.SourceType) ? "-" : r.SourceType)
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="p-desc">생일자가 로그인해서 선물을 선택하면 표시됩니다.</div>
                                            }
                                        </div>
                                    </div>

                                    <div class="item-foot">
                                        <div class="time">
                                            <span class="muted">생일일자</span> @r.NextBirthdayDate.ToString("yyyy-MM-dd")
                                            <span class="muted"> · (입력)</span> @birthText
                                            @if (r.SentAt.HasValue)
                                            {
                                                <span class="muted"> · 처리</span>
                                                @r.SentAt.Value.ToString("yyyy-MM-dd HH:mm")
                                            }
                                        </div>

                                        <!-- ✅ 버튼 1개 토글 -->
                                        <div class="actions">
                                            <form method="post" action="/Present/AdminBirthPickSetSent" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="pickId" value="@(r.PickId ?? 0)" />
                                                <input type="hidden" name="sent" value="@(nextSentValue ? "true" : "false")" />

                                                <!-- ✅ 목록으로 돌아올 때 filter/withinDays 유지 -->
                                                <input type="hidden" name="withinDays" value="@withinDays" />
                                                <input type="hidden" name="filter" value="@filter" />

                                                <input type="hidden" name="q" value="" />
                                                <input type="hidden" name="includeInactive" value="false" />

                                                <button type="submit"
                                                        class="btn-mini @btnClass"
                                                        @( (!canSendToggle) ? "disabled" : "" )>
                                                    @btnText
                                                </button>
                                            </form>
                                        </div>

                                        @if (!canSendToggle)
                                        {
                                            <div class="hint">※ 선물 미선택자는 발송 처리할 수 없습니다.</div>
                                        }
                                    </div>
                                </article>
                            }
                        }
                    </div>
                }
            </div>

        </div>
    </div>

    <!-- ✅ Toast -->
    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <!-- 이미지 모달 -->
    <div id="imgModal" class="modal-backdrop" aria-hidden="true">
        <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="imgModalTitle">
            <div class="modal-topbar">
                <div id="imgModalTitle" class="modal-title">이미지</div>
                <button type="button" class="modal-close" id="imgModalClose">✕ 닫기</button>
            </div>
            <div class="modal-body">
                <img id="imgModalImg" class="modal-img" src="" alt="확대 이미지" />
            </div>
        </div>
    </div>

    <script>
        // ===========================
        // ✅ Copy + Toast
        // ===========================
        let __toastTimer = null;

        function showToast(msg) {
            const t = document.getElementById("toast");
            if (!t) return;

            t.textContent = msg || "복사되었습니다";
            t.classList.add("show");

            clearTimeout(__toastTimer);
            __toastTimer = setTimeout(() => {
                t.classList.remove("show");
            }, 1400);
        }

        async function copyText(btn) {
            try {
                const wrap = btn.closest(".copyWrap");
                const ta = wrap?.querySelector(".copySrc");
                const text = ta?.value ?? "";

                if (!text) return;

                // ✅ 최신 브라우저(https, localhost)
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                } else {
                    // ✅ 폴백(구형/비보안 컨텍스트)
                    ta.focus();
                    ta.select();
                    document.execCommand("copy");
                }

                // 버튼 피드백
                const old = btn.textContent;
                btn.textContent = "✔";
                setTimeout(() => btn.textContent = old, 900);

                // ✅ Toast
                showToast("복사되었습니다");
            } catch (e) {
                alert("복사에 실패했습니다.");
            }
        }

        // ===========================
        // ✅ Image Modal
        // ===========================
        (function () {
            const modal = document.getElementById('imgModal');
            const modalImg = document.getElementById('imgModalImg');
            const modalTitle = document.getElementById('imgModalTitle');
            const closeBtn = document.getElementById('imgModalClose');

            function openModal(src, title) {
                modalImg.src = src;
                modalTitle.textContent = title || '이미지';
                modal.classList.add('open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.classList.add('modal-lock');
                closeBtn.focus();
            }

            function closeModal() {
                modal.classList.remove('open');
                modal.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('modal-lock');
                modalImg.src = '';
            }

            document.addEventListener('click', function (e) {
                const img = e.target.closest('.js-zoom');
                if (!img) return;
                if (img.dataset && img.dataset.nozoom === '1') return;

                const src = img.getAttribute('src') || '';
                if (!src) return;
                if (src.indexOf('/images/common/no-image.jpg') >= 0) return;

                const title = img.dataset ? (img.dataset.title || img.getAttribute('alt') || '이미지') : '이미지';
                openModal(src, title);
            });

            closeBtn.addEventListener('click', closeModal);

            modal.addEventListener('click', function (e) {
                if (e.target === modal) closeModal();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modal.classList.contains('open')) {
                    closeModal();
                }
            });
        })();
    </script>
</body>
</html>
