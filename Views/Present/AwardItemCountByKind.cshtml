@model List<(string ProductName, int Total, int Visible, int Hidden, DateTime? MinMod, DateTime? MaxMod, int[] PriceBands)>


@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IUserUiPreferenceService PrefSvc

@using BulletinBoard.Common;
@using BulletinBoard.Models;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Services


@{
    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    var isBasic = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Basic));
    var isModerator = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Moderator));
}

@{
    Layout = null;
    var rows = Model ?? new();
    // SuperAdmin이 아니면 숨김 항목을 집계에서 제외
    if (!isSuperAdmin)
        rows = rows.Select(r => (r.ProductName, Total: r.Visible, Visible: r.Visible, Hidden: 0, r.MinMod, r.MaxMod, r.PriceBands)).ToList();
    int total   = rows.Sum(r => r.Total);
    int visible = rows.Sum(r => r.Visible);
    int hidden  = rows.Sum(r => r.Hidden);
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>종류별 카운트</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/present-bright.css" asp-append-version="true">
    <style>.noResult { display: none; padding: 24px 0; text-align: center; font-size: 13px; color: #9CA3AF; }</style>
</head>
<body>
<div class="pw">

    <div class="pbar">
        <a href="/">← @ConstatsCommon.ToHome</a>
        <span class="adBar">
            <a href="/Present/AwardItemCountByPrice">가격대별</a>
            <a href="/Present/AwardItemAdmin">전체 목록</a>
        </span>
    </div>

    <div class="pK">잠실새내 유년부 입니다.</div>
    <h1 class="pT">종류별 카운트</h1>

    <div class="adSum">
        <span>종류 <b>@rows.Count</b></span>
        <span>전체 <b>@total</b>개</span>
        <span class="v">표시 <b>@visible</b>개</span>
        <span class="h">숨김 <b>@hidden</b>개</span>
    </div>

    <input class="adSearch" type="search" id="searchBox" placeholder="상품명 검색" oninput="doFilter(this.value)" />

    <div class="adList" id="listPanel">
        @if (!rows.Any())
        {
            <div class="adNone">데이터가 없습니다.</div>
        }
        else
        {
            int maxCnt = rows.Max(r => r.Total);
            if (maxCnt == 0) maxCnt = 1;
            string[] pbLabels = { "5천↓", "5천~1만", "1만~1.5만", "1.5만~2만", "2만~2.5만", "2.5만↑" };
            @for (int i = 0; i < rows.Count; i++)
            {
                var row   = rows[i];
                int pct   = (int)Math.Round(row.Total * 100.0 / maxCnt);
                string encName = Uri.EscapeDataString(row.ProductName);

                <a class="adRow row" href="/Present/AwardItemAdminByName?name=@encName"
                   data-name="@Html.Encode(row.ProductName.ToLowerInvariant())">
                    <span class="adNum">@(i + 1)</span>
                    <div class="adMain">
                        <span class="adName">@row.ProductName</span>
                        @if (row.PriceBands != null && row.PriceBands.Any(v => v > 0))
                        {
                            <div class="adBands">
                                @for (int pi = 0; pi < row.PriceBands.Length; pi++)
                                {
                                    if (row.PriceBands[pi] > 0)
                                    {
                                        <span class="adBand">@pbLabels[pi] @row.PriceBands[pi]</span>
                                    }
                                }
                            </div>
                        }
                    </div>
                    <div class="adRight">
                        <div class="adTrack"><div class="adFill" style="width:@pct%"></div></div>
                        <span class="adCnt">@row.Total</span>
                        <div class="adChips">
                            <span class="adChip">표시 @row.Visible</span>
                            @if (row.Hidden > 0)
                            {
                                <span class="adChip h">숨김 @row.Hidden</span>
                            }
                        </div>
                        <span class="adGo">›</span>
                    </div>
                </a>
            }
            <div class="noResult" id="noResult">검색 결과가 없습니다.</div>
        }
    </div>

    <div class="pft"><span>© 유년부 · 선물 관리</span><a href="/Present/AwardItemAdmin">전체 목록</a></div>
</div>

<script>
    function doFilter(q) {
        var val = q.trim().toLowerCase();
        var rows = document.querySelectorAll('#listPanel .row');
        var visible = 0;
        rows.forEach(function(r) {
            var name = r.dataset.name || '';
            var show = !val || name.includes(val);
            r.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        var nr = document.getElementById('noResult');
        if (nr) nr.style.display = visible === 0 ? 'block' : 'none';
    }
</script>
</body>
</html>
