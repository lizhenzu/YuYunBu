@model List<(string ProductName, int Total, int Visible, int Hidden, DateTime? MinMod, DateTime? MaxMod, int[] PriceBands)>


@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IUserUiPreferenceService PrefSvc

@using BulletinBoard.Common;
@using BulletinBoard.Models;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Services


@{
    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    var isBasic = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Basic));
    var isModerator = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Moderator));
}

@{
    Layout = null;
    var rows = Model ?? new();
    // SuperAdmin이 아니면 숨김 항목을 집계에서 제외
    if (!isSuperAdmin)
        rows = rows.Select(r => (r.ProductName, Total: r.Visible, Visible: r.Visible, Hidden: 0, r.MinMod, r.MaxMod, r.PriceBands)).ToList();
    int total   = rows.Sum(r => r.Total);
    int visible = rows.Sum(r => r.Visible);
    int hidden  = rows.Sum(r => r.Hidden);
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>종류별 카운트</title>
    <style>
        :root {
            --bg:     #f6f8ff;
            --panel:  #ffffff;
            --ink:    #0f172a;
            --muted:  #64748b;
            --line:   rgba(15,23,42,.09);
            --blue:   #2563eb;
            --r:      18px;
            --shadow: 0 16px 44px rgba(2,6,23,.09);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: "Noto Sans KR", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
            background: var(--bg);
            color: var(--ink);
            min-height: 100vh;
        }

        .wrap { max-width: 760px; margin: 0 auto; padding: 20px 14px 40px; }

        /* ── 헤더 ── */
        .hero {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: calc(var(--r) + 4px);
            box-shadow: var(--shadow);
            padding: 18px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 16px;
        }

        .heroLeft h1 { font-size: 18px; font-weight: 900; letter-spacing: -.3px; }
        .heroLeft p  { margin-top: 5px; font-size: 13px; color: var(--muted); }

        .heroRight { display: flex; gap: 8px; flex-wrap: wrap; }

        .btn {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 8px 14px; border-radius: 12px;
            font-size: 13px; font-weight: 800; font-family: inherit;
            text-decoration: none; cursor: pointer; border: none;
            transition: opacity .12s;
        }
        .btn:hover { opacity: .82; }
        .btnGhost {
            background: rgba(255,255,255,.95);
            border: 1px solid var(--line);
            color: var(--ink);
            box-shadow: 0 6px 16px rgba(2,6,23,.06);
        }

        /* ── 검색 + 요약 ── */
        .toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }

        .summary-pills { display: flex; gap: 8px; flex-wrap: wrap; }
        .summary-pill {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 7px 13px; border-radius: 999px;
            background: var(--panel); border: 1px solid var(--line);
            box-shadow: 0 6px 14px rgba(2,6,23,.05);
            font-size: 13px; font-weight: 800; color: var(--muted);
            white-space: nowrap;
        }
        .summary-pill b { font-size: 15px; }
        .pill-total   b { color: #2563eb; }
        .pill-visible b { color: #16a34a; }
        .pill-hidden  b { color: #dc2626; }

        /* 숨김/표시 칩 */
        .rowChips { display: flex; gap: 5px; flex-shrink: 0; }
        .chip {
            display: inline-flex; align-items: center; gap: 3px;
            padding: 2px 8px; border-radius: 999px;
            font-size: 11px; font-weight: 800;
            font-variant-numeric: tabular-nums; white-space: nowrap;
        }
        .chip-v { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }
        .chip-h { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; }

        /* 가격대 분포 */
        .priceBands {
            display: flex; gap: 4px; flex-wrap: wrap;
            margin-top: 4px;
        }
        .pband {
            display: inline-flex; align-items: center; gap: 3px;
            padding: 2px 7px; border-radius: 999px;
            font-size: 10px; font-weight: 800;
            font-variant-numeric: tabular-nums; white-space: nowrap;
            border: 1px solid transparent;
        }
        .pb0 { background:#ede9fe; border-color:#c4b5fd; color:#5b21b6; }
        .pb1 { background:#eff6ff; border-color:#bfdbfe; color:#1d4ed8; }
        .pb2 { background:#f0fdf4; border-color:#bbf7d0; color:#15803d; }
        .pb3 { background:#fefce8; border-color:#fde68a; color:#92400e; }
        .pb4 { background:#fff7ed; border-color:#fed7aa; color:#c2410c; }
        .pb5 { background:#fef2f2; border-color:#fecaca; color:#991b1b; }

        .searchBox {
            padding: 8px 13px;
            border: 1px solid var(--line);
            border-radius: 12px;
            font-size: 13px; font-family: inherit;
            width: 200px; outline: none;
            background: var(--panel);
            box-shadow: 0 4px 10px rgba(2,6,23,.04);
        }
        .searchBox:focus { border-color: var(--blue); }

        /* ── 리스트 패널 ── */
        .panel {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: var(--r);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        /* ── 각 행 ── */
        .row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 18px;
            border-bottom: 1px solid rgba(15,23,42,.055);
            text-decoration: none;
            color: inherit;
            transition: background .1s;
            cursor: pointer;
        }
        .row:last-child { border-bottom: none; }
        .row:hover { background: rgba(37,99,235,.05); }
        .row:hover .rowMain .rowName { color: var(--blue); }

        /* 순위 번호 */
        .rowNum {
            width: 28px; flex-shrink: 0;
            font-size: 12px; font-weight: 900; color: var(--muted);
            text-align: right;
        }

        /* 상품명 + 가격대 묶음 */
        .rowMain {
            flex: 1; min-width: 0;
            display: flex; flex-direction: column; gap: 4px;
        }

        /* 상품명 */
        .rowName {
            font-size: 14px; font-weight: 800;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            transition: color .1s;
        }

        /* 바 + 카운트 */
        .rowRight {
            display: flex; align-items: center; gap: 10px;
            flex-shrink: 0;
        }

        .bar {
            width: 120px; height: 8px;
            background: #e2e8f0; border-radius: 999px; overflow: hidden;
        }
        .barFill { height: 100%; border-radius: 999px; background: var(--blue); }

        .cnt {
            min-width: 28px; text-align: right;
            font-size: 14px; font-weight: 900; color: var(--blue);
            font-variant-numeric: tabular-nums;
        }

        .arrow {
            font-size: 13px; color: var(--muted); opacity: .5;
        }

        /* 빈 상태 */
        .empty {
            padding: 36px; text-align: center;
            color: var(--muted); font-size: 14px;
        }

        /* 결과 없음 */
        .noResult {
            padding: 24px 18px; text-align: center;
            color: var(--muted); font-size: 13px;
            display: none;
        }

        @@media (max-width: 540px) {
            .bar { display: none; }
            .rowName { font-size: 13px; }
            .searchBox { width: 140px; }
            .row { padding: 11px 12px; gap: 8px; }
            .chip { font-size: 10px; padding: 2px 6px; }
        }
    </style>
</head>
<body>
<div class="wrap">

    <div class="hero">
        <div class="heroLeft">
            <h1>📦 종류별 카운트</h1>
            <p>AwardItem 테이블 · ProductName 그룹 카운트 · 항목 클릭 시 상세 수정</p>
        </div>
        <div class="heroRight">
            <a class="btn btnGhost" href="/Present/AwardItemAdmin">← 전체 목록</a>
            <a class="btn btnGhost" href="/Present/AwardItemCountByPrice">💰 가격대별</a>
            <a class="btn btnGhost" href="/">🏠 홈</a>
        </div>
    </div>

    <div class="toolbar">
        <div class="summary-pills">
            <div class="summary-pill pill-total">종류 <b>@rows.Count</b> &nbsp;· 전체 <b>@total</b>개</div>
            <div class="summary-pill pill-visible">👁 표시 <b>@visible</b>개</div>
            <div class="summary-pill pill-hidden">🙈 숨김 <b>@hidden</b>개</div>
        </div>
        <input class="searchBox" type="search" id="searchBox"
               placeholder="상품명 검색…" oninput="doFilter(this.value)" />
    </div>

    <div class="panel" id="listPanel">
        @if (!rows.Any())
        {
            <div class="empty">데이터가 없습니다.</div>
        }
        else
        {
            int maxCnt = rows.Max(r => r.Total);
            if (maxCnt == 0) maxCnt = 1;
            @for (int i = 0; i < rows.Count; i++)
            {
                var row   = rows[i];
                int pct   = (int)Math.Round(row.Total * 100.0 / maxCnt);
                string encName = Uri.EscapeDataString(row.ProductName);

                <a class="row" href="/Present/AwardItemAdminByName?name=@encName"
                   data-name="@Html.Encode(row.ProductName.ToLowerInvariant())">
                    <span class="rowNum">@(i + 1)</span>
                    <div class="rowMain">
                        <span class="rowName">@row.ProductName</span>
                        @{
                            string[] pbLabels = { "5천↓", "5천~1만", "1만~1.5만", "1.5만~2만", "2만~2.5만", "2.5만↑" };
                        }
                        @if (row.PriceBands != null && row.PriceBands.Any(v => v > 0))
                        {
                            <div class="priceBands">
                                @for (int pi = 0; pi < row.PriceBands.Length; pi++)
                                {
                                    if (row.PriceBands[pi] > 0)
                                    {
                                        <span class="pband pb@(pi)">@pbLabels[pi] @row.PriceBands[pi]</span>
                                    }
                                }
                            </div>
                        }
                    </div>
                    <div class="rowRight">
                        <div class="bar">
                            <div class="barFill" style="width:@pct%"></div>
                        </div>
                        <span class="cnt">@row.Total</span>
                        <div class="rowChips">
                            <span class="chip chip-v">👁 @row.Visible</span>
                            @if (row.Hidden > 0)
                            {
                                <span class="chip chip-h">🙈 @row.Hidden</span>
                            }
                        </div>
                        <span class="arrow">›</span>
                    </div>
                </a>
            }
            <div class="noResult" id="noResult">검색 결과가 없습니다.</div>
        }
    </div>

</div>

<script>
    function doFilter(q) {
        var val = q.trim().toLowerCase();
        var rows = document.querySelectorAll('#listPanel .row');
        var visible = 0;
        rows.forEach(function(r) {
            var name = r.dataset.name || '';
            var show = !val || name.includes(val);
            r.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        var nr = document.getElementById('noResult');
        if (nr) nr.style.display = visible === 0 ? 'block' : 'none';
    }
</script>
</body>
</html>
