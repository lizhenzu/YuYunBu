@model BulletinBoard.Models.AwardItem
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@inject IAuthService AuthService

@{
    Layout = null;

    var returnUrl = ViewBag.ReturnUrl as string ?? "/Present/ListPresent?productDisplayOpton=display";

    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));

    bool canSeePrice = isSuperAdmin || isAdmin;
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <title>상품 상세</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        :root {
            --bg: #0b1220;
            --panel: rgba(255,255,255,.94);
            --text: #0b1220;
            --muted: rgba(2,6,23,.65);
            --line: rgba(2,6,23,.12);
            --radius: 22px;
            --shadow: 0 24px 70px rgba(0,0,0,.25);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: radial-gradient(900px 600px at 15% 10%, rgba(56,189,248,.22), transparent 60%), radial-gradient(900px 600px at 85% 15%, rgba(34,197,94,.18), transparent 60%), linear-gradient(180deg, #050914, #0b1220);
            font-family: system-ui, -apple-system, Segoe UI, Roboto, "Noto Sans KR", Arial, sans-serif;
            color: #fff;
            padding: 18px;
        }

        .wrap {
            max-width: 980px;
            margin: 0 auto;
        }

        .card {
            background: var(--panel);
            color: var(--text);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 16px;
            border-bottom: 1px solid var(--line);
        }

        .title {
            font-size: 1.2rem;
            font-weight: 1000;
        }

        .btn-back {
            border: 1px solid var(--line);
            background: rgba(255,255,255,.9);
            border-radius: 999px;
            padding: 8px 12px;
            font-weight: 900;
            cursor: pointer;
        }

            .btn-back:hover {
                filter: brightness(1.02);
            }

        .content {
            display: grid;
            grid-template-columns: 420px 1fr;
            gap: 20px;
            padding: 18px;
        }

        @@media (max-width: 860px) {
            .content {
                grid-template-columns: 1fr;
            }
        }

        .imgbox {
            border-radius: 18px;
            overflow: hidden;
            border: 1px solid var(--line);
            background: #f3f6fb;
        }

            .imgbox img {
                width: 100%;
                aspect-ratio: 1/1;
                object-fit: cover;
                display: block;
            }

        .info {
            display: grid;
            gap: 12px;
        }

        .name {
            font-size: 1.4rem;
            font-weight: 1100;
        }

        .desc {
            color: var(--muted);
            line-height: 1.55;
            font-weight: 700;
        }

        .row {
            display: grid;
            grid-template-columns: 140px 1fr;
            gap: 10px;
            padding: 10px 0;
            border-bottom: 1px dashed var(--line);
        }

        .label {
            font-weight: 900;
            color: rgba(2,6,23,.75);
        }

        .value {
            font-weight: 800;
        }

        .price {
            font-size: 1.1rem;
            font-weight: 1100;
            color: #065f46;
        }

        .priceLock {
            color: #9ca3af;
            font-weight: 900;
        }

        .footer {
            padding: 16px;
            border-top: 1px solid var(--line);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }
    </style>
</head>

<body>
    <div class="wrap">
        <div class="card">

            <!-- 🔝 상단 -->
            <div class="topbar">
                <div class="title">🎁 상품 상세</div>
                <button class="btn-back" onclick="location.href='@returnUrl'">
                    ← 돌아가기
                </button>
            </div>

            <!-- 📦 본문 -->
            <div class="content">

                <!-- 이미지 -->
                <div class="imgbox">
                    <img src="/images/AwardItem/@(@Model.ProductID).jpg"
                         onerror="this.onerror=null;this.src='/images/common/no-image.jpg';"
                         alt="상품 이미지" />
                </div>

                <!-- 정보 -->
                <div class="info">

                    <div class="name">@Model.ProductName</div>

                    <div class="desc">
                        @Model.ProductDescription
                    </div>

                    <div class="row">
                        <div class="label">상품 ID</div>
                        <div class="value">@Model.ProductID</div>
                    </div>
                    @if (canSeePrice)
                    {
                    <div class="row">
                        <div class="label">Source</div>
                        <div class="value">@Model.SourceType</div>
                    </div>
                    }

                    <div class="row">
                        <div class="label">필요 포인트</div>
                        <div class="value">@Model.PointRequirement</div>
                    </div>

                    <div class="row">
                        <div class="label">가격</div>
                        <div class="value">
                            @if (canSeePrice)
                            {
                                <span class="price">💰 @Model.UnitPrice.ToString("N0") 원</span>
                            }
                            else
                            {
                                // <span class="priceLock">🔒 관리자만 확인 가능</span>
                            }
                        </div>
                    </div>

                </div>
            </div>

            <!-- 🔚 하단 -->
            <div class="footer">
                <button class="btn-back" onclick="location.href='@returnUrl'">
                    ← 목록으로 돌아가기
                </button>
            </div>

        </div>
    </div>
</body>
</html>
