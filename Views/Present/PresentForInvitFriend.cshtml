@using BulletinBoard.Common;
@using BulletinBoard.Helpers;

@*  ══════════════════════════════════════════════════════════════
    전도(새친구 초대) 감사 · 선물 안내 — 아이와 부모님께 드리는 편지 한 장.
    Bone(호텔 인쇄물) 스킨.  (예전 숨기기 버튼은 이 화면에서 동작하지 않았으므로 뺐다.)
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
    var urlPick = "/Present/ListPresent?productDisplayOpton=newComer";
    var today = DateHelper.GetKoreaNow();
    string dateText = today.ToString("yyyy.MM.dd") + " " + today.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture).ToUpperInvariant();
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>새친구 초대 감사 — @ConstatsCommon.MainKeyTitle</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/present-bright.css" asp-append-version="true">
</head>
<body>

<div class="pw">
    <div>
        <div class="pbar">
            <span><a href="/">← @ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/Present/Kind">선물 목록</a></span>
            <span>@dateText</span>
        </div>

        <div class="pK">새친구 초대 감사</div>
        <h1 class="pT">새친구를 데려와 준<br />우리 친구에게 정말 고마워요</h1>

        <p class="ltP">
            <b>친구를 교회에 초대해 준 마음</b>은 하나님께서 참 기뻐하실 거예요.<br />
            용기 내서 "같이 가자!" 해준 너의 따뜻한 마음이<br />
            새친구에게는 큰 선물이 되었어요.
        </p>

        <div class="ltMarks">
            <span>하나님이 기뻐하시는 초대</span>
            <span>따뜻한 환영과 배려</span>
            <span>다음 주도 함께 와요</span>
        </div>

        <div class="psec"><div class="psecT">부모님께 드리는 짧은 안내</div></div>
        <p class="ltP" style="font-size:13.5px">
            아이가 새친구를 초대해 함께 예배드릴 수 있도록 도와주셔서 진심으로 감사합니다.<br />
            유년부는 새친구가 낯설지 않도록 <b>환영</b>하고, <b>안전</b>하게 돌보며,
            <b>아이들의 눈높이</b>에 맞춘 예배와 활동으로 함께하겠습니다.
        </p>
        <div class="ltNote">새친구가 다음 주에도 편하게 올 수 있도록, 따뜻한 격려 한마디를 부탁드려요.</div>

        <div class="psec"><div class="psecT">선물 고르는 방법</div></div>
        <ol class="ltSteps">
            <li><b>01</b><span>아래 <em>전도 선물 고르러 가기</em>로 들어가서 선물을 골라 주세요.</span></li>
            <li><b>02</b><span>선택이 끝나면 <em>완료 화면을 캡처</em>해 주세요.</span></li>
            <li><b>03</b><span>캡처한 이미지를 <em>교회 담임선생님</em>께 보내 주시면, 이번 주에 전도 선물을 준비해 아이에게 전달해 드립니다.</span></li>
        </ol>
        <div class="ltNote">작은 확인을 위해 캡처를 부탁드려요. 번거로우시겠지만 협조해 주시면 감사하겠습니다.</div>

        <div class="ltActs">
            <a class="ltBtn" href="@urlPick">전도 선물 고르러 가기 →</a>
            <a class="ltBtn line" href="/">유년부 홈으로</a>
        </div>

        <div class="ltQuote">
            <div class="ltQk">짧은 축복 문장</div>
            하나님, 우리 아이가 친구를 사랑으로 초대한 마음을 기뻐 받아 주세요.<br />
            새친구가 교회에서 기쁘고 편안한 시간을 보내고, 예수님을 알아가는 은혜를 누리게 해 주세요. 아멘.
        </div>

        <div class="pft"><span>© 유년부 · 새친구 초대</span><a href="/Present/Kind">선물 목록</a></div>

    </div>
</div>

</body>
</html>
