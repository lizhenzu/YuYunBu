@using BulletinBoard.Common;
@using BulletinBoard.Helpers;

@*  ══════════════════════════════════════════════════════════════
    새친구 등반 축하 · 선물 안내 — 부모님께 드리는 짧은 편지 한 장.
    Bone(호텔 인쇄물) 스킨.  (예전 숨기기 버튼은 이 화면에서 동작하지 않았으므로 뺐다.)
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
    var urlPick = "/Present/ListPresent?productDisplayOpton=newComer";
    var today = DateHelper.GetKoreaNow();
    string dateText = today.ToString("yyyy.MM.dd") + " " + today.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture).ToUpperInvariant();
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>새친구 등반 축하 — @ConstatsCommon.MainKeyTitle</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/present-bright.css" asp-append-version="true">
</head>
<body>

<div class="pw">
    <div>
        <div class="pbar">
            <span><a href="/">← @ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/Present/Kind">선물 목록</a></span>
            <span>@dateText</span>
        </div>

        <div class="pK">새친구 등반 축하</div>
        <h1 class="pT">새친구와 어머님께<br />진심으로 감사드립니다</h1>

        <p class="ltP">
            <b>유년부</b>에 아이를 보내주셔서 진심으로 감사합니다.<br />
            벌써 <b>4주째</b> 함께 예배하며 걸어와 주셔서 정말 기쁘고,<br />
            이번 주 <b>등반</b>을 하게 된 것도 마음 다해 축하드립니다.
        </p>

        <div class="ltMarks">
            <span>등반 선물 준비</span>
            <span>선택 후 캡처 전송</span>
            <span>이번 주 아이에게 전달</span>
        </div>

        <div class="psec"><div class="psecT">선물 고르는 방법</div></div>
        <ol class="ltSteps">
            <li><b>01</b><span>아래 <em>등반 선물 고르러 가기</em>로 들어가서 선물을 골라 주세요.</span></li>
            <li><b>02</b><span>선택이 끝나면 <em>완료 화면을 캡처</em>해 주세요.</span></li>
            <li><b>03</b><span>캡처한 이미지를 <em>교회 담임선생님</em>께 보내 주시면, 이번 주에 등반 선물을 준비해 아이에게 전달해 드립니다.</span></li>
        </ol>
        <div class="ltNote">작은 확인을 위해 캡처를 부탁드려요. 번거로우시겠지만 협조해 주시면 감사하겠습니다.</div>

        <div class="ltActs">
            <a class="ltBtn" href="@urlPick">등반 선물 고르러 가기 →</a>
            <a class="ltBtn line" href="/">유년부 홈으로</a>
        </div>

        <div class="pft"><span>© 유년부 · 새친구</span><a href="/Present/Kind">선물 목록</a></div>

    </div>
</div>

</body>
</html>
