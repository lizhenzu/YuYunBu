@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@*  ══════════════════════════════════════════════════════════════
    퀴즈 출제 방법 — 2026-10-04 시안 확정 (DailyMission4 밝은 흰색 · 공용 wwwroot/css/quiz-bright.css)
    · 주소는 그대로.  "퀴즈뱅크에서 가져오기" 는 예전처럼 숨겨 둔다(아래 주석을 풀면 다시 보인다)
    · 이전 화면은 BranchQuestionMethod.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
    string kind = ViewBag.KindData as string ?? "";
    string KindStrnig = kind == QuizCategory.Broad.ToString() ? "돌발" : "일반";
    string whenRaw = ViewBag.WhenDate as string ?? "";
    DateTime when;
    bool hasWhen = DateTime.TryParse(whenRaw, out when);
    string[] dayKor = { "일", "월", "화", "수", "목", "금", "토" };
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>@KindStrnig 퀴즈 출제 방법</title>
    <link rel="stylesheet" href="/css/quiz-bright.css" asp-append-version="true">
    <style>body { margin: 0; background: #FFFFFF; }</style>
</head>
<body>
<div class="qb">

    <div class="qb-top">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/Question/Index?KindData=@kind">퀴즈</a><span class="sep">›</span>출제</span>
        <span>QUIZ</span>
    </div>

    <div class="qb-k">NEW QUIZ · @KindStrnig</div>
    <h1 class="qb-h1">어떻게 출제할까요</h1>

    @if (hasWhen)
    {
        <div class="qb-date"><span class="c"><small>@(when.Month)월</small><b>@when.Day</b></span><span class="t">출제일<b>@when.ToString("yyyy년 M월 d일") @(dayKor[(int)when.DayOfWeek])요일</b></span></div>
    }

    <div class="qb-sec">출제 방법</div>
    <a class="qb-row" href="/Question/BranchQuestionType?KindData=@kind&WhenDate=@whenRaw">
        <span class="n">01</span>
        <span class="t"><b>@KindStrnig 퀴즈 새로 만들기</b><small>유형을 고르고 문제를 직접 써요</small></span>
        <span class="g">›</span>
    </a>

    @* 퀴즈뱅크에서 가져오기 — 필요시 주석 해제
    <a class="qb-row" href="/Question/FromTemplate?KindData=@kind&WhenDate=@whenRaw">
        <span class="n">02</span>
        <span class="t"><b>@KindStrnig 퀴즈뱅크에서 고르기</b><small>오늘 말씀에 맞는 문제를 골라 등록해요</small></span>
        <span class="g">›</span>
    </a>
    *@

    <div class="qb-ft">
        <span>@KindStrnig 퀴즈</span>
        <span><a href="/Question/Index?KindData=@kind">퀴즈 달력</a><a href="#" onclick="history.back(); return false;">뒤로</a><a href="/">@ConstatsCommon.ToHome</a></span>
    </div>
</div>
</body>
</html>
