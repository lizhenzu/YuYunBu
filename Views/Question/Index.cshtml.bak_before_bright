@model BulletinBoard.Models.CalendarViewModel
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = "_Layout_Quiz";
}


<script>
    var globalID = "";
    var questionType = "";
    var selectedDate = null;
</script>
<script src="/js/common2.js"></script>
<div class="container">
    <div class="header">
        <h1 id="year">@Model.CurrentDate.Year</h1>
        <h2 id="month">@Model.CurrentDate.ToString("MMMM")</h2>
        @if (ViewBag.KindData != null && ViewBag.KindData == QuizCategory.Broad.ToString())
        {
            <h3 id="desc">돌발퀴즈 출제</h3>
        }
        else
        {
            <h3 id="desc">일반 퀴즈 출제</h3>
        }
    </div>
    <div class="calendar-controls">
        <button onclick="prevMonth('@ViewBag.PrevDateTime')">이전달</button>
        <button onclick="goToToday('@ViewBag.NowDateTime')">오늘</button>
        <button onclick="nextMonth('@ViewBag.NextDateTime')">다음달</button>
    </div>
    <div class="calendarLegend">
        <div class="day has-event">퀴즈생성됨</div>
        <div class="day">퀴즈생성안됨</div>
    </div>
    <div class="calendar">
        <div style="background: #FFEBCD;">일</div>
        <div style="background: #FFEBCD;">월</div>
        <div style="background: #FFEBCD;">화</div>
        <div style="background: #FFEBCD;">수</div>
        <div style="background: #FFEBCD;">목</div>
        <div style="background: #FFEBCD;">금</div>
        <div style="background: #FFEBCD;">토</div>
    </div>
    <div class="calendar" id="calendar">
        <!-- Calendar will be generated by JavaScript -->
    </div>
    <div class="events">
        <div id="event-details" style="text-align: center;">위 달력 일자를 눌러서 퀴즈를 확인 하세요.</div>
        <div id="event-details-guide" class="guide" style="display:none;"></div>
        <div class="buttons">
            <div class="button new-reminder"        id="modify-button" onclick="modifyQuestion()" style="display:none;">퀴즈 수정</div>
            <div class="button new-reminder-delete" id="delete-button" onclick="deleteQuestion()" style="display:none;">퀴즈 삭제</div>
            <div class="button choice"              id="preview-button" onclick="PreViewQuestion()" style="display:none;">퀴즈 미리보기</div>
            <div class="button new-reminder"        id="add-button" onclick="AddQuestion()" style="display:none;">퀴즈 입력</div>
        </div>

        @await Html.PartialAsync("_Layout_Quiz_NavigationButton", @ViewBag.KindData as string)

    </div>
</div>


<script>

    function modifyQuestion() {
        window.location.href = "/Question/ModifyQuiz?Id=" + globalID;
    }
    async function deleteQuestion() {

        let result = await confirmMessage(true, ['이 퀴즈를 삭제 할까요?'], null, '진행'); // 취소 버튼 표시
        if (result === 'y') {

            window.location.href = "/Question/DeleteQuestion?Id=" + globalID;

        } else if (result === 'c') {
            //  alert('취소 버튼을 눌렀습니다. 작업을 취소합니다.');
            // 작업 취소 로직
            return;
        }
       
    }

    function AddQuestion() {
        if (selectedDate) {
            // 하루 더하던 보정을 없앴으므로 여기서도 고른 날짜를 그대로 읽는다
            var todayDate = toYmdLocal(selectedDate);
            window.location.href = "/Question/BranchQuestionMethod?KindData=@ViewBag.KindData&WhenDate=" + todayDate;
        }
    }

    // 달력에서 고른 날짜를 그대로 YYYY-MM-DD 로 만든다.
    // toISOString() 은 UTC 로 바꿔 버려서 한국 시간 기준 하루 전으로 밀린다.
    // (예전에는 그걸 하루 더해서 메우고 있었다)
    function toYmdLocal(d) {
        var y  = d.getFullYear();
        var m  = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        return y + '-' + m + '-' + dd;
    }

    function PreViewQuestion() {
        if (selectedDate) {
            var formattedDate = toYmdLocal(selectedDate);
            window.location.href = "/DailyMission2/Quiz?date=" + formattedDate;
        }
    }

    const monthNames = ["1월", "2월", "3월", "4월", "5월", "6월", "7월", "8월", "9월", "10월", "11월", "12월"];
    let currentDate = new Date(@Model.CurrentDate.Year, @Model.CurrentDate.Month - 1, @Model.CurrentDate.Day);
    let events = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(@Model.Events));

    function renderCalendar(date) {
        const year = date.getFullYear();
        const month = date.getMonth();
        document.getElementById("year").textContent = year;
        document.getElementById("month").textContent = monthNames[month];

        const firstDayOfMonth = new Date(year, month, 1).getDay();
        const lastDateOfMonth = new Date(year, month + 1, 0).getDate();

        const calendar = document.getElementById("calendar");
        calendar.innerHTML = "";

        for (let i = 0; i < firstDayOfMonth; i++) {
            const emptyCell = document.createElement("div");
            calendar.appendChild(emptyCell);
        }

        for (let i = 1; i <= lastDateOfMonth; i++) {
            const dayCell = document.createElement("div");
            dayCell.textContent = i;
            dayCell.className = "day";
            const cellDate = new Date(year, month, i);
            const event = events.find(e => new Date(e.Date).toDateString() === cellDate.toDateString());
            dayCell.onclick = () => {
                // ⚠️ cellDate 를 그대로 넘기면 selectedDate 가 달력 칸의 날짜 객체를
                //    가리키게 되어, 누군가 날짜를 바꾸면 그 칸이 영영 바뀌어 버린다.
                //    복사본을 만들어 칸의 원본을 지킨다.
                selectedDate = new Date(cellDate);
                if (event) {
                    showEventDetails(event);
                } else {
                    showAddButton(selectedDate);
                }
            };
            if (event) {
                dayCell.className += " has-event";
            }
            if (i === currentDate.getDate() && month === currentDate.getMonth() && year === currentDate.getFullYear()) {
                dayCell.className += " selected";
            }
            calendar.appendChild(dayCell);
        }
    }

    function showEventDetails(event) {
        console.log("event ", event);
        const eventDetails = document.getElementById("event-details");

        var data = `<div class="event">`;
        data = data + `<div style="text-align: left;">${event.Title} ${event.QuestionData.QuestionTypeDesc}</div>`;
        data = data + `<div>&nbsp; </div>`;
        data = data + `<div class="formatted-text" style="text-align: left;">${event.Description}</div>`;
        data = data + `<div>&nbsp; </div>`;
        if (event.QuestionData.QuestionType == 'O' || event.QuestionData.QuestionType == 'o') {
            data = data + `<div style="text-align: left;">&nbsp; 1)${event.QuestionData.Question1}</div>`;
            data = data + `<div style="text-align: left;">&nbsp; 2)${event.QuestionData.Question2}</div>`;
            data = data + `<div style="text-align: left;">&nbsp; 3)${event.QuestionData.Question3}</div>`;
            data = data + `<div style="text-align: left;">&nbsp; 4)${event.QuestionData.Question4}</div>`;
            eventDetailsGuide = document.getElementById("event-details-guide");
            eventDetailsGuide.style.display = "none";
        }
        else {
            eventDetailsGuide = document.getElementById("event-details-guide");
            eventDetailsGuide.style.display = "block";
            guideDaa = `<div style="text-align: center;">♡♡♡답변가이드♡♡♡</div>`;
            eventDetailsGuide.innerHTML = guideDaa + `<div style="text-align: left;">${event.QuestionData.AnswerGuide}</div>`;
        };
        data = data + `<div style="text-align: left;">&nbsp; 정답 : ${event.QuestionData.CorrectAnswer}</div>`;
        data = data + `</div>`;
        eventDetails.innerHTML = data;

        globalID = event.QuestionData.Id;
        questionType = event.QuestionData.QuestionType;

        const modifyButton = document.getElementById("modify-button");
        const deleteButton = document.getElementById("delete-button");
        const previewButton = document.getElementById("preview-button");
        const addButton = document.getElementById("add-button");

        if (modifyButton && addButton) {
            modifyButton.style.display = "block";
            deleteButton.style.display = "block";
            previewButton.style.display = "block";
            addButton.style.display = "none";
        }
    }

    function showAddButton() {
        const eventDetails = document.getElementById("event-details");

        // ⚠️ 예전에는 여기서 selectedDate 를 하루 더해 놓았다.
        //    toISOString() 이 UTC 로 밀리는 것을 메우려던 것인데,
        //    고른 날짜 자체를 바꿔 버려서 같은 날을 누를 때마다 하루씩 늘어났다.
        //    이제는 값을 건드리지 않고 그대로 읽는다.
        var todayDate = toYmdLocal(selectedDate);
        eventDetails.innerHTML = `<div style="text-align: center;">${todayDate}일자에 퀴즈가 없습니다.</div><div style="text-align: center;">아래 퀴즈입력 버튼 눌러서 ${todayDate}일자에 새로운 퀴즈를 추가할 수 있습니다.</div>`;

        const modifyButton = document.getElementById("modify-button");
        const deleteButton = document.getElementById("delete-button");
        const previewButton = document.getElementById("preview-button");
        const addButton = document.getElementById("add-button");

        console.log("modifyButton:", modifyButton);
        console.log("addButton:", addButton);

        if (modifyButton && addButton) {
            modifyButton.style.display = "none";
            deleteButton.style.display = "none";
            previewButton.style.display = "none";
            addButton.style.display = "block";
        }
    }

    function prevMonth(va) {
        //currentDate.setMonth(currentDate.getMonth() - 1);
        //renderCalendar(currentDate);
        window.location.href = "/Question/Index?selectedDate=" + va;
    }

    function nextMonth(va) {
        //currentDate.setMonth(currentDate.getMonth() + 1);
        //renderCalendar(currentDate);
        window.location.href = "/Question/Index?selectedDate=" + va;
    }

    function goToToday(va) {
        //currentDate = new Date();
        //renderCalendar(currentDate);
        window.location.href = "/Question/Index?selectedDate=" + va;
    }

    renderCalendar(currentDate);

</script>

