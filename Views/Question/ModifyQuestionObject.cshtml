@model BulletinBoard.Models.QuestionTypeDataObject

<style>
    label {
        margin-right: 20px; /* 오른쪽 마진으로 라벨 사이의 간격 조정 */
    }
</style>

@await Html.PartialAsync("_HeadTitle2", new TitleBox{ TitleHead = $"객관식", TitleBody = "성경퀴즈 수정"})

<form asp-action="UpdateQuestionObject" method="post" >
    <div asp-validation-summary="All" class="text-danger"></div>

    @await Html.PartialAsync("_QuestionObjectPartial",Model)


    <div class="button-container-horizontal">
        <div class="button-click-division" onclick="goURL('/Question/QuestionDetailList')">목록</div>
        <div class="button-click-division" onclick="goURL('/Question/BranchQuestionType')">이전화면</div>
        <div class="button-click-division" onclick="sendPostRequest()">제출</div>
    </div>
    <button type="submit" class="pretty-button" id="submitButton" style="display:none;">제출</button>
</form>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

<script>
    function goURL(url) {
        window.location.href = url;
    }
    function sendPostRequest() {
        document.getElementById('submitButton').click(); // submit 버튼 클릭 효과
    }
</script>
