@model IEnumerable<BulletinBoard.Models.QuestionTypeDataObjects>
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@*  ══════════════════════════════════════════════════════════════
    퀴즈 목록 — 2026-10-04 시안 확정 (DailyMission4 밝은 흰색 · 공용 wwwroot/css/quiz-bright.css)
    · 예전 _Layout_Mission 대신 단독 화면.  수정 · 삭제 주소는 그대로 (삭제는 확인창을 거친다)
    · 이전 화면은 QuestionDetailList.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
    string kind = ViewBag.KindData as string ?? "";
    bool isBroad = kind == QuizCategory.Broad.ToString();
    string kindName = isBroad ? "돌발" : "일반";
    var list = Model?.ToList() ?? new List<BulletinBoard.Models.QuestionTypeDataObjects>();

    string TypeName(string? t) => (t ?? "").ToLower() switch { "o" => "객관식", "a" => "O/X", _ => "주관식" };
    string TypeCls(string? t)  => (t ?? "").ToLower() switch { "o" => "o", "a" => "x", _ => "" };
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#FFFFFF">
    <title>@(kindName) 퀴즈 목록</title>
    <link rel="stylesheet" href="/css/quiz-bright.css" asp-append-version="true">
    <style>body { margin: 0; background: #FFFFFF; }</style>
</head>
<body>
<div class="qb">

    <div class="qb-top">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span>퀴즈</span>
        <span>QUIZ</span>
    </div>

    <div class="qb-k">QUIZ</div>
    <h1 class="qb-h1">퀴즈 목록<small>@kindName · @(list.Count)개</small></h1>
    <div class="qb-sub">출제한 퀴즈를 날짜순으로 보여요</div>

    <div class="qb-chips">
        <a class="on" href="/Question/QuestionDetailList?KindData=@kind">목록</a>
        <a href="/Question/Index?KindData=@kind">달력</a>
    </div>

    @if (list.Count == 0)
    {
        <div class="qb-empty">아직 출제한 퀴즈가 없어요</div>
    }

    @foreach (var item in list)
    {
        string t = (item.QuestionType ?? "").ToLower();
        <div class="qb-q">
            <div class="h"><b>@item.ExposeDate.ToString("M월 d일") @(item.WeekDayKor)요일</b><span class="qb-tg @TypeCls(t)">@TypeName(t)</span></div>
            <p>@item.QuestionQ</p>
            @if (t == "o")
            {
                <ol>
                    <li class="@(item.CorrectAnswer == "1" ? "ans" : "")">@item.Question1@(item.CorrectAnswer == "1" ? " · 정답" : "")</li>
                    <li class="@(item.CorrectAnswer == "2" ? "ans" : "")">@item.Question2@(item.CorrectAnswer == "2" ? " · 정답" : "")</li>
                    <li class="@(item.CorrectAnswer == "3" ? "ans" : "")">@item.Question3@(item.CorrectAnswer == "3" ? " · 정답" : "")</li>
                    <li class="@(item.CorrectAnswer == "4" ? "ans" : "")">@item.Question4@(item.CorrectAnswer == "4" ? " · 정답" : "")</li>
                </ol>
            }
            else
            {
                <div class="ans-line">정답 @item.CorrectAnswer</div>
            }
            <div class="ac">
                <a href="/Question/ModifyQuiz?Id=@item.Id">수정</a>
                <button type="button" class="d" data-del="@item.Id">삭제</button>
            </div>
        </div>
    }

    <div class="qb-ft">
        <span>@kindName 퀴즈</span>
        <span><a href="/Question/Index?KindData=@kind">퀴즈 달력</a><a href="/HumanResource/ManageUserInfo">정보 관리</a><a href="/">@ConstatsCommon.ToHome</a></span>
    </div>
</div>

<script src="/js/common2.js"></script>
<script>
    // 삭제 — 예전에는 확인 없이 바로 지웠다. 달력 화면과 같은 확인창을 거친다.
    document.addEventListener('click', async function (e) {
        var b = e.target.closest('[data-del]');
        if (!b) return;
        var go = true;
        if (typeof confirmMessage === 'function') {
            go = (await confirmMessage(true, ['이 퀴즈를 삭제 할까요?'], null, '진행')) === 'y';
        } else {
            go = confirm('이 퀴즈를 삭제 할까요?');
        }
        if (go) location.href = '/Question/DeleteQuestion?Id=' + b.getAttribute('data-del');
    });
    function redirectToPage(URL) { window.location.href = URL; }
</script>
</body>
</html>
