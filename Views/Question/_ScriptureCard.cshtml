@using BulletinBoard.Models
@using BulletinBoard.Helpers
@*  ══════════════════════════════════════════════════════════════
    "오늘의 말씀" 카드 + 구절 복사 아이콘 (CreateQuizByBank · FromTemplate 공용)
    · 아이콘을 누르면 화면에 보이는 구절 위치만 복사한다 (예: 고린도후서 11장 16절 ~ 11장 33절)
    · 복사 스타일과 스크립트는 _CopyButtonAssets 에 있다
    · 2026-11-05: ViewBag.QuizAiDate 가 있으면(직접 작성 · 객관식) 옆에 AI 버튼 — 구절 · 날짜를 채운 프람프트를 복사한다
    ══════════════════════════════════════════════════════════════ *@
@{
    TodayWordToReads? word = ViewBag.TodayWordToReads as TodayWordToReads;

    string range = word == null ? "" : $"{word.BibleText} {word.FromJang}장 {word.FromZul}절 ~ {word.ToJang}장 {word.ToZul}절";

    string? quizAiDate = ViewBag.QuizAiDate as string;
    string? aiPrompt = (word != null && !string.IsNullOrEmpty(quizAiDate)) ? QuizAiPromptHelper.Build(ViewBag.QuizAiTemplate as string, range, quizAiDate) : null;
}
@if (word != null)
{
    @await Html.PartialAsync("_CopyButtonAssets")

    <div class="qb-scr">
        <i>오늘의 말씀</i>
        <b>@word.BibleSubject</b>
        <div class="rg">
            <small>@range</small>
            <button type="button" class="qb-cp" id="qbCopyBtn" aria-label="구절 복사" title="구절 복사" data-copy="@range" onclick="qbCopyScripture(this)">
                <svg class="cp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
                <svg class="ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
            </button>
            @if (aiPrompt != null)
            {
                <button type="button" class="qb-cp ai" aria-label="AI 프람프트 복사" title="AI 프람프트 복사" data-copy="@aiPrompt" onclick="qbCopyScripture(this)">
                    <span class="cp">AI</span>
                    <svg class="ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                </button>
            }
        </div>
    </div>


}
