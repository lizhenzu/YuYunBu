@model BulletinBoard.Models.QuestionBankData


@{
    Layout = "_Layout_Quiz";
}

<div class="container">

    @await Html.PartialAsync("_PublisheQuizHeader", "퀴즈를 수정합니다." )

    <br />


    <form asp-action="ModifyQuestionBankProcess" method="post" style="margin:15px;">
        <div class="form-group">
            <label asp-for="@Model.QuestionQ"></label>
            <textarea id="QuestionQ" name="QuestionQ" asp-for="QuestionQ" rows="10" autofocus style="width: 96%;"></textarea>
            <span asp-validation-for="QuestionQ" class="error"></span>
        </div>

        @if (@Model.QuestionType.ToLower() == "o")
        {
            <div class="form-group">
                <label asp-for="@Model.Question1"></label>
                <input type="text" id="Question1" name="Question1" asp-for="Question1" style="width: 96%;">
                <span asp-validation-for="Question1" class="error"></span>
            </div>
            <div class="form-group">
                <label asp-for="@Model.Question2"></label>
                <input type="text" id="Question2" name="Question2" asp-for="Question2" style="width: 96%;" />
                <span asp-validation-for="Question2" class="error"></span>
            </div>
            <div class="form-group">
                <label asp-for="@Model.Question3"></label>
                <input type="text" id="Question3" name="Question3" asp-for="Question3" style="width: 96%;">
                <span asp-validation-for="Question3" class="error"></span>
            </div>
            <div class="form-group">
                <label asp-for="@Model.Question4"></label>
                <input type="text" id="Question4" name="Question4" asp-for="Question4">
                <span asp-validation-for="Question4" class="error"></span>
            </div>
            <div class="form-group">
                <label asp-for="CorrectAnswer"></label>
                <div class="radio-group">
                    <label><input type="radio" name="CorrectAnswer" value="1" asp-for="CorrectAnswer"> 1</label>
                    <label><input type="radio" name="CorrectAnswer" value="2" asp-for="CorrectAnswer"> 2</label>
                    <label><input type="radio" name="CorrectAnswer" value="3" asp-for="CorrectAnswer"> 3</label>
                    <label><input type="radio" name="CorrectAnswer" value="4" asp-for="CorrectAnswer"> 4</label>
                </div>
                <span asp-validation-for="CorrectAnswer" class="error"></span>
            </div>
        }
        else
        {
            <div class="form-group">
                <label asp-for="CorrectAnswer"></label>
                <input asp-for="CorrectAnswer" class="form-control" autofocus />
                <span asp-validation-for="CorrectAnswer" class="error"></span>
            </div>
        }

        <div class="form-group">
            <label asp-for="@Model.BibleText"></label>
            <input type="text" id="BibleText" name="BibleText" asp-for="BibleText" style="width: 96%;" />
            <span asp-validation-for="BibleText" class="error"></span>
        </div>

        <div class="form-group">
            <label asp-for="@Model.Jang"></label>
            <input type="text" id="Jang" name="Jang" asp-for="Jang" style="width: 96%;" />
            <span asp-validation-for="Jang" class="error"></span>
        </div>

        <div class="form-group">
            <label asp-for="@Model.Zul"></label>
            <input type="text" id="Zul" name="Zul" asp-for="Zul" style="width: 96%;" />
            <span asp-validation-for="Zul" class="error"></span>
        </div>

        <div class="form-group">
            <label asp-for="@Model.Zul1"></label>
            <input type="text" id="Zul1" name="Zul1" asp-for="Zul1" style="width: 96%;" />
            <span asp-validation-for="Zul1" class="error"></span>
        </div>

        <div class="buttons">

            <button type="submit" class="button enroll">퀴즈 수정</button>

        </div>
        <input type="hidden" id="QuestionType" name="QuestionType" value="@Model.QuestionType" />
        <input type="hidden" id="Id" name="Id" value="@Model.Id" />
    </form>
    @await Html.PartialAsync("_Layout_QuestionBank_NavigationButton", string.Empty)
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")
