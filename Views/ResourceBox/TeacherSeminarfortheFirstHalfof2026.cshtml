@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>교사 세미나 자료</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Pretendard", "Noto Sans KR", "Malgun Gothic", "Segoe UI", sans-serif;
            background: radial-gradient(circle at top left, rgba(56, 189, 248, 0.14), transparent 28%), radial-gradient(circle at top right, rgba(167, 139, 250, 0.16), transparent 24%), linear-gradient(180deg, #07111f 0%, #0b1220 42%, #0f172a 100%);
            color: #f8fafc;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .page {
            width: 100%;
            min-height: 100vh;
            padding: 18px 14px 28px;
        }

        .shell {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
        }

        .hero {
            position: relative;
            overflow: hidden;
            border-radius: 28px;
            padding: 24px 18px 22px;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(30, 41, 59, 0.92)), linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
            border: 1px solid rgba(255,255,255,0.08);
            box-shadow: 0 24px 60px rgba(2, 6, 23, 0.45), inset 0 1px 0 rgba(255,255,255,0.06);
        }

            .hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at 0% 0%, rgba(251, 191, 36, 0.18), transparent 24%), radial-gradient(circle at 100% 0%, rgba(96, 165, 250, 0.18), transparent 24%);
                pointer-events: none;
            }

        .hero-top {
            position: relative;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .hero-left {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            min-width: 0;
            flex: 1 1 520px;
        }

        .hero-icon {
            flex: 0 0 auto;
            width: 64px;
            height: 64px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            background: linear-gradient(135deg, rgba(251,191,36,.22), rgba(255,255,255,.08));
            border: 1px solid rgba(255,255,255,.10);
            box-shadow: 0 12px 24px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.08);
        }

        .hero-title-wrap {
            min-width: 0;
        }

        .hero-title {
            margin: 0;
            font-size: 28px;
            line-height: 1.18;
            letter-spacing: -0.03em;
            font-weight: 900;
            color: #ffffff;
        }

        .hero-subtitle {
            margin-top: 12px;
            font-size: 15px;
            line-height: 1.7;
            font-weight: 700;
            color: rgba(226, 232, 240, 0.88);
        }

        .hero-badge {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 10px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            color: #e2e8f0;
            font-size: 12px;
            font-weight: 900;
            letter-spacing: 0.14em;
            white-space: nowrap;
        }

        .hero-desc {
            position: relative;
            margin-top: 18px;
            padding: 16px 16px;
            border-radius: 20px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            color: rgba(226,232,240,.84);
            font-size: 14px;
            line-height: 1.75;
            font-weight: 600;
        }

        .grid {
            margin-top: 18px;
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .card {
            position: relative;
            overflow: hidden;
            display: block;
            width: 100%;
            border-radius: 24px;
            padding: 18px;
            background: linear-gradient(180deg, rgba(255,255,255,0.10), rgba(255,255,255,0.06));
            border: 1px solid rgba(255,255,255,0.10);
            box-shadow: 0 16px 32px rgba(2,6,23,.22), inset 0 1px 0 rgba(255,255,255,.08);
            transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

            .card::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, rgba(255,255,255,.06), transparent 45%);
                pointer-events: none;
            }

            .card:hover {
                transform: translateY(-2px);
                border-color: rgba(255,255,255,0.18);
                box-shadow: 0 22px 40px rgba(2,6,23,.28), inset 0 1px 0 rgba(255,255,255,.10);
            }

        .card-inner {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .card-icon {
            flex: 0 0 auto;
            width: 58px;
            height: 58px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
        }

        .icon-gold {
            background: linear-gradient(135deg, rgba(251,191,36,.24), rgba(245,158,11,.16));
            border: 1px solid rgba(251,191,36,.24);
        }

        .icon-blue {
            background: linear-gradient(135deg, rgba(96,165,250,.22), rgba(59,130,246,.14));
            border: 1px solid rgba(96,165,250,.24);
        }

        .icon-purple {
            background: linear-gradient(135deg, rgba(167,139,250,.22), rgba(139,92,246,.14));
            border: 1px solid rgba(167,139,250,.24);
        }

        .icon-green {
            background: linear-gradient(135deg, rgba(34,197,94,.24), rgba(22,163,74,.14));
            border: 1px solid rgba(34,197,94,.24);
        }

        .card-body {
            min-width: 0;
            flex: 1 1 auto;
        }

        .card-title {
            font-size: 20px;
            line-height: 1.3;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -0.02em;
            word-break: keep-all;
        }

        .card-text {
            margin-top: 7px;
            font-size: 14px;
            line-height: 1.7;
            color: rgba(226,232,240,.80);
            font-weight: 600;
            word-break: keep-all;
        }

        .card-arrow {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 44px;
            height: 44px;
            padding: 0 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.10);
            color: #f8fafc;
            font-size: 14px;
            font-weight: 900;
            white-space: nowrap;
        }

        .home-card {
            background: radial-gradient(circle at left top, rgba(34,197,94,.14), transparent 30%), linear-gradient(180deg, rgba(255,255,255,0.10), rgba(255,255,255,0.06));
        }

        .footer-note {
            margin-top: 16px;
            text-align: center;
            font-size: 12px;
            line-height: 1.6;
            color: rgba(226,232,240,.62);
            font-weight: 600;
        }

        @@media (min-width: 640px) {
            .page {
                padding: 24px 20px 36px;
            }

            .hero {
                border-radius: 32px;
                padding: 28px 24px 24px;
            }

            .hero-title {
                font-size: 34px;
            }

            .hero-subtitle {
                font-size: 16px;
            }

            .hero-desc {
                font-size: 15px;
                padding: 18px 18px;
            }

            .grid {
                gap: 16px;
            }

            .card {
                padding: 20px;
                border-radius: 26px;
            }

            .card-title {
                font-size: 22px;
            }

            .card-text {
                font-size: 15px;
            }
        }

        @@media (min-width: 960px) {
            .page {
                padding: 30px 24px 42px;
            }

            .hero {
                padding: 34px 32px 30px;
            }

            .hero-title {
                font-size: 40px;
            }

            .grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 18px;
            }

            .card {
                min-height: 150px;
                display: flex;
                align-items: center;
            }
        }

        @@media (max-width: 639px) {
            .hero-badge {
                width: 100%;
                justify-content: center;
            }

            .card-inner {
                align-items: flex-start;
            }

            .card-arrow {
                display: none;
            }

            .card-title {
                font-size: 19px;
            }

            .hero-title {
                word-break: keep-all;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="shell">
            <section class="hero">
                <div class="hero-top">
                    <div class="hero-left">
                        <div class="hero-icon">📘</div>

                        <div class="hero-title-wrap">
                            <h1 class="hero-title">26년도 상반기 교사세미나</h1>

                            <div class="hero-subtitle">
                                21세기 교회 교육 Paradigm<br />
                                20% 시대, 다음 100년의 신앙 전수와 부흥
                            </div>
                        </div>
                    </div>

                    <div class="hero-badge">TEACHER SEMINAR 2026</div>
                </div>

                <div class="hero-desc">
                    아래 자료를 통해 강사 육성 강의 정리, 요약 자료, 상세 자료를 확인하실 수 있습니다.
                    모바일에서도 보기 편하도록 넓고 시원한 카드형 구조로 구성했습니다.
                    필요한 자료를 눌러 바로 이동해 주세요.
                </div>

                <div class="grid">
                    <a class="card" href="https://church-edu-mission-gppoj03.gamma.site/" target="_blank" rel="noopener noreferrer" title="강사 육성강의 바로가기">
                        <div class="card-inner">
                            <div class="card-icon icon-gold">🎓</div>

                            <div class="card-body">
                                <div class="card-title">강사 육성강의 정리</div>
                                <div class="card-text">
                                    강사 육성 강의를 보기 좋게 정리한 자료입니다.
                                </div>
                            </div>

                            <div class="card-arrow">바로가기 ↗</div>
                        </div>
                    </a>

                    <a class="card" href="https://21church-education-6riye6k.gamma.site/" target="_blank" rel="noopener noreferrer" title="강사 자료(요약) 바로가기">
                        <div class="card-inner">
                            <div class="card-icon icon-blue">📝</div>

                            <div class="card-body">
                                <div class="card-title">강사 A4 자료 (요약)</div>
                                <div class="card-text">
                                    전체 흐름을 빠르게 파악할 수 있는 핵심 요약 자료입니다.
                                </div>
                            </div>

                            <div class="card-arrow">바로가기 ↗</div>
                        </div>
                    </a>

                    <a class="card" href="https://21church-education-e8o88yr.gamma.site/" target="_blank" rel="noopener noreferrer" title="강사 자료(상세) 바로가기">
                        <div class="card-inner">
                            <div class="card-icon icon-purple">📚</div>

                            <div class="card-body">
                                <div class="card-title">강사 A4 자료 (상세)</div>
                                <div class="card-text">
                                    강의 내용과 핵심 설명을 더 자세히 확인할 수 있는 상세 자료입니다.
                                </div>
                            </div>

                            <div class="card-arrow">바로가기 ↗</div>
                        </div>
                    </a>

                    <a class="card home-card" href="/" title="홈으로 가기">
                        <div class="card-inner">
                            <div class="card-icon icon-green">🏠</div>

                            <div class="card-body">
                                <div class="card-title">홈으로 가기</div>
                                <div class="card-text">
                                    메인 화면으로 이동합니다.
                                </div>
                            </div>

                            <div class="card-arrow">이동하기 ↗</div>
                        </div>
                    </a>
                </div>

                <div class="footer-note">
                    교사 세미나 자료 모음
                </div>
            </section>
        </div>
    </div>
</body>
</html>