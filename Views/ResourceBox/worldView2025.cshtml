@{
    Layout = null;
}
<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>2026 하나바이블 세계관 컨퍼런스 · 배너</title>

    <style>
        :root {
            /* ✅ 밝은 배경 톤 */
            --pageBgA: #e6edf7;
            --pageBgB: #f7f9fc;
            --ink: #0b1220;
            --muted: rgba(11,18,32,.65);
            --line: rgba(2,6,23,.10);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans KR",sans-serif;
            color: var(--ink);
            background: radial-gradient(circle at 12% 10%, rgba(255,107,129,.14), transparent 42%), radial-gradient(circle at 92% 20%, rgba(154,215,255,.22), transparent 44%), radial-gradient(circle at 40% 95%, rgba(127,231,196,.20), transparent 45%), linear-gradient(180deg, var(--pageBgA), var(--pageBgB));
        }

        /* ✅ 가운데 몰림 제거: 전체 흐름형 레이아웃 */
        .wrap {
            min-height: 100vh;
            padding: 22px 14px 34px;
        }

        /* ✅ 더 넓게(펼쳐 보이게) */
        .stage {
            width: min(1200px, 100%);
            margin: 0 auto; /* 너무 붙지 않게만 */
        }

        /* ✅ 상단 타이틀도 카드형으로 “페이지에 자연스럽게” */
        .page-title {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin: 0 0 14px;
            padding: 14px 16px;
            border-radius: 18px;
            background: rgba(255,255,255,.86);
            border: 1px solid var(--line);
            box-shadow: 0 14px 34px rgba(15,23,42,.10);
            backdrop-filter: blur(8px);
        }

            .page-title h1 {
                margin: 0;
                font-size: 1.06rem;
                letter-spacing: .02em;
                font-weight: 950;
                color: var(--ink);
            }

            .page-title .mini {
                margin-top: 4px;
                font-size: .84rem;
                font-weight: 800;
                color: var(--muted);
                line-height: 1.35;
            }

        .top-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
            align-items: center;
        }

            /* ✅ 어두운 버튼 제거 → 밝고 또렷한 버튼 */
            .top-actions a {
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: .45rem;
                padding: .44rem .88rem;
                border-radius: 999px;
                background: linear-gradient(135deg, rgba(221,231,243,.75), rgba(255,255,255,.95));
                border: 1px solid rgba(52,73,94,.20);
                color: rgba(34,49,63,.98);
                font-size: .84rem;
                font-weight: 950;
                box-shadow: 0 10px 22px rgba(15,23,42,.10);
                transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
                -webkit-tap-highlight-color: transparent;
            }

                .top-actions a:hover {
                    transform: translateY(-1px);
                    border-color: rgba(52,73,94,.35);
                    box-shadow: 0 14px 28px rgba(15,23,42,.14);
                }

        /* ✅ 모바일에서는 타이틀/버튼이 세로로 자연스럽게 */
        @@media (max-width: 720px) {
            .page-title {
                flex-direction: column;
                align-items: stretch;
            }

            .top-actions {
                justify-content: flex-start;
            }
        }

        @@media (max-width: 420px) {
            .top-actions a {
                width: 100%;
                justify-content: center;
            }
        }
    </style>

</head>
<body>
    <div class="wrap">
        <div class="stage">

            <div class="page-title">
                <div>
                    <h1>🚨 컨퍼런스 자료집</h1>
                    <div class="mini">HanaBibleConference_2026</div>
                </div>
                <div class="top-actions">
                    <a href="/" aria-label="홈으로">🏠 홈</a>
                    <a href="/HanaBible/2026/1/detail/main.html" aria-label="통합 인덱스 메인">🧭 통합 인덱스 메인</a>
                </div>
            </div>

            <div id="conference-banner-root"
                 class="conf-root js-global-cookie-section"
                 data-cookie-key="HanaBibleConference_2026"
                 data-state="checking">

                <!-- ✅ 1) 판정 중 UI: 먼저 보임 -->
                <div class="conf-boot" aria-live="polite">
                    <div class="conf-boot-card">
                        <div class="conf-boot-row">
                            <div class="conf-boot-spinner" aria-hidden="true"></div>
                            <div class="conf-boot-title">컨퍼런스 배너 표시 여부를 확인 중이에요…</div>
                        </div>
                        <div class="conf-boot-sub">잠시만요 🚨 (숨김 설정이 있으면 자동으로 감춰져요)</div>
                    </div>
                </div>

                <!-- ✅ 2) 실제 배너 콘텐츠(Show일 때만 표시) -->
                <div class="conf-content" hidden>

                    <div class="conference-banner-wrapper">

                        <div class="conference-banner">
                            <div class="conference-banner-ribbon">
                                HANA BIBLE 2026
                            </div>

                            <!-- 헤더: 왼쪽 정보 + 오른쪽 숨기기 버튼 -->
                            <div class="conference-banner-header">
                                <div class="conference-banner-main">
                                    <div class="conference-banner-label blink-strong">
                                        <span class="emoji">🚨</span>
                                        <span>다음세대 세계관 핵심 행사</span>
                                    </div>

                                    <div class="conference-banner-title">
                                        2026 하나바이블 [세계관]컨퍼런스 &amp; 사역 페스타
                                    </div>

                                    <div class="conference-banner-sub">
                                        2025년 5과정 2학기, 2026년 6과정 1학기 흐름을 한눈에!
                                        세계관 학교와 가정·교회·학교 사역을 연결하는 내용을 정리해 두었습니다.
                                    </div>
                                </div>

                                <!-- 🔹 상단 숨기기 버튼 (글로벌 쿠키 제어용) -->
                                <div class="conf-hide-controls">
                                    <button type="button"
                                            class="conf-hide-btn js-global-cookie-hide-btn"
                                            data-hide="today">
                                        오늘만 안보기
                                    </button>
                                    <button type="button"
                                            class="conf-hide-btn js-global-cookie-hide-btn"
                                            data-hide="1week">
                                        1주일 동안 숨기기
                                    </button>
                                    <button type="button"
                                            class="conf-hide-btn js-global-cookie-hide-btn"
                                            data-hide="3week">
                                        3주 숨기기
                                    </button>
                                </div>
                            </div>

                            <div class="conference-banner-links">
                                <a href="/HanaBible/2026/1/HanaBibleConference.html"
                                   class="conference-banner-cta"
                                   target="_blank"
                                   rel="noopener">
                                    <span class="emoji">👉</span>
                                    <span>2026 하나 바이블 세계관 컨퍼런스 &amp; 사역 페스타</span>
                                </a>

                                <a href="/HanaBible/2026/1/detail/main.html"
                                   class="conference-banner-cta secondary"
                                   aria-label="6과정 1학기 통합 인덱스 메인으로 이동">
                                    <span class="emoji">🧭</span>
                                    <span>6과정 1학기 전파 공유 교육 통합 인덱스 메인 · 3개 섹션 한눈에</span>
                                </a>

                                <a href="/HanaBible/2026/1/HanaBibleCompare2025vs2026.html"
                                   class="conference-banner-cta secondary">
                                    <span class="emoji">📊</span>
                                    <span>5과정 2학기(2025) · 6과정 1학기(2026) 비교 분석</span>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ✅ 배너 기존 테마(코어) 그대로 유지 -->
                <style id="conference-banner-style">
                    .conf-root {
                        margin: 0 0 1.6rem;
                    }
                    /* 페이지가 넓어져서 위/아래 여백만 살짝 정리 */

                    .conf-boot {
                        display: block;
                    }

                    .conf-boot-card {
                        border-radius: 18px;
                        padding: .95rem 1rem;
                        background: rgba(255,255,255,.92);
                        border: 1px solid rgba(0,0,0,.10);
                        box-shadow: 0 14px 34px rgba(0,0,0,.08);
                        backdrop-filter: blur(10px);
                    }

                    .conf-boot-row {
                        display: flex;
                        align-items: center;
                        gap: .65rem;
                    }

                    .conf-boot-title {
                        font-weight: 900;
                        font-size: .98rem;
                        color: rgba(2,6,23,.88);
                    }

                    .conf-boot-sub {
                        margin-top: .35rem;
                        font-size: .86rem;
                        color: rgba(2,6,23,.60);
                        font-weight: 700;
                    }

                    .conf-boot-spinner {
                        width: 18px;
                        height: 18px;
                        border-radius: 50%;
                        border: 3px solid rgba(2,6,23,.18);
                        border-top-color: rgba(255,107,129,.95);
                        animation: confSpin .8s linear infinite;
                    }

                    @@keyframes confSpin {
                        to {
                            transform: rotate(360deg);
                        }
                    }

                    .conf-root[data-state="shown"] .conference-banner-wrapper {
                        margin: 0 0 1.6rem;
                    }

                    .conf-root[data-state="shown"] .conference-banner {
                        position: relative;
                        display: flex;
                        flex-direction: column;
                        align-items: flex-start;
                        justify-content: center;
                        gap: .4rem;
                        padding: 1.3rem 1.7rem;
                        border-radius: 26px;
                        background: linear-gradient(135deg, #fff8e1 0%, #ffe0f2 40%, #ffc2e0 100%);
                        border: 4px solid #ff6b81;
                        box-shadow: 0 14px 28px rgba(255, 107, 129, 0.35);
                        color: #3b1624;
                        overflow: hidden;
                    }

                    .conf-root[data-state="shown"] .conference-banner-header {
                        width: 100%;
                        display: flex;
                        flex-wrap: wrap;
                        gap: .8rem;
                        align-items: flex-start;
                        justify-content: space-between;
                    }

                    .conf-root[data-state="shown"] .conference-banner-main {
                        display: flex;
                        flex-direction: column;
                        gap: .3rem;
                    }

                    .conf-root[data-state="shown"] .conference-banner::before {
                        content: "";
                        position: absolute;
                        left: 0;
                        top: -10%;
                        width: 10px;
                        height: 120%;
                        background: linear-gradient(180deg, #ff6b81, #ffb347);
                        box-shadow: 0 0 10px rgba(255, 107, 129, 0.65);
                    }

                    .conf-root[data-state="shown"] .conference-banner-ribbon {
                        position: absolute;
                        top: -12px;
                        right: -40px;
                        transform: rotate(20deg);
                        background: #ff6b81;
                        color: #fff;
                        padding: .35rem 1.6rem;
                        font-size: .78rem;
                        font-weight: 800;
                        text-transform: uppercase;
                        letter-spacing: .09em;
                        box-shadow: 0 4px 10px rgba(0,0,0,0.25);
                    }

                    .conf-root[data-state="shown"] .conference-banner-label {
                        font-size: .85rem;
                        font-weight: 800;
                        padding: .18rem .8rem;
                        border-radius: 999px;
                        background: #fff;
                        color: #b03060;
                        display: inline-flex;
                        align-items: center;
                        gap: .35rem;
                        border: 2px solid rgba(255,107,129,.7);
                    }

                        .conf-root[data-state="shown"] .conference-banner-label .emoji {
                            font-size: 1.1rem;
                        }

                    .conf-root[data-state="shown"] .conference-banner-title {
                        margin-top: .3rem;
                        font-weight: 900;
                        letter-spacing: .04em;
                        line-height: 1.3;
                        font-size: 1.7rem;
                        text-shadow: 0 2px 4px rgba(255,255,255,.6);
                    }

                    .conf-root[data-state="shown"] .conference-banner-sub {
                        margin-top: .25rem;
                        font-size: .93rem;
                        opacity: .96;
                    }

                    .conf-root[data-state="shown"] .conference-banner-links {
                        margin-top: .8rem;
                        display: flex;
                        flex-wrap: wrap;
                        gap: .6rem;
                    }

                    .conf-root[data-state="shown"] .conference-banner-cta {
                        font-size: .9rem;
                        font-weight: 800;
                        padding: .5rem 1.1rem;
                        border-radius: 999px;
                        display: inline-flex;
                        align-items: center;
                        gap: .4rem;
                        text-decoration: none;
                        border: 0;
                        cursor: pointer;
                        background: #ff6b81;
                        color: #fff;
                        box-shadow: 0 4px 12px rgba(255,107,129,.5);
                        transform: translateY(0);
                        transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
                    }

                        .conf-root[data-state="shown"] .conference-banner-cta .emoji {
                            font-size: 1.1rem;
                        }

                        .conf-root[data-state="shown"] .conference-banner-cta:hover {
                            transform: translateY(-2px);
                            box-shadow: 0 6px 18px rgba(255,107,129,.7);
                            background: #ff4c66;
                        }

                        .conf-root[data-state="shown"] .conference-banner-cta.secondary {
                            background: #fff;
                            color: #b03060;
                            border: 3px solid #ff6b81;
                            box-shadow: 0 4px 12px rgba(255,255,255,.7);
                        }

                            .conf-root[data-state="shown"] .conference-banner-cta.secondary:hover {
                                background: #ffe6f0;
                            }

                    .conf-root[data-state="shown"] .blink-strong {
                        animation: blinkStrong 1.4s ease-in-out infinite;
                    }

                    @@keyframes blinkStrong {
                        0% {
                            opacity: 1;
                            transform: scale(1);
                        }

                        50% {
                            opacity: .5;
                            transform: scale(1.03);
                        }

                        100% {
                            opacity: 1;
                            transform: scale(1);
                        }
                    }

                    .conf-root[data-state="shown"] .conf-hide-controls {
                        display: flex;
                        flex-wrap: wrap;
                        gap: .4rem;
                    }

                    .conf-root[data-state="shown"] .conf-hide-btn {
                        border-radius: 999px;
                        border: 0;
                        padding: .38rem .8rem;
                        font-size: .8rem;
                        font-weight: 700;
                        cursor: pointer;
                        background: rgba(255,255,255,.72);
                        color: #7b3250;
                        border: 1px solid rgba(255,138,160,.6);
                        box-shadow: 0 2px 8px rgba(0,0,0,.06);
                        transition: background .12s ease, transform .12s ease, box-shadow .12s ease;
                        backdrop-filter: blur(4px);
                        white-space: nowrap;
                    }

                        .conf-root[data-state="shown"] .conf-hide-btn:hover {
                            background: #ffe3ed;
                            transform: translateY(-1px);
                            box-shadow: 0 4px 12px rgba(0,0,0,.08);
                        }

                    @@media (min-width:768px) {
                        .conf-root[data-state="shown"] .conference-banner-title {
                            font-size: 2rem;
                        }
                    }
                </style>

                <script>
                    (function () {
                        var root = document.getElementById("conference-banner-root");
                        if (!root) return;

                        var cookieKey = root.getAttribute("data-cookie-key") || "HanaBibleConference_2026";

                        function getCookie(name) {
                            var m = document.cookie.match(new RegExp("(^|;\\s*)" + name.replace(/[.*+?^${}()|[\\]\\\\]/g, "\\$&") + "=([^;]*)"));
                            return m ? decodeURIComponent(m[2]) : null;
                        }

                        function showContent() {
                            root.setAttribute("data-state", "shown");

                            var boot = root.querySelector(".conf-boot");
                            var content = root.querySelector(".conf-content");

                            if (boot) boot.style.display = "none";
                            if (content) { content.hidden = false; content.style.display = "block"; }

                            root.style.display = "block";
                        }

                        function hideAll() {
                            root.setAttribute("data-state", "hidden");

                            var st = document.getElementById("conference-banner-style");
                            if (st && st.parentNode) st.parentNode.removeChild(st);

                            if (root && root.parentNode) root.parentNode.removeChild(root);
                        }

                        var v = getCookie(cookieKey);
                        if (v) hideAll();
                        else showContent();
                    })();
                </script>

            </div>

        </div>
    </div>
</body>
</html>
