            position: fixed;
            inset: 0;
            display: none;
            place-items: center;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
        }

        .loading-box {
            background: var(--bg3);
            color: var(--text);
            padding: 16px 22px;
            border-radius: 12px;
            border: 1px solid var(--border);
            font-size: 14px;
            font-weight: 500;
            box-shadow: var(--shadow2);
        }

        #processingBox {
            display: none;
        }

        .copy-scope {
            user-select: text !important;
            -webkit-user-select: text !important;
        }

        .no-copy,
        .no-copy * {
            user-select: none !important;
            -webkit-user-select: none !important;
            -moz-user-select: none !important;
            -ms-user-select: none !important;
            -webkit-touch-callout: none !important;
        }

        .text-copy-source {
            position: absolute;
            left: -99999px;
            top: -99999px;
            width: 1px;
            height: 1px;
            opacity: 0;
            pointer-events: none;
        }

        body.text-mode .hero-eyebrow,
        body.text-mode .hero-divider {
            display: none;
        }

        body.text-mode .copy-date-line {
            display: block;
        }

        body.text-mode .hero-title {
            margin: 0;
        }

        body.text-mode .hero-section {
            padding-top: 24px;
            padding-bottom: 24px;
        }

        body.text-mode .main-grid {
            grid-template-columns: 1fr;
        }

        @@media (max-width: 900px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 640px) {
            .shell {
                padding: 20px 12px 130px;
            }

            .hero-section {
                padding: 24px 20px 20px;
            }

            .g-card-bd {
                padding: 16px 14px;
            }

            .scripture-item {
                font-size: 15px;
                padding: 14px 14px 14px 18px;
            }

            .prayer-text {
                font-size: 15px;
            }

            .top-nav {
                padding: 0 12px;
            }

            .nav-date-pill {
                font-size: 11px;
            }

            .loop-hint {
                display: none;
            }
        }

        @@media (max-width: 420px) {
            .hero-title {
                font-size: 1.3rem;
            }

            .player-controls {
                gap: 6px;
            }

            .pc-btn {
                padding: 7px 12px;
                font-size: 12px;
            }
        }
    </style>
</head>

<body class="@(methodTEXT ? "text-mode" : "")">
    <div id="loadingOverlay" class="loading-overlay"><div class="loading-box">⏳ 처리 중입니다…</div></div>
    <div id="processingBox">📖 처리 중입니다... 잠시만 기다려 주세요.</div>

    <nav class="top-nav no-copy">
        <div class="nav-left">
            <a href="/" class="nav-home-btn">🏠 홈</a>
            <div class="nav-date-pill">📅 @DateString</div>
        </div>
        <div class="nav-right">
            @if (isSuperAdmin || isAdmin)
            {
                <a href="/RhapsodyOfReality/DetailWords?Id=@Model?.RhapsodyOfRealitysData?.Id&methodTEXT=TEXT"
                   class="nav-admin-btn">📰 평문</a>
            }
            @if (isSuperAdmin)
            {
                <a href="/RhapsodyOfReality/ModifyView?Id=@Model?.RhapsodyOfRealitysData?.Id"
                   class="nav-admin-btn">✏️ 수정</a>
                <a href="/RhapsodyOfReality/DetailList"
                   class="nav-admin-btn accent">📂 목록</a>
            }
        </div>
    </nav>

    <div class="shell copy-scope" id="copyScope">

        <header class="hero-section reveal">
            @if (methodTEXT)
            {
                <div class="copy-date-line">📅 @DateString</div>
            }
            else
            {
                <div class="hero-eyebrow">오늘의 말씀</div>
            }

            <h1 class="hero-title">@Model?.RhapsodyOfRealitysData?.WordTitle</h1>

            @if (!methodTEXT)
            {
                <div class="hero-divider"></div>
            }
        </header>

        <div class="main-grid">

            <div class="col-left">

                @if (!methodTEXT && !string.IsNullOrEmpty(videoId))
                {
                    <article class="g-card reveal no-copy">
                        <div class="g-card-hd">
                            <div class="g-card-hd-left">
                                <div class="section-icon blue">🎥</div>
                                <span class="g-card-title">설교 영상</span>
                            </div>
                            @if (isSuperAdmin && hasRange)
                            {
                                <span class="g-card-meta">구간: 0:00 ~ @endMin:@endSec.ToString("D2")</span>
                            }
                        </div>
                        <div class="g-card-bd">
                            <div class="player-wrap">
                                @if (isSuperAdmin && hasRange)
                                {
                                    <iframe id="ytplayer"
                                            src="https://www.youtube.com/embed/@videoId?start=0&end=@total&enablejsapi=1"
                                            title="설교영상"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen></iframe>
                                }
                                else
                                {
                                    <iframe id="ytplayer"
                                            src="https://www.youtube.com/embed/@videoId?enablejsapi=1"
                                            title="설교영상"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                            allowfullscreen></iframe>
                                }
                            </div>
                            <div class="player-controls">
                                <button type="button" class="pc-btn primary" onclick="ytPlay()">▶ 재생</button>
                                <button type="button" class="pc-btn" onclick="ytPause()">⏸ 일시정지</button>
                                <button type="button" class="pc-btn" onclick="ytReplay()">↺ 처음부터</button>
                                <span class="loop-hint"><span class="loop-dot"></span>무한 반복 중</span>
                            </div>
                        </div>
                    </article>
                }

                <article class="g-card reveal">
                    <div class="g-card-hd">
                        <div class="g-card-hd-left">
                            <div class="section-icon gold no-copy">📖</div>
                            <span class="g-card-title">오늘의 말씀</span>
                        </div>
                    </div>
                    <div class="g-card-bd">
                        @{
                            var phrase = Model?.RhapsodyOfRealitysData?.WordPhrase ?? "";
                            var lines = phrase.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None);
                            foreach (var ln in lines)
                            {
                                if (!string.IsNullOrWhiteSpace(ln))
                                {
                                    if (methodTEXT)
                                    {
                                        <p class="scripture-plain">@ln</p>
                                    }
                                    else
                                    {
                                        <div class="scripture-item">@ln</div>
                                    }
                                }
                            }
                        }
                    </div>
                </article>

                <article class="prayer-card reveal">
                    <div class="prayer-card-hd">
                        <div class="section-icon purple no-copy">🙏</div>
                        <span class="g-card-title">기도</span>
                        <span class="prayer-cross no-copy" style="margin-left:4px; font-size:16px;">✝</span>
                    </div>
                    <div class="g-card-bd">
                        <p class="prayer-text">@Model?.RhapsodyOfRealitysData?.WordPray</p>
                    </div>
                </article>

            </div>

            <aside class="col-right">
                <article class="g-card reveal">
                    <div class="g-card-hd">
                        <div class="g-card-hd-left">
                            <div class="section-icon blue no-copy">📝</div>
                            <span class="g-card-title">참고 성경</span>
                        </div>
                    </div>
                    <div class="g-card-bd">
                        <div class="ref-list">
                            @foreach (var va in Model?.eBibleDatas ?? Enumerable.Empty<eBibles>())
                            {
                                <details class="ref-acc" @(methodTEXT ? "open" : "")>
                                    <summary>@va.JanZulString</summary>
                                    <div class="ref-acc-bd">
                                        @if (!string.IsNullOrEmpty(va.BibleText) && va.eBibleDatas != null)
                                        {
                                            foreach (var v in va.eBibleDatas)
                                            {
                                                <div class="ref-verse">
                                                    <span class="ref-verse-num">@v.zul</span>
                                                    <span class="ref-verse-text">@v.BibleData</span>
                                                </div>
                                            }
                                        }
                                        else if (!string.IsNullOrEmpty(va.BibleText))
                                        {
                                            <div class="ref-verse">
                                                <span class="ref-verse-text">@va.BibleText</span>
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </div>

                        @if (isSuperAdmin)
                        {
                            <div class="no-copy" style="margin-top:14px; padding-top:12px; border-top:1px solid var(--border);">
                                <span style="font-size:11px; color:var(--text3); word-break:break-all;">
                                    https://www.jamsilkids.com/RhapsodyOfReality/DetailWords
                                </span>
                            </div>
                        }
                    </div>
                </article>
            </aside>

        </div>
    </div>

    <textarea id="textCopySource" class="text-copy-source">@textCopyContent</textarea>

    @if (!methodTEXT)
    {
        <div class="actionbar no-copy">
            <a class="ab-btn" href="/">🏠 홈</a>
            @if (isSuperAdmin)
            {
                <a class="ab-btn gold-btn" href="/RhapsodyOfReality/DetailList">📂 QT 목록</a>
                <a class="ab-btn" href="/RhapsodyOfReality/ModifyView?Id=@Model?.RhapsodyOfRealitysData?.Id">✏️ 수정</a>
            }
            @if (isSuperAdmin || isAdmin)
            {
                <a class="ab-btn" href="/BibleBulk/BibleMissingList">📖 성경</a>
                <a class="ab-btn" href="/RhapsodyOfReality/DetailWords?Id=@Model?.RhapsodyOfRealitysData?.Id&methodTEXT=TEXT">📰 평문</a>
            }
        </div>
    }

    <script>
        var player = null;
        var playerReady = false;
        var actionQueue = [];
        var ytLastEnded = 0;

        function createYTPlayer() {
            var el = document.getElementById('ytplayer');
            if (!el || !window.YT || !YT.Player) return;

            player = new YT.Player('ytplayer', {
                events: {
                    'onReady': function () {
                        playerReady = true;
                        while (actionQueue.length) {
                            try { actionQueue.shift()(); } catch (e) { }
                        }
                    },
                    'onStateChange': function (e) {
                        if (e.data === YT.PlayerState.ENDED) {
                            var now = Date.now();
                            if (now - ytLastEnded < 3000) return;
                            ytLastEnded = now;

                            var vid = '@videoId';
                            setTimeout(function () {
                                try {
                                    player.loadVideoById({ videoId: vid, startSeconds: 0 });
                                } catch (ex) { }
                            }, 400);
                        }
                    }
                }
            });
        }

        (function initYT() {
            if (window.YT && YT.Player) {
                createYTPlayer();
            } else {
                window.onYouTubeIframeAPIReady = function () {
                    createYTPlayer();
                };
            }
        })();

        function doWhenReady(fn) {
            if (playerReady && player) {
                fn();
            } else {
                actionQueue.push(fn);
            }
        }

        function ytPlay() { doWhenReady(function () { player.playVideo(); }); }
        function ytPause() { doWhenReady(function () { player.pauseVideo(); }); }
        function ytReplay() { doWhenReady(function () { player.seekTo(0); player.playVideo(); }); }
    </script>

    <script>
        (function () {
            var obs = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting) {
                        e.target.classList.add('in');
                        obs.unobserve(e.target);
                    }
                });
            }, { threshold: 0.07 });

            document.querySelectorAll('.reveal').forEach(function (el, i) {
                el.style.transitionDelay = (i * 60) + 'ms';
                obs.observe(el);
            });
        })();
    </script>

    <script>
        function normalizeCopyText(text) {
            return (text || '')
                .replace(/\r/g, '')
                .replace(/[ \t]+\n/g, '\n')
                .replace(/\n[ \t]+\n/g, '\n\n')
                .replace(/\n{4,}/g, '\n\n\n')
                .trim();
        }

        function getTextModeCopyText() {
            var el = document.getElementById('textCopySource');
            if (!el) return '';
            return normalizeCopyText(el.value || '');
        }

        document.addEventListener('copy', function (e) {
            var isTextMode = @Html.Raw(methodTEXT ? "true" : "false");
            if (!isTextMode) return;

            var cleanText = getTextModeCopyText();
            if (!cleanText) return;

            if (e.clipboardData) {
                e.preventDefault();
                e.clipboardData.setData('text/plain', cleanText);
            } else if (window.clipboardData) {
                e.preventDefault();
                window.clipboardData.setData('Text', cleanText);
            }
        });

        (function forceSelectableTextMode() {
            var isTextMode = @Html.Raw(methodTEXT ? "true" : "false");
            if (!isTextMode) return;

            var scope = document.getElementById('copyScope');
            if (!scope) return;

            scope.querySelectorAll('.scripture-plain, .prayer-text, .ref-acc summary, .ref-verse, .ref-verse-num, .ref-verse-text, .hero-title, .copy-date-line, .g-card-title')
                .forEach(function (el) {
                    el.style.userSelect = 'text';
                    el.style.webkitUserSelect = 'text';
                });
        })();
    </script>
</body>
</html>