@model BulletinBoard.Models.RhapsodyOfRealityComposite
@using BulletinBoard.Common
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http
@using BulletinBoard.Services.Abstract
@using System.Text
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    var todayDate = DateHelper.GetTodayDateDayString();
    string formattedModResultData = $"preach_{todayDate}.webp";
    string formattedModResultDataOG = $"{ViewBag.Domain}/images/preach/{formattedModResultData}";
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());

    bool methodTEXT = false;
    if (ViewBag.methodTEXT != null && ViewBag.methodTEXT == "TEXT")
    {
        methodTEXT = true;
    }
}

@{
    int Year = int.Parse(Model.RhapsodyOfRealitysData.ExposeDate.Substring(0, 4));
    int Month = int.Parse(Model.RhapsodyOfRealitysData.ExposeDate.Substring(5, 2));
    int Day = int.Parse(Model.RhapsodyOfRealitysData.ExposeDate.Substring(8, 2));
    string DateString = $"{Year}년 {Month}월 {Day}일 {Model.RhapsodyOfRealitysData.WeekDayKor}요일";

    var videoId = Model?.RhapsodyOfRealitysData?.YouTuBuURL ?? "";
    var endMin = Model?.RhapsodyOfRealitysData?.EndMinute ?? 0;
    var endSec = Model?.RhapsodyOfRealitysData?.EndSecond ?? 0;
    var total = endMin * 60 + endSec;
    var hasRange = (endMin > 0 || endSec > 0);
}

@{
    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && (await AuthService.IsInRole(user, nameof(Roles.SuperAdmin)) || string.Equals(User.Identity?.Name, "Basic", StringComparison.OrdinalIgnoreCase));   // 2026-10-05: "Basic" 계정도 SuperAdmin 과 동일
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    var isBasic = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Basic));
}

@{
    var sb = new StringBuilder();

    var titleText = (Model?.RhapsodyOfRealitysData?.WordTitle ?? "").Trim();
    var phraseForCopy = Model?.RhapsodyOfRealitysData?.WordPhrase ?? "";
    var prayerText = (Model?.RhapsodyOfRealitysData?.WordPray ?? "").Trim();
    var refList = Model?.eBibleDatas ?? Enumerable.Empty<eBibles>();

    var phraseLines = phraseForCopy
        .Split(new[] { "\r\n", "\n" }, StringSplitOptions.None)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Select(x => x.Trim())
        .ToList();

    sb.AppendLine($"📅 {DateString}");
    sb.AppendLine();
    sb.AppendLine(titleText);
    sb.AppendLine();
    sb.AppendLine("📖오늘의 말씀");

    if (phraseLines.Any())
    {
        sb.AppendLine(phraseLines[0]);

        for (int i = 1; i < phraseLines.Count; i++)
        {
            sb.AppendLine();
            sb.AppendLine(phraseLines[i]);
        }
    }

    if (!string.IsNullOrWhiteSpace(prayerText))
    {
        sb.AppendLine();
        sb.AppendLine("🙏기도");
        sb.AppendLine(prayerText);
    }

    if (refList.Any())
    {
        sb.AppendLine();
        sb.AppendLine("📝 참고 성경");
        sb.AppendLine();

        foreach (var va in refList)
        {
            if (va == null) { continue; }

            var janZul = (va.JanZulString ?? "").Trim();
            if (!string.IsNullOrWhiteSpace(janZul))
            {
                sb.AppendLine(janZul);
            }

            if (va.eBibleDatas != null && va.eBibleDatas.Any())
            {
                foreach (var v in va.eBibleDatas)
                {
                    if (v == null) { continue; }

                    sb.AppendLine($"{v.zul}절");
                    sb.AppendLine((v.BibleData ?? "").Trim());
                    sb.AppendLine();
                }
            }
            else if (!string.IsNullOrWhiteSpace(va.BibleText))
            {
                sb.AppendLine(va.BibleText.Trim());
                sb.AppendLine();
            }
        }
    }

    if (isSuperAdmin)
    {
        sb.AppendLine("https://www.jamsilkids.com/RhapsodyOfReality/DetailWords");
    }

    var textCopyContent = sb.ToString().Trim();
}

