@model BulletinBoard.Models.RhapsodyOfRealityComposite
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    var todayDate = DateHelper.GetTodayDateDayString();
    string formattedModResultData = $"preach_{todayDate}.webp";
    string formattedModResultDataOG = $"{@ViewBag.Domain}/images/preach/{formattedModResultData}";
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());

    bool methodTEXT = false;
    @if (@ViewBag.methodTEXT != null && @ViewBag.methodTEXT == "TEXT")
    {
        methodTEXT = true;
    }
}

@{
    int Year  = int.Parse(Model.RhapsodyOfRealitysData.ExposeDate.Substring(0, 4));
    int Month = int.Parse(Model.RhapsodyOfRealitysData.ExposeDate.Substring(5, 2));
    int Day   = int.Parse(Model.RhapsodyOfRealitysData.ExposeDate.Substring(8, 2));
    string DateString  = $"{Year}년 {Month}월 {Day}일 {Model.RhapsodyOfRealitysData.WeekDayKor}요일";
    string DateShort   = $"{Month}월 {Day}일 {Model.RhapsodyOfRealitysData.WeekDayKor}";

    var videoId  = Model?.RhapsodyOfRealitysData?.YouTuBuURL ?? "";
    var endMin   = Model?.RhapsodyOfRealitysData?.EndMinute ?? 0;
    var endSec   = Model?.RhapsodyOfRealitysData?.EndSecond ?? 0;
    var total    = endMin * 60 + endSec;
    var hasRange = (endMin > 0 || endSec > 0);

    var refCount = Model?.eBibleDatas?.Count ?? 0;
}

@{
    var user         = await AuthService.GetSignedUser(User);
    var isSignedIn   = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && (await AuthService.IsInRole(user, nameof(Roles.SuperAdmin)) || string.Equals(User.Identity?.Name, "Basic", StringComparison.OrdinalIgnoreCase));   // 2026-10-05: "Basic" 계정도 SuperAdmin 과 동일
    var isAdmin      = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    var isBasic      = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Basic));
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FBFAF7" />
    <title>@Model?.RhapsodyOfRealitysData?.WordTitle · @ChurchName</title>
    <meta property="og:title"       content="@ChurchName · @DepartmentName" />
    <meta property="og:description" content="@ChurchName · @DepartmentName 입니다." />
    <meta property="og:image"       content="@formattedModResultDataOG" />
    <meta property="og:url"         content="@ViewBag.FullURL" />
    <meta property="og:type"        content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Gothic+A1:wght@400;500;700;800;900&family=Gowun+Batang:wght@400;700&display=swap" rel="stylesheet">

    <script src="https://www.youtube.com/iframe_api"></script>
    <script src="/js/common2.js"></script>
    <script src="/js/ProcessBar73.js"></script>
    <script src="/js/bibleOneByOne.js"></script>

<style>
/* ══════════════════════════════════════════════
   오늘의 5분 말씀 — 밝은 테마 (단일 테마 확정)
══════════════════════════════════════════════ */
:root{
    --paper:      #FBFAF7;
    --card:       #FFFFFF;
    --card-soft:  #F7F5F0;
    --ink:        #232733;
    --ink2:       #4E5464;
    --muted:      #8A8F9C;
    --line:       #EBE7E0;
    --line-soft:  #F3F0EA;

    --accent:     #F2762E;
    --accent-mid: #FBDCC6;
    --accent-soft:#FEF2E9;
    --accent-ink: #A9481A;

    --vid:      #3E7FC1;  --vid-soft:  #EAF2FA;
    --word:     #F2762E;  --word-soft: #FEF2E9;
    --pray:     #7C6BD6;  --pray-soft: #F1EEFC;
    --bib:      #2A9D8F;  --bib-soft:  #E7F5F2;

    --shadow-s: 0 1px 2px rgba(35,39,51,.05), 0 2px 8px rgba(35,39,51,.05);
    --shadow-m: 0 2px 6px rgba(35,39,51,.07), 0 10px 28px rgba(35,39,51,.07);

    --r-card: 18px;
    --fs: 1;                 /* 글자 크기 배율 (JS로 변경) */
    --f-ui:   "Gothic A1","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
    --f-read: "Gowun Batang","Nanum Myeongjo","Apple SD Gothic Neo",serif;
}

*,*::before,*::after{ box-sizing:border-box; }
html{ -webkit-text-size-adjust:100%; scroll-behavior:smooth; }
body{
    margin:0; background:var(--paper); color:var(--ink);
    font-family:var(--f-ui); font-weight:400; line-height:1.6;
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
    padding-bottom:env(safe-area-inset-bottom);
}
a{ color:inherit; text-decoration:none; }
button{ font-family:inherit; }

/* 종이 질감 — 아주 옅은 그라데이션 두 점 */
body::before{
    content:""; position:fixed; inset:0; z-index:-1; pointer-events:none;
    background:
      radial-gradient(760px 420px at 88% -8%,  rgba(242,118,46,.055), transparent 62%),
      radial-gradient(680px 400px at -6% 4%,   rgba(62,127,193,.045), transparent 60%);
}

/* ── 상단바 ───────────────────────────── */
.tbar{
    position:sticky; top:0; z-index:60;
    background:rgba(251,250,247,.92);
    -webkit-backdrop-filter:saturate(180%) blur(14px);
    backdrop-filter:saturate(180%) blur(14px);
    border-bottom:1px solid var(--line);
}
.tbar-in{
    max-width:860px; margin:0 auto;
    padding:9px clamp(14px,4vw,22px);
    display:flex; align-items:center; gap:10px;
}
.tb-home{
    flex:none; display:inline-flex; align-items:center; gap:6px;
    height:36px; padding:0 14px; border-radius:999px;
    background:var(--card); border:1px solid var(--line);
    font-size:13px; font-weight:800; color:var(--ink2);
    box-shadow:var(--shadow-s); transition:.16s;
}
.tb-home:hover{ border-color:var(--accent); color:var(--accent-ink); background:var(--accent-soft); }
.tb-date{
    flex:1; min-width:0; text-align:center;
    font-size:12.5px; font-weight:800; color:var(--muted);
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.tb-fs{ flex:none; display:flex; gap:0; background:var(--card-soft); border:1px solid var(--line); border-radius:999px; padding:3px; }
.tb-fs button{
    width:30px; height:28px; border:0; background:transparent; cursor:pointer;
    border-radius:999px; color:var(--muted); font-weight:900; line-height:1;
    display:grid; place-items:center; transition:.14s;
}
.tb-fs button:nth-child(1){ font-size:11px; }
.tb-fs button:nth-child(2){ font-size:13px; }
.tb-fs button:nth-child(3){ font-size:16px; }
.tb-fs button.on{ background:var(--card); color:var(--accent-ink); box-shadow:var(--shadow-s); }
.tb-fs button:hover{ color:var(--accent-ink); }

/* ── 레이아웃 ─────────────────────────── */
.wrap{ max-width:760px; margin:0 auto; padding:0 clamp(14px,4vw,22px) 128px; }

/* ── 히어로 ───────────────────────────── */
.hero{ padding:34px 0 22px; text-align:center; }
.hero-eyebrow{
    display:inline-flex; align-items:center; gap:7px;
    background:var(--accent-soft); color:var(--accent-ink);
    border:1px solid var(--accent-mid); border-radius:999px;
    padding:5px 15px; font-size:12px; font-weight:800; letter-spacing:.02em;
}
.hero-title{
    margin:16px 0 0; font-family:var(--f-ui); font-weight:900;
    font-size:clamp(25px,6.4vw,40px); line-height:1.24; letter-spacing:-.03em;
    color:var(--ink); text-wrap:balance; word-break:keep-all;
}
.hero-meta{
    margin-top:14px; display:flex; align-items:center; justify-content:center;
    gap:9px; flex-wrap:wrap; font-size:12.5px; font-weight:700; color:var(--muted);
}
.hero-dot{ width:3px; height:3px; border-radius:50%; background:var(--line); }
.hero-rule{
    margin:22px auto 0; width:58px; height:4px; border-radius:999px;
    background:linear-gradient(90deg,var(--accent),#FBB47A);
}

/* ── 카드 ─────────────────────────────── */
.card{
    background:var(--card); border:1px solid var(--line);
    border-radius:var(--r-card); box-shadow:var(--shadow-s);
    overflow:hidden; margin-bottom:16px;
}
.card-hd{
    display:flex; align-items:center; gap:10px;
    padding:14px 17px; border-bottom:1px solid var(--line-soft);
}
.card-ico{
    flex:none; width:32px; height:32px; border-radius:10px;
    display:grid; place-items:center; font-size:16px;
}
.ico-vid { background:var(--vid-soft);  }
.ico-word{ background:var(--word-soft); }
.ico-pray{ background:var(--pray-soft); }
.ico-bib { background:var(--bib-soft);  }
.card-tt{ font-size:14.5px; font-weight:900; letter-spacing:-.2px; color:var(--ink); }
.card-sub{ margin-left:auto; font-size:11.5px; font-weight:700; color:var(--muted); white-space:nowrap; }
.card-bd{ padding:17px; }

/* ── 영상 ─────────────────────────────── */
.player{
    position:relative; width:100%; aspect-ratio:16/9;
    background:#111827; border-radius:13px; overflow:hidden;
}
.player iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; }
.pcontrols{ display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-top:13px; }
.pbtn{
    display:inline-flex; align-items:center; justify-content:center; gap:6px;
    flex:0 1 auto; min-width:0; white-space:nowrap;
    height:40px; padding:0 15px; border-radius:999px; cursor:pointer;
    border:1px solid var(--line); background:var(--card);
    font-size:13.5px; font-weight:800; color:var(--ink2); transition:.15s;
}
.pbtn:hover{ background:var(--card-soft); border-color:var(--muted); }
.pbtn:active{ transform:scale(.97); }
.pbtn.play{
    background:var(--accent); border-color:var(--accent); color:#fff;
    box-shadow:0 3px 12px rgba(242,118,46,.32);
}
.pbtn.play:hover{ background:#E4681F; border-color:#E4681F; }
.loop{
    margin-left:auto; display:inline-flex; align-items:center; gap:6px;
    flex:0 0 auto; white-space:nowrap;
    font-size:11.5px; font-weight:800; color:var(--bib);
    background:var(--bib-soft); border-radius:999px; padding:5px 12px;
}
.loop i{ width:6px; height:6px; border-radius:50%; background:var(--bib); animation:blip 1.7s ease-in-out infinite; }
@@keyframes blip{ 0%,100%{opacity:1} 50%{opacity:.28} }

/* ── 읽는 글 (설교 본문) ──────────────── */
.reading{ font-family:var(--f-read); }
.s-line{
    font-size:calc(16.5px * var(--fs)); line-height:1.95;
    color:var(--ink); margin:0 0 15px; word-break:keep-all;
    padding-left:15px; border-left:2px solid var(--line-soft);
    transition:border-color .18s, padding-left .18s;
}
.s-line:last-child{ margin-bottom:0; }
.s-line:hover{ border-left-color:var(--accent-mid); }
.s-plain{
    font-size:calc(16.5px * var(--fs)); line-height:1.95;
    color:var(--ink); margin:0 0 15px; word-break:keep-all;
}
.s-plain:last-child{ margin-bottom:0; }

/* ── 기도 ─────────────────────────────── */
.pray-card{
    background:linear-gradient(160deg,#F6F3FE 0%,#FFFFFF 62%);
    border:1px solid #E4DEFA; border-radius:var(--r-card);
    box-shadow:var(--shadow-s); overflow:hidden; margin-bottom:16px;
}
.pray-card .card-hd{ border-bottom-color:#EDE8FB; }
.pray-text{
    font-family:var(--f-read);
    font-size:calc(16px * var(--fs)); line-height:1.9;
    color:#3A3560; margin:0; word-break:keep-all;
    position:relative; padding-left:26px;
}
.pray-text::before{
    content:"✝"; position:absolute; left:0; top:1px;
    color:var(--pray); font-size:16px; opacity:.55;
}

/* ── 참고 성경 (펼친 상태) ────────────── */
.ref{ margin-bottom:14px; }
.ref:last-child{ margin-bottom:0; }
.ref-tt{
    display:inline-flex; align-items:center; gap:7px;
    background:var(--bib-soft); color:#1F7A6E;
    border:1px solid #CDE9E3; border-radius:999px;
    padding:5px 14px; font-size:12.5px; font-weight:900; margin-bottom:9px;
}
.ref-body{
    border-left:2px solid var(--bib-soft); padding-left:14px;
}
.verse{ display:flex; gap:10px; margin-bottom:9px; align-items:baseline; }
.verse:last-child{ margin-bottom:0; }
.verse-n{
    flex:none; min-width:20px; text-align:right;
    font-family:var(--f-ui); font-size:11px; font-weight:900;
    color:var(--bib); padding-top:3px;
}
.verse-t{
    flex:1; min-width:0; font-family:var(--f-read);
    font-size:calc(15px * var(--fs)); line-height:1.8;
    color:var(--ink2); word-break:keep-all;
}
.ref-empty{ font-size:13px; color:var(--muted); font-weight:600; }

/* ── 관리자 링크 메모 ─────────────────── */
.admin-note{
    margin-top:15px; padding-top:13px; border-top:1px dashed var(--line);
    font-size:11px; color:var(--muted); word-break:break-all;
}

/* ── 하단 액션바 ──────────────────────── */
.abar{
    position:fixed; left:50%; transform:translateX(-50%);
    bottom:calc(14px + env(safe-area-inset-bottom)); z-index:70;
    display:flex; gap:7px; padding:7px;
    background:rgba(255,255,255,.94);
    -webkit-backdrop-filter:saturate(180%) blur(16px);
    backdrop-filter:saturate(180%) blur(16px);
    border:1px solid var(--line); border-radius:999px;
    box-shadow:var(--shadow-m);
    max-width:calc(100vw - 24px); overflow-x:auto; scrollbar-width:none;
}
.abar::-webkit-scrollbar{ display:none; }
.ab{
    flex:none; display:inline-flex; align-items:center; gap:5px;
    height:38px; padding:0 15px; border-radius:999px;
    font-size:13px; font-weight:800; color:var(--ink2);
    background:var(--card-soft); transition:.15s; white-space:nowrap;
}
.ab:hover{ background:var(--accent-soft); color:var(--accent-ink); }
.ab.main{ background:var(--accent); color:#fff; box-shadow:0 3px 12px rgba(242,118,46,.3); }
.ab.main:hover{ background:#E4681F; color:#fff; }

/* ── 처리 중 박스 ─────────────────────── */
#processingBox{
    display:none; position:fixed; left:50%; top:50%;
    transform:translate(-50%,-50%); z-index:200;
    background:var(--card); border:1px solid var(--line);
    border-radius:14px; box-shadow:var(--shadow-m);
    padding:16px 22px; font-size:14px; font-weight:800; color:var(--ink);
}

/* ── 등장 애니메이션 ──────────────────── */
.rv{ opacity:0; transform:translateY(14px); transition:opacity .5s ease, transform .5s ease; }
.rv.in{ opacity:1; transform:none; }

/* ── 반응형 ───────────────────────────── */
@@media (max-width:520px){
    .tb-date{ font-size:11.5px; }
    .tb-home{ padding:0 11px; font-size:12.5px; }
    .card-bd{ padding:15px 14px; }
    .card-hd{ padding:13px 14px; }
    .hero{ padding:26px 0 18px; }
    .s-line{ padding-left:12px; }
    .pcontrols .pbtn{ padding:0 12px; font-size:13px; }
    .loop{ margin-left:0; }
}
@@media (min-width:900px){
    .wrap{ max-width:820px; }
    .hero{ padding:48px 0 26px; }
}
@@media print{
    .tbar,.abar,.pcontrols,.player,#processingBox{ display:none !important; }
    body{ background:#fff; }
    .card,.pray-card{ box-shadow:none; border-color:#DDD; break-inside:avoid; }
}
@@media (prefers-reduced-motion:reduce){
    *{ animation:none !important; transition:none !important; }
    .rv{ opacity:1; transform:none; }
    html{ scroll-behavior:auto; }
}
</style>
</head>
<body>

<div id="processingBox">📖 처리 중입니다... 잠시만 기다려 주세요.</div>

<!-- ═══ 상단바 ═══ -->
<header class="tbar">
    <div class="tbar-in">
        <a href="/" class="tb-home">🏠 홈</a>
        <div class="tb-date">@DateString</div>
        <div class="tb-fs" role="group" aria-label="글자 크기">
            <button type="button" onclick="setFs('s')" id="fsS" aria-label="작게">가</button>
            <button type="button" onclick="setFs('m')" id="fsM" aria-label="보통">가</button>
            <button type="button" onclick="setFs('l')" id="fsL" aria-label="크게">가</button>
        </div>
    </div>
</header>

<div class="wrap">

    <!-- ═══ 히어로 ═══ -->
    <section class="hero">
        <span class="hero-eyebrow">✨ 오늘의 5분 말씀</span>
        <h1 class="hero-title">@Model?.RhapsodyOfRealitysData?.WordTitle</h1>
        <div class="hero-meta">
            <span>📅 @DateShort</span>
            @if (isSuperAdmin || isAdmin)
            {
                <span class="hero-dot"></span>
                <span>👀 @Model?.RhapsodyOfRealitysData?.Visited</span>
            }
        </div>
        <div class="hero-rule"></div>
    </section>

    <!-- ═══ 설교 영상 ═══ -->
    @if (!methodTEXT && !string.IsNullOrEmpty(videoId))
    {
        <article class="card rv">
            <div class="card-hd">
                <div class="card-ico ico-vid">🎥</div>
                <span class="card-tt">설교 영상</span>
                @if (isSuperAdmin && hasRange)
                {
                    <span class="card-sub">0:00 ~ @endMin:@endSec.ToString("D2")</span>
                }
            </div>
            <div class="card-bd">
                <div class="player">
                    <iframe id="ytplayer"
                            src="https://www.youtube.com/embed/@videoId?start=0@(hasRange ? $"&end={total}" : "")&enablejsapi=1&rel=0"
                            title="설교영상"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen></iframe>
                </div>
                <div class="pcontrols">
                    <button type="button" class="pbtn play" onclick="ytPlay()">▶ 재생</button>
                    <button type="button" class="pbtn" onclick="ytPause()">⏸ 일시정지</button>
                    <button type="button" class="pbtn" onclick="ytReplay()">↺ 처음부터</button>
                    <span class="loop"><i></i>무한 반복 중</span>
                </div>
            </div>
        </article>
    }

    <!-- ═══ 오늘의 말씀 ═══ -->
    <article class="card rv">
        <div class="card-hd">
            <div class="card-ico ico-word">📖</div>
            <span class="card-tt">오늘의 말씀</span>
        </div>
        <div class="card-bd reading">
            @{
                var phrase = Model?.RhapsodyOfRealitysData?.WordPhrase ?? "";
                var lines  = phrase.Split(new[]{"\r\n","\n"}, StringSplitOptions.None);
                foreach (var ln in lines)
                {
                    if (!string.IsNullOrWhiteSpace(ln))
                    {
                        if (methodTEXT)
                        {
                            <p class="s-plain">@ln</p>
                        }
                        else
                        {
                            <p class="s-line">@ln</p>
                        }
                    }
                }
            }
        </div>
    </article>

    <!-- ═══ 기도 ═══ -->
    <article class="pray-card rv">
        <div class="card-hd">
            <div class="card-ico ico-pray">🙏</div>
            <span class="card-tt">기도</span>
        </div>
        <div class="card-bd">
            <p class="pray-text">@Model?.RhapsodyOfRealitysData?.WordPray</p>
        </div>
    </article>

    <!-- ═══ 참고 성경 (전부 펼침) ═══ -->
    <article class="card rv">
        <div class="card-hd">
            <div class="card-ico ico-bib">📝</div>
            <span class="card-tt">참고 성경</span>
            @if (refCount > 0)
            {
                <span class="card-sub">@refCount 곳</span>
            }
        </div>
        <div class="card-bd">
            @if (refCount == 0)
            {
                <div class="ref-empty">참고 성경이 없어요.</div>
            }
            else
            {
                foreach (var va in Model.eBibleDatas)
                {
                    <div class="ref">
                        <div class="ref-tt">📕 @va.JanZulString</div>
                        <div class="ref-body">
                            @if (!string.IsNullOrEmpty(va.BibleText))
                            {
                                foreach (var v in va.eBibleDatas)
                                {
                                    <div class="verse">
                                        <span class="verse-n">@v.zul</span>
                                        <span class="verse-t">@v.BibleData</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            }

            @if (isSuperAdmin)
            {
                <div class="admin-note">https://www.jamsilkids.com/RhapsodyOfReality/DetailWords</div>
            }
        </div>
    </article>

</div>

<!-- ═══ 하단 액션바 ═══ -->
@if (!methodTEXT)
{
    <nav class="abar">
        <a class="ab main" href="/">🏠 홈</a>
        @if (isSuperAdmin)
        {
            <a class="ab" href="/RhapsodyOfReality/DetailList">📂 QT 목록</a>
