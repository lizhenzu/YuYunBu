@model UploadDataWithID
@using BulletinBoard.Common;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@inject IAuthService AuthService
 

<h1>Add Info.</h1>

<form asp-action="SaveUploadData" method="post">
    <div>
        @for (int i = 0; i < Model.UploadDatas.Count; i++)
        {
            <div>
                <input type="hidden" asp-for="@Model.UploadDatas[i].UploadID" />
                <input type="hidden" asp-for="@Model.UploadDatas[i].TEXTData" />
                <input type="hidden" asp-for="@Model.UploadDatas[i].URLData" />
                <input type="checkbox" asp-for="@Model.UploadDatas[i].checkData" />
                <label asp-for="@Model.UploadDatas[i].checkData">@Model.UploadDatas[i].TEXTData  @Model.UploadDatas[i].UploadID</label>
            </div>
        }
    </div> 
    <input type="hidden" id="WeeklyWordToReadID" name="WeeklyWordToReadID" value="@Model.WeeklyWordToReadID" />
    <input type="hidden" id="SelectedCategory" name="SelectedCategory" value="@Model.SelectedCategory.ToString()" />
    <button type="submit" name="action" value ="save">Save</button>
    <button type="submit" name="action" value="delete">Delete</button>

</form>
<br />
<br />
<button onclick="redirectToPage('/FileUpload/Upload?category=@Model.SelectedCategory.ToString()')">추가</button>
<button onclick="redirectToPage('/WeeklyReport/IndexByID?Id=@Model.WeeklyWordToReadID')">돌아가기</button>
<script>
    function redirectToPage(URL) {
        window.location.href = URL;
    }
</script>