@model BulletinBoard.Models.RhapsodyOfReality
@using BulletinBoard.Common
@*  ══════════════════════════════════════════════════════════════
    오늘의 5분 말씀 — 수정
    · 2026-10-05 시안 확정 — 사이트 공통 틀(초록 · 하늘색 버튼) 대신 따로 그린 밝은 흰색 화면
    · 저장하면 ModifyProcess → QT 목록(DetailList)으로 돌아간다
    · 이전 화면은 ModifyView.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@
@{
    Layout = null;
    ViewData["IdPfx"] = "m";

    string label = "";
    if (DateTime.TryParse(Model?.ExposeDate, out var dt))
    {
        string[] dayKor = { "일", "월", "화", "수", "목", "금", "토" };
        label = $"{dt.Month}월 {dt.Day}일 {dayKor[(int)dt.DayOfWeek]}요일";
    }
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>5분 말씀 수정@(label == "" ? "" : " · " + label)</title>
    <partial name="_RrStyle" />
</head>
<body>
<div class="pz">

    <div class="bar">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/RhapsodyOfReality/DetailList">QT 목록</a><span class="sep">›</span>@(label == "" ? "수정" : label.Substring(0, label.LastIndexOf(' ')) + " 수정")</span>
        <a class="nb" href="/RhapsodyOfReality/DetailWords?Id=@Model.Id">보기 →</a>
    </div>
    <div class="prog"></div>

    <div class="kk" style="margin-top:20px">오늘의 5분 말씀 · 수정</div>
    <h1 class="h1">@(label == "" ? "말씀 수정" : label)</h1>

    <form method="post" action="/RhapsodyOfReality/ModifyProcess" class="fm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <partial name="_RrForm" model="Model" view-data="ViewData" />
        <div class="acts">
            <a class="nb" href="/RhapsodyOfReality/DetailList">목록으로</a>
            <div class="grp">
                <a class="nb" href="/RhapsodyOfReality/DetailWords?Id=@Model.Id" target="_blank" rel="noopener">미리 보기</a>
                <button class="nb pri" type="submit">저장</button>
            </div>
        </div>
    </form>

</div>
</body>
</html>
