@model BulletinBoard.Models.RhapsodyOfReality

<style>
 

    .button {
        margin: 5px 0;
    }

  

    .header {
        text-align: center;
        padding: 20px;
        background-color: #4CAF50;
        color: white;
    }

        .header h1, .header h3, .header h4 {
            margin: 10px 0;
        }

    .buttons {
        display: flex;
        padding: 20px 0;
        flex-direction: column;
        margin-bottom: 5.5px;
    }

    .buttons2 {
        display: flex;
        justify-content: space-between;
        padding: 20px 0;
        margin: 3px;
        margin-bottom: 5.5px;
        gap: 7px;
    }

    .button {
        flex: 1;
        padding: 10px;
        margin-left: 5px;
        margin-right: 5px;
        text-align: center;
        border-radius: 5px;
        cursor: pointer;
        background-color: #E8E8FF;
    }

        .button.choice {
            background-color: #FFEB3B; /* Yellow */
        }

        .button.subjective {
            background-color: #2196F3; /* Blue */
            color: white;
        }

        .button.back {
            background-color: #E8E8FF;
            color: black;
        }

        .button.main {
            background-color: #4CAF50; /* Green */
            color: white;
        }

        .button.home {
            background-color: #00BCD4; /* Cyan */
            color: white;
        }

    .error {
        color: red;
        font-size: 0.9em;
        margin-top: 5px;
    }

    @@media (max-width: 600px) {

        .button {
            margin: 5px 0;
        }
    }
</style>


<form asp-action="ModifyProcess" method="post" class="verse-form">

    <div class="card-header-middle">
        <h2>성경QT 수정</h2>
    </div>

    <div class="form-header">
        <h2>@ViewData["Title"]</h2>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>
 
    <div class="form-group">
        <label asp-for="ExposeDate"></label>
        <input type="date" asp-for="ExposeDate" class="Reciteonly-field" style="width: 100%;" />
        <span asp-validation-for="ExposeDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="WordTitle"></label>
        <input asp-for="WordTitle" class="Reciteonly-field" style="width: 100%;" />
        <span asp-validation-for="WordTitle" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="YouTuBuURL"></label>
        <input asp-for="YouTuBuURL" class="Reciteonly-field" style="width: 100%;" />
        <span asp-validation-for="YouTuBuURL" class="text-danger"></span>
    </div>

    <div class="form-group" style="display: flex; gap: 10px; align-items: center;">
        <label style="white-space: nowrap;">실행시간</label>
        <input type="number" asp-for="EndMinute" class="form-control" placeholder="분" min="0" style="width:80px;" />
        <input type="number" asp-for="EndSecond" class="form-control" placeholder="초" min="0" max="59" style="width:80px;" />
        <span class="text-muted">(예: 1분 15초)</span>
    </div>

    <div class="form-group">
        <label asp-for="WordPhrase"></label>
        <textarea id="WordPhrase" name="WordPhrase" asp-for="WordPhrase" class="form-control" rows="12" autofocus></textarea>
        <span asp-validation-for="WordPhrase" class="text-danger"></span>
    </div>

   
    <div class="form-group">
        <label asp-for="WordPray"></label>
        <textarea id="WordPray" name="WordPray" asp-for="WordPray" class="form-control" rows="12" autofocus></textarea>
        <span asp-validation-for="WordPray" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="HolyWord"></label>
        <textarea id="HolyWord" name="HolyWord" asp-for="HolyWord" class="form-control" rows="12" autofocus></textarea>
        <span asp-validation-for="HolyWord" class="text-danger"></span>
    </div>

    <input type="hidden" id="Id" name="Id" value="@Model.Id" />

    <div class="form-group">
        <button type="submit" class="btn-submit">제출</button>
    </div>   
</form>
 
<div class="buttons2">
    <div class="button main" onclick="location.href='/RhapsodyOfReality/DetailList'">QT홈으로</div>
    <div class="button home" onclick="location.href='/'">Home</div>
 
    </div>
 
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial") 
} 