@model BulletinBoard.Models.RhapsodyOfRealityComposite
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    var todayDate = DateHelper.GetTodayDateDayString();
    string formattedModResultData = $"preach_{todayDate}.webp";
    string formattedModResultDataOG = $"{@ViewBag.Domain}/images/preach/{formattedModResultData}";
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}

@{
    int Year  = int.Parse(Model.RhapsodyOfRealitysData.ExposeDate.Substring(0, 4));
    int Month = int.Parse(Model.RhapsodyOfRealitysData.ExposeDate.Substring(5, 2));
    int Day   = int.Parse(Model.RhapsodyOfRealitysData.ExposeDate.Substring(8, 2));
    string DateString = $"{Year}년 {Month}월 {Day}일 {Model.RhapsodyOfRealitysData.WeekDayKor}요일";
}

@{
    var user        = await AuthService.GetSignedUser(User);
    var isSignedIn  = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin     = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model?.RhapsodyOfRealitysData?.WordTitle · @ChurchName</title>
    <meta property="og:title"       content="@Model?.RhapsodyOfRealitysData?.WordTitle" />
    <meta property="og:description" content="@DateString · @ChurchName @DepartmentName" />
    <meta property="og:image"       content="@formattedModResultDataOG" />
    <meta property="og:url"         content="@ViewBag.FullURL" />
    <meta property="og:type"        content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@300;400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,500;1,400&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg:            #0a0c14;
            --bg2:           #10121e;
            --bg3:           #181c2e;
            --card-bg:       #141828;
            --border:        rgba(255,255,255,0.11);
            --text:          #f0ecff;
            --text2:         #ccc6ee;
            --text3:         #9490b4;
            --gold:          #f0c460;
            --gold-dim:      rgba(240,196,96,0.18);
            --gold-glow:     rgba(240,196,96,0.30);
            --blue:          #7aa8ff;
            --blue-dim:      rgba(122,168,255,0.14);
            --purple:        #a87dff;
            --purple-dim:    rgba(168,125,255,0.13);
            --r:             16px;
            --r2:            24px;
            --shadow:        0 8px 32px rgba(0,0,0,0.50), inset 0 1px 0 rgba(255,255,255,0.07);
            --font-serif:    'Noto Serif KR', 'Georgia', serif;
            --font-sans:     'Noto Sans KR', 'system-ui', sans-serif;
            --font-display:  'Playfair Display', 'Noto Serif KR', serif;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            color: var(--text);
            font-family: var(--font-sans);
            font-weight: 400;
            background-color: var(--bg);
            background-image:
                radial-gradient(ellipse 70% 50% at 15% 0%,   rgba(91,141,238,0.13)  0%, transparent 55%),
                radial-gradient(ellipse 55% 45% at 88% 15%,  rgba(139,92,246,0.11)  0%, transparent 55%),
                radial-gradient(ellipse 40% 35% at 50% 100%, rgba(232,184,75,0.07)  0%, transparent 60%);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* TOP NAV */
        .top-nav {
            position: sticky;
            top: 0;
            z-index: 200;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            height: 56px;
            background: rgba(10,12,20,0.82);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }
        .nav-left { display: flex; align-items: center; gap: 10px; }
        .nav-home-btn {
            display: flex; align-items: center; gap: 7px;
            padding: 7px 14px;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.18);
            background: rgba(255,255,255,0.09);
            color: #d8d4f0;
            font-size: 13px; font-weight: 600;
            text-decoration: none;
            transition: all .18s;
        }
        .nav-home-btn:hover { background: rgba(255,255,255,0.16); color: #fff; }
        .nav-date-pill {
            display: flex; align-items: center; gap: 6px;
            padding: 5px 13px;
            border-radius: 999px;
            background: var(--gold-dim);
            border: 1px solid rgba(232,184,75,0.30);
            font-size: 12px; font-weight: 600;
            color: var(--gold);
            letter-spacing: .04em;
        }
        .nav-right { display: flex; align-items: center; gap: 8px; }
        .nav-admin-btn {
            padding: 6px 13px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.16);
            background: rgba(255,255,255,0.08);
            color: #ccc8e8;
            font-size: 12px; font-weight: 600;
            cursor: pointer; text-decoration: none;
            transition: all .18s;
        }
        .nav-admin-btn:hover { background: rgba(255,255,255,0.16); color: #fff; }
        .nav-admin-btn.kakao {
            background: rgba(254,229,0,0.15);
            border-color: rgba(254,229,0,0.40);
            color: #ffe600;
        }
        .nav-admin-btn.kakao:hover { background: rgba(254,229,0,0.25); }

        /* SHELL */
        .shell {
            max-width: 860px;
            margin: 0 auto;
            padding: 32px 18px 140px;
        }

        /* HERO */
        .hero-section {
            margin-bottom: 28px;
            padding: 36px 40px 32px;
            border-radius: var(--r2);
            background: #13172a;
            border: 1px solid var(--border);
            border-top: 1px solid rgba(255,255,255,0.16);
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
        }
        .hero-section::before {
            content: '';
            position: absolute;
            top: -80px; right: -60px;
            width: 280px; height: 280px;
            background: radial-gradient(circle, rgba(232,184,75,0.14) 0%, transparent 65%);
            pointer-events: none;
        }
        .hero-eyebrow {
            display: inline-flex; align-items: center; gap: 8px;
            font-size: 11px; font-weight: 600;
            letter-spacing: .14em; text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 14px;
        }
        .hero-eyebrow::before { content: '✦'; font-size: 10px; opacity: .7; }
        .hero-title {
            font-family: var(--font-serif);
            font-size: clamp(1.5rem, 3vw, 2.2rem);
            font-weight: 700;
            line-height: 1.3;
            color: #f5f2ff;
            margin: 0 0 10px;
            position: relative; z-index: 1;
            text-shadow: 0 2px 12px rgba(0,0,0,0.5);
        }
        .hero-divider {
            width: 48px; height: 3px;
            background: linear-gradient(90deg, var(--gold), transparent);
            border-radius: 2px;
            margin-top: 14px;
        }

        /* MAIN GRID */
        .main-grid {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 22px;
            align-items: start;
        }
        @@media (max-width: 860px) { .main-grid { grid-template-columns: 1fr; } }
        .col-left  { display: flex; flex-direction: column; gap: 22px; }
        .col-right { display: flex; flex-direction: column; gap: 22px; }

        /* CARDS */
        .g-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-top: 1px solid rgba(255,255,255,0.15);
            border-radius: var(--r2);
            box-shadow: var(--shadow);
            overflow: hidden;
        }
        .g-card-hd {
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            background: rgba(255,255,255,0.03);
        }
        .g-card-hd-left { display: flex; align-items: center; gap: 10px; }
        .section-icon {
            width: 32px; height: 32px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px;
            background: rgba(255,255,255,0.08);
            border: 1px solid var(--border);
            flex-shrink: 0;
        }
        .section-icon.gold   { background: var(--gold-dim);   border-color: rgba(232,184,75,0.25); }
        .section-icon.blue   { background: var(--blue-dim);   border-color: rgba(91,141,238,0.25); }
        .section-icon.purple { background: rgba(168,125,255,0.13); border-color: rgba(139,92,246,0.25); }
        .g-card-title { font-size: 14px; font-weight: 700; color: var(--text); letter-spacing: .01em; }
        .g-card-bd { padding: 22px 20px; }

        /* SCRIPTURE */
        .scripture-plain {
            font-family: var(--font-serif);
            font-size: 17px;
            line-height: 1.95;
            color: #e0dcf8;
            font-weight: 400;
            margin: 0 0 12px;
        }

        /* PRAYER */
        .prayer-card {
            position: relative;
            overflow: hidden;
            background: #161a30;
            border: 1px solid rgba(168,125,255,0.28);
            border-top: 1px solid rgba(255,255,255,0.13);
            border-radius: var(--r2);
            box-shadow: var(--shadow);
        }
        .prayer-card::after {
            content: '';
            position: absolute;
            top: -50px; right: -50px;
            width: 200px; height: 200px;
            background: radial-gradient(circle, rgba(240,196,96,0.10) 0%, transparent 65%);
            pointer-events: none;
        }
        .prayer-card-hd {
            display: flex; align-items: center; gap: 10px;
            padding: 14px 20px;
            border-bottom: 1px solid rgba(168,125,255,0.22);
            background: rgba(168,125,255,0.07);
        }
        .prayer-cross { font-size: 16px; color: var(--gold); opacity: .85; }
        .prayer-text {
            font-family: var(--font-serif);
            font-size: 16.5px;
            line-height: 2.0;
            color: #ddd8f8;
            font-weight: 400;
            position: relative; z-index: 1;
            white-space: pre-line;
            text-shadow: 0 1px 4px rgba(0,0,0,0.5);
        }

        /* REFERENCE */
        .ref-list { display: flex; flex-direction: column; gap: 8px; }
        .ref-acc {
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.11);
            overflow: hidden;
            background: rgba(255,255,255,0.03);
            transition: border-color .2s;
        }
        .ref-acc:hover { border-color: rgba(122,168,255,0.35); }
        .ref-acc[open] { border-color: rgba(122,168,255,0.40); background: rgba(122,168,255,0.05); }
        .ref-acc summary {
            list-style: none; cursor: pointer;
            padding: 12px 14px;
            display: flex; align-items: center; gap: 8px;
            font-size: 13px; font-weight: 700;
            color: #a0c4ff;
            user-select: none;
            transition: background .15s;
        }
        .ref-acc summary::-webkit-details-marker { display: none; }
        .ref-acc summary::before {
            content: '›'; font-size: 18px; line-height: 1;
            color: var(--text3); transition: transform .2s; flex-shrink: 0;
        }
        .ref-acc[open] summary::before { transform: rotate(90deg); color: #a0c4ff; }
        .ref-acc summary:hover { background: rgba(255,255,255,0.04); }
        .ref-acc-bd { padding: 0 12px 12px; display: flex; flex-direction: column; gap: 6px; }
        .ref-verse {
            display: flex; gap: 10px;
            padding: 10px 12px;
            border-radius: 8px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.09);
            font-size: 14px; line-height: 1.78;
            font-family: var(--font-serif);
            font-weight: 400;
            color: #d8d3f4;
        }
        .ref-verse-num {
            font-size: 11px; font-weight: 800;
            color: #7aa8ff; min-width: 22px;
            margin-top: 3px; flex-shrink: 0;
            font-family: var(--font-sans);
        }
        .ref-verse-text { flex: 1; }

        /* REVEAL */
        .reveal {
            opacity: 0; transform: translateY(18px);
            transition: opacity .55s ease, transform .55s ease;
        }
        .reveal.in { opacity: 1; transform: none; }

        /* FLOATING ACTION BAR */
        .actionbar {
            position: fixed;
            left: 12px; right: 12px; bottom: 14px;
            z-index: 300;
            display: flex; align-items: center; justify-content: center;
            flex-wrap: wrap; gap: 8px;
            padding: 10px 14px;
            background: rgba(10,12,20,0.90);
            border: 1px solid var(--border);
            border-top: 1px solid rgba(255,255,255,0.10);
            border-radius: 18px;
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            box-shadow: 0 16px 48px rgba(0,0,0,0.55), 0 2px 0 rgba(255,255,255,0.04) inset;
            max-width: 700px;
            margin: 0 auto;
        }
        .ab-btn {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 9px 16px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.18);
            background: rgba(255,255,255,0.10);
            color: #d8d4f0;
            font-size: 13px; font-weight: 600;
            cursor: pointer; text-decoration: none;
            transition: all .18s;
            white-space: nowrap;
        }
        .ab-btn:hover { background: rgba(255,255,255,0.18); color: #fff; border-color: rgba(255,255,255,0.30); }
        .ab-btn.kakao-btn {
            background: rgba(254,229,0,0.18);
            border-color: rgba(254,229,0,0.45);
            color: #ffe600;
            font-weight: 700;
        }
        .ab-btn.kakao-btn:hover { background: rgba(254,229,0,0.28); }

        /* KAKAO SHARE HINT BANNER */
        .share-hint {
            display: flex; align-items: center; gap: 10px;
            padding: 12px 18px;
            margin-bottom: 20px;
            border-radius: 12px;
            background: rgba(254,229,0,0.07);
            border: 1px solid rgba(254,229,0,0.25);
            font-size: 13px; font-weight: 500;
            color: #ffe600;
        }

        @@media (max-width: 640px) {
            .shell { padding: 20px 12px 130px; }
            .hero-section { padding: 24px 20px 20px; }
            .g-card-bd { padding: 16px 14px; }
            .scripture-plain { font-size: 15.5px; }
            .prayer-text { font-size: 15px; }
            .top-nav { padding: 0 12px; }
            .nav-date-pill { font-size: 11px; }
        }
        @@media (max-width: 420px) {
            .hero-title { font-size: 1.3rem; }
        }
    </style>
</head>

<body>

    <nav class="top-nav">
        <div class="nav-left">
            <a href="/" class="nav-home-btn">🏠 홈</a>
            <div class="nav-date-pill">📅 @DateString</div>
        </div>
        <div class="nav-right">
            <a href="/RhapsodyOfReality/DetailWords?Id=@Model?.RhapsodyOfRealitysData?.Id"
               class="nav-admin-btn">🎥 영상보기</a>
            @if (isSuperAdmin)
            {
                <a href="/RhapsodyOfReality/DetailList"
                   class="nav-admin-btn">📂 목록</a>
            }
            <button class="nav-admin-btn kakao" onclick="shareKakao()">💬 카카오 공유</button>
        </div>
    </nav>

    <div class="shell">

        <div class="share-hint">
            💬 이 페이지를 카카오톡으로 공유하세요 — 아래 버튼을 탭하면 바로 공유됩니다.
        </div>

        <header class="hero-section reveal">
            <div class="hero-eyebrow">오늘의 말씀</div>
            <h1 class="hero-title">@Model?.RhapsodyOfRealitysData?.WordTitle</h1>
            <div class="hero-divider"></div>
        </header>

        <div class="main-grid">

            <div class="col-left">

                <!-- 말씀 CARD -->
                <article class="g-card reveal">
                    <div class="g-card-hd">
                        <div class="g-card-hd-left">
                            <div class="section-icon gold">📖</div>
                            <span class="g-card-title">오늘의 말씀</span>
                        </div>
                    </div>
                    <div class="g-card-bd">
                        @{
                            var phrase = Model?.RhapsodyOfRealitysData?.WordPhrase ?? "";
                            var lines  = phrase.Split(new[]{"\r\n","\n"}, StringSplitOptions.None);
                            foreach (var ln in lines)
                            {
                                if (!string.IsNullOrWhiteSpace(ln))
                                {
                                    <p class="scripture-plain">@ln</p>
                                }
                            }
                        }
                    </div>
                </article>

                <!-- 기도 CARD -->
                <article class="prayer-card reveal">
                    <div class="prayer-card-hd">
                        <div class="section-icon purple">🙏</div>
                        <span class="g-card-title">기도</span>
                        <span class="prayer-cross" style="margin-left:4px;">✝</span>
                    </div>
                    <div class="g-card-bd">
                        <p class="prayer-text">@Model?.RhapsodyOfRealitysData?.WordPray</p>
                    </div>
                </article>

            </div>

            <aside class="col-right">
                <article class="g-card reveal">
                    <div class="g-card-hd">
                        <div class="g-card-hd-left">
                            <div class="section-icon blue">📝</div>
                            <span class="g-card-title">참고 성경</span>
                        </div>
                    </div>
                    <div class="g-card-bd">
                        <div class="ref-list">
                            @foreach (var va in Model?.eBibleDatas ?? Enumerable.Empty<eBibles>())
                            {
                                <details class="ref-acc">
                                    <summary>@va.JanZulString</summary>
                                    <div class="ref-acc-bd">
                                        @if (!string.IsNullOrEmpty(va.BibleText))
                                        {
                                            foreach (var v in va.eBibleDatas)
                                            {
                                                <div class="ref-verse">
                                                    <span class="ref-verse-num">@v.zul</span>
                                                    <span class="ref-verse-text">@v.BibleData</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    </div>
                </article>
            </aside>

        </div>
    </div>

    <!-- FLOATING ACTION BAR -->
    <div class="actionbar no-select">
        <a class="ab-btn" href="/">🏠 홈</a>
        <a class="ab-btn" href="/RhapsodyOfReality/DetailWords?Id=@Model?.RhapsodyOfRealitysData?.Id">🎥 영상보기</a>
        <button class="ab-btn kakao-btn" onclick="shareKakao()">💬 카카오 공유</button>
    </div>

    <!-- KAKAO SDK -->
    <script src="https://t1.kakaocdn.net/kakao_js_sdk/2.7.2/kakao.min.js"
            integrity="sha384-TiCUE00h649CAMonG018J2ujOgDKW/kVWlChEuu4jK2vxfAAD0eZxzCKakxg55G4"
            crossorigin="anonymous"></script>
    <script>
        // 카카오 앱 키 (실제 앱 키로 교체 필요)
        if (window.Kakao && !Kakao.isInitialized()) {
            Kakao.init('YOUR_KAKAO_JAVASCRIPT_KEY');
        }

        function shareKakao() {
            if (!window.Kakao || !Kakao.isInitialized()) {
                // 카카오 SDK 없을 때 URL 복사로 대체
                copyLink();
                return;
            }
            Kakao.Share.sendDefault({
                objectType: 'feed',
                content: {
                    title: '@Html.Raw(Model?.RhapsodyOfRealitysData?.WordTitle?.Replace("'", "\\'") ?? "")',
                    description: '@DateString · @Html.Raw((ChurchName ?? "") + " " + (DepartmentName ?? ""))',
                    imageUrl: '@formattedModResultDataOG',
                    link: {
                        mobileWebUrl: window.location.href,
                        webUrl: window.location.href
                    }
                },
                buttons: [{
                    title: '말씀 보기',
                    link: {
                        mobileWebUrl: window.location.href,
                        webUrl: window.location.href
                    }
                }]
            });
        }

        function copyLink() {
            var url = window.location.href;
            if (navigator.clipboard) {
                navigator.clipboard.writeText(url).then(function() {
                    alert('링크가 복사되었습니다!\n카카오톡에 붙여넣기하세요 📋');
                });
            } else {
                var ta = document.createElement('textarea');
                ta.value = url;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                alert('링크가 복사되었습니다!\n카카오톡에 붙여넣기하세요 📋');
            }
        }
    </script>

    <!-- SCROLL REVEAL -->
    <script>
        (function () {
            var obs = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting) {
                        e.target.classList.add('in');
                        obs.unobserve(e.target);
                    }
                });
            }, { threshold: 0.07 });
            document.querySelectorAll('.reveal').forEach(function (el, i) {
                el.style.transitionDelay = (i * 60) + 'ms';
                obs.observe(el);
            });
        })();
    </script>

</body>
</html>
