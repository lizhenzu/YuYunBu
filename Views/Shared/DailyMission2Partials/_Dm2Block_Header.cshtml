@* Views/Shared/DailyMission2Partials/_Dm2Block_Header.cshtml *@
@model dynamic
@functions {
    string S(object v) => v == null ? "" : v.ToString();
    bool B(object v) { try { return v != null && Convert.ToBoolean(v); } catch { return false; } }
}

@{
    // 기대 입력:
    // Model.Title (string)
    // Model.BadgeOk (bool)
    // Model.BadgeText (string, optional)
    // Model.Subtitle (string, optional)
    var title = S(Model?.Title);
    var badgeOk = B(Model?.BadgeOk);
    var badgeText = S(Model?.BadgeText);
    if (string.IsNullOrWhiteSpace(badgeText)) badgeText = "완료 ✓";
    var subtitle = S(Model?.Subtitle);
}

<div class="cardTop">
    <div class="cardTitle">@title</div>
    @if (badgeOk)
    {
        <span class="badge ok">@badgeText</span>
    }
</div>
@if (!string.IsNullOrWhiteSpace(subtitle))
{
    <div class="cardSub">@subtitle</div>
}
