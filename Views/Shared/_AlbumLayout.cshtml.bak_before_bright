@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@using BulletinBoard.Enums
@using Microsoft.AspNetCore.Http
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@*
    앨범 공통 레이아웃 — Bone 톤 (wwwroot/css/board-bone.css)
    · 검은 머리: 경로(사진·영상 › …) + 각 화면의 PageHeader
    · Details 의 업로드/선택/뷰어 스크립트가 Bootstrap 보조 클래스(d-none, d-flex, spinner-border …)를 쓰므로
      Bootstrap 은 그대로 두고, 버튼·카드 색만 Bone 으로 덮어쓴다.
    · ViewData["Crumb"] : 경로 마지막 이름 (기본 "앨범")
*@
@{
    Layout = null;
    var pageTitle = ViewData["Title"] as string ?? "앨범";
    var crumb = ViewData["Crumb"] as string ?? "앨범";
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@pageTitle · 사진 앨범</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&family=Inter:wght@200;400;500;600&family=Gothic+A1:wght@400;600&display=swap" rel="stylesheet">
    <link href="~/css/board-bone.css" rel="stylesheet" asp-append-version="true" />

    <style>
        /* ── 판 ── */
        body.alb { background: var(--bg); color: var(--tx); font-family: "Gothic A1", system-ui, sans-serif; font-size: 15px; }
        .alb a { color: inherit; text-decoration: none; }
        .alb .sh { max-width: 1100px; }
        .alb .hd .sh { padding-bottom: 24px; }
        .alb main.sh { padding-top: 22px; }

        /* ── Bootstrap 버튼 → Bone ── */
        .alb .btn { border-radius: 0 !important; font-family: inherit; font-size: 13.5px; padding: 8px 14px; border: 1px solid var(--rule); background: var(--card); color: var(--tx); box-shadow: none !important; }
        .alb .btn:hover { border-color: var(--acc); color: var(--acc); background: var(--card); }
        .alb .btn-sm { font-size: 12.5px; padding: 5px 10px; }
        .alb .btn-brand { background: var(--tx); border-color: var(--tx); color: var(--bg); font-weight: 600; }
        .alb .btn-brand:hover { background: var(--acc); border-color: var(--acc); color: #fff; }
        .alb .btn-outline-danger { color: var(--danger); }
        .alb .btn-outline-danger:hover { border-color: var(--danger); color: var(--danger); background: var(--card); }
        .alb .btn-light { background: var(--card); color: var(--tx); }
        .alb .rounded-4, .alb .rounded-pill { border-radius: 0 !important; }

        /* 검은 머리 안의 버튼 */
        .alb .hd .btn { background: none; border-color: #3A3C40; color: var(--headtx); }
        .alb .hd .btn:hover { border-color: var(--headk); color: var(--headk); }
        .alb .hd .btn-brand { background: var(--headk); border-color: var(--headk); color: #16181C; }
        .alb .hd .btn-brand:hover { background: #D8BF94; color: #16181C; }
        .alb .hd .btn-outline-danger { color: #E08A72; }
        .alb .hd .btn-outline-danger:hover { border-color: #E08A72; color: #E08A72; }
        .alb .hd .text-secondary, .alb .hd .text-muted { color: var(--headdim) !important; }

        /* 머리 구성 */
        .albH { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
        .albH .hdK { margin-top: 22px; }
        .albH .hdT { font-size: 30px; }
        .albAct { display: flex; flex-wrap: wrap; gap: 6px; }

        /* ── 카드·표식 ── */
        .alb .glass { background: var(--card); border: 1px solid var(--rule); border-radius: 0 !important; box-shadow: none; backdrop-filter: none; }
        .alb .badge-soft { background: none; border: 1px solid var(--acc); color: var(--acc); font-weight: 600; }
        .alb .text-secondary { color: var(--dim) !important; }
        .alb .alert { border-radius: 0; border: 0; border-left: 2px solid var(--acc); background: var(--card); color: var(--tx); }
        .alb .form-check-input:checked { background-color: var(--acc); border-color: var(--acc); }
        .alb .form-check-input:focus { box-shadow: none; border-color: var(--acc); }
        .alb .spinner-border { color: var(--headk); }
        .alb .form-control { border-radius: 0 !important; border-color: var(--rule); font-family: inherit; }
        .alb .form-control:focus { border-color: var(--acc); box-shadow: none; }

        /* 업로드 끌어놓기 칸 (Details) */
        .alb .dz { border: 1px dashed var(--rule); border-radius: 0; padding: 28px; text-align: center; cursor: pointer; background: var(--bg); color: var(--dim2); transition: border-color .15s, background .15s; }
        .alb .dz:hover { border-color: var(--acc); background: var(--mark); }
        .alb .preview img { height: 84px; object-fit: cover; margin: .25rem; }

        /* 사진 격자 (Details) */
        .alb .grid { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
        @@media (min-width: 768px) { .alb .grid { grid-template-columns: repeat(3, 1fr); } }
        @@media (min-width: 1100px) { .alb .grid { grid-template-columns: repeat(4, 1fr); } }
        .alb .photo { position: relative; overflow: hidden; background: var(--card); border: 1px solid var(--rule); transition: border-color .15s; }
        .alb .photo:hover { border-color: var(--acc); }
        .alb .photo img { width: 100%; height: 230px; object-fit: cover; display: block; background: var(--mark); }
        @@media (max-width: 560px) { .alb .photo img { height: 160px; } }
        .alb .photo .top-actions { position: absolute; top: .5rem; left: .5rem; right: .5rem; display: flex; justify-content: space-between; align-items: center; z-index: 2; }
        .alb .checkbox { background: rgba(22,24,28,.7); color: #fff; padding: .2rem .55rem; border: 0; }
        .alb .bottom { display: flex; justify-content: space-between; align-items: center; padding: .6rem .75rem .8rem; }
        .alb .cover-tag { font-size: 11px; font-weight: 600; letter-spacing: .1em; padding: 2px 7px; background: var(--acc); color: #fff; }

        /* 아래 */
        .albFt { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding: 30px 0 44px; font-size: 12.5px; color: var(--dim); }
        .albFt a:hover { color: var(--acc); }
    </style>

    @RenderSection("Head", required: false)
</head>
<body class="alb">
    <header class="hd">
        <div class="sh">
            <div class="hdTop">
                <span><a href="/Albums/Branch">사진 · 영상</a><span class="sep">›</span>@crumb</span>
                <span style="display:flex;gap:14px;align-items:center">@RenderSection("NavRight", required: false)<a href="/">@ConstatsCommon.ToHome</a></span>
            </div>
            @RenderSection("PageHeader", required: false)
        </div>
    </header>

    <main class="sh">
        @RenderBody()
    </main>

    <div class="sh">
        <div class="albFt"><span>© @DateHelper.GetKoreaNow().Year 유년부 사진 앨범</span><span><a href="/Albums">앨범 목록</a> · <a href="/Albums/Branch">사진 · 영상</a></span></div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
