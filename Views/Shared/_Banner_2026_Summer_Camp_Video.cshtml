<!-- ✅ 2026 여름성경학교 다시보기 배너 -->
<section style="margin-top:8px;">

    <style>
        @@keyframes campVideoShine {
            0%   { background-position: 200% center; }
            100% { background-position: -200% center; }
        }
        @@keyframes campVideoPulse {
            0%, 100% {
                box-shadow:
                    0 18px 48px rgba(2,32,80,.22),
                    0 6px 16px rgba(2,32,80,.14),
                    0 0 0 1px rgba(56,189,248,.22),
                    inset 0 1px 0 rgba(255,255,255,.55);
            }
            50% {
                box-shadow:
                    0 18px 48px rgba(2,32,80,.30),
                    0 6px 16px rgba(2,32,80,.20),
                    0 0 0 3px rgba(56,189,248,.38),
                    inset 0 1px 0 rgba(255,255,255,.55);
            }
        }
        @@keyframes campPlayBounce {
            0%, 100% { transform: translateY(-50%) scale(1); }
            50%       { transform: translateY(-50%) scale(1.10); }
        }

        .camp-video-btn {
            display: block;
            position: relative;
            padding: 22px 18px;
            background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 40%, #7dd3fc 75%, #38bdf8 100%);
            border: 1px solid rgba(56,189,248,.45);
            overflow: hidden;
            text-decoration: none;
            cursor: pointer;
            width: 100%;
            text-align: left;
            font-family: inherit;
            animation: campVideoPulse 3.2s ease-in-out infinite;
        }

        .camp-video-btn::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(
                105deg,
                transparent 30%,
                rgba(255,255,255,.45) 50%,
                transparent 70%
            );
            background-size: 200% 100%;
            animation: campVideoShine 3.5s linear infinite;
            pointer-events: none;
        }

        .camp-video-bar {
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 8px;
            background: linear-gradient(180deg, #0ea5e9, #0284c7);
            box-shadow: 6px 0 20px rgba(14,165,233,.45);
        }

        .camp-video-play {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%) scale(1);
            width: 52px;
            height: 52px;
            border-radius: 999px;
            background: linear-gradient(135deg, #0ea5e9, #0284c7);
            border: 2px solid rgba(255,255,255,.7);
            box-shadow: 0 8px 20px rgba(2,132,199,.40);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: #fff;
            animation: campPlayBounce 2.4s ease-in-out infinite;
        }

        .camp-video-body {
            position: relative;
            padding-left: 12px;
            padding-right: 76px;
            z-index: 1;
        }

        .camp-video-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: .4px;
            color: #0369a1;
            background: rgba(255,255,255,.65);
            border: 1px solid rgba(14,165,233,.30);
            padding: 3px 10px;
            border-radius: 999px;
            margin-bottom: 8px;
        }

        .camp-video-title {
            font-size: 16px;
            font-weight: 950;
            letter-spacing: -.25px;
            color: #0c4a6e;
            line-height: 1.3;
            margin: 0;
        }

        .camp-video-sub {
            margin-top: 6px;
            font-size: 12.5px;
            font-weight: 800;
            color: rgba(12,74,110,.70);
            line-height: 1.55;
        }

        .camp-video-tag {
            color: rgba(3,105,161,.85);
        }

        #campVideoModal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: rgba(0,0,0,.85);
            align-items: center;
            justify-content: center;
            padding: 16px;
        }
        #campVideoModal.open { display: flex; }

        .camp-modal-inner {
            position: relative;
            width: 100%;
            max-width: 760px;
        }

        .camp-modal-frame-wrap {
            background: #000;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 32px 90px rgba(0,0,0,.75);
            aspect-ratio: 16 / 9;
        }

        .camp-modal-frame-wrap iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }

        .camp-modal-close {
            position: absolute;
            top: -46px;
            right: 0;
            background: rgba(255,255,255,.18);
            border: 1px solid rgba(255,255,255,.28);
            color: #fff;
            font-size: 20px;
            width: 38px;
            height: 38px;
            border-radius: 999px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .camp-modal-label {
            margin-top: 14px;
            text-align: center;
            color: rgba(255,255,255,.60);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .2px;
        }
    </style>

    <button class="camp-video-btn" onclick="openCampVideoModal()" title="2026 여름성경학교 다시보기">

        <span class="camp-video-bar"></span>

        <div class="camp-video-body">
            <div class="camp-video-eyebrow">🎬 영상 보기</div>
            <p class="camp-video-title">☀️ 2026 여름성경학교 다시보기</p>
            <div class="camp-video-sub">
                잠실새내 유년부 · 여름성경학교 현장을 함께 돌아봐요 🌊<br>
                <span class="camp-video-tag">▶ 터치하면 영상이 바로 열려요!</span>
            </div>
        </div>

        <span class="camp-video-play">▶</span>
    </button>

    <div id="campVideoModal" onclick="closeCampVideoOutside(event)">
        <div class="camp-modal-inner">
            <button class="camp-modal-close" onclick="closeCampVideoModal()" title="닫기">✕</button>
            <div class="camp-modal-frame-wrap">
                <iframe id="campVideoFrame" src=""
                        allowfullscreen
                        allow="autoplay; encrypted-media"></iframe>
            </div>
            <div class="camp-modal-label">☀️ 2026 여름성경학교 · 잠실새내 유년부 &nbsp;|&nbsp; ESC 또는 바깥을 터치하면 닫혀요</div>
        </div>
    </div>

    <script>
        function openCampVideoModal() {
            document.getElementById('campVideoFrame').src =
                'https://www.youtube.com/embed/PBoEjUYo7ZU?autoplay=1&rel=0';
            document.getElementById('campVideoModal').classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closeCampVideoModal() {
            document.getElementById('campVideoFrame').src = '';
            document.getElementById('campVideoModal').classList.remove('open');
            document.body.style.overflow = '';
        }
        function closeCampVideoOutside(e) {
            if (e.target === document.getElementById('campVideoModal')) closeCampVideoModal();
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeCampVideoModal();
        });
    </script>
</section>
