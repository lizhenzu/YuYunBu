<!-- ✅ 가정을 위한 기도 배너 -->
<section class="familyPrayerSection">
    <style>
        .familyPrayerSection {
            padding: 16px 0;
        }
        .familyPrayerWrap {
            border-radius: 20px;
            padding: 28px 24px 24px;
            background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 40%, #f5e6ff 100%);
            box-shadow: 0 8px 28px rgba(180, 120, 160, .12);
            position: relative;
            overflow: hidden;
        }
        .familyPrayerWrap::before {
            content: '';
            position: absolute;
            right: -30px;
            top: -30px;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(255,255,255,.35);
        }
        .familyPrayerWrap::after {
            content: '';
            position: absolute;
            left: -20px;
            bottom: -20px;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(244,180,200,.15);
        }
        .familyPrayerHeader {
            position: relative;
            z-index: 1;
            text-align: center;
            margin-bottom: 20px;
        }
        .familyPrayerIcon {
            font-size: 32px;
            margin-bottom: 8px;
        }
        .familyPrayerTitle {
            font-size: 20px;
            font-weight: 800;
            color: #831843;
            letter-spacing: -.3px;
        }
        .familyPrayerSub {
            font-size: 13px;
            color: #a8556e;
            margin-top: 4px;
            font-weight: 500;
        }
        /* 분홍 영역 전체를 /PrayHome/Index 로 이동하는 링크로 덮습니다.
           헤더(z-index:1)는 이 오버레이(z-index:2) 아래라 배경 클릭이 되고,
           안쪽 버튼 3개(z-index:3)는 오버레이 위라 각자 링크가 그대로 동작합니다. */
        .familyPrayerLink {
            position: absolute;
            inset: 0;
            z-index: 2;
            border-radius: inherit;
            -webkit-tap-highlight-color: transparent;
        }
        .familyPrayerWrap:hover {
            box-shadow: 0 12px 34px rgba(180, 120, 160, .20);
        }
        .familyPrayerWrap {
            transition: box-shadow .2s;
        }

        .familyPrayerBtns {
            position: relative;
            z-index: 3;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
        }
        .familyPrayerBtn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 18px 8px 16px;
            border-radius: 16px;
            background: rgba(255,255,255,.72);
            border: 1px solid rgba(190,130,160,.12);
            text-decoration: none;
            transition: all .2s;
            box-shadow: 0 2px 8px rgba(180,120,160,.06);
        }
        .familyPrayerBtn:hover {
            background: rgba(255,255,255,.95);
            box-shadow: 0 4px 16px rgba(180,120,160,.15);
            transform: translateY(-2px);
        }
        .familyPrayerBtn:active {
            transform: translateY(0);
        }
        .familyPrayerBtnIcon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }
        .familyPrayerBtn:nth-child(1) .familyPrayerBtnIcon {
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
        }
        .familyPrayerBtn:nth-child(2) .familyPrayerBtnIcon {
            background: linear-gradient(135deg, #a78bfa, #8b5cf6);
        }
        .familyPrayerBtn:nth-child(3) .familyPrayerBtnIcon {
            background: linear-gradient(135deg, #f472b6, #ec4899);
        }
        .familyPrayerBtnLabel {
            font-size: 13px;
            font-weight: 700;
            color: #4a3347;
            text-align: center;
            line-height: 1.3;
        }

        @@media (max-width: 480px) {
            .familyPrayerWrap {
                padding: 22px 16px 18px;
                border-radius: 16px;
            }
            .familyPrayerBtns {
                gap: 8px;
            }
            .familyPrayerBtn {
                padding: 14px 6px 12px;
                border-radius: 12px;
            }
            .familyPrayerBtnIcon {
                width: 38px;
                height: 38px;
                font-size: 19px;
            }
            .familyPrayerBtnLabel {
                font-size: 12px;
            }
        }
    </style>

    <div class="familyPrayerWrap">
        @* 분홍 영역 전체 클릭 → 기도 공간 *@
        <a href="/PrayHome/Index" class="familyPrayerLink" aria-label="기도 공간으로 이동"></a>

        <div class="familyPrayerHeader">
            <div class="familyPrayerIcon">🙏</div>
            <div class="familyPrayerTitle">가정을 위한 기도</div>
            <div class="familyPrayerSub">매일 사랑하는 가족을 위해 기도해 주세요</div>
        </div>

        <div class="familyPrayerBtns">
            <a href="/Prayer365?view=user" class="familyPrayerBtn">
                <div class="familyPrayerBtnIcon">👧</div>
                <div class="familyPrayerBtnLabel">자녀를 위한 365</div>
            </a>
            <a href="/BessingACouple/DetailWords?Kind=Wife" class="familyPrayerBtn">
                <div class="familyPrayerBtnIcon">👩</div>
                <div class="familyPrayerBtnLabel">아내를 위해</div>
            </a>
            <a href="/BessingACouple/DetailWords?Kind=Husband" class="familyPrayerBtn">
                <div class="familyPrayerBtnIcon">👨</div>
                <div class="familyPrayerBtnLabel">남편을 위해</div>
            </a>
        </div>
    </div>
</section>
