                    <ellipse cx="36" cy="21" rx="5" ry="12" fill="rgba(255,253,242,0.93)" transform="rotate(24,36,21)" />
                    <ellipse cx="36" cy="21" rx="4.5" ry="12" fill="rgba(255,253,242,0.91)" transform="rotate(0,36,21)" />
