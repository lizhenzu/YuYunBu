@* Views/Shared/_Banner_27_Easter.cshtml *@

<style>
    .ea-banner-root,
    .ea-banner-root * {
        box-sizing: border-box;
    }

    .ea-banner-root {
        width: 100%;
        padding: 10px 0;
        font-family: 'Noto Sans KR', sans-serif;
    }

    .ea-banner-link {
        display: block;
        width: 100%;
        text-decoration: none;
        color: inherit;
    }

    .ea-banner-wrapper {
        width: 100%;
        position: relative;
        overflow: hidden;
        background: linear-gradient(108deg, #1a0a3e 0%, #3b1572 16%, #7c3fa0 30%, #c06090 44%, #e8935a 58%, #f5c540 75%, #fef5d0 100%);
        min-height: 220px;
        border-radius: 0;
        box-shadow: 0 30px 80px rgba(2,6,23,.18), 0 12px 28px rgba(2,6,23,.12);
    }

    /* Atmospheric glow layers */
    .ea-glow-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

        .ea-glow-layer::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 55% 70% at 68% 33%, rgba(255,220,80,0.55) 0%, transparent 65%), radial-gradient(ellipse 30% 40% at 82% 22%, rgba(255,175,40,0.38) 0%, transparent 55%);
        }

        .ea-glow-layer::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 70% 35% at 50% 0%, rgba(180,120,255,0.22) 0%, transparent 60%), radial-gradient(ellipse 48% 60% at 0% 42%, rgba(18,5,58,0.6) 0%, transparent 55%);
        }

    /* SVG light rays — sits above glow, below hills/objects */
    .ea-rays-svg {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 1;
    }

    /* Hill silhouettes */
    .ea-hills {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 55%;
        pointer-events: none;
        z-index: 2;
    }

    .ea-hill {
        position: absolute;
        bottom: 0;
        border-radius: 50% 50% 0 0;
    }

    .ea-hill-1 {
        left: -8%;
        width: 50%;
        height: 65%;
        background: linear-gradient(180deg, rgba(30,10,62,0.88) 0%, rgba(12,3,30,0.96) 100%);
    }

    .ea-hill-2 {
        left: 22%;
        width: 46%;
        height: 80%;
        background: linear-gradient(180deg, rgba(42,14,80,0.82) 0%, rgba(18,5,40,0.94) 100%);
    }

    .ea-hill-3 {
        left: 48%;
        width: 55%;
        height: 58%;
        background: linear-gradient(180deg, rgba(75,42,28,0.72) 0%, rgba(40,18,8,0.9) 100%);
    }

    .ea-hill-4 {
        right: -5%;
        width: 35%;
        height: 44%;
        background: linear-gradient(180deg, rgba(95,60,30,0.62) 0%, rgba(60,30,10,0.82) 100%);
    }

    /* Golden ground mist */
    .ea-mist {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 22%;
        background: linear-gradient(0deg, rgba(255,205,70,0.42) 0%, rgba(255,185,50,0.18) 45%, transparent 100%);
        pointer-events: none;
        z-index: 3;
    }

    /* Solitary empty cross */
    .ea-cross-wrap {
        position: absolute;
        left: 20%;
        bottom: 28%;
        z-index: 5;
        pointer-events: none;
        filter: drop-shadow(0 0 16px rgba(255,210,50,0.75)) drop-shadow(0 0 40px rgba(255,170,20,0.3));
    }

    .ea-cross-beam {
        background: rgba(18, 6, 46, 0.93);
        border-radius: 1.5px;
    }

    .ea-cross-v-main {
        width: 7px;
        height: 90px;
        position: relative;
        margin: 0 auto;
    }

    .ea-cross-h-main {
        position: absolute;
        width: 46px;
        height: 6px;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
    }

    /* Empty tomb */
    .ea-tomb-wrap {
        position: absolute;
        right: 6%;
        bottom: 16%;
        z-index: 5;
        pointer-events: none;
    }

    /* Easter lily cluster */
    .ea-lily-wrap {
        position: absolute;
        left: 8%;
        bottom: 14%;
        z-index: 5;
        pointer-events: none;
    }

    /* Dove */
    .ea-dove-wrap {
        position: absolute;
        right: 28%;
        top: 11%;
        z-index: 6;
        pointer-events: none;
        opacity: 0.78;
    }

    /* Church info */
    .ea-church-info {
        position: absolute;
        top: 8%;
        right: 4%;
        display: flex;
        align-items: center;
        gap: 8px;
        z-index: 10;
    }

    .ea-church-sub {
        font-size: 7px;
        color: rgba(255, 236, 185, 0.78);
        letter-spacing: 0.5px;
        text-align: right;
        line-height: 1.3;
        font-weight: 400;
    }

    .ea-church-name {
        font-family: 'Noto Serif KR', serif;
        font-size: 22px;
        font-weight: 900;
        color: rgba(255, 248, 220, 0.96);
        letter-spacing: -1px;
        text-shadow: 0 1px 8px rgba(0,0,0,0.28);
    }

    .ea-logo-icon {
        width: 36px;
        height: 36px;
        position: relative;
        flex: 0 0 auto;
    }

        .ea-logo-icon svg {
            width: 100%;
            height: 100%;
            display: block;
        }

    /* Main title */
    .ea-title-area {
        position: absolute;
        top: 10%;
        left: 5%;
        z-index: 10;
    }

    .ea-title-eyebrow {
        font-family: 'Noto Sans KR', sans-serif;
        font-size: 11px;
        font-weight: 400;
        color: rgba(255, 228, 135, 0.82);
        letter-spacing: 4px;
        margin-bottom: 4px;
    }

    .ea-title-main {
        font-family: 'Noto Serif KR', serif;
        font-size: 54px;
        font-weight: 900;
        color: #fffae6;
        line-height: 1.05;
        letter-spacing: -2px;
        text-shadow: 0 2px 18px rgba(190,120,8,0.5), 0 0 55px rgba(255,195,35,0.22);
        font-style: italic;
    }

    .ea-title-sub {
        font-family: 'Noto Serif KR', serif;
        font-size: 28px;
        font-weight: 700;
        color: rgba(255, 234, 155, 0.93);
        letter-spacing: -0.5px;
        margin-top: 0;
        text-shadow: 0 1px 10px rgba(150,85,0,0.42);
    }

    /* Date & venue info */
    .ea-info-line {
        position: absolute;
        bottom: 9%;
        left: 0;
        right: 0;
        text-align: center;
        z-index: 10;
        padding: 0 16px;
    }

    .ea-info-text {
        font-family: 'Noto Sans KR', sans-serif;
        font-size: 14px;
        font-weight: 400;
        color: rgba(255, 240, 192, 0.95);
        letter-spacing: 2px;
        text-shadow: 0 1px 6px rgba(0,0,0,0.4);
    }

        .ea-info-text .ea-date {
            font-family: 'Noto Serif KR', serif;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: 0;
            color: #ffe450;
            text-shadow: 0 0 14px rgba(255,215,30,0.55);
        }

    /* Grain texture overlay */
    .ea-grain {
        position: absolute;
        inset: 0;
        opacity: 0.055;
        pointer-events: none;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        background-size: 128px 128px;
    }

    .ea-ink-edge {
        position: absolute;
        inset: 0;
        pointer-events: none;
        box-shadow: inset 0 0 60px rgba(18,4,55,0.28), inset 0 0 120px rgba(8,2,28,0.14);
    }

    @@media (max-width: 768px) {
        .ea-banner-wrapper {
            min-height: 180px;
        }

        .ea-title-main {
            font-size: 30px;
        }

        .ea-title-sub {
            font-size: 18px;
        }

        .ea-title-eyebrow {
            font-size: 9px;
            letter-spacing: 2px;
        }

        .ea-church-name {
            font-size: 14px;
        }

        .ea-church-sub {
            font-size: 5px;
        }

        .ea-info-text {
            font-size: 10px;
            letter-spacing: 1px;
        }

            .ea-info-text .ea-date {
                font-size: 12px;
            }

        .ea-logo-icon {
            width: 24px;
            height: 24px;
        }

        .ea-cross-v-main {
            height: 55px;
            width: 5px;
        }

        .ea-cross-h-main {
            width: 30px;
            height: 4px;
            top: 13px;
        }

        .ea-tomb-wrap {
            right: 4%;
            bottom: 14%;
        }

        .ea-dove-wrap {
            display: none;
        }
    }
</style>

<div class="ea-banner-root">
    <a href="https://www.youtube.com/watch?v=BMdne966lY0"
       class="ea-banner-link"
