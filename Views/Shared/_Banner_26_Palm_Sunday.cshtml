@* Views/Shared/_Banner_26_Palm_Sunday.cshtml *@

<style>
    .ps-banner-root,
    .ps-banner-root * {
        box-sizing: border-box;
    }

    .ps-banner-root {
        width: 100%;
        padding: 10px 0;
        font-family: 'Noto Sans KR', sans-serif;
    }

    .ps-banner-link {
        display: block;
        width: 100%;
        text-decoration: none;
        color: inherit;
    }

    .ps-banner-wrapper {
        width: 100%;
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #e8e4e0 0%, #d4d0cc 30%, #b8b4b0 60%, #9a9590 100%);
        min-height: 220px;
        border-radius: 0;
        box-shadow: 0 30px 80px rgba(2,6,23,.18), 0 12px 28px rgba(2,6,23,.12);
    }

    /* Watercolor / ink wash background layers */
    .ps-wash-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

        .ps-wash-layer::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 80% 120% at 20% 60%, rgba(80,75,70,0.4) 0%, transparent 70%), radial-gradient(ellipse 60% 100% at 50% 80%, rgba(100,95,88,0.35) 0%, transparent 60%), radial-gradient(ellipse 70% 90% at 75% 70%, rgba(90,85,78,0.3) 0%, transparent 65%);
        }

        .ps-wash-layer::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 40% 50% at 10% 90%, rgba(60,55,50,0.5) 0%, transparent 70%), radial-gradient(ellipse 50% 60% at 90% 85%, rgba(70,65,58,0.4) 0%, transparent 65%), radial-gradient(ellipse 100% 40% at 50% 100%, rgba(80,75,68,0.45) 0%, transparent 80%);
        }

    /* Mountain / hill silhouettes */
    .ps-hills {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 55%;
        pointer-events: none;
    }

    .ps-hill {
        position: absolute;
        bottom: 0;
        border-radius: 50% 50% 0 0;
    }

    .ps-hill-1 {
        left: -10%;
        width: 55%;
        height: 70%;
        background: linear-gradient(180deg, rgba(95,90,82,0.7) 0%, rgba(75,70,62,0.85) 100%);
    }

    .ps-hill-2 {
        left: 20%;
        width: 50%;
        height: 85%;
        background: linear-gradient(180deg, rgba(85,80,72,0.65) 0%, rgba(65,60,52,0.8) 100%);
    }

    .ps-hill-3 {
        left: 45%;
        width: 60%;
        height: 60%;
        background: linear-gradient(180deg, rgba(100,95,87,0.6) 0%, rgba(80,75,67,0.75) 100%);
    }

    .ps-hill-4 {
        left: 70%;
        width: 40%;
        height: 50%;
        background: linear-gradient(180deg, rgba(110,105,97,0.5) 0%, rgba(90,85,77,0.7) 100%);
    }

    /* Ground fog / mist */
    .ps-mist {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 20%;
        background: linear-gradient(0deg, rgba(70,65,58,0.9) 0%, rgba(90,85,78,0.4) 50%, transparent 100%);
        pointer-events: none;
    }

    /* Three crosses */
    .ps-crosses {
        position: absolute;
        bottom: 28%;
        left: 18%;
        display: flex;
        align-items: flex-end;
        gap: 18px;
        pointer-events: none;
        z-index: 3;
    }

    .ps-cross {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .ps-cross-beam {
        background: rgba(50,45,40,0.85);
        border-radius: 1px;
    }

    .ps-cross-h {
        position: absolute;
    }

    .ps-cross-left {
        transform: rotate(-8deg);
    }

        .ps-cross-left .ps-cross-v {
            width: 3.5px;
            height: 55px;
            position: relative;
        }

        .ps-cross-left .ps-cross-h {
            width: 28px;
            height: 3px;
            top: 12px;
            left: 50%;
            transform: translateX(-50%);
        }

    .ps-cross-center {
        margin-bottom: 8px;
    }

        .ps-cross-center .ps-cross-v {
            width: 5px;
            height: 75px;
            position: relative;
        }

        .ps-cross-center .ps-cross-h {
            width: 38px;
            height: 4px;
            top: 16px;
            left: 50%;
            transform: translateX(-50%);
        }

    .ps-cross-right {
        transform: rotate(6deg);
    }

        .ps-cross-right .ps-cross-v {
            width: 3.5px;
            height: 50px;
            position: relative;
        }

        .ps-cross-right .ps-cross-h {
            width: 26px;
            height: 3px;
            top: 11px;
            left: 50%;
            transform: translateX(-50%);
        }

    /* Church info (top-right) */
    .ps-church-info {
        position: absolute;
        top: 8%;
        right: 4%;
        display: flex;
        align-items: center;
        gap: 8px;
        z-index: 10;
    }

    .ps-church-sub {
        font-size: 7px;
        color: #555;
        letter-spacing: 0.5px;
        text-align: right;
        line-height: 1.3;
        font-weight: 400;
    }

    .ps-church-name {
        font-family: 'Noto Serif KR', serif;
        font-size: 22px;
        font-weight: 900;
        color: #333;
        letter-spacing: -1px;
    }

    .ps-logo-icon {
        width: 36px;
        height: 36px;
        position: relative;
        flex: 0 0 auto;
    }

        .ps-logo-icon svg {
            width: 100%;
            height: 100%;
            display: block;
        }

    /* Main title area */
    .ps-title-area {
        position: absolute;
        top: 10%;
        left: 5%;
        z-index: 10;
    }

    .ps-title-main {
        font-family: 'Noto Serif KR', serif;
        font-size: 48px;
        font-weight: 900;
        color: #2a2520;
        line-height: 1.15;
        letter-spacing: -2px;
        text-shadow: 1px 1px 3px rgba(255,255,255,0.3);
        font-style: italic;
    }

    .ps-title-sub {
        position: relative;
        font-family: 'Noto Serif KR', serif;
        font-size: 42px;
        font-weight: 900;
        color: #2a2520;
        line-height: 1.15;
        letter-spacing: -1px;
        margin-top: -2px;
        text-shadow: 1px 1px 3px rgba(255,255,255,0.3);
    }

    .ps-blood-drop {
        position: absolute;
        width: 14px;
        height: 18px;
        right: 2px;
        top: 5px;
    }

    /* Date & venue info */
    .ps-info-line {
        position: absolute;
        bottom: 12%;
        left: 0;
        right: 0;
        text-align: center;
        z-index: 10;
        padding: 0 16px;
    }

    .ps-info-text {
        font-family: 'Noto Sans KR', sans-serif;
        font-size: 14px;
        font-weight: 400;
        color: white;
        letter-spacing: 2px;
    }

        .ps-info-text .ps-date {
            font-family: 'Noto Serif KR', serif;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: 0;
        }

    /* Grain / texture overlay */
    .ps-grain {
        position: absolute;
        inset: 0;
        opacity: 0.08;
        pointer-events: none;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        background-size: 128px 128px;
    }

    .ps-ink-edge {
        position: absolute;
        inset: 0;
        pointer-events: none;
        box-shadow: inset 0 0 60px rgba(180,175,168,0.4), inset 0 0 120px rgba(160,155,148,0.2);
    }

    @@media (max-width: 768px) {
        .ps-banner-wrapper {
            min-height: 180px;
        }

        .ps-title-main {
            font-size: 28px;
        }

        .ps-title-sub {
            font-size: 24px;
        }

        .ps-church-name {
            font-size: 14px;
        }

        .ps-church-sub {
            font-size: 5px;
        }

        .ps-info-text {
            font-size: 10px;
            letter-spacing: 1px;
        }

            .ps-info-text .ps-date {
                font-size: 12px;
            }

        .ps-logo-icon {
            width: 24px;
            height: 24px;
        }

        .ps-cross-center .ps-cross-v {
            height: 45px;
            width: 4px;
        }

        .ps-cross-center .ps-cross-h {
            width: 24px;
            height: 3px;
            top: 10px;
        }

        .ps-cross-left .ps-cross-v {
            height: 35px;
            width: 3px;
        }

        .ps-cross-left .ps-cross-h {
            width: 18px;
            height: 2.5px;
            top: 8px;
        }

        .ps-cross-right .ps-cross-v {
            height: 32px;
            width: 3px;
        }

        .ps-cross-right .ps-cross-h {
            width: 17px;
            height: 2.5px;
            top: 7px;
        }

        .ps-blood-drop {
            width: 10px;
            height: 13px;
        }
    }
</style>

<div class="ps-banner-root">
    <a href="https://www.youtube.com/watch?v=m9sTo8AJfc4"
       class="ps-banner-link"
       rel="noopener"
       title="고난주간 특별새벽기도회">
        <div class="ps-banner-wrapper">
            <div class="ps-wash-layer"></div>

            <div class="ps-hills">
                <div class="ps-hill ps-hill-1"></div>
                <div class="ps-hill ps-hill-2"></div>
                <div class="ps-hill ps-hill-3"></div>
                <div class="ps-hill ps-hill-4"></div>
            </div>

            <div class="ps-crosses">
                <div class="ps-cross ps-cross-left">
                    <div class="ps-cross-beam ps-cross-v">
                        <div class="ps-cross-beam ps-cross-h"></div>
                    </div>
                </div>
                <div class="ps-cross ps-cross-center">
                    <div class="ps-cross-beam ps-cross-v">
                        <div class="ps-cross-beam ps-cross-h"></div>
                    </div>
                </div>
                <div class="ps-cross ps-cross-right">
                    <div class="ps-cross-beam ps-cross-v">
                        <div class="ps-cross-beam ps-cross-h"></div>
                    </div>
                </div>
            </div>

            <div class="ps-mist"></div>

            <div class="ps-church-info">
                <div>
                    <div class="ps-church-sub">대한예수교장로회</div>
                    <div class="ps-church-name">잠실새내교회</div>
                </div>
                <div class="ps-logo-icon">
                    <svg viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="30" cy="30" r="28" fill="#555" opacity="0.85" />
                        <path d="M30 10 C30 10, 22 22, 22 30 C22 38, 26 44, 30 48 C34 44, 38 38, 38 30 C38 22, 30 10, 30 10Z" fill="white" opacity="0.9" />
                        <path d="M30 18 L30 40" stroke="white" stroke-width="2" />
                        <path d="M24 28 L36 28" stroke="white" stroke-width="2" />
                        <path d="M20 24 C16 20, 18 14, 24 16 C26 16, 28 18, 30 22" stroke="white" stroke-width="1.5" fill="none" opacity="0.8" />
                        <path d="M40 24 C44 20, 42 14, 36 16 C34 16, 32 18, 30 22" stroke="white" stroke-width="1.5" fill="none" opacity="0.8" />
                    </svg>
                </div>
            </div>

            <div class="ps-title-area">
                <div class="ps-title-main">고난주간</div>
                <div class="ps-title-sub">
                    특별새벽기도회
                    <svg class="ps-blood-drop" viewBox="0 0 20 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10 0 C10 0, 2 12, 2 17 C2 22, 5.5 25, 10 25 C14.5 25, 18 22, 18 17 C18 12, 10 0, 10 0Z" fill="#c0392b" opacity="0.85" />
                        <ellipse cx="8" cy="15" rx="2" ry="2.5" fill="#e74c3c" opacity="0.4" />
                    </svg>
                </div>
            </div>

            <div class="ps-info-line">
                <span class="ps-info-text">
                    일시 <span class="ps-date">3.30</span>(월) ~ <span class="ps-date">4.3</span>(금)
                    &nbsp;&nbsp; 새벽 <span class="ps-date">5:30</span>
                    &nbsp;&nbsp; 본당 대예배실
                </span>
            </div>

            <div class="ps-grain"></div>
            <div class="ps-ink-edge"></div>
        </div>
    </a>
</div>