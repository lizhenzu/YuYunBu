<!-- ✅ CCM 찬양 배너: 자녀를 주님 손에 맡깁니다 -->
<section style="margin-top:8px;">

    <style>
        @@keyframes ccmGlow {
            0%, 100% { box-shadow: 0 20px 50px rgba(10,60,30,.28), 0 8px 18px rgba(10,60,30,.18), 0 0 0 1px rgba(74,222,128,.18), inset 0 1px 0 rgba(255,255,255,.15); }
            50%       { box-shadow: 0 20px 50px rgba(10,60,30,.36), 0 8px 18px rgba(10,60,30,.24), 0 0 0 3px rgba(74,222,128,.36), inset 0 1px 0 rgba(255,255,255,.15); }
        }

        .ccm-banner-btn {
            display: block;
            position: relative;
            padding: 20px 18px;
            background: linear-gradient(135deg, #bbf7d0, #86efac 45%, #4ade80);
            border: 1px solid rgba(74,222,128,.40);
            box-shadow:
                0 20px 50px rgba(10,60,30,.22),
                0 8px 18px rgba(10,60,30,.14),
                inset 0 1px 0 rgba(255,255,255,.40);
            overflow: hidden;
            text-decoration: none;
            cursor: pointer;
            width: 100%;
            text-align: left;
            font-family: inherit;
            animation: ccmGlow 3s ease-in-out infinite;
        }

        /* YouTube 팝업 오버레이 */
        #ccmModal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: rgba(0,0,0,.82);
            align-items: center;
            justify-content: center;
            padding: 16px;
        }
        #ccmModal.open {
            display: flex;
        }
        .ccm-modal-inner {
            position: relative;
            width: 100%;
            max-width: 720px;
            background: #000;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 30px 80px rgba(0,0,0,.7);
            aspect-ratio: 16 / 9;
        }
        .ccm-modal-inner iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }
        .ccm-close {
            position: absolute;
            top: -40px;
            right: 0;
            background: rgba(255,255,255,.15);
            border: none;
            color: #fff;
            font-size: 22px;
            width: 36px;
            height: 36px;
            border-radius: 999px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }
    </style>

    <button class="ccm-banner-btn" onclick="openCcmModal()" title="찬양 듣기 팝업 열기">

        <!-- 좌측 포인트 바 (녹색) -->
        <span style="
          position:absolute; left:0; top:0; bottom:0; width:8px;
          background: linear-gradient(180deg, #16a34a, #15803d);
          box-shadow: 6px 0 22px rgba(22,163,74,.40);
        "></span>

        <!-- 우측 재생 아이콘 -->
        <span style="
          position:absolute; right:18px; top:50%; transform:translateY(-50%);
          width:44px; height:44px; border-radius:999px;
          background:rgba(22,163,74,.20); border:1px solid rgba(22,163,74,.40);
          display:flex; align-items:center; justify-content:center;
          font-size:20px; color:#15803d;
        ">▶</span>

        <div style="position:relative; padding-left:10px; padding-right:60px;">
            <div style="
              font-size:15.5px; font-weight:950;
              letter-spacing:-.2px; color:#14532d;
              line-height:1.3;
            ">
                🎵 자녀를 주님 손에 맡깁니다
            </div>
            <div style="
              margin-top:6px; font-size:12.5px; font-weight:800;
              color:rgba(20,83,45,.75); line-height:1.5;
            ">
                지난날의 회개와 새날의 소망 · 부모가 삶으로 부르는 찬양<br>
                <span style="color:rgba(22,101,52,.80);">터치하면 바로 재생됩니다 ▶</span>
            </div>
        </div>
    </button>

    <!-- YouTube 팝업 모달 -->
    <div id="ccmModal" onclick="closeCcmModalOutside(event)">
        <div class="ccm-modal-inner">
            <button class="ccm-close" onclick="closeCcmModal()" title="닫기">✕</button>
            <iframe id="ccmFrame" src="" allowfullscreen
                    allow="autoplay; encrypted-media"></iframe>
        </div>
    </div>

    <script>
        function openCcmModal() {
            document.getElementById('ccmFrame').src =
                'https://www.youtube.com/embed/BmujuiD-O8g?autoplay=1&rel=0';
            document.getElementById('ccmModal').classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closeCcmModal() {
            document.getElementById('ccmFrame').src = '';
            document.getElementById('ccmModal').classList.remove('open');
            document.body.style.overflow = '';
        }
        function closeCcmModalOutside(e) {
            if (e.target === document.getElementById('ccmModal')) closeCcmModal();
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeCcmModal();
        });
    </script>
</section>
