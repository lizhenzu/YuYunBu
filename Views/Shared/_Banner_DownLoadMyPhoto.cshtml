<!-- =========================================================
     📸 MyPhotoPick Banner (Cookie Controlled – FULL SCOPE)
     - 동일 룰 적용
       1) 쿠키 판정 전: "결정 중..." UI(boot) 먼저 노출
       2) 쿠키 있음: 배너 DOM + 스타일(style)까지 통째로 제거
       3) 쿠키 없음: 배너+스타일 전체 표시
       4) 기존 훅(js-global-cookie-section / js-global-cookie-hide-btn) 그대로 유지
     ========================================================= -->

<div id="mypick-banner-root"
