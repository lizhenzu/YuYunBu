        .mypick-root[data-state="shown"] .mypick-banner-visual::before {
            top: 10px;
            left: 6px;
            transform: rotate(-11deg);
        }

        .mypick-root[data-state="shown"] .mypick-banner-visual::after {
            bottom: 8px;
            right: 6px;
