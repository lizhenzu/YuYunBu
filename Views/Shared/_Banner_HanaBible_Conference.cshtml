        }</style>

    <!-- ✅ 쿠키 판정 스크립트: 숨김이면 "스타일+DOM" 통째로 제거 -->
    <script>
        (function () {
            var root = document.getElementById("conference-banner-root");
            if (!root) return;

            var cookieKey = root.getAttribute("data-cookie-key") || "HanaBibleConference_2026";

            function getCookie(name) {
                var m = document.cookie.match(new RegExp("(^|;\\s*)" + name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + "=([^;]*)"));
                return m ? decodeURIComponent(m[2]) : null;
            }

            function showContent() {
                root.setAttribute("data-state", "shown");

                var boot = root.querySelector(".conf-boot");
                var content = root.querySelector(".conf-content");

                if (boot) boot.style.display = "none";
                if (content) { content.hidden = false; content.style.display = "block"; }

                // ✅ 글로벌 훅이 display:none 걸어둔 경우 대비
                root.style.display = "block";
            }

            function hideAll() {
                root.setAttribute("data-state", "hidden");

                // ✅ 스타일 제거
                var st = document.getElementById("conference-banner-style");
                if (st && st.parentNode) st.parentNode.removeChild(st);

                // ✅ DOM 통째로 제거(boot 포함)
                if (root && root.parentNode) root.parentNode.removeChild(root);
            }

            var v = getCookie(cookieKey);
            if (v) hideAll();
            else showContent();
        })();
    </script>

</div>
