            border: 2px solid rgba(255, 107, 129, 0.7);
        }

            .conf-root[data-state="shown"] .conference-banner-label .emoji {
                font-size: 1.1rem;
            }

        .conf-root[data-state="shown"] .conference-banner-title {
            margin-top: 0.3rem;
            font-weight: 900;
            letter-spacing: 0.04em;
