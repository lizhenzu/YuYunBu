            border-radius: 26px;
            background: linear-gradient(135deg, #fff8e1 0%, #ffe0f2 40%, #ffc2e0 100%);
            border: 4px solid #ff6b81;
            box-shadow: 0 14px 28px rgba(255, 107, 129, 0.35);
            color: #3b1624;
            overflow: hidden;
        }

        .conf-root[data-state="shown"] .conference-banner-header {
