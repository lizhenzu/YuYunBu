            display: flex;
            flex-wrap: wrap;
            gap: 0.8rem;
            align-items: flex-start;
            justify-content: space-between;
        }

        .conf_root_fix_dummy {
        }
        /* (코드 에디터 자동정렬용 - 영향 없음) */

        .conf-root[data-state="shown"] .conference-banner-main {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }

        .conf-root[data-state="shown"] .conference-banner::before {
