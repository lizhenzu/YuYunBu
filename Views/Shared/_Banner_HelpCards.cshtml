@using BulletinBoard.Enums

@*  ══════════════════════════════════════════════════════════════
    홈 맨 아래 카드 — 2026-10-05 A안 확정 (카드 3장을 같은 틀로: 8px · 가는 테두리 · 선 아이콘 · 이모지 없음)
    · 합친 것: 개선사항 · 불편사항 접수  /  접수 보기(SuperAdmin 만)  /  유년부 분실물(예전 파랑 그라데이션 배너)
    · 주소는 그대로: /Board/Create2?boardName=Anonymous · /Board/IndexByBoard?boardName=Anonymous · /BandBoard/Index?boardTableName=LostAndFoundPosts&boardName=분실물게시판
    · "비지니스 회화"(DailyEnglish) 카드는 basic 계정에게만 — 같은 틀로 맞춤
    · 예전 분실물 배너 파일(_Banner_LostAndFound.cshtml)은 그대로 두었다(홈에서는 더 이상 부르지 않음)
    ══════════════════════════════════════════════════════════════ *@
@{
    bool hcSuper = User?.Identity?.IsAuthenticated == true && User.IsInRole(nameof(Roles.SuperAdmin));
    bool hcBasic = string.Equals(User?.Identity?.Name, "basic", StringComparison.OrdinalIgnoreCase);
}
<section class="hcWrap" aria-label="의견과 분실물">
    <style>
        .hcWrap { margin: 10px 0 8px; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; text-align: left; }
        .hcCard { display: flex; align-items: center; gap: 13px; padding: 14px 16px; margin-bottom: 10px; background: #fff; border: 1px solid #E2E8F0; border-radius: 8px;
                  box-shadow: 0 1px 6px rgba(0,0,0,.06); color: #374151; text-decoration: none; -webkit-tap-highlight-color: transparent; }
        .hcCard:last-child { margin-bottom: 0; }
        .hcIc { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: #F4F6F9; }
        .hcIc svg { stroke: #374151; }
        .hcIc.blue  { background: #EAF2FD; } .hcIc.blue svg  { stroke: #2F80ED; }
        .hcIc.amber { background: #FBEFE7; } .hcIc.amber svg { stroke: #B4531F; }
        .hcIc.green { background: #EAF7EF; } .hcIc.green svg { stroke: #15803D; }
        .hcTx { flex: 1; min-width: 0; }
        .hcTx b { display: block; font-size: 15px; font-weight: 800; color: #111827; transition: color .15s; word-break: keep-all; }
        .hcTx small { display: block; margin-top: 2px; font-size: 12px; line-height: 1.5; color: #6B7280; word-break: keep-all; }
        .hcTx small strong { font-weight: 700; color: #374151; }
        .hcG { flex: none; font-size: 18px; font-weight: 300; color: #7FA3DB; }
        .hcTag { margin-left: 6px; padding: 2px 8px; border-radius: 999px; background: #FBEFE7; color: #B4531F; font-size: 10.5px; font-weight: 800; vertical-align: 2px; }
        .hcCard:hover .hcTx b, .hcCard:focus-visible .hcTx b { color: #2F80ED; }
        .hcCard:focus-visible { outline: 2px solid #2F80ED; outline-offset: 2px; }
    </style>

    <a class="hcCard" href="/Board/Create2?boardName=Anonymous" aria-label="개선사항 및 불편사항 접수">
        <span class="hcIc blue" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v12H8l-4 4z" /><path d="M8 9h8M8 12h5" /></svg></span>
        <span class="hcTx"><b>개선사항 · 불편사항 접수</b><small>불편했던 점이나 아이디어를 남겨 주세요</small></span>
        <span class="hcG" aria-hidden="true">›</span>
    </a>

    @if (hcBasic)
    {
        <a class="hcCard" href="/DailyEnglish" aria-label="비지니스 회화">
            <span class="hcIc blue" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v12H8l-4 4z" /><path d="M8 9h8M8 12h5" /></svg></span>
            <span class="hcTx"><b>비지니스 회화</b><small>비지니스 회화</small></span>
            <span class="hcG" aria-hidden="true">›</span>
        </a>
    }

    @if (hcSuper)
    {
        <a class="hcCard" href="/Board/IndexByBoard?boardName=Anonymous" aria-label="접수된 개선사항 및 불편사항 보기">
            <span class="hcIc amber" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13l2-8h12l2 8" /><path d="M4 13v6h16v-6h-5l-1 2h-4l-1-2z" /></svg></span>
            <span class="hcTx"><b>접수된 의견 보기<span class="hcTag">관리자</span></b><small>남겨 주신 개선사항과 불편사항을 모아 봐요</small></span>
            <span class="hcG" aria-hidden="true">›</span>
        </a>
    }

    <a class="hcCard" href="/BandBoard/Index?boardTableName=LostAndFoundPosts&boardName=분실물게시판" title="분실물 게시판으로 이동" aria-label="유년부 분실물 등록과 찾기">
        <span class="hcIc green" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" /></svg></span>
        <span class="hcTx"><b>유년부 분실물 · 등록 · 찾기</b><small>잃어버린 물건이 있나요? 게시판에 등록해 주세요. <strong>주운 분도 남겨 주세요.</strong></small></span>
        <span class="hcG" aria-hidden="true">›</span>
    </a>
</section>
