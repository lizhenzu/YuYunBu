@using BulletinBoard.Models

@{
    // ✅ ViewData["UserInfo"] 에 UserInfos가 들어있다고 가정
    var me = ViewData["UserInfo"] as UserInfo;

    // ✅ publishYN == "h" 이면 절대 노출하지 않음
    bool hideByPolicy = (me != null && string.Equals(me.birthDay_PublishYN, "h", StringComparison.OrdinalIgnoreCase));

    // ✅ 생일 정보 누락 여부
    bool needBirthFix = (me != null && !hideByPolicy && (me.bMonth == 0 || me.bDay == 0));

    // ✅ 이동 주소 (고정)
    string confirmUrl = "/humanResource/confirmbirth";
}
 
@if (needBirthFix)
{
    <style>
        /* =========================
                   🎂 Birthday Missing Notice (NEW DESIGN)
                   - 깔끔 + 귀여움 + 강조
                   - 모바일 우선 반응형
                   ========================= */

        .bb-birthfix-wrap {
            margin: 1.2rem 0 1.6rem;
        }

        .bb-birthfix-card {
            position: relative;
            overflow: hidden;
            border-radius: 24px;
            padding: 1.2rem 1.2rem 1.1rem;
            background: linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(245,253,255,0.92) 40%, rgba(255,250,235,0.92) 100%);
            border: 2px solid rgba(25,118,210,0.18);
            box-shadow: 0 18px 38px rgba(0, 0, 0, 0.08);
        }

            /* 은은한 장식 */
            .bb-birthfix-card::before {
                content: "";
                position: absolute;
                inset: -80px -120px auto auto;
                width: 260px;
                height: 260px;
                border-radius: 999px;
                background: radial-gradient(circle at 30% 30%, rgba(255,183,3,0.30), rgba(255,183,3,0) 60%);
                pointer-events: none;
            }

            .bb-birthfix-card::after {
                content: "";
                position: absolute;
                left: -90px;
                bottom: -120px;
                width: 280px;
                height: 280px;
                border-radius: 999px;
                background: radial-gradient(circle at 40% 40%, rgba(33,150,243,0.22), rgba(33,150,243,0) 65%);
                pointer-events: none;
            }

        .bb-birthfix-top {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .bb-birthfix-icon {
            width: 52px;
            height: 52px;
            flex: 0 0 52px;
            border-radius: 16px;
            background: linear-gradient(135deg, rgba(255, 183, 3, 0.95), rgba(255, 209, 102, 0.95));
            box-shadow: 0 10px 22px rgba(255,183,3,0.22);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0,0,0,0.06);
        }

            .bb-birthfix-icon span {
                font-size: 1.6rem;
                line-height: 1;
            }

        .bb-birthfix-titlebox {
            min-width: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .bb-birthfix-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            border-radius: 999px;
            background: rgba(25,118,210,0.08);
            border: 1px solid rgba(25,118,210,0.18);
            color: #0d47a1;
            font-size: 0.78rem;
            font-weight: 900;
            width: fit-content;
        }

        .bb-birthfix-title {
            font-size: 1.15rem;
            font-weight: 1000;
            color: #18324a;
            letter-spacing: 0.01em;
            margin: 0;
        }

        .bb-birthfix-desc {
            margin: 0;
            color: #3f556a;
            font-size: 0.9rem;
            line-height: 1.5;
            font-weight: 650;
        }

        .bb-birthfix-hint {
            margin-top: 10px;
            border-radius: 16px;
            padding: 10px 12px;
            background: rgba(34,197,94,0.10);
            border: 1px solid rgba(34,197,94,0.16);
            color: #14532d;
            font-size: 0.86rem;
            font-weight: 800;
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

            .bb-birthfix-hint .emoji {
                font-size: 1.15rem;
                line-height: 1.1;
            }

        .bb-birthfix-actions {
            margin-top: 12px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .bb-birthfix-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 950;
            font-size: 0.9rem;
            border: 1px solid rgba(0,0,0,0.08);
            cursor: pointer;
            transition: transform .12s ease, box-shadow .12s ease, opacity .12s ease;
            white-space: nowrap;
        }

        .bb-birthfix-btn-primary {
            background: linear-gradient(135deg, rgba(25,118,210,0.95), rgba(33,150,243,0.95));
            color: #fff;
            box-shadow: 0 10px 18px rgba(25,118,210,0.22);
        }

            .bb-birthfix-btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 14px 28px rgba(25,118,210,0.28);
                opacity: .98;
            }

        .bb-birthfix-btn-ghost {
            background: rgba(255,255,255,0.9);
            color: #1f3b55;
        }

            .bb-birthfix-btn-ghost:hover {
                transform: translateY(-1px);
                box-shadow: 0 10px 18px rgba(0,0,0,0.08);
            }

        .bb-birthfix-timer {
            margin-top: 10px;
            font-size: 0.82rem;
            font-weight: 800;
            color: #6b7f92;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            border-radius: 999px;
            background: rgba(255,255,255,0.75);
            border: 1px dashed rgba(0,0,0,0.14);
        }

            .bb-birthfix-timer strong {
                color: #0d47a1;
                font-weight: 1000;
            }

        @@media (min-width: 768px) {
            .bb-birthfix-card

        {
            padding: 1.35rem 1.45rem 1.25rem;
        }

        .bb-birthfix-title {
            font-size: 1.25rem;
        }

        .bb-birthfix-desc {
            font-size: 0.95rem;
        }

        }
    </style>

    <div class="bb-birthfix-wrap">
        <section class="bb-birthfix-card" role="region" aria-label="생일 정보 확인 안내">
            <div class="bb-birthfix-top">
                <div class="bb-birthfix-icon" aria-hidden="true">
                    <span>🎂</span>
                </div>

                <div class="bb-birthfix-titlebox">
                    <div class="bb-birthfix-badge">
                        🔔 생일 정보 확인 필요 
                    </div>

                    <h3 class="bb-birthfix-title">
                        당신의 생일 정보가 없어요, 생일 정보를 수정해 주세요
                    </h3>

                    <p class="bb-birthfix-desc">
                        생일이 등록되어 있지 않으면 <b>생일자 안내</b>와 <b>선물 기능</b>이 정상적으로 동작하지 않을 수 있어요.
                        아래 버튼을 눌러 <b>생일 정보를 먼저 등록</b>해 주세요.
                    </p>

                    <div class="bb-birthfix-hint">
                        <span class="emoji" aria-hidden="true">✅</span>
                        <div>
                            <div style="font-weight:1000;">안전 안내</div>
                            <div style="margin-top:2px;">
                                생일 정보는 필요할 때만 사용되며, 설정에 따라 공개 여부를 선택할 수 있어요.
                            </div>
                        </div>
                    </div>

                    <div class="bb-birthfix-actions">
                        <a class="bb-birthfix-btn bb-birthfix-btn-primary" href="@confirmUrl">
                            📝 생일 정보 수정하러 가기
                        </a> 
                    </div>

                
                </div>
            </div>
        </section>
    </div>

 
}
