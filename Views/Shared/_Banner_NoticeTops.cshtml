@using BulletinBoard.ViewModels.Notice
@{
    // ✅ 컨트롤러에서 "이미 선별된" 상단고정 공지 목록을 전달
    // - service/controller에서 IsPinned + PopupUntil 만료조건까지 처리
    var notices = ViewBag.PinnedNotices as List<Notice>;
}

@if (notices != null && notices.Any())
{
    <style>
        /* =========================================
                   최신 공지 배너 (nbtops 양식 유지)
                   ✅ "내용(HTML/Razor)"은 그대로, ✅ 테마 배경색만 '최신' 톤으로 교체
                   - 메타(날짜/작성자/조회수) 한 줄 정렬 + 모바일 폰트 깨짐 방지 (그대로 유지)
                   ========================================= */

        .nbtops-wrap {
            margin-top :5px;
            margin-bottom: 5px;
        }

        .nbtops-shell {
            position: relative;
            padding: 18px;
            overflow: hidden;
            border-radius: 3px;
            border: 1px solid rgba(255,255,255,.14);
            box-shadow: 0 22px 45px rgba(0,0,0,.35), 0 10px 18px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.25), inset 0 -8px 18px rgba(0,0,0,.35);
            color: #eaffff;
            /* ✅ NEW THEME (2026 느낌) : "Aurora Glass / Neo Navy"
                       - 더 깊은 네이비 베이스 + 네온 민트/스카이/바이올렛 포인트
                       - 모바일에서도 색 뭉개짐 최소화(채도/명도 밸런스 조정)
                    */
            background: radial-gradient(1200px 520px at 12% 12%, rgba(34, 211, 238, .22) 0%, rgba(34, 211, 238, 0) 58%), radial-gradient(980px 520px at 88% 22%, rgba(99, 102, 241, .22) 0%, rgba(99, 102, 241, 0) 60%), radial-gradient(980px 560px at 42% 120%, rgba(16, 185, 129, .18) 0%, rgba(16, 185, 129, 0) 62%), radial-gradient(760px 420px at 18% 92%, rgba(244, 114, 182, .12) 0%, rgba(244, 114, 182, 0) 60%), linear-gradient(135deg, #050B18 0%, #071E2A 48%, #07102A 100%);
            transform-style: preserve-3d;
            transition: transform .25s ease, box-shadow .25s ease;
        }

            /* ✅ (테마 카피) 그라데이션 테두리 라인 */
            .nbtops-shell::before {
                content: "";
                position: absolute;
                inset: -2px;
                padding: 2px;
                background: linear-gradient(90deg, rgba(34,211,238,.75), rgba(16,185,129,.70), rgba(99,102,241,.70), rgba(244,114,182,.55) );
                -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
                -webkit-mask-composite: xor;
                mask-composite: exclude;
                pointer-events: none;
                opacity: .86;
            }

            /* ✅ (테마 카피) 카드 바닥 그림자 레이어 */
            .nbtops-shell::after {
                content: "";
                position: absolute;
                left: 12%;
                right: 12%;
                bottom: -18px;
                height: 28px;
                background: radial-gradient( ellipse at center, rgba(0,0,0,.55) 0%, rgba(0,0,0,.35) 40%, rgba(0,0,0,0) 70% );
                filter: blur(14px);
                z-index: -1;
            }

            /* ✅ (테마 카피) Hover 리프트 */
            .nbtops-shell:hover {
                transform: translateY(-4px) scale(1.01);
                box-shadow: 0 32px 65px rgba(0,0,0,.45), 0 14px 26px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.28), inset 0 -10px 20px rgba(0,0,0,.4);
            }

        .nbtops-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .nbtops-h1 {
            font-size: 18px;
            font-weight: 950;
            letter-spacing: -.2px;
            line-height: 1.2;
            color: #eaffff;
            text-shadow: 0 8px 24px rgba(0,0,0,.22);
        }

        .nbtops-actions a {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border-radius: 999px;
            font-weight: 900;
            font-size: 13px;
            text-decoration: none;
            transition: transform .12s ease, box-shadow .12s ease, background .12s ease;
        }

        .nbtops-actions .btn-ghost {
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.18);
            color: #eaffff;
        }

            .nbtops-actions .btn-ghost:hover {
                transform: translateY(-2px);
                background: rgba(255,255,255,.16);
            }

        .nbtops-grid {
            display: grid;
            gap: 12px;
        }

        .nbtops-card {
            position: relative;
            padding: 14px 14px;
            border-radius: 16px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.14);
            box-shadow: 0 12px 24px rgba(0,0,0,.18);
            overflow: hidden;
            backdrop-filter: blur(6px);
        }

            .nbtops-card::after {
                content: "";
                position: absolute;
                inset: 0;
                /* ✅ 카드 하이라이트도 NEW 톤으로 살짝 조정 */
                background: radial-gradient(740px 240px at 15% 0%, rgba(34,211,238,.16), transparent 55%);
                pointer-events: none;
                opacity: .92;
            }

            .nbtops-card a {
                text-decoration: none;
                color: inherit;
                position: relative;
                z-index: 1;
                display: block;
            }

        .nbtops-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
        }

        .nbtops-ctitle {
            font-weight: 950;
            color: rgba(234,255,255,.98);
            line-height: 1.25;
            font-size: 15px;
            letter-spacing: -.1px;
            margin: 0;
        }

        .nbtops-meta {
            margin-top: 6px;
            font-size: 12px;
            color: rgba(234,255,255,.86);
            font-variant-numeric: tabular-nums;
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", Arial, sans-serif;
            letter-spacing: 0;
        }

        .meta-line {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: #eaffff;
            font-weight: 900;
            white-space: nowrap;
        }

        .meta-ico {
            font-family: "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji", emoji;
            font-size: 1em;
            line-height: 1;
            vertical-align: -0.08em;
            margin-right: 2px;
        }

        .nbtops-excerpt {
            margin-top: 10px;
            font-size: 13px;
            line-height: 1.65;
            color: rgba(234,255,255,.92);
            display: -webkit-box;
            -webkit-line-clamp: 4;
            -webkit-box-orient: vertical;
            overflow: hidden;
            word-break: break-word;
        }

        @@media (min-width: 768px) {
            .nbtops-shell {
                padding: 1.35rem 1.7rem;
            }

            .nbtops-h1 {
                font-size: 20px;
            }
        }

        @@media (min-width: 860px) {
            .nbtops-grid {
                grid-template-columns: 1fr;
            }

            .nbtops-card {
                padding: 16px 16px;
            }
        }
    </style>

    <section class="nbtops-wrap">
        <div class="nbtops-shell">

            <div class="nbtops-head">
                <div class="nbtops-h1">최신 공지</div>

                <div class="nbtops-actions">
                    <a class="btn-ghost" href="@Url.Action("Index", "Notice")" title="공지 목록">
                        공지 목록 →
                    </a>
                </div>
            </div>

            <div class="nbtops-grid">
                @foreach (var n in notices)
                {
                    <article class="nbtops-card">
                        <a href="@Url.Action("Details", "Notice", new { id = n.Id })" title="상세 보기">

                            <div class="nbtops-row">
                                <h3 class="nbtops-ctitle">@n.Title</h3>
                            </div>

                            <div class="nbtops-meta">
                                <span class="meta-line" title="작성일/작성자/조회수">
                                    @n.CreatedAt.ToString("yyyy.MM.dd") ·
                                    @(string.IsNullOrWhiteSpace(n.AuthorName) ? "관리자" : n.AuthorName)
                                    · <span class="meta-ico" aria-hidden="true">👀</span>
                                    @n.ViewCount.ToString("N0")회
                                </span>
                            </div>

                            <div class="nbtops-excerpt">
                                @Html.Raw((n.Content ?? "").Replace("\n", "<br />"))
                            </div>

                        </a>
                    </article>
                }
            </div>

        </div>
    </section>
}