@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Cfg = BulletinBoard.Models.Prayer365.Prayer365Config
@inject BulletinBoard.Services.Prayer365.IPrayer365Service Prayer365

@*  홈 배너 — 오늘의 축복 기도 (2026-09-27 확정 A안 · 기도 수첩 크림 · 금빛)
    · 초록 찬양 카드(_Banner_CCM_ChildrenToGod) 바로 위.  누르면 /Prayer365 (오늘의 기도)
    · SuperAdmin 역할, 예외로 "Basic" 계정만 (2026-09-28 — Admin 역할에게는 홈 배너를 보이지 않는다)
    · 오늘 기도문 제목만 읽는다 (가벼운 조회).  휴대폰에서는 "기도하기" 버튼을 숨긴다 *@

@{
    bool isStaff = User?.Identity?.IsAuthenticated == true
                   && (User.IsInRole(nameof(Roles.SuperAdmin))
                       || string.Equals(User.Identity?.Name, "Basic", StringComparison.OrdinalIgnoreCase));
    string? title = null;
    var today = DateHelper.GetKoreaToday();
    if (isStaff)
    {
        try { title = await Prayer365.GetTitleAsync(Cfg.Md(today)); }
        catch { title = null; }   // 표 문제면 제목 없이 배너만
    }
}

@if (isStaff)
{
    <style>
        .p365b { position: relative; display: flex; align-items: center; gap: 14px; margin: 10px 0 8px; padding: 14px 16px; border-radius: 16px;
                 text-decoration: none; color: #3a2a14; overflow: hidden; text-align: left;
                 background: linear-gradient(135deg, #fffdf6 0%, #fbf4e3 60%, #f3e6c6 100%); border: 1px solid #e9d9ad;
                 box-shadow: 0 4px 16px rgba(110,85,48,.12); transition: transform .15s, box-shadow .15s; }
        .p365b:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(110,85,48,.18); }
        .p365b::after { content: ""; position: absolute; right: -40px; bottom: -60px; width: 180px; height: 180px; border-radius: 50%;
                        background: radial-gradient(circle, #fff6d6, transparent 70%); pointer-events: none; }
        .p365b .cal { position: relative; z-index: 1; flex: none; width: 56px; text-align: center; background: #fff; border: 1px solid #e9d9ad;
                      border-radius: 10px; overflow: hidden; box-shadow: 0 2px 6px rgba(110,85,48,.1); }
        .p365b .cal b { display: block; background: #9A7B4F; color: #fff; font-size: 10.5px; font-weight: 700; padding: 3px 0; letter-spacing: .08em; }
        .p365b .cal span { display: block; font-family: "Noto Serif KR", serif; font-size: 24px; font-weight: 600; color: #6E5530; padding: 3px 0 5px; line-height: 1; }
        .p365b .tx { position: relative; z-index: 1; flex: 1; min-width: 0; }
        .p365b .k { font-size: 11.5px; font-weight: 800; color: #9A7B4F; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .p365b .lock { font-size: 10.5px; font-weight: 800; color: #B4531F; background: #FBF3EC; border: 1px solid #E7D2C4; border-radius: 999px; padding: 1px 7px; }
        .p365b .t { font-family: "Noto Serif KR", serif; font-size: 17px; font-weight: 600; margin-top: 3px; line-height: 1.35; word-break: keep-all;
                    overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
        .p365b .t.empty { color: #8a7350; font-weight: 500; }
        .p365b .s { font-size: 11.5px; color: #8a7350; margin-top: 3px; }
        .p365b .go { position: relative; z-index: 1; flex: none; font-size: 12.5px; font-weight: 800; color: #fff; background: #6E5530;
                     padding: 9px 13px; border-radius: 999px; white-space: nowrap; }
        .p365b:hover .go { background: #9A7B4F; }
        @@media (max-width: 560px) {
            .p365b .go { display: none; }   /* 휴대폰 — 버튼 없이 배너 전체를 누른다 */
            .p365b .t { font-size: 15.5px; }
        }
        @@media (prefers-reduced-motion: reduce) { .p365b { transition: none; } }
    </style>
    <a class="p365b" href="/Prayer365" aria-label="오늘의 축복 기도 보러 가기">
        <div class="cal"><b>@(today.Month)월</b><span>@today.Day</span></div>
        <div class="tx">
            <div class="k">🙏 오늘의 축복 기도 @if (Cfg.StaffOnly) { <span class="lock">🔒 회원 미리보기</span> }</div>
            @if (!string.IsNullOrWhiteSpace(title))
            {
                <div class="t">@title</div>
            }
            else
            {
                <div class="t empty">오늘 기도문을 준비하고 있어요</div>
            }
            <div class="s">@Cfg.BookTitle · @Cfg.Author</div>
        </div>
        <span class="go">기도하기 ›</span>
    </a>
}
