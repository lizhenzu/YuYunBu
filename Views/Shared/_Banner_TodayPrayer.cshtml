@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Cfg = BulletinBoard.Models.Prayer365.Prayer365Config
@inject BulletinBoard.Services.Prayer365.IPrayer365Service Prayer365

@*  ══════════════════════════════════════════════════════════════
    홈 "오늘의 기도" 통합 카드 — 2026-10-04 A안 확정 (번호 목록형)
    · 예전 두 카드를 합쳤다: 홈의 "수험생을 위한 기도"(dm2-card) + "가정을 위한 기도"(_Banner_26_Daily_Prayer)
    · 자녀 365(날짜 칩 · 오늘 기도 제목) / 수험생(D-day 칩 · 수능 날짜) / 부부(아내 · 남편 버튼) 세 줄
    · 누르는 곳은 예전 그대로: /Prayer365?view=user · /EntranceExamPray/Index · /BessingACouple/DetailWords?Kind=Wife|Husband · /PrayHome/Index
    · _Banner_26_Daily_Prayer 는 자료실(ResourceBox)에서 계속 쓰므로 그대로 둔다
    ══════════════════════════════════════════════════════════════ *@
@{
    var tpToday = DateHelper.GetKoreaToday();

    // 오늘 365 기도 제목 — 365 기도문이 공개 전(StaffOnly)이면 관리자(SuperAdmin · Admin · Basic)에게만
    bool tpStaff = User?.Identity?.IsAuthenticated == true;   // 공개 전에는 로그인한 회원만
    string? tpTitle = null;
    bool tp365Open = !Cfg.StaffOnly || tpStaff;   // 오늘 기도 제목 · 며칠째 표시도 같은 기준으로 보인다
    if (tp365Open)
    {
        try { tpTitle = await Prayer365.GetTitleAsync(Cfg.Md(tpToday)); }
        catch { tpTitle = null; }   // 표 문제면 제목 없이
    }

    // 나의 기도 일수(이번 주 도장 · 숫자 세 칸)는 2026-10-18 홈 카드에서 뺐다 — 계산도 하지 않는다

    // 관리자 참여자 줄은 2026-10-18 홈에서 뺐다 → 365 기도 화면(/Prayer365) 맨 아래로 옮김 (SuperAdmin 역할 · Basic 아이디)

    // 오늘이 한 해 365 기도 중 며칠째인지 — 책 기준(2/29 포함 366편)이라 기도문 번호와 맞는다. DB 조회 없음.
    int tpDayNo    = Cfg.DayIndex(Cfg.Md(tpToday));
    int tpDayTotal = Cfg.TotalDays;
    int tpDayPct   = tpDayTotal > 0 ? Math.Min(100, (int)Math.Round(tpDayNo * 100.0 / tpDayTotal)) : 0;

    // 수능 D-day — 해가 바뀌면 이 한 줄만 고치면 된다 (예전 홈 수험생 카드와 같은 계산)
    var tpSuneung = new DateTime(2026, 11, 19);
    int tpDday = (int)(tpSuneung - tpToday.Date).TotalDays;
    string[] tpDow = { "일", "월", "화", "수", "목", "금", "토" };
    string tpSuneungText = $"{tpSuneung:yyyy년 M월 d일} {tpDow[(int)tpSuneung.DayOfWeek]}요일 수능";
    string tpDLabel, tpDSub, tpExamTitle;
    if (tpDday > 0)       { tpDLabel = $"D-{tpDday}"; tpDSub = "수능까지";  tpExamTitle = "오늘도 수험생을 위해 기도해요"; }
    else if (tpDday == 0) { tpDLabel = "D-DAY";        tpDSub = "오늘 수능"; tpExamTitle = "시험장에 나아가는 아이와 함께 기도해요"; }
    else                  { tpDLabel = "수고했어요";    tpDSub = "수능 이후"; tpExamTitle = "지나온 걸음을 감사하며 기도해요"; }
    bool tpDIsText = tpDday < 0;
}
<section class="tpCard" aria-label="오늘의 기도">
    <style>
        /* ══════════════════════════════════════════════════════════════
           홈 "오늘의 기도" 카드 — 2026-10-18 세 번째 버전(10-11 저녁 ~ 10-16 모양)으로 되돌림 + 10-17 관리자 줄
           · 흰 카드 한 장 · 구분선 목록: 자녀 365 → (관리자) → 수험생 → 부부 → 치유
           · 자녀: 날짜 칩(연.월 · 일 · 요일) + 기도문 공개 알약 + 오늘 기도 제목 + 며칠째 막대(짧게)
           · 부부: 제목 줄 아래 아내(분홍) · 남편(파랑) 칸 (10-12 B안)
           · 관리자 줄(Basic · SuperAdmin): 카드 끝까지 꽉 찬 회색 띠 (10-17 모양)
           · 이동 로딩은 홈 공용(Index.cshtml 의 showNavLoading, 0.3초 늦게 페이드)
           · 바로 전(B-1 따로 떨어진 카드) 소스는 .bak_before_v3
           ══════════════════════════════════════════════════════════════ */
        .tpCard { margin: 0 0 10px; padding: 18px; background: #fff; border: 1px solid #E2E8F0; border-radius: 8px; box-shadow: 0 1px 6px rgba(0,0,0,.06);
                  font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; color: #374151; text-align: left; }
        .tpHd { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
        .tpK { font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
        .tpMore { flex: none; font-size: 12.5px; font-weight: 800; color: #2F80ED; background: #EAF2FD; border-radius: 999px; padding: 4px 12px; text-decoration: none; white-space: nowrap; }
        .tpMore:hover { background: #DCEAFB; color: #2F80ED; }
        .tpT { margin-top: 6px; font-size: 20px; font-weight: 800; letter-spacing: -.02em; line-height: 1.35; color: #111827; }
        .tpS { margin-top: 3px; font-size: 12.5px; color: #6B7280; }

        .tpList { margin-top: 12px; }
        .tpRow { display: flex; align-items: center; gap: 12px; padding: 13px 0; border-top: 1px solid #EEF0F3; color: inherit; text-decoration: none; }
        .tpRow:last-child { padding-bottom: 0; }
        a.tpRow:hover .tpTx b { color: #2F80ED; }
        .tpTx { flex: 1; min-width: 0; }
        .tpTx b { display: block; font-size: 15px; font-weight: 800; color: #111827; transition: color .15s; }
        .tpTx span { display: block; margin-top: 2px; font-size: 12.5px; color: #6B7280; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .tpTx span.hl { font-weight: 700; color: #2F80ED; }
        .tpTx span.vl { font-weight: 700; color: #5B54C9; }
        .tpTx span.gr { font-weight: 700; color: #1F9D78; }
        .tpG { flex: none; font-size: 18px; font-weight: 300; color: #7FA3DB; }

        /* 날짜 · D-day 칩 */
        .tpChip { flex: none; width: 52px; border-radius: 10px; overflow: hidden; background: #fff; text-align: center; box-shadow: 0 1px 2px rgba(17,24,39,.08), 0 0 0 1px #EEF0F3; }
        .tpChip small { display: block; padding: 3px 0; background: #2F80ED; color: #fff; font-size: 10.5px; font-weight: 800; letter-spacing: .02em; }
        .tpChip strong { display: block; padding: 3px 0 5px; font-size: 21px; font-weight: 300; line-height: 1.1; color: #111827; }
        /* 365 날짜 칩 — 위 연.월 · 가운데 큰 일 · 아래 요일 (평일 검정 · 토 파랑 · 일 빨강) */
        .tpChip.cal small { padding: 3px 0; font-size: 10px; letter-spacing: 0; font-variant-numeric: tabular-nums; }
        .tpChip.cal strong { padding: 2px 0 0; font-size: 24px; line-height: 1.15; }
        .tpChip.cal em { display: block; padding: 0 0 5px; font-style: normal; font-size: 10.5px; font-weight: 800; color: #111827; letter-spacing: 0; }
        .tpChip.cal em.sat { color: #2F80ED; }
        .tpChip.cal em.sun { color: #E03131; }
        .tpChip.dd small { background: #5B54C9; font-size: 10px; }
        .tpChip.dd strong { padding: 5px 0 6px; font-size: 15px; font-weight: 800; color: #5B54C9; letter-spacing: -.02em; }
        .tpChip.dd strong.txt { font-size: 11.5px; }
        .tpIc { flex: none; width: 52px; height: 50px; border-radius: 10px; background: #FDF2F4; display: grid; place-items: center; }
        .tpIc.hl { background: #E8F6F1; }

        /* 며칠째 — 가는 진행 막대 + 292일째 · 366일 중 */
        .tpTx .tpDay { display: flex; align-items: center; gap: 8px; margin-top: 7px; overflow: visible; white-space: normal; }
        .tpDay i { display: block; flex: 1; max-width: 130px; height: 5px; border-radius: 99px; background: #E5EDF9; overflow: hidden; }
        .tpDay s { display: block; height: 100%; border-radius: 99px; background: #2F80ED; text-decoration: none; }
        .tpDay em { font-style: normal; font-size: 11.5px; font-weight: 700; color: #6B7280; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .tpTx .tpDay em b { display: inline; font-size: 11.5px; font-weight: 800; color: #2F80ED; }

        /* 기도문 공개 알약 (초록 점) + 로그인 안내 한 줄 */
        .tpTx b.tpNm { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .tpOpen { font-style: normal; font-size: 11px; font-weight: 700; color: #1F9D78; background: #E8F6F1; border-radius: 999px; padding: 2px 9px; white-space: nowrap; }
        .tpOpen::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #1F9D78; margin-right: 5px; vertical-align: 1px; }
        .tpTx .tpLogin { display: flex; align-items: center; gap: 4px; margin-top: 10px; padding-top: 8px; border-top: 1px dashed #BFE5D8; font-size: 12px; font-weight: 700; color: #1F7A5C; white-space: normal; }
        .tpLogin em { font-style: normal; font-weight: 500; color: #6B7280; }

        /* 부부 — 제목 줄 아래에 아내(분홍) · 남편(파랑) 칸을 나란히 */
        .tpRow.tpCouple { flex-wrap: wrap; row-gap: 10px; }
        .tpPair { flex: 1 1 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .tpPair a { display: flex; align-items: center; justify-content: space-between; gap: 6px; border-radius: 10px; padding: 11px 13px; text-decoration: none; transition: background .15s; }
        .tpPair a span { min-width: 0; }
        .tpPair a b { display: block; font-size: 14px; font-weight: 800; white-space: nowrap; }
        .tpPair a i { display: block; margin-top: 1px; font-style: normal; font-size: 11.5px; font-weight: 600; opacity: .8; white-space: nowrap; }
        .tpPair a u { flex: none; text-decoration: none; font-size: 18px; font-weight: 300; }
        .tpPair a.wf { background: #FDF2F4; color: #C2334D; }
        .tpPair a.wf:hover { background: #FBE4E9; }
        .tpPair a.hu { background: #EAF2FD; color: #1F5FBF; }
        .tpPair a.hu:hover { background: #DCEAFB; }
        @@media (max-width: 360px) { .tpPair a i { display: none; } }

        @@media (max-width: 480px) { .tpCard { padding: 16px 14px; } .tpT { font-size: 19px; } }
    </style>

    <div class="tpHd">
        <span class="tpK">오늘의 기도</span>
        <a class="tpMore" href="/PrayHome/Index" aria-label="기도홈 — 기도 전체 보기">기도 전체 ›</a>
    </div>
    <div class="tpT">오늘도 함께 기도해요</div>
    <div class="tpS">매일 사랑하는 가족과 수험생을 위해 기도해 주세요</div>

    <div class="tpList">
        @* 자녀를 위한 365 — 날짜 칩 + 제목 · 기도문 공개 + 오늘 기도 제목 + 며칠째 막대 *@
        <a class="tpRow" href="/Prayer365?view=user" aria-label="자녀를 위한 365일 축복 기도 — 오늘 기도문">
            <span class="tpChip cal"><small>@tpToday.ToString("yyyy.MM")</small><strong>@tpToday.Day</strong><em class="@(tpToday.DayOfWeek == DayOfWeek.Sunday ? "sun" : tpToday.DayOfWeek == DayOfWeek.Saturday ? "sat" : "")">@(tpDow[(int)tpToday.DayOfWeek])요일</em></span>
            <span class="tpTx">
                <b class="tpNm">자녀를 위한 365</b>
                @if (!string.IsNullOrWhiteSpace(tpTitle))
                {
                    <span class="hl">@tpTitle</span>
                }
                else
                {
                    <span>오늘 날짜의 축복 기도문</span>
                }
                @if (tp365Open && tpDayNo > 0)
                {
                    <span class="tpDay"><i aria-hidden="true"><s style="width:@(tpDayPct)%"></s></i><em><b>@tpDayNo</b>일째 · @(tpDayTotal)일 중</em></span>
                }
                @if (!tpStaff)
                {
                    <span class="tpLogin">오늘의 기도문을 열어 보세요 <em>· 로그인 필요</em></span>
                }
            </span>
            <span class="tpG" aria-hidden="true">›</span>
        </a>

        <a class="tpRow" href="/EntranceExamPray/Index" aria-label="수험생을 위한 기도">
            <span class="tpChip dd"><small>@tpDSub</small><strong class="@(tpDIsText ? "txt" : "")">@tpDLabel</strong></span>
            <span class="tpTx">
                <b>수험생을 위해</b>
                <span class="vl">@tpExamTitle</span>
                <span>@tpSuneungText</span>
            </span>
            <span class="tpG" aria-hidden="true">›</span>
        </a>

        <div class="tpRow tpCouple">
            <span class="tpIc" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D9534F" stroke-width="2" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></svg></span>
            <span class="tpTx">
                <b>부부를 위해</b>
                <span>서로를 축복하는 기도</span>
            </span>
            <span class="tpPair">
                <a class="wf" href="/BessingACouple/DetailWords?Kind=Wife" aria-label="아내를 위한 기도 — 남편이 드리는 기도"><span><b>아내를 위해</b><i>남편이 드리는 기도</i></span><u>›</u></a>
                <a class="hu" href="/BessingACouple/DetailWords?Kind=Husband" aria-label="남편을 위한 기도 — 아내가 드리는 기도"><span><b>남편을 위해</b><i>아내가 드리는 기도</i></span><u>›</u></a>
            </span>
        </div>

        <a class="tpRow" href="/HealingAndRestorationPray/Index" aria-label="치유와 회복을 위한 기도">
            <span class="tpIc hl" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F9D78" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 8v8M8 12h8" /></svg></span>
            <span class="tpTx">
                <b>치유와 회복을 위해</b>
                <span class="gr">몸과 마음이 아픈 이를 위해</span>
            </span>
            <span class="tpG" aria-hidden="true">›</span>
        </a>
    </div>
</section>
