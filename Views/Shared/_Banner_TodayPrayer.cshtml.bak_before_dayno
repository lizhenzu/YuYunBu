@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Cfg = BulletinBoard.Models.Prayer365.Prayer365Config
@inject BulletinBoard.Services.Prayer365.IPrayer365Service Prayer365

@*  ══════════════════════════════════════════════════════════════
    홈 "오늘의 기도" 통합 카드 — 2026-10-04 A안 확정 (번호 목록형)
    · 예전 두 카드를 합쳤다: 홈의 "수험생을 위한 기도"(dm2-card) + "가정을 위한 기도"(_Banner_26_Daily_Prayer)
    · 자녀 365(날짜 칩 · 오늘 기도 제목) / 수험생(D-day 칩 · 수능 날짜) / 부부(아내 · 남편 버튼) 세 줄
    · 누르는 곳은 예전 그대로: /Prayer365?view=user · /EntranceExamPray/Index · /BessingACouple/DetailWords?Kind=Wife|Husband · /PrayHome/Index
    · _Banner_26_Daily_Prayer 는 자료실(ResourceBox)에서 계속 쓰므로 그대로 둔다
    ══════════════════════════════════════════════════════════════ *@
@{
    var tpToday = DateHelper.GetKoreaToday();

    // 오늘 365 기도 제목 — 365 기도문이 공개 전(StaffOnly)이면 관리자(SuperAdmin · Admin · Basic)에게만
    bool tpStaff = User?.Identity?.IsAuthenticated == true
                   && (User.IsInRole(nameof(Roles.SuperAdmin)) || User.IsInRole(nameof(Roles.Admin))
                       || string.Equals(User.Identity?.Name, "Basic", StringComparison.OrdinalIgnoreCase));
    string? tpTitle = null;
    if (!Cfg.StaffOnly || tpStaff)
    {
        try { tpTitle = await Prayer365.GetTitleAsync(Cfg.Md(tpToday)); }
        catch { tpTitle = null; }   // 표 문제면 제목 없이
    }

    // 수능 D-day — 해가 바뀌면 이 한 줄만 고치면 된다 (예전 홈 수험생 카드와 같은 계산)
    var tpSuneung = new DateTime(2026, 11, 19);
    int tpDday = (int)(tpSuneung - tpToday.Date).TotalDays;
    string[] tpDow = { "일", "월", "화", "수", "목", "금", "토" };
    string tpSuneungText = $"{tpSuneung:yyyy년 M월 d일} {tpDow[(int)tpSuneung.DayOfWeek]}요일 수능";
    string tpDLabel, tpDSub, tpExamTitle;
    if (tpDday > 0)       { tpDLabel = $"D-{tpDday}"; tpDSub = "수능까지";  tpExamTitle = "오늘도 수험생을 위해 기도해요"; }
    else if (tpDday == 0) { tpDLabel = "D-DAY";        tpDSub = "오늘 수능"; tpExamTitle = "시험장에 나아가는 아이와 함께 기도해요"; }
    else                  { tpDLabel = "수고했어요";    tpDSub = "수능 이후"; tpExamTitle = "지나온 걸음을 감사하며 기도해요"; }
    bool tpDIsText = tpDday < 0;
}
<section class="tpCard" aria-label="오늘의 기도">
    <style>
        .tpCard { margin: 0 0 10px; padding: 18px; background: #fff; border: 1px solid #E2E8F0; border-radius: 8px; box-shadow: 0 1px 6px rgba(0,0,0,.06);
                  font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; color: #374151; text-align: left; }
        .tpHd { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
        .tpK { font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
        .tpMore { flex: none; font-size: 12.5px; font-weight: 800; color: #2F80ED; background: #EAF2FD; border-radius: 999px; padding: 4px 12px; text-decoration: none; white-space: nowrap; }
        .tpMore:hover { background: #DCEAFB; color: #2F80ED; }
        .tpT { margin-top: 6px; font-size: 20px; font-weight: 800; letter-spacing: -.02em; line-height: 1.35; color: #111827; }
        .tpS { margin-top: 3px; font-size: 12.5px; color: #6B7280; }

        .tpList { margin-top: 12px; }
        .tpRow { display: flex; align-items: center; gap: 12px; padding: 13px 0; border-top: 1px solid #EEF0F3; color: inherit; text-decoration: none; }
        .tpRow:last-child { padding-bottom: 0; }
        a.tpRow:hover .tpTx b { color: #2F80ED; }
        .tpTx { flex: 1; min-width: 0; }
        .tpTx b { display: block; font-size: 15px; font-weight: 800; color: #111827; transition: color .15s; }
        .tpTx span { display: block; margin-top: 2px; font-size: 12.5px; color: #6B7280; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .tpTx span.hl { font-weight: 700; color: #2F80ED; }
        .tpTx span.vl { font-weight: 700; color: #5B54C9; }
        .tpTx span.gr { font-weight: 700; color: #1F9D78; }
        .tpG { flex: none; font-size: 18px; font-weight: 300; color: #7FA3DB; }

        /* 날짜 · D-day 칩 */
        .tpChip { flex: none; width: 52px; border-radius: 10px; overflow: hidden; background: #fff; text-align: center; box-shadow: 0 1px 2px rgba(17,24,39,.08), 0 0 0 1px #EEF0F3; }
        .tpChip small { display: block; padding: 3px 0; background: #2F80ED; color: #fff; font-size: 10.5px; font-weight: 800; letter-spacing: .02em; }
        .tpChip strong { display: block; padding: 3px 0 5px; font-size: 21px; font-weight: 300; line-height: 1.1; color: #111827; }
        .tpChip.dd small { background: #5B54C9; font-size: 10px; }
        .tpChip.dd strong { padding: 5px 0 6px; font-size: 15px; font-weight: 800; color: #5B54C9; letter-spacing: -.02em; }
        .tpChip.dd strong.txt { font-size: 11.5px; }
        .tpIc { flex: none; width: 52px; height: 50px; border-radius: 10px; background: #FDF2F4; display: grid; place-items: center; }
        .tpIc.hl { background: #E8F6F1; }
        /* 부부 — 한 줄 안에 아내 · 남편 */
        .tpPair { flex: none; display: flex; gap: 6px; }
        .tpPair a { font-size: 12.5px; font-weight: 800; color: #374151; background: #F4F6F9; border-radius: 999px; padding: 7px 13px; text-decoration: none; white-space: nowrap; }
        .tpPair a:hover { color: #2F80ED; background: #EAF2FD; }

        @@media (max-width: 480px) { .tpCard { padding: 16px 14px; } .tpT { font-size: 19px; } }
    </style>

    <div class="tpHd">
        <span class="tpK">오늘의 기도</span>
        <a class="tpMore" href="/PrayHome/Index" aria-label="기도홈 — 기도 전체 보기">기도 전체 ›</a>
    </div>
    <div class="tpT">오늘도 함께 기도해요</div>
    <div class="tpS">매일 사랑하는 가족과 수험생을 위해 기도해 주세요</div>

    <div class="tpList">
        <a class="tpRow" href="/Prayer365?view=user" aria-label="자녀를 위한 365일 축복 기도 — 오늘 기도문">
            <span class="tpChip"><small>@(tpToday.Month)월</small><strong>@tpToday.Day</strong></span>
            <span class="tpTx">
                <b>자녀를 위한 365</b>
                @if (!string.IsNullOrWhiteSpace(tpTitle))
                {
                    <span class="hl">@tpTitle</span>
                }
                else
                {
                    <span>오늘 날짜의 축복 기도문</span>
                }
            </span>
            <span class="tpG">›</span>
        </a>

        <a class="tpRow" href="/EntranceExamPray/Index" aria-label="수험생을 위한 기도" onclick="if(window.showNavLoading)showNavLoading();">
            <span class="tpChip dd"><small>@tpDSub</small><strong class="@(tpDIsText ? "txt" : "")">@tpDLabel</strong></span>
            <span class="tpTx">
                <b>수험생을 위해</b>
                <span class="vl">@tpExamTitle</span>
                <span>@tpSuneungText</span>
            </span>
            <span class="tpG">›</span>
        </a>

        <div class="tpRow">
            <span class="tpIc" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D9534F" stroke-width="2" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></svg></span>
            <span class="tpTx">
                <b>부부를 위해</b>
                <span>서로를 축복하는 기도</span>
            </span>
            <span class="tpPair">
                <a href="/BessingACouple/DetailWords?Kind=Wife" aria-label="아내를 위한 기도">아내</a>
                <a href="/BessingACouple/DetailWords?Kind=Husband" aria-label="남편을 위한 기도">남편</a>
            </span>
        </div>

        @* 치유와 회복을 위해 — 2026-10-11 A안(네 번째 줄)으로 추가. 이전 화면은 .bak_before_healing *@
        <a class="tpRow" href="/HealingAndRestorationPray/Index" aria-label="치유와 회복을 위한 기도" onclick="if(window.showNavLoading)showNavLoading();">
            <span class="tpIc hl" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1F9D78" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 8v8M8 12h8" /></svg></span>
            <span class="tpTx">
                <b>치유와 회복을 위해</b>
                <span class="gr">몸과 마음이 아픈 이를 위해</span>
            </span>
            <span class="tpG">›</span>
        </a>
    </div>
</section>
