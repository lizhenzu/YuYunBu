@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Cfg = BulletinBoard.Models.Prayer365.Prayer365Config
@inject BulletinBoard.Services.Prayer365.IPrayer365Service Prayer365

@*  ══════════════════════════════════════════════════════════════
    홈 "오늘의 기도" 통합 카드 — 2026-10-04 A안 확정 (번호 목록형)
    · 예전 두 카드를 합쳤다: 홈의 "수험생을 위한 기도"(dm2-card) + "가정을 위한 기도"(_Banner_26_Daily_Prayer)
    · 자녀 365(날짜 칩 · 오늘 기도 제목) / 수험생(D-day 칩 · 수능 날짜) / 부부(아내 · 남편 버튼) 세 줄
    · 누르는 곳은 예전 그대로: /Prayer365?view=user · /EntranceExamPray/Index · /BessingACouple/DetailWords?Kind=Wife|Husband · /PrayHome/Index
    · _Banner_26_Daily_Prayer 는 자료실(ResourceBox)에서 계속 쓰므로 그대로 둔다
    ══════════════════════════════════════════════════════════════ *@
@{
    var tpToday = DateHelper.GetKoreaToday();

    // 오늘 365 기도 제목 — 365 기도문이 공개 전(StaffOnly)이면 관리자(SuperAdmin · Admin · Basic)에게만
    bool tpStaff = User?.Identity?.IsAuthenticated == true;   // 공개 전에는 로그인한 회원만
    string? tpTitle = null;
    bool tp365Open = !Cfg.StaffOnly || tpStaff;   // 오늘 기도 제목 · 며칠째 표시도 같은 기준으로 보인다
    if (tp365Open)
    {
        try { tpTitle = await Prayer365.GetTitleAsync(Cfg.Md(tpToday)); }
        catch { tpTitle = null; }   // 표 문제면 제목 없이
    }

    // 나의 기도 일수(이번 주 도장 · 숫자 세 칸)는 2026-10-18 홈 카드에서 뺐다 — 계산도 하지 않는다

    // 참여자 요약 — Basic · SuperAdmin 아이디에게만 (다른 기도 화면의 관리자 기준과 같다)
    BulletinBoard.Models.Prayer365.Prayer365ParticipantsVM? tpAdm = null;
    if (PrayManagerHelper.IsPrayManager(User))
    {
        try { tpAdm = BulletinBoard.Models.Prayer365.Prayer365ParticipantsVM.Build(await Prayer365.GetAllPrayDaysAsync(), tpToday, "recent"); }
        catch { tpAdm = null; }
    }

    // 오늘이 한 해 365 기도 중 며칠째인지 — 책 기준(2/29 포함 366편)이라 기도문 번호와 맞는다. DB 조회 없음.
    int tpDayNo    = Cfg.DayIndex(Cfg.Md(tpToday));
    int tpDayTotal = Cfg.TotalDays;
    int tpDayPct   = tpDayTotal > 0 ? Math.Min(100, (int)Math.Round(tpDayNo * 100.0 / tpDayTotal)) : 0;

    // 수능 D-day — 해가 바뀌면 이 한 줄만 고치면 된다 (예전 홈 수험생 카드와 같은 계산)
    var tpSuneung = new DateTime(2026, 11, 19);
    int tpDday = (int)(tpSuneung - tpToday.Date).TotalDays;
    string[] tpDow = { "일", "월", "화", "수", "목", "금", "토" };
    string tpSuneungText = $"{tpSuneung:yyyy년 M월 d일} {tpDow[(int)tpSuneung.DayOfWeek]}요일 수능";
    string tpDLabel, tpDSub, tpExamTitle;
    if (tpDday > 0)       { tpDLabel = $"D-{tpDday}"; tpDSub = "수능까지";  tpExamTitle = "오늘도 수험생을 위해 기도해요"; }
    else if (tpDday == 0) { tpDLabel = "D-DAY";        tpDSub = "오늘 수능"; tpExamTitle = "시험장에 나아가는 아이와 함께 기도해요"; }
    else                  { tpDLabel = "수고했어요";    tpDSub = "수능 이후"; tpExamTitle = "지나온 걸음을 감사하며 기도해요"; }
    bool tpDIsText = tpDday < 0;
}
<section class="tpCard" aria-label="오늘의 기도">
    <style>
        /* ══════════════════════════════════════════════════════════════
           홈 "오늘의 기도" 카드 — 2026-10-18 B-1 시안 확정
           · 연한 회색 바탕 위에 영역마다 따로 떨어진 흰 카드 (자녀 · 관리자 · 부부 · 수험생 · 치유)
           · 영역 머리줄 = 꽉 찬 색 아이콘 원 + 제목 + 오른쪽 상태(알약 · D-day 숫자 · ›)
           · 이전(옅은 배경색 영역) 소스는 .bak_before_b1 · 그 전은 .bak_before_nobg
           ══════════════════════════════════════════════════════════════ */
        .tpCard { margin: 0 0 10px; padding: 14px 12px 12px; background: #F4F6F9; border: 1px solid #E2E8F0; border-radius: 12px;
                  font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; color: #374151; text-align: left; }
        .tpTop { padding: 0 6px 12px; }
        .tpHd { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
        .tpK { font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
        .tpMore { flex: none; font-size: 12.5px; font-weight: 800; color: #2F80ED; background: #EAF2FD; border-radius: 999px; padding: 4px 12px; text-decoration: none; white-space: nowrap; }
        .tpMore:hover { background: #DCEAFB; color: #2F80ED; }
        .tpT { margin-top: 6px; font-size: 20px; font-weight: 800; letter-spacing: -.02em; line-height: 1.35; color: #111827; }
        .tpS { margin-top: 3px; font-size: 12.5px; color: #6B7280; }

        /* 영역 카드 */
        .tpArea { display: block; margin: 0 0 10px; padding: 14px 16px; background: #fff; border: 1px solid #E8ECF2; border-radius: 12px; color: inherit; text-decoration: none; transition: border-color .15s; }
        .tpArea:last-child { margin-bottom: 0; }
        a.tpArea:hover { border-color: #C9DCF7; }
        a.tpArea:hover .tpAt { color: #2F80ED; }

        /* 머리줄: 아이콘 원 + 제목 + 오른쪽 상태 */
        .tpAh { display: flex; align-items: center; gap: 10px; }
        .tpIcn { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; }
        .tpAt { flex: 1; min-width: 0; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: 15px; font-weight: 800; color: #111827; transition: color .15s; }
        .tpPill { flex: none; font-size: 11.5px; font-weight: 700; border-radius: 999px; padding: 3px 10px; white-space: nowrap; }
        .tpG { flex: none; font-size: 18px; font-weight: 300; color: #B6C6DD; }
        .tpBig { flex: none; text-align: right; font-size: 20px; font-weight: 800; line-height: 1; color: #5B54C9; font-variant-numeric: tabular-nums; }
        .tpBig.txt { font-size: 14px; }
        .tpBig small { display: block; margin-top: 3px; font-size: 11px; font-weight: 400; color: #6B7280; }

        /* 머리줄 아래 글 */
        .tpAx { display: block; margin-top: 10px; font-size: 13.5px; font-weight: 700; word-break: keep-all; }
        .tpAx.hl { color: #2F80ED; }
        .tpAx.vl { color: #5B54C9; }
        .tpAx.gr { color: #1F9D78; }
        .tpAs { display: block; margin-top: 2px; font-size: 12.5px; color: #6B7280; }

        /* 기도문 공개 알약 (초록 점) · 로그인 안내 */
        .tpOpen { font-style: normal; font-size: 11px; font-weight: 700; color: #1F9D78; background: #fff; box-shadow: inset 0 0 0 1px #BFE5D8; border-radius: 999px; padding: 2px 9px; white-space: nowrap; }
        .tpOpen::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #1F9D78; margin-right: 5px; vertical-align: 1px; }
        .tpLogin { display: flex; align-items: center; gap: 4px; margin-top: 10px; padding-top: 8px; border-top: 1px dashed #BFE5D8; font-size: 12px; font-weight: 700; color: #1F7A5C; }
        .tpLogin em { font-style: normal; font-weight: 500; color: #6B7280; }

        /* 며칠째 — 줄 전체 길이 막대 + 막대 아래 한 줄 */
        .tpDay { display: block; margin-top: 8px; }
        .tpDay i { display: block; height: 6px; border-radius: 99px; background: #E5EDF9; overflow: hidden; }
        .tpDay s { display: block; height: 100%; border-radius: 99px; background: #2F80ED; text-decoration: none; }
        .tpDay em { display: block; margin-top: 4px; font-style: normal; font-size: 11.5px; color: #6B7280; font-variant-numeric: tabular-nums; }
        .tpDay em b { display: inline; font-size: 11.5px; font-weight: 800; color: #2F80ED; }

        /* 관리자 줄 — Basic · SuperAdmin 에게만.  점선 흰 카드 · 줄 전체가 참여자 화면 링크 */
        .tpAdm { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 0 0 10px; padding: 10px 16px; background: #fff; border: 1px dashed #D9DFE8; border-radius: 12px; font-size: 12.5px; color: inherit; text-decoration: none; transition: background .15s; }
        .tpAdm:hover { background: #F7F8FA; }
        .tpAdm .tag { font-style: normal; font-size: 11px; font-weight: 700; color: #B4531F; background: #fff; box-shadow: inset 0 0 0 1px #F3D3BF; border-radius: 999px; padding: 2px 8px; }
        .tpAdm .st { display: flex; gap: 14px; flex: 1; flex-wrap: wrap; color: #6B7280; }
        .tpAdm .st b { margin-left: 4px; font-size: 14px; font-weight: 800; color: #111827; }
        .tpAdm .go { flex: none; margin-left: auto; font-size: 18px; font-weight: 300; color: #B6C6DD; }

        /* 부부 — 아내(분홍) · 남편(파랑) 칸 */
        .tpPair { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }
        .tpPair a { display: flex; align-items: center; justify-content: space-between; gap: 6px; border-radius: 8px; padding: 10px 12px; background: #fff; text-decoration: none; transition: background .15s; }
        .tpPair a span { min-width: 0; }
        .tpPair a b { display: block; font-size: 14px; font-weight: 800; white-space: nowrap; }
        .tpPair a i { display: block; margin-top: 1px; font-style: normal; font-size: 11.5px; font-weight: 600; opacity: .85; white-space: nowrap; }
        .tpPair a u { flex: none; text-decoration: none; font-size: 18px; font-weight: 300; }
        .tpPair a.wf { color: #C2334D; box-shadow: inset 0 0 0 1px #F3C9D2; }
        .tpPair a.wf:hover { background: #FDF2F4; }
        .tpPair a.hu { color: #1F5FBF; box-shadow: inset 0 0 0 1px #C9DCF7; }
        .tpPair a.hu:hover { background: #F4F8FE; }
        @@media (max-width: 360px) { .tpPair a i { display: none; } }

        @@media (max-width: 480px) { .tpCard { padding: 12px 10px 10px; } .tpArea, .tpAdm { padding-left: 14px; padding-right: 14px; } .tpT { font-size: 19px; } }

        /* 누르면 화면 전체를 흐리게 덮지 않고(홈의 "기다려 주세요" 오버레이 제외 = data-no-loading) 누른 곳만 살짝 눌림 + 아래에서 파란 선이 차오른다 */
        .tpCard a { -webkit-tap-highlight-color: transparent; }
        .tpCard a.tpArea, .tpCard .tpPair a, .tpCard a.tpAdm { position: relative; overflow: hidden; }
        .tpCard a.go { border-color: #C9DCF7; opacity: .8; }
        .tpCard a.go:not(.tpMore)::after { content: ""; position: absolute; left: 0; bottom: 0; height: 3px; width: 0; background: #2F80ED; animation: tpGo 1.6s cubic-bezier(.1, .6, .3, 1) forwards; }
        @@keyframes tpGo { to { width: 92%; } }
    </style>

    <div class="tpTop">
        <div class="tpHd">
            <span class="tpK">오늘의 기도</span>
            <a class="tpMore" data-no-loading href="/PrayHome/Index" aria-label="기도홈 — 기도 전체 보기">기도 전체 ›</a>
        </div>
        <div class="tpT">오늘도 함께 기도해요</div>
        <div class="tpS">매일 사랑하는 가족과 수험생을 위해 기도해 주세요</div>
    </div>

    <div class="tpList">
        @* 자녀를 위한 365 — 아이콘 원 + 제목 + "292 / 366일째" 알약, 오늘 기도 제목, 전체 길이 막대 + 날짜 · 남은 일수 *@
        <a class="tpArea" data-no-loading href="/Prayer365?view=user" aria-label="자녀를 위한 365일 축복 기도 — 오늘 기도문">
            <span class="tpAh">
                <span class="tpIcn" style="background:#5B8FD6" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M9 10h.01M15 10h.01" /><path d="M9.5 15a3.5 3.5 0 0 0 5 0" /></svg></span>
                <b class="tpAt">자녀를 위한 365 <em class="tpOpen">기도문 공개</em></b>
                @if (tp365Open && tpDayNo > 0)
                {
                    <span class="tpPill" style="background:#EAF2FD;color:#2F80ED">@tpDayNo / @(tpDayTotal)일째</span>
                }
            </span>
            @if (!string.IsNullOrWhiteSpace(tpTitle))
            {
                <span class="tpAx hl">@tpTitle</span>
            }
            else
            {
                <span class="tpAx hl">오늘 날짜의 축복 기도문</span>
            }
            @if (tp365Open && tpDayNo > 0)
            {
                <span class="tpDay"><i aria-hidden="true"><s style="width:@(tpDayPct)%"></s></i><em>@(tpToday.Month)월 @(tpToday.Day)일 @(tpDow[(int)tpToday.DayOfWeek])요일 · <b>@(tpDayTotal - tpDayNo)일</b> 남음</em></span>
            }
            @if (!tpStaff)
            {
                <span class="tpLogin">오늘의 기도문을 열어 보세요 <em>· 로그인 필요</em></span>
            }
        </a>

        @* 관리자 줄 — Basic · SuperAdmin 에게만.  줄 전체가 참여자 화면 링크 *@
        @if (tpAdm != null)
        {
            <a class="tpAdm" data-no-loading href="/Prayer365/Participants" aria-label="관리자 — 기도 참여자 보기">
                <em class="tag">관리자</em>
                <span class="st"><span>참여자<b>@(tpAdm.Total)명</b></span><span>오늘 기도<b>@(tpAdm.Today)명</b></span></span>
                <span class="go" aria-hidden="true">›</span>
            </a>
        }

        @* 순서: 자녀 365 → (관리자) → 부부 → 수험생 → 치유 *@
        <div class="tpArea">
            <span class="tpAh">
                <span class="tpIcn" style="background:#D96A7C" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></svg></span>
                <b class="tpAt">부부를 위해</b>
                <span class="tpPill" style="background:#FDF2F4;color:#C2334D">서로 축복</span>
            </span>
            <span class="tpPair">
                <a class="wf" data-no-loading href="/BessingACouple/DetailWords?Kind=Wife" aria-label="아내를 위한 기도 — 남편이 드리는 기도"><span><b>아내를 위해</b><i>남편이 드리는 기도</i></span><u>›</u></a>
                <a class="hu" data-no-loading href="/BessingACouple/DetailWords?Kind=Husband" aria-label="남편을 위한 기도 — 아내가 드리는 기도"><span><b>남편을 위해</b><i>아내가 드리는 기도</i></span><u>›</u></a>
            </span>
        </div>

        @* 수험생 — 머리줄 오른쪽에 큰 D-day 숫자 + "수능까지", 설명 두 줄은 아이콘 아래 줄 *@
        <a class="tpArea" data-no-loading href="/EntranceExamPray/Index" aria-label="수험생을 위한 기도">
            <span class="tpAh">
                <span class="tpIcn" style="background:#7C77CF" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9l10-5 10 5-10 5z" /><path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5" /></svg></span>
                <b class="tpAt">수험생을 위해</b>
                <span class="tpBig @(tpDIsText ? "txt" : "")">@tpDLabel<small>@tpDSub</small></span>
            </span>
            <span class="tpAx vl">@tpExamTitle</span>
            <span class="tpAs">@tpSuneungText</span>
        </a>

        @* 치유와 회복을 위해 *@
        <a class="tpArea" data-no-loading href="/HealingAndRestorationPray/Index" aria-label="치유와 회복을 위한 기도">
            <span class="tpAh">
                <span class="tpIcn" style="background:#4BA68A" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></svg></span>
                <b class="tpAt">치유와 회복을 위해</b>
                <span class="tpG" aria-hidden="true">›</span>
            </span>
            <span class="tpAx gr">몸과 마음이 아픈 이를 위해</span>
        </a>
    </div>

    <script>
        // 누른 링크에 .go 를 달아 "넘어가는 중" 을 그 자리에서 보여 준다 (새 탭 · 보조키 클릭은 제외). 뒤로 오면 지운다.
        (function () {
            var card = document.currentScript.closest('.tpCard');
            if (!card) return;
            card.addEventListener('click', function (e) {
                if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                var a = e.target.closest('a[href]');
                if (a && card.contains(a) && a.target !== '_blank') a.classList.add('go');
            });
            window.addEventListener('pageshow', function () {
                card.querySelectorAll('a.go').forEach(function (a) { a.classList.remove('go'); });
            });
        })();
    </script>
</section>
