        .tp365Nums { gap: 1px; background: #DCE8F9; border: 1px solid #DCE8F9; }
        .tp365Cta { box-shadow: none; border: 1px solid #C9DCF7; }
        .tpArea .tpLab { display: flex; align-items: center; gap: 6px; flex: 1 1 100%; margin-bottom: 8px; font-size: 10.5px; font-weight: 800; letter-spacing: .04em; }
        .tpArea .tpLab i { display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #fff; font-style: normal; font-size: 10px; }
        .tpArea.a1 { background: #F4F8FE; border-color: #DCE8F9; }  .tpArea.a1 .tpLab { color: #5B8FD6; }
        .tpArea.a2 { background: #F6F5FD; border-color: #E3E1F6; }  .tpArea.a2 .tpLab { color: #7C77CF; }
        .tpArea.a3 { background: #FEF6F7; border-color: #F6E1E5; }  .tpArea.a3 .tpLab { color: #C4707F; }
        .tpArea.a4 { background: #F3FAF7; border-color: #D8EFE6; }  .tpArea.a4 .tpLab { color: #4BA68A; }
