        .tpPair a.wf { background: #fff; }
        .tpPair a.hu { background: #fff; }
        .tpArea .tpPair a.wf:hover, .tpArea .tpPair a.hu:hover { background: #F4F6F9; }
        /* 관리자 줄 — Basic · SuperAdmin 에게만.  카드 끝까지 꽉 찬 띠 · 줄 전체가 참여자 화면 링크 (2026-10-17) */
