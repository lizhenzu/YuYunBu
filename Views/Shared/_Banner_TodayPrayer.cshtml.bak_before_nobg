        .tpChip.cal small { padding: 3px 0; font-size: 10px; letter-spacing: 0; font-variant-numeric: tabular-nums; }
        .tpChip.cal strong { padding: 2px 0 0; font-size: 24px; line-height: 1.15; }
        .tpChip.cal em { display: block; padding: 0 0 5px; font-style: normal; font-size: 10.5px; font-weight: 800; color: #111827; letter-spacing: 0; }
        /* 요일 색 — 평일 검정 · 토요일 파랑 · 일요일 빨강 (2026-10-11) */
        .tpChip.cal em.sat { color: #2F80ED; }
        .tpChip.cal em.sun { color: #E03131; }

        /* 며칠째 — 가는 진행 막대 + 285일째 · 366일 중 */
        .tpTx .tpDay { display: flex; align-items: center; gap: 8px; margin-top: 7px; overflow: visible; white-space: normal; }
        .tpDay i { display: block; flex: 1; height: 5px; border-radius: 99px; background: #E5EDF9; overflow: hidden; }
        .tpDay s { display: block; height: 100%; border-radius: 99px; background: #2F80ED; text-decoration: none; }
        .tpDay em { font-style: normal; font-size: 11.5px; font-weight: 700; color: #6B7280; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .tpDay em b { font-weight: 800; color: #2F80ED; }

        /* 기도문 공개 알약 (초록 점) + 로그인 안내 한 줄 (2026-10-11) */
        .tpTx b.tpNm { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .tpOpen { font-style: normal; font-size: 11px; font-weight: 700; color: #1F9D78; background: #E8F6F1; border-radius: 999px; padding: 2px 9px; white-space: nowrap; }
        .tpOpen::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #1F9D78; margin-right: 5px; vertical-align: 1px; }
        .tpTx .tpLogin { display: flex; align-items: center; gap: 4px; margin-top: 10px; padding-top: 8px; border-top: 1px dashed #BFE5D8; font-size: 12px; font-weight: 700; color: #1F7A5C; white-space: normal; }
        .tpLogin em { font-style: normal; font-weight: 500; color: #6B7280; }

        /* 자녀를 위한 365 — 오늘의 기도 상자 + 이번 주 기도 도장 + 숫자 세 칸 + 버튼 (2026-10-17 B+C 시안) */
        .tpRow.tp365 { display: block; padding: 14px 0 16px; }
        .tp365 > span { display: block; }
        .tp365Hd { display: flex !important; justify-content: space-between; align-items: center; gap: 8px; }
        .tp365Hd .tpNm { font-size: 16px; font-weight: 800; color: #111827; }
        .tp365Dt { flex: none; font-size: 11.5px; color: #6B7280; white-space: nowrap; }
        .tp365Q { margin-top: 10px; padding: 12px 14px; border-radius: 12px; background: #EAF2FD; color: #1F3B66; font-size: 15px; font-weight: 800; line-height: 1.5; word-break: keep-all; }
        .tp365Q small { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 3px; font-size: 11px; font-weight: 400; color: #4B6FA8; }
        .tp365Q small i { font-style: normal; }
        .tp365Q .bar { height: 4px; margin-top: 9px; border-radius: 99px; background: #fff; overflow: hidden; }
        .tp365Q .bar s { display: block; height: 100%; border-radius: 99px; background: #2F80ED; text-decoration: none; }
        .tp365Wkh { display: flex !important; justify-content: space-between; align-items: baseline; margin-top: 14px; font-size: 12px; color: #6B7280; }
        .tp365Wkh i { font-style: normal; }
        .tp365Wkh b { display: inline; font-size: 12px; font-weight: 800; color: #111827; }
        .tp365Wk { display: grid !important; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; margin-top: 6px; }
        .tp365Wk .wd { text-align: center; font-size: 10.5px; color: #9CA3AF; }
        .tp365Wk .wd.sun { color: #E03131; }
        .tp365Wk .wd.sat { color: #2F80ED; }
        .tp365Wk u { display: grid; place-items: center; margin: 3px auto 0; width: 30px; height: 30px; border-radius: 50%; background: #F4F6F9; color: #9CA3AF; font-size: 11px; text-decoration: none; }
        .tp365Wk u.on { background: #2F80ED; color: #fff; }
        .tp365Wk u.td { box-shadow: 0 0 0 2px #9DC1F5; background: #fff; color: #2F80ED; font-weight: 800; }
        .tp365Wk u.on.td { background: #2F80ED; color: #fff; }
        .tp365Wk u.fut { background: transparent; border: 1px dashed #E2E8F0; }
        .tp365Nums { display: grid !important; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; margin-top: 12px; }
        .tp365Nums > span { display: block; padding: 8px 4px; border-radius: 10px; background: #F4F6F9; text-align: center; font-size: 11px; color: #6B7280; }
        .tp365Nums b { display: block; font-size: 16px; font-weight: 800; color: #111827; }
        .tp365Nums .hl b { color: #2F80ED; }
        .tp365Nums .gr b { color: #1F9D78; }
        .tp365Msg { margin-top: 12px; padding: 10px 12px; border-radius: 12px; background: #F4F6F9; text-align: center; font-size: 12px; color: #6B7280; }
        .tp365Msg b { display: block; margin-bottom: 2px; font-size: 13.5px; font-weight: 800; color: #111827; }
        .tp365Cta { margin-top: 12px; padding: 11px; border-radius: 999px; background: #2F80ED; color: #fff; text-align: center; font-size: 13.5px; font-weight: 800; transition: background .15s; }
        a.tp365:hover .tp365Cta { background: #1F6FDB; }
        a.tp365:hover .tpNm { color: #2F80ED; }
        .tp365 .tpLogin { margin-top: 10px; padding-top: 0; border-top: 0; justify-content: center; }

        /* ── 네 구역을 나눈다 — 2026-10-17 C안: 구역마다 아주 옅은 배경색 + 번호 라벨 ──
           색은 연하게(흰 바탕에 거의 묻어나는 정도) 해서 한 구역이 다른 구역을 가리지 않게 한다 */
        /* 2026-10-17: 좌우 여백 없이 카드 끝까지 꽉 채우고 모서리는 각지게 (바깥 카드만 8px 둥근 모서리 · overflow:hidden 으로 안쪽을 잘라 준다) */
