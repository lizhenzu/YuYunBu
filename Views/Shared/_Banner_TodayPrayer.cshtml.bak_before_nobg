        .tpPair { flex: 1 1 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .tpPair a { display: flex; align-items: center; justify-content: space-between; gap: 6px; border-radius: 10px; padding: 11px 13px; text-decoration: none; transition: background .15s; }
