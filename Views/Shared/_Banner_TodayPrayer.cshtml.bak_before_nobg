        .tpArea .tpChip, .tpArea .tpIc { background: #fff; }
        .tp365Q { background: #fff; color: #1F3B66; }
        .tp365Q small { color: #6B86AE; }
        .tp365Q .bar { background: #E5EDF9; }
        .tp365Wk u { background: #fff; }
        .tp365Wk u.on { background: #6FA2EC; color: #fff; }
        .tp365Wk u.td { box-shadow: 0 0 0 2px #C9DCF7; }
        .tp365Wk u.on.td { background: #6FA2EC; }
        .tp365Nums > span { background: #fff; }
        .tp365Nums b { font-weight: 800; color: #374151; }
        .tp365Nums .hl b { color: #5B8FD6; }
        .tp365Nums .gr b { color: #4BA68A; }
        .tp365Msg { background: #fff; }
        .tp365Cta { background: #fff; color: #2F80ED; box-shadow: inset 0 0 0 1px #C9DCF7; }
        a.tp365:hover .tp365Cta { background: #EAF2FD; }
        /* 첫 기도 — 안내 문구 + 버튼 글자를 한 박스 안에 위아래로 */
