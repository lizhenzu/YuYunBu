        .tpTop { padding: 18px 18px 14px; }
        .tpList { margin-top: 0; }
        .tpRow.tpArea { flex-wrap: wrap; margin: 0; padding: 14px 18px 16px; border: 0; border-top: 1px solid; border-radius: 0; }
        .tpRow.tpArea:last-child { padding-bottom: 16px; }
