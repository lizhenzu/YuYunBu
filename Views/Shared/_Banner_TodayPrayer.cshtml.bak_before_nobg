        .tpPair a b { display: block; font-size: 14px; font-weight: 800; white-space: nowrap; }
        .tpPair a i { display: block; margin-top: 1px; font-style: normal; font-size: 11.5px; font-weight: 600; opacity: .8; white-space: nowrap; }
        .tpPair a u { flex: none; text-decoration: none; font-size: 18px; font-weight: 300; }
        .tpPair a.wf { background: #FDF2F4; color: #C2334D; }
        .tpPair a.wf:hover { background: #FBE4E9; }
        .tpPair a.hu { background: #EAF2FD; color: #1F5FBF; }
        .tpPair a.hu:hover { background: #DCEAFB; }
