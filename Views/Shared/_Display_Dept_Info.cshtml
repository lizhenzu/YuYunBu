@model UserInfo
@*  현재 부서 정보 표 — 2026-10-04 밝은 테마 (quiz-bright.css 의 dp-cur).  이전 파일은 _Display_Dept_Info.cshtml.bak_before_bright *@
@{
    string YearBan = $"{Model.ClassYear}학년 {Model.ClassBan}반";
}
<div class="dp-cur">
    <div><span>부서</span><b>@Model.DeptNM</b></div>
    @if (Model.ClassYear > 0 && Model.RoleCode == "T1002") // 교사
    {
        <div><span>역할</span><b>@Model.RoleNM</b></div>
        <div><span>학년·반</span><b>@YearBan</b></div>
    }
    else if (Model.ClassYear > 0 && Model.RoleCode == "T1001")  // 학생
    {
        <div><span>학년·반</span><b>@YearBan</b></div>
    }
    else
    {
        <div><span>역할</span><b>@Model.RoleNM</b></div>
    }
</div>
