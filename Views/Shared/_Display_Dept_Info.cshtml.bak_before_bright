@model UserInfo
@{
    string YearBan = $"{@Model.ClassYear}학년{@Model.ClassBan}반";
    <h4>현재 부서정보</h4>
    <p>부서명 : @Model.DeptNM </p>
    if (@Model.ClassYear > 0 && Model.RoleCode == "T1002") // 교사
    {
       <p>역할 : @Model.RoleNM </p>
       <p>학년반 : @YearBan</p>
    }
    else if (@Model.ClassYear > 0 && Model.RoleCode == "T1001")  // 학생
    {
       <p>학년반 : @YearBan</p>
    }
    else
    {
       <p>역할 : @Model.RoleNM </p>
    }
}