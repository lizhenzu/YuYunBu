@model BulletinBoard.Models.PraiseContent

 
<div class="form-group">
    <label>각 절을 아래 각각 입력란에 분리해서 입력하세요.</label>
</div>
 

<div class="form-group">
    <label asp-for="contentsText"></label>
    <input type="text" asp-for="contentsText" class="Reciteonly-field" style="width: 100%;" />
    <span asp-validation-for="contentsText" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Singer"></label>
    <input type="text" asp-for="Singer" class="Reciteonly-field" style="width: 100%;" />
    <span asp-validation-for="Singer" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="contentsURL"></label>
    <input type="text" asp-for="contentsURL" class="Reciteonly-field" style="width: 100%;" />
    <span asp-validation-for="contentsURL" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Kind"></label>
    <input type="text" asp-for="Kind" class="Reciteonly-field" value="@ViewBag.Kind" style="width: 100%;" />
    <span asp-validation-for="Kind" class="text-danger"></span>
</div>