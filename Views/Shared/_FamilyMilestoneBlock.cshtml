@using BulletinBoard.Common
@using BulletinBoard.Enums
@using BulletinBoard.Services.Abstract
@using Microsoft.EntityFrameworkCore
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject BibleReadingThrough.Data.AppDbContext GiftDb

@{
    var user        = await AuthService.GetSignedUser(User);
    var isSignedIn  = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin     = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    bool isStaff    = isAdmin || isSuperAdmin;

    // 선물 관리 화면을 열 수 있는 사람 — Admin · SuperAdmin 역할, 예외로 "Basic" 계정
    bool canManageGifts = isStaff
                          || string.Equals(User.Identity?.Name, "Basic", StringComparison.OrdinalIgnoreCase);

    var familyMilestones = ViewBag.FamilyMilestones
        as List<FamilyMilestoneDisplayVM>
        ?? new List<FamilyMilestoneDisplayVM>();

    var milestoneConfigs = ViewBag.FamilyMilestoneConfigs
        as List<FamilyMilestoneConfigVM>
        ?? new List<FamilyMilestoneConfigVM>();

    // 선물 상세(설명 · 구매 링크) — 팝업에서 쓴다. 표가 없거나 오류면 빈 값으로 둔다.
    var giftInfo = new Dictionary<int, (string Desc, string Url)>();
    try
    {
        var giftIds = familyMilestones.Where(x => x.ProductId.HasValue)
                                      .Select(x => x.ProductId!.Value).Distinct().ToList();
        if (giftIds.Count > 0)
        {
            var allItems = GiftDb.AwardItems.AsNoTracking().ToList();
            foreach (var it in allItems.Where(a => giftIds.Contains(a.ProductID)))
            {
                giftInfo[it.ProductID] = (it.ProductDescription ?? "", it.ExternalUrl ?? "");
            }
        }
    }
    catch { }

    var myUserNameForMilestone = (ViewBag.MyUserName as string) ?? "";

    // 가족 미니트리 헬퍼
    string MftAvCls(string rel) => rel switch
    {
        "엄마" => "mft-av-mom", "아빠" => "mft-av-dad",
        "할머니" or "할아버지" => "mft-av-grand",
        "본인" => "mft-av-self",
        "형" or "동생" or "언니" or "누나" or "오빠" => "mft-av-sib",
        _ => "mft-av-other"
    };
    // rel로 성별이 확정되는 경우 우선, 그 외엔 sex("M"/"F") 기준
    string MftEmoji(string rel, string sex = "")
    {
        return rel switch
        {
            "엄마"     => "👩",
            "아빠"     => "👨",
            "할머니"   => "👵",
            "할아버지" => "👴",
            "언니"     => "👧",
            "누나"     => "👧",
            "형"       => "👦",
            "오빠"     => "👦",
            // 성별 불명 관계는 sex 필드로 판단
            _ => sex?.ToUpper() == "F" ? "👧"
               : sex?.ToUpper() == "M" ? "👦"
               : "🧒"
        };
    }
    bool MftIsParent(string? rel) => rel == "엄마" || rel == "아빠" || rel == "할머니" || rel == "할아버지";
    string MftDefaultPhoto = "/images/icon/people/people_01.webp";
    bool MftHasPhoto(string? photo) => !string.IsNullOrWhiteSpace(photo) && !photo.Contains("people_01.webp");
    string MftRoleCls(string rel) => rel switch
    {
        "엄마" => "mft-role-mom", "아빠" => "mft-role-dad",
        "본인" => "mft-role-self",
        _ => "mft-role-etc"
    };

    // 이름 마스킹: 부모/조부모는 항상 끝자 *, 나머지는 비로그인 시만 끝자 *
    string MaskName(string? name, string? rel)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        bool isParentRel = MftIsParent(rel ?? "");
        bool shouldMask  = isParentRel || !isSignedIn;
        if (!shouldMask) return name;
        return name.Length <= 1 ? "*" : name.Substring(0, name.Length - 1) + "*";
    }
}

@* 이미지 로딩 중 화면 전환 차단 방지: 링크 클릭 시 미완료 이미지 src 즉시 해제 *@
<script>
(function () {
    function abortPendingImages() {
        document.querySelectorAll('img').forEach(function (img) {
            if (!img.complete) { img.src = ''; }
        });
    }
    function isNavLink(el) {
        var a = el.closest('a[href]');
        if (!a) return false;
        var href = a.getAttribute('href') || '';
        return href && href.charAt(0) !== '#' && href.indexOf('javascript') !== 0;
    }
    // 모바일: touchstart에서 즉시 처리 (300ms 딜레이 전에)
    document.addEventListener('touchstart', function (e) {
        if (isNavLink(e.target)) abortPendingImages();
    }, { passive: true, capture: true });
    // 데스크탑: click에서 처리
    document.addEventListener('click', function (e) {
        if (isNavLink(e.target)) abortPendingImages();
    }, true);
})();
</script>


@*  ══════════════════════════════════════════════════════════════
    가족 마일스톤 — 한 가족 = 한 카드.  상단 타임라인(1,000 → 2,000 → 3,000 → 4,000 …)에
    단계마다 상태(전달완료 · 구매완료 · 신청중 · 고르기 · 박수 · 미도달)를 보여 주고,
    가족 구성(가계도)은 「가족팀 보기」 를 눌러야 팝업으로 나온다.
    ══════════════════════════════════════════════════════════════ *@
@{
    // 단계 목록 (설정 표 순서).  설정이 비어 있으면 실제 달성 행에서 뽑는다.
    var steps = milestoneConfigs.OrderBy(c => c.PointThreshold)
                                .Select(c => (Threshold: c.PointThreshold, Type: (c.MilestoneType ?? "AWARD").ToUpperInvariant(), Emoji: c.DisplayEmoji ?? ""))
                                .ToList();
    if (steps.Count == 0)
        steps = familyMilestones.GroupBy(r => r.PointThreshold).OrderBy(g => g.Key)
                                .Select(g => (Threshold: g.Key, Type: (g.First().MilestoneType ?? "AWARD").ToUpperInvariant(), Emoji: g.First().DisplayEmoji ?? ""))
                                .ToList();

    // 팀별로 묶는다 (합산 높은 팀부터).
    // 지금 받을 선물이 있는 팀만 — 도달한 '시상' 단계 중 아직 전달(HIDDEN)되지 않은 것이 하나라도 있어야 한다.
    var teams = familyMilestones.GroupBy(r => r.FamilyTeamId)
                                .Select(g => new { First = g.OrderBy(x => x.PointThreshold).First(), Rows = g.ToDictionary(x => x.PointThreshold, x => x) })
                                .Where(t => t.Rows.Values.Any(r => string.Equals(r.MilestoneType, "AWARD", StringComparison.OrdinalIgnoreCase)
                                                                   && !string.Equals(r.GiftStatus, "HIDDEN", StringComparison.OrdinalIgnoreCase)))
                                .OrderByDescending(t => t.First.TeamTotalDm2).ThenBy(t => t.First.TeamName)
                                .ToList();
}

@if (teams.Count > 0 && steps.Count > 0)
{
