<div style="margin-top:10px; margin-bottom:10px;">
@foreach (var t in teams)
{
    var f = t.First;
    int total = f.TeamTotalDm2;
    // 도달한 단계만 보여 준다 (앞으로 받을 상 · 남은 점수는 보여 주지 않는다)
    var mySteps = steps.Where(s => s.Threshold <= total).ToList();
    if (mySteps.Count == 0) { continue; }
    int reachedCount = mySteps.Count;
    // 채워진 선 : 첫 점부터 마지막 점까지 (점 사이 간격 = (100 - 2*edge) / (n-1))
    double edge = 100.0 / (mySteps.Count * 2);
    double fillPct = mySteps.Count <= 1 ? 0 : (reachedCount - 1) * (100.0 - 2 * edge) / (mySteps.Count - 1);
    double vfill = mySteps.Count <= 1 ? 0 : 100;
    bool isRecipientMe = isSignedIn && string.Equals(myUserNameForMilestone, f.RecipientUserName, StringComparison.OrdinalIgnoreCase);
    bool isMember = f.MemberUserNames.Contains(myUserNameForMilestone);
    string popId = "fmPop-" + f.FamilyTeamId;
    var mParents = f.Members.Where(m => MftIsParent(m.RelationLabel)).ToList();
    var mKids    = f.Members.Where(m => !MftIsParent(m.RelationLabel)).ToList();

    <div class="fmT" id="fmT-@f.FamilyTeamId">
        @* 머리 : 1줄 = 작은 링크(키커), 2줄 = 제목 + 버튼 — 모바일에서도 안 밀린다 *@
        <div class="fmTKick">🏆 <a class="fmTLink" href="/DailyMission2/Welcome" title="@ConstatsCommon.MainKeyTitle 으로 가기">@ConstatsCommon.MainKeyTitle <span class="ar">→</span></a></div>
        <div class="fmTHd">
            <div class="t">가족팀 마일스톤 도달 축하해요!</div>
            <span class="fmTBtns">
                @* 휴대폰에서만 — 축소판 ↔ 지금 모습 (2026-09-27) *@
                <button type="button" class="fmTMore" aria-expanded="false"
                        onclick="var c=document.getElementById('fmT-@f.FamilyTeamId'),o=c.classList.toggle('open');this.textContent=o?'접기 ▴':'상세히 ▾';this.classList.toggle('on',o);this.setAttribute('aria-expanded',o);">상세히 ▾</button>
                <button type="button" class="fmTBtn" data-pop="@popId">👨‍👩‍👧 가족팀 보기</button>
            </span>
        </div>

        <div class="fmTTeam">
            <div class="fmTAv">@if (MftHasPhoto(f.RecipientPhoto)) { <img src="@f.RecipientPhoto" alt="" loading="lazy" onerror="this.remove()" /> } else { <text>🧑</text> }</div>
            <div>
                <div class="n">@f.TeamName<small>선물 수령자 @MaskName(f.RecipientFullName, "본인")</small></div>
                <div class="s">합산 <b>@(total.ToString("N0"))점</b></div>
            </div>
        </div>

        @* 휴대폰 축소판 (2026-09-27) — 단계를 한 줄 칸으로.  "상세히"를 누르면 아래 타임라인 *@
        <div class="fmC" style="grid-template-columns: repeat(@(Math.Min(mySteps.Count, 4)), 1fr);">
            @foreach (var cs in mySteps)
            {
                t.Rows.TryGetValue(cs.Threshold, out var crow);
                bool cAward = cs.Type == "AWARD";
                <div class="fmCs @(cAward ? "" : "clap")">
                    <div class="p">@(cs.Threshold.ToString("N0"))</div>
                    @if (!cAward)
                    {
                        <div class="e">👏</div><div class="n">박수</div>
                    }
                    else if (crow != null && crow.ProductId.HasValue)
                    {
                        string cCls = crow.GiftStatus switch { "HIDDEN" => "done", "PURCHASED" => "buy", _ => "pick" };
                        string cTxt = crow.GiftStatus switch { "HIDDEN" => "전달완료", "PURCHASED" => "구매완료", _ => "신청중" };
                        <div class="im"><img src="/images/AwardItem/@(crow.ProductId).jpg" alt="" loading="lazy" onerror="this.parentNode.classList.add('noimg');this.remove();" /></div>
                        <div class="n">@crow.ProductName</div>
                        <span class="st @cCls">@cTxt</span>
                    }
                    else
                    {
                        <div class="e">🎁</div><div class="n">고르기 전</div>
                    }
                </div>
            }
        </div>

        <div class="fmTL" style="grid-template-columns: repeat(@mySteps.Count, 1fr); --edge: @(edge.ToString("0.##"))%; --hfill: @(fillPct.ToString("0.##"))%; --vfill: @(vfill.ToString("0.#"))%;">
            <div class="fill"></div>
            @for (int si = 0; si < mySteps.Count; si++)
            {
                var s = mySteps[si];
                bool isLastReached = si == reachedCount - 1;
                t.Rows.TryGetValue(s.Threshold, out var row);
                bool isAward = s.Type == "AWARD";
                string ndCls = (isLastReached && (row == null || string.IsNullOrWhiteSpace(row.GiftStatus)) && isAward) ? "now" : "done";

                <div class="fmN @ndCls">
                    <div class="hdr">
                        <div class="pt">@(s.Threshold.ToString("N0"))점</div>
                        <div class="kind">@(isAward ? "시상" : "박수")</div>
                    </div>
                    @if (!isAward)
                    {
                        <div class="fmB clap"><div class="em">👏</div><div class="gn">박수 시상</div></div>
                    }
                    else if (row != null && row.ProductId.HasValue)
                    {
                        string gDesc = "", gUrl = "";
                        if (giftInfo.ContainsKey(row.ProductId.Value)) { gDesc = giftInfo[row.ProductId.Value].Desc; gUrl = giftInfo[row.ProductId.Value].Url; }
                        var gBuy = string.IsNullOrWhiteSpace(gUrl) ? "https://www.coupang.com/np/search?q=" + Uri.EscapeDataString(row.ProductName ?? "") : gUrl;
                        string stCls = row.GiftStatus switch { "HIDDEN" => "done", "PURCHASED" => "buy", _ => "pick" };
                        // 상태 문구는 홈 선물 카드 모두 같게 — 신청중 · 구매완료 · 전달완료 (2026-09-27 통일)
                        string stTxt = row.GiftStatus switch { "HIDDEN" => "전달완료", "PURCHASED" => "구매완료", _ => "신청중" };
                        @if (canManageGifts)
                        {
                            @* 관리자만 — 선물 칸을 누르면 통합 선물 관리로 (사진 크게 보기는 그 화면에서) *@
                            <a class="fmB gift lnk" href="/StudentPointDashboard4/AdminPurchaseList" title="관리자 — 통합 선물 관리로">
                                <img src="/images/AwardItem/@(row.ProductId).jpg" alt="@row.ProductName" loading="lazy" decoding="async"
                                     onerror="this.onerror=null;this.src='/images/common/no-image.png';" />
                                <div><div class="gn">@row.ProductName</div><span class="st @stCls">@stTxt</span></div>
                            </a>
                        }
                        else
                        {
                            <div class="fmB gift">
                                <img src="/images/AwardItem/@(row.ProductId).jpg" alt="@row.ProductName" class="fmGiftImg" loading="lazy" decoding="async"
                                     data-gname="@row.ProductName" data-gdesc="@gDesc" data-gbuy="@gBuy"
                                     onerror="this.onerror=null;this.src='/images/common/no-image.png';" />
                                <div><div class="gn">@row.ProductName</div><span class="st @stCls">@stTxt</span></div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="fmB todo">
                            <div class="gn">아직 안 골랐어요</div>
                            @if (isRecipientMe)
                            {
                                <a class="go" href="/StudentPointDashboard4/GiftSelect?type=family&threshold=@s.Threshold">🎁 선물 고르기</a>
                            }
                            else
                            {
                                <div class="who">@MaskName(f.RecipientFullName, "본인")님이 골라요</div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="fmTFoot">
            <span>선물은 <b>@MaskName(f.RecipientFullName, "본인")</b>님께 지급돼요</span>
            <span>박수 단계는 선물 대신 예배 시간에 박수로 축하해요</span>
        </div>
    </div>

    @* 가족팀 팝업 — 기존 가계도 그대로 *@
    <div class="fmPop" id="@popId" data-popmask>
        <div class="fmPopBox" onclick="event.stopPropagation()">
            <div class="fmPopHd"><b>👨‍👩‍👧 @f.TeamName</b><button type="button" class="fmPopX" data-popclose>닫기 ✕</button></div>
            <div class="fmMileTree">
                @if (mParents.Any())
                {
                    <div class="fmMileTreeRow">
                        @for (int pi = 0; pi < mParents.Count; pi++)
                        {
                            var mn = mParents[pi]; var rl = mn.RelationLabel ?? "";
                            <div class="fmMileTreeNode">
                                <div class="fmMileTreeAv @MftAvCls(rl)">@MftEmoji(rl, mn.Sex)</div>
                                <div class="fmMileTreeNm">@MaskName(mn.FullName, rl)</div>
                                <span class="fmMileTreeRole @MftAvCls(rl)">@rl</span>
                                <div class="fmMileTreePt">@(mn.YearPoint.ToString("N0"))점</div>
                            </div>
                            @if (pi < mParents.Count - 1) { <div class="fmMileTreeHline"></div> }
                        }
                    </div>
                }
                @if (mParents.Any() && mKids.Any()) { <div class="fmMileTreeVline"></div> }
                @if (mKids.Any())
                {
                    <div class="fmMileTreeRow">
                        @foreach (var mn in mKids)
                        {
                            var rl = mn.RelationLabel ?? "";
                            <div class="fmMileTreeNode">
                                <div class="fmMileTreeAv @MftAvCls(rl)">@MftEmoji(rl, mn.Sex)</div>
                                <div class="fmMileTreeNm">@MaskName(mn.FullName, rl)</div>
                                <span class="fmMileTreeRole @MftAvCls(rl)">@rl</span>
                                <div class="fmMileTreePt">@(mn.YearPoint.ToString("N0"))점</div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="fmPopSum">@(f.Members.Count)명 합산 <b>@(total.ToString("N0"))점</b> · 선물은 <b>@MaskName(f.RecipientFullName, "본인")</b>님께</div>
        </div>
    </div>
}
</div>

<script>
    function fmGiftClose(e) { if (e) e.stopPropagation(); document.getElementById('fmGiftModal').classList.remove('on'); }
    (function () {
        function bind() {
            // 선물 사진 크게
            document.querySelectorAll('.fmGiftImg').forEach(function (img) {
                img.addEventListener('click', function (e) {
                    e.preventDefault(); e.stopPropagation();
                    document.getElementById('fmGiftImg2').src = img.getAttribute('src');
                    document.getElementById('fmGiftName2').textContent = img.getAttribute('data-gname') || '';
                    document.getElementById('fmGiftDesc2').textContent = img.getAttribute('data-gdesc') || '';
                    var buy = document.getElementById('fmGiftBuy');
                    if (buy) buy.href = img.getAttribute('data-gbuy') || '#';
                    document.getElementById('fmGiftModal').classList.add('on');
                });
            });
            // 가족팀 팝업
            document.querySelectorAll('[data-pop]').forEach(function (b) {
                b.addEventListener('click', function () {
                    var p = document.getElementById(b.getAttribute('data-pop'));
                    if (p) { p.classList.add('on'); document.body.style.overflow = 'hidden'; }
                });
            });
            function closeAll() { document.querySelectorAll('.fmPop.on').forEach(function (p) { p.classList.remove('on'); }); document.body.style.overflow = ''; }
            document.querySelectorAll('[data-popclose]').forEach(function (b) { b.addEventListener('click', closeAll); });
            document.querySelectorAll('[data-popmask]').forEach(function (m) { m.addEventListener('click', function (e) { if (e.target === m) closeAll(); }); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { fmGiftClose(); closeAll(); } });
        }
        if (document.readyState !== 'loading') bind();
        else document.addEventListener('DOMContentLoaded', bind);
    })();
</script>
}
