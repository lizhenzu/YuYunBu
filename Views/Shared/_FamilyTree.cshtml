@using BulletinBoard.Services.Abstract
@{
    var _ftree = ViewBag.FamilyTree as FamilyTreeVM;
}
@if (_ftree != null && _ftree.Members.Count > 0)
{
    var _me       = _ftree.Members.FirstOrDefault(m => m.IsMe);
    int _myRole   = _me?.RoleCode ?? 9;
    var _parents  = _ftree.Members.Where(m => m.RoleCode >= 1 && m.RoleCode <= 4).OrderBy(m => m.RoleCode).ToList();
    var _students = _ftree.Members.Where(m => m.RoleCode == 0).OrderBy(m => m.RelationCode).ToList();
    bool _meIsStudent = _myRole == 0;

    <style>
        .ftree-card {
            background: #fff;
            border: 1px solid #E2E8F0;
            border-radius: 20px;
            padding: 16px 14px 14px;
            margin: 0 0 14px;
            box-shadow: 0 2px 10px rgba(15,23,42,.07);
        }
        .ftree-title {
            font-size: 13px; font-weight: 800; color: #1E293B;
            display: flex; align-items: center; gap: 6px; margin-bottom: 14px;
        }
        .ftree-team-badge {
            font-size: 10px; font-weight: 700;
            background: #EFF6FF; color: #3B82F6; border: 1px solid #BFDBFE;
            border-radius: 12px; padding: 2px 9px;
        }
        .ftree-row { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
        .ftree-connector-row {
            display: flex; justify-content: center; align-items: center;
            height: 28px; position: relative; margin: 0 auto;
        }
        .ftree-vline { width: 2px; background: #CBD5E1; height: 28px; margin: 0 auto; }
        .ftree-hline { height: 2px; background: #CBD5E1; flex: 1; }
        .ftree-member {
            display: flex; flex-direction: column; align-items: center; gap: 4px;
            min-width: 64px; max-width: 80px;
        }
        .ftree-avatar-wrap { position: relative; width: 52px; height: 52px; }
        .ftree-avatar {
            width: 52px; height: 52px; border-radius: 50%;
            object-fit: cover; border: 2.5px solid #E2E8F0;
        }
        .ftree-me .ftree-avatar { border-color: #10B981; box-shadow: 0 0 0 3px rgba(16,185,129,.2); }
        .ftree-role-badge {
            position: absolute; bottom: -2px; left: 50%; transform: translateX(-50%);
            font-size: 9px; font-weight: 800; border-radius: 8px;
            padding: 1px 5px; white-space: nowrap; border: 1px solid;
        }
        .badge-me     { background: #D1FAE5; color: #065F46; border-color: #6EE7B7; }
        .badge-parent { background: #DBEAFE; color: #1E40AF; border-color: #93C5FD; }
        .badge-child  { background: #FEF3C7; color: #92400E; border-color: #FCD34D; }
        .badge-other  { background: #F1F5F9; color: #475569; border-color: #CBD5E1; }
        .ftree-name { font-size: 11px; font-weight: 700; color: #1E293B; text-align: center; line-height: 1.2; }
        .ftree-pts  { font-size: 10px; font-weight: 700; color: #F59E0B; background: #FEF3C7; border-radius: 8px; padding: 1px 6px; }
        .ftree-date { font-size: 9px; color: #94A3B8; text-align: center; }
    </style>

    <div class="ftree-card">
        <div class="ftree-title">
            🌳 우리 가족
            <span class="ftree-team-badge">@_ftree.TeamName</span>
            <span style="margin-left:auto;font-size:12px;font-weight:700;color:#92400E;background:#FEF3C7;border-radius:8px;padding:2px 8px;">
                합산 @(_ftree.Members.Sum(m => m.YearPoint).ToString("N0"))점
            </span>
        </div>

        @* 부모/조부모 행 *@
        @if (_parents.Count > 0)
        {
            <div class="ftree-row">
                @foreach (var _pm in _parents)
                {
                    string _pbadgeCls = _pm.IsMe ? "badge-me" : "badge-parent";
                    string _pcard     = _pm.IsMe ? "ftree-me" : "";
                    string _pdate     = _pm.LastActionDate.HasValue ? _pm.LastActionDate.Value.ToString("yyyy-MM-dd") : "-";
                    <div class="ftree-member @_pcard">
                        <div class="ftree-avatar-wrap">
                            <img class="ftree-avatar"
                                 src="@(string.IsNullOrWhiteSpace(_pm.Photo) ? "/images/icon/people/people_01.webp" : _pm.Photo)"
                                 alt="@_pm.FullName"
                                 onerror="this.src='/images/icon/people/people_01.webp'"/>
                            <span class="ftree-role-badge @_pbadgeCls">@_pm.RelLabel</span>
                        </div>
                        <div class="ftree-name">@_pm.FullName</div>
                        <div class="ftree-pts">@_pm.YearPoint.ToString("N0")점</div>
                        <div class="ftree-date">@_pdate</div>
                    </div>
                }
            </div>
            @if (_students.Count > 0)
            {
                <div class="ftree-connector-row" style="width:@(_students.Count <= 1 ? "2px" : "60%");">
                    @if (_students.Count <= 1)
                    {
                        <div class="ftree-vline"></div>
                    }
                    else
                    {
                        <div class="ftree-vline" style="height:14px;align-self:flex-start;"></div>
                        <div class="ftree-hline"></div>
                        <div class="ftree-vline" style="height:14px;align-self:flex-start;"></div>
                    }
                </div>
            }
        }

        @* 학생(자녀) 행 *@
        @if (_students.Count > 0)
        {
            <div class="ftree-row">
                @foreach (var _sm in _students)
                {
                    string _sbadgeCls = _sm.IsMe ? "badge-me" : "badge-child";
                    string _scard     = _sm.IsMe ? "ftree-me" : "";
                    string _sdate     = _sm.LastActionDate.HasValue ? _sm.LastActionDate.Value.ToString("yyyy-MM-dd") : "-";
                    <div class="ftree-member @_scard">
                        <div class="ftree-avatar-wrap">
                            <img class="ftree-avatar"
                                 src="@(string.IsNullOrWhiteSpace(_sm.Photo) ? "/images/icon/people/people_01.webp" : _sm.Photo)"
                                 alt="@_sm.FullName"
                                 onerror="this.src='/images/icon/people/people_01.webp'"/>
                            <span class="ftree-role-badge @_sbadgeCls">@_sm.RelLabel</span>
                        </div>
                        <div class="ftree-name">@_sm.FullName</div>
                        <div class="ftree-pts">@_sm.YearPoint.ToString("N0")점</div>
                        <div class="ftree-date">@_sdate</div>
                    </div>
                }
            </div>
        }
    </div>
}
