@model TitleBox

<style>
    .groupbox-border-root {
        width: 100%;
        margin: 15px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .groupbox-border-root-narrow {
        width: 100%;
        padding-top: 5px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .groupbox-border-box {
        position: relative;
        width: 95%;
        padding: 13px;
        border: 3px solid #4287f5; /* Blue border for the box */
        text-align: center;
        box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.3), -5px -5px 10px rgba(255, 255, 255, 0.5); /* 3D effect */
        border-radius: 5px;
        transition: transform 0.3s ease-in-out;
    }

    .groupbox-border-box:hover {
        transform: scale(1.05); /* Scale effect on hover */
    }

    .groupbox-border-label {
        position: absolute;
        top: -1.5em;
        left: 20px;
        background: #4287f5; /* Blue background for the label */
        padding: 5px 10px;
        color: #ffffff; /* White text for contrast */
        font-size: 17px;
        font-weight: bold;
        border: 3px solid #041b3f; /* Blue border for the label */
        border-radius: 5px;
        box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2), -2px -2px 5px rgba(255, 255, 255, 0.4); /* 3D effect for label */
    }
</style>
<div class="body-container">

    @if (string.IsNullOrEmpty(@Model.TitleHead))
    {
        <div class="groupbox-border-root-narrow">
            <div class="groupbox-border-box">
                <p class="text-font-20px-bold"><strong>@Model.TitleBody</strong></p>
            </div>
        </div>
    }
    else
    {
        <div class="groupbox-border-root">
            <div class="groupbox-border-box">
                <p class="text-font-20px-bold" style="margin-top :10px;"><strong>@Model.TitleBody</strong></p>
                <span class="groupbox-border-label"><strong>  @Model.TitleHead</strong> </span>
            </div>
        </div>
    }
</div>