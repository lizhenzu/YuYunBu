        </button>

        <button class="quick-nav-btn btn-soft-pink" onclick="location.hash='#address'">
            <span class="emoji">👧📋</span><span>학생교적부</span>
        </button>

        <button class="quick-nav-btn" onclick="location.hash='#album'">
