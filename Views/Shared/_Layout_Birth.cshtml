@using BulletinBoard.Common;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http;
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = null;
    var UserId = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserId.ToString()) as string;
    var UserFullName = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserFullName.ToString()) as string;
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ConstatsCommon.MainKeyTitle - 선물 선택</title>
    <style>
        body {
            background-color: #f7fdf8;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        header {
            background-color: #c8e6c9;
            text-align: center;
            padding: 20px 10px;
            border-bottom: 3px solid #a5d6a7;
        }

            header h1 {
                font-size: 2.2em;
                margin: 0;
                color: #1b5e20;
            }

            header p {
                font-size: 1em;
                margin: 8px 0 0;
            }

        footer {
            background-color: #c8e6c9;
            text-align: center;
            padding: 20px;
            font-size: 1em;
            color: #1b5e20;
            margin-top: 40px;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            justify-content: center;
            padding: 5px;
        }

        .card {
            width: 180px;
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            overflow: hidden;
            position: relative;
            margin-top: 5px;
            margin-bottom: 5px;
        }

            .card img {
                width: 100%;
                display: block;
                border-bottom: 1px solid #eee;
            }

        .badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #ffeb3b;
            color: #333;
            font-size: 0.8em;
            padding: 6px 10px;
            border-radius: 20px;
            font-weight: bold;
            box-shadow: 1px 1px 5px rgba(0,0,0,0.1);
        }

        .card-content {
            padding: 15px;
        }

        .brand {
            color: #1e88e5;
            font-size: 0.9em;
            margin-bottom: 5px;
        }

        .title {
            font-size: 0.9em;
            line-height: 1.4;
            margin-bottom: 10px;
        }

        .rating {
            color: #999;
            font-size: 0.85em;
            margin-bottom: 10px;
        }

            .rating span {
                color: #ffc107;
                font-size: 1em;
            }

        .price {
            font-size: 1.0em;
            font-weight: bold;
            margin-bottom: 10px;
            color: #2e7d32;
        }

        .price2 {
            font-size: 1.0em;
            font-weight: bold;
            margin-bottom: 10px;
            color: #2e7d32;
        }

        .status {
            font-size: 0.90em;
            font-weight: bold;
            margin-top: 10px;
            margin-bottom: 10px;
        }

        .button-group {
            display: flex;
            justify-content: space-between;
            gap: 10px;
        }

            .button-group button {
                flex: 1;
                padding: 5px;
                border: none;
                border-radius: 8px;
                font-size: 1.20em;
                cursor: pointer;
            }

        .gift-me {
            background-color: #424242;
            color: #fff;
        }

        .gift {
            background-color: #00704A;
            color: #ffffff;
        }
    </style>
</head>
<body>

    <header>
        <br />
        <h1>생일 선물 고르기</h1>
        <h3>안녕하세요</h3>
        <h2>@UserFullName 님</h2>
        <br />
    </header>


    <div class="nav-buttons" style="text-align:center; margin: 20px;">
        <button onclick="window.location.href='/'" style=" user-select: none;cursor: pointer; font-size: 1.20em;background:#81c784;color:white;border:none;padding:10px 20px;margin:5px;border-radius:8px;box-shadow:1px 1px 5px #aaa;">
            🏠 홈으로
        </button>
    </div>
        @RenderBody()
    <footer>
        🎁 감사합니다!
    </footer>

</body>
</html>
