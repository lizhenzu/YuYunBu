<body>
      @RenderBody()


    <script>
        // Function to automatically execute submitRequest after the page has loaded
        document.addEventListener('DOMContentLoaded', function () {
            submitRequest();
        });

        async function submitRequest() {
        @{

            if (ViewData["PM"] != null)
            {
                string pm = ViewData["PM"].ToString();
                pm = pm.Replace("\r", "").Replace("\n", "");
                ViewData["PM"] = pm;
            }
            else
            {
                ViewData["PM"] = string.Empty;
            }

        }

            var content = "@Html.Raw(ViewData["PM"] ?? "")"; // This ensures ViewData["PM"] renders correctly as a JavaScript string
            var contentID = "@Html.Raw(ViewData["PMID"] ?? "")"; // This ensures ViewData["PM"] renders correctly as a JavaScript string

            if (content.trim()) {

                let result = await confirmMessage(true, ["@Html.Raw(@sessionValue)님~", "새로운 문자가 도착했어요."], null, "지금 보기", "다음에"); // 취소 버튼 표시
                if (result === 'y') {
                    //  alert('확인 버튼을 눌렀습니다. 다음 작업을 진행합니다.');
                    // 여기에 다음 작업을 넣습니다
                    goToPage('/MessageCenter/ReadPopMessage?PopMessageReadMehod=@PopMessageReadMehod.ReadMyAllMessage.ToString()');
                } else if (result === 'c') {
                    //  alert('취소 버튼을 눌렀습니다. 작업을 취소합니다.');
                    // 작업 취소 로직
                }
            }
        }
        function goToPage(url) {
            window.location.href = url;
        }
    </script>

</body>
