    <style>
        table {
            margin: 0 auto; /* 테이블을 수평으로 가운데 정렬 */
            border-collapse: collapse; /* 셀 간의 간격 제거 */
            border-spacing: 0; /* 테두리 사이 간격 제거 */
        }

            table th, table td {
                font-family: 'Tahoma', sans-serif;
                font-size: 11px;
                padding: 5px 10px; /* 셀 내부 여백 추가 */
                border: 1px solid #ddd; /* 셀 테두리 추가 */
            }

        td {
            text-align: left;
        }
