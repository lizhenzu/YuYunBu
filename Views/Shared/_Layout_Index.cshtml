@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

 @{
    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
    var sessionValue = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserFullName.ToString());

 }

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <link rel="manifest" href="/manifest.json">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ChurchName · @DepartmentName</title>
    <meta property="og:title" content="@ChurchName · @DepartmentName">
    <meta property="og:description" content="@ChurchName · @DepartmentName 입니다.">
    <meta property="og:image" content="@ViewBag.FullURL/images/home/welcome/welcome_01.webp">
    <meta property="og:url" content="@ViewBag.FullURL">
    <meta property="og:type" content="website">

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js')
                .then(function (registration) {
                    console.log('Service Worker registered with scope:', registration.scope);
                }).catch(function (error) {
                    console.log('Service Worker registration failed:', error);
                });
        }
    </script>
    <style>
         @@import url('https://fonts.googleapis.com/css2?family=Jua&display=swap');

        body {
            /* font-family: 'Jua', sans-serif; */
            display: block;
            margin: 0px;
            text-align: center;
            background-color: #E0E0E0;
        }

        .container {
            color: #333;
            padding-top: 0px;
            /* display: flex;*/
            justify-content: center;
            align-items: center;
        }

        .content {
            text-align: center;
            color: #43A047;
            background-color: #E8F5E9; /* #9e1a20; /* #198754;  rgba(0, 0, 0, 0.8); Semi-transparent black background */
            padding: 5px;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            z-index: 1000;
        }

        .modal {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            padding: 10px;
            background-color: rgba(0, 0, 0, 0.8); /* 어두운 배경색에 약간의 투명도 추가 */
            width: 320px;
            z-index: 1001;
            box-shadow: 0 4px 6px rgba(0,0,0,.8);
            border-radius: 8px; /* 모서리 둥글게 */
        }

            .modal h2 {
                margin-top: 0;
                color: #333; /* 제목 색상 */
            }

            .modal button {
                padding: 8px 16px;
                margin-right: 11px; /* 버튼 간격 */
                background-color: #4CAF50; /* 버튼 배경색 */
                color: white;
                border: none;
                border-radius: 4px; /* 버튼 모서리 둥글게 */
                cursor: pointer;
            }

                .modal button:last-child {
                    margin-right: 0;
                }

            .modal div.controls {
                text-align: center;
                margin-top: 20px;
            }

            .modal div.checkbox-group {
                margin-top: 10px;
                text-align: center;
            }

            .modal input[type="checkbox"] {
                margin-right: 5px;
            }
    </style>

    <style>
        .no-margin {
            margin: 1px;
            padding: 1px;
        }
    </style>

    <style>
        .modalBox {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgb(0,0,0,0.9);
        }

        .modal-content-box {
            margin: auto;
            display: block;
            width: 320px;
            max-width: 1200px;
        }

        .captionBox {
            color: black;
            font-size: 20px;
            color: white;
            text-align: center;
            margin-top: 8px;
            margin-bottom: 8px;
        }

        .closeBox {
