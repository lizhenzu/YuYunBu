@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ChurchName · @DepartmentName</title>

    <!-- Bootstrap 5 통일 -->
    <environment include="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet"
              href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
              integrity="sha384-9NDLqfU3Z3dFQ..."
              crossorigin="anonymous" />
        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    </environment>
    <link rel="stylesheet" href="~/css/button.css" />
    <link rel="stylesheet" href="~/css/card.css">
    <link rel="stylesheet" href="~/css/InputForm.css">
    <link rel="stylesheet" href="~/css/responsive.css">
    <link rel="stylesheet" href="~/css/Table.css">
    <link rel="stylesheet" href="~/css/radiobox.css">
    <link rel="stylesheet" href="~/css/img_thumbnail.css">
    <link rel="stylesheet" href="~/css/textFont.css">
    <link rel="stylesheet" href="~/css/modalPopup.css">
    <link rel="stylesheet" href="~/css/welcome2.css">
    <link rel="stylesheet" href="~/css/construction.css">
    <link rel="stylesheet" href="~/css/textTextBackgroundColorAndColor.css">
    <link rel="stylesheet" href="~/css/missionCommon.css">
    <link rel="stylesheet" href="~/css/missionC.css">
    <link rel="stylesheet" href="~/css/common.layer.css">
    <link rel="stylesheet" href="~/css/color.css">


    <link rel="stylesheet" href="/css/topLevelImage.css">
    <link rel="stylesheet" href="/css/missionCircle.css">
    <link rel="stylesheet" href="/css/ProcessBar.css">

    <link rel="stylesheet" href="/css/ButtonBase7.css">
    <link rel="stylesheet" href="/css/ColorBase7.css">

    <link rel="stylesheet" href="/assets/styles.css">


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <environment exclude="Development">
        <link rel="stylesheet" href="https://ajax.aspnetcdn.com/ajax/bootstrap/3.3.7/css/bootstrap.min.css"
              asp-fallback-href="~/lib/bootstrap/dist/css/bootstrap.min.css"
              asp-fallback-test-class="sr-only" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />
        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
 
    </environment>


    <style>
        body {
            background-size: cover;
            margin: 0;
            background: #ECEFF1;
            display: flex;
            padding-top:20px;
        }
    </style>
    
    <style>
        .mission-card {
            background: white;
            border-radius: 15px;
            box-shadow: 3px 3px 8px rgba(0, 0, 0, 0.1);
            margin: 5px 0;
            padding: 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            transition: transform 0.2s ease-in-out, background 0.3s;
        }

            .mission-card:active {
                border-color: #ff7043;
            }

            .mission-card:hover {
                border-color: #ff7043;
            }

            .mission-card img {
                width: 55px;
                height: 55px;
                border-radius: 50%;
                border: 3px solid #ffffff;
                box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
                border-radius: 35px;
            }

        .mission-text {
            flex: 1;
            margin-left: 15px;
            text-align: left;
        }

        .mission-title {
            font-size: 22px;
            font-weight: bold;
            color: #37474F;
        }

    </style>
    <script src="/js/common2.js"></script>
    <script src="/js/ProcessBar73.js"></script>
    <style>
        /* 폭죽을 그릴 전역 캔버스: 콘텐츠 위, 로딩 오버레이(z=9999) 아래 */
        #fx {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9000;
        }
    </style>
</head>
<body>
    <canvas id="fx"></canvas>
    <div id="loadingOverlay" class="loading-overlay">
        <div class="loading-box">처리중입니다</div>
    </div>

    <div class="container" style="max-width: 1000px;">
        @RenderBody()
    </div>

    <!-- Scripts: Bootstrap 5 (jQuery 불필요) -->
    <environment include="Development">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-..."
                crossorigin="anonymous"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="/assets/celebrate.js" defer></script>
    </environment>
    <environment exclude="Development">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-..."
                crossorigin="anonymous"></script>
        <script src="~/js/site.min.js" asp-append-version="true"></script>
        <script src="/assets/celebrate.js" defer></script>
    </environment>

    <script>
        (function(){
          function setupFX(){
            // 1) 이미 초기화됐다면 재초기화하지 않음
            if (window.FX) return;

            // 2) 캔버스 준비
            var cvs = document.getElementById('fx');
            if (!cvs) {
              cvs = document.createElement('canvas');
              cvs.id = 'fx';
              document.body.prepend ? document.body.prepend(cvs) : document.body.insertBefore(cvs, document.body.firstChild);
            }

            // 3) 라이브러리 준비됐으면 초기화
            if (window.CelebrateFX && typeof window.CelebrateFX.init === 'function') {
              window.FX = window.CelebrateFX.init({ canvas: cvs, enableSound: true });
              console.log('FX ready');
            } else {
              console.warn('celebrate.js not ready yet; will retry on window.load');
            }
          }

          // DOM 로드 후 한 번 시도
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupFX);
          } else {
            setupFX();
          }
          // JS 리소스(defer 포함)까지 모두 끝난 뒤 한번 더 안전하게
          window.addEventListener('load', setupFX);
        })();
    </script>
    @RenderSection("Scripts", required: false)
 
</body>
</html> 