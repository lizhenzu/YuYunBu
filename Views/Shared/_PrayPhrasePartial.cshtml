@model BulletinBoard.Models.PrayPhrase
@*  기도문 입력칸 묶음 — 2026-10-04 밝은 테마 (quiz-bright.css 안에서 사용).  이전 파일은 _PrayPhrasePartial.cshtml.bak_before_bright *@

<span class="pp-date">공개일 @Model.ExposeDate.ToString("yyyy-MM-dd")</span>

<div class="qb-f">
    <label asp-for="PrayTitle">기도제목</label>
    <input asp-for="PrayTitle" class="qb-in" autofocus />
    <span asp-validation-for="PrayTitle" class="error"></span>
</div>

<div class="qb-f">
    <label asp-for="BibleTextToPray">성경 (예: 요한복음)</label>
    <input asp-for="BibleTextToPray" class="qb-in" />
    <span asp-validation-for="BibleTextToPray" class="error"></span>
</div>

<div class="pp-rng">
    <span class="lbl">시작 장 · 절</span>
    <div class="pr">
        <input asp-for="BibleTextToPrayFromJang" class="qb-in" placeholder="시작 장" aria-label="시작 장" />
        <input asp-for="BibleTextToPrayFromZul" class="qb-in" placeholder="시작 절" aria-label="시작 절" />
    </div>
    <span class="lbl" style="margin-top:12px">종료 장 · 절</span>
    <div class="pr">
        <input asp-for="BibleTextToPrayToJang" class="qb-in" placeholder="종료 장" aria-label="종료 장" />
        <input asp-for="BibleTextToPrayToZul" class="qb-in" placeholder="종료 절" aria-label="종료 절" />
    </div>
    <span asp-validation-for="BibleTextToPrayFromJang" class="error"></span>
    <span asp-validation-for="BibleTextToPrayFromZul" class="error"></span>
    <span asp-validation-for="BibleTextToPrayToJang" class="error"></span>
    <span asp-validation-for="BibleTextToPrayToZul" class="error"></span>
</div>

<div class="qb-f">
    <label asp-for="PraryBeginMesssage">기도 시작 말씀</label>
    <textarea id="PraryBeginMesssage" name="PraryBeginMesssage" class="qb-in" rows="2" style="min-height:70px">@Model.PraryBeginMesssage</textarea>
    <span asp-validation-for="PraryBeginMesssage" class="error"></span>
</div>

<div class="qb-f">
    <label asp-for="PrayContent1">기도내용 1</label>
    <textarea id="PrayContent1" name="PrayContent1" class="qb-in" rows="3" style="min-height:90px">@Model.PrayContent1</textarea>
    <span asp-validation-for="PrayContent1" class="error"></span>
</div>
<div class="qb-f">
    <label asp-for="PrayContent2">기도내용 2</label>
    <textarea id="PrayContent2" name="PrayContent2" class="qb-in" rows="3" style="min-height:90px">@Model.PrayContent2</textarea>
    <span asp-validation-for="PrayContent2" class="error"></span>
</div>
<div class="qb-f">
    <label asp-for="PrayContent3">기도내용 3</label>
    <textarea id="PrayContent3" name="PrayContent3" class="qb-in" rows="3" style="min-height:90px">@Model.PrayContent3</textarea>
    <span asp-validation-for="PrayContent3" class="error"></span>
</div>

<div class="qb-f">
    <label asp-for="PraryEndMesssage">기도 맺음 말씀</label>
    <textarea id="PraryEndMesssage" name="PraryEndMesssage" class="qb-in" rows="2" style="min-height:70px">@Model.PraryEndMesssage</textarea>
    <span asp-validation-for="PraryEndMesssage" class="error"></span>
</div>

<input type="hidden" id="Id" name="Id" value="@Model.Id" />
