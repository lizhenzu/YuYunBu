@model NavigationButtonInfo
<div class="button-container-horizontal-transparent">
    @if (!string.IsNullOrEmpty(Model.goPrev))
    {
        <div class="button-click-division-2" onclick="sendPostRequest(@Model.goPrev)">이전</div>
    }
    @if (!string.IsNullOrEmpty(Model.goList))
    {
        <div class="button-click-division-2" onclick="sendPostRequest(@Model.goList)">메인</div>
    }
    @if (!string.IsNullOrEmpty(Model.goNext))
    {
        <div class="button-click-division-2" onclick="sendPostRequest(@Model.goNext)">다음</div>
    }
</div>

<script>
    function sendPostRequest(url) {
        window.location.href = url;
    }
</script>
