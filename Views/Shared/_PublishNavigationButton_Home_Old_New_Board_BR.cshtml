@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<div class="button-bar no-select">
    <div class="colorBaseHome buttonCommon" onclick="location.href='/'">Home</div>
    @if (ViewBag.ab == "a")
    {
        <div class="colorBaseForestGreen buttonCommon " onclick="location.href='/bibleCenter/IndexByAB?ab=b'">신약성경</div>
    }
    else
    {
        <div class="colorBaseMintGreen  buttonCommon " onclick="location.href='/bibleCenter/IndexByAB?ab=a'">구약성경</div>

    }
    <div class="colorBaseLightPurple buttonCommon " onclick="location.href='/bibleCenter/MyDashboard'">@ConstatsCommon.ReadBibleAllTitleButton</div>
</div>