@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    bool isOldTestament = ViewBag.ab == "a";
}

<style>
    .reading-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
        margin: 10px 0 20px;
    }

    .reading-nav-btn {
        border: none;
        border-radius: 16px;
        padding: 14px 20px;
        min-width: 160px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: 0.97rem;
        font-weight: 800;
        cursor: pointer;
        color: white;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.10);
        transition: transform .22s ease, box-shadow .22s ease, filter .22s ease;
    }

        .reading-nav-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 32px rgba(15, 23, 42, 0.14);
            filter: brightness(1.02);
        }

        .reading-nav-btn:active {
            transform: translateY(0);
        }

    .nav-emoji {
        font-size: 1.05rem;
        line-height: 1;
    }

    .nav-home {
        background: linear-gradient(135deg, #0f172a 0%, #334155 100%);
    }

    .nav-old {
        background: linear-gradient(135deg, #10b981 0%, #14b8a6 100%);
    }

    .nav-new {
        background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
    }

    .nav-dashboard {
        background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
    }

    @@media (max-width: 640px) {
        .reading-nav {
            gap: 10px;
        }

        .reading-nav-btn {
            width: 100%;
            min-width: 0;
            padding: 14px 16px;
            border-radius: 14px;
        }
    }
</style>

<div class="reading-nav">
    <button type="button" class="reading-nav-btn nav-home" onclick="location.href='/'">
        <span class="nav-emoji">🏠</span>
        <span>홈</span>
    </button>

    @if (isOldTestament)
    {
        <button type="button" class="reading-nav-btn nav-new" onclick="location.href='/bibleCenter/IndexByAB?ab=b'">
            <span class="nav-emoji">📘</span>
            <span>신약성경</span>
        </button>
    }
    else
    {
        <button type="button" class="reading-nav-btn nav-old" onclick="location.href='/bibleCenter/IndexByAB?ab=a'">
            <span class="nav-emoji">📗</span>
            <span>구약성경</span>
        </button>
    }

    <button type="button" class="reading-nav-btn nav-dashboard" onclick="location.href='/bibleCenter/MyDashboard'">
        <span class="nav-emoji">📊</span>
        <span>@ConstatsCommon.ReadBibleAllTitleButton</span>
    </button>
</div>