<style>
    .reading-legend-wrap {
        display: flex;
        justify-content: flex-end;
        padding: 16px 6px;
    }

    .reading-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 800;
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
        border: 1px solid rgba(255,255,255,0.7);
        backdrop-filter: blur(6px);
        white-space: nowrap;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    /* 완료 */
    .legend-complete {
        background: linear-gradient(180deg, #f1f5f9 0%, #e2e8f0 100%);
        color: #475569;
    }

        .legend-complete .legend-dot {
            background: #64748b;
        }

    /* 진행중 */
    .legend-progress {
        background: linear-gradient(180deg, #fff1f2 0%, #ffe4e6 100%);
        color: #be123c;
    }

        .legend-progress .legend-dot {
            background: #f43f5e;
        }

    /* 미진행 */
    .legend-notstarted {
        background: linear-gradient(180deg, #f0fdf4 0%, #dcfce7 100%);
        color: #166534;
    }

        .legend-notstarted .legend-dot {
            background: #22c55e;
        }

    @@media (max-width: 640px) {
        .reading-legend-wrap

    {
        justify-content: center;
    }

    .reading-legend {
        justify-content: center;
    }

    .legend-item {
        font-size: 0.85rem;
        padding: 7px 12px;
    }

    }
</style>

<div class="reading-legend-wrap">
    <div class="reading-legend">
        <div class="legend-item legend-complete">
            <span class="legend-dot"></span>
            완료
        </div>
        <div class="legend-item legend-progress">
            <span class="legend-dot"></span>
            진행중
        </div>
        <div class="legend-item legend-notstarted">
            <span class="legend-dot"></span>
            미진행
        </div>
    </div>
</div>