@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{

 var UserId = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserId.ToString()) as string;
 }
<script>

    const dataAll = {
        UserId: "@UserId",
        LangCD: "all",
        PagesForView: 0,
        Notice_1_Collapse: ""
    };
    const dataKO = {
        UserId: "@UserId",
        LangCD: "ko",
        PagesForView: 0,
        Notice_1_Collapse: ""
    };
    const dataEN = {
        UserId: "@UserId",
        LangCD: "en",
        PagesForView: 0,
        Notice_1_Collapse: ""
    };


</script>

<div class="button-bar  no-select">
    <div class="buttonCommon colorBaseDeepTeal" id="closeDiv" onclick="doProcess(dataAll, 'UpdateUserSettings', 'y', false);">한글/영어</div>
    <div class="buttonCommon colorBaseForestGreen" id="closeDiv" onclick="doProcess(dataKO, 'UpdateUserSettings', 'y', false);">한글</div>
    <div class="buttonCommon colorBaseMediumGreen" id="closeDiv" onclick="doProcess(dataEN, 'UpdateUserSettings', 'y', false);">영어</div>
</div>
