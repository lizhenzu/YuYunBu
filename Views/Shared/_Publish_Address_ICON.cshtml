@model BulletinBoard.Models.ClassICON
@using BulletinBoard.Common;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@using BulletinBoard.Helpers
@using Microsoft.AspNetCore.Http;
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<div class="card">
    <img src="@Model.imageURL" alt="Profile Picture">
    <div class="info">
        <div class="row" style="display: flex; justify-content: center; text-align: center;"><span style="font-weight: bold;">@Model.ClassName</span></div>
        <button onclick="location.href='/HumanResource/addressBookDetail?DeptCode=@Model.DeptCode&RankQueryOptionData=@Model.RankQueryOptionData.ToString()&ClassYear=@Model.ClassYear&ClassBan=@Model.ClassBan'">상세보기</button>
        <button onclick="location.href='/HumanResource/printStudentCard?DeptCode=@Model.DeptCode&ClassYear=@Model.ClassYear&ClassBan=@Model.ClassBan'">교적카드</button>
    </div>
</div>

