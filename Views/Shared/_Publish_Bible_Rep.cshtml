@model BulletinBoard.Models.eBibles

<style>

    .card {
        background-color: #F5F5F5;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        padding: 24px;
        margin-bottom: 20px;
    }

        .card h1 {
            text-align: center; /* 가운데 정렬 적용 */
        }

        .card p {
            text-align: center; /* 가운데 정렬 적용 */
        }

    .label {
        font-weight: bold;
        margin-top: 8px;
        color: #555;
    }

    .value {
        /*  margin-left: 10px;*/
    }
</style>

        <div class="card">
            <h1>@Model.BibleText</h1>
            <p>(개역개정)</p>
            <div style="padding-top : 3px;padding-bottom : 3px;"><span class="label" style="color: #43A047;">저자 </span><br /><span class="value">@Model._BibleBasicInfos2.Author</span></div>
            <div style="padding-top : 3px;padding-bottom : 3px;"><span class="label" style="color: #43A047;">기록 시기</span><br /><span class="value">@Model._BibleBasicInfos2.WhenWritten</span></div>
            <div style="padding-top : 3px;padding-bottom : 3px;"><span class="label" style="color: #43A047;">개요 </span><br /><span class="value">@Model._BibleBasicInfos2.OverView</span></div>
            <div style="padding-top : 3px;padding-bottom : 3px;"><span class="label" style="color: #43A047;">기록 목적</span><br /><span class="value">@Model._BibleBasicInfos2.Purpose</span></div>
        </div>
        <div class="card" style="text-align :center; ">
            <p style="padding-top : 3px;padding-bottom : 3px; text-align :center; color: #43A047;">오늘의 말씀</p>
            <h4>@Model.JanZulString</h4>
        </div>