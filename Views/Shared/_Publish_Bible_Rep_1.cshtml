@model BulletinBoard.Models.eBibles
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var UserId = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserId.ToString()) as string;
}
<style>

    .card {
        background-color: #F5F5F5;
        border-radius: 12px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        padding: 24px;
        margin-bottom: 20px;
    }

        .card h1 {
            text-align: center; /* 가운데 정렬 적용 */
        }

        .card p {
            text-align: center; /* 가운데 정렬 적용 */
        }

    .label {
        font-weight: bold;
        margin-top: 8px;
        color: #555;
    }

    .value {
        /*  margin-left: 10px;*/
    }
</style>

<script>

    const dataBibleBookOverviewDetail = {
        UserId: "@UserId",
        LangCD: "",
        PagesForView: 0,
        Notice_1_Collapse: "",
        BibleBookOverview: "d"
    };

</script>
<div class="card" style="margin-top: 10px;">
    <h1>@Model.BibleText</h1>
    <p>(개역개정)</p>
    <div style="padding-top : 3px;padding-bottom : 3px;"><span class="label" style="color: #43A047;">저자 </span><br /><span class="value">@Model._BibleBasicInfos2.Author</span></div>
    <div style="padding-top : 3px;padding-bottom : 3px;"><span class="label" style="color: #43A047;">기록 시기</span><br /><span class="value">@Model._BibleBasicInfos2.WhenWritten</span></div>
    <div style="padding-top : 3px;padding-bottom : 3px;"><span class="label" style="color: #43A047;">개요 </span><br /><span class="value">@Model._BibleBasicInfos2.OverView</span></div>
    <div style="padding-top : 3px;padding-bottom : 3px;"><span class="label" style="color: #43A047;">기록 목적</span><br /><span class="value">@Model._BibleBasicInfos2.Purpose</span></div>

    <div style="margin-top: 15px; text-align: center;">
        <div class="buttonCommon colorBaseMediumGreen" id="closeDiv" style="background-color:#A3D9A5; color:black;" onclick="doProcess(dataBibleBookOverviewDetail, 'UpdateUserSettings', 'y');">상세본으로 전환</div>
    </div>
</div>
