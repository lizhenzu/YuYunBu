@model BulletinBoard.Models.eBibles
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var UserId = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserId.ToString()) as string;
}
<script>

    const dataBibleBookOverviewSimple = {
        UserId: "@UserId",
        LangCD: "",
        PagesForView: 0,
        Notice_1_Collapse: "",
        BibleBookOverview: "s"
    };
</script>

<div class="bible-overview-box">
    <div class="bible-overview-container">
        <h1>📖 성경 개요</h1>

        <div class="section">
            <h2>📘 성경</h2>
            <p>@Model._BibleBookOverviewDetail.BookName</p>
        </div>

        <div class="section">
            <h2>✍️ 저자</h2>
            <p>
                <strong>@Model._BibleBookOverviewDetail.Author</strong><br>
                @Model._BibleBookOverviewDetail.AuthorDescription
            </p>
        </div>

        <div class="section">
            <h2>📅 저작 연대</h2>
            <ul>
                <li>@Model._BibleBookOverviewDetail.WrittenDateFrom ~ @Model._BibleBookOverviewDetail.WrittenDateTo
                <li>@Model._BibleBookOverviewDetail.AlternativeDate</li>
            </ul>
        </div>

        <div class="section">
            <h2>📍 기록 장소</h2>
            <p>@Model._BibleBookOverviewDetail.WrittenPlace</p>
        </div>

        <div class="section">
            <h2>🎯 기록 대상</h2>
            <p>@Model._BibleBookOverviewDetail.WrittenTarget</p>
        </div>

        <div class="section">
            <h2>🕰️ 역사적 배경</h2>
            <p>
                @Model._BibleBookOverviewDetail.HistoricalPeriod <br />
                @Model._BibleBookOverviewDetail.HistoricalBackground
            </p>
        </div>

        <div class="section">
            <h2>🔑 핵심어</h2>
            <p>   @Model._BibleBookOverviewDetail.Keywords</p>
        </div>

        @{
            var content = Model._BibleBookOverviewDetail.ContentSummary ?? "";
            var contentSummaryList = content.Split(new[] { "\\n", "\n" }, StringSplitOptions.RemoveEmptyEntries);
            var numberedItems = new List<string>();
            var finalNote = "";

            foreach (var item in contentSummaryList)
            {
                if (System.Text.RegularExpressions.Regex.IsMatch(item.Trim(), @"^\d+\.\s"))
                {
                    // 번호 제거 (예: "1. 내용" -> "내용")
                    var cleanItem = System.Text.RegularExpressions.Regex.Replace(item.Trim(), @"^\d+\.\s*", "");
                    numberedItems.Add(cleanItem);
                }
                else
                {
                    finalNote = item.Trim(); // 마지막 요약 문장 (숫자 없는 경우)
                }
            }
        }


        <div class="section">
            <h2>📜 핵심 내용 요약</h2>

            @if (numberedItems.Any())
            {
                <ul>
                    @foreach (var item in numberedItems)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
        </div>
        @if (!string.IsNullOrEmpty(finalNote))
        {
            <div class="section">
                <h2>📜한줄 요약</h2>

                <p>@finalNote</p>
            </div>
        }

        <div style="margin-top: 15px; text-align: center;">
            <div class="buttonCommon colorBaseMediumGreen" style="background-color:#A3D9A5 ; color:black;" id="closeDiv" onclick="doProcess(dataBibleBookOverviewSimple, 'UpdateUserSettings', 'y');">간략본으로 전환</div>
        </div>
    </div>
</div>
<style>
    .bible-overview-box {
        font-family: 'Segoe UI', sans-serif;
        margin-top: 10px;
        margin-bottom: 10px;
        padding: 1px;
        background-color: #f9f9f9;
    }

    .bible-overview-container {
        /*  max-width: 800px;*/
        margin: 0 auto;
        background-color: #fff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 12px rgba(0, 0, 0, 0.08);
    }

        .bible-overview-container h1 {
            text-align: center;
            color: #2c3e50;
            margin-bottom: 30px;
            font-size: 24px;
        }

        .bible-overview-container .section {
            margin-bottom: 20px;
        }

            .bible-overview-container .section h2 {
                font-size: 16px;
                margin-bottom: 8px;
                color: #34495e;
                border-left: 4px solid #3498db;
                padding-left: 10px;
            }

            .bible-overview-container .section p,
            .bible-overview-container .section ul {
                margin: 0;
                line-height: 1.6;
                color: #555;
            }

        .bible-overview-container ul {
            padding-left: 20px;
        }

    @@media (max-width: 600px) {
        .bible-overview-container {
            padding: 20px;
        }

            .bible-overview-container h1 {
                font-size: 20px;
            }

            .bible-overview-container .section h2 {
                font-size: 14px;
            }
    }
</style>
