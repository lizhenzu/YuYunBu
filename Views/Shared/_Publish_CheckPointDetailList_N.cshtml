@model BulletinBoard.Models.PointByUserNameList


<div class='container'>
    @foreach (var item in Model.pointByUserNames)
    {
        string dateSring = string.Empty;

        string fullName = $"{@item.LastName}{@item.FirstName}";

        if (item.ClassYear == 123)
        {
            dateSring = $"이름(계정) : {@item.LastName}{@item.FirstName}({@item.UserName}) [유년부교사]";
        }
        else if (item.ClassYear > 0)
        {
            dateSring = $"이름(계정) : {@item.LastName}{@item.FirstName}({@item.UserName}) [{@item.ClassYear}학년{@item.ClassBan}반]";
        }
        else
        {
            dateSring = $"이름(계정) : {@item.LastName}{@item.FirstName}({@item.UserName})";
        }

        if (item.DC_Total >= Model.FromPoint && item.DC_Total < Model.ToPoint)
        {
            <div class="card">
                <img src="@item.ProfilePicturePath" alt="Profile Picture">
                <div class="info">
                    <h3>@fullName</h3>
                    <p>점수(토털) : @item.DC_Total</p>
                    <p>점수(보관) : @item.AwardLevel</p>
                    <button>Manage</button>
                </div>
            </div>
        }
    }
</div>

