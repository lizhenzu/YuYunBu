@model MissionContents


<div class="mission" >
	<div class="mission-photo">
		<img src="@Model.BackGround" class="resize-image">
	</div>
	<div class="mission-info" style="user-select: none;">
		<h3 style="margin-top : 1px">@Model.MissionText</h3>

		@if (string.IsNullOrEmpty(@Model.MissionMessageA))
		{
			<p >@Model.MissionMessage</p>
		}
		else
		{
@*			<p>(@Model.MissionMessageA) <br /> @Model.MissionMessage</p>*@
			<p>(@Model.MissionMessageA) <br /> 광고가 누락되어서 1주일 연기 합니다. ^^ </p>
		}
@*		<button class="mission-button @Model.ButtonStyle" onclick="location.href='@Model.MissionURL'">이동</button>
		<button class="mission-button mission-button-color-6" onclick="location.href='/ChallengeEnglishQuiz/Intro'">설명</button>
*@	</div>
</div>

