@model MissionContents

@{
	List<UserInfo> birthDayList = ViewData["BirthDayList"] as List<UserInfo>;
	string infoString = string.Empty;
	string roletring = string.Empty;
	string YearBan = string.Empty;

}
<style>
	.no-margin {
		margin: 1px;
		padding: 1px;
	}

</style>
<div class="mission">
	<div class="mission-photo">
		<img src="@Model.BackGround" class="resize-image">
	</div>
	<div class="mission-info">
		<h3 style="margin-top : 1px">@Model.MissionText</h3>
		<table cellspacing="0" cellpadding="0">
			@foreach (var va in birthDayList)
			{
				<tr>
					@if (va.RoleCode == "T1001")
					{
						roletring = $"학생";
						YearBan = $"{va.ClassYear}학년{va.ClassBan}반";
					}
					else
					{
						roletring = $"교사";
						YearBan = "";
					}
					@if (va.bDay > 9)
					{
						infoString = $"{va.bMonth}월{va.bDay}일";
					}
					else
					{
						infoString = $"{va.bMonth}월0{va.bDay}일";
					}

					<td onclick="ManageUserInfo('@va.UserId')">
						@va.FullName
					</td>
					<td>
						@roletring
					</td>
					<td>
						@YearBan
					</td>
					<td>
						@infoString
					</td>
				</tr>
			}
		</table>
		<h4 class="no-margin" onclick="location.href='/HumanResource/ViewMainBirthDay'" style="color: blue;user-select: none;">더보기...</h4>
	</div>
</div>

 