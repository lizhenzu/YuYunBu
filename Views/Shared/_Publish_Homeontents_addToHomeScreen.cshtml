@model MissionContents

<script>
    function addToHomeScreen() {
        const userAgent = window.navigator.userAgent.toLowerCase();

        if (userAgent.includes("iphone") || userAgent.includes("ipad")) {
            // iOS 디바이스 안내
            alert("iOS에서는 Safari 브라우저에서 하단 공유 버튼을 클릭한 후 '홈 화면에 추가'를 선택하세요.");
        } else if (userAgent.includes("android")) {
            // Android 디바이스 안내
            alert("Android에서는 브라우저 메뉴 버튼을 클릭한 후 '홈 화면에 추가'를 선택하세요.");
        } else {
            // 데스크톱 또는 기타 플랫폼 안내
            alert("홈 화면 바로가기를 추가하려면 모바일 기기에서 이 페이지에 접속하세요.");
        }
    }


</script>

<script>
    // 전역 변수에 설치 프롬프트 저장
    let deferredPrompt;

    // 브라우저가 beforeinstallprompt 이벤트를 감지할 때 실행
    window.addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        deferredPrompt = event;

        // 버튼 표시
        const installButton = document.getElementById('installButton');
        installButton.style.display = 'block';

        installButton.addEventListener('click', () => {
            // 버튼 숨김
            installButton.style.display = 'none';

            // 설치 프롬프트 실행
            deferredPrompt.prompt();

            deferredPrompt.userChoice.then((choiceResult) => {
                if (choiceResult.outcome === 'accepted') {
                    console.log('사용자가 설치를 수락했습니다.');
                } else {
                    console.log('사용자가 설치를 거부했습니다.');
                }
                deferredPrompt = null; // 초기화
            });
        });
    });

    // 지원하지 않는 경우 처리
    window.addEventListener('appinstalled', () => {
        console.log('PWA가 설치되었습니다.');
    });
</script>

<div class="mission">
    <div class="mission-photo">
        <img src="@Model.BackGround" class="resize-image">
    </div>
    <div class="mission-info" style="user-select: none;">
        <h3 style="margin-top : 1px">@Model.MissionText</h3>
        <p>@Model.MissionMessage</p>
        <button class="mission-button @Model.ButtonStyle" id="installButton">만들기</button>
    </div>
</div>

