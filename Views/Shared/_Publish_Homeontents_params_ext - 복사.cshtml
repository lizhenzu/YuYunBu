@model MissionMenuItem


<div class="mission">
	<div class="mission-info" style="user-select: none;">

		<!-- 이미지 + 텍스트를 나란히 배치 -->
		<div style="display: flex; gap: 20px; align-items: center; justify-content: center; flex-wrap: wrap;">
			@if (!string.IsNullOrEmpty(@Model.BackGround))
			{
				<div class="mission-photo">
					<img src="@Model.BackGround" class="resize-image" style="max-width: 200px;     width: 50px;height: auto;">
				</div>
			}
			<div style="max-width: 500px;">
				<h3 style="margin-top: 1px;">@Model.MissionText</h3>
				<p>@Model.MissionMessage</p>
			</div>
		</div>

		<!-- 아래쪽 버튼 링크들 -->
		<div style="display: flex; gap: 10px; justify-content: center; align-items: center; margin-top: 20px; flex-wrap: wrap;">
			<h4 class="no-margin" onclick="location.href='@Model.MissionURL1'" style="color: blue; user-select: none; cursor: pointer;">@Model.MissionURL1_Text</h4>
			@if (!string.IsNullOrEmpty(@Model.MissionURL2))
			{
				<h4 class="no-margin" onclick="location.href='@Model.MissionURL2'" style="color: blue; user-select: none; cursor: pointer;">@Model.MissionURL2_Text</h4>
			}
			@if (!string.IsNullOrEmpty(@Model.MissionURL3))
			{
				<h4 class="no-margin" onclick="location.href='@Model.MissionURL3'" style="color: blue; user-select: none; cursor: pointer;">@Model.MissionURL3_Text</h4>
			}
			@if (!string.IsNullOrEmpty(@Model.MissionURL4))
			{
				<h4 class="no-margin" onclick="location.href='@Model.MissionURL4'" style="color: blue; user-select: none; cursor: pointer;">@Model.MissionURL4_Text</h4>
			}
		</div>

	</div>
</div>

