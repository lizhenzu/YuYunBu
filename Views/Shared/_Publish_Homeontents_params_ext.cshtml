@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model MissionMenuItem

@{

	RhapsodyOfRealitys _RhapsodyOfRealitys = ViewBag.RhapsodyOfRealitys as RhapsodyOfRealitys;
}

<div class="mission">
	@if (!string.IsNullOrEmpty(@Model.BackGround))
	{
		<div class="mission-photo">
			<img src="@Model.BackGround" class="resize-image">
		</div>
	}
	<div class="mission-info" style="user-select: none;">
		@if (!string.IsNullOrEmpty(@Model.Header))
		{
			<h4 style="margin-top : 1px;color: #A50034;">@Model.Header</h4>
		}
		<h2>@Model.MissionText</h2>


		@if (@Model.MissionText.Contains("아침설교"))
		{
			<p style="margin-top : 1px;color: #A50034;">@_RhapsodyOfRealitys.WordTitle</p>
			<div style="display: flex; gap: 10px; justify-content: center; align-items: center;">
				<h4 class="no-margin" onclick="location.href='/RhapsodyOfReality/DetailWords'" style="color: blue;user-select: none;cursor: pointer;">5분 말씀듣기</h4>
			</div>
		}
		else
		{
			<p>@Model.MissionMessage</p>
			<div style="display: flex; gap: 10px; justify-content: center; align-items: center;">
				<h4 class="no-margin" onclick="location.href='@Model.MissionURL1'" style="color: blue;user-select: none;cursor: pointer;">@Model.MissionURL1_Text</h4>
				@if (!string.IsNullOrEmpty(@Model.MissionURL2))
				{
					<h4 class="no-margin" onclick="location.href='@Model.MissionURL2'" style="color: blue;user-select: none;cursor: pointer;">@Model.MissionURL2_Text</h4>
				}
				@if (!string.IsNullOrEmpty(@Model.MissionURL3))
				{
					<h4 class="no-margin" onclick="location.href='@Model.MissionURL3'" style="color: blue;user-select: none;cursor: pointer;">@Model.MissionURL3_Text</h4>
				}
				@if (!string.IsNullOrEmpty(@Model.MissionURL4))
				{
					<h4 class="no-margin" onclick="location.href='@Model.MissionURL4'" style="color: blue;user-select: none;cursor: pointer;">@Model.MissionURL4_Text</h4>
				}
				@if (!string.IsNullOrEmpty(@Model.MissionURL5))
				{
					<h4 class="no-margin" onclick="location.href='@Model.MissionURL5'" style="color: blue;user-select: none;cursor: pointer;">@Model.MissionURL5_Text</h4>
				}
				@if (!string.IsNullOrEmpty(@Model.MissionURL6))
				{
					<h4 class="no-margin" onclick="location.href='@Model.MissionURL6'" style="color: blue;user-select: none;cursor: pointer;">@Model.MissionURL6_Text</h4>
				}
			</div>
		}

	</div>
</div>

