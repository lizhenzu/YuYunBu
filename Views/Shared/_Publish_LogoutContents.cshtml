@model MissionContents


<div class="mission" >
	<div class="mission-photo">
		<img src="@Model.BackGround" class="resize-image">
	</div>
	<div class="mission-info">
		<h3 style="margin-top : 1px">@Model.MissionText</h3>
		<p>@Model.MissionMessage</p>
		<form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
			<button type="submit" class="mission-button @Model.ButtonStyle">이동</button>
		</form>
	</div>
</div>

