@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Common;

@{
    var sessionWorkDT = Context.Session.GetString(DateKind.WorkDT.ToString());
    var sessionTodayDT = Context.Session.GetString(DateKind.TodayDT.ToString());

    DateTime todayDT = BulletinBoard.Common.SharedComm.GetToday();
    DateTime missionDT = BulletinBoard.Common.SharedComm.GetToday();

    if (sessionWorkDT != null)
    {
        missionDT = DateTime.Parse(sessionWorkDT);
    }

    if (sessionTodayDT != null)
    {
        todayDT = DateTime.Parse(sessionTodayDT);
    }

    string TodayMesssage = $"오늘은 {@BulletinBoard.Common.SharedComm.GetTodayStringKor()} 입니다.";
    string MissionMesssage = $"{missionDT.Month}월{missionDT.Day}일자 미션을 보고 계시네요.";

}
@if (missionDT.ToString("yyyy-MM-dd") != todayDT.ToString("yyyy-MM-dd"))
{
    <div class="button no-select" style="display: flex; justify-content: center; align-items: center; background-color: #9e1a20; ">
        <div style="text-align:center">
            <h4 style="text-align:center;">알려드려요~</h4>
            <h4 style="text-align:center">@TodayMesssage</h4>
            <h4 style="text-align:center">@MissionMesssage</h4>
        </div>
    </div>
}
 