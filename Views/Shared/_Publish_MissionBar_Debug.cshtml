@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService


@model string

@if (await AuthService.IsSignedIn(User) && await AuthService.IsInRole(await AuthService.GetSignedUser(User), nameof(Roles.SuperAdmin)))
{
    <div class="button no-select" style="display: flex; padding: 10px;
    margin: 10px;justify-content: center; align-items: center; background-color: #9e1a20; ">
        <div style="text-align:center">
            <h4 style="text-align:center;color:white;font-size: 14px;">@Model</h4>
        </div>
    </div>

}

