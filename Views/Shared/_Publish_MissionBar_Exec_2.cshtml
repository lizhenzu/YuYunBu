@model BulletinBoard.Models.MissionBar
 


<div class="mission-card  no-select">
    <img src="/images/ICON/doExec/doMission03.webp" alt="Mission Icon">
    <div class="mission-text">
        <div class="mission-title" style="text-align:center;">미션 수행</div>
        <div class="mission-desc" style="text-align:center;">@Model.MissionText <span style="font-weight:bold; color:#990000;">(@Model.MissionLangDec)</span> 수행하기</div>
    </div>
    <span class="mission-status pending" onclick="redirectToPage('@Model.MissionURL')">이동</span>
</div>
