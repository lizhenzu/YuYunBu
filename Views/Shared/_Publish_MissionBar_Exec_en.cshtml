@model BulletinBoard.Models.MissionBar
 


<div class="mission-card  no-select">
    <img src="/images/ICON/doExec/doMission03.webp" alt="Mission Icon">
    <div class="mission-text">
        <div class="mission-title" style="text-align:center;color:#006633">미션 수행(영어)</div>
        <div class="mission-desc" style="text-align:center;color:#cc0000">오늘의 @Model.MissionText 수행하기</div>
    </div>
    <span class="mission-status pending" onclick="redirectToPage('@Model.MissionURL')">이동</span>
</div>
