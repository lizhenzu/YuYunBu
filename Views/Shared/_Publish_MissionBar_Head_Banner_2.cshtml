@model BulletinBoard.Models.MissionBannerBar

@if (!string.IsNullOrEmpty(Model.MissionText))
{

    <div class="mission-card no-select">
        <div class="mission-text">
            <div class="mission-title" style="text-align:center;">📚 @Model.MissionTitle 📚</div>
            <h3 style="text-align:center;">@Model.MissionText</h3>

            @if (!string.IsNullOrEmpty(Model.BibleSummary))
            {
                <h5>@Model.BibleSummary</h5>
            }

        </div>
    </div>

   @* <div class="button no-select" style="display: flex; justify-content: center; align-items: center; background-color: #FFC1E3; border: 2px solid #4A154B;border-radius: 5px; ">
