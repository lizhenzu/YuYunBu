@using BulletinBoard.Helpers
@model MissionHeaderImageInfo
@{

    var todayDate = DateHelper.GetTodayDateDayString(Model.ImageCount);
    string formattedModResultData = string.Empty;

    if (@Model.Title == "말씀")
    {
        formattedModResultData = $"/images/mission/word/word_{todayDate}.webp";
    }
    else if (@Model.Title == "퀴즈" || @Model.Title == "돌발")
    {
        formattedModResultData = $"/images/mission/quiz/quiz_{todayDate}.webp";
    }
    else if (@Model.Title == "암송")
    {
        formattedModResultData = $"/images/mission/recite/recite_{todayDate}.webp";
    }
    else if (@Model.Title == "기도")
    {
        formattedModResultData = $"/images/mission/pray/pray_{todayDate}.webp";
    }
    else
    {
        formattedModResultData = $"/";
    }
}


<div class="top-image-container">
    <div class="top-label">@Model.Title</div>
    <img src="@formattedModResultData" alt="Top Image" class="top-image">
</div>
