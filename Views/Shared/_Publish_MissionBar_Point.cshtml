@using BulletinBoard.Helpers
@model MissionPointButton

<div class="mission-card no-select">
    <img src="/images/ICON/stamp/stamp08.jpg" alt="Point Icon">
    <div class="mission-text">
        <div class="mission-title" style="text-align:center;">포인트</div>
     
        @if (Model.CountData > 0)
        {
            <div class="mission-desc" style="text-align:center;">포인트 획득 완료 🎖</div>
        }
        else
        {
            @if (Model.MissionButtonLocked == true)
            {
                <div class="mission-desc" style="text-align:center;">미션 수행 불가(@ViewBag.TotalElapseDays)</div>
            }
            else
            {
                <div class="mission-desc" style="text-align:center;">포인트 획득하러 가기</div>
                <div class="mission-desc" style="text-align:center;"><span style="color:orangered; font-weight : bold;">@Model.Title</span> 수행후 이동하세요</div>
            }
        }
    </div>
    @if (Model.CountData > 0)
    {
        <div class="circleCompleted"></div>
    }
    else
    {
        @if (Model.MissionButtonLocked == true)
        {
            <div class="circleLocked"></div>
        }
        else
        {
            <span class="mission-status pending" onclick="clickMission('@Model.FunctionName', this)">이동</span>
        }
    }
</div>
