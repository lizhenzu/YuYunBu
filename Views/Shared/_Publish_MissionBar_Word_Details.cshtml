@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model BulletinBoard.Models.TodayWordToRead

@if (!string.IsNullOrEmpty(Model.BibleText))
{

    <div class="mission-card ">
        <div class="mission-text">
            <div class="mission-title" style="text-align:center;">📚 하나님 말씀 📚</div>
            <h5 style="text-align:center;">@SharedComm.GetTodayToStringKor(Model.ExposeDate)</h5>
            <h3 style="text-align:center;">@Model.BibleSubject</h3>
            <h5 style="text-align:center;">@Model.BibleText @SharedComm.MakeBibleSerialJangZul(Model.BibleText, Model.FromJang, Model.FromZul, Model.ToJang, Model.ToZul)</h5>
            <h5 style="text-align:center; padding-top :20px; ">오늘의 말씀 가이드[하나바이블]</h5>
            @if (!string.IsNullOrEmpty(Model.BibleSummary))
            {
                <p style="color: #43A047; font-size: 16px;">@Model.BibleSummary</p>
            }
            <h5 style="text-align:center;padding-top :20px; font-size: 16px; ">오늘의 말씀 4줄 요약[AI]</h5>
            @if (!string.IsNullOrEmpty(Model.Synopsis))
            {
                <p style="color: #006600; font-size: 16px;">@Model.Synopsis</p>
            }
        </div>
    </div>

   @* <div class="button no-select" style="display: flex; justify-content: center; align-items: center; background-color: #FFC1E3; border: 2px solid #4A154B;border-radius: 5px; ">
        <div style="text-align:center">
            <h5 style="text-align:center;color:#4A154B">@Model.MissionTitle</h5>
            <h3 style="text-align:center;color:#4A154B">@Model.MissionText</h3>
            @if (!string.IsNullOrEmpty(Model.BibleSummary))
            {
                <h5 style="text-align:center;color:#4A154B">@Model.BibleSummary</h5>
            }
        </div>
    </div>*@
}