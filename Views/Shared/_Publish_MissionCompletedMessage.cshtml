@model string 
<div id="mission-completed-note-message" class="modal-popup-background">
    <div class="modal-popup-content">
        <img src="/images/mission/completed-stamp-2.png" alt="Completed Stamp" class="completed-stamp-left">
        <p style="padding-left : 60px; margin-bottom: 40px;"><strong>@Model</strong> 미션 완료를 하셨어요.</p>
