@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@model MissionContents_2
@{
	string backgroundColor = "white";


	@if (@Model.MissionCount > 0)
	{
		backgroundColor = "#F5F5F5";
	}


	int maxLimit = 9;

	var todayDate = DateHelper.GetTodayDateDayString(maxLimit);

	string formattedModResult = $"/images/mission/missioncompletedstamp/rorate/missionCompletedStamp_rotate_{todayDate}.png";

}


<div class="mission-card">
	@if (@Model.MissionCount > 0)
	{
		<div class="quiz-container">
			<img src="@Model.BackGround" alt="Quiz" style="display: block; filter: blur(2.5px);">
			<img style=" border:none; box-shadow: none;width: 120px; height: 120px; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); border: none;"
				 src="@formattedModResult"
			alt="Mission Completed">
		</div>
	}
	else
	{
		<div class="quiz-container">
			<img src="@Model.BackGround" alt="Quiz">
		</div>
	}
	<div class="mission-title">@Model.missionTitle</div>
	<div class="mission-desc">@Model.missionDesc</div>
	@if (@Model.MissionCount > 0)
	{
		<div class="buttonCommon colorBasePaleSilver "  style="padding : 20px;" onclick="location.href='/DailyMission/@Model.MissionURL'">@Model.missionButtonText (다시 보기) </div>
	}
	else
	{
		<div class="buttonCommon  @Model.missionButtonClass " style="padding : 20px;" onclick="location.href='/DailyMission/@Model.MissionURL'">@Model.missionButtonText</div>
	}
</div>

 