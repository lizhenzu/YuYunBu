@model BulletinBoard.Models.TodayCheckCompositeData
@{
	string bonusText = "보너스퀴즈";
}
@if (Model.Total_All < 200 && Model.QuestionCountAddPoint <= 2)
{
	<div class="content" style="text-align:center;background-color: #004d40;color: white; ">
		<h4 style="margin:3px;">알림</h4>
		<hr>
		<h5 style="margin:3px;text-align:left;">
			포인트가 200점 미만이면 "@bonusText"가 자동 출제 됩니다.<br />
			하루에 총 2문제씩 추가 출제가 됩니다.<br />
			아래 "@bonusText" 클릭해서 "@bonusText" 포인트 받아 가세요~
		</h5>
	</div>
}

