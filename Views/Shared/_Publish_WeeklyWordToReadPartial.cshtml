@model BulletinBoard.Models.TodayCollectWeeklyWordToRead

 
<style>

    
    p . boldStmt {
        font-weight: bold;
    }
     

</style>

@if (!string.IsNullOrEmpty(Model.WeeklyWordToReadData.BibleTextToRecite))
{
<form method="post" asp-action="AddWeeklyWordToReadPoint">
        @await Html.PartialAsync("_PublisheBible",Model.WeekeBiblesDataToRecite)
        <input type="hidden" id="Id" name="Id" value="@Model.WeeklyWordToReadData.Id" />

        <div class="body-container">
            @if (@Model.TodayCheckCompositeData.WeeklyWordToReadCount == 0)
            {
                <div class="button-click-division" onclick="sendPostRequest()">암송 하셨으면 여기를 클릭</div>
            }
            
            <div class="button-click-division" onclick="goHome()">Home</div>
        </div>
        <button type="submit" class="pretty-button" id="submitButton" style="display:none;">제출</button>

</form>
}
else
{
    @await Html.PartialAsync("_DisplayMessageBar" ,"오늘은 암송구절이 없습니다.")
}

<script>
    function goHome() {
        window.location.href = "/Home/IndexBranch";
    }
    function sendPostRequest() {
        document.getElementById('submitButton').click(); // submit 버튼 클릭 효과
    }
</script>


@await Html.PartialAsync("_PublisheModalDialogBox")