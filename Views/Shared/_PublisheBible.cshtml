@model BulletinBoard.Models.eBibles

<style>

.container-N17 {
    display: flex; /* Flexbox를 사용하여 자식 요소를 행으로 정렬 */
    justify-content: flex-end; /* 자식 요소를 오른쪽 끝으로 정렬 */
    gap: 5px; /* 자식 요소 사이의 간격 */
    padding-right: 5px; /* 오른쪽에 5px의 패딩을 추가하여 여백 생성 */
    align-items: center; /* 자식 요소들을 세로 중앙에 위치시킵니다 */
}

 
.text-N17 {
    padding-top:15px;
    font-size: 18px; /* 글자 크기 */
    margin-right: auto; /* 나머지 요소를 오른쪽으로 밀어내기 */
    font-weight:bold;
}

.button-click-division-N183123812 {
    width: 130px;
    padding: 3px;
    margin: 3px;
    text-align: center;
    background-color: #3498db;
    color: white;
    font-size: 17px;
    font-weight:bold;
    user-select: none;
    cursor: pointer;
    box-shadow: 3px 3px 5px rgba(0,0,0,0.2);
    transition: all 0.3s ease;
}

        .button-click-division-N183123812:active {
    box-shadow: inset 1px 1px 2px rgba(0,0,0,0.2);
    transform: translateY(4px);
}
</style>

<div class="card">
    <div class="card-body">
        <div class="container-N17">
            <p class="text-N17">@Model.JanZulString</p>
            <button type="button" class="button-click-division-N183123812" onclick="openModialgPopup_N1789('@Html.Raw(@Model.BibleText)', @Model.FromJang , @Model.FromZul , @Model.ToJang , @Model.ToZul)">큰 글자로 보기</button>
        </div>
        @if (!string.IsNullOrEmpty(@Model.BibleText))
        {
            @foreach (eBible va in Model.eBibleDatas)
            {
                <p> @va.zul.@va.BibleData</p>
            }
        }
        @if (@Model.eBibleDatas.Count == 0)
        {
            <p><strong>참고성경</strong></p>
            <ul>
                <li><a href="http://m.holybible.or.kr/mobile/B_RHV/">HolyBible</a></li>
            </ul>
        }

    </div>
</div>
