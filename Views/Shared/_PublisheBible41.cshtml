@model BulletinBoard.Models.eBibles
@{
    int loopCount = 0;
}
<style>

    .text-align-cnter {
        text-align:center;
        margin:10px;
    }

    .text-font-20px-bold {
        font-size: 20px; /* 글자 크기 */
    }
    tr
    {
        padding:15px;
        margin: 5px;
    }
    td { 
        font-size: 20px; /* 글자 크기 */
        vertical-align: top;

    }
    .td-color-A { 
       background-color:#f5f5f5;
    }
    .td-color-B { 
       background-color:#d3d3d3;
    }

</style>


@if (!string.IsNullOrEmpty(@Model.BibleText))
{
        <table>
        @foreach (eBible va in Model.eBibleDatas)
        {
            @if ((loopCount++ % 2) ==0)
            {
                  <tr><td class="td-color-A"> @va.zul.</td><td class="td-color-A">@va.BibleData</td></tr>
            }
            else
            {
                  <tr><td class="td-color-B"> @va.zul.</td><td class="td-color-B">@va.BibleData</td></tr>
            }
        }
        </table>
}
@if (@Model.eBibleDatas.Count == 0)
{
        <p><strong>참고성경</strong></p>
        <ul>
            <li><a href="http://m.holybible.or.kr/mobile/B_RHV/">HolyBible</a></li>
        </ul>
}

