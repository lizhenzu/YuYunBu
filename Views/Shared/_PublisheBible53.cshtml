@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model BulletinBoard.Models.eBibles
 
<div class="content-blank">
 
    @if (!string.Equals(ViewBag.DisableLangTransBtton as string, "y", StringComparison.OrdinalIgnoreCase))
    {
        @await Html.PartialAsync("_PublishSwicthLang")
        @await Html.PartialAsync("_PublishNavigationButton_7", Model)
    }

    @await Html.PartialAsync("_PublisheBible_Title", Model)
    @await Html.PartialAsync("_PublisheBible_OneByOne", Model)

    @if (!string.Equals(ViewBag.DisableLangTransBtton as string, "y", StringComparison.OrdinalIgnoreCase))
    {
        @await Html.PartialAsync("_PublishNavigationButton_7", Model)
    }

</div>
