@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model BulletinBoard.Models.eBibles

<style>

    .bible-card-1 {
        all: unset;
        display: block;
        text-align: center;
        padding: 24px;
        margin: 20px 0;
        box-shadow: 0 0 12px rgba(0, 0, 0, 0.08);
        border-radius: 12px;
        background-color: #ffffff;
        font-family: Arial, sans-serif;
        font-size: 16px;
    }

    .bible-title-1 {
        padding: 3px 0;
        color: #43A047;
        font-weight: bold;
        font-size: 1rem;
        margin: 0;
    }

    .bible-text-1 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 10px 0;
    }

    .bible-ref-1 {
        font-family: initial !important;
        font-size: initial !important;
        color: #555;
        margin-top: 6px;
    }

</style>

<div class="bible-card-1">
    <p class="bible-title-1">하나님 말씀</p>
    <h3 class="bible-text-1">@Model.BibleText</h3>
    <h5 class="bible-ref-1">@Model.JanZulStringOnly</h5>
</div>