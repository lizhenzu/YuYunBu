@inject IAuthService AuthService

@using BulletinBoard.Enums
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Common
@model IEnumerable<BulletinBoard.Models.UploadData>
 
    @foreach (UploadData uploadData in Model)
    { 
        string[] words = uploadData.URLData.Split('.');
        string fileExt = words[words.Length - 1];
        string fileName = words[words.Length - 2];
        string guid = Guid.NewGuid().ToString();
        if (@uploadData.checkData)
        {
            if (fileExt.ToLower() == "jpeg" || fileExt.ToLower() == "jpg" || fileExt.ToLower() == "webp" || fileExt.ToLower() == "gif" || fileExt.ToLower() == "png")
            {
            <img src="@uploadData.URLData" onclick="openImageModal(this.src)" />
            }
        }
    }
 

