@model BulletinBoard.Models.PrayPhrase

<div class="card">
    <div class="card-body">
        <p class="text-font-20px-bold">성품기도</p>
            @if (!string.IsNullOrEmpty(@Model.PrayContent1))
            {
                <p>@BulletinBoard.Helpers.PrayTextHelper.MarkNamesInline(Model.PrayContent1)</p>
            }
            @* PrayContent2 는 자녀가 자기 자신을 위해 드리는 기도문이다.
               화면에는 노출하지 않는다. *@
            @if (!string.IsNullOrEmpty(@Model.PrayContent3))
            {
                <p>@Model.PrayContent3</p>
            }
        <p>@Model.PraryEndMesssage</p>

    </div>
</div>