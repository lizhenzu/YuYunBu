@model string


@{
    DateTime dateValue;
    string newDateString = @ViewBag.WhenDate;

    if (DateTime.TryParse(newDateString, out dateValue))
    {
        // 날짜로 변환된 경우
        newDateString = $"{dateValue.Year}년 {dateValue.Month}월 {dateValue.Day}일"; 
    }

}
<div class="header">
    <h1>퀴즈 관리</h1>
    <h3>@Model</h3>
    <h4>출제일자 : @newDateString</h4>
</div>