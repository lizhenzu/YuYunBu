@model BulletinBoard.Models.QuestionTypeDataObject

<div class="card">
    <div class="card-body">
        <button type="button" class="btn btn-primary" value="시험출제 전 필독" id="loadData" onclick="openPopup('/html/HowToSubmitQuestion.html')">시험출제 전 필독</button>
    </div>
</div>

<div class="form-group">
    <label asp-for="ExposeDate"></label>
    <input type="date" id="ExposeDate" name="ExposeDate" class="form-control" value="@Model.ExposeDate.ToString("yyyy-MM-dd")" />
    <span asp-validation-for="ExposeDate" class="text-danger"></span>
</div>


<div class="form-group">
    <label for="QuestionQ">질문</label>
    <textarea id="QuestionQ" name="QuestionQ" class="form-control" rows="3" autofocus>@Model.QuestionQ</textarea>
    <span asp-validation-for="QuestionQ" class="text-danger"></span>
</div>


<div class="form-group">
    <label for="QuestionQ">질문</label>
    <textarea id="QuestionQ" name="QuestionQ" class="form-control" rows="30" autofocus>@Model.QuestionBackground</textarea>
    <span asp-validation-for="QuestionQ" class="text-danger"></span>
</div>


<div class="form-group">
    <label asp-for="Question1"></label>
    <input asp-for="Question1" class="form-control" autofocus />
    <span asp-validation-for="Question1" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Question2"></label>
    <input asp-for="Question2" class="form-control" autofocus />
    <span asp-validation-for="Question2" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Question3"></label>
    <input asp-for="Question3" class="form-control" autofocus />
    <span asp-validation-for="Question3" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Question4"></label>
    <input asp-for="Question4" class="form-control" autofocus />
    <span asp-validation-for="Question4" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="CorrectAnswer"></label>
    @await Html.PartialAsync("_RadioButtonPartial",Model.CorrectAnswer)
</div>

<input type="hidden" id="QuestionType" name="QuestionType" value="O" /> 
<input type="Hidden" id="Id" name="Id"   value="@Model.Id" />
 

<script>
    function openPopup(url) {
        window.open(url, 'Popup', 'width=600,height=400,left=200,top=200');
    }

</script>
