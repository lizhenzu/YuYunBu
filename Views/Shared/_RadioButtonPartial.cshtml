@model string


<div class="radios-wrapper">
    @for (int i = 1; i <= 4; i++)
    {
        <div class="radio-container">
            <input type="radio" class="radio-button" name="CorrectAnswer" id="@($"option{i}")" value="@i" @(i.ToString() == Model ? "checked" : "")>
            <label for="@($"option{i}")">@i</label>
        </div>
    }
</div>