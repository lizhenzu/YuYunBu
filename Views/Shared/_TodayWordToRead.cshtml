@model BulletinBoard.Models.TodayCollectWordToRead
 

@if (!string.IsNullOrEmpty(@Model.TodayWordToReadData.BibleText))
{
    <form method="post" asp-action="AddTodayWordToReadPoint">
        @await Html.PartialAsync("_PublisheBible",Model.TodayeBiblesData)
        <input type="hidden" id="Id" name="Id" value="@Model.TodayWordToReadData.Id" />

        <div class="body-container">
            @if (@Model.TodayCheckCompositeData.TodayWordToReadCountToMe == 0)
            {
               <div class="button-click-division" onclick="sendPostRequest()">말씀을 읽으셨으면 여기를 클릭</div>
            }
            <div class="button-click-division" onclick="goHome()">Home</div>
        </div>
        <button type="submit" class="pretty-button" id="submitButton" style="display:none;">제출</button>
    </form>
}
else
{
    @await Html.PartialAsync("_DisplayMessageBar" ,"오늘은 매일성경 말씀이 없습니다.")
}
<script>
    function goHome() {
        window.location.href = "/Home/IndexBranch";
    }
    function sendPostRequest() {
        document.getElementById('submitButton').click(); // submit 버튼 클릭 효과
    }
</script>


@await Html.PartialAsync("_PublisheModalDialogBox")