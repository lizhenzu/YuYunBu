@using BulletinBoard.Models
@using BulletinBoard.Common   <!-- VideoKindOption enum -->
@model ShortVideoInput

@{
    ViewData["Title"] = "쇼츠 수정";
}
<h2>@ViewData["Title"]</h2>
<hr />
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ShortId" />

    <div>
        <label asp-for="YoutubeId"></label>
        <input asp-for="YoutubeId" />
        <span asp-validation-for="YoutubeId" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div>
        <input asp-for="IsActive" /> <label asp-for="IsActive"></label>
    </div>

    <!-- ✅ VideoKind 드롭다운 추가 -->
    <div>
        <label asp-for="VideoKind"></label>
        <select asp-for="VideoKind" asp-items="Html.GetEnumSelectList<VideoKindOption>()"></select>
        <span asp-validation-for="VideoKind" class="text-danger"></span>
    </div>

    <div style="margin-top:10px">
        <button type="submit" class="btn btn-primary">저장</button>
        <a asp-action="Index" class="btn">목록</a>
    </div>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
