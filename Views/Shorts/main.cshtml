@using BulletinBoard.Models
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model IEnumerable<ShortVideo>
@{

    Layout = null;
}


<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="color-scheme" content="dark light" />
  <title>영어 체험 공간</title>
  <style>
    :root{
      --bg:#0e0f1a; --card:#14162a; --accent:#6ee7ff; --accent2:#a78bfa; --text:#e5e7eb; --muted:#9ca3af;
      --border: rgba(255,255,255,.10);
      --border-strong: rgba(255,255,255,.18);
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0; font-family: system-ui, -apple-system, Segoe UI, Roboto, "Noto Sans KR", Arial, sans-serif;
      background:
        radial-gradient(1200px 800px at 80% -10%, rgba(103,232,249,.15), transparent 60%),
        radial-gradient(1000px 700px at -10% 110%, rgba(167,139,250,.17), transparent 60%),
        var(--bg);
      color:var(--text);
    }
    .wrap{max-width:1100px; margin:0 auto; padding:28px 18px 56px}
    header{
      display:flex; align-items:center; gap:16px; justify-content:space-between; flex-wrap:wrap;
      margin-bottom:18px;
    }
    .brand{display:flex; gap:14px; align-items:center;}
    .logo{
      width:56px; height:56px; border-radius:16px; display:grid; place-items:center;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color:#0b1220; font-weight:900; box-shadow:0 10px 30px rgba(0,0,0,.35);
      user-select:none;
    }
    h1{margin:0; font-size:28px; line-height:1.2}
    .sub{color:var(--muted); font-size:14px; margin-top:4px}
    .cta{display:flex; gap:10px; flex-wrap:wrap}
    .btn{
      border:1px solid var(--border); background:#111328; color:var(--text);
      padding:10px 14px; border-radius:12px; cursor:pointer; transition:.2s transform,.2s box-shadow,.2s background,.2s border-color;
    }
    .btn:hover{transform:translateY(-2px); box-shadow:0 8px 20px rgba(0,0,0,.25)}
    .btn:focus-visible{outline:3px solid var(--accent); outline-offset:2px}
    .btn.primary{background:linear-gradient(135deg,var(--accent),var(--accent2)); color:#0b1220; font-weight:700}

    .playground{
      background: linear-gradient(180deg, rgba(255,255,255,.05), transparent 40%), var(--card);
      border:1px solid var(--border);
      border-radius:18px; padding:20px; position:relative; overflow:hidden;
    }
    /* 부드러운 떠다니는 장식 */
    .bubble{position:absolute; filter:blur(18px); opacity:.5; animation:float 9s ease-in-out infinite}
    .b1{width:180px;height:180px;background:#6ee7ff22; top:-40px; right:-30px; animation-delay:0s}
    .b2{width:220px;height:220px;background:#a78bfa22; bottom:-60px; left:-40px; animation-delay:1.2s}
    @@keyframes float{ 0%,100%{transform:translateY(0)} 50%{transform:translateY(-14px)} }
    @@media (prefers-reduced-motion: reduce){
      .bubble{animation:none}
      .btn,.card{transition:none}
    }

    .grid{
      display:grid; gap:16px;
      grid-template-columns: repeat(6,1fr);
    }
    @@media (max-width:1080px){ .grid{grid-template-columns: repeat(3,1fr);} }
    @@media (max-width:640px){ .grid{grid-template-columns: repeat(2,1fr);} }
    @@media (max-width:420px){ .grid{grid-template-columns: 1fr;} }

    .card{
      background: linear-gradient(180deg, rgba(255,255,255,.03), transparent 40%), #111328;
      border:1px solid var(--border);
      border-radius:16px; padding:18px; text-decoration:none; color:inherit; display:block;
      min-height:150px; position:relative; overflow:hidden; transition:.18s transform,.18s box-shadow,.18s border-color,.18s background;
    }
    .card:hover{transform:translateY(-4px); border-color:var(--border-strong); box-shadow:0 12px 28px rgba(0,0,0,.32)}
    .card:focus-visible{outline:3px solid var(--accent); outline-offset:2px}
    .tag{
      font-size:12px; color:#0b1220; background:linear-gradient(135deg,var(--accent),var(--accent2));
      display:inline-block; padding:4px 10px; border-radius:999px; font-weight:700;
      box-shadow:0 10px 16px rgba(0,0,0,.25);
    }
    .title{margin:10px 0 4px; font-size:18px; font-weight:800}
    .desc{margin:0; color:var(--muted); font-size:14px}
    .icon{
      position:absolute; right:10px; bottom:8px; font-size:48px; opacity:.9; transform:rotate(4deg);
      filter:drop-shadow(0 6px 10px rgba(0,0,0,.35));
    }
    footer{margin-top:18px; color:var(--muted); font-size:13px}
    .note{margin-top:10px; display:flex; gap:8px; align-items:center; flex-wrap:wrap}
    .note small{opacity:.9}

    /* 작은 화면 타이포/여백 미세 조정 */
    @@media (max-width:480px){
      h1{font-size:22px}
      .logo{width:48px;height:48px}
      .card{min-height:140px}
    }

        .count-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 24px;
            height: 20px;
            padding: 0 6px;
            margin-left: 8px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
            color: #0b1220;
            background: linear-gradient(135deg,var(--accent),var(--accent2));
            box-shadow: 0 8px 16px rgba(0,0,0,.25);
        }
  </style>
</head>


@{
    // 컨트롤러에서 담아준 건수
    var counts = ViewBag.VideoKindCounts as IDictionary<VideoKindOption,int>;
}
@functions{
    int GetCount(VideoKindOption k)
    {
        if (ViewBag.VideoKindCounts is IDictionary<VideoKindOption,int> d && d.TryGetValue(k, out var c))
            return c;
        return 0;
    }
}

<body>
  <div class="wrap">
<header>
  <div class="brand">
    <div class="logo" aria-hidden="true">EN</div>
    <div>
      <h1>영어 체험 공간</h1>
      <div class="sub">아이부터 어른까지, 재미있게 배우는 맞춤형 영어 놀이터</div>
    </div>
  </div>
  <div class="cta">
    <a class="btn" href="/" aria-label="홈으로 이동">🏠 홈으로</a>
    <button class="btn" type="button" onclick="toggleMode()" aria-label="라이트/다크 테마 전환">🌙/☀️ 테마</button>
  </div>
</header>


    <section class="playground" aria-label="메뉴 카드 영역">
      <div class="bubble b1" aria-hidden="true"></div>
      <div class="bubble b2" aria-hidden="true"></div>

      <div class="grid" id="navGrid">
        <!-- 1. 아이 영어 -->
                <a class="card" href="/Shorts/Index?param=Child" aria-label="아이 영어로 이동">
                    <span class="tag">Kids</span>
                    <h3 class="title">
                        어린이 영어
                        <span class="count-badge">@GetCount(VideoKindOption.Child)</span>
                    </h3>
                    <p class="desc">어린이 기초 표현</p>
                    <div class="icon" aria-hidden="true">🧸</div>
                </a>


        <!-- 2. 어른 영어 -->
                <a class="card" href="/Shorts/Index?param=Adult" aria-label="어른 영어로 이동">
                    <span class="tag">Adults</span>
                    <h3 class="title">
                        일반 영어
                        <span class="count-badge">@GetCount(VideoKindOption.Adult)</span>
                    </h3>
                    <p class="desc">일반 실전 회화</p>
                    <div class="icon" aria-hidden="true">🧑‍💼</div>
                </a>


        <!-- 3. 영어 교정 -->
                <a class="card" href="/Shorts/Index?param=KorEnglish" aria-label="영어 교정으로 이동">
                    <span class="tag">Fix</span>
                    <h3 class="title">
                        영어 교정
                        <span class="count-badge">@GetCount(VideoKindOption.KorEnglish)</span>
                    </h3>
                    <p class="desc">콩글리시를 자연스러운 표현으로</p>
                    <div class="icon" aria-hidden="true">🪄</div>
                </a>


        <!-- 4. 생활영어 -->
                <a class="card" href="/Shorts/Index?param=Life" aria-label="생활영어로 이동">
                    <span class="tag">Daily</span>
                    <h3 class="title">
                        짧은 영어
                        <span class="count-badge">@GetCount(VideoKindOption.Life)</span>
                    </h3>
                    <p class="desc">영어 표현 짧게 배우기</p>
                    <div class="icon" aria-hidden="true">☕</div>
                </a>


        <!-- 5. 영어 바른 표현 -->
                <a class="card" href="/Shorts/Index?param=CorrectExpression" aria-label="영어 바른 표현으로 이동">
                    <span class="tag">Better</span>
                    <h3 class="title">
                        영어 바른 표현
                        <span class="count-badge">@GetCount(VideoKindOption.CorrectExpression)</span>
                    </h3>
                    <p class="desc">영어 정확한 표현/점검 </p>
                    <div class="icon" aria-hidden="true">✨</div>
                </a>
                <!-- 4.5 실전영어 -->
                <a class="card" href="/Shorts/Index?param=Practical" aria-label="실전영어로 이동">
                    <span class="tag">Practice</span>
                    <h3 class="title">
                        실전 영어
                        <span class="count-badge">@GetCount(VideoKindOption.Practical)</span>
                    </h3>
                    <p class="desc">상황별 실전 회화</p>
                    <div class="icon" aria-hidden="true">🎯</div>
                </a>
   
      </div>
    </section>

    <footer>
      <div class="note">
        <small>Tip: ...</small>
      </div>
    </footer>
  </div>

  <script>
    // 라이트/다크 테마 토글
    function toggleMode(){
      const dark = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim() === '#0e0f1a';
      if(dark){
        document.documentElement.style.setProperty('--bg','#f7f7fb');
        document.documentElement.style.setProperty('--card','#ffffff');
        document.documentElement.style.setProperty('--text','#0e0f1a');
        document.documentElement.style.setProperty('--muted','#4b5563');
        document.documentElement.style.setProperty('--border','rgba(0,0,0,.12)');
        document.documentElement.style.setProperty('--border-strong','rgba(0,0,0,.22)');
      }else{
        document.documentElement.style.setProperty('--bg','#0e0f1a');
        document.documentElement.style.setProperty('--card','#14162a');
        document.documentElement.style.setProperty('--text','#e5e7eb');
        document.documentElement.style.setProperty('--muted','#9ca3af');
        document.documentElement.style.setProperty('--border','rgba(255,255,255,.10)');
        document.documentElement.style.setProperty('--border-strong','rgba(255,255,255,.18)');
      }
    }

    // 랜덤 카드 오픈
    function surprise(){
      const cards = Array.from(document.querySelectorAll('.grid .card'));
      if(cards.length === 0) return;
      const pick = cards[Math.floor(Math.random()*cards.length)];
      pick.classList.add('pulse');
      setTimeout(()=>{ location.href = pick.getAttribute('href'); }, 260);
    }

    // 작은 펄스 효과
    const style = document.createElement('style');
    style.textContent = `.pulse{transform:scale(1.02) translateY(-4px); box-shadow:0 18px 36px rgba(0,0,0,.35)!important}`;
    document.head.appendChild(style);
  </script>
</body>
</html>
