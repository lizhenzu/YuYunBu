@using BulletinBoard.Common;
@using BulletinBoard.DataAccessLayer;
@using System.Collections.Generic;

@*  ══════════════════════════════════════════════════════════════
    가입 마법사 — 2026-11-08 시안 확정 (DailyMission4 밝은 흰색 · 공용 quiz-bright.css)
    · 역할(학생 · 교사 · 학부모) → 필요한 것만 차례로 → 확인 → 관리자 승인 요청
      학생: (같은 이름 확인) → 학년·반 → 생일·성별 → 학교·부모님 연락처
      교사: (같은 이름 확인) → 연락처
      학부모: 고르면 끝 — 더 입력받지 않고 바로 확인 (2026-11-08 변경)
    · 단계는 화면 안에서만 넘어가고, 마지막에 한 번에 보낸다 (/SignupWizard/Submit)
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
    var fullName = (string)ViewData["FullName"];
    var returnUrl = (string)ViewData["ReturnUrl"];
    var latest = ViewData["Latest"] as SignupApplication;
    var msg = ViewData["Msg"] as string;
    var same = (List<PersonCandidate>)ViewData["Same"];
    var years = (List<int>)ViewData["Years"];
    var bans = (List<int>)ViewData["Bans"];
    bool pending = latest != null && latest.Status == "PENDING";
    bool rejected = latest != null && latest.Status == "REJECTED";
    bool change = ViewData["Change"] is bool cb && cb;          // 정보 관리 › 역할 변경으로 들어옴
    var current = ViewData["Current"] as CurrentRole;
    string curKind = current?.Kind ?? "";                         // S · T · X(임원 등) · ""(역할 없음 = 학부모)
    string Tag(string k) => change && (curKind == k || (k == "P" && curKind == "")) ? "지금 역할" : "";
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>@(change ? "역할 변경" : "가입 마무리")</title>
    <link rel="stylesheet" href="/css/quiz-bright.css" asp-append-version="true">
    <style>
        body { margin: 0; background: #FFFFFF; }
        .sw-step { display: none; }
        .sw-step.on { display: block; }
        .sw-dots { display: flex; gap: 4px; margin: 10px 0 14px; }
        .sw-dots i { flex: 1; height: 4px; border-radius: 2px; background: #E5E8EE; }
        .sw-dots i.on { background: #2F7BF5; }
        .sw-opt { display: block; width: 100%; text-align: left; padding: 14px 16px; margin-bottom: 8px; border: 1px solid #E1E5EB; border-radius: 12px; background: #fff; font: inherit; cursor: pointer; }
        .sw-opt b { font-size: 16px; }
        .sw-opt small { margin-left: 6px; color: #8A93A0; font-size: 12.5px; }
        .sw-opt.on { border: 2px solid #2F7BF5; background: #EAF2FD; }
        .sw-opt.off { opacity: .5; cursor: not-allowed; }
        .sw-f { margin-bottom: 12px; }
        .sw-f label { display: block; font-size: 12.5px; color: #6B7684; margin-bottom: 4px; }
        .sw-f input, .sw-f select { width: 100%; box-sizing: border-box; height: 44px; border: 1px solid #D9DEE6; border-radius: 10px; padding: 0 10px; font: inherit; font-size: 15px; background: #fff; }
        .sw-row { display: flex; gap: 6px; }
        .sw-row > * { flex: 1; min-width: 0; }
        .sw-sex { display: flex; gap: 8px; }
        .sw-sex button { flex: 1; height: 44px; border-radius: 10px; border: 1px solid #D9DEE6; background: #fff; font: inherit; font-size: 15px; }
        .sw-sex button.on { border: 2px solid #2F7BF5; background: #EAF2FD; color: #2F7BF5; font-weight: 700; }
        .sw-sum { padding: 12px 14px; background: #F5F7FA; border-radius: 12px; font-size: 14px; line-height: 1.8; margin-bottom: 8px; }
        .sw-note { font-size: 12.5px; color: #6B7684; }
        .sw-err { min-height: 18px; font-size: 13px; color: #D13B3B; margin: 6px 0; }
        .sw-nav { display: flex; gap: 8px; }
        .sw-nav button { flex: 1; height: 46px; border-radius: 12px; border: 1px solid #D9DEE6; background: #fff; font: inherit; font-size: 15px; font-weight: 700; }
        .sw-nav button.p { flex: 1.6; background: #2F7BF5; border-color: #2F7BF5; color: #fff; }
        .sw-wait { margin: 12px 0; padding: 14px; border-radius: 12px; background: #FFF4E0; color: #9A5B00; font-size: 14px; line-height: 1.7; }
        .sw-rej { margin: 12px 0; padding: 12px 14px; border-radius: 12px; background: #FDEEEE; color: #B03030; font-size: 13.5px; }
        .sw-msg { margin: 12px 0; padding: 10px 12px; border-radius: 10px; background: #EAF2FD; color: #2F7BF5; font-size: 13px; }
    </style>
</head>
<body>
<div class="qb">

    <div class="qb-top">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span>가입 마무리</span>
        <span>WELCOME</span>
    </div>

    @if (pending)
    {
        <div class="qb-k">WAITING</div>
        <h1 class="qb-h1">@(latest!.IsChange ? "역할 변경을 요청했어요" : "승인을 요청했어요")</h1>
        @if (latest.IsChange && !string.IsNullOrEmpty(latest.PrevRole)) { <div class="qb-sub">@latest.PrevRole → @latest.RoleLabel</div> }
        <div class="sw-wait">
            관리자 확인을 기다리는 중이에요 (@latest!.InsertDT.ToString("M월 d일")).<br />
            그 전에도 미션은 바로 할 수 있어요. 승인되면 쪽지로 알려 드려요.
        </div>
        <div class="sw-sum">
            <b>@latest.RoleLabel</b> · @latest.FullName<br />
            @if (latest.RoleKind == "S")
            {
                @(latest.ClassYear > 0 ? $"{latest.ClassYear}학년 {latest.ClassBan}반" : "반은 관리자가 정해요")<br />
                @($"{latest.BMonth}월 {latest.BDay}일 · {(latest.Sex == "M" ? "남" : "여")}")<br />
                @(string.IsNullOrEmpty(latest.School) ? "" : latest.School + " · ")<text>부모님 @latest.Phone</text>
            }
            else if (latest.RoleKind == "P")
            {
                <text>더 입력한 정보는 없어요.</text>
            }
            else
            {
                <text>연락처 @latest.Phone</text>
            }
        </div>
        <div class="qb-btns"><a class="qb-btn p" href="@returnUrl">@ConstatsCommon.ToHome</a></div>
    }
    else
    {
        @if (rejected) { <div class="sw-rej">@(latest!.IsChange ? "역할 변경" : "가입 승인") 요청이 반려됐어요.@if (!string.IsNullOrEmpty(latest!.RejectReason)) { <br /><b>사유: @latest.RejectReason</b> }<br />내용을 고쳐서 다시 보내 주세요.</div> }
        @if (!string.IsNullOrEmpty(msg)) { <div class="sw-msg">@msg</div> }

        <form method="post" action="/SignupWizard/Submit" id="swForm" onsubmit="return false;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <input type="hidden" name="role" id="fRole" />
            <input type="hidden" name="personId" id="fPerson" value="0" />
            <input type="hidden" name="sex" id="fSex" />
            <input type="hidden" name="change" value="@(change ? "true" : "false")" />

            @* 1) 역할 *@
            <div class="sw-step" data-k="role">
                <div class="qb-k">@(change ? "역할 변경" : "STEP 1")</div>
                <h1 class="qb-h1">@(change ? "어떤 역할로 바꿀까요?" : "어떤 분이세요?")</h1>
                <div class="sw-dots"></div>
                @if (change)
                {
                    <div class="qb-sub">@fullName 님의 지금 역할은 <b>@current?.Label</b>이에요. 바꿀 역할을 고르면 필요한 것만 다시 물어볼게요. 관리자가 승인하면 바뀌어요.</div>
                }
                else
                {
                    <div class="qb-sub">@fullName 님, 고르면 필요한 것만 차례로 물어볼게요.</div>
                }
                <button type="button" class="sw-opt" data-role="S"><b>학생</b><small>유년부 어린이 @Tag("S")</small></button>
                <button type="button" class="sw-opt" data-role="T"><b>교사</b><small>선생님 @Tag("T")</small></button>
                <button type="button" class="sw-opt" data-role="P"><b>학부모</b><small>어린이의 부모님 @Tag("P")</small></button>
            </div>

            @* 2) 같은 이름 확인 (학생 · 교사, 같은 이름이 있을 때만) *@
            <div class="sw-step" data-k="same">
                <div class="qb-k">확인</div>
                <h1 class="qb-h1">같은 이름이 있어요</h1>
                <div class="sw-dots"></div>
                <div class="qb-sub">@fullName 님과 같은 이름이 있어요. 나인지 골라 주세요.</div>
                @foreach (var p in same)
                {
                    bool linked = !string.IsNullOrEmpty(p.UserName);
                    string cls = p.ClassYear > 0 && p.ClassBan > 0 ? $"{p.ClassYear}학년 {p.ClassBan}반" : "반 정보 없음";
                    <button type="button" class="sw-opt @(linked ? "off" : "")" data-person="@p.PersonId" disabled="@linked">
                        <b>@p.FullName · @cls</b><small>@(linked ? "이미 다른 계정과 연결됨" : "이 사람이 저예요")</small>
                    </button>
                }
                <button type="button" class="sw-opt" data-person="0"><b>위 사람들과 달라요</b><small>동명이인 — 새로 등록</small></button>
            </div>

            @* 3) 학생: 학년 · 반 *@
            <div class="sw-step" data-k="cls">
                <div class="qb-k">학생 · 반</div>
                <h1 class="qb-h1">몇 학년 몇 반이에요?</h1>
                <div class="sw-dots"></div>
                <div class="sw-f"><label>학년</label>
                    <select name="classYear" id="fYear"><option value="">골라 주세요</option>@foreach (var y in years) { <option value="@y">@(y)학년</option> }<option value="0">잘 모르겠어요</option></select>
                </div>
                <div class="sw-f"><label>반</label>
                    <select name="classBan" id="fBan"><option value="">골라 주세요</option>@foreach (var b in bans) { <option value="@b">@(b)반</option> }<option value="0">잘 모르겠어요</option></select>
                </div>
                <div class="sw-note">모르면 "잘 모르겠어요"를 고르세요. 관리자가 정해 드려요.</div>
            </div>

            @* 4) 학생: 생일 · 성별 *@
            <div class="sw-step" data-k="birth">
                <div class="qb-k">학생 · 생일</div>
                <h1 class="qb-h1">생일과 성별을 알려 주세요</h1>
                <div class="sw-dots"></div>
                <div class="sw-f"><label>생일</label>
                    <div class="sw-row">
                        <select name="bMonth" id="fMonth"><option value="">월</option>@for (int m = 1; m <= 12; m++) { <option value="@m">@(m)월</option> }</select>
                        <select name="bDay" id="fDay"><option value="">일</option>@for (int d = 1; d <= 31; d++) { <option value="@d">@(d)일</option> }</select>
                    </div>
                </div>
                <div class="sw-f"><label>성별</label>
                    <div class="sw-sex"><button type="button" data-sex="M">남</button><button type="button" data-sex="F">여</button></div>
                </div>
            </div>

            @* 5) 학생: 학교 · 부모님 연락처 *@
            <div class="sw-step" data-k="etc">
                <div class="qb-k">학생 · 연락</div>
                <h1 class="qb-h1">학교와 부모님 연락처</h1>
                <div class="sw-dots"></div>
                <div class="sw-f"><label>학교 (선택)</label><input name="school" id="fSchool" maxlength="100" placeholder="○○초등학교" /></div>
                <div class="sw-f"><label>부모님 연락처</label><input name="phone" id="fPhoneS" inputmode="tel" maxlength="20" placeholder="010-0000-0000" /></div>
            </div>

            @* 교사: 연락처 *@
            <div class="sw-step" data-k="tel">
                <div class="qb-k">교사</div>
                <h1 class="qb-h1">연락처를 알려 주세요</h1>
                <div class="sw-dots"></div>
                <div class="sw-f"><label>연락처</label><input name="phone" id="fPhoneT" inputmode="tel" maxlength="20" placeholder="010-0000-0000" /></div>
            </div>

            @* 학부모는 고르면 끝 — 더 입력받지 않고 바로 확인으로 (2026-11-08 결정) *@

            @* 마지막: 확인 *@
            <div class="sw-step" data-k="sum">
                <div class="qb-k">마지막</div>
                <h1 class="qb-h1">이대로 승인을 요청할까요?</h1>
                <div class="sw-dots"></div>
                <div class="sw-sum" id="sumBox"></div>
                <div class="sw-note">관리자가 확인하면 반영돼요. 그 전에도 미션은 바로 할 수 있어요.</div>
            </div>

            <div class="sw-err" id="swErr"></div>
            <div class="sw-nav">
                <button type="button" id="swPrev">이전</button>
                <button type="button" class="p" id="swNext">다음</button>
            </div>
        </form>

    }

    <div class="qb-ft">
        <span>가입 마무리</span>
        <span><a href="/">@ConstatsCommon.ToHome</a></span>
    </div>
</div>

@if (!pending)
{
<script>
(function () {
    var hasSame = @(same.Count > 0 ? "true" : "false");
    var form = document.getElementById('swForm');
    var stepsEl = {}; form.querySelectorAll('.sw-step').forEach(function (s) { stepsEl[s.dataset.k] = s; });
    var role = '', idx = 0, personPicked = false;
    var $ = function (id) { return document.getElementById(id); };
    var err = $('swErr');

    function flow() {
        if (role === 'S') return ['role'].concat(hasSame ? ['same'] : []).concat(['cls', 'birth', 'etc', 'sum']);
        if (role === 'T') return ['role'].concat(hasSame ? ['same'] : []).concat(['tel', 'sum']);
        if (role === 'P') return ['role', 'sum'];
        return ['role'];
    }
    function show() {
        var f = flow(), k = f[idx];
        Object.keys(stepsEl).forEach(function (x) { stepsEl[x].classList.toggle('on', x === k); });
        stepsEl[k].querySelector('.sw-dots').innerHTML = f.map(function (_, i) { return '<i class="' + (i <= idx ? 'on' : '') + '"></i>'; }).join('');
        $('swPrev').style.display = idx > 0 ? '' : 'none';
        $('swNext').textContent = k === 'sum' ? '승인 요청 보내기' : '다음';
        if (k === 'sum') $('sumBox').innerHTML = summary();
        err.textContent = '';
        window.scrollTo(0, 0);
    }
    function txt(id) { var e = $(id); return e ? e.value.trim() : ''; }
    function selText(id) { var e = $(id); return e && e.selectedIndex >= 0 ? e.options[e.selectedIndex].text : ''; }
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function summary() {
        if (role === 'S') {
            var cls = ($('fYear').value === '0' || $('fBan').value === '0') ? '반은 관리자가 정해요' : selText('fYear') + ' ' + selText('fBan');
            return '<b>학생</b><br>' + esc(cls) + '<br>' + esc(selText('fMonth') + ' ' + selText('fDay')) + ' · ' + ($('fSex').value === 'M' ? '남' : '여')
                + '<br>' + (txt('fSchool') ? esc(txt('fSchool')) + ' · ' : '') + '부모님 ' + esc(txt('fPhoneS'));
        }
        if (role === 'T') return '<b>교사</b><br>연락처 ' + esc(txt('fPhoneT'));
        return '<b>학부모</b><br>더 입력할 것은 없어요.';
    }
    function check(k) {
        if (k === 'role' && !role) return '역할을 골라 주세요';
        if (k === 'same' && !personPicked) return '나인지 골라 주세요';
        if (k === 'cls' && ($('fYear').value === '' || $('fBan').value === '')) return '학년과 반을 골라 주세요 (모르면 "잘 모르겠어요")';
        if (k === 'birth' && (!$('fMonth').value || !$('fDay').value)) return '생일을 골라 주세요';
        if (k === 'birth' && !$('fSex').value) return '성별을 골라 주세요';
        if (k === 'etc' && !txt('fPhoneS')) return '부모님 연락처를 적어 주세요';
        if (k === 'tel' && !txt('fPhoneT')) return '연락처를 적어 주세요';
        return '';
    }
    function send() {
        // 고른 역할의 연락처 칸만 보낸다
        ['fPhoneS', 'fPhoneT'].forEach(function (id) { $(id).disabled = !((role === 'S' && id === 'fPhoneS') || (role === 'T' && id === 'fPhoneT')); });
        if (role !== 'S') { ['fYear', 'fBan', 'fMonth', 'fDay'].forEach(function (id) { $(id).value = '0'; }); }
        if (role === 'P') $('fPerson').value = '0';
        $('swNext').disabled = true;
        form.onsubmit = null; form.submit();
    }

    form.querySelectorAll('[data-role]').forEach(function (b) {
        b.addEventListener('click', function () {
            role = b.dataset.role; $('fRole').value = role;
            form.querySelectorAll('[data-role]').forEach(function (x) { x.classList.toggle('on', x === b); });
            err.textContent = '';
        });
    });
    form.querySelectorAll('[data-person]').forEach(function (b) {
        b.addEventListener('click', function () {
            if (b.disabled) return;
            $('fPerson').value = b.dataset.person; personPicked = true;
            form.querySelectorAll('[data-person]').forEach(function (x) { x.classList.toggle('on', x === b); });
            err.textContent = '';
        });
    });
    form.querySelectorAll('[data-sex]').forEach(function (b) {
        b.addEventListener('click', function () {
            $('fSex').value = b.dataset.sex;
            form.querySelectorAll('[data-sex]').forEach(function (x) { x.classList.toggle('on', x === b); });
        });
    });

    $('swPrev').addEventListener('click', function () { if (idx > 0) { idx--; show(); } });
    $('swNext').addEventListener('click', function () {
        var f = flow(), k = f[idx], m = check(k);
        if (m) { err.textContent = m; return; }
        if (k === 'sum') { send(); return; }
        idx++; show();
    });
    show();
})();
</script>
}
</body>
</html>
