@using BulletinBoard.Common;
@using BulletinBoard.DataAccessLayer;
@using System.Collections.Generic;

@*  ══════════════════════════════════════════════════════════════
    가입 마법사 — 2026-11-08 시안 확정 (DailyMission4 밝은 흰색 · 공용 quiz-bright.css)
    · 역할(학생 · 교사 · 학부모) → 필요한 것만 차례로 → 확인 → 관리자 승인 요청
      학생: (같은 이름 확인) → [역할만 정하고 끝내기 | 더 입력하기 → 학년·반 → 생일·성별 → 학교·부모님 연락처]
      교사: (같은 이름 확인) → [역할만 정하고 끝내기 | 더 입력하기 → 연락처]
      연락처는 어디서나 필수가 아니다 (2026-11-08)
      학부모: 고르면 끝 — 더 입력받지 않고 바로 확인 (2026-11-08 변경)
    · 단계는 화면 안에서만 넘어가고, 마지막에 한 번에 보낸다 (/SignupWizard/Submit)
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
    var fullName = (string)ViewData["FullName"];
    var returnUrl = (string)ViewData["ReturnUrl"];
    var latest = ViewData["Latest"] as SignupApplication;
    var msg = ViewData["Msg"] as string;
    var same = (List<PersonCandidate>)ViewData["Same"];
    var years = (List<int>)ViewData["Years"];
    var bans = (List<int>)ViewData["Bans"];
    bool pending = latest != null && latest.Status == "PENDING";
    bool rejected = latest != null && latest.Status == "REJECTED";
    bool change = ViewData["Change"] is bool cb && cb;          // 정보 관리 › 역할 변경으로 들어옴
    var current = ViewData["Current"] as CurrentRole;
    string curKind = current?.Kind ?? "";                         // S · T · X(임원 등) · ""(역할 없음 = 학부모)
    string Tag(string k) => change && (curKind == k || (k == "P" && curKind == "")) ? "지금 역할" : "";

    // 신청 내용 한 줄 — 비어 있는 값은 빼고 보여 준다 (역할만 정한 신청이면 "더 입력한 정보 없음")
    string SignupDetailText(SignupApplication a)
    {
        var parts = new List<string>();
        if (a.RoleKind == "S")
        {
            if (a.ClassYear > 0 && a.ClassBan > 0) parts.Add($"{a.ClassYear}학년 {a.ClassBan}반");
            if (a.BMonth > 0 && a.BDay > 0) parts.Add($"{a.BMonth}월 {a.BDay}일");
            if (a.Sex == "M" || a.Sex == "F") parts.Add(a.Sex == "M" ? "남" : "여");
            if (!string.IsNullOrEmpty(a.School)) parts.Add(a.School);
            if (!string.IsNullOrEmpty(a.Phone)) parts.Add("부모님 " + a.Phone);
        }
        else if (a.RoleKind == "T" && !string.IsNullOrEmpty(a.Phone)) parts.Add("연락처 " + a.Phone);
        return parts.Count == 0 ? "더 입력한 정보는 없어요." : string.Join(" · ", parts);
    }
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>@(change ? "역할 변경" : "가입 마무리")</title>
    <link rel="stylesheet" href="/css/quiz-bright.css" asp-append-version="true">
    <style>
        body { margin: 0; background: #FFFFFF; }
        .sw-step { display: none; }
        .sw-step.on { display: block; }
        .sw-dots { display: flex; gap: 4px; margin: 10px 0 14px; }
        .sw-dots i { flex: 1; height: 4px; border-radius: 2px; background: #E5E8EE; }
        .sw-dots i.on { background: #2F7BF5; }
        .sw-opt { display: block; width: 100%; text-align: left; padding: 14px 16px; margin-bottom: 8px; border: 1px solid #E1E5EB; border-radius: 12px; background: #fff; font: inherit; cursor: pointer; }
        .sw-opt b { font-size: 16px; }
        .sw-opt small { margin-left: 6px; color: #8A93A0; font-size: 12.5px; }
        .sw-opt.on { border: 2px solid #2F7BF5; background: #EAF2FD; }
        .sw-opt.off { opacity: .5; cursor: not-allowed; }
        .sw-f { margin-bottom: 12px; }
        .sw-f label { display: block; font-size: 12.5px; color: #6B7684; margin-bottom: 4px; }
        .sw-f input, .sw-f select { width: 100%; box-sizing: border-box; height: 44px; border: 1px solid #D9DEE6; border-radius: 10px; padding: 0 10px; font: inherit; font-size: 15px; background: #fff; }
        .sw-row { display: flex; gap: 6px; }
        .sw-row > * { flex: 1; min-width: 0; }
        .sw-sex { display: flex; gap: 8px; }
        .sw-sex button { flex: 1; height: 44px; border-radius: 10px; border: 1px solid #D9DEE6; background: #fff; font: inherit; font-size: 15px; }
        .sw-sex button.on { border: 2px solid #2F7BF5; background: #EAF2FD; color: #2F7BF5; font-weight: 700; }
        .sw-sum { padding: 12px 14px; background: #F5F7FA; border-radius: 12px; font-size: 14px; line-height: 1.8; margin-bottom: 8px; }
        .sw-note { font-size: 12.5px; color: #6B7684; }
        .sw-err { min-height: 18px; font-size: 13px; color: #D13B3B; margin: 6px 0; }
        .sw-nav { display: flex; gap: 8px; }
        .sw-nav button { flex: 1; height: 46px; border-radius: 12px; border: 1px solid #D9DEE6; background: #fff; font: inherit; font-size: 15px; font-weight: 700; }
        .sw-nav button.p { flex: 1.6; background: #2F7BF5; border-color: #2F7BF5; color: #fff; }
        /* 승인 대기 화면 (A안) */
        .sw-wtop { font-size: 13px; font-weight: 700; color: #374151; padding-bottom: 12px; border-bottom: 1px solid #EEF0F3; }
        .sw-wic { width: 72px; height: 72px; border-radius: 50%; background: #FFF4E0; display: flex; align-items: center; justify-content: center; font-size: 34px; margin: 26px auto 0; }
        .sw-wh { margin: 14px 0 0; font-size: 24px; font-weight: 800; letter-spacing: -.02em; text-align: center; color: #111827; }
        .sw-wsub { margin-top: 6px; text-align: center; font-size: 14px; color: #6B7280; line-height: 1.6; }
        .sw-chg { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 14px; font-size: 14px; color: #6B7280; }
        .sw-chg .pill { padding: 5px 12px; border-radius: 999px; background: #F4F6F9; color: #6B7280; font-weight: 700; }
        .sw-chg .pill.n { background: #EAF2FD; color: #2F7BF5; }
        .sw-steps { display: flex; margin: 24px 4px 0; }
        .sw-steps .st { flex: 1; text-align: center; font-size: 12.5px; color: #9AA3AF; position: relative; }
        .sw-steps .st i { display: block; width: 26px; height: 26px; border-radius: 50%; margin: 0 auto 6px; background: #E5E8EE; color: #fff; font-style: normal; font-weight: 800; line-height: 26px; font-size: 13px; position: relative; z-index: 1; }
        .sw-steps .st::before { content: ""; position: absolute; top: 12px; left: -50%; width: 100%; height: 3px; background: #E5E8EE; }
        .sw-steps .st:first-child::before { display: none; }
        .sw-steps .st.done { color: #2F7BF5; font-weight: 700; }
        .sw-steps .st.done i, .sw-steps .st.done::before, .sw-steps .st.now::before { background: #2F7BF5; }
        .sw-steps .st.now { color: #8A5300; font-weight: 700; }
        .sw-steps .st.now i { background: #F59E0B; }
        .sw-card { margin-top: 22px; background: #F5F7FA; border-radius: 16px; padding: 12px 16px; }
        .sw-card .row { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; font-size: 14px; }
        .sw-card .row + .row { border-top: 1px solid #E8EBF0; }
        .sw-card .row span { color: #8A93A0; white-space: nowrap; }
        .sw-card .row b { font-weight: 700; text-align: right; word-break: keep-all; }
        .sw-wnote { margin-top: 14px; text-align: center; font-size: 13px; color: #6B7280; }
        /* quiz-bright.css 의 ".qb a { color: inherit }" 가 더 강해 글자가 검게 보이던 것 — 같은 무게(.qb a.sw-home)로 흰 글자를 지킨다 */
        .qb a.sw-home { display: block; width: 100%; box-sizing: border-box; margin-top: 18px; padding: 16px 0; border-radius: 16px; background: #2F7BF5; color: #fff; text-align: center; font-size: 17px; font-weight: 800; text-decoration: none; }
        .qb a.sw-home:visited, .qb a.sw-home:hover, .qb a.sw-home:active { color: #fff; }
        .sw-rej { margin: 12px 0; padding: 12px 14px; border-radius: 12px; background: #FDEEEE; color: #B03030; font-size: 13.5px; }
        .sw-msg { margin: 12px 0; padding: 10px 12px; border-radius: 10px; background: #EAF2FD; color: #2F7BF5; font-size: 13px; }
    </style>
</head>
<body>
<div class="qb">

    @if (pending)
    {
        @* 승인 대기 화면 — 2026-11-08 A안: 가운데 정렬 · 진행 3단계 · 요약 카드 · "홈으로"는 아래 큰 버튼 하나만 *@
        string prevPill = string.IsNullOrEmpty(latest!.PrevRole) ? "" : (latest.PrevRole.StartsWith("역할 없음") ? "학부모" : latest.PrevRole);
        <div class="sw-wtop">@(latest.IsChange ? "역할 변경" : "가입 마무리")</div>
        <div class="sw-wic" aria-hidden="true">&#9203;</div>
        <h1 class="sw-wh">@(latest.IsChange ? "역할 변경을 요청했어요" : "승인을 요청했어요")</h1>
        <div class="sw-wsub">관리자가 확인하면 @(latest.IsChange ? "바뀌어요" : "역할이 정해져요").<br />그 전에도 미션은 바로 할 수 있어요.</div>
        <div class="sw-chg">
            @if (latest.IsChange && prevPill.Length > 0) { <span class="pill">@prevPill</span><span>→</span> }
            else if (!latest.IsChange) { <span class="pill">새 가입</span><span>→</span> }
            <span class="pill n">@latest.RoleLabel</span>
        </div>

        <div class="sw-steps">
            <div class="st done"><i>&#10003;</i>요청 보냄</div>
            <div class="st now"><i>2</i>관리자 확인</div>
            <div class="st"><i>3</i>완료</div>
        </div>

        <div class="sw-card">
            <div class="row"><span>이름</span><b>@latest.FullName</b></div>
            <div class="row"><span>요청 날짜</span><b>@latest.InsertDT.ToString("M월 d일")</b></div>
            @* 입력한 값은 항목마다 한 줄씩 (학생: 반 · 생일 · 성별 · 학교 · 부모님 연락처 / 교사: 연락처). 비어 있으면 "없음 (역할만)" *@
            @{
                bool anyDetail = false;
            }
            @if (latest.RoleKind == "S")
            {
                if (latest.ClassYear > 0 && latest.ClassBan > 0) { anyDetail = true; <div class="row"><span>학년 · 반</span><b>@($"{latest.ClassYear}학년 {latest.ClassBan}반")</b></div> }
                else if (latest.BMonth > 0) { <div class="row"><span>학년 · 반</span><b>관리자가 정해요</b></div> }
                if (latest.BMonth > 0 && latest.BDay > 0) { anyDetail = true; <div class="row"><span>생일</span><b>@($"{latest.BMonth}월 {latest.BDay}일")</b></div> }
                if (latest.Sex == "M" || latest.Sex == "F") { anyDetail = true; <div class="row"><span>성별</span><b>@(latest.Sex == "M" ? "남" : "여")</b></div> }
                if (!string.IsNullOrEmpty(latest.School)) { anyDetail = true; <div class="row"><span>학교</span><b>@latest.School</b></div> }
                if (!string.IsNullOrEmpty(latest.Phone)) { anyDetail = true; <div class="row"><span>부모님 연락처</span><b>@latest.Phone</b></div> }
            }
            else if (latest.RoleKind == "T" && !string.IsNullOrEmpty(latest.Phone))
            {
                anyDetail = true;
                <div class="row"><span>연락처</span><b>@latest.Phone</b></div>
            }
            @if (!anyDetail)
            {
                <div class="row"><span>입력한 정보</span><b>없음 (역할만)</b></div>
            }
        </div>
        <div class="sw-wnote">승인되면 쪽지로 알려 드려요.</div>
        <a class="sw-home" href="@returnUrl">@ConstatsCommon.ToHome</a>
    }
    else
    {
        <div class="qb-top">
            <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span>@(change ? "역할 변경" : "가입 마무리")</span>
            <span>WELCOME</span>
        </div>

        @if (rejected) { <div class="sw-rej">@(latest!.IsChange ? "역할 변경" : "가입 승인") 요청이 반려됐어요.@if (!string.IsNullOrEmpty(latest!.RejectReason)) { <br /><b>사유: @latest.RejectReason</b> }<br />내용을 고쳐서 다시 보내 주세요.</div> }
        @if (!string.IsNullOrEmpty(msg)) { <div class="sw-msg">@msg</div> }

        <form method="post" action="/SignupWizard/Submit" id="swForm" onsubmit="return false;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <input type="hidden" name="role" id="fRole" />
            <input type="hidden" name="personId" id="fPerson" value="0" />
            <input type="hidden" name="sex" id="fSex" />
            <input type="hidden" name="change" value="@(change ? "true" : "false")" />
            <input type="hidden" name="detail" id="fDetail" value="false" />

            @* 1) 역할 *@
            <div class="sw-step" data-k="role">
                <div class="qb-k">@(change ? "역할 변경" : "STEP 1")</div>
                <h1 class="qb-h1">@(change ? "어떤 역할로 바꿀까요?" : "어떤 분이세요?")</h1>
                <div class="sw-dots"></div>
                @if (change)
                {
                    <div class="qb-sub">@fullName 님의 지금 역할은 <b>@current?.Label</b>이에요. 바꿀 역할을 고르면 필요한 것만 다시 물어볼게요. 관리자가 승인하면 바뀌어요.</div>
                }
                else
                {
                    <div class="qb-sub">@fullName 님, 고르면 필요한 것만 차례로 물어볼게요.</div>
                }
                <button type="button" class="sw-opt" data-role="S"><b>학생</b><small>유년부 어린이 @Tag("S")</small></button>
                <button type="button" class="sw-opt" data-role="T"><b>교사</b><small>선생님 @Tag("T")</small></button>
                <button type="button" class="sw-opt" data-role="P"><b>학부모</b><small>어린이의 부모님 @Tag("P")</small></button>
            </div>

            @* 2) 같은 이름 확인 (학생 · 교사, 같은 이름이 있을 때만) *@
            <div class="sw-step" data-k="same">
                <div class="qb-k">확인</div>
                <h1 class="qb-h1">같은 이름이 있어요</h1>
                <div class="sw-dots"></div>
                <div class="qb-sub">@fullName 님과 같은 이름이 있어요. 나인지 골라 주세요.</div>
                @foreach (var p in same)
                {
                    bool linked = !string.IsNullOrEmpty(p.UserName);
                    string cls = p.ClassYear > 0 && p.ClassBan > 0 ? $"{p.ClassYear}학년 {p.ClassBan}반" : "반 정보 없음";
                    <button type="button" class="sw-opt @(linked ? "off" : "")" data-person="@p.PersonId" disabled="@linked">
                        <b>@p.FullName · @cls</b><small>@(linked ? "이미 다른 계정과 연결됨" : "이 사람이 저예요")</small>
                    </button>
                }
                <button type="button" class="sw-opt" data-person="0"><b>위 사람들과 달라요</b><small>동명이인 — 새로 등록</small></button>
            </div>

            @* 학생 · 교사: 더 입력할지 고르기 — "역할만"을 고르면 바로 확인으로 (2026-11-08) *@
            <div class="sw-step" data-k="more">
                <div class="qb-k" id="moreK">더 입력할까요?</div>
                <h1 class="qb-h1">자세한 정보도 적을까요?</h1>
                <div class="sw-dots"></div>
                <div class="qb-sub">지금은 역할만 정하고 끝내도 돼요. 자세한 정보는 나중에 관리자가 채울 수 있어요.</div>
                <button type="button" class="sw-opt" data-detail="false"><b>역할만 정하고 끝내기</b><small id="moreOnly"></small></button>
                <button type="button" class="sw-opt" data-detail="true"><b>더 입력하기</b><small id="moreMore"></small></button>
            </div>

            @* 3) 학생: 학년 · 반 *@
            <div class="sw-step" data-k="cls">
                <div class="qb-k">학생 · 반</div>
                <h1 class="qb-h1">몇 학년 몇 반이에요?</h1>
                <div class="sw-dots"></div>
                <div class="sw-f"><label>학년</label>
                    <select name="classYear" id="fYear"><option value="">골라 주세요</option>@foreach (var y in years) { <option value="@y">@(y)학년</option> }<option value="0">잘 모르겠어요</option></select>
                </div>
                <div class="sw-f"><label>반</label>
                    <select name="classBan" id="fBan"><option value="">골라 주세요</option>@foreach (var b in bans) { <option value="@b">@(b)반</option> }<option value="0">잘 모르겠어요</option></select>
                </div>
                <div class="sw-note">모르면 "잘 모르겠어요"를 고르세요. 관리자가 정해 드려요.</div>
            </div>

            @* 4) 학생: 생일 · 성별 *@
            <div class="sw-step" data-k="birth">
                <div class="qb-k">학생 · 생일</div>
                <h1 class="qb-h1">생일과 성별을 알려 주세요</h1>
                <div class="sw-dots"></div>
                <div class="sw-f"><label>생일</label>
                    <div class="sw-row">
                        <select name="bMonth" id="fMonth"><option value="">월</option>@for (int m = 1; m <= 12; m++) { <option value="@m">@(m)월</option> }</select>
                        <select name="bDay" id="fDay"><option value="">일</option>@for (int d = 1; d <= 31; d++) { <option value="@d">@(d)일</option> }</select>
                    </div>
                </div>
                <div class="sw-f"><label>성별</label>
                    <div class="sw-sex"><button type="button" data-sex="M">남</button><button type="button" data-sex="F">여</button></div>
                </div>
            </div>

            @* 5) 학생: 학교 · 부모님 연락처 *@
            <div class="sw-step" data-k="etc">
                <div class="qb-k">학생 · 연락</div>
                <h1 class="qb-h1">학교와 부모님 연락처</h1>
                <div class="sw-dots"></div>
                <div class="sw-f"><label>학교 (선택)</label><input name="school" id="fSchool" maxlength="100" placeholder="○○초등학교" /></div>
                <div class="sw-f"><label>부모님 연락처 (선택)</label><input name="phone" id="fPhoneS" inputmode="tel" maxlength="20" placeholder="010-0000-0000" /></div>
            </div>

            @* 교사: 연락처 *@
            <div class="sw-step" data-k="tel">
                <div class="qb-k">교사</div>
                <h1 class="qb-h1">연락처를 알려 주세요</h1>
                <div class="sw-dots"></div>
                <div class="sw-f"><label>연락처 (선택)</label><input name="phone" id="fPhoneT" inputmode="tel" maxlength="20" placeholder="010-0000-0000" /></div>
            </div>

            @* 학부모는 고르면 끝 — 더 입력받지 않고 바로 확인으로 (2026-11-08 결정) *@

            @* 마지막: 확인 *@
            <div class="sw-step" data-k="sum">
                <div class="qb-k">마지막</div>
                <h1 class="qb-h1">이대로 승인을 요청할까요?</h1>
                <div class="sw-dots"></div>
                <div class="sw-sum" id="sumBox"></div>
                <div class="sw-note">관리자가 확인하면 반영돼요. 그 전에도 미션은 바로 할 수 있어요.</div>
            </div>

            <div class="sw-err" id="swErr"></div>
            <div class="sw-nav">
                <button type="button" id="swPrev">이전</button>
                <button type="button" class="p" id="swNext">다음</button>
            </div>
        </form>

        <div class="qb-ft">
            <span>@(change ? "역할 변경" : "가입 마무리")</span>
            <span><a href="/">@ConstatsCommon.ToHome</a></span>
        </div>
    }
</div>

@if (!pending)
{
<script>
(function () {
    var hasSame = @(same.Count > 0 ? "true" : "false");
    var form = document.getElementById('swForm');
    var stepsEl = {}; form.querySelectorAll('.sw-step').forEach(function (s) { stepsEl[s.dataset.k] = s; });
    var role = '', idx = 0, personPicked = false, detail = null;   // detail: null = 아직 안 고름 · true 더 입력 · false 역할만
    var $ = function (id) { return document.getElementById(id); };
    var err = $('swErr');

    function flow() {
        var head = ['role'].concat(hasSame ? ['same'] : []).concat(['more']);
        if (role === 'S') return head.concat(detail ? ['cls', 'birth', 'etc'] : []).concat(['sum']);
        if (role === 'T') return head.concat(detail ? ['tel'] : []).concat(['sum']);
        if (role === 'P') return ['role', 'sum'];
        return ['role'];
    }
    function show() {
        var f = flow(), k = f[idx];
        Object.keys(stepsEl).forEach(function (x) { stepsEl[x].classList.toggle('on', x === k); });
        stepsEl[k].querySelector('.sw-dots').innerHTML = f.map(function (_, i) { return '<i class="' + (i <= idx ? 'on' : '') + '"></i>'; }).join('');
        $('swPrev').style.display = idx > 0 ? '' : 'none';
        $('swNext').textContent = k === 'sum' ? '승인 요청 보내기' : '다음';
        if (k === 'sum') $('sumBox').innerHTML = summary();
        if (k === 'more') {
            $('moreK').textContent = (role === 'S' ? '학생' : '교사') + ' · 더 입력할까요?';
            $('moreOnly').textContent = (role === 'S' ? '학생' : '교사') + '으로만 등록';
            $('moreMore').textContent = role === 'S' ? '학년·반 · 생일 · 학교 · 부모님 연락처' : '연락처';
        }
        err.textContent = '';
        window.scrollTo(0, 0);
    }
    function txt(id) { var e = $(id); return e ? e.value.trim() : ''; }
    function selText(id) { var e = $(id); return e && e.selectedIndex >= 0 ? e.options[e.selectedIndex].text : ''; }
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function summary() {
        var label = role === 'S' ? '학생' : role === 'T' ? '교사' : '학부모';
        if (role === 'P' || !detail) return '<b>' + label + '</b><br>역할만 정해요. 더 입력할 것은 없어요.';
        var parts = [];
        if (role === 'S') {
            parts.push(($('fYear').value === '0' || $('fBan').value === '0') ? '반은 관리자가 정해요' : selText('fYear') + ' ' + selText('fBan'));
            if ($('fMonth').value && $('fDay').value) parts.push(selText('fMonth') + ' ' + selText('fDay'));
            if ($('fSex').value) parts.push($('fSex').value === 'M' ? '남' : '여');
            if (txt('fSchool')) parts.push(txt('fSchool'));
            if (txt('fPhoneS')) parts.push('부모님 ' + txt('fPhoneS'));
        } else {
            parts.push(txt('fPhoneT') ? '연락처 ' + txt('fPhoneT') : '연락처 없음');
        }
        return '<b>' + label + '</b><br>' + parts.map(esc).join(' · ');
    }
    function check(k) {
        if (k === 'role' && !role) return '역할을 골라 주세요';
        if (k === 'same' && !personPicked) return '나인지 골라 주세요';
        if (k === 'more' && detail === null) return '역할만 정할지, 더 입력할지 골라 주세요';
        if (k === 'cls' && ($('fYear').value === '' || $('fBan').value === '')) return '학년과 반을 골라 주세요 (모르면 "잘 모르겠어요")';
        if (k === 'birth' && (!$('fMonth').value || !$('fDay').value)) return '생일을 골라 주세요';
        if (k === 'birth' && !$('fSex').value) return '성별을 골라 주세요';
        // 연락처는 필수가 아니다 (2026-11-08 결정)
        return '';
    }
    function send() {
        // 고른 역할의 연락처 칸만 보낸다
        ['fPhoneS', 'fPhoneT'].forEach(function (id) { $(id).disabled = !detail || !((role === 'S' && id === 'fPhoneS') || (role === 'T' && id === 'fPhoneT')); });
        if (role !== 'S' || !detail) {
            ['fYear', 'fBan'].forEach(function (id) { $(id).value = '0'; });
            ['fMonth', 'fDay'].forEach(function (id) { $(id).value = ''; });
            $('fSex').value = ''; $('fSchool').value = '';
        }
        $('fDetail').value = detail ? 'true' : 'false';
        if (role === 'P') $('fPerson').value = '0';
        $('swNext').disabled = true;
        form.onsubmit = null; form.submit();
    }

    form.querySelectorAll('[data-role]').forEach(function (b) {
        b.addEventListener('click', function () {
            role = b.dataset.role; $('fRole').value = role;
            form.querySelectorAll('[data-role]').forEach(function (x) { x.classList.toggle('on', x === b); });
            err.textContent = '';
        });
    });
    form.querySelectorAll('[data-person]').forEach(function (b) {
        b.addEventListener('click', function () {
            if (b.disabled) return;
            $('fPerson').value = b.dataset.person; personPicked = true;
            form.querySelectorAll('[data-person]').forEach(function (x) { x.classList.toggle('on', x === b); });
            err.textContent = '';
        });
    });
    form.querySelectorAll('[data-detail]').forEach(function (b) {
        b.addEventListener('click', function () {
            detail = b.dataset.detail === 'true';
            form.querySelectorAll('[data-detail]').forEach(function (x) { x.classList.toggle('on', x === b); });
            err.textContent = '';
        });
    });
    form.querySelectorAll('[data-sex]').forEach(function (b) {
        b.addEventListener('click', function () {
            $('fSex').value = b.dataset.sex;
            form.querySelectorAll('[data-sex]').forEach(function (x) { x.classList.toggle('on', x === b); });
        });
    });

    $('swPrev').addEventListener('click', function () { if (idx > 0) { idx--; show(); } });
    $('swNext').addEventListener('click', function () {
        var f = flow(), k = f[idx], m = check(k);
        if (m) { err.textContent = m; return; }
        if (k === 'sum') { send(); return; }
        idx++; show();
    });
    show();
})();
</script>
}
</body>
</html>
