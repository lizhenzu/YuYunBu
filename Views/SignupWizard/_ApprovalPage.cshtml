@using BulletinBoard.Common;
@using BulletinBoard.DataAccessLayer;
@using System.Collections.Generic;
@model List<SignupApplication>

@*  ══════════════════════════════════════════════════════════════
    가입 승인 · 역할 변경 승인 — 2026-11-08 시안 확정 (SuperAdmin 역할 + Basic 계정)
    · 두 화면이 같은 틀을 쓰고(이 파일), 제목 · 안내 · 알약 · 지워지는 것 안내만 다르다
      Approvals.cshtml            가입 승인       (ReqType = JOIN)
      RoleChangeApprovals.cshtml  역할 변경 승인  (ReqType = CHANGE)
    · 신청 한 건 = 카드 한 장. 반려 사유 칸은 "반려"를 눌렀을 때만 펼쳐진다
    · 처리: /SignupWizard/Decide
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;
    var years = (List<int>)ViewData["Years"];
    var bans = (List<int>)ViewData["Bans"];
    bool isChange = (ViewData["ReqType"] as string) == "CHANGE";
    string pageTitle = isChange ? "역할 변경 승인" : "가입 승인";
    string pageSub = isChange
        ? "가입한 회원이 \"나의 역할 변경\"으로 낸 신청이에요. 승인하면 바로 바뀌어요."
        : "방금 가입한 회원이 고른 역할이에요. 확인하고 승인해 주세요.";

    string PrevPill(SignupApplication a)
        => string.IsNullOrEmpty(a.PrevRole) ? "이전 역할" : (a.PrevRole.StartsWith("역할 없음") ? "학부모" : a.PrevRole);

    // 역할 변경 승인 때 지워지는 것 — 승인하기 전에 미리 알려 준다
    string WarnText(SignupApplication a)
    {
        if (!a.IsChange) return "";
        bool wasStudent = a.PrevRole.StartsWith("학생");
        bool wasNone = a.PrevRole.StartsWith("역할 없음");
        if (wasStudent && a.RoleKind == "T") return "승인하면 학생 반 배정이 삭제돼요 (" + a.PrevRole + ").";
        if (wasStudent && a.RoleKind == "P") return "승인하면 학생 반 배정과 역할이 삭제돼요 (" + a.PrevRole + ").";
        if (!wasStudent && !wasNone && a.RoleKind == "P") return "승인하면 지금 역할(" + a.PrevRole + ")이 없어져요.";
        if (wasStudent && a.RoleKind == "E") return "승인하면 학생 반 배정이 삭제되고 기타가 돼요 (" + a.PrevRole + ").";
        if (!wasNone && a.RoleKind == "E") return "승인하면 지금 역할(" + a.PrevRole + ") 대신 기타가 돼요.";
        return "";
    }
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>@pageTitle</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #FFFFFF; color: #111827; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-text-size-adjust: 100%; }
        a { color: inherit; text-decoration: none; }
        .ap { max-width: 560px; margin: 0 auto; padding: 14px 16px 48px; }
        .ap-top { font-size: 13px; color: #8A93A0; padding-bottom: 12px; border-bottom: 1px solid #EEF0F3; }
        .ap-top a { color: #374151; font-weight: 700; }
        .ap-top a:hover { color: #2F7BF5; }
        .ap h1 { margin: 16px 0 4px; font-size: 24px; font-weight: 800; letter-spacing: -.02em; }
        .ap-sub { font-size: 13.5px; color: #6B7280; line-height: 1.6; }
        .ap-cnt { display: inline-block; margin-top: 12px; padding: 6px 14px; border-radius: 999px; background: #FFF4E0; color: #8A5300; font-size: 13px; font-weight: 700; }
        .req { margin-top: 14px; border: 1px solid #E8EBF0; border-radius: 18px; padding: 16px; }
        .head { display: flex; align-items: center; gap: 12px; }
        .av { flex: none; width: 44px; height: 44px; border-radius: 50%; background: #EAF2FD; color: #2F7BF5; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; }
        .nm { flex: 1; min-width: 0; }
        .nm b { display: block; font-size: 17px; font-weight: 800; }
        .nm small { font-size: 12.5px; color: #8A93A0; }
        .dt { flex: none; font-size: 12px; color: #8A93A0; }
        .chg { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 14px; font-size: 14px; color: #6B7280; }
        .pill { padding: 5px 12px; border-radius: 999px; background: #F4F6F9; color: #6B7280; font-weight: 700; font-size: 13.5px; }
        .pill.n { background: #EAF2FD; color: #2F7BF5; }
        .info { margin-top: 12px; background: #F5F7FA; border-radius: 12px; padding: 4px 14px; }
        .info .r { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; font-size: 14px; }
        .info .r + .r { border-top: 1px solid #E8EBF0; }
        .info .r span { color: #8A93A0; white-space: nowrap; }
        .info .r b { font-weight: 700; text-align: right; word-break: keep-all; }
        .lab { margin: 14px 2px 6px; font-size: 12.5px; font-weight: 700; color: #6B7280; }
        .sel { display: flex; gap: 8px; }
        .sel select { flex: 1; min-width: 0; height: 46px; border: 1px solid #D9DEE6; border-radius: 12px; padding: 0 12px; background: #fff; font: inherit; font-size: 15px; }
        .same { margin-top: 12px; border: 1.5px solid #FAD9A1; background: #FFF8EA; border-radius: 14px; padding: 12px 14px; font-size: 13.5px; color: #8A5300; line-height: 1.6; }
        .same b { color: #6B3F00; }
        .warn { margin-top: 12px; border-radius: 12px; padding: 10px 14px; background: #FDEEEE; color: #A63030; font-size: 13.5px; line-height: 1.6; font-weight: 700; }
        .acts { display: flex; gap: 8px; margin-top: 16px; }
        .acts button { height: 48px; border-radius: 14px; font: inherit; font-size: 16px; font-weight: 800; border: 0; cursor: pointer; }
        .acts .no { flex: 1; background: #F4F6F9; color: #6B7280; }
        .acts .ok { flex: 2; background: #2F7BF5; color: #fff; }
        .acts button[disabled], .why button[disabled] { opacity: .5; }
        .why { display: none; margin-top: 10px; }
        .why.on { display: block; }
        .why input { width: 100%; height: 46px; border: 1px solid #F0C4C4; border-radius: 12px; padding: 0 12px; font: inherit; font-size: 15px; background: #FFF8F8; }
        .why .go { margin-top: 8px; display: flex; gap: 8px; }
        .why .go button { height: 44px; border-radius: 12px; border: 0; font: inherit; font-size: 15px; font-weight: 800; cursor: pointer; }
        .why .c { flex: 1; background: #F4F6F9; color: #6B7280; }
        .why .d { flex: 2; background: #D13B3B; color: #fff; }
        .err { min-height: 16px; font-size: 13px; color: #D13B3B; margin-top: 6px; }
        .empty { display: none; margin: 30px 0 10px; text-align: center; color: #9AA3AF; font-size: 14px; }
    </style>
</head>
<body>
<div class="ap">

    <div class="ap-top"><a href="/HumanResource/ManageUserInfo#join">정보 관리</a> › @pageTitle</div>

    <h1>@pageTitle</h1>
    <div class="ap-sub">@pageSub</div>
    <span class="ap-cnt">확인 대기 <span id="apCnt">@Model.Count</span>건</span>

    <div id="apList">
        @foreach (var a in Model)
        {
            bool hasTarget = a.PersonId > 0;
            bool targetTaken = hasTarget && !string.IsNullOrEmpty(a.TargetUserName);
            string warn = WarnText(a);
            bool anyInfo = false;
            <div class="req" id="ap@(a.Id)" data-name="@a.FullName" data-role="@a.RoleKind">
                <div class="head">
                    <div class="av">@(string.IsNullOrEmpty(a.FullName) ? "?" : a.FullName.Substring(0, 1))</div>
                    <div class="nm"><b>@a.FullName</b><small>@a.UserName</small></div>
                    <div class="dt">@a.InsertDT.ToString("M월 d일")</div>
                </div>
                <div class="chg">
                    <span class="pill">@(a.IsChange ? PrevPill(a) : "새 가입")</span><span>→</span><span class="pill n">@a.RoleLabel</span>
                </div>

                @if (warn.Length > 0) { <div class="warn">@warn</div> }

                <div class="info">
                    @if (a.RoleKind == "S")
                    {
                        if (a.BMonth > 0 && a.BDay > 0) { anyInfo = true; <div class="r"><span>생일</span><b>@($"{a.BMonth}월 {a.BDay}일")</b></div> }
                        if (a.Sex == "M" || a.Sex == "F") { anyInfo = true; <div class="r"><span>성별</span><b>@(a.Sex == "M" ? "남" : "여")</b></div> }
                        if (!string.IsNullOrEmpty(a.School)) { anyInfo = true; <div class="r"><span>학교</span><b>@a.School</b></div> }
                        if (!string.IsNullOrEmpty(a.Phone)) { anyInfo = true; <div class="r"><span>부모님 연락처</span><b>@a.Phone</b></div> }
                        if (a.IsChange && anyInfo) { <div class="r"><span>입력한 반</span><b>@(a.ClassYear > 0 && a.ClassBan > 0 ? $"{a.ClassYear}학년 {a.ClassBan}반" : "잘 모르겠어요")</b></div> }
                    }
                    else if (a.RoleKind == "T" && !string.IsNullOrEmpty(a.Phone))
                    {
                        anyInfo = true;
                        <div class="r"><span>연락처</span><b>@a.Phone</b></div>
                    }
                    @if (!anyInfo) { <div class="r"><span>입력한 정보</span><b>없음 (역할만)</b></div> }
                </div>

                @if (hasTarget)
                {
                    <div class="same">
                        <b>같은 이름의 기존 기록을 골랐어요</b><br />
                        @a.TargetFullName · @(a.TargetClassYear > 0 ? $"{a.TargetClassYear}학년 {a.TargetClassBan}반" : "반 정보 없음") · @(targetTaken ? "지금은 다른 계정(" + a.TargetUserName + ")과 연결됨" : "계정 없음")
                    </div>
                    <div class="lab">사람 명부</div>
                    <div class="sel">
                        <select class="ap-link">
                            <option value="true" disabled="@targetTaken" selected="@(!targetTaken)">기존 기록에 연결</option>
                            <option value="false" selected="@targetTaken">새로 등록 (동명이인)</option>
                        </select>
                    </div>
                }

                @* 역할 변경 승인은 역할만 바꾼다 — 학생이어도 학년 · 반은 묻지 않는다 (2026-11-09). 가입 승인만 학년 · 반을 고른다 *@
                @if (a.RoleKind == "S" && !isChange)
                {
                    int y0 = a.ClassYear > 0 ? a.ClassYear : a.TargetClassYear;
                    int b0 = a.ClassBan > 0 ? a.ClassBan : a.TargetClassBan;
                    <div class="lab">승인할 학년 · 반 (바꿀 수 있어요)</div>
                    <div class="sel">
                        <select class="ap-y"><option value="0">학년 미정</option>@foreach (var y in years) { <option value="@y" selected="@(y == y0)">@(y)학년</option> }</select>
                        <select class="ap-b"><option value="0">반 미정</option>@foreach (var b in bans) { <option value="@b" selected="@(b == b0)">@(b)반</option> }</select>
                    </div>
                }
                else if (a.RoleKind == "T")
                {
                    <div class="lab">교사 구분</div>
                    <div class="sel"><select class="ap-t"><option value="T1002">교사</option><option value="T1003">교사(S)</option></select></div>
                }

                <div class="acts">
                    <button type="button" class="no" onclick="apWhy(@a.Id, true)">반려</button>
                    <button type="button" class="ok" onclick="apDecide(@a.Id, true)">승인</button>
                </div>
                <div class="why" id="apw@(a.Id)">
                    <input class="ap-why" maxlength="300" placeholder="반려 사유를 적어 주세요" />
                    <div class="go">
                        <button type="button" class="c" onclick="apWhy(@a.Id, false)">취소</button>
                        <button type="button" class="d" onclick="apDecide(@a.Id, false)">반려 보내기</button>
                    </div>
                </div>
                <div class="err" id="ape@(a.Id)"></div>
            </div>
        }
    </div>
    <div class="empty" id="apEmpty">확인할 @(isChange ? "역할 변경" : "가입") 신청이 없어요.</div>
</div>

<script>
    function apCount() {
        var n = document.querySelectorAll('#apList .req').length;
        document.getElementById('apCnt').textContent = n;
        document.getElementById('apEmpty').style.display = n ? 'none' : 'block';
    }
    function apWhy(id, on) {
        var w = document.getElementById('apw' + id);
        w.classList.toggle('on', on);
        if (on) { var i = w.querySelector('input'); if (i) i.focus(); }
    }
    function apDecide(id, approve) {
        var row = document.getElementById('ap' + id), err = document.getElementById('ape' + id);
        var why = row.querySelector('.ap-why').value.trim();
        err.textContent = '';
        if (!approve && !why) { err.textContent = '반려 사유를 적어 주세요'; return; }
        if (approve && row.dataset.role === 'S' && row.querySelector('.ap-y')) {
            var y = row.querySelector('.ap-y').value, b = row.querySelector('.ap-b').value;
            if ((y === '0') !== (b === '0')) { err.textContent = '학년과 반을 둘 다 고르거나 둘 다 미정으로 두세요'; return; }
        }
        var fd = new FormData();
        fd.append('id', id);
        fd.append('approve', approve ? 'true' : 'false');
        var link = row.querySelector('.ap-link');
        fd.append('linkExisting', link ? link.value : 'false');
        var ys = row.querySelector('.ap-y'), bs = row.querySelector('.ap-b'), ts = row.querySelector('.ap-t');
        fd.append('classYear', ys ? ys.value : '0');
        fd.append('classBan', bs ? bs.value : '0');
        fd.append('teacherRole', ts ? ts.value : '');
        fd.append('reason', why);
        var btns = row.querySelectorAll('button');
        btns.forEach(function (x) { x.disabled = true; });
        fetch('/SignupWizard/Decide', { method: 'POST', body: fd, credentials: 'same-origin' })
            .then(function (x) {
                var ct = x.headers.get('content-type') || '';
                if (x.redirected || ct.indexOf('json') < 0) { throw new Error('응답 ' + x.status); }
                return x.json();
            })
            .then(function (j) {
                if (j.ok) { row.remove(); apCount(); }
                else { err.textContent = j.message || '처리하지 못했어요'; btns.forEach(function (x) { x.disabled = false; }); }
            })
            .catch(function (e) { err.textContent = '처리하지 못했어요 · ' + (e && e.message ? e.message : ''); btns.forEach(function (x) { x.disabled = false; }); });
    }
    apCount();
</script>
</body>
</html>
