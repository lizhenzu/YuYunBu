@model BulletinBoard.Models.TodayCheckCompositeData
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&display=swap" rel="stylesheet">
<style>
    .local-body {
        background-size: cover;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        padding: 20px;
        height: 100vh;
        margin: 0;
        position: relative;
    }

    .header {
        width: 100%;
        text-align: center;
        color: white;
        font-size: 24px;
        background: rgba(0, 0, 0, 0.5);
        padding: 10px;
    }

    .video-card {
        width: 300px;
        border-radius: 8px;
        overflow: hidden;
        margin: 5px;
        justify-content: center;
        align-items: center;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: rgba(255, 255, 255, 0.5);
    }

        .video-card:hover {
            transform: scale(1.03);
            box-shadow: 0 8px 16px rgba(0,0,0,0.2);
        }

        .video-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .video-card .title {
            padding: 10px;
            background-color: #000;
            color: #fff;
            text-align: center;
            font-weight: bold;
        }
</style>

<style>

    .body2 {
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-color: #f0f0f0;
        flex-wrap: wrap;
    }

</style>
<link rel="stylesheet" href="/css/missionC.css">
<div class="head-body">
    <div class="score-container" style="margin-top:15px;">
        <div class="score-header  no-select">
            <h1 style="margin:25px;">동영상 모음집</h1>
        </div>
    </div>

    <div class="body2">

        <div class="video-card" onclick="playVideo('KWJ1VNa7iPQ')">
            <img src="/images/episode/summer_2024.jpg" alt="대표 이미지 1">
            <div class="title">2024여름성경학교</div>
        </div>

        <div class="video-card" onclick="playVideo('9iZg1c2kdRU')">
            <img src="/images/episode/winter_2024.png" alt="대표 이미지 2">
            <div class="title">2024겨울성경학교</div>
        </div>

        <div class="video-card" onclick="playVideo('2Drhlb2MJA4')">
            <img src="/images/episode/drone.png" alt="대표 이미지 1">
            <div class="title">2023여름성경학교(드론촬영)</div>
        </div>

        <div class="video-card" onclick="playVideo('57ryuFA3q08')">
            <img src="/images/episode/summer_2023_1.png" alt="대표 이미지 3">
            <div class="title">2023여름성경학교(1일차)</div>
        </div>
        <div class="video-card" onclick="playVideo('PVlysb87Bfs')">
            <img src="/images/episode/summer_2023_2.png" alt="대표 이미지 3">
            <div class="title">2023여름성경학교(2일차)</div>
        </div>
        <div class="video-card" onclick="playVideo('UXGhVNKu6iU')">
            <img src="/images/episode/summer_2023_3.png" alt="대표 이미지 3">
            <div class="title">2023여름성경학교(3일차)</div>
        </div>

    </div>
</div>
<script>
    function playVideo(videoId) {
        window.open(`https://www.youtube.com/watch?v=${videoId}`, '_blank');
    }
</script>

