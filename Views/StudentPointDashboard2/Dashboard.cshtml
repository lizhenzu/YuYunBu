@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract

@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IUserUiPreferenceService PrefSvc

@model BulletinBoard.ViewModels.Dashboard.StudentPointDashboardVM
@{
    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    var isBasic = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Basic));
}

@{
    Layout = null;

    // ✅ 원하는 경로로 교체하세요
    var urlChallengeMain = "/DailyMission2/Index";      // 도전 성경말씀(말씀읽기/퀴즈/암송/기도)
    var urlBibleReading = "/bibleCenter/MyDashboard";     // 도전성경완독(성경 통독하기)
    var urlAttendance = "/Attendance/DashboardAll";       // 출석 대쉬보드(전체반) - 필요시 변경
    var urlWorldview = "/Worldview/Intro";                // 미션북
    var urlHome = "/";                                    // 홈

    // ✅ 감사 일기(말씀&일기) 상세 페이지 + AJAX API (DevotionPointsController)
    var urlThanksDetail = "/DevotionPoints/MyMonthly";
    var urlThanksTotalApi = "/DevotionPoints/MyTotal";

    // ✅ 선물 페이지(필요시 변경)
    var urlGift = "/StudentPointDashboard4/MyGiftBox3";

    // ✅ 통합포인트 선물 기준점수(필요시 변경)
    var integratedGoal = 2000;

    // ✅ 통합포인트 열람(랭킹/전체 보기) 페이지
    var urlIntegratedRank = "/StudentPointDashboard4/TotalRank";
}

@{
    // ✅ 상단 헤더용 사용자/부서명 세팅

    var ChurchName = HttpContextAccessor.HttpContext?.Session.GetString(CommonMetaDataCategory.ChurchName.ToString()) ?? "";
    var DepartmentName = HttpContextAccessor.HttpContext?.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString()) ?? "";

    var userFullName =
        (ViewData[HttpContextSessionCategory.UserFullName.ToString()] as string)
        ?? (HttpContextAccessor.HttpContext?.Session.GetString(HttpContextSessionCategory.UserFullName.ToString()) ?? "");

    var topTitle = (string.IsNullOrWhiteSpace(ChurchName) && string.IsNullOrWhiteSpace(DepartmentName))
        ? "교회 포털"
        : $"{ChurchName} · {DepartmentName}";

    var helloText = string.IsNullOrWhiteSpace(userFullName) ? "안녕하세요 👋" : $"{userFullName}님, 안녕하세요 👋";
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ConstatsCommon.myDoToRi 보드(2축)</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #f6f7fb;
            --bg2: #ffffff;
            --ink: #0f172a;
            --muted: #64748b;
            --line: rgba(2,6,23,.10);
            --shadow: 0 16px 36px rgba(2,6,23,.10);
            --shadow2: 0 10px 24px rgba(2,6,23,.08);
            --radius: 22px;
            /* ✅ 홈 버튼 강조 컬러 (그린→블루) */
            --home1: #22c55e;
            --home2: #3b82f6;
            /* 출석(보라) */
            --att1: #c084fc;
            --att2: #6d28d9;
            --attBg1: rgba(192,132,252,.18);
            --attBg2: rgba(109,40,217,.10);
            /* 전도(로즈) */
            --ev1: #fb7185;
            --ev2: #be123c;
            --evBg1: rgba(251,113,133,.18);
            --evBg2: rgba(190,18,60,.10);
            /* 완독(블루) */
            --read1: #60a5fa;
            --read2: #1d4ed8;
            --readBg1: rgba(96,165,250,.18);
            --readBg2: rgba(29,78,216,.10);
            /* 통합(틸→블루) */
            --int1: #2dd4bf;
            --int2: #3b82f6;
            --intBg1: rgba(45,212,191,.18);
            --intBg2: rgba(59,130,246,.10);
            /* 통합 구성 ① 말씀(시안) */
            --bible1: #22d3ee;
            --bible2: #3b82f6;
            --bibleBg1: rgba(34,211,238,.18);
            --bibleBg2: rgba(59,130,246,.10);
            /* 통합 구성 ② 미션북(민트) */
            --mb1: #5eead4;
            --mb2: #60a5fa;
            --mbBg1: rgba(94,234,212,.18);
            --mbBg2: rgba(96,165,250,.10);
            /* 통합 구성 ③ 감사(라이트시안) */
            --thx1: #67e8f9;
            --thx2: #2563eb;
            --thxBg1: rgba(103,232,249,.18);
            --thxBg2: rgba(37,99,235,.10);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Noto Sans KR", system-ui, -apple-system, Segoe UI, Roboto, Arial;
            color: var(--ink);
            background: radial-gradient(1200px 600px at 12% 0%, rgba(167,139,250,.16), transparent 60%), radial-gradient(1000px 550px at 88% 8%, rgba(34,197,94,.14), transparent 60%), radial-gradient(900px 600px at 50% 100%, rgba(59,130,246,.12), transparent 60%), linear-gradient(180deg, var(--bg), var(--bg2));
            min-height: 100vh;
        }

        .wrap {
            max-width: 1100px;
            margin: 0 auto;
            padding: 18px 14px 28px;
        }

        /* ========================= ✅ 상단 통합 헤더 ========================= */
        header.heroUnified {
            border: 1px solid var(--line);
            background: rgba(255,255,255,.88);
            backdrop-filter: blur(10px);
            border-radius: calc(var(--radius) + 8px);
            box-shadow: var(--shadow);
            padding: 16px;
            margin-bottom: 14px;
            overflow: hidden;
            position: relative;
        }

            header.heroUnified::before {
                content: "";
                position: absolute;
                inset: -2px;
                background: radial-gradient(780px 260px at 0% 0%, rgba(34,197,94,.18), transparent 55%), radial-gradient(780px 260px at 100% 0%, rgba(59,130,246,.18), transparent 55%), radial-gradient(900px 320px at 50% 120%, rgba(167,139,250,.16), transparent 55%);
                pointer-events: none;
            }

        .heroUInner {
            position: relative;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 12px;
            align-items: start;
        }

        .heroULeft {
            min-width: 0;
        }

        .brandRow {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .logo {
            width: 52px;
            height: 52px;
            border-radius: 18px;
            background: linear-gradient(135deg, rgba(34,197,94,.95), rgba(59,130,246,.95));
            box-shadow: var(--shadow2);
            display: grid;
            place-items: center;
            color: white;
            font-weight: 900;
            font-size: 22px;
            flex: 0 0 auto;
        }

        .brandText {
            min-width: 0;
            line-height: 1.1;
        }

        .brandTitle {
            font-weight: 900;
            font-size: 13px;
            color: rgba(15,23,42,.86);
            letter-spacing: -.2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .hello {
            margin-top: 4px;
            font-weight: 900;
            font-size: 18px;
            letter-spacing: -.3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .subline {
            margin-top: 8px;
            font-size: 13px;
            color: var(--muted);
            line-height: 1.45;
        }

        .miniRules {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .pill {
            border: 1px solid var(--line);
            background: rgba(255,255,255,.92);
            border-radius: 999px;
            padding: 8px 10px;
            font-size: 12px;
            color: var(--muted);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            user-select: none;
            box-shadow: 0 8px 16px rgba(2,6,23,.05);
            white-space: nowrap;
        }

            .pill i {
                width: 10px;
                height: 10px;
                border-radius: 999px;
                background: linear-gradient(135deg, rgba(34,197,94,.95), rgba(59,130,246,.95));
                display: inline-block;
            }

        .heroURight {
            display: flex;
            flex-direction: column;
            gap: 10px;
            align-items: flex-end;
        }

        .heroTags {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .heroTag {
            border: 1px solid var(--line);
            background: rgba(255,255,255,.92);
            border-radius: 999px;
            padding: 8px 10px;
            font-size: 12px;
            color: var(--muted);
            box-shadow: 0 8px 16px rgba(2,6,23,.05);
            user-select: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .heroDot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: linear-gradient(135deg, rgba(34,197,94,.95), rgba(59,130,246,.95));
            display: inline-block;
        }

        .actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .btn {
            border: 1px solid var(--line);
            background: rgba(255,255,255,.92);
            color: var(--ink);
            padding: 10px 12px;
            border-radius: 14px;
            font-size: 13px;
            font-weight: 900;
            cursor: pointer;
            box-shadow: 0 10px 22px rgba(2,6,23,.06);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: transform .12s ease, box-shadow .12s ease;
        }

            .btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 16px 30px rgba(2,6,23,.10);
            }

            .btn.primary {
                border: 0;
                background: linear-gradient(135deg, rgba(34,197,94,.95), rgba(22,163,74,.95));
                color: #fff;
            }

            .btn.secondary {
                border: 0;
                background: linear-gradient(135deg, rgba(59,130,246,.95), rgba(99,102,241,.95));
                color: #fff;
            }

            .btn.homeAccent {
                border: 0;
                color: #fff;
                background: linear-gradient(135deg, var(--home1), var(--home2));
                box-shadow: 0 16px 34px rgba(34,197,94,.18), 0 14px 30px rgba(59,130,246,.16);
            }

                .btn.homeAccent:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 22px 44px rgba(34,197,94,.22), 0 18px 36px rgba(59,130,246,.18);
                }

            .btn.rankAccent {
                border: 0;
                color: #fff;
                background: linear-gradient(135deg, rgba(45,212,191,.95), rgba(59,130,246,.95));
                box-shadow: 0 18px 38px rgba(45,212,191,.18), 0 16px 34px rgba(59,130,246,.16);
            }

                .btn.rankAccent:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 24px 52px rgba(45,212,191,.22), 0 18px 40px rgba(59,130,246,.18);
                }

        .btnHomeRight {
            margin-left: auto;
        }

        .sectionTitle {
            margin: 14px 2px 10px;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 12px;
        }

            .sectionTitle h2 {
                margin: 0;
                font-size: 15px;
                letter-spacing: -.2px;
            }

            .sectionTitle span {
                font-size: 12px;
                color: var(--muted);
            }

        .grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 12px;
        }

        .card {
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow2);
            padding: 14px;
            position: relative;
            overflow: hidden;
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(10px);
        }

            .card > * {
                position: relative;
                z-index: 1;
            }

            .card.click {
                cursor: pointer;
                transition: transform .12s ease, box-shadow .12s ease;
            }

                .card.click:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 18px 34px rgba(2,6,23,.12);
                }

        .cardHead {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
        }

        .titleRow {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .icon {
            width: 40px;
            height: 40px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            font-size: 18px;
            font-weight: 900;
            color: white;
            box-shadow: 0 12px 24px rgba(2,6,23,.12);
            flex: 0 0 auto;
        }

        .meta {
            min-width: 0;
        }

            .meta small {
                display: block;
                font-size: 15px;
                color: var(--muted);
                font-weight: 1200;
            }

            .meta b {
                display: block;
                font-size: 14px;
                letter-spacing: -.2px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        .bigValue {
            margin-top: 12px;
            display: flex;
            align-items: baseline;
            gap: 8px;
            flex-wrap: wrap;
        }

            .bigValue .num {
                font-size: 28px;
                font-weight: 900;
                letter-spacing: -.6px;
            }

            .bigValue .unit {
                font-size: 13px;
                font-weight: 900;
                color: var(--muted);
            }

        .sideBadge {
            display: inline-flex;
            align-items: center;
            gap: 2px;
            padding: 5px 10px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 900;
            color: #4c1d95;
            background: rgba(237,233,254,.95);
            border: 1px solid rgba(196,181,253,.95);
            box-shadow: 0 6px 16px rgba(109,40,217,.08);
        }

        .subHint {
            margin-top: 8px;
            font-size: 12px;
            color: var(--muted);
            line-height: 1.4;
        }

        .bar {
            margin-top: 10px;
            height: 12px;
            background: rgba(226,232,240,.75);
            border: 1px solid rgba(226,232,240,.95);
            border-radius: 999px;
            overflow: hidden;
        }

            .bar > i {
                display: block;
                height: 100%;
                width: 0%;
                border-radius: 999px;
                transition: width .6s ease;
            }

        .ax-att::before {
            background: linear-gradient(135deg, var(--attBg1), rgba(255,255,255,.70) 35%, var(--attBg2));
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .ax-att .icon {
            background: linear-gradient(135deg, var(--att1), var(--att2));
        }

        .ax-att .bar > i {
            background: linear-gradient(135deg, var(--att1), var(--att2));
        }

        .ax-ev::before {
            background: linear-gradient(135deg, var(--evBg1), rgba(255,255,255,.70) 35%, var(--evBg2));
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .ax-ev .icon {
            background: linear-gradient(135deg, var(--ev1), var(--ev2));
        }

        .ax-ev .bar > i {
            background: linear-gradient(135deg, var(--ev1), var(--ev2));
        }

        .ax-int::before {
            background: linear-gradient(135deg, var(--intBg1), rgba(255,255,255,.70) 35%, var(--intBg2));
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .ax-int .icon {
            background: linear-gradient(135deg, var(--int1), var(--int2));
        }

        .ax-int .bar > i {
            background: linear-gradient(135deg, var(--int1), var(--int2));
        }

        .c-bible::before {
            background: linear-gradient(135deg, var(--bibleBg1), rgba(255,255,255,.70) 35%, var(--bibleBg2));
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .c-bible .icon {
            background: linear-gradient(135deg, var(--bible1), var(--bible2));
        }

        .c-bible .bar > i {
            background: linear-gradient(135deg, var(--bible1), var(--bible2));
        }

        .c-mb::before {
            background: linear-gradient(135deg, var(--mbBg1), rgba(255,255,255,.70) 35%, var(--mbBg2));
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .c-mb .icon {
            background: linear-gradient(135deg, var(--mb1), var(--mb2));
        }

        .c-mb .bar > i {
            background: linear-gradient(135deg, var(--mb1), var(--mb2));
        }

        .c-thx::before {
            background: linear-gradient(135deg, var(--thxBg1), rgba(255,255,255,.70) 35%, var(--thxBg2));
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .c-thx .icon {
            background: linear-gradient(135deg, var(--thx1), var(--thx2));
        }

        .c-thx .bar > i {
            background: linear-gradient(135deg, var(--thx1), var(--thx2));
        }

        .c-read::before {
            background: linear-gradient(135deg, var(--readBg1), rgba(255,255,255,.70) 35%, var(--readBg2));
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .c-read .icon {
            background: linear-gradient(135deg, var(--read1), var(--read2));
        }

        .c-read .bar > i {
            background: linear-gradient(135deg, var(--read1), var(--read2));
        }

        .groupBox {
            grid-column: span 12;
            border: 2px solid rgba(15,23,42,.12);
            border-radius: 24px;
            background: linear-gradient(180deg, rgba(45,212,191,.10), rgba(59,130,246,.06));
            box-shadow: 0 18px 40px rgba(2,6,23,.08);
            padding: 14px;
            position: relative;
        }

        .groupTitle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 10px;
        }

        .groupTitleLeft {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .groupBadge {
            width: 40px;
            height: 40px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, rgba(45,212,191,.22), rgba(59,130,246,.18));
            border: 1px solid rgba(15,23,42,.10);
            box-shadow: 0 10px 20px rgba(2,6,23,.06);
            font-size: 18px;
        }

        .groupTitle h3 {
            margin: 0;
            font-size: 14px;
            letter-spacing: -.2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .groupTitle p {
            margin: 2px 0 0;
            font-size: 12px;
            color: var(--muted);
        }

        .groupGrid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 12px;
        }

        .col-6 {
            grid-column: span 6;
        }

        .col-12 {
            grid-column: span 12;
        }

        .heroInt {
            grid-column: span 12;
            padding: 18px;
            border-radius: calc(var(--radius) + 6px);
            border: 2px solid rgba(59,130,246,.22);
            background: radial-gradient(900px 320px at 10% 0%, rgba(45,212,191,.26), transparent 55%), radial-gradient(900px 320px at 90% 0%, rgba(59,130,246,.24), transparent 55%), linear-gradient(135deg, rgba(255,255,255,.95), rgba(255,255,255,.86));
            box-shadow: 0 26px 70px rgba(2,6,23,.14);
            position: relative;
            overflow: hidden;
            margin: 0;
        }

            .heroInt::after {
                content: "";
                position: absolute;
                inset: -40%;
                background: conic-gradient(from 180deg, rgba(45,212,191,.00), rgba(45,212,191,.22), rgba(59,130,246,.18), rgba(45,212,191,.00));
                filter: blur(26px);
                opacity: .55;
                animation: heroGlow 6s linear infinite;
                pointer-events: none;
            }

        @@keyframes heroGlow {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .heroRibbon {
            position: absolute;
            top: 12px;
            left: 14px;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 900;
            color: #0b1220;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(15,23,42,.10);
            box-shadow: 0 14px 28px rgba(2,6,23,.10);
        }

            .heroRibbon i {
                width: 10px;
                height: 10px;
                border-radius: 999px;
                background: linear-gradient(135deg, var(--int1), var(--int2));
                display: inline-block;
            }

        .heroGoal {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: 999px;
            border: 1px solid rgba(15,23,42,.10);
            background: rgba(255,255,255,.90);
            box-shadow: 0 10px 22px rgba(2,6,23,.06);
            font-weight: 900;
            font-size: 12px;
            color: rgba(15,23,42,.86);
            white-space: nowrap;
            text-align: right;
        }

        .heroInt .bigValue {
            margin-top: 18px;
            gap: 10px;
        }

            .heroInt .bigValue .num {
                font-size: 44px;
                line-height: 1;
                letter-spacing: -1.2px;
                text-shadow: 0 12px 32px rgba(59,130,246,.18);
            }

            .heroInt .bigValue .unit {
                font-size: 14px;
                opacity: .9;
            }

        /* ✅ 통합포인트 + (획득/소멸/잔여) 포인트 3개 나란히 표시 */
        .heroInt .heroTotals {
            align-items: flex-end;
            justify-content: space-between;
            gap: 12px;
        }

        .heroInt .totalMain {
            display: inline-flex;
            align-items: baseline;
            gap: 10px;
            flex: 0 0 auto;
        }

        .heroInt .pointStack {
            display: flex;
            gap: 10px;
            align-items: stretch;
            justify-content: flex-end;
            flex-wrap: wrap;
            margin-left: auto;
        }

        .heroInt .pointPill {
            border: 1px solid rgba(15,23,42,.10);
            background: rgba(255,255,255,.92);
            border-radius: 16px;
            padding: 8px 10px;
            box-shadow: 0 10px 22px rgba(2,6,23,.06);
            min-width: 132px;
            text-align: right;
        }

            .heroInt .pointPill .k {
                display: block;
                font-size: 11px;
                color: var(--muted);
                font-weight: 900;
                letter-spacing: -.1px;
                margin-bottom: 2px;
                white-space: nowrap;
            }

            .heroInt .pointPill .v {
                display: inline-block;
                font-size: 18px;
                font-weight: 1000;
                letter-spacing: -.5px;
                line-height: 1.1;
            }

            .heroInt .pointPill .u {
                font-size: 11px;
                font-weight: 900;
                color: var(--muted);
                margin-left: 4px;
            }

        @@media (max-width: 520px) {
            .heroInt .pointPill {
                min-width: 0;
                flex: 1 1 auto;
            }

            .heroInt .heroTotals {
                align-items: flex-start;
            }
        }

        .heroInt .bar {
            height: 16px;
            margin-top: 12px;
            border-radius: 999px;
            background: rgba(226,232,240,.75);
            border: 1px solid rgba(226,232,240,.95);
            overflow: hidden;
            position: relative;
        }

            .heroInt .bar > i {
                background: linear-gradient(135deg, var(--int1), var(--int2));
            }

            .heroInt .bar::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg, rgba(255,255,255,.00), rgba(255,255,255,.55), rgba(255,255,255,.00));
                transform: translateX(-60%);
                animation: barShine 2.8s ease-in-out infinite;
                pointer-events: none;
                opacity: .8;
            }

        @@keyframes barShine {
            0% {
                transform: translateX(-60%);
            }

            60% {
                transform: translateX(60%);
            }

            100% {
                transform: translateX(60%);
            }
        }

        .heroInt.isGoal {
            border-color: rgba(34,197,94,.35);
            box-shadow: 0 30px 90px rgba(34,197,94,.12), 0 24px 70px rgba(59,130,246,.14);
        }

            .heroInt.isGoal .heroRibbon {
                background: linear-gradient(135deg, rgba(34,197,94,.18), rgba(59,130,246,.14));
            }

            .heroInt.isGoal .heroGoal {
                border-color: rgba(34,197,94,.25);
            }

        .rankCta {
            grid-column: span 12;
            border-radius: calc(var(--radius) + 6px);
            border: 2px dashed rgba(59,130,246,.22);
            background: radial-gradient(900px 320px at 10% 0%, rgba(45,212,191,.18), transparent 55%), radial-gradient(900px 320px at 90% 0%, rgba(59,130,246,.16), transparent 55%), rgba(255,255,255,.92);
            box-shadow: 0 20px 54px rgba(2,6,23,.10);
            padding: 16px;
            overflow: hidden;
        }

        .rankCtaInner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .rankCtaLeft {
            min-width: 240px;
            flex: 1 1 320px;
        }

        .rankCtaTitle {
            margin: 0;
            font-size: 15px;
            font-weight: 900;
            letter-spacing: -.2px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .rankCtaDesc {
            margin: 8px 0 0;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.45;
        }

        .rankCtaRight {
            display: flex;
            gap: 10px;
            align-items: center;
            justify-content: flex-end;
            flex: 0 0 auto;
        }

        .rankHintPills {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        @@media (max-width: 860px) {
            .heroUInner {
                grid-template-columns: 1fr;
            }

            .heroURight {
                align-items: stretch;
            }

            .heroTags {
                justify-content: flex-start;
            }

            .actions {
                width: 100%;
                justify-content: flex-end;
            }

            .btnHomeRight {
                margin-left: auto;
            }

            .col-6 {
                grid-column: span 12;
            }

            .hello {
                white-space: normal;
            }

            .heroInt .cardHead {
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
            }

            .heroGoal {
                width: 100%;
                justify-content: space-between;
                white-space: normal;
                border-radius: 14px;
                padding: 10px 12px;
                text-align: right;
            }

            .heroInt .bigValue .num {
                font-size: 48px;
            }

            .heroInt {
                /*  padding-top: 78px; */
            }

            .heroRibbon {
                top: 12px;
            }

            .rankCtaRight {
                width: 100%;
                justify-content: stretch;
            }

                .rankCtaRight .btn {
                    flex: 1 1 auto;
                    justify-content: center;
                }
        }

        .footer {
            margin-top: 14px;
            text-align: center;
            color: var(--muted);
            font-size: 12px;
            opacity: .9;
            line-height: 1.55;
        }

        /* ========================= ✅ Gift Modal (화려 버전) ========================= */
        .modalBack {
            position: fixed;
            inset: 0;
            background: rgba(2,6,23,.58);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 18px;
            z-index: 9999;
        }

        .modal {
            width: min(560px, 100%);
            border-radius: 26px;
            border: 1px solid rgba(2,6,23,.10);
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(10px);
            box-shadow: 0 30px 90px rgba(2,6,23,.28);
            overflow: hidden;
            color: var(--ink);
            position: relative;
        }

        /* 상단 화려한 헤더 */
        .modalFancyTop {
            position: relative;
            padding: 18px 16px 14px;
            background: radial-gradient(900px 240px at 12% 0%, rgba(34,197,94,.28), transparent 55%), radial-gradient(900px 240px at 88% 0%, rgba(59,130,246,.28), transparent 55%), linear-gradient(135deg, rgba(45,212,191,.22), rgba(99,102,241,.18));
            border-bottom: 1px solid rgba(2,6,23,.10);
            overflow: hidden;
        }

            .modalFancyTop::after {
                content: "";
                position: absolute;
                inset: -60%;
                background: conic-gradient(from 210deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.35) 12%, rgba(255,255,255,0) 24%, rgba(255,255,255,.25) 36%, rgba(255,255,255,0) 52%, rgba(255,255,255,.32) 70%, rgba(255,255,255,0) 100%);
                filter: blur(18px);
                opacity: .65;
                animation: modalShimmer 5.2s linear infinite;
                pointer-events: none;
            }

        @@keyframes modalShimmer {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .modalHeadRow {
            position: relative;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
        }

        .modalTitle {
            display: flex;
            flex-direction: column;
            gap: 6px;
            min-width: 0;
        }

            .modalTitle b {
                font-size: 18px;
                letter-spacing: -.4px;
                line-height: 1.2;
            }

        .modalCongrats {
            font-size: 13px;
            color: rgba(15,23,42,.80);
            font-weight: 800;
        }

        .modalCloseBtn {
            border: 1px solid rgba(2,6,23,.12);
            background: rgba(255,255,255,.92);
            color: var(--ink);
            border-radius: 14px;
            padding: 8px 10px;
            cursor: pointer;
            font-weight: 900;
            box-shadow: 0 10px 22px rgba(2,6,23,.08);
        }

        .modalBody {
            padding: 14px 16px 16px;
        }

        .modalMsg {
            margin: 4px 0 14px;
            color: rgba(15,23,42,.80);
            font-size: 13px;
            line-height: 1.55;
        }

        .modalBox {
            border: 1px solid rgba(2,6,23,.10);
            background: linear-gradient(180deg, rgba(248,250,252,.92), rgba(255,255,255,.92));
            border-radius: 18px;
            padding: 12px;
            box-shadow: 0 14px 34px rgba(2,6,23,.08);
        }

            .modalBox .row {
                display: flex;
                justify-content: space-between;
                gap: 10px;
                flex-wrap: wrap;
                font-size: 13px;
            }

                .modalBox .row b {
                    font-weight: 900;
                }

                .modalBox .row + .row {
                    margin-top: 8px;
                }

        .badgeStep {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: 999px;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(2,6,23,.10);
            box-shadow: 0 12px 26px rgba(2,6,23,.08);
            font-size: 12px;
            font-weight: 900;
            color: rgba(15,23,42,.85);
            margin-top: 10px;
            user-select: none;
        }

            .badgeStep i {
                width: 10px;
                height: 10px;
                border-radius: 999px;
                background: linear-gradient(135deg, rgba(34,197,94,.95), rgba(59,130,246,.95));
                display: inline-block;
            }

        .modalBtns {
            margin-top: 14px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

            .modalBtns .btn {
                flex: 1 1 170px;
                justify-content: center;
            }

        /* confetti */
        .confettiWrap {
            position: absolute;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .confetti {
            position: absolute;
            top: -18px;
            width: 10px;
            height: 16px;
            border-radius: 4px;
            opacity: .9;
            animation: confettiFall 1.9s ease-in forwards;
            filter: drop-shadow(0 10px 18px rgba(2,6,23,.20));
        }

        @@keyframes confettiFall {
            0% {
                transform: translateY(-20px) rotate(0deg);
                opacity: 0;
            }

            10% {
                opacity: 1;
            }

            100% {
                transform: translateY(620px) rotate(540deg);
                opacity: 0;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .bar > i, .btn, .card.click {
                transition: none !important;
            }

            .modalFancyTop::after {
                animation: none !important;
            }

            .confetti {
                animation: none !important;
                display: none !important;
            }
        }


        .heroTopCta {
            position: relative;
            z-index: 2;
            grid-column: span 12;
            width: 100%;
            margin: 14px 0;
        }

        .heroRankBtn {
            display: flex;
            align-items: center;
            gap: 14px;
            width: 100%;
            min-height: 84px;
            padding: 18px 20px;
            text-decoration: none;
            color: #fff;
            border-radius: 24px;
            border: 1px solid rgba(255,255,255,.28);
            background: radial-gradient(120% 160% at 0% 0%, rgba(255,255,255,.22), transparent 40%), radial-gradient(120% 160% at 100% 100%, rgba(255,255,255,.10), transparent 36%), linear-gradient(135deg, #14b8a6 0%, #2563eb 48%, #7c3aed 100%);
            box-shadow: 0 24px 48px rgba(37,99,235,.22), 0 18px 34px rgba(124,58,237,.18);
            position: relative;
            overflow: hidden;
            transition: transform .14s ease, box-shadow .14s ease, filter .14s ease;
        }

            .heroRankBtn::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.26) 50%, rgba(255,255,255,0) 100%);
                transform: translateX(-120%);
                animation: heroRankShine 3s ease-in-out infinite;
                pointer-events: none;
            }

        @@keyframes heroRankShine {
            0% {
                transform: translateX(-120%);
            }

            55% {
                transform: translateX(120%);
            }

            100% {
                transform: translateX(120%);
            }
        }

        .heroRankBtn:hover {
            transform: translateY(-2px);
            box-shadow: 0 30px 58px rgba(37,99,235,.28), 0 22px 40px rgba(124,58,237,.22);
            filter: saturate(1.05);
        }

        .heroRankBtnIcon {
            width: 54px;
            height: 54px;
            border-radius: 18px;
            display: grid;
            place-items: center;
            flex: 0 0 auto;
            font-size: 28px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.22);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.16);
            backdrop-filter: blur(6px);
        }

        .heroRankBtnText {
            display: flex;
            flex-direction: column;
            min-width: 0;
            line-height: 1.15;
            flex: 1 1 auto;
        }

            .heroRankBtnText small {
                font-size: 12px;
                font-weight: 800;
                opacity: .92;
                margin-bottom: 6px;
                letter-spacing: -.1px;
            }

            .heroRankBtnText b {
                font-size: 24px;
                font-weight: 1000;
                letter-spacing: -.5px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        .heroRankBtnArrow {
            flex: 0 0 auto;
            font-size: 24px;
            font-weight: 1000;
            opacity: .96;
        }

        @@media (max-width: 860px) {
            .heroRankBtn {
                min-height: 76px;
                padding: 16px 16px;
                gap: 12px;
                border-radius: 20px;
            }

            .heroRankBtnIcon {
                width: 48px;
                height: 48px;
                font-size: 24px;
                border-radius: 16px;
            }

            .heroRankBtnText b {
                font-size: 20px;
                white-space: normal;
            }

            .heroRankBtnArrow {
                font-size: 20px;
            }
        }
                
                </style>
</head>

<body>
    <!-- ✅ AntiForgery (Layout=null이라 직접 넣음) -->
    <form id="afForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <!-- ✅ 컨트롤러에서 온 값 바인딩 -->
    <div id="data"
         data-bible-point="@Model.BiblePoint"
         data-read-percent="@Model.BibleReadPercent"
         data-attendance-count="@Model.AttendanceCount"
         data-attendance-weeks-total="@Model.AttendanceWeeksTotal"
         data-attendance-point="@Model.AttendancePoint"
         data-missionbook-point="@Model.MissionBookPoint"
         data-evangelism-count="@Model.EvangelismCount"
         data-thanks-point="@Model.ThanksPointTotal"
         data-integrated-total="@Model.IntegratedTotal"
         data-integrated-goal="@integratedGoal"
         data-show-gift="@(Model.ShowGiftPopup ? "1" : "0")"
         data-popup-milestone="@Model.PopupMilestone"
         data-earned-credit="@Model.EarnedCredit"
         data-spent-credit="@Model.SpentCredit"
         data-available-credit="@Model.AvailableCredit"
         data-url-gift="@urlGift"></div>

    <div class="wrap">

        <header class="heroUnified">
            <div class="heroUInner">
                <div class="heroULeft">
                    <div class="brandRow">
                        <div class="logo">🌰</div>
                        <div class="brandText">
                            <div class="brandTitle">@topTitle · @ConstatsCommon.myDoToRi 보드</div>
                            <div class="hello">@helloText</div>
                        </div>
                    </div>

                    <div class="subline">
                        이 화면은 <b>통합 포인트 / 전도상</b> <b>2축</b>을 한 번에 확인하는 공간이에요.<br />
                        <b>출석카운트 × @ConstatsCommon.attendancePoint</b>도 통합 포인트에 함께 들어가요. 목표에 도달하면 <b>“선물을 받으세요”</b> 안내가 떠요!
                    </div>

                    <div class="miniRules">
                        <span class="pill"><i></i>2축 운영</span>
                        <span class="pill">🎯 부족한 영역 찾기</span>
                        <span class="pill">🎁 목표 달성 시 선물 안내</span>
                    </div>
                </div>

                <div class="heroURight">
                    <div class="heroTags">
                        <span class="heroTag"><span class="heroDot"></span>🌰 통합 포인트 · 전도상</span>
                    </div>

                    <div class="actions">
                        <!-- ✅ 이미 연결되어 있음 -->
                        @if (ViewBag.ShowGiftList)
                        {
                            <a class="btn rankAccent" href="@urlGift">🎁 내 선물함</a>
                        }
                        <a class="btn rankAccent" href="/StudentPointDashboard4/AdminPurchaseList">🎁 @ConstatsCommon.myDoToRi 선물받는 친구들</a>
                        <a class="btn homeAccent btnHomeRight" href="@urlHome">🏠 Home</a>
                    </div>
                </div>
            </div>
        </header>

        
        @await Html.PartialAsync("_Banner_IntMission_Notice_Once")

        <main class="grid">

                <div class="heroTopCta">
        <a class="heroRankBtn" href="/StudentPointDashboard4/TotalRank">
            <span class="heroRankBtnIcon">🏆</span>
            <span class="heroRankBtnText">
                <small>전체 친구들 현황 보기</small>
                        <b>도토리 친구들 한눈에 보기</b>
            </span>
            <span class="heroRankBtnArrow">→</span>
        </a>
    </div>

            <section class="card ax-int col-12 heroInt" id="integratedHero">         

                <div class="cardHead">
                    <div class="titleRow">
                        <div class="meta">
                            <small>1축</small>
                            <b style="font-size:20px;font-weight: 900;">@ConstatsCommon.myDoToRi · 통합 포인트</b>
                        </div>
                    </div>

                    <div class="heroGoal">
                        🎯 목표 <b>@integratedGoal.ToString("N0")</b>점
                    </div>
                </div>

                <!-- ✅ 통합포인트 + (획득/소멸/잔여) 포인트 3개 나란히 -->
                <div class="bigValue heroTotals">
                    <div class="totalMain">
                        <span class="num" data-out="integratedTotal">0</span>
                        <span class="unit">점</span>
                    </div>

                    <div class="pointStack" aria-label="획득/소멸/잔여 포인트">
                        <div class="pointPill" title="통합 포인트 달성으로 지금까지 획득한 누적 포인트">
                            <span class="k">소멸 포인트</span>
                            <span class="v">@((Model?.SpentMilestone ?? 0).ToString("N0"))</span><span class="u">점</span>
                        </div>

                        <div class="pointPill" title="선물 지급/구매완료 등으로 소멸된 포인트">
                            <span class="k">잔여 포인트</span>
                            <span class="v">@((Model.IntegratedTotal - (Model?.SpentMilestone ?? 0)).ToString("N0"))</span><span class="u">점</span>
                        </div>
                    </div>
                </div>

                <div class="bar"><i data-bar="integratedTotal"></i></div>

                <div class="subHint" style="margin-top:12px; font-size:13px;">
                    <b>@($"{@ConstatsCommon.MainKeyTitle} · 출석카운트×{@ConstatsCommon.attendancePoint} · {@ConstatsCommon.MissionBibleWithparent} · {@ConstatsCommon.HolyWordAndRead}")</b>를 합쳐서 계산해요.<br />
                    목표에 도달하면 <b>선물 안내</b>가 자동으로 떠요 🎁
                </div>
            </section>

            <section class="groupBox">
                <div class="groupTitle">
                    <div class="groupTitleLeft">
                        <div class="groupBadge">📦</div>
                        <div>
                            <h3>통합 구성 ①~④ (한 묶음)</h3>
                            <p>아래 4개가 합쳐져서 “@ConstatsCommon.myDoToRi · 통합 포인트”가 돼요</p>
                        </div>
                    </div>
                    <div class="pill" style="margin:0;">
                        <i></i>4개 항목 합산
                    </div>
                </div>

                <div class="groupGrid">
                    <section class="card click c-bible col-6" onclick="location.href='@urlChallengeMain'">
                        <div class="cardHead">
                            <div class="titleRow">
                                <div class="icon">📖</div>
                                <div class="meta">
                                    <small>통합 구성 ①</small>
                                    <b>@ConstatsCommon.MainKeyTitle</b>
                                </div>
                            </div>
                        </div>
                        <div class="bigValue"><span class="num" data-out="biblePoint">0</span><span class="unit">점</span></div>
                        <div class="bar"><i data-bar="biblePoint"></i></div>
                        <div class="subHint">말씀 읽기/퀴즈/기도/암송으로 포인트가 올라가요!</div>
                    </section>

                    <section class="card click c-mb col-6" onclick="location.href='@urlWorldview'">
                        <div class="cardHead">
                            <div class="titleRow">
                                <div class="icon">📒</div>
                                <div class="meta">
                                    <small>통합 구성 ②</small>
                                    <b>@ConstatsCommon.MissionBibleWithparent</b>
                                </div>
                            </div>
                        </div>
                        <div class="bigValue"><span class="num" data-out="missionBookPoint">0</span><span class="unit">점</span></div>
                        <div class="bar"><i data-bar="missionBookPoint"></i></div>
                        <div class="subHint">미션북을 채우면 믿음이 더 단단해져요 💪</div>
                    </section>

                    <section class="card click c-thx col-12" onclick="location.href='@urlThanksDetail'">
                        <div class="cardHead">
                            <div class="titleRow">
                                <div class="icon">🌼</div>
                                <div class="meta">
                                    <small>통합 구성 ③</small>
                                    <b>@ConstatsCommon.HolyWordAndRead</b>
                                </div>
                            </div>
                        </div>
                        <div class="bigValue"><span class="num" data-out="thanksPoint">0</span><span class="unit">점</span></div>
                        <div class="bar"><i data-bar="thanksPoint"></i></div>
                        <div class="subHint">감사를 적으면 마음이 따뜻해져요. 오늘 감사 1가지 적어볼까? 😊</div>
                    </section>

                    <section class="card click ax-att col-12" onclick="location.href='@urlAttendance'">
                        <div class="cardHead">
                            <div class="titleRow">
                                <div class="icon">⛪</div>
                                <div class="meta">
                                    <small>통합 구성 ④</small>
                                    <b>출석카운트 × @ConstatsCommon.attendancePoint</b>
                                </div>
                            </div>
                        </div>
                        <div class="bigValue">
                            <span>
                                <span class="num" data-out="attendancePoint">0</span><span class="unit">점</span>
                            </span>
                            <span class="sideBadge">
                                <b data-out="attendanceCount">0</b>/<b data-out="attendanceWeeksTotal">0</b>주
                            </span>
                        </div>
                        <div class="bar"><i data-bar="attendancePoint"></i></div>
                        <div class="subHint">올해는 총 <b data-out="attendanceWeeksTotal">0</b>주 중 <b data-out="attendanceCount">0</b>주 출석했고, 출석카운트 × @(@ConstatsCommon.attendancePoint)로 통합 포인트에 들어가요 🙏</div>
                    </section>
                </div>
            </section>
        </main>
        <div class="sectionTitle">
            <h2>전도상</h2>
            <span>별도 축으로 확인해요</span>
        </div>

        <main class="grid">
            <section class="card click ax-ev col-12" onclick="alert('전도 기록 화면 연결 예정이에요! 😀')">
                <div class="cardHead">
                    <div class="titleRow">
                        <div class="icon">🤝</div>
                        <div class="meta">
                            <small>2축</small>
                            <b>전도상</b>
                        </div>
                    </div>
                </div>
                <div class="bigValue"><span class="num" data-out="evangelism">0</span><span class="unit">명</span></div>
                <div class="bar"><i data-bar="evangelism"></i></div>
                <div class="subHint">친구에게 교회 이야기를 전하면 사랑이 전해져요 💗</div>
            </section>
        </main>

        <div class="sectionTitle" style="margin-top:18px;">
            <h2>참고 지표</h2>
            <span>통합포인트에는 포함되지 않아요</span>
        </div>

        <main class="grid">
            <section class="card click c-read col-12" onclick="location.href='@urlBibleReading'">
                <div class="cardHead">
                    <div class="titleRow">
                        <div class="icon">🏁</div>
                        <div class="meta">
                            <small>참고 지표</small>
                            <b>도전!!! 성경66권 완독 진행률</b>
                        </div>
                    </div>
                </div>
                <div class="bigValue"><span class="num" data-out="readPercent">0</span><span class="unit">%</span></div>
                <div class="bar"><i data-bar="readPercent"></i></div>
                <div class="subHint">※ 성경완독은 “통합포인트”에 포함하지 않고, 진행률로만 보여줘요.</div>
            </section>
        </main>

        <div class="sectionTitle" style="margin-top:18px;">
            <h2>통합 포인트 열람</h2>
            <span>전체 현황을 한 번에 확인해요</span>
        </div>

        <main class="grid">
            <section class="card rankCta col-12">
                <div class="rankCtaInner">
                    <div class="rankCtaLeft">
                        <h3 class="rankCtaTitle">📊 “다른 아이들은, 지금 어디쯤 왔을까?”</h3>
                        <p class="rankCtaDesc">
                            통합포인트는 경쟁보다 <b>서로를 응원</b>하기 위한 “확인용 화면”이에요.<br />
                            누가 얼마나 열심히 했는지 보기보다, <b>함께 달려가는 분위기</b>를 만드는 데 사용해 주세요 😊
                        </p>
                        <div class="rankHintPills">
                            <span class="pill"><i></i>확인용(열람)</span>
                            <span class="pill">👀 전체 현황 보기</span>
                            <span class="pill">🤍 응원 포인트</span>
                        </div>
                    </div>

                    <div class="rankCtaRight">
                        <a class="btn rankAccent" href="@urlIntegratedRank">📈 통합 포인트 열람하러 가기</a>
                    </div>
                </div>
            </section>
        </main>

        <div class="footer">
            © 2026 @ChurchName · @DepartmentName
        </div>
    </div>

    <!-- ✅ 선물 팝업 (화려 버전) -->
    <div class="modalBack" id="giftModalBack" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="modal" id="giftModal">
            <div class="confettiWrap" id="confettiWrap"></div>

            <div class="modalFancyTop">
                <div class="modalHeadRow">
                    <div class="modalTitle">
                        <b>🎁 선물 선택 시간!</b>
                        <div class="modalCongrats" id="giftCongratsLine">🎉 0포인트 도달 축하해요!</div>
                    </div>
                    <button type="button" class="modalCloseBtn" id="giftCloseBtn">닫기</button>
                </div>
                <div class="badgeStep">
                    <i></i> 이번 단계: <span id="giftStepBadge">0</span>포인트 선물
                </div>
            </div>

            <div class="modalBody">
                <div class="modalMsg" id="giftMsgLine">
                    <b>선택 가능한 선물이 열렸어요!</b><br />
                    이번은 <b>100포인트 단계</b>에 해당하는 선물을 선택해 주세요 😊
                </div>

                <div class="modalBox">
                    <div class="row"><span>내 통합포인트</span><b><span id="giftTotalText">0</span> 점</b></div>
                    <div class="row"><span>이번 단계(마일스톤)</span><b><span id="giftMilestoneText">0</span> 점</b></div>
                </div>

                <div class="modalBtns">
                    <a class="btn primary" id="giftGoBtn" href="@urlGift">🎁 선물 선택하러 가기</a>
                    <button class="btn" type="button" data-act="accumulate">누적(적립하기)</button>
                    <button class="btn" type="button" data-act="later">다음에 결정할래요</button>
                    <button class="btn" type="button" data-act="defer3">3일후에 결정할래</button>
                    <button class="btn" type="button" data-act="defer7">7일후에 결정할래</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const root = document.getElementById('data');

            const raw = {
                biblePoint: Number(root.dataset.biblePoint || 0),
                readPercent: Number(root.dataset.readPercent || 0),
                attendanceCount: Number(root.dataset.attendanceCount || 0),
                attendanceWeeksTotal: Number(root.dataset.attendanceWeeksTotal || 0),
                attendancePoint: Number(root.dataset.attendancePoint || 0),
                missionBookPoint: Number(root.dataset.missionbookPoint || 0),
                evangelismCount: Number(root.dataset.evangelismCount || 0),

                // ✅ 서버 값(정답)
                thanksFallback: Number(root.dataset.thanksPoint || 0),
                integratedTotalServer: Number(root.dataset.integratedTotal || 0),

                integratedGoal: Number(root.dataset.integratedGoal || 2000),

                // ✅ 서버 판단(정답)
                showGift: String(root.dataset.showGift || "0") === "1",
                popupMilestone: Number(root.dataset.popupMilestone || 0),

                urlGift: String(root.dataset.urlGift || "")
            };

            function clamp(n, min, max) { return Math.max(min, Math.min(max, n)); }

            const max = {
                evangelism: 10,
                biblePoint: 300,
                attendancePoint: 120,
                missionBookPoint: 200,
                thanksPoint: 200
            };

            function setText(key, value) {
                document.querySelectorAll(`[data-out='${key}']`).forEach(el => el.textContent = String(value));
            }

            function setBar(key, pct) {
                const el = document.querySelector(`[data-bar='${key}']`);
                if (!el) return;
                const p = clamp(pct, 0, 100);
                requestAnimationFrame(() => setTimeout(() => el.style.width = p.toFixed(1) + "%", 60));
            }

            function computeIntegrated(thanksPoint) {
                return raw.biblePoint + raw.attendancePoint + raw.missionBookPoint + Number(thanksPoint || 0) + (raw.evangelismCount * 50);
            }

            // ✅ 팝업 "한 번만" 열리도록 가드
            let modalOpenedOnce = false;

            function render(thanksPoint) {
                // 출석카운트 × 2 (통합 구성)
                const attendanceCount = clamp(raw.attendanceCount, 0, 999);
                const attendanceWeeksTotal = clamp(raw.attendanceWeeksTotal, 0, 999);
                const attendancePoint = clamp(raw.attendancePoint, 0, 999999);
                setText("attendanceCount", attendanceCount);
                setText("attendanceWeeksTotal", attendanceWeeksTotal);
                setText("attendancePoint", attendancePoint);
                if (attendancePoint > max.attendancePoint) max.attendancePoint = Math.ceil(attendancePoint / 20) * 20;
                setBar("attendancePoint", max.attendancePoint ? (attendancePoint / max.attendancePoint) * 100 : 0);

                // 전도
                const ev = clamp(raw.evangelismCount, 0, max.evangelism);
                setText("evangelism", ev);
                setBar("evangelism", max.evangelism ? (ev / max.evangelism) * 100 : 0);

                // 통합 구성
                // ✅ 숫자 표시는 실제값, 바 차트 길이만 max로 제한
                const bp = clamp(raw.biblePoint, 0, max.biblePoint);
                setText("biblePoint", raw.biblePoint);   // 실제 점수 그대로 표시
                setBar("biblePoint", max.biblePoint ? (bp / max.biblePoint) * 100 : 0);

                const mb = clamp(raw.missionBookPoint, 0, max.missionBookPoint);
                setText("missionBookPoint", mb);
                setBar("missionBookPoint", max.missionBookPoint ? (mb / max.missionBookPoint) * 100 : 0);

                const tp = clamp(Number(thanksPoint || 0), 0, 999999);
                setText("thanksPoint", tp);
                if (tp > max.thanksPoint) max.thanksPoint = Math.ceil(tp / 50) * 50;
                setBar("thanksPoint", max.thanksPoint ? (tp / max.thanksPoint) * 100 : 0);

                // 완독(참고)
                const rp = clamp(raw.readPercent, 0, 100);
                setText("readPercent", rp);
                setBar("readPercent", rp);

                // 통합
                const integrated = computeIntegrated(tp);
                setText("integratedTotal", integrated);

                const goal = Math.max(1, raw.integratedGoal);
                setBar("integratedTotal", (integrated / goal) * 100);

                const hero = document.getElementById("integratedHero");
                if (hero) hero.classList.toggle("isGoal", integrated >= goal);

                maybeShowGiftModal(integrated);
            }

            function openModal(total) {
                const back = document.getElementById("giftModalBack");
                if (!back) return;

                const milestone = Number(raw.popupMilestone || 0);
                document.getElementById("giftTotalText").textContent = String(total);
                document.getElementById("giftMilestoneText").textContent = String(milestone);

                // ✅ 화려 문구
                const congrats = document.getElementById("giftCongratsLine");
                const stepBadge = document.getElementById("giftStepBadge");
                const msgLine = document.getElementById("giftMsgLine");

                if (congrats) congrats.textContent = `🎉 ${milestone}포인트 도달 축하해요!`;
                if (stepBadge) stepBadge.textContent = String(milestone);

                // “100포에 해당하는 선물 선택” 문구 (마일스톤에 맞춰 자동)
                if (msgLine) {
                    msgLine.innerHTML = `
                        <b>선택 가능한 선물이 열렸어요!</b><br/>
                        이번은 <b>${milestone}포인트 단계</b>에 해당하는 선물을 선택해 주세요 😊
                    `;
                }

                // ✅ 폭죽(Confetti) 뿌리기
                burstConfetti();

                back.style.display = "flex";
                back.setAttribute("aria-hidden", "false");
            }

            function closeModal() {
                const back = document.getElementById("giftModalBack");
                if (!back) return;
                back.style.display = "none";
                back.setAttribute("aria-hidden", "true");

                // confetti 정리
                const wrap = document.getElementById("confettiWrap");
                if (wrap) wrap.innerHTML = "";
            }

            function maybeShowGiftModal(total) {
                if (!raw.showGift) return;
                if (modalOpenedOnce) return;
                modalOpenedOnce = true;
                openModal(total);
            }

            // ✅ Anti-Forgery 토큰 읽기
            function getAfToken() {
                const input = document.querySelector("#afForm input[name='__RequestVerificationToken']");
                return input ? input.value : "";
            }

            // PopupActionType 매핑 (프로젝트 enum과 다르면 수정)
            const actionMap = {
                accumulate: 0,
                later: 1,
                defer3: 2,
                defer7: 3,
                go_pick: 4
            };

            async function postPopupAction(actionKey, keepalive) {
                const milestone = Number(raw.popupMilestone || 0);
                const actionType = actionMap[actionKey];
                if (!milestone || actionType === undefined) return;

                const token = getAfToken();
                return fetch("/StudentPointDashboard4/PopupAction", {
                    method: "POST",
                    credentials: "same-origin",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": token
                    },
                    body: JSON.stringify({ milestone: milestone, actionType: actionType }),
                    keepalive: !!keepalive
                });
            }

            // ✅ 폭죽 생성
            function burstConfetti() {
                const wrap = document.getElementById("confettiWrap");
                const modal = document.getElementById("giftModal");
                if (!wrap || !modal) return;

                wrap.innerHTML = "";
                const rect = modal.getBoundingClientRect();
                const W = rect.width;

                // 28개 정도면 “화려하지만 과하지 않게”
                const count = 28;

                for (let i = 0; i < count; i++) {
                    const el = document.createElement("span");
                    el.className = "confetti";

                    // 위치
                    const left = Math.random() * (W - 10);
                    el.style.left = left.toFixed(1) + "px";

                    // 크기/시간 랜덤
                    const w = 8 + Math.random() * 8;
                    const h = 12 + Math.random() * 14;
                    el.style.width = w.toFixed(0) + "px";
                    el.style.height = h.toFixed(0) + "px";

                    const dur = 1.4 + Math.random() * 1.2;
                    const delay = Math.random() * 0.25;
                    el.style.animationDuration = dur.toFixed(2) + "s";
                    el.style.animationDelay = delay.toFixed(2) + "s";

                    // 색 랜덤(그린/블루/민트/보라 계열)
                    const colors = [
                        "linear-gradient(135deg, rgba(34,197,94,.95), rgba(16,185,129,.90))",
                        "linear-gradient(135deg, rgba(59,130,246,.95), rgba(99,102,241,.90))",
                        "linear-gradient(135deg, rgba(45,212,191,.95), rgba(34,211,238,.90))",
                        "linear-gradient(135deg, rgba(167,139,250,.95), rgba(59,130,246,.85))"
                    ];
                    el.style.background = colors[(Math.random() * colors.length) | 0];

                    wrap.appendChild(el);

                    // 끝나면 제거
                    setTimeout(() => { try { el.remove(); } catch { } }, (dur + delay + 0.2) * 1000);
                }
            }

            // ✅ 닫기/백드롭/버튼 클릭
            document.addEventListener("click", (e) => {
                const t = e.target;

                if (t && t.id === "giftCloseBtn") return closeModal();
                if (t && t.id === "giftModalBack") return closeModal();

                const act = t && t.dataset && t.dataset.act;
                if (!act) return;

                postPopupAction(act, false)
                    .catch(() => { })
                    .finally(() => closeModal());
            });

            // ✅ "선물 선택하러 가기" 클릭 시도 기록(선택)
            const goBtn = document.getElementById("giftGoBtn");
            if (goBtn) {
                goBtn.addEventListener("click", () => {
                    postPopupAction("go_pick", true).catch(() => { });
                });
            }

            // 1) 서버 fallback 렌더(즉시 표시)
            render(raw.thanksFallback);

            // 2) 감사 누적 총점 AJAX로 덮어쓰기(선택)
            fetch('@urlThanksTotalApi', { method: 'GET', credentials: 'same-origin' })
                .then(r => r.json())
                .then(res => {
                    if (!res || res.ok !== true) return;
                    const totalPoints = Number(res.totalPoints || 0);
                    render(totalPoints);
                })
                .catch(() => { });
        })();
    </script>
    <script src="/js/GlobalCookie.js"></script>

</body>
</html>
