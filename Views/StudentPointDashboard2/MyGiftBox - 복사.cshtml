        }

        .stats {
            display: grid;
            grid-template-columns: repeat(12,1fr);
            gap: 12px;
            margin-top: 12px
        }

        .stat {
            grid-column: span 6;
            border: 1px solid var(--line);
            border-radius: 18px;
            background: rgba(255,255,255,.86);
            padding: 12px;
            box-shadow: 0 10px 22px rgba(2,6,23,.06);
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        @@media (min-width: 780px) { .stat { grid-column: span 3; } }

        .k { font-size: 12px; color: var(--muted); font-weight: 900; display:flex; align-items:center; gap:6px; }
        .k .dot{ width:8px; height:8px; border-radius:99px; background: linear-gradient(135deg,var(--pri1),var(--pri2)); display:inline-block; }
        .v { font-size: 20px; font-weight: 1000; letter-spacing: -.4px }

        .currentBox {
