        }
        .currentName { margin:0; font-weight:1000; }
        .currentMeta { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
        .miniPill {
            border: 1px solid var(--line);
            background: rgba(255,255,255,.9);
            border-radius: 999px;
            padding: 6px 10px;
            font-size: 12px;
            color: var(--muted);
            font-weight: 900;
        }
        .miniPill b{ color: var(--ink); }

        .miniBtn {
            border: 0;
            border-radius: 14px;
