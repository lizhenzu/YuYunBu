            border: 0;
            color: #fff;
            background: linear-gradient(135deg,var(--pri1),var(--pri2));
            box-shadow: 0 16px 34px rgba(34,197,94,.18), 0 14px 30px rgba(59,130,246,.16);
        }
               .btn.secondary {
                border: 0;
                background: linear-gradient(135deg, rgba(59,130,246,.95), rgba(99,102,241,.95));
                color: #fff;
            }
        
        .btn.danger{
            border:0;
            background: linear-gradient(135deg, rgba(239,68,68,.95), rgba(244,63,94,.95));
            color:#fff;
            box-shadow: 0 16px 34px rgba(239,68,68,.18), 0 14px 30px rgba(244,63,94,.16);
        }
.grid {
            display: grid;
            grid-template-columns: repeat(12,1fr);
            gap: 12px;
            margin-top: 14px
        }

        .card {
            grid-column: span 12;
