            backdrop-filter: blur(10px);
            border-radius: var(--r);
            box-shadow: var(--shadow2);
            padding: 14px;
            overflow: hidden;
        }

        .cardHead { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap }
        .cardTitle { margin: 0; font-weight: 900; font-size: 15px; letter-spacing: -.2px }

        .pill {
            border: 1px solid var(--line);
            background: rgba(255,255,255,.92);
            border-radius: 999px;
            padding: 8px 10px;
            font-size: 12px;
            color: var(--muted);
            display: inline-flex;
            align-items: center;
            gap: 8px;
