        }
        .miniBtn.primary{
            color:#fff;
            background: linear-gradient(135deg,var(--pri1),var(--pri2));
        }
        .miniBtn.ghost{
            background: rgba(255,255,255,.92);
            color: var(--ink);
            border: 1px solid var(--line);
        }

        .giftGrid { display:grid; grid-template-columns: repeat(12,1fr); gap:12px; }
        .giftCard {
            grid-column: span 12;
            border: 1px solid var(--line);
            background: rgba(255,255,255,.92);
            border-radius: var(--r);
            box-shadow: var(--shadow2);
            overflow: hidden;
            display:flex;
            gap: 12px;
            padding: 12px;
            align-items: center;
        }
        @@media (min-width: 780px) { .giftCard { grid-column: span 6; } }
        @@media (min-width: 1020px) { .giftCard { grid-column: span 4; } }

        .gImg{
            width: 64px; height: 64px; border-radius: 18px;
            object-fit: cover;
            border: 1px solid var(--line);
            background: #fff;
            flex: 0 0 auto;
        }
        .gMain{ min-width:0; flex:1; }
        .gName{ margin:0; font-weight:1000; }
        .gDesc{ margin:6px 0 0; color: var(--muted); font-size: 12px; line-height:1.4; }
        .gRight{ display:flex; flex-direction:column; gap:8px; align-items:flex-end; }
        .pricePill{
            border-radius: 999px;
            padding: 7px 10px;
            font-size: 12px;
            font-weight: 1000;
            background: rgba(34,197,94,.10);
            border: 1px solid rgba(34,197,94,.25);
        }

        .hGrid{ display:grid; grid-template-columns: repeat(12,1fr); gap:12px; margin-top:12px; }
        .hCard{
            grid-column: span 12;
            border: 1px solid var(--line);
            background: rgba(255,255,255,.92);
            border-radius: var(--r);
            box-shadow: var(--shadow2);
            overflow:hidden;
            padding: 12px;
        }
        .hTopRow{ display:flex; gap:12px; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; }
        .hImg{
            width: 64px; height: 64px; border-radius: 18px;
            object-fit: cover;
            border: 1px solid var(--line);
            background: #fff;
        }
        .hMain{ flex:1; min-width: 200px; }
        .hName{ margin:0; font-weight:1000; }

        .sBadge{
            border-radius: 999px;
            padding: 7px 10px;
            font-size: 12px;
            font-weight: 1000;
            border: 1px solid var(--line);
            background: rgba(255,255,255,.92);
        }
        .sBadge.purchased{
            color:#0b5;
            border-color: rgba(34,197,94,.35);
            background: rgba(34,197,94,.10);
        }
        .sBadge.canceled{
            color:#f97316;
            border-color: rgba(249,115,22,.35);
            background: rgba(249,115,22,.10);
        }
        .sBadge.hidden{
            color:#64748b;
