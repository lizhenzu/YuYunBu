@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@using Microsoft.Extensions.Configuration;
@using System.Data;
@using System.Data.SqlClient;
@using System.Collections.Generic;
@using System.Linq;

@inject IConfiguration Configuration
@{

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}

@model GiftBoxVM
@{
    var user = await AuthService.GetSignedUser(User);
    var isSignedIn = await AuthService.IsSignedIn(User);
    var isSuperAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.SuperAdmin));
    var isAdmin = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Admin));
    var isBasic = isSignedIn && await AuthService.IsInRole(user, nameof(Roles.Basic));
}
@{
    Layout = null;

    string N(int v) => v.ToString("N0");

    string StatusKo(string s) => (s ?? "").ToUpperInvariant() switch
    {
        "DRAFT" => "선택 중(재선택 가능)",
        "PURCHASED" => "구매 완료(변경 불가)",
        "CANCELED_BY_RESELECT" => "재선택으로 변경됨",
        "CANCELED_BY_UPGRADE" => "상위 점수 도달로 자동 변경",
        "HIDDEN" => "숨김",
        _ => s ?? "-"
    };

    // (선택) 상태별 배지 클래스
    string StatusBadgeClass(string s) => (s ?? "").ToUpperInvariant() switch
    {
        "PURCHASED" => "purchased",
        "CANCELED_BY_RESELECT" => "canceled",
        "CANCELED_BY_UPGRADE" => "canceled",
        "HIDDEN" => "hidden",
        _ => ""
    };

    // ✅ [버그 수정 핵심]
    // CreditCostSnapshot은 "선물가격"이 아니라 "그 시점에 소멸 처리할 잔여 credit(=AvailableCredit)"이 저장됨.
    // credit은 dbo.StudentPointMilestoneCredit의 누적합으로 계산되므로, 단순히 credit/5000*100 같은 계산은 오답이 될 수 있음.
    // 해결: StudentPointMilestoneCredit를 읽어서 누적 credit → milestone point로 역매핑한다.
    var milestoneCumCredits = new List<(int MilestonePoint, int CumCredit)>();

    try
    {
        var connStr = Configuration.GetConnectionString("DefaultConnection");
        if (!string.IsNullOrWhiteSpace(connStr))
        {
            using var conn = new SqlConnection(connStr);
            await conn.OpenAsync();

            using var cmd = new SqlCommand(@"
SELECT MilestonePoint, Credit
FROM dbo.StudentPointMilestoneCredit WITH (NOLOCK)
WHERE IsActive=1
ORDER BY MilestonePoint ASC;", conn);

            using var r = await cmd.ExecuteReaderAsync();
            int cum = 0;

            while (await r.ReadAsync())
            {
                var mp = r.GetInt32(0);
                var c = r.GetInt32(1);

                cum += c;
                milestoneCumCredits.Add((mp, cum));
            }
        }
    }
    catch
    {
        // 테이블 접근 실패 시에도 페이지는 뜨게(표시만 fallback)
        milestoneCumCredits = new List<(int MilestonePoint, int CumCredit)>();
    }

    int ToMilestonePointFromCredit(int credit)
    {
        if (credit <= 0) return 0;

        // ✅ 정상 루트: 누적 credit과 정확히 매칭되는 milestone을 찾는다.
        // (보통 선택 시점의 AvailableCredit = 해당 milestone까지 누적 earned 이라 exact match가 많음)
        if (milestoneCumCredits.Count > 0)
        {
            // 1) exact match 우선
            var exact = milestoneCumCredits.FirstOrDefault(x => x.CumCredit == credit);
            if (exact.MilestonePoint > 0) return exact.MilestonePoint;

            // 2) exact가 아니면: credit 이하 중 가장 큰 milestone(가장 근접한 하위 마일스톤)
            var below = milestoneCumCredits
                .Where(x => x.CumCredit <= credit)
                .OrderByDescending(x => x.CumCredit)
                .FirstOrDefault();

            if (below.MilestonePoint > 0) return below.MilestonePoint;

            return 0;
        }

        // ✅ fallback (DB 조회 실패 등)
        // 너무 공격적으로 잘못 표시되는 것보단 0이 낫다.
        return 0;
    }
}

<!doctype html>
<html lang="ko">
<head>
