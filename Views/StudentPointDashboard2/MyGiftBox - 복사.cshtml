        }
    </style>
</head>
<body>
<div class="wrap">
    <header>
        <div class="hTop">
            <div>
                <h1 class="title">
                    <span class="badge">🎁</span>
                    내 선물함
                </h1>
                <p class="sub">통합 포인트 달성으로 모은 credit으로 선물을 선택하고, 구매 완료까지 확인할 수 있어요.</p>
            </div>

            <div class="btnRow">
                    <a class="btn" href="/">🏠 Home</a>
                    <a class="btn" href="/StudentPointDashboard4/Index">🌰 @ConstatsCommon.myDoToRi 홈</a>
     @if (isSuperAdmin || isAdmin)
                        {
                            <a class="btn secondary" href="/StudentPointDashboard4/AdminPurchaseList">🛠️ 관리자</a>
                        }
            </div>
        </div>

        <div class="stats">
            <div class="stat">
                <div class="k"><span class="dot"></span>통합 포인트</div>
                <div class="v">@N(Model?.IntegratedTotal ?? 0)</div>
            </div>
            <div class="stat">
                <div class="k"><span class="dot"></span>사용완료 포인트</div>
                <div class="v">@N(Model?.SpentMilestone ?? 0)</div>
            </div>
           <div class="stat">
    <div class="k"><span class="dot"></span>사용가능 포인트</div>
    <div class="v">@N((Model?.IntegratedTotal ?? 0) - (Model?.SpentMilestone ?? 0))</div>
</div>

                @if (isSuperAdmin || isAdmin)
                {
                    <div class="stat">
                        <div class="k"><span class="dot"></span>획득 credit</div>
                        <div class="v">@N(Model?.EarnedCredit ?? 0)</div>
                    </div>
                    <div class="stat">
                        <div class="k"><span class="dot"></span>잔여 credit</div>
                        <div class="v">@N(Model?.AvailableCredit ?? 0)</div>
                    </div>
                }
        </div>
    </header>

    <div class="grid">

        <!-- 현재 선택 (DRAFT) -->
        <section class="card">
            <div class="cardHead">
                <h2 class="cardTitle">현재 선택</h2>
                <span class="pill"><i></i>DRAFT는 구매 전 상태</span>
            </div>

            @if (Model.CurrentDraft == null)
            {
                <p class="sub" style="margin:10px 0 0;">현재 선택된 선물이 없습니다. 선물 선택 페이지에서 골라주세요.</p>
            }
            else
            {
                var d = Model.CurrentDraft;
                var dImg = (d.ImageUrl ?? "").Trim();
                if (string.IsNullOrWhiteSpace(dImg)) { dImg = "/images/gift-placeholder.png"; }

                <div class="currentBox" style="margin-top:12px;">
                    <div class="currentLeft">
                        <img class="currentImg" src="@dImg" alt="@d.ProductName" />
                        <div>
                            <p class="currentName">@d.ProductName</p>
                            <div class="currentMeta">
                                <span class="miniPill">상태: <b>@StatusKo(d.Status)</b></span>
                                <span class="miniPill">선택일: <b>@d.CreatedAt.ToString("yyyy-MM-dd HH:mm")</b></span>

                                @if (@d.Milestone > 0)
                                {
                                    <span class="miniPill">마일스톤: <b>@d.Milestone</b></span>
                                }
                                    @if (isSuperAdmin || isAdmin)
                                {
                                <span class="miniPill">소멸 credit: <b>@N(d.CreditCostSnapshot)</b></span>
                                }
                            </div>
                        </div>
                    </div>              
                </div>

 

                <div class="btnRow" style="margin-top:12px;">
                    <form method="post" action="@Url.Action("CancelGift", "StudentPointDashboard2")"
                          onsubmit="return confirm('선물을 취소하면 완전히 삭제됩니다. 정말 취소할까요?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@d.OrderId" />
                        <button type="submit" class="btn danger">🗑️ 선택 취소(삭제)</button>
                    </form>
                </div>

@*                 <p class="sub" style="margin:10px 0 0;">
                    ※ 재선택하면 기존 선택(DRAFT/취소류)은 DB에서 삭제됩니다. (요구사항 반영)
                </p>
 *@            }
        </section>

        <!-- 지금 가능한 선물 -->
        <section class="card">
            <div class="cardHead">
                <h2 class="cardTitle">지금 가능한 선물</h2>
                <span class="pill"><i></i>잔여 credit 기준</span>
            </div>

            @if (Model.AffordableGifts == null || Model.AffordableGifts.Count == 0)
            {
                <p class="sub" style="margin:10px 0 0;">현재 잔여 credit으로 선택 가능한 선물이 없습니다.</p>
            }
            else
            {
                <div class="giftGrid" style="margin-top:12px;">
                    @foreach (var g in Model.AffordableGifts)
                    {
                        var img = (g.ImageUrl ?? "").Trim();
                        if (string.IsNullOrWhiteSpace(img)) { img = "/images/gift-placeholder.png"; }

                        <div class="giftCard">
                            <img class="gImg" src="@img" alt="@g.ProductName" />
                            <div class="gMain">
                                <p class="gName">@g.ProductName</p>
                                @if (!string.IsNullOrWhiteSpace(g.ProductDescription))
                                {
                                    <p class="gDesc">@g.ProductDescription</p>
                                }
                            </div>
                            <div class="gRight">
                                @if(isSuperAdmin || isAdmin)
                                {
                                <span class="pricePill">💳 @N(g.UnitPrice) credit</span>
                                }

                                <form method="post" action="/StudentPointDashboard4/SelectGift">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@g.ProductID" />
                                    <button type="submit" class="miniBtn primary">선택</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- 이력 -->
        <section class="card">
            <div class="cardHead">
                <h2 class="cardTitle">선물 선택 이력</h2>
                <span class="pill"><i></i>최근 50건</span>
            </div>

            @if (Model.History == null || Model.History.Count == 0)
            {
                <p class="sub" style="margin:10px 0 0;">이력이 아직 없어요.</p>
            }
            else
            {
                <div class="hGrid">
                    @foreach (var h in Model.History)
                    {
                        var img = (h.ImageUrl ?? "").Trim();
                        if (string.IsNullOrWhiteSpace(img)) { img = "/images/gift-placeholder.png"; }

                        var badgeClass = StatusBadgeClass(h.Status);
                        var milestonePoint = ToMilestonePointFromCredit(h.CreditCostSnapshot);

                        <article class="hCard">
                            <div class="hTopRow">
                                <img class="hImg" src="@img" alt="@h.ProductName" />

                                <div class="hMain">
                                    <p class="hName">@h.ProductName</p>
                                </div>

                                <span class="sBadge @badgeClass">@StatusKo(h.Status)</span>
                            </div>

                            <div class="hMetaRow">
                                <span class="hPill">🕒 <b>@h.CreatedAt.ToString("yyyy-MM-dd HH:mm")</b></span>

                                <span class="hPill">
                                    🎯 시상<b>@h.Milestone</b>포인트
                                </span>

                                @if (isSuperAdmin || isAdmin)
                                {
                                    <span class="hPill">💳 소멸 credit <b>@N(h.CreditCostSnapshot)</b></span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

    </div>

    <div class="footer">
       © @DateHelper.GetKoreaNow().Year @ChurchName · @DepartmentName
    </div>
</div>
</body>
</html>
