@model List<BulletinBoard.Models.AwardItem>
@using BulletinBoard.Helpers

@{
    Layout = null;
    var studentUserName = ViewBag.StudentUserName as string ?? "";
    var teamName        = ViewBag.TeamName        as string ?? "";
    var milestone       = (int)(ViewBag.Milestone ?? 1000);
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>🎁 선물 선택 — @teamName</title>
<style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

:root {
    --bg:     #f0f4ff;
    --white:  #ffffff;
    --pri:    #4f46e5;
    --pri2:   #6366f1;
    --pri-lt: #eef2ff;
    --pri-md: #c7d2fe;
    --text:   #1e293b;
    --text2:  #475569;
    --muted:  #94a3b8;
    --border: #e2e8f0;
}

html, body {
    min-height: 100vh;
    background: var(--bg);
    font-family: "Noto Sans KR", system-ui, -apple-system, sans-serif;
    color: var(--text);
}

.page {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(20px,4vw,40px) clamp(14px,3vw,24px) 60px;
}

/* ── 헤더 ── */
.header {
    background: var(--white);
    border-radius: 18px;
    border: 1.5px solid var(--border);
    padding: 18px 20px;
    margin-bottom: 20px;
    box-shadow: 0 4px 20px rgba(99,102,241,.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    position: relative;
    overflow: hidden;
}
.header::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--pri), var(--pri2), #818cf8);
}
.header-left { display: flex; flex-direction: column; gap: 4px; }
.header-title { font-size: 18px; font-weight: 900; color: var(--text); }
.header-sub   { font-size: 13px; color: var(--text2); font-weight: 600; }
.header-sub b { color: var(--pri); }

.btn-back {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 16px; border-radius: 10px;
    border: 1.5px solid var(--border); background: var(--bg);
    color: var(--text2); font-size: 13px; font-weight: 700;
    text-decoration: none; transition: all .18s;
}
.btn-back:hover { border-color: var(--pri); color: var(--pri); background: var(--pri-lt); }

/* ── 선물 그리드 ── */
.gift-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 16px;
}

.gift-card {
    background: var(--white);
    border-radius: 16px;
    border: 2px solid var(--border);
    overflow: hidden;
    cursor: pointer;
    transition: transform .18s, border-color .18s, box-shadow .18s;
    box-shadow: 0 2px 10px rgba(0,0,0,.05);
}
.gift-card:hover {
    transform: translateY(-4px);
    border-color: var(--pri);
    box-shadow: 0 10px 28px rgba(99,102,241,.20);
}
.gift-card:active { transform: scale(.97); }

/* 이미지 — background-image 방식으로 CSS 충돌 원천 차단 */
.gift-thumb {
    width: 100%;
    height: 180px;
    background-size: cover;
    background-position: center;
    background-color: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    color: var(--muted);
}

.gift-info {
    padding: 12px 14px 14px;
}
.gift-name {
    font-size: 14px;
    font-weight: 800;
    color: var(--text);
    line-height: 1.35;
    margin-bottom: 4px;
}
.gift-desc {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    margin-bottom: 6px;
}
.gift-price {
    font-size: 12px;
    font-weight: 700;
    color: var(--pri);
}

/* ── 숨김 폼 ── */
.hidden-form { display: none; }

/* ── 빈 상태 ── */
.empty {
    grid-column: 1/-1;
    text-align: center;
    padding: 60px 20px;
    color: var(--muted);
    font-size: 14px;
}

@@media (max-width: 420px) {
    .gift-grid { grid-template-columns: repeat(2, 1fr); }
    .gift-thumb { height: 130px; font-size: 36px; }
}
</style>
</head>
<body>

<div class="page">

    <!-- 헤더 -->
    <div class="header">
        <div class="header-left">
            <div class="header-title">🎁 @milestone.ToString("N0")점 달성 선물 선택</div>
            <div class="header-sub">
                🏠 팀: <b>@(string.IsNullOrWhiteSpace(teamName) ? "(팀명 없음)" : teamName)</b>
                &nbsp;·&nbsp; 학생: <b>@studentUserName</b>
                &nbsp;·&nbsp; <span style="background:var(--pri-lt);color:var(--pri);padding:2px 8px;border-radius:6px;font-weight:800;">🏆 @milestone.ToString("N0")점</span>
            </div>
        </div>
        <a href="/DailyMission2/ParticipantTeams" class="btn-back">← 팀 목록으로</a>
    </div>

    <!-- 선물 그리드 -->
    @if (Model == null || !Model.Any())
    {
        <div class="gift-grid">
            <div class="empty">등록된 선물이 없습니다.</div>
        </div>
    }
    else
    {
        <div class="gift-grid">
            @foreach (var item in Model)
            {
                <div class="gift-card"
                     data-pid="@item.ProductID"
                     data-name="@(item.ProductName ?? "")"
                     onclick="selectGift(this)">
                    <!-- background-image 방식: <img> 태그 CSS 충돌 완전 차단 -->
                    <div class="gift-thumb"
                         style="background-image: url('/images/AwardItem/@(item.ProductID).jpg?v=@DateHelper.GetKoreaNow().Ticks');"
                         title="@item.ProductName">
                        🎁
                    </div>
                    <div class="gift-info">
                        <div class="gift-name">@item.ProductName</div>
                        @if (!string.IsNullOrWhiteSpace(item.ProductDescription))
                        {
                            <div class="gift-desc">@item.ProductDescription</div>
                        }
                        <div class="gift-price">@item.UnitPrice.ToString("N0")원</div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- 결과 메시지 표시 (TempData) -->
    @if (TempData["TeamGiftMsg"] != null)
    {
        <div id="resultMsg" style="margin-top:16px;padding:14px 18px;border-radius:14px;background:#fef3c7;border:1.5px solid #fde68a;color:#92400e;font-weight:700;font-size:14px;">
            @TempData["TeamGiftMsg"]
        </div>
    }

    <!-- 안티포저리 토큰 (fetch용) -->
    @Html.AntiForgeryToken()

</div>

<!-- 처리 중 오버레이 -->
<div id="loadingOverlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:9999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:18px;padding:32px 40px;text-align:center;font-size:15px;font-weight:700;color:#1e293b;">
        ⏳ 선물 지급 중...
    </div>
</div>

<script>
var TEAM_NAME    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(teamName));
var STUDENT_NAME = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(studentUserName));
var MILESTONE    = @milestone;
var CSRF_TOKEN   = document.querySelector('input[name="__RequestVerificationToken"]').value;

function selectGift(el) {
    var productId = el.getAttribute('data-pid');
    var name      = el.getAttribute('data-name') || '';

    if (!confirm('🎁 [' + name + '] 선물을 지급할까요?\n\n팀: ' + TEAM_NAME + '\n학생: ' + STUDENT_NAME)) return;

    // 처리 중 표시
    document.getElementById('loadingOverlay').style.display = 'flex';

    var fd = new FormData();
    fd.append('studentUserName', STUDENT_NAME);
    fd.append('teamName',        TEAM_NAME);
    fd.append('productId',       productId);
    fd.append('milestone',       MILESTONE);
    fd.append('__RequestVerificationToken', CSRF_TOKEN);

    fetch('/StudentPointDashboard4/TeamGiftGrant', { method: 'POST', body: fd })
        .then(function(res) {
            // 서버가 리다이렉트 응답(302)을 보내면 fetch는 자동으로 따라감
            // 최종 URL로 이동
            if (res.redirected) {
                window.location.href = res.url;
            } else if (res.ok) {
                window.location.href = '/DailyMission2/ParticipantTeams';
            } else {
                return res.text().then(function(t) {
                    throw new Error('서버 오류 (' + res.status + ')');
                });
            }
        })
        .catch(function(err) {
            document.getElementById('loadingOverlay').style.display = 'none';
            alert('❌ 오류가 발생했습니다.\n' + err.message);
        });
}
</script>

</body>
</html>
