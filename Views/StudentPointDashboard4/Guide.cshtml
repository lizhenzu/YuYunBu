@using BulletinBoard.Common;
@using BulletinBoard.Helpers;

@*  ══════════════════════════════════════════════════════════════
    나의 도토리 통합 시상 안내 — 안내문 한 장.  항상 보인다.
    (예전에는 '공지 한 번만' 배너(_Banner_IntMission_Notice_Once)만 넣어 두어서,
     '공지 숨기기'를 한 번 누른 사람에게는 이 페이지가 빈 화면이었다.
     그 배너는 대시보드에서 계속 쓰고, 여기는 안내문을 그대로 적어 둔다.)
    DailyMission4 밝은 흰색 버전 · wwwroot/css/present-bright.css
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;

    var today = DateHelper.GetKoreaNow();
    string dateText = today.ToString("yyyy.MM.dd") + " " + today.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture).ToUpperInvariant();

    var urlBoard  = "/StudentPointDashboard4";
    var urlGift   = "/StudentPointDashboard4/MyGiftBox3";
    var urlAsk    = "https://bit2001-001-site3.atempurl.com/Board/Create2?boardName=Anonymous";
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>@ConstatsCommon.myDoToRi 통합 시상 안내 — @ConstatsCommon.MainKeyTitle</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/present-bright.css" asp-append-version="true">
<style>
    .gdWarn { margin-top: 12px; padding: 10px 14px; border-radius: 12px; background: #F4F6F9; font-size: 12.5px; line-height: 1.7; color: #6B7280; word-break: keep-all; }
    ol.ltSteps li .sub { display: block; margin-top: 4px; font-size: 12.5px; color: #9CA3AF; line-height: 1.75; }
    .gdTwo { display: grid; grid-template-columns: 1fr; gap: 8px; margin-top: 10px; }
    .gdCard { padding: 14px 16px; border-radius: 12px; background: #F4F6F9; }
    .gdCard .k { margin-bottom: 4px; font-size: 11.5px; font-weight: 800; color: #2F80ED; }
    .gdCard .t { font-size: 15px; font-weight: 800; color: #111827; line-height: 1.4; }
    .gdCard .p { margin-top: 6px; font-size: 12.5px; line-height: 1.85; color: #6B7280; word-break: keep-all; }
    .gdCard .p b { font-weight: 800; color: #111827; }
    .ltQuote a { color: #2F80ED; font-weight: 700; text-decoration: underline; }
    @@media (min-width: 560px) { .gdTwo { grid-template-columns: 1fr 1fr; } }
</style>
</head>
<body>

<div class="pw">

    <div class="pbar">
        <span><a href="/">← @ConstatsCommon.ToHome</a><span class="sep">·</span><a href="@urlBoard">@ConstatsCommon.myDoToRi</a></span>
        <span>@dateText</span>
    </div>

    <div class="pK">시상 안내</div>
    <h1 class="pT">@ConstatsCommon.myDoToRi<br />통합 시상 안내</h1>

    <p class="ltP">
        세 가지 활동에서 얻은 포인트를 <b>모두 합산</b>하여 시상합니다.<br />
        활동을 할수록 포인트가 쌓이고, 쌓인 만큼 선물을 고를 수 있어요.
    </p>

    <div class="ltMarks">
        <span>@ConstatsCommon.MainKeyTitle</span>
        <span>@ConstatsCommon.MissionBibleWithparent</span>
        <span>@ConstatsCommon.HolyWordAndRead</span>
    </div>

    <div class="gdWarn">아래 안내는 운영상 일부 바뀔 수 있어요. 바뀌면 다시 알려 드릴게요.</div>

    <div class="psec"><div class="psecT">학생 시상 안내</div></div>
    <ol class="ltSteps">
        <li><b>01</b><span>세 가지 활동을 할수록 <em>포인트</em>가 계속 쌓여요.
            <span class="sub">@ConstatsCommon.HolyWordAndRead 점수가 내가 한 것과 다르면 담임 선생님께 알려 주세요.</span></span></li>
        <li><b>02</b><span><em>포인트가 100의 배수가 될 때마다</em> 선물을 신청할 수 있어요.
            <span class="sub">100점, 200점, 300점 … 처럼 100의 배수마다 가능해요.</span></span></li>
        <li><b>03</b><span>선물을 받을 수 있는지는 <em>내부 credit</em>이라는 기준으로 정해져요.
            <span class="sub">credit 은 선물을 받을 때 쓰는 특별 점수예요 · 처음 100포인트가 되면 보너스 credit 을 한 번 받아요 · credit 은 포인트와 달라요 · credit 은 화면에 보이지 않아요.</span></span></li>
        <li><b>04</b><span>선물을 받으면 <em>내부 credit 은 다시 0부터</em> 시작해요.</span></li>
        <li><b>05</b><span><em>활동을 많이 할수록</em> 더 다양하고 좋은 선물을 고를 수 있어요.</span></li>
        <li><b>06</b><span><em>포인트를 모아 두었다가 나중에 한 번에</em> 쓸 수도 있어요.
            <span class="sub">연말까지 모으면 더 크고 멋진 선물을 받을 수 있어요.</span></span></li>
    </ol>

    <div class="psec"><div class="psecT">가족팀 · 교사</div></div>
    <div class="gdTwo">
        <div class="gdCard">
            <div class="k">가족팀</div>
            <div class="t">가족팀 시상 안내</div>
            <div class="p">가족팀은 <b>100포인트 단계별 시상</b> 대상에 들어가지 않아요.<br />가족팀 포인트는 <b>연말까지 누적</b>되고, 누적 포인트 기준으로 가족팀 시상을 할 예정이에요.</div>
        </div>
        <div class="gdCard">
            <div class="k">교사</div>
            <div class="t">교사 시상 안내</div>
            <div class="p">교사는 <b>100포인트 단계별 시상</b> 대상에 들어가지 않아요.<br />교사 포인트는 <b>연말까지 누적</b>되고, 연말에 한 번에 시상할 예정이에요.</div>
        </div>
    </div>

    <div class="ltQuote">
        <div class="ltQk">문의</div>
        궁금한 점이 있으면 <a href="@urlAsk" target="_blank" rel="noopener">익명 게시판</a>에 남겨 주세요.
    </div>

    <div class="ltActs">
        <a class="ltBtn" href="@urlBoard">@ConstatsCommon.myDoToRi 보드</a>
        <a class="ltBtn line" href="@urlGift">나의 선물함</a>
    </div>

    <div class="pft"><span>© 유년부 · 시상 안내</span><a href="/">@ConstatsCommon.ToHome</a></div>

</div>

</body>
</html>
