@using BulletinBoard.Common;
@using BulletinBoard.Helpers;

@*  ══════════════════════════════════════════════════════════════
    나의 도토리 통합 시상 안내 — 안내문 한 장.  항상 보인다.
    (예전에는 '공지 한 번만' 배너(_Banner_IntMission_Notice_Once)만 넣어 두어서,
     '공지 숨기기'를 한 번 누른 사람에게는 이 페이지가 빈 화면이었다.
     그 배너는 대시보드에서 계속 쓰고, 여기는 안내문을 그대로 적어 둔다.)
    Bone(호텔 인쇄물) 스킨 · letter.css
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;

    var today = DateHelper.GetKoreaNow();
    string dateText = today.ToString("yyyy.MM.dd") + " " + today.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture).ToUpperInvariant();

    var urlBoard  = "/StudentPointDashboard4";
    var urlGift   = "/StudentPointDashboard4/MyGiftBox3";
    var urlAsk    = "https://bit2001-001-site3.atempurl.com/Board/Create2?boardName=Anonymous";
}

<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>@ConstatsCommon.myDoToRi 통합 시상 안내 — @ConstatsCommon.MainKeyTitle</title>
<link rel="stylesheet" href="/css/mission3/bone.css" asp-append-version="true">
<link rel="stylesheet" href="/css/mission3/letter.css" asp-append-version="true">
<style>
    .qz .gdWarn { margin-top: 14px; padding: 9px 12px; border: 1px dashed #D6CBB7; font-size: 11px; color: var(--dim2); line-height: 1.6; word-break: keep-all; }
    .qz ol.ltSteps li .sub { display: block; margin-top: 4px; font-size: 11.5px; color: var(--dim); line-height: 1.7; }
    .qz .gdTwo { display: grid; grid-template-columns: 1fr; gap: 9px; margin-top: 8px; }
    .qz .gdCard { border: 1px solid var(--rule); background: #fff; padding: 14px 15px; }
    .qz .gdCard .k { font-size: 10px; font-weight: 600; letter-spacing: .2em; color: var(--acc); margin-bottom: 8px; }
    .qz .gdCard .t { font-family: "Noto Serif KR", serif; font-size: 15.5px; line-height: 1.35; }
    .qz .gdCard .p { font-size: 12px; color: var(--dim2); line-height: 1.8; margin-top: 8px; word-break: keep-all; }
    .qz .gdCard .p b { font-weight: 600; color: var(--tx); }
    @@media (min-width: 560px) { .qz .gdTwo { grid-template-columns: 1fr 1fr; } }
</style>
</head>
<body>

<div class="qz">
    <div class="qzBody">

        <div class="qzBar">
            <div>
                <a class="qzHome" href="/">@ConstatsCommon.ToHome</a><span class="qzHomeSep">·</span><a class="qzHome" href="@urlBoard">@ConstatsCommon.myDoToRi</a>
            </div>
            <div class="qzDate">@dateText</div>
        </div>

        <div class="ltK">AWARD GUIDE</div>
        <h1 class="ltT">@ConstatsCommon.myDoToRi<br />통합 시상 안내</h1>

        <p class="ltP">
            세 가지 활동에서 얻은 포인트를 <b>모두 합산</b>하여 시상합니다.<br />
            활동을 할수록 포인트가 쌓이고, 쌓인 만큼 선물을 고를 수 있어요.
        </p>

        <div class="ltMarks">
            <span>@ConstatsCommon.MainKeyTitle</span>
            <span>@ConstatsCommon.MissionBibleWithparent</span>
            <span>@ConstatsCommon.HolyWordAndRead</span>
        </div>

        <div class="gdWarn">아래 안내는 운영상 일부 바뀔 수 있어요. 바뀌면 다시 알려 드릴게요.</div>

        <div class="ltSec">학생 시상 안내</div>
        <ol class="ltSteps">
            <li><b>01</b><span>세 가지 활동을 할수록 <em>포인트</em>가 계속 쌓여요.
                <span class="sub">@ConstatsCommon.HolyWordAndRead 점수가 내가 한 것과 다르면 담임 선생님께 알려 주세요.</span></span></li>
            <li><b>02</b><span><em>포인트가 100의 배수가 될 때마다</em> 선물을 신청할 수 있어요.
                <span class="sub">100점, 200점, 300점 … 처럼 100의 배수마다 가능해요.</span></span></li>
            <li><b>03</b><span>선물을 받을 수 있는지는 <em>내부 credit</em>이라는 기준으로 정해져요.
                <span class="sub">credit 은 선물을 받을 때 쓰는 특별 점수예요 · 처음 100포인트가 되면 보너스 credit 을 한 번 받아요 · credit 은 포인트와 달라요 · credit 은 화면에 보이지 않아요.</span></span></li>
            <li><b>04</b><span>선물을 받으면 <em>내부 credit 은 다시 0부터</em> 시작해요.</span></li>
            <li><b>05</b><span><em>활동을 많이 할수록</em> 더 다양하고 좋은 선물을 고를 수 있어요.</span></li>
            <li><b>06</b><span><em>포인트를 모아 두었다가 나중에 한 번에</em> 쓸 수도 있어요.
                <span class="sub">연말까지 모으면 더 크고 멋진 선물을 받을 수 있어요.</span></span></li>
        </ol>

        <div class="ltSec">가족팀 · 교사</div>
        <div class="gdTwo">
            <div class="gdCard">
                <div class="k">FAMILY TEAM</div>
                <div class="t">가족팀 시상 안내</div>
                <div class="p">가족팀은 <b>100포인트 단계별 시상</b> 대상에 들어가지 않아요.<br />가족팀 포인트는 <b>연말까지 누적</b>되고, 누적 포인트 기준으로 가족팀 시상을 할 예정이에요.</div>
            </div>
            <div class="gdCard">
                <div class="k">TEACHER</div>
                <div class="t">교사 시상 안내</div>
                <div class="p">교사는 <b>100포인트 단계별 시상</b> 대상에 들어가지 않아요.<br />교사 포인트는 <b>연말까지 누적</b>되고, 연말에 한 번에 시상할 예정이에요.</div>
            </div>
        </div>

        <div class="ltQuote">
            <div class="ltQk">문의</div>
            궁금한 점이 있으면 <a href="@urlAsk" target="_blank" rel="noopener" style="color:var(--acc);text-decoration:none;border-bottom:1px solid var(--acc)">익명 게시판</a>에 남겨 주세요.
        </div>

        <div class="ltActs">
            <a class="ltBtn" href="@urlBoard">@ConstatsCommon.myDoToRi 보드 →</a>
            <a class="ltBtn line" href="@urlGift">나의 선물함</a>
        </div>

        <div class="brFoot"><span>© BULLETIN BOARD · AWARD GUIDE</span><a href="/">홈으로 →</a></div>

    </div>
</div>

</body>
</html>
