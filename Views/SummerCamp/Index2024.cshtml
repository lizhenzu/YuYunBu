            padding: 0;
            color: #333;
        }

        .container {
            justify-content: space-around;
            padding: 20px;
            padding-top: 10px;
            /* display: flex;*/
            justify-content: center;
            align-items: center;
        }

        .test {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .textAlignLeft {
            text-align:left;
        }

        .textAlignCenter {
            text-align: center;
        }

        .noMarginNoPadding {
            margin: 0px;
            padding: 7px;
        }

        .tabeBound {
           width: 90%;
        }

        .card {
            background-color: #f4f4f4;
            padding: 1px;
