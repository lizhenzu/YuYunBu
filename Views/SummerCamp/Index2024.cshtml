        }

        .mobile {
            background-image: url('/images/2024_summer_camp/top_logo_2.jpg');
        }

        .mobile2 {
            background-image: url('/images/OnePoint/KakaoTalk_20240515_162338647_02.webp');
        }

        .city {
            background-image: url('/images/OnePoint/OnePoint06_crop.webp');
        }

        .goHome {
            background-image: url('/home/Home.webp');
        }

        button {
            border: none;
            padding: 10px;
            width: 100%;
            border-radius: 5px;
            background-color: orange;
            color: white;
            cursor: pointer;
        }

            button:hover {
