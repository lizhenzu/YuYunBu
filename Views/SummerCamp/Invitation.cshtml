@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor


@{
    Layout = null;
}

@{

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>겨울성경학교 유초등부 가정통신문</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f9f9f9;
            margin: 0;
            padding: 1px;
        }

        .container {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 5px;
            /*            border-radius: 8px;
                    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        */
        }
        h1, h2 {
            text-align: center;
        }

        .section {
            margin-bottom: 20px;
        }

        .info {
            background: #e3f2fd;
            padding: 15px;
            border-radius: 5px;
        }

        .bold {
            font-weight: bold;
        }

        .form-section {
            background: #fff3cd;
            padding: 15px;
            border-radius: 5px;
        }

        .footer {
            text-align: center;
            margin-top: 20px;
            font-size: 0.9em;
            color: gray;
        }


        .button-container {
            text-align: center;
            margin-top: 20px;
        }

        .home-button {
            background-color: #4CAF50;
            color: white;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 4px;
            font-size: 16px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>겨울성경학교 가정통신문</h2>
        <div class="section">
            <p>잠실새내 유년부 학부모님께,</p>
            <p>샬롬! 하나님의 풍성한 은혜와 사랑이 귀 가정에 가득하길 바랍니다.</p>
            <p>잠실새내교회 유년부에서는 <span class="bold">“신약 성경 맥 잡기(딤후 3:15-17)”</span>라는 주제로 겨울성경학교를 준비했습니다.</p>
        </div>

        <div class="info">
            <p>이번 겨울, 하나님의 언약을 중심으로 예수님의 구속 역사를 살펴보며 전체를 바라보는 안목을 가지게 하고, 신약 성경 27권을 다섯 가지로 분류하며 각 권을 구체적으로 배우게 됩니다.</p>
            <p>겨울성경학교를 통해 하나님의 말씀을 더욱 사랑하며 예수님을 만나는 은혜가 있기를 바랍니다.</p>
        </div>

        <h2>프로그램 안내</h2>
        <div class="section">
            <ul>
                <li><span class="bold">주제:</span> 신약 성경 맥 잡기 (딤후 3:15-17)</li>
                <li><span class="bold">일시:</span> 2025년 2월 21일(금) - 23일(주) (무박 3일)</li>
                <li><span class="bold">장소:</span> 비전센터 3층 유년부실, 용인 점핑고 (21일 금)</li>
                <li><span class="bold">회비:</span> 20,000원 (카카오뱅크 3333-30-4264095, 이승찬)</li>
            </ul>
            <p><span class="bold">※ 입금 시 아이의 이름과 학년/반을 기록해주세요! ex. 홍길동1-1</span></p>
            <p><span class="bold">※ 21일 (금) 9시 30분에 출발합니다. 시간 엄수 부탁드립니다.</span></p>
        </div>

        <h2>유초등 학부모 연합 기도회 안내</h2>
        <div class="section">
            <p><span class="bold">일시:</span> 2월 9일, 16일 주일 11:20 – 11:50</p>
            <p><span class="bold">장소:</span> 비전센터 4층 초등부실</p>
            <p>겨울성경학교를 위한 뜨거운 기도의 자리에 학부모님들을 초대합니다.</p>
        </div>

        <h2>문의</h2>
        <div class="section">
            <p><span class="bold">이승찬 전도사:</span> 010-3870-9352</p>
            <p><span class="bold">유민종 부장:</span> 010-4729-6832</p>
        </div>

        <h2>겨울성경학교 참가신청서</h2>
        <div class="form-section">
            <p><span class="bold">이름:</span> ____________________</p>
            <p><span class="bold">학년/반:</span> ____________________</p>
            <p><span class="bold">연락처:</span> ____________________</p>
            <p><span class="bold">주민등록번호:</span> ____________________ (여행자보험 가입을 위해 수집합니다. 가입 후 정보는 폐기합니다.)</p>
            <p><span class="bold">참석일:</span> □ 21일 □ 22일 □ 23일</p>
            <p>위와 같이 성경학교에 참석하기를 희망합니다.</p>
            <p>______년 ____월 ____일</p>
            <p><span class="bold">보호자:</span> ____________________</p>
        </div>
        <div class="footer">
            <p> © @DateHelper.GetKoreaNow().Year @ChurchName · @DepartmentName</p>
        </div>
        <div class="button-container">
            <a href="/" class="home-button">홈으로 가기</a>
        </div>
        <br />
       
    </div>
</body>
</html>
