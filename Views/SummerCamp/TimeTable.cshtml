                </tr>
                <tr>
                    <td>16:30~17:00</td>
                    <td rowspan="3">귀가</td>
                </tr>
                <tr>
                    <td>17:00~17:30</td>
                </tr>
                <tr>
                    <td>17:30~18:00</td>
                </tr>


