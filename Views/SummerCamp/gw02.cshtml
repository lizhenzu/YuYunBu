@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>공과교재</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f9f9f9;
            margin: 0;
            padding: 2px;
        }

        .container {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 5px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        h1 {
            text-align: center;
            color: #333;
        }

        .image-container {
            text-align: center;
            margin: 0 auto;
            padding: 3px;
        }

            .image-container img {
                display: block;
                width: 100%;
                height: auto;
                margin: 3px 0;
                cursor: pointer;
                transition: transform 0.2s;
            }

                .image-container img:hover {
                    transform: scale(1.05);
                }

        .page-number {
            font-weight: bold;
            margin-top: 5px;
            margin-bottom: 15px;
        }

        .button-container {
            text-align: center;
            margin-top: 20px;
        }

        .home-button {
            background-color: #4CAF50;
            color: white;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 4px;
            font-size: 16px;
        }
    </style>
    <script>
        function enlargeImage(src) {
            var imgWindow = window.open("");
            imgWindow.document.write('<img src="' + src + '" style="width:100%">');
        }
    </script>
</head>
