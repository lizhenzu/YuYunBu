@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>공과교재</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f9f9f9;
            margin: 0;
            padding: 2px;
        }

        .container {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 5px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

        h1 {
            text-align: center;
            color: #333;
        }

        .image-container {
            text-align: center;
            margin: 0 auto;
            padding: 3px;
        }

            .image-container img {
                display: block;
                width: 100%;
                height: auto;
                margin: 3px 0;
                cursor: pointer;
                transition: transform 0.2s;
            }

                .image-container img:hover {
                    transform: scale(1.05);
                }

        .page-number {
            font-weight: bold;
            margin-top: 5px;
            margin-bottom: 15px;
        }

        .button-container {
            text-align: center;
            margin-top: 20px;
        }

        .home-button {
            background-color: #4CAF50;
            color: white;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 4px;
            font-size: 16px;
        }
    </style>
    <script>
        function enlargeImage(src) {
            var imgWindow = window.open("");
            imgWindow.document.write('<img src="' + src + '" style="width:100%">');
        }
    </script>
</head>
<body>

    <div class="container">
        <h2>겨울성경학교 유년부</h2>
        <h3> 공과 교재(개요)</h3> 
        <div class="button-container">
            <a href="/" class="home-button">Home</a>
            <a href="/Summer_2024/study" class="home-button">이전 화면</a>
        </div>
        <br />
        <div class="image-container">
            <img src="/images/camp/winter_2025/slide1.png" alt="Slide 1" onclick="enlargeImage('/images/camp/winter_2025/slide1.png')">
            <div class="page-number">페이지 1</div>

            <img src="/images/camp/winter_2025/slide2.png" alt="Slide 2" onclick="enlargeImage('/images/camp/winter_2025/slide2.png')">
            <div class="page-number">페이지 2</div>

            <img src="/images/camp/winter_2025/slide3.png" alt="Slide 3" onclick="enlargeImage('/images/camp/winter_2025/slide3.png')">
            <div class="page-number">페이지 3</div>

            <img src="/images/camp/winter_2025/slide4.png" alt="Slide 4" onclick="enlargeImage('/images/camp/winter_2025/slide4.png')">
            <div class="page-number">페이지 4</div>

            <img src="/images/camp/winter_2025/slide5.png" alt="Slide 5" onclick="enlargeImage('/images/camp/winter_2025/slide5.png')">
            <div class="page-number">페이지 5</div>

            <img src="/images/camp/winter_2025/slide6.png" alt="Slide 6" onclick="enlargeImage('/images/camp/winter_2025/slide6.png')">
            <div class="page-number">페이지 6</div>

            <img src="/images/camp/winter_2025/slide7.png" alt="Slide 7" onclick="enlargeImage('/images/camp/winter_2025/slide7.png')">
            <div class="page-number">페이지 7</div>

            <img src="/images/camp/winter_2025/slide8.png" alt="Slide 8" onclick="enlargeImage('/images/camp/winter_2025/slide8.png')">
            <div class="page-number">페이지 8</div>

            <img src="/images/camp/winter_2025/slide9.png" alt="Slide 9" onclick="enlargeImage('/images/camp/winter_2025/slide9.png')">
            <div class="page-number">페이지 9</div>
        </div>

        <div class="button-container">
            <a href="/" class="home-button">Home</a>
            <a href="/Summer_2024/study" class="home-button">이전 화면</a>
        </div>
        <br />
    </div>

</body>
</html>
