@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString());
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString());
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ChurchName · @DepartmentName</title>
    <style>
        body { 
            background-color: #f0f2f5;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            background-color: #ffffff;
            padding: 30px 17px; /* Adding 17px left and right padding */
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            max-width: 400px;
            width: 100%;
            text-align: center;
        }

        h1 {
            color: #2c3e50;
            font-size: 24px;
            margin-bottom: 20px;
        }

        h2 {
            color: #2c3e50;
            font-size: 20px;
            margin-bottom: 20px;
        }

        h3 {
            color: #2c3e50;
            font-size: 18px;
            margin-bottom: 20px;
        }

        .button-group {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

            .button-group button {
                padding: 15px;
                color: #fff;
                border: none;
                border-radius: 5px;
                font-size: 16px;
                cursor: pointer;
                transition: background-color 0.3s ease;
                width: 48%;
            }

        .retry-btn {
            background-color: #2980b9;
        }

            .retry-btn:hover {
                background-color: #1f6391;
            }

        .home-btn {
            background-color: #27ae60;
        }

            .home-btn:hover {
                background-color: #1e8449;
            }
    </style>
</head>
<body>

    <div class="container">
        <h1>설문에 응해 주셔서 감사합니다</h1>
        <h2>설문이 익명으로 접수되었습니다.</h2>
        <p>설문 다시 작성 가능합니다.</p>

        <div class="button-group">
            <button type="button" class="retry-btn" onclick="window.location.href='/Survey/CreateSurvey/';">설문 다시 작성</button>
            <button type="button" class="home-btn" onclick="window.location.href='/';">Home</button>
        </div>
    </div>

</body>
</html>
