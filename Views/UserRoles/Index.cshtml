@using BulletinBoard.Models
@using BulletinBoard.Common;
@model List<BulletinBoard.Models.UserRolesViewModel>

@*  ══════════════════════════════════════════════════════════════
    사용자 권한 목록 — 2026-10-04 시안 확정 (DailyMission4 밝은 흰색 · 공용 wwwroot/css/quiz-bright.css)
    · 2026-11-08 반응형 카드로 변경 — 접지 않고 연락처 · 가입일 · 최종 접속 · 버튼을 모두 보여 준다 (휴대폰 1열 ~ PC 4열)
    · 찾기 · Role 칩 · 같은 이름 · 정렬은 화면 안에서(서버 왕복 없음)
    · 권한 관리 · 이 사람으로 보기(가장) · 계정 삭제 주소는 예전 그대로.  삭제 · 가장은 화면 안 확인창 → 대기카드
    · 이전 화면은 Index.cshtml.bak_before_bright
    ══════════════════════════════════════════════════════════════ *@

@{
    Layout = null;

    var users = Model ?? new List<UserRolesViewModel>();
    string Norm(string? s) => (s ?? "").Trim().ToLowerInvariant();
    string FullName(UserRolesViewModel u) => $"{u.LastName}{u.FirstName}".Trim();

    var nameCounts = users.GroupBy(u => Norm(FullName(u))).ToDictionary(g => g.Key, g => g.Count());
    int Cnt(string role) => users.Count(u => (u.Roles ?? new List<string>()).Contains(role));
    int noneCnt = users.Count(u => !(u.Roles ?? new List<string>()).Any());
    int dupCnt = users.Count(u => nameCounts[Norm(FullName(u))] > 1);

    // 소속 없음 (2026-11-08 시안 확정) — 반 배정 · 교사 배정 · 승인된 역할이 하나도 없는 사람 (가입 승인 대기는 제외)
    bool NoAff(UserRolesViewModel u) => u.Kind == UserRoleKind.Parent && !u.Pending;
    string AffText(UserRolesViewModel u) => NoAff(u) ? "소속 없음" : u.AffLabel;
    string KindOf(UserRolesViewModel u) => NoAff(u) ? "no" : KindCls(u.Kind);
    int KCnt(UserRoleKind k) => users.Count(u => u.Kind == k && !NoAff(u));
    int noAffCnt = users.Count(NoAff);
    // 반 없는 학생 (2026-11-08) — 학생인데 반 배정(ClassInfo_2026)이 없는 사람
    bool NoClass(UserRolesViewModel u) => u.Kind == UserRoleKind.Student && u.ClassYear <= 0;
    int noClassCnt = users.Count(NoClass);
    string KindCls(UserRoleKind k) => k switch { UserRoleKind.Student => "st", UserRoleKind.Teacher => "te", UserRoleKind.Officer => "of", UserRoleKind.Etc => "et", _ => "pa" };
    string RoleCls(string r) => r switch { "SuperAdmin" => "s", "Admin" => "a", "Moderator" => "m", "Basic" => "b", _ => "" };
    int no = 0;

    // 최종 접속 — 오늘 · 어제는 시각까지, 일주일 안은 "N일 전", 그 밖은 날짜
    var kToday = BulletinBoard.Helpers.DateHelper.GetKoreaNow().Date;
    string LastText(DateTime? at)
    {
        if (!at.HasValue) return "접속 기록 없음";
        var d = at.Value;
        int days = (kToday - d.Date).Days;
        if (days <= 0) return $"오늘 {d:HH:mm}";
        if (days == 1) return $"어제 {d:HH:mm}";
        if (days < 7) return $"{days}일 전";
        return d.ToString("yyyy-MM-dd");
    }
    string LastCls(DateTime? at) => !at.HasValue ? "none" : (kToday - at.Value.Date).Days <= 1 ? "now" : (kToday - at.Value.Date).Days < 30 ? "" : "old";
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFFFFF">
    <title>사용자 권한</title>
    <link rel="stylesheet" href="/css/quiz-bright.css" asp-append-version="true">
    <style>
        body { margin: 0; background: #FFFFFF; }

        /* 도구 줄 (스크롤해도 위에 붙음) */
        .ur-tools { position: sticky; top: 0; z-index: 10; background: #fff; padding: 14px 0 10px; border-bottom: 1px solid var(--line); }
        .ur-srch { display: flex; align-items: center; gap: 8px; height: 44px; padding: 0 14px; border-radius: 12px; background: var(--grey); }
        .ur-srch svg { flex: 0 0 auto; }
        .ur-srch input { flex: 1; min-width: 0; border: 0; background: transparent; outline: none; font: inherit; font-size: 14px; color: var(--ink); }
        .ur-chips { display: flex; gap: 6px; margin-top: 10px; overflow-x: auto; scrollbar-width: none; }
        .ur-chips::-webkit-scrollbar { display: none; }
        .ur-chips button { flex: 0 0 auto; border: 0; border-radius: 999px; padding: 6px 12px; font: inherit; font-size: 12.5px; font-weight: 700; background: var(--grey); color: var(--dim2); cursor: pointer; white-space: nowrap; }
        .ur-chips button.on { background: var(--blue); color: #fff; }
        .ur-chips button b { font-weight: 800; margin-left: 3px; opacity: .8; }
        .ur-chips .gap { flex: 0 0 1px; background: var(--line); margin: 4px 2px; }

        /* 넓은 화면에서는 카드가 여러 줄로 놓이도록 이 화면만 폭을 넓힌다 */
        .qb.ur-wide { max-width: 1280px; }

        /* 사용자 카드 (2026-11-08 시안 확정) — 한 사람 = 카드 한 장, 다 펼쳐서 보여 준다
           휴대폰 1열 · 태블릿 2열 · PC 3~4열 */
        .ur-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-top: 14px; }
        .ur-row { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 14px 14px 12px; border-radius: 16px; background: #fff; box-shadow: inset 0 0 0 1px #E3E7ED; }
        .ur-row[hidden] { display: none; }
        .ur-hd { display: flex; align-items: flex-start; gap: 10px; }
        .ur-av { flex: 0 0 40px; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--soft); color: var(--blue); font-size: 16px; font-weight: 800; }
        .ur-hd .t { flex: 1; min-width: 0; }
        .ur-hd .n { display: block; font-size: 11px; font-weight: 800; color: #7FA3DB; font-variant-numeric: tabular-nums; }
        .ur-hd .t b { font-size: 16px; font-weight: 800; color: var(--ink); word-break: keep-all; }
        .ur-hd .t .ur-af { margin-top: 5px; }
        .ur-hd .t .tag { display: block; }
        .ur-rl { display: flex; gap: 4px; flex-wrap: wrap; }
        .ur-tg { font-size: 10.5px; font-weight: 800; border-radius: 999px; padding: 2px 8px; background: var(--grey); color: var(--dim2); white-space: nowrap; }
        .ur-tg.s { background: var(--redbg); color: var(--red); }
        .ur-tg.a { background: var(--soft); color: var(--blue); }
        .ur-tg.m { background: var(--okbg); color: var(--ok); }
        .ur-tg.b { background: var(--warnbg); color: var(--warn); }
        .ur-tg.none { background: #fff; box-shadow: inset 0 0 0 1px var(--line); color: var(--dim); }
        /* 소속 (2026-11-08) */
        .ur-af { display: inline-block; margin-right: 6px; font-size: 11px; font-weight: 800; border-radius: 6px; padding: 1px 7px; vertical-align: 1px; }
        .ur-af.st { background: var(--soft); color: var(--blue); }
        .ur-af.te { background: var(--okbg); color: var(--ok); }
        .ur-af.of { background: #F3EEFF; color: #7048C8; }
        .ur-af.pa { background: var(--warnbg); color: var(--warn); }
        .ur-af.et { background: var(--grey); color: var(--dim2); }
        /* 최종 접속 — 오늘·어제는 초록, 기록 없음은 빨강, 30일 넘으면 흐리게 */
        .ur-meta dd.ur-ll.now { color: var(--ok); font-weight: 800; }
        .ur-meta dd.ur-ll.none { color: var(--red); }
        .ur-meta dd.ur-ll.old { color: var(--dim); }
        /* 소속 없음 — 노란 카드 */
        .ur-row.noaff { background: #FFF8E6; box-shadow: inset 0 0 0 1px #F2C879; }
        .ur-row.noaff .ur-hd .n { color: #C9922B; }
        .ur-row.noaff .ur-av { background: #FFE9BF; color: #A86A12; }
        .ur-af.no { background: #fff; color: #A86A12; box-shadow: inset 0 0 0 1px #F2C879; }
        .ur-chips button.na { background: #FFF1D6; color: #A86A12; }
        .ur-chips button.na.on { background: #E59A1A; color: #fff; }
        /* 반 없는 학생 — 하늘색 카드 */
        .ur-row.nocls { background: #EEF5FF; box-shadow: inset 0 0 0 1px #B9D0F2; }
        .ur-row.nocls .ur-av { background: #DCE9FB; }
        .ur-row.nocls .ur-af.st { background: #fff; box-shadow: inset 0 0 0 1px #B9D0F2; }
        .ur-chips button.nc { background: #E3EEFC; color: #2F6FD0; }
        .ur-chips button.nc.on { background: #2F6FD0; color: #fff; }
        .ur-dup { margin-left: 6px; font-size: 10.5px; font-weight: 800; border-radius: 999px; padding: 1px 7px; background: var(--warnbg); color: var(--warn); vertical-align: 2px; }

        .ur-meta { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 4px 10px; margin: 0; padding-top: 10px; border-top: 1px solid var(--line); font-size: 13px; }
        .ur-row.noaff .ur-meta { border-top-color: #F6DDA8; }
        .ur-row.nocls .ur-meta { border-top-color: #CFE0F7; }
        .ur-meta dt { color: var(--dim2); }
        .ur-meta dd { margin: 0; color: var(--ink); font-weight: 500; word-break: break-all; }
        .ur-acts { display: flex; gap: 6px; margin-top: auto; padding-top: 2px; }
        .ur-btn { flex: 1 1 0; min-width: 0; border: 0; border-radius: 999px; padding: 9px 6px; font: inherit; font-size: 12.5px; font-weight: 800; cursor: pointer; background: var(--grey); color: var(--tx); text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .ur-btn.w { flex-grow: 1.5; }
        .qb a.ur-btn.p, .ur-btn.p { background: var(--blue); color: #fff; }
        .ur-btn.d { background: var(--redbg); color: var(--red); }
        .ur-empty { grid-column: 1 / -1; padding: 36px 0; text-align: center; font-size: 13px; color: var(--dim); }
        .ur-empty[hidden] { display: none; }

        .qb-pop p b { color: #111827; }
        .qb-pop .bt button.d { background: #FDEEEE; color: #D9534F; }
    </style>
</head>
<body>

<div class="qb-wait" id="loadingOverlay"><div class="box"><div class="sp"></div><span id="waitText">처리하는 중이에요</span><small>잠시만 기다려 주세요</small></div></div>

<div class="qb ur-wide">

    <div class="qb-top">
        <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">·</span><a href="/HumanResource/ManageUserInfo#role">정보 관리</a><span class="sep">›</span>사용자 권한</span>
        <span>ROLE</span>
    </div>

    <div class="qb-k">USER ROLES · S</div>
    <h1 class="qb-h1">사용자 권한<small id="urCount">@(users.Count)명</small></h1>
    <div class="qb-sub">한 사람당 카드 한 장 — 연락처와 버튼까지 모두 펼쳐 보여요</div>
    @if (TempData["UrMsg"] is string urMsg && urMsg.Length > 0)
    {
        <div role="status" style="margin-top:12px;padding:11px 14px;border-radius:12px;background:var(--soft);color:var(--blue);font-size:13.5px;font-weight:700">@urMsg</div>
    }

    <div class="ur-tools">
        <label class="ur-srch">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <input id="urSearch" type="text" placeholder="이름 · 이메일 · 전화 · Role 찾기" autocomplete="off" />
        </label>
        <div class="ur-chips" id="urChips">
            <button type="button" class="on" data-f="all">전체<b>@users.Count</b></button>
            <button type="button" data-f="SuperAdmin">SuperAdmin<b>@Cnt("SuperAdmin")</b></button>
            <button type="button" data-f="Admin">Admin<b>@Cnt("Admin")</b></button>
            <button type="button" data-f="Basic">Basic<b>@Cnt("Basic")</b></button>
            <button type="button" data-f="none">Role 없음<b>@noneCnt</b></button>
            <button type="button" data-f="dup">같은 이름<b>@dupCnt</b></button>
            <span class="gap"></span>
            <button type="button" data-f="k:st">학생<b>@KCnt(UserRoleKind.Student)</b></button>
            <button type="button" data-f="k:te">교사<b>@KCnt(UserRoleKind.Teacher)</b></button>
            <button type="button" data-f="k:of">임원<b>@KCnt(UserRoleKind.Officer)</b></button>
            @if (KCnt(UserRoleKind.Parent) > 0) { <button type="button" data-f="k:pa">학부모<b>@KCnt(UserRoleKind.Parent)</b></button> }
            <button type="button" data-f="k:et">기타<b>@KCnt(UserRoleKind.Etc)</b></button>
            <button type="button" class="na" data-f="k:no">소속 없음<b>@noAffCnt</b></button>
            <button type="button" class="nc" data-f="nc">반 없는 학생<b>@noClassCnt</b></button>
            <span class="gap"></span>
            <button type="button" class="on" data-s="name">이름순</button>
            <button type="button" data-s="date">최근 가입순</button>
            <button type="button" data-s="last">최근 접속순</button>
        </div>
    </div>

    <div id="urRows" class="ur-grid">
        @foreach (var user in users)
        {
            no++;
            var roles = (user.Roles ?? new List<string>()).ToList();
            var name = FullName(user);
            var dc = nameCounts[Norm(name)];
            var filter = $"{name} {user.LastName} {user.FirstName} {user.Email} {user.PhoneNumber} {string.Join(" ", roles)} {AffText(user)}".ToLowerInvariant();
            var sortDate = user.InsertDT?.ToString("yyyy-MM-dd") ?? "0000-00-00";

            <div class="ur-row @(NoAff(user) ? "noaff" : "") @(NoClass(user) ? "nocls" : "")"
                 data-nc="@(NoClass(user) ? "1" : "0")"
                 data-filter="@filter"
                 data-roles="|@string.Join("|", roles)|"
                 data-dup="@(dc > 1 ? "1" : "0")"
                 data-kind="@KindOf(user)"
                 data-name="@Norm(name)"
                 data-date="@sortDate"
                 data-last="@(user.LastAccessAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")">
                <div class="ur-hd">
                    <span class="ur-av" aria-hidden="true">@(name.Length > 0 ? name.Substring(0, 1) : "?")</span>
                    <span class="t">
                        <span class="n">@no.ToString("00")</span>
                        <b>@name</b>@if (dc > 1) {<span class="ur-dup">같은 이름 @dc</span>}
                        <span class="tag"><span class="ur-af @KindOf(user)">@AffText(user)</span></span>
                    </span>
                </div>
                <div class="ur-rl">
                    @if (roles.Count == 0)
                    {
                        <span class="ur-tg none">Role 없음</span>
                    }
                    else
                    {
                        foreach (var r in roles)
                        {
                            <span class="ur-tg @RoleCls(r)">@r</span>
                        }
                    }
                </div>
                <dl class="ur-meta">
                    <dt>이메일</dt><dd>@(string.IsNullOrWhiteSpace(user.Email) ? "-" : user.Email)</dd>
                    <dt>연락처</dt><dd>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "-" : user.PhoneNumber)</dd>
                    <dt>가입일</dt><dd>@(user.InsertDT?.ToString("yyyy. MM. dd") ?? "-")</dd>
                    <dt>최종 접속</dt><dd class="ur-ll @LastCls(user.LastAccessAt)" title="@(user.LastAccessAt?.ToString("yyyy-MM-dd HH:mm") ?? "")">@LastText(user.LastAccessAt)</dd>
                </dl>
                <div class="ur-acts">
                    <a class="ur-btn p" href="/UserRoles/Manage?userId=@user.UserId">권한 관리</a>
                    <button type="button" class="ur-btn w" data-imp="@user.UserId" data-name="@name">이 사람으로 보기</button>
                    <button type="button" class="ur-btn d" data-del="@user.UserId" data-name="@name">탈퇴</button>
                </div>
            </div>
        }
        <div class="ur-empty" id="urEmpty" hidden="@(users.Count > 0)">찾는 사람이 없어요</div>
    </div>

    <div class="qb-ft">
        <span>사용자 권한</span>
        <span><a href="/HumanResource/ManageUserInfo#role">정보 관리</a><a href="#" onclick="history.back(); return false;">뒤로</a><a href="/">@ConstatsCommon.ToHome</a></span>
    </div>
</div>

<!-- 탈퇴는 POST (탈퇴 승인과 같은 범위로 지운다) -->
<form id="urDelForm" method="post" action="/UserRoles/Delete" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="userId" id="urDelId" />
</form>

<!-- 화면 안 확인창 -->
<div class="qb-pop" id="urPop">
    <div class="box">
        <h3 id="urPopT"></h3>
        <p id="urPopP"></p>
        <div class="bt">
            <button type="button" id="urPopN">취소</button>
            <button type="button" class="d" id="urPopY">진행</button>
        </div>
    </div>
</div>

<script>
    (function () {
        const $ = id => document.getElementById(id);
        const wrap = $('urRows');
        const rows = Array.from(wrap.querySelectorAll('.ur-row'));
        const empty = $('urEmpty');
        let f = 'all', s = 'name';

        function apply() {
            const q = $('urSearch').value.trim().toLowerCase();
            const sorted = rows.slice().sort((a, b) => s === 'name'
                ? a.dataset.name.localeCompare(b.dataset.name, 'ko')
                : s === 'last'
                    ? b.dataset.last.localeCompare(a.dataset.last) || a.dataset.name.localeCompare(b.dataset.name, 'ko')
                    : b.dataset.date.localeCompare(a.dataset.date));
            let shown = 0;
            sorted.forEach(r => {
                let ok = !q || r.dataset.filter.includes(q);
                if (ok && f === 'none') ok = r.dataset.roles === '||';
                else if (ok && f === 'dup') ok = r.dataset.dup === '1';
                else if (ok && f === 'nc') ok = r.dataset.nc === '1';
                else if (ok && f.startsWith('k:')) ok = r.dataset.kind === f.slice(2);
                else if (ok && f !== 'all') ok = r.dataset.roles.includes('|' + f + '|');
                r.hidden = !ok;
                wrap.insertBefore(r, empty);
                if (ok) r.querySelector('.n').textContent = String(++shown).padStart(2, '0');
            });
            empty.hidden = shown > 0;
            $('urCount').textContent = shown + '명';
        }

        $('urSearch').addEventListener('input', apply);
        $('urChips').addEventListener('click', e => {
            const b = e.target.closest('button'); if (!b) return;
            if (b.dataset.f) { f = b.dataset.f; document.querySelectorAll('#urChips [data-f]').forEach(x => x.classList.toggle('on', x === b)); }
            if (b.dataset.s) { s = b.dataset.s; document.querySelectorAll('#urChips [data-s]').forEach(x => x.classList.toggle('on', x === b)); }
            apply();
        });

        function esc(t) { const d = document.createElement('div'); d.textContent = t; return d.innerHTML; }
        function ask(title, html, yes, waitText, url) {
            $('urPopT').textContent = title;
            $('urPopP').innerHTML = html;
            $('urPopY').textContent = yes;
            $('urPop').style.display = 'flex';
            $('urPopY').onclick = () => {
                $('urPop').style.display = 'none';
                $('waitText').textContent = waitText;
                $('loadingOverlay').classList.add('on');
                if (typeof url === 'function') url(); else location.href = url;
            };
        }
        $('urPopN').onclick = () => $('urPop').style.display = 'none';

        wrap.addEventListener('click', e => {
            const del = e.target.closest('[data-del]');
            if (del) {
                ask('탈퇴 처리할까요?',
                    '<b>' + esc(del.dataset.name) + '</b> 님의 계정과 기록을 모두 지워요.<br>' +
                    '반 · 출석 · 미션 · 성경 읽기 · 선물 · 가족팀 · 접속 기록 · 프로필 사진까지 탈퇴와 같이 지워져요.<br>' +
                    '되돌릴 수 없어요.', '탈퇴', '탈퇴 처리하는 중이에요',
                    function () { $('urDelId').value = del.dataset.del; $('urDelForm').submit(); });
                return;
            }
            const imp = e.target.closest('[data-imp]');
            if (imp) {
                ask('이 사람으로 볼까요?', '<b>' + esc(imp.dataset.name) + '</b> 님으로 로그인한 화면을 봐요.<br>브라우저를 닫으면 원래대로 돌아와요.', '보기', '바꾸는 중이에요',
                    '/UserRoles/ImpersonateUser?userId=' + encodeURIComponent(imp.dataset.imp));
            }
        });

        window.addEventListener('pageshow', () => $('loadingOverlay').classList.remove('on'));
        apply();
    })();
</script>
</body>
</html>
