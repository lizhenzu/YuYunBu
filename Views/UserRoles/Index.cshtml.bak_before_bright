        /* Mobile cards (기본: 숨김) */
        .urCards {
            display: none;
            margin-top: 12px;
        }

        .urCard {
            background: #fff;
            border: 1px solid rgba(15,23,42,.10);
            border-radius: 18px;
            padding: 12px;
            box-shadow: 0 10px 22px rgba(15,23,42,.06);
            margin-bottom: 10px;
        }

        .noPill {
            font-size: 12px;
            font-weight: 950;
            color: rgba(15,23,42,.70);
            background: rgba(15,23,42,.06);
            border: 1px solid rgba(15,23,42,.10);
            padding: 3px 8px;
            border-radius: 999px;
            white-space: nowrap;
