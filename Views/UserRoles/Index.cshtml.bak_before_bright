@using BulletinBoard.Models
@model List<BulletinBoard.Models.UserRolesViewModel>

@{
    ViewData["Title"] = "User Roles";
    Layout = null; // ✅ 독립 페이지

    int loopCount = 1;

    string Norm(string? s) => (s ?? "").Trim().ToLowerInvariant();
    string FullNameKey(UserRolesViewModel u) => $"{Norm(u?.LastName)}|{Norm(u?.FirstName)}";

    // 이름 중복 카운트
    var nameCounts = (Model ?? new List<UserRolesViewModel>())
        .GroupBy(u => FullNameKey(u))
        .ToDictionary(g => g.Key, g => g.Count());

    // 중복 그룹에 색상 인덱스 부여(그룹마다 다른 색)
    var dupKeys = nameCounts.Where(kv => kv.Value > 1).Select(kv => kv.Key).ToList();
    var dupIndex = new Dictionary<string, int>();
    for (int i = 0; i < dupKeys.Count; i++) dupIndex[dupKeys[i]] = i;

    // 0~N 톤 회전
    string DupTone(string key)
    {
        if (!dupIndex.TryGetValue(key, out var idx)) return "";
        var tones = new[] { "dup-a", "dup-b", "dup-c", "dup-d", "dup-e", "dup-f" };
        return tones[idx % tones.Length];
    }
}

<!doctype html>
