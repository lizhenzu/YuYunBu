@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)

    // ✅ 이동 경로
    var urlSundayLesson = "/WeeklyWordToRead/WeeklyWordToReadDetailList"; // 주일공과
    var urlSundayIntro = "/WeeklyWordToRead/IntroBook";                 // 주일공과 서론
    var urlOfficial = "https://xn--9d0bp30cjhe9zk.com/main/bbs/board.php?bo_table=hana_3_1";     // 총회교육개발원 (외부 사이트 · 새 창)

    var menus = new[] {
        new { No = "01", Label = "주일공과 서론",       Desc = "공과의 흐름과 핵심을 먼저 살펴봐요",  En = "INTRO",    Url = urlSundayIntro },
        new { No = "02", Label = "주일공과 보기",       Desc = "이번 주 공과 내용과 활동을 확인해요",  En = "LESSON",   Url = urlSundayLesson },
        new { No = "03", Label = "총회교육개발원 자료", Desc = "공식 공과 · 교육 자료를 바로 확인해요", En = "OFFICIAL", Url = urlOfficial },
    };
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>주일공과 · 교육자료</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <style>
        /* ── DailyMission4 밝은 흰색 버전 (2026-10-03 시안 확정) ── */
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; background: #FFFFFF; color: #374151; font-family: "Noto Sans KR", "Malgun Gothic", system-ui, sans-serif; -webkit-text-size-adjust: 100%; }
        a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }
        .sh { max-width: 760px; margin: 0 auto; padding: 0 16px; }
        .hdTop { display: flex; justify-content: space-between; align-items: center; padding: 14px 0 12px; border-bottom: 1px solid #EEF0F3; font-size: 13px; }
        .hdTop a { font-weight: 700; color: #374151; }
        .hdTop a:hover { color: #2F80ED; }
        .hdTop span { color: #9CA3AF; letter-spacing: .04em; }
        .hdK { margin-top: 20px; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #2F80ED; }
        .hdT { margin: 6px 0 0; font-size: 24px; font-weight: 800; letter-spacing: -.02em; color: #111827; }
        .hdS { margin-top: 4px; font-size: 13px; color: #6B7280; }
        .secT { margin-top: 24px; padding-top: 16px; border-top: 1px solid #EEF0F3; font-size: 16px; font-weight: 800; color: #111827; }
        .mn { display: flex; align-items: center; gap: 14px; padding: 16px 2px; border-bottom: 1px solid #EEF0F3; }
        .mn:active { background: #F4F6F9; }
        .mnNo { flex: none; width: 30px; font-size: 17px; font-weight: 800; color: #7FA3DB; }
        .mnTx { flex: 1; min-width: 0; }
        .mnL { display: block; font-size: 16.5px; font-weight: 800; color: #111827; }
        .mn:hover .mnL { color: #2F80ED; }
        .mnD { display: block; margin-top: 2px; font-size: 13px; color: #6B7280; }
        .mnE { font-style: normal; font-size: 10.5px; font-weight: 800; color: #2F80ED; background: #EAF2FD; border-radius: 999px; padding: 1px 7px; margin-left: 6px; vertical-align: 2px; }
        .mnA { flex: none; font-size: 18px; color: #7FA3DB; transition: transform .15s; }
        .mn:hover .mnA { transform: translateX(3px); }
        .ft { display: flex; justify-content: space-between; padding: 18px 0 30px; font-size: 11.5px; color: #9CA3AF; }
        .ft a { color: #6B7280; font-weight: 700; }
    </style>
</head>

<body>
    <header class="sh">
        <div class="hdTop"><a href="/">← @ConstatsCommon.ToHome</a><span>HANA BIBLE</span></div>
        <div class="hdK">SUNDAY LESSON</div>
        <h1 class="hdT">주일공과 · 교육자료</h1>
        <div class="hdS">주일 공과와 공식 교육 자료를 한곳에서 확인하세요.</div>
    </header>

    <main class="sh">
        <div class="secT">바로가기</div>
        @foreach (var m in menus)
        {
            <a class="mn" href="@m.Url" @(m.En == "OFFICIAL" ? "target=_blank rel=noopener" : "")>
                <span class="mnNo">@m.No</span>
                <span class="mnTx"><span class="mnL">@m.Label@if (m.En == "OFFICIAL") {<i class="mnE">외부</i>}</span><span class="mnD">@m.Desc</span></span>
                <span class="mnA">›</span>
            </a>
        }

        <div class="ft"><span>© 유년부 · 주일공과</span><a href="/">@ConstatsCommon.ToHome</a></div>
    </main>
</body>
</html>
