@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)

    // ✅ 이동 경로
    var urlSundayLesson = "/WeeklyWordToRead/WeeklyWordToReadDetailList"; // 주일공과
    var urlSundayIntro = "/WeeklyWordToRead/IntroBook";                 // 주일공과 서론
    var urlOfficial = "/HTML/hanaBible/HowToGoToBibleStudy.html";     // 총회교육개발원

    var menus = new[] {
        new { No = "01", Label = "주일공과 보기",       Desc = "이번 주 공과 내용과 활동을 확인해요",  En = "LESSON",   Url = urlSundayLesson },
        new { No = "02", Label = "주일공과 서론",       Desc = "공과의 흐름과 핵심을 먼저 살펴봐요",  En = "INTRO",    Url = urlSundayIntro },
        new { No = "03", Label = "총회교육개발원 자료", Desc = "공식 공과 · 교육 자료를 바로 확인해요", En = "OFFICIAL", Url = urlOfficial },
    };
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>주일공과 · 교육자료</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&family=Inter:wght@200;400;500;600&family=Gothic+A1:wght@400;600&display=swap" rel="stylesheet">
    <link href="~/css/board-bone.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .mn { display: flex; align-items: center; gap: 16px; padding: 20px 2px; border-bottom: 1px solid var(--line); transition: background .15s; }
        .mn:hover { background: var(--card); }
        .mnNo { flex: none; width: 34px; font-family: "Inter", sans-serif; font-weight: 200; font-size: 26px; color: var(--acc); }
        .mnTx { flex: 1; min-width: 0; }
        .mnL { display: block; font-family: "Noto Serif KR", serif; font-size: 19px; line-height: 1.35; }
        .mnD { display: block; margin-top: 3px; font-size: 13.5px; color: var(--dim2); }
        .mnE { flex: none; font-family: "Inter", sans-serif; font-size: 11px; letter-spacing: .16em; color: var(--dim); }
        .mnA { flex: none; font-size: 16px; color: var(--dim); transition: transform .15s, color .15s; }
        .mn:hover .mnA { color: var(--acc); transform: translateX(3px); }
        @@media (max-width: 480px) { .mnE { display: none; } }
    </style>
</head>

<body>
    <header class="hd">
        <div class="sh">
            <div class="hdTop"><a href="/">← @ConstatsCommon.ToHome</a><span>HANA BIBLE</span></div>
            <div class="hdK">SUNDAY LESSON</div>
            <h1 class="hdT">주일공과 · 교육자료</h1>
            <div class="hdS">주일 공과와 공식 교육 자료를 한곳에서 확인하세요.</div>
        </div>
    </header>

    <main class="sh">
        <section class="sec">
            <div class="secH">
                <div><div class="secK">MENU</div><div class="secT">바로가기</div></div>
            </div>
            @foreach (var m in menus)
            {
                <a class="mn" href="@m.Url">
                    <span class="mnNo">@m.No</span>
                    <span class="mnTx"><span class="mnL">@m.Label</span><span class="mnD">@m.Desc</span></span>
                    <span class="mnE">@m.En</span>
                    <span class="mnA">→</span>
                </a>
            }
        </section>

        <div class="ft"><span>© 유년부 · 주일공과</span><a href="/">@ConstatsCommon.ToHome</a></div>
    </main>
</body>
</html>
