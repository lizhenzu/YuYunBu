@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@model BulletinBoard.Models.WeeklyWordToRead

@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>공과 등록</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&family=Inter:wght@200;400;500;600&family=Gothic+A1:wght@400;600&display=swap" rel="stylesheet">
    <link href="~/css/board-bone.css" rel="stylesheet" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link href="~/css/lesson-bright.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <header class="hd">
        <div class="sh">
            <div class="hdTop">
                <span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">›</span><a href="@Url.Action("WeeklyWordToReadDetailList")">공과 목록</a></span>
            </div>
            <div class="hdK">NEW LESSON</div>
            <h1 class="hdT">공과 등록</h1>
            <div class="hdS">단원 · 과 번호부터 차례로 채워 주세요.</div>
        </div>
    </header>

    <main class="sh">
        <form asp-action="CreateWeeklyWordToRead" method="post" class="fm" style="margin-top:4px">
            @await Html.PartialAsync("_LessonFields", Model)

            <div class="fAct" style="margin-top:26px">
                <a href="@Url.Action("WeeklyWordToReadDetailList")" class="nbtn">목록</a>
                <button type="submit" class="nbtn pri">등록</button>
            </div>
        </form>
        <div class="ft"><span>© 유년부 · 공과</span></div>
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
