@model UploadDataWithID
@using BulletinBoard.Common;
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@using BulletinBoard.Enums
@inject IAuthService AuthService

@{
    Layout = null; // ✅ 독립 페이지 — Bone 톤 (wwwroot/css/board-bone.css)
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>저장 완료</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&family=Inter:wght@200;400;500;600&family=Gothic+A1:wght@400;600&display=swap" rel="stylesheet">
    <link href="~/css/board-bone.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .done { padding: 56px 0 20px; text-align: center; }
        .done .k { font-size: 11.5px; font-weight: 600; letter-spacing: .22em; color: var(--acc); }
        .done h2 { margin: 10px 0 0; font-family: "Noto Serif KR", serif; font-weight: 400; font-size: 24px; }
        .done .rule { width: 40px; height: 1px; background: var(--acc); margin: 20px auto; }
        .done p { font-size: 14.5px; color: var(--dim2); line-height: 1.8; }
        .done .btns { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; margin-top: 22px; }
    </style>
</head>
<body>
    <header class="hd">
        <div class="sh">
            <div class="hdTop"><span><a href="/">@ConstatsCommon.ToHome</a><span class="sep">›</span><a href="/WeeklyWordToRead/WeeklyWordToReadDetailList">공과 목록</a></span></div>
            <div class="hdK">MATERIALS</div>
            <h1 class="hdT">공과 자료</h1>
        </div>
    </header>

    <main class="sh">
        <div class="done">
            <div class="k">SAVED</div>
            <h2>저장했어요</h2>
            <div class="rule"></div>
            <p>@(ViewBag.Message ?? "자료 변경 내용이 반영되었습니다.")</p>
            <div class="btns">
                <a class="nbtn" href="/FileUpload/Upload?category=@Model.SelectedCategory.ToString()">＋ 자료 추가</a>
                <a class="nbtn pri" href="/WeeklyReport/IndexByID?Id=@Model.WeeklyWordToReadID">공과 본문으로 돌아가기</a>
            </div>
        </div>
        <div class="ft"><span>© 유년부 · 공과 자료</span></div>
    </main>
</body>
</html>
