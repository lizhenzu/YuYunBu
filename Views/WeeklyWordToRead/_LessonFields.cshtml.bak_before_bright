@model BulletinBoard.Models.WeeklyWordToRead
@* 공과 등록(EnrollWeeklyWordToRead) · 수정(ModifyWeeklyWordToRead) 공통 입력 칸 — Bone 톤 (board-bone.css + 아래 .lf* 스타일)
   ⚠ 입력 이름(asp-for / name)은 컨트롤러 바인딩에 쓰이므로 바꾸지 말 것 *@

<style>
    .lfSec { margin-top: 30px; }
    .lfSec:first-of-type { margin-top: 22px; }
    .lfH { display: flex; align-items: baseline; gap: 12px; padding-bottom: 9px; margin-bottom: 16px; border-bottom: 1px solid var(--tx); }
    .lfH span { font-family: "Inter", sans-serif; font-weight: 200; font-size: 22px; color: var(--acc); }
    .lfH b { font-family: "Noto Serif KR", serif; font-weight: 500; font-size: 17px; }
    .lfH small { margin-left: auto; font-size: 12px; color: var(--dim); }
    .lfNums { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .lfNums.two { grid-template-columns: repeat(2, 1fr); max-width: 360px; }
    .lfNums .fRow { margin-bottom: 0; }
    .lfNums .fIn { text-align: right; font-family: "Inter", sans-serif; font-variant-numeric: tabular-nums; }
    .lfBox { padding: 16px; margin-bottom: 14px; background: var(--card); border: 1px solid var(--rule); border-left: 2px solid var(--acc); }
    .lfBox .fRow:last-child { margin-bottom: 0; }
    .lfBox .fIn { background: var(--bg); }
    .lfNote { margin-top: 10px; padding: 11px 14px; background: var(--mark); font-size: 13px; line-height: 1.7; color: var(--dim2); }
    textarea.fIn.lfT { min-height: 130px; font-family: inherit; }
    @@media (max-width: 480px) { .lfNums { grid-template-columns: repeat(2, 1fr); } }
</style>

<div asp-validation-summary="All" class="text-danger"></div>

@* 01 기본 정보 *@
<section class="lfSec">
    <div class="lfH"><span>01</span><b>기본 정보</b></div>
    <div class="lfNums two">
        <div class="fRow"><label asp-for="WeekTitle_DW" class="fLbl"></label><input asp-for="WeekTitle_DW" type="number" step="1" class="fIn" /></div>
        <div class="fRow"><label asp-for="WeekTitle_GUA" class="fLbl"></label><input asp-for="WeekTitle_GUA" type="number" step="1" class="fIn" /></div>
    </div>
    <div class="fRow" style="margin-top:18px">
        <label asp-for="BibleTitle" class="fLbl">공과 제목</label>
        <input asp-for="BibleTitle" class="fIn" autofocus />
        <span asp-validation-for="BibleTitle" class="text-danger"></span>
    </div>
    <div class="fRow">
        <label asp-for="OnePoint" class="fLbl">원포인트</label>
        <input asp-for="OnePoint" class="fIn" />
        <span asp-validation-for="OnePoint" class="text-danger"></span>
    </div>
</section>

@* 02 말씀 *@
<section class="lfSec">
    <div class="lfH"><span>02</span><b>말씀</b><small>각 절을 칸마다 나눠 입력하세요</small></div>

    <div class="lfBox">
        <div class="fRow">
            <label asp-for="BibleTextToRecite" class="fLbl"></label>
            <input asp-for="BibleTextToRecite" class="fIn" />
            <span asp-validation-for="BibleTextToRecite" class="text-danger"></span>
        </div>
        <div class="lfNums">
            <div class="fRow"><label asp-for="BibleTextToReciteFromJang" class="fLbl"></label><input asp-for="BibleTextToReciteFromJang" type="number" step="1" class="fIn" /></div>
            <div class="fRow"><label asp-for="BibleTextToReciteFromZul" class="fLbl"></label><input asp-for="BibleTextToReciteFromZul" type="number" step="1" class="fIn" /></div>
            <div class="fRow"><label asp-for="BibleTextToReciteToJang" class="fLbl"></label><input asp-for="BibleTextToReciteToJang" type="number" step="1" class="fIn" /></div>
            <div class="fRow"><label asp-for="BibleTextToReciteToZul" class="fLbl"></label><input asp-for="BibleTextToReciteToZul" type="number" step="1" class="fIn" /></div>
        </div>
    </div>

    <div class="lfBox">
        <div class="fRow">
            <label asp-for="BibleTextToRead" class="fLbl"></label>
            <input asp-for="BibleTextToRead" class="fIn" />
            <span asp-validation-for="BibleTextToRead" class="text-danger"></span>
        </div>
        <div class="lfNums">
            <div class="fRow"><label asp-for="BibleTextToReadFromJang" class="fLbl"></label><input asp-for="BibleTextToReadFromJang" type="number" step="1" class="fIn" /></div>
            <div class="fRow"><label asp-for="BibleTextToReadFromZul" class="fLbl"></label><input asp-for="BibleTextToReadFromZul" type="number" step="1" class="fIn" /></div>
            <div class="fRow"><label asp-for="BibleTextToReadToJang" class="fLbl"></label><input asp-for="BibleTextToReadToJang" type="number" step="1" class="fIn" /></div>
            <div class="fRow"><label asp-for="BibleTextToReadToZul" class="fLbl"></label><input asp-for="BibleTextToReadToZul" type="number" step="1" class="fIn" /></div>
        </div>
    </div>

    <div class="lfBox">
        <div class="fRow">
            <label asp-for="BibleTextToRead_1" class="fLbl"></label>
            <input asp-for="BibleTextToRead_1" class="fIn" />
            <span asp-validation-for="BibleTextToRead_1" class="text-danger"></span>
        </div>
        <div class="lfNums">
            <div class="fRow"><label asp-for="BibleTextToReadFromJang_1" class="fLbl"></label><input asp-for="BibleTextToReadFromJang_1" type="number" step="1" class="fIn" /></div>
            <div class="fRow"><label asp-for="BibleTextToReadFromZul_1" class="fLbl"></label><input asp-for="BibleTextToReadFromZul_1" type="number" step="1" class="fIn" /></div>
            <div class="fRow"><label asp-for="BibleTextToReadToJang_1" class="fLbl"></label><input asp-for="BibleTextToReadToJang_1" type="number" step="1" class="fIn" /></div>
            <div class="fRow"><label asp-for="BibleTextToReadToZul_1" class="fLbl"></label><input asp-for="BibleTextToReadToZul_1" type="number" step="1" class="fIn" /></div>
        </div>
    </div>
</section>

@* 03 학습 목표 *@
<section class="lfSec">
    <div class="lfH"><span>03</span><b>학습 목표</b></div>
    <div class="fRow"><label asp-for="LearningObjectives1" class="fLbl"></label><input asp-for="LearningObjectives1" class="fIn" /><span asp-validation-for="LearningObjectives1" class="text-danger"></span></div>
    <div class="fRow"><label asp-for="LearningObjectives2" class="fLbl"></label><input asp-for="LearningObjectives2" class="fIn" /><span asp-validation-for="LearningObjectives2" class="text-danger"></span></div>
    <div class="fRow"><label asp-for="LearningObjectives3" class="fLbl">학습 목표 3</label><input asp-for="LearningObjectives3" class="fIn" /><span asp-validation-for="LearningObjectives3" class="text-danger"></span></div>
</section>

@* 04 영상 · 성품 카드 *@
<section class="lfSec">
    <div class="lfH"><span>04</span><b>영상 · 성품 카드</b></div>
    <div class="fGrid">
        <div class="fRow"><label asp-for="YoJulSongURL" class="fLbl"></label><input asp-for="YoJulSongURL" class="fIn" /><span asp-validation-for="YoJulSongURL" class="text-danger"></span></div>
        <div class="fRow"><label asp-for="YoJulSongText" class="fLbl"></label><input asp-for="YoJulSongText" class="fIn" /><span asp-validation-for="YoJulSongText" class="text-danger"></span></div>
        <div class="fRow"><label asp-for="CharcaterMovingURL" class="fLbl"></label><input asp-for="CharcaterMovingURL" class="fIn" /><span asp-validation-for="CharcaterMovingURL" class="text-danger"></span></div>
        <div class="fRow"><label asp-for="CharcaterMovingURLText" class="fLbl"></label><input asp-for="CharcaterMovingURLText" class="fIn" /><span asp-validation-for="CharcaterMovingURLText" class="text-danger"></span></div>
    </div>
    <div class="fRow"><label asp-for="Charcatercard1Text" class="fLbl"></label><input asp-for="Charcatercard1Text" class="fIn" /><span asp-validation-for="Charcatercard1Text" class="text-danger"></span></div>
    <div class="fRow"><label asp-for="Charcatercard2Text" class="fLbl"></label><input asp-for="Charcatercard2Text" class="fIn" /><span asp-validation-for="Charcatercard2Text" class="text-danger"></span></div>
    <div class="fRow"><label asp-for="Charcatercard3Text" class="fLbl"></label><input asp-for="Charcatercard3Text" class="fIn" /><span asp-validation-for="Charcatercard3Text" class="text-danger"></span></div>
</section>

@* 05 수업 흐름 *@
<section class="lfSec">
    <div class="lfH"><span>05</span><b>수업 흐름</b><small>환영 · 모험 · 가치 · 격려</small></div>

    <div class="lfBox">
        <div class="fRow"><label asp-for="WelcomeA" class="fLbl">환영 A</label><input asp-for="WelcomeA" class="fIn" /><span asp-validation-for="WelcomeA" class="text-danger"></span></div>
        <div class="fRow"><label asp-for="WelcomeB" class="fLbl">환영 B</label><input asp-for="WelcomeB" class="fIn" /><span asp-validation-for="WelcomeB" class="text-danger"></span></div>
        <div class="fRow"><label asp-for="WelcomeTeacherGuide" class="fLbl">환영 · 교사 가이드</label><textarea id="WelcomeTeacherGuide" name="WelcomeTeacherGuide" asp-for="WelcomeTeacherGuide" class="fIn lfT" rows="5"></textarea><span asp-validation-for="WelcomeTeacherGuide" class="text-danger"></span></div>
    </div>

    <div class="lfBox">
        <div class="fRow"><label asp-for="Adventure" class="fLbl">모험</label><input asp-for="Adventure" class="fIn" /><span asp-validation-for="Adventure" class="text-danger"></span></div>
        <div class="fRow"><label asp-for="AdventureTeacherGuide" class="fLbl">모험 · 교사 가이드</label><textarea id="AdventureTeacherGuide" name="AdventureTeacherGuide" asp-for="AdventureTeacherGuide" class="fIn lfT" rows="5"></textarea><span asp-validation-for="AdventureTeacherGuide" class="text-danger"></span></div>
    </div>

    <div class="lfBox">
        <div class="fRow"><label asp-for="ValueData1" class="fLbl">가치 1</label><input asp-for="ValueData1" class="fIn" /><span asp-validation-for="ValueData1" class="text-danger"></span></div>
        <div class="fRow"><label asp-for="ValueData2" class="fLbl">가치 2</label><input asp-for="ValueData2" class="fIn" /><span asp-validation-for="ValueData2" class="text-danger"></span></div>
        <div class="fRow"><label asp-for="ValueData3" class="fLbl">가치 3</label><input asp-for="ValueData3" class="fIn" /><span asp-validation-for="ValueData3" class="text-danger"></span></div>
        <div class="fRow"><label asp-for="ValueTeacherGuide" class="fLbl">가치 · 교사 가이드</label><textarea id="ValueTeacherGuide" name="ValueTeacherGuide" asp-for="ValueTeacherGuide" class="fIn lfT" rows="5"></textarea><span asp-validation-for="ValueTeacherGuide" class="text-danger"></span></div>
    </div>

    <div class="lfBox">
        <div class="fRow"><label asp-for="EncourageStudyPoint1" class="fLbl">격려 요점 1</label><input asp-for="EncourageStudyPoint1" class="fIn" /><span asp-validation-for="EncourageStudyPoint1" class="text-danger"></span></div>
        <div class="fRow"><label asp-for="EncourageStudyPoint2" class="fLbl">격려 요점 2</label><input asp-for="EncourageStudyPoint2" class="fIn" /><span asp-validation-for="EncourageStudyPoint2" class="text-danger"></span></div>
        <div class="fRow"><label asp-for="EncourageTeacherGuide" class="fLbl">격려 · 교사 가이드</label><textarea id="EncourageTeacherGuide" name="EncourageTeacherGuide" asp-for="EncourageTeacherGuide" class="fIn lfT" rows="5"></textarea><span asp-validation-for="EncourageTeacherGuide" class="text-danger"></span></div>
    </div>
</section>

@* 06 미션 · 기간 *@
<section class="lfSec">
    <div class="lfH"><span>06</span><b>이번 주 미션 · 기간</b></div>
    <div class="fRow"><label asp-for="ThisWeekMission" class="fLbl">이번 주 미션</label><input asp-for="ThisWeekMission" class="fIn" /><span asp-validation-for="ThisWeekMission" class="text-danger"></span></div>
    <div class="fGrid">
        <div class="fRow">
            <label asp-for="DateFrom" class="fLbl"></label>
            <input type="date" id="DateFrom" name="DateFrom" class="fIn" value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="DateFrom" class="text-danger"></span>
        </div>
        <div class="fRow">
            <label asp-for="DateTo" class="fLbl"></label>
            <input type="date" id="DateTo" name="DateTo" class="fIn" value="@Model.DateTo.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="DateTo" class="text-danger"></span>
        </div>
    </div>
    <div class="lfNote">
        시작일자와 종료일자는 이 공과를 언제부터 언제까지 할지를 정하는 거예요.<br />
        예) 시작 2024.3.5 · 종료 2024.3.15 → 3월 5일부터 3월 15일까지 진행
    </div>
</section>

<input type="hidden" id="Id" name="Id" value="@Model.Id" />
