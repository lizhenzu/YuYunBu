@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model YoutubeShort
@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>쇼츠 등록</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .form-container {
            background: white;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            max-width: 500px;
            width: 100%;
        }

        h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333;
        }

        label {
            display: block;
            margin-top: 15px;
            font-weight: bold;
            color: #555;
        }

        input[type="text"] {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button {
            margin-top: 20px;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 15px;
            padding-bottom: 15px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }

            button:hover {
                background-color: #0056b3;
            }

        .footer-buttons {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

            .footer-buttons a {
                text-decoration: none;
                background-color: #6c757d;
                color: white;
                padding: 10px 20px;
                border-radius: 5px;
            }

                .footer-buttons a:hover {
                    background-color: #5a6268;
                }
    </style>
    <style>
        form {
            display: flex;
            justify-content: flex-end; /* Aligns the button to the right */
            flex-wrap: wrap; /* Keeps input fields aligned */
            gap: 10px; /* Adds spacing between input fields and the button */
        }

        button[type="submit"] {
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="form-container">
        <h2>쇼츠 등록</h2>
        <form method="POST" action="/YoutubeShorts/EnrollProcessYoutubeShorts">
            <label for="url">YouTube Shorts 주소</label>
            <input type="text" id="ContentsURL" name="ContentsURL" placeholder="https://youtube.com/shorts/..." value="@Model.ContentsURL" required>
            <input type="text" id="ContentsText" name="ContentsText" placeholder="설명 입력" value="@Model.ContentsText" required>
            <input type="hidden" id="Id" name="Id" value="@Model.Id">

            <button type="submit">제출</button>
        </form>

        <div class="footer-buttons">
            <button onclick="location.href='/'">홈으로</button>
            <button onclick="location.href='/YoutubeShorts/'">전체</button>
            <button onclick="location.href='/YoutubeShorts/IndexByGroup'">목록</button>
            <button onclick="location.href='/YoutubeShorts/EnrollYoutubeShorts'">등록</button>
        </div>
    </div>

</body>
</html>