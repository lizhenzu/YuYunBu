@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model IEnumerable<BulletinBoard.Models.BibleYouTuBu>

@{
    Layout = null;

    var BibleText = ViewData["BibleText"] as string;
    bool isEventBibleText = true;

    if (!Model.Any())
    {
        isEventBibleText = false;
    }
    var UserFullName = HttpContextAccessor.HttpContext.Session.GetString(HttpContextSessionCategory.UserFullName.ToString()) as string;
    string ActionSource = HttpContextAccessor.HttpContext.Session.GetString(MVCInfomation.ActionSource.ToString()) as String;
    string ControllerSource = HttpContextAccessor.HttpContext.Session.GetString(MVCInfomation.ControllerSource.ToString()) as String;
}

<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>성경 읽기 목록표 - 신명기</title>
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(to bottom, #e0f7fa, #f1f8e9);
            color: #37474f;
        }

        header {
            background-color: #aed581;
            color: #1b5e20;
            text-align: center;
            padding: 40px 20px;
            font-weight: 700;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
 
 
        .card-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }
  

        .progress-info {
            font-size: 0.9rem; 
            margin-bottom: 20px;
            line-height: 1.4;
        }
        /* 카드 버튼 그룹 */
        .card-buttons {
            display: flex;
            justify-content: space-between;
        }

            .card-buttons button {
                border: none;
                padding: 8px 12px;
                border-radius: 6px;
                font-weight: 600;
                cursor: pointer;
                font-size: 0.9rem;
                flex: 1;
                margin: 0 4px;
                transition: background-color 0.3s ease;
            }

                .card-buttons button:first-child {
                    margin-left: 0;
                }

                .card-buttons button:last-child {
                    margin-right: 0;
                }

                .card-buttons button:hover {
                    background-color: #d4ac0d;
                    color: #2E4053;
                }
        /* 반응형 */
        @@media (max-width: 768px) {
            .card-container {
                flex-direction: column;
                align-items: center;
            }

            .btn-group button {
                margin: 10px 5px;

            }

            .card {
                width: 90%; 
            }
        }
    </style>
    <style>

        .modal, .video-popup {
            display: none;
            position: fixed;
            z-index: 100;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
        }

        .modal-content, .video-content {
            background-color: white;
            padding: 0.2rem;
            width: 90%;
            max-width: 400px;
            text-align: center;
        }

        .video-content {
            width: 90%;
            max-width: 500px;
        }


        .chapter-list {
            margin-top: 1rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            justify-content: center;
        }

            .chapter-list button {
                background-color: #aed581;
                border: none;
                padding: 0.4rem 0.8rem;
                border-radius: 8px;
                cursor: pointer;
                font-size: 0.9rem;
            }

        .video-frame {
            width: 100%;
            aspect-ratio: 16 / 9;
            max-width: 100%;
            border: none;
        }

    </style>
    <link rel="stylesheet" href="/css/card7.css">
    <link rel="stylesheet" href="/css/ButtonBase7.css">
    <link rel="stylesheet" href="/css/ColorBase7.css">










     <style>
   
    .card-container {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
      padding: 10px;
    }

    /* ---------- 카드 공통 ---------- */
    .card {
      width: 260px;
      padding: 20px 18px;
      border-radius: 14px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .card:hover {
      transform: translateY(-6px);
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
    }

    .progress-info {
      margin: 10px 0 18px;
      font-weight: 600;
    }

    /* ---------- 카드 상태별 배경 & 텍스트 ---------- */
    .card-not-started {
      background-color: #ffebee;
      color: #b71c1c;
    }

    .card-in-progress {
      background-color: #fff8e1;
      color: #f57f17;
    }

    .card-completed {
      background-color: #e8f5e9;
      color: #1b5e20;
    }

    /* ---------- 버튼 공통 ---------- */
    .card-buttons {
      display: flex;
      gap: 8px;
    }

    .card-buttons button {
      flex: 1 1 0;
      padding: 10px 0;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      font-size: 0.9rem;
      box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.15);
      transition: all 0.18s ease;
    }

    .card-buttons button:hover {
      transform: translateY(-2px);
      box-shadow: 4px 4px 8px rgba(0, 0, 0, 0.22);
    }

    .card-buttons button:active {
      transform: scale(0.96);
      box-shadow: inset 3px 3px 6px rgba(0, 0, 0, 0.25);
    }

    /* ---------- 버튼 색상 (카드별 3종) ---------- */
    /* 미완료 */
    .card-not-started .card-buttons button:nth-child(1) { background: #ef9a9a; color: white; }
    .card-not-started .card-buttons button:nth-child(2) { background: #ffcdd2; color: #b71c1c; }
    .card-not-started .card-buttons button:nth-child(3) { background: #ff8a80; color: white; }

    /* 진행중 */
    .card-in-progress .card-buttons button:nth-child(1) { background: #ffd54f; color: black; }
    .card-in-progress .card-buttons button:nth-child(2) { background: #fff176; color: black; }
    .card-in-progress .card-buttons button:nth-child(3) { background: #fbc02d; color: white; }

    /* 완료 */
    .card-completed .card-buttons button:nth-child(1) { background: #a5d6a7; color: black; }
    .card-completed .card-buttons button:nth-child(2) { background: #81c784; color: white; }
    .card-completed .card-buttons button:nth-child(3) { background: #66bb6a; color: white; }

    /* ---------- 모바일 ---------- */
    @@media (max-width: 600px) {
      .card {
        width: 90%;
      }
    }
  </style>


</head>
<body>
    <header>
        <h3>안녕하세요</h3>
        <h1>🌿@BibleText 통독공간🌿</h1>
        <h5>@UserFullName 님</h5>
        <p>매일 말씀과 동행하는 여정</p>
    </header>
    <br />

    @await Html.PartialAsync("_PublishNavigationButton_Home_Old_New_Board")
    @await Html.PartialAsync("_PublishRegionDesc")
 
    <div class="card-container">
        @foreach (var item in Model)
        {
            var cardClass = "card card-not-started";        

            if (@Convert.ToInt32(item.ProgressRate) == 100)
            {
                cardClass = "card card-completed";               
            }
            else if (@Convert.ToInt32(item.ProgressRate) > 0)
            {
                cardClass = "card card-in-progress";     
            }

            string queryString = $"/DailyMission/BibleSheetJangByJang?ControllerSource={ControllerSource}&ActionSource={ActionSource}";
            queryString = queryString + $"&BibleText={@BibleText}&FromJang={@item.SeqNo}&FromZul=0&ToJang={@item.SeqNo}&ToZul=0";
            <div class="@cardClass">

                <h3>@($"{BibleText} {@item.SeqNo}장")</h3>
                <div class="progress-info">
                    진도율:  @($"{Decimal.ToInt32(@item.ProgressRate)}%")<br />
                    동영상길이 : @($"{@item.TimeMM}분 {@item.TimeSS}초")
                </div>
                <div class="card-buttons">
                    <button   onclick="showChapters('@item.URL')">영상보기</button>
                    <button onclick="location.href='@queryString'">권별읽기</button>
                    <button  onclick="location.href='/bibleCenter/ReadingTheBibleOneVerse?BibleId=@item.BibleId&BibleText=@BibleText&Jang=@item.SeqNo'">몇줄읽기</button>
                </div>
            </div>
        }
    </div>

    <br />
     @await Html.PartialAsync("_PublishNavigationButton_Home_Old_New_Board")


    <div class="modal" id="modal">
        <div class="modal-content">
            <h2 id="selectedBook">성경 책</h2>
            <div class="chapter-list" id="chapterList"></div>
        </div>
        <div class="button-bar no-select">
            <div class="buttonCommon colorBaseClose" onclick="closeModal()">닫기</div>
        </div>
    </div>

    <div class="video-popup" id="videoPopup">
        <div class="video-content">
            <iframe id="youtubeFrame" class="video-frame" src="" frameborder="0" allowfullscreen></iframe>
            <button onclick="closeVideo()" style="margin:10px;">닫기</button>
        </div>
    </div>

    <audio id="bgm" loop>
        <source src="https://www.bensound.com/bensound-music/bensound-sunny.mp3" type="audio/mp3">
    </audio>
    <script>
        const modal = document.getElementById("modal");
        const chapterList = document.getElementById("chapterList");
        const selectedBookEl = document.getElementById("selectedBook");
        const videoPopup = document.getElementById("videoPopup");
        const youtubeFrame = document.getElementById("youtubeFrame");
        const fixedVideoId = "QquLCaitw9s";

        // 별도의 비동기 함수: 서버에 GET 요청
        async function fetchChaptersFromServer(videoId) {
            const response = await fetch(`/bibleCenter/HitBibleYouTuBuHit?videoId=${encodeURIComponent(videoId)}`);
            if (!response.ok) {
                throw new Error(`서버 오류 상태: ${response.status}`);
            }

            const data = await response.json();
            console.log("서버 응답 데이터:", data);
        }

        async function showChapters(videoId) {

            try {
                await fetchChaptersFromServer(videoId);
            } catch (error) {
                console.warn("서버 요청 중 오류 발생 (무시하고 계속):", error);
            }

            //// URL에서 v= 뒤에 있는 유튜브 ID 추출
            //const match = URL.match(/[?&]v=([^&]+)/);
            //if (match && match[1]) {
            //    videoId = match[1];
            //} else {
            //    alert("유효한 유튜브 링크가 아닙니다.");
            //    return;
            //}

            const embedUrl = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
            youtubeFrame.src = embedUrl;
            videoPopup.style.display = "flex";
        }

        function closeModal() {
            modal.style.display = "none";
        }

        function closeVideo() {
            videoPopup.style.display = "none";
            youtubeFrame.src = "";
        }

        function toggleDarkMode() {
            document.body.classList.toggle("dark-mode");
        }

        function toggleBgm() {
            const bgm = document.getElementById("bgm");
            if (bgm.paused) {
                bgm.play();
            } else {
                bgm.pause();
            }
        }
    </script>

</body>
</html>
