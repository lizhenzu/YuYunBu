@model IEnumerable<BulletinBoard.Models.BibleLastReadRateByUserCompleted>
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using BulletinBoard.Services.Abstract
@using Microsoft.AspNetCore.Http;
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    var ChurchName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.ChurchName.ToString()) ?? "";
    var DepartmentName = HttpContextAccessor.HttpContext.Session.GetString(CommonMetaDataCategory.DepartmentName.ToString()) ?? "";

    var list = (Model ?? Enumerable.Empty<BibleLastReadRateByUserCompleted>())
        .Where(x => x != null && x.readBibleAllCount > 0)
        .ToList();

    var totalCount = list.Count;
    var maxRead = (totalCount > 0) ? list.Max(x => x.readBibleAllCount) : 0;
    var avgRead = (totalCount > 0) ? (decimal)list.Sum(x => x.readBibleAllCount) / totalCount : 0m;

    string Safe(string s) => string.IsNullOrWhiteSpace(s) ? "" : s.Trim();

    int RankOf(BulletinBoard.Models.BibleLastReadRateByUserCompleted item)
    {
        var ordered = list.OrderByDescending(x => x.readBibleAllCount).ToList();
        var idx = ordered.FindIndex(x => x.UserId == item.UserId);
        return (idx < 0) ? 9999 : (idx + 1);
    }
}

<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ConstatsCommon.ReadBibleAllTitleButton 대시보드</title>

    <!-- ✅ 폰트 (가독성 + 귀여움 조금) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;600;800;900&family=Gowun+Dodum&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg0: #0b1220;
            --bg1: #0e1930;
            --card: #0f223d;
            --card2: #0d1b33;
            --text: #eaf2ff;
            --muted: rgba(234,242,255,.72);
            --line: rgba(255,255,255,.10);
            --accent: #41d9b5;
            --accent2: #7aa7ff;
            --danger: #ff6b6b;
            --shadow: 0 14px 42px rgba(0,0,0,.35);
            --shadow2: 0 10px 22px rgba(15,23,42,.28);
            --radius: 18px;
            /* ✅ bottomNav 높이(초기값). JS가 실제 높이로 자동 갱신 */
            --bottomNavH: 120px;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            font-family: 'Noto Sans KR', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
            background: radial-gradient(1200px 700px at 20% -10%, rgba(65,217,181,.22), transparent 60%), radial-gradient(900px 600px at 95% 0%, rgba(122,167,255,.18), transparent 60%), linear-gradient(180deg, var(--bg0), var(--bg1));
            color: var(--text);
        }

        /* ======= Top App Bar ======= */
        .topbar {
            top: 0;
            z-index: 20;
            backdrop-filter: blur(10px);
            background: linear-gradient(180deg, rgba(11,18,32,.88), rgba(11,18,32,.60));
            border-bottom: 1px solid var(--line);
        }

        .topbarInner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 14px 16px 12px;
            gap: 12px;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            flex-direction: column;
            gap: 4px;
            min-width: 220px;
        }

            .brand .titleRow {
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .badgeLogo {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: linear-gradient(135deg, rgba(65,217,181,.95), rgba(122,167,255,.85));
            box-shadow: var(--shadow2);
            display: grid;
            place-items: center;
            font-weight: 900;
            color: #07121f;
        }

        .brand h1 {
            margin: 0;
            font-size: 16px;
            letter-spacing: -.4px;
            line-height: 1.2;
        }

        .brand .sub {
            margin: 0;
            font-size: 12px;
            color: var(--muted);
            font-family: 'Gowun Dodum','Noto Sans KR',sans-serif;
        }

        .statsMini {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
            margin-top :20px;
        }

        .pill {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 12px;
            border-radius: 999px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.10);
            box-shadow: 0 10px 18px rgba(0,0,0,.18);
            font-size: 12px;
            color: var(--muted);
            white-space: nowrap;
        }

            .pill b {
                color: var(--text);
                font-weight: 900;
            }

        /* ======= Controls ======= */
        .controls {
            max-width: 1100px;
            margin: 12px auto 0;
            padding: 0 16px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .searchWrap {
            flex: 1 1 280px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            border-radius: 14px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.10);
            box-shadow: var(--shadow2);
        }

        .searchIcon {
            opacity: .9;
        }

        .searchWrap input {
            width: 100%;
            background: transparent;
            border: 0;
            outline: 0;
            color: var(--text);
            font-size: 14px;
        }

            .searchWrap input::placeholder {
                color: rgba(234,242,255,.55);
            }

        .selectWrap {
            flex: 0 0 auto;
            display: flex;
            gap: 10px;
        }

            .selectWrap select {
                appearance: none;
                background: rgba(255,255,255,.06);
                border: 1px solid rgba(255,255,255,.10);
                color: var(--text);
                padding: 12px 14px;
                border-radius: 14px;
                outline: 0;
                box-shadow: var(--shadow2);
                font-size: 14px;
                min-width: 170px;
            }

        /* ======= Grid ======= */
        .wrap {
            max-width: 1100px;
            margin: 14px auto 0;
            padding: 10px; /* ✅ bottomNav에 가리지 않게 */
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 12px;
            margin-top: 12px;
        }

        .card {
            grid-column: span 12;
            display: flex;
            gap: 12px;
            padding: 14px;
            border-radius: var(--radius);
            background: linear-gradient(180deg, rgba(15,34,61,.92), rgba(13,27,51,.92));
            border: 1px solid rgba(255,255,255,.10);
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
            transform: translateZ(0);
        }

            .card::before {
                content: "";
                position: absolute;
                inset: -2px;
                background: radial-gradient(220px 160px at 15% 15%, rgba(65,217,181,.16), transparent 60%), radial-gradient(240px 160px at 90% 0%, rgba(122,167,255,.14), transparent 60%);
                pointer-events: none;
            }

        .avatar {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            overflow: hidden;
            flex: 0 0 auto;
            border: 1px solid rgba(255,255,255,.14);
            box-shadow: 0 10px 22px rgba(0,0,0,.22);
            background: rgba(255,255,255,.06);
            position: relative;
            z-index: 1;
        }

            .avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .content {
            flex: 1;
            min-width: 0;
            position: relative;
            z-index: 1;
        }

        .nameRow {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .nameBtn {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            border: 0;
            background: transparent;
            color: var(--text);
            padding: 0;
            cursor: pointer;
            text-align: left;
        }

        .name {
            font-weight: 900;
            letter-spacing: -.3px;
            font-size: 16px;
            line-height: 1.1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 240px;
        }

        .readBadge {
            flex: 0 0 auto;
            padding: 9px 10px;
            border-radius: 14px;
            background: rgba(65,217,181,.14);
            border: 1px solid rgba(65,217,181,.24);
            color: var(--text);
            font-size: 12px;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 10px 20px rgba(0,0,0,.18);
        }

            .readBadge .dot {
                width: 8px;
                height: 8px;
                border-radius: 99px;
                background: var(--accent);
                box-shadow: 0 0 0 6px rgba(65,217,181,.14);
            }

        .empty {
            margin-top: 22px;
            padding: 18px;
            border-radius: var(--radius);
            border: 1px dashed rgba(255,255,255,.18);
            background: rgba(255,255,255,.05);
            color: var(--muted);
            text-align: center;
        }

        /* ======= Bottom Nav ======= */
        .bottomNav {
           
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 30;
            padding: 10px 12px calc(12px + env(safe-area-inset-bottom)); /* ✅ iPhone 홈바 대응 */
            background: linear-gradient(180deg, rgba(11,18,32,0), rgba(11,18,32,.85) 25%, rgba(11,18,32,.92));
            backdrop-filter: blur(10px);
        }

        .navInner {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            gap: 10px;
        }

        .navBtn {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 10px;
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,.12);
            background: rgba(255,255,255,.06);
            color: var(--text);
            font-weight: 900;
            cursor: pointer;
            user-select: none;
            box-shadow: 0 10px 22px rgba(0,0,0,.22);
            transition: transform .12s ease, background .12s ease;
        }

            .navBtn:active {
                transform: scale(.98);
            }

        .navHome {
            background: linear-gradient(135deg, rgba(122,167,255,.18), rgba(255,255,255,.06));
        }

        .navMain {
            background: linear-gradient(135deg, rgba(65,217,181,.16), rgba(255,255,255,.06));
        }

        .navBible {
            background: linear-gradient(135deg, rgba(255,214,102,.18), rgba(255,255,255,.06));
        }

        /* ======= Responsive ======= */
        @@media (min-width: 560px) {
            .card

        {
            grid-column: span 6;
        }

        .name {
            max-width: 220px;
        }

        }

        @@media (min-width: 920px) {
            .card

        {
            grid-column: span 4;
        }

        .name {
            max-width: 240px;
        }

        }

        /* 📱 모바일에서는 하단 버튼 세로 정렬 */
        @@media (max-width: 600px) {
            .navInner

        {
            flex-direction: column;
            gap: 8px;
        }

        .navBtn {
            width: 100%;
            justify-content: center;
            padding: 14px 10px;
            border-radius: 14px;
        }

        }

        /* accessibility */
        @@media (prefers-reduced-motion: reduce) {
            *

        {
            transition: none !important;
            scroll-behavior: auto !important;
        }

        }
    </style>
</head>

<body>
    <!-- ✅ TopBar -->
    <div class="topbar">
        <div class="topbarInner">
            <div class="brand">
                <div class="titleRow">
                    <div class="badgeLogo">📖</div>
                    <h1>@ConstatsCommon.ReadBibleAllTitleButton</h1>
                </div>
                <p class="sub">1독 이상 완독자 현황 · (오프라인 & 온라인 통합 집계)</p>
            </div>

            <div class="statsMini">
                <div class="pill">참여자 <b>@totalCount</b> 명</div>
                <div class="pill">최다 <b>@maxRead</b> 독</div>
                <div class="pill">평균 <b>@avgRead.ToString("0.0")</b> 독</div>
            </div>
        </div>

        <!-- ✅ Search / Sort -->
        <div class="controls">
            <div class="searchWrap">
                <span class="searchIcon">🔎</span>
                <input id="q" type="text" placeholder="이름으로 검색해요 (예: 서준)" autocomplete="off" />
            </div>

            <div class="selectWrap">
                <select id="sort">
                    <option value="count_desc">독수 높은 순</option>
                    <option value="count_asc">독수 낮은 순</option>
                    <option value="name_asc">이름 가나다순</option>
                    <option value="name_desc">이름 역순</option>
                </select>
            </div>
        </div>
    </div>

    <div class="wrap">
        @if (totalCount <= 0)
        {
            <div class="empty">
                아직 1독 이상 완독자가 없어요. <br />
                첫 완독자가 나오면 여기에 멋지게 표시됩니다! ✨
            </div>
        }
        else
        {
            <div id="grid" class="grid">
                @foreach (var item in list)
                {
                    var perData = $"{item.readBibleAllCount}독 완료";
                    var rank = RankOf(item);

                    // ✅ 진행바: 1독=35%, 2독=55%, 3독=70%, 4독=82%, 5독+=92~100%
                    int pct = 35;
                    if (item.readBibleAllCount == 1) pct = 35;
                    else if (item.readBibleAllCount == 2) pct = 55;
                    else if (item.readBibleAllCount == 3) pct = 70;
                    else if (item.readBibleAllCount == 4) pct = 82;
                    else if (item.readBibleAllCount >= 5) pct = 92 + Math.Min(8, (item.readBibleAllCount - 5));
                    if (pct > 100) pct = 100;

                    <div class="card"
                         data-name="@Safe(item.LastName + item.FirstName)"
                         data-count="@item.readBibleAllCount"
                         data-userid="@item.UserId">

                        <div class="avatar">
                            <img src="@item.ProfilePicturePath" alt="@Safe(item.LastName + item.FirstName) 프로필" loading="lazy" />
                        </div>

                        <div class="content">
                            <div class="nameRow">
                                <button class="nameBtn" type="button"
                                        onclick="location.href='/bibleCenter/MyDashboard?userId=@item.UserId'">
                                    <span class="name">@Safe(item.LastName + item.FirstName)님</span>
                                </button>

                                <div class="readBadge" title="완독 횟수">
                                    <span class="dot"></span>
                                    <span>@perData</span>
                                </div>
                            </div>

                            @* 진행바가 필요하면 주석 해제
                            <div class="progressWrap" aria-hidden="true">
                                <div class="bar"><i style="width:@pct%;"></i></div>
                                <div class="barText">@pct%</div>
                            </div>
                            *@
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- ✅ Bottom Navigation -->
    <div class="bottomNav" id="bottomNav">
        <div class="navInner">
            <div class="navBtn navHome" onclick="location.href='/'">
                <span>🏠</span>
                <span>Home</span>
            </div>
            <div class="navBtn navMain" onclick="location.href='/Home/MissionMainBoard'">
                <span>🎯</span>
                <span>@ConstatsCommon.MainKeyTitle</span>
            </div>
            <div class="navBtn navBible" onclick="location.href='/bibleCenter/MyDashboard'">
                <span>📖</span>
                <span>@ConstatsCommon.ReadBibleAllTitleButton</span>
            </div>
        </div>

        <div style="max-width:1100px;margin:8px auto 0;padding:0 4px;color:rgba(234,242,255,.45);font-size:11px;text-align:center;">
            &copy; @DateHelper.GetKoreaNow().Year @($"{ChurchName} {DepartmentName}".Trim()) All Rights Reserved.
        </div>
    </div>

    <script>
        (function () {
            const q = document.getElementById('q');
            const sort = document.getElementById('sort');
            const grid = document.getElementById('grid');

            function normalize(s) {
                return (s || '').toString().trim().toLowerCase();
            }

            function applyFilterAndSort() {
                if (!grid) return;

                const keyword = normalize(q.value);
                const items = Array.from(grid.querySelectorAll('.card'));

                items.forEach(el => {
                    const name = normalize(el.getAttribute('data-name'));
                    const ok = !keyword || name.includes(keyword);
                    el.style.display = ok ? '' : 'none';
                });

                const mode = sort.value;

                const sorted = items.sort((a, b) => {
                    const ca = parseInt(a.getAttribute('data-count') || '0', 10);
                    const cb = parseInt(b.getAttribute('data-count') || '0', 10);
                    const na = (a.getAttribute('data-name') || '').toString();
                    const nb = (b.getAttribute('data-name') || '').toString();

                    if (mode === 'count_desc') return cb - ca || na.localeCompare(nb, 'ko');
                    if (mode === 'count_asc') return ca - cb || na.localeCompare(nb, 'ko');
                    if (mode === 'name_desc') return nb.localeCompare(na, 'ko');
                    return na.localeCompare(nb, 'ko');
                });

                sorted.forEach(el => grid.appendChild(el));
            }

            // ✅ bottomNav 실제 높이를 재서, 마지막 카드가 가리지 않도록 wrap padding을 자동 보정
            function syncBottomNavHeight() {
                const nav = document.getElementById('bottomNav');
                if (!nav) return;
                const h = Math.ceil(nav.getBoundingClientRect().height || 0);
                document.documentElement.style.setProperty('--bottomNavH', h + 'px');
            }

            if (q) q.addEventListener('input', applyFilterAndSort);
            if (sort) sort.addEventListener('change', applyFilterAndSort);

            window.addEventListener('load', function () {
                applyFilterAndSort();
                syncBottomNavHeight();
            });
            window.addEventListener('resize', syncBottomNavHeight);
        })();
    </script>
</body>
</html>
