@model BulletinBoard.Models.eBibleBase
@using BulletinBoard.Common;
@using BulletinBoard.Enums
@using BulletinBoard.Helpers;
@using Microsoft.AspNetCore.Http;
@using BulletinBoard.Services.Abstract
@inject IAuthService AuthService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = null;

    string ActionSource = HttpContextAccessor.HttpContext.Session.GetString(MVCInfomation.ActionSource.ToString()) as String;
    string ControllerSource = HttpContextAccessor.HttpContext.Session.GetString(MVCInfomation.ControllerSource.ToString()) as String;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>성경 말씀 카드</title>
    <link href="https://fonts.googleapis.com/css2?family=Gowun+Dodum&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Gowun Dodum', sans-serif;
            background: url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1400&q=80') no-repeat center center fixed;
            background-size: cover;
        }

        .overlay {
            background-color: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(4px);
        /*    min-height: 100vh;*/
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        h1 {
            text-align: center;
            color: #2f4f4f;
            font-size: 2rem;
            margin-bottom: 30px;
            background-color: rgba(255, 255, 255, 0.5);
            padding: 10px 20px;
            border-radius: 12px;
        }

        .card-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
            width: 100%;
            max-width: 1000px;
        }

        .bible-card {
            background-color: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
            padding: 20px;
            width: 300px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s ease;
        }

            .bible-card:hover {
                transform: translateY(-5px);
            }

        .verse-reference {
            font-weight: bold;
            font-size: 1.1rem;
            color: #3e6b4b;
            margin-bottom: 10px;
        }

        .verse-text {
            font-size: 1rem;
            color: #333;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .copy-button {
            align-self: flex-end;
            padding: 6px 12px;
            background-color: #3e6b4b;
            color: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-size: 0.9rem;
        }

            .copy-button:hover {
                background-color: #2e5036;
            }

        @@media (max-width: 600px) {
            .bible-card {
                width: 90%;
            }

            h1 {
                font-size: 1.5rem;
            }
        }
    </style>
    <link rel="stylesheet" href="/css/card7.css">
    <link rel="stylesheet" href="/css/ButtonBase7.css">
    <link rel="stylesheet" href="/css/ColorBase7.css">

</head>
<body>
    <div class="overlay">
        <h1>🌿 오늘의 성경 말씀 🌞</h1>
        <div class="card-container">
            <div class="bible-card">
                <div class="verse-reference">@Model.BibleText @Model.Jang:@Model.zul</div>
                <div class="verse-text">
                    @Model.BibleData
                </div>

            </div>
        </div>
    </div>
    <br />
    @await Html.PartialAsync("_PublishNavigationButton_Home_Old_New_Board")
</body>
</html>
