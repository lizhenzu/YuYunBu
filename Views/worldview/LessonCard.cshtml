            .yt-btn {
                width: 62px;
                height: 42px;
            }

            .action-bar {
                grid-template-columns: 1fr;
            }

            .bigBtn {
                min-height: 70px;
            }
        }

        .yt-modal {
            position: fixed;
            inset: 0;
            background: rgba(10, 12, 18, .55);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 16px;
            z-index: 9999;
        }

            .yt-modal.show {
                display: flex;
            }

        .yt-sheet {
            width: min(920px, 100%);
            border-radius: 20px;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(20,30,60,.10);
            box-shadow: 0 24px 70px rgba(0,0,0,.25);
            overflow: hidden;
            backdrop-filter: blur(10px);
        }

        .yt-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            background: linear-gradient(90deg, rgba(107,78,162,.12), rgba(255,45,85,.10));
        }

        .yt-title {
            font-weight: 950;
            color: #2f2f44;
            letter-spacing: -.2px;
            font-size: 14px;
        }

        .yt-close {
            border: 0;
            cursor: pointer;
            width: 38px;
            height: 38px;
            border-radius: 12px;
            font-weight: 950;
            background: #fff;
            box-shadow: 0 10px 18px rgba(20,25,40,.08);
        }

        .yt-frame-wrap {
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #000;
        }

        .yt-frame {
            width: 100%;
            height: 100%;
            border: 0;
        }




        /* =========================
           ✅ Mission CTA (눈에 띄게 + 반짝)
           ========================= */

        /* 기존 .mission 덮어쓰기 */
        .mission {
            width: 138px;
            height: 138px;
            border-radius: 999px;
            right: 14px;
            bottom: 14px;
            /* 더 강한 컬러 + 대비 */
            background: radial-gradient(circle at 30% 25%, rgba(255,255,255,.95), rgba(255,255,255,0) 35%), radial-gradient(circle at 35% 35%, #fff2b8, #ffd36a 58%, #ffb43a 100%);
            border: 3px solid rgba(120, 80, 10, .28);
            /* 강한 그림자 + 글로우 */
            box-shadow: 0 22px 40px rgba(40,30,10,.22), 0 0 0 6px rgba(255, 196, 61, .20), 0 0 30px rgba(255, 196, 61, .38);
            transform: rotate(-8deg);
            z-index: 5; /* 더 앞으로 */
            overflow: hidden;
            /* ✅ 반짝 + 두근 */
            animation: missionPulse 1.35s ease-in-out infinite;
            will-change: transform, filter, box-shadow;
        }

            /* 주변에 “반짝 입자” 느낌 */
            .mission:before,
            .mission:after {
                content: "";
                position: absolute;
                inset: -30px;
                border-radius: 999px;
                pointer-events: none;
            }

            .mission:before {
                background: radial-gradient(circle at 25% 30%, rgba(255,255,255,.85) 0 6px, transparent 7px), radial-gradient(circle at 70% 25%, rgba(255,255,255,.75) 0 4px, transparent 5px), radial-gradient(circle at 62% 70%, rgba(255,255,255,.65) 0 5px, transparent 6px), radial-gradient(circle at 30% 75%, rgba(255,255,255,.60) 0 3px, transparent 4px);
                opacity: .55;
                animation: missionSpark 2.2s linear infinite;
            }

            .mission:after {
                background: conic-gradient(from 0deg, rgba(255,255,255,.35), rgba(255,255,255,0) 35%, rgba(255,255,255,.25) 60%, rgba(255,255,255,0) 100%);
                opacity: .35;
                animation: missionShine 2.0s ease-in-out infinite;
            }

            /* 텍스트 더 또렷 */
            .mission .t {
                font-size: 14px;
                font-weight: 950;
                color: #5a3a00;
                text-shadow: 0 2px 0 rgba(255,255,255,.5);
                line-height: 1.15;
            }

            /* 체크박스: 크게 + 더 잘 보이게 */
            .mission input {
                width: 28px;
                height: 28px;
                accent-color: #b7791f;
                cursor: pointer;
                filter: drop-shadow(0 8px 10px rgba(40,30,10,.18));
                transform: translateY(1px);
            }

            /* 힌트 라벨 (작은 배지) */
            .mission .hint {
                margin-top: 6px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 6px 10px;
                border-radius: 999px;
                background: rgba(255,255,255,.72);
                border: 1px solid rgba(120,80,10,.20);
                font-size: 11px;
                font-weight: 900;
                color: #6a4b00;
                box-shadow: 0 10px 18px rgba(20,25,40,.10);
                animation: hintBlink 1.6s ease-in-out infinite;
            }

        @@keyframes missionPulse {
            0%

        {
            transform: rotate(-8deg) scale(1);
            box-shadow: 0 22px 40px rgba(40,30,10,.22), 0 0 0 6px rgba(255, 196, 61, .18), 0 0 26px rgba(255, 196, 61, .32);
            filter: saturate(1.0);
        }

        50% {
            transform: rotate(-8deg) scale(1.06);
            box-shadow: 0 28px 52px rgba(40,30,10,.28), 0 0 0 10px rgba(255, 196, 61, .22), 0 0 44px rgba(255, 196, 61, .55);
            filter: saturate(1.15);
        }

        100% {
            transform: rotate(-8deg) scale(1);
        }

        }

        @@keyframes missionSpark {
            0%

        {
            transform: rotate(0deg);
            opacity: .45;
        }

        50% {
            opacity: .75;
        }

        100% {
            transform: rotate(360deg);
            opacity: .45;
        }

        }

        @@keyframes missionShine {
            0%

        {
            transform: rotate(0deg);
            opacity: .22;
        }

        50% {
            opacity: .45;
        }

        100% {
            transform: rotate(18deg);
            opacity: .22;
        }

        }

        @@keyframes hintBlink {
            0%,100%

        {
            transform: translateY(0);
            opacity: .95;
        }

        50% {
            transform: translateY(-2px);
            opacity: 1;
        }

        }

        /* ✅ 모바일에서 너무 덜컹하지 않게 */
        @@media (max-width: 420px) {
            .mission

        {
            width: 122px;
            height: 122px;
        }

        .mission input {
            width: 26px;
            height: 26px;
        }

        }
    </style>
</head>

<body>
    <main class="paper" role="main" aria-label="성경적 세계관 웹카드">

        <!-- HEADER -->
        <section class="header">
            <div class="lesson-cloud" aria-label="@($"{L}과")">
                <div class="lesson-num">@L</div>
                <div class="lesson-text">과</div>
            </div>

            <div class="title-wrap">
                <div class="unit">@GetText("HeaderUnit")</div>
                <h1 class="title">@GetText("HeaderTitle")</h1>
            </div>

            <!-- ✅ 우측: 유튜브(성경이야기) -->
            <div class="right-area" aria-label="영상">
                <div class="qr-mini" aria-label="성경이야기 영상">
                    <div class="qr" title="성경이야기 영상">
                        <button type="button"
                                class="yt-btn"
                                data-yt="@(hasHeaderYt? headerYoutubeUrl : "")"
                                @(hasHeaderYt ? "" : "disabled")
                                aria-label="성경이야기 유튜브 영상 보기">
                            ▶
                            <small>영상</small>
                        </button>
                    </div>
                    <div class="badge">@GetText("HeaderQrBadge", "성경이야기")</div>
                </div>
            </div>
        </section>

        <!-- VERSE BAND -->
        <section class="verse-band" aria-label="외울 말씀">
            <div class="verse-left">
                <span class="verse-pill">@GetText("VerseRef")</span>
                <span class="verse-pill">@GetText("VerseTag", "외울말씀")</span>
            </div>
            <div class="verse-verse">@GetText("VerseText")</div>
        </section>

        <!-- DEFINITION -->
        @{
            var defTemplate = GetText("DefTextTemplate");
            var parts = System.Text.RegularExpressions.Regex.Split(defTemplate, @"(\{\{WORD\d+\}\})");
        }
        <section class="definition" aria-label="성경적 세계관 정의">
            <div class="glasses">
                <div class="icon" aria-hidden="true">👓</div>
                <div class="label">@GetText("DefLabel", "말씀안경")</div>
            </div>

            <div class="def-text" data-lesson="@L">
                @foreach (var raw in parts)
                {
                    // ✅ Trim 제거: {{WORD}} 앞뒤 공백 손실 방지
                    var part = raw;
                    if (string.IsNullOrWhiteSpace(part)) { continue; }

                    if (System.Text.RegularExpressions.Regex.IsMatch(part, @"^\{\{WORD\d+\}\}$"))
                    {
                        var groupKey = part.Substring(2, part.Length - 4); // WORD1

                        if (Model.BlankGroupCounts != null &&
                        Model.BlankGroupCounts.TryGetValue(groupKey, out var count) &&
                        count > 0)
                        {
                            <span class="blank" data-group="@groupKey">
                                @for (int i = 0; i < count; i++)
                                {
                                   <input class="box blank-char"
       data-group="@groupKey"
       data-idx="@(i + 1)"
       maxlength="1"
       inputmode="text"
       enterkeyhint="next"
       autocomplete="off"
       autocapitalize="off"
       autocorrect="off"
      placeholder="@(Model.BlankInitialMap != null
    && Model.BlankInitialMap.TryGetValue(groupKey, out var idxMap)
    && idxMap.TryGetValue(i + 1, out var ch)
        ? (ch ?? "").Trim() : "")"
       spellcheck="false" />

                                }
                            </span>
                        }
                    }
                    else
                    {
                       @part
                    }
                }

                <div style="margin-top:12px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                    <button type="button" id="btnCheckBlanks" data-check-url="@Url.Action("CheckBlanks", "Worldview")"
                            style="border:0; cursor:pointer; padding:10px 14px; border-radius:999px; font-weight:900;
                               background:linear-gradient(90deg,#6b4ea2,#8a76c9); color:#fff; box-shadow:0 12px 24px rgba(70,50,120,.18);">
                        제출하기
                    </button>
                    <span id="blankResultMsg" style="font-weight:900; color:#2f2f44;"></span>
                </div>
            </div>
        </section>

        <!-- TWO PANELS -->
        <section class="grid2" aria-label="활동 영역">
            <article class="panel pink" aria-label="가족과 이야기해요">
                <div class="panel-title">
                    <div class="sticker" aria-hidden="true">🏠</div>
                    <div>@GetText("FamilyTitle", "가족과 이야기해요")</div>
                </div>

                <ul>
                    <li>@GetText("FamilyQ1")</li>
                    <li>@GetText("FamilyQ2")</li>
                    <li>@GetText("FamilyQ3")</li>
                </ul>

                <div class="say-box" role="note" aria-label="축복 문장 예시">
                    <div class="cap">@GetText("SayCapToChild", "자녀에게")</div>
                    <div class="say">@GetText("SayParent")</div>
                    <div class="cap">@GetText("SayCapToParent", "부모님께")</div>
                    <div class="say">@GetText("SayChild")</div>
                </div>
            </article>

            <article class="panel blue" aria-label="소금과 빛">
                <div class="panel-title">
                    <div class="sticker" aria-hidden="true">✨</div>
                    <div>@GetText("SaltTitle", "소금과 빛")</div>
                </div>

                <ul>
                    <li>@GetText("SaltQ1")</li>
                    <li>@GetText("SaltQ2")</li>
                </ul>

                @if (hasActivityYt)
                {
                    <div class="qr-big" aria-label="활동 영상">
                        <div class="qr" title="활동 영상" style="width:120px;height:120px;border-radius:16px;">
                            <button type="button"
                                    class="yt-btn"
                                    data-yt="@activityYoutubeUrl"
                                    aria-label="활동 유튜브 영상 보기"
                                    style="width:86px;height:56px;border-radius:16px;">
                                ▶
                                <small>보기</small>
                            </button>
                        </div>
                    </div>
                }
            </article>
        </section>

        <!-- PRAYER -->
        <section class="prayer" aria-label="기도하기">
            <div class="prayer-head">
                <div class="sticker" aria-hidden="true">🙏</div>
                <div>@GetText("PrayerTitle", "기도하기")</div>
            </div>

            <p class="prayer-text">@GetText("PrayerText")</p>

            <div class="mission" aria-label="미션 완료 체크">
                <div class="t">@GetText("MissionTitle", "미션북 완료")</div>
                <input type="checkbox" aria-label="미션 완료 체크박스" />
            </div>
        </section>

        <!-- ✅ 하단 버튼 -->
        <section class="action-bar" aria-label="페이지 이동 및 미션 제출">
            <button type="button" class="bigBtn home" id="btnHome" title="홈으로">
                <div class="bigIcon">🏠</div>
                <div class="bigText">
                    <div class="bigTitle">홈으로</div>
                    <div class="bigSub">메인 화면으로 이동</div>
                </div>
            </button>

            <button type="button" class="bigBtn " id="btnMissionHome" title="미션 홈으로">
                <div class="bigIcon">🌱</div>
                <div class="bigText">
                    <div class="bigTitle">미션 홈</div>
                    <div class="bigSub">전체 미션을 한눈에</div>
                </div>
            </button>

            <button type="button" class="bigBtn status" id="btnDash" title="완료 현황 보기">
                <div class="bigIcon">📊</div>
                <div class="bigText">
                    <div class="bigTitle">완료 현황</div>
                    <div class="bigSub">내 진행 상황 확인</div>
                </div>
            </button>

            <button type="button" class="bigBtn submit" id="btnMissionSubmit" title="미션 제출">
                <div class="bigIcon">📝</div>
                <div class="bigText">
                    <div class="bigTitle">미션 제출</div>
                    <div class="bigSub">자녀와 공과북을 함께 마쳤다면, 제출해 주세요 🌱</div>
                </div>
            </button>
        </section>

        <div class="guide-box" style="margin-top:10px; font-size:13px; color:#6b7894;">
            ✅ <b>제출 시 기본 3점</b>이 적립돼요.<br />
            🎁 모든 빈칸을 <b>정답으로 맞춘 상태</b>에서 제출하면 <b>추가 2점</b>이 더해져서 <b>총 5점</b>이 돼요!<br />
            ⚠️ 점수는 <b>레슨(과)당 1회만</b> 적립돼요.
        </div>
    </main>

    <!-- ✅ 유튜브 모달 -->
    <div class="yt-modal" id="ytModal" aria-hidden="true">
        <div class="yt-sheet" role="dialog" aria-modal="true" aria-label="유튜브 영상">
            <div class="yt-topbar">
                <div class="yt-title" id="ytTitle">영상 보기</div>
                <button type="button" class="yt-close" id="ytClose" aria-label="닫기">✕</button>
            </div>
            <div class="yt-frame-wrap">
                <iframe class="yt-frame" id="ytFrame"
                        src=""
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen></iframe>
            </div>
        </div>
    </div>

    <script>
        let lastCheck = { checked: false, isAllCorrect: false };

        (function () {
            // ===========================
            // ✅ 이동 버튼 URL
            // ===========================
            const HOME_URL = "/";
            const MISSION_HOME_URL = "/Worldview/Intro";
            const DASHBOARD_URL = "/Worldview/DashBoard";

            const btnHome = document.getElementById("btnHome");
            const btnMissionHome = document.getElementById("btnMissionHome");
            const btnDash = document.getElementById("btnDash");

            if (btnHome) btnHome.addEventListener("click", () => location.href = HOME_URL);
            if (btnMissionHome) btnMissionHome.addEventListener("click", () => location.href = MISSION_HOME_URL);
            if (btnDash) btnDash.addEventListener("click", () => location.href = DASHBOARD_URL);

            // ===========================
            // ✅ 유튜브 모달
            // ===========================
            const modal = document.getElementById('ytModal');
            const frame = document.getElementById('ytFrame');
            const closeBtn = document.getElementById('ytClose');
            const titleEl = document.getElementById('ytTitle');

            function toEmbedUrl(url) {
                if (!url) return "";
                url = ("" + url).trim();
                if (url.includes("youtube.com/embed/")) return url;

                const shortMatch = url.match(/youtu\.be\/([a-zA-Z0-9_-]{6,})/);
                if (shortMatch && shortMatch[1]) return "https://www.youtube.com/embed/" + shortMatch[1] + "?autoplay=1&rel=0";

                const watchMatch = url.match(/[?&]v=([a-zA-Z0-9_-]{6,})/);
                if (watchMatch && watchMatch[1]) return "https://www.youtube.com/embed/" + watchMatch[1] + "?autoplay=1&rel=0";

                return url;
            }

            function openModal(rawUrl, titleText) {
                const embed = toEmbedUrl(rawUrl);
                if (!embed) return;

                titleEl.textContent = titleText || "영상 보기";
                frame.src = embed;

                modal.classList.add('show');
                modal.setAttribute('aria-hidden', 'false');
                document.addEventListener('keydown', onEsc);
            }

            function closeModal() {
                modal.classList.remove('show');
                modal.setAttribute('aria-hidden', 'true');
                frame.src = "";
                document.removeEventListener('keydown', onEsc);
            }

            function onEsc(e) { if (e.key === 'Escape') closeModal(); }

            document.querySelectorAll('.yt-btn[data-yt]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const url = btn.getAttribute('data-yt') || "";
                    if (!url) return;

                    const isHeader = btn.closest('.qr-mini') != null;
                    const titleText = isHeader ? "성경이야기 영상" : "활동 영상";
                    openModal(url, titleText);
                });
            });

            modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
            closeBtn?.addEventListener('click', closeModal);

            // ===========================
            // ✅ API 호출: 제출
            // ===========================
            async function submitLesson(lessonNo, answersObj) {
                const res = await fetch("/Worldview/submitlesson", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ lessonNo, answers: answersObj })
                });

                const data = await res.json();
                if (!res.ok) {
                    alert(data?.message || "제출에 실패했어요.");
                    return;
                }

                alert(data.message + `\n(기본 ${data.basePoint}점 + 보너스 ${data.bonusPoint}점 = 총 ${data.totalPoint}점)`);
            }

            // ===========================
            // ✅ 채점 결과 UI 반영
            // ===========================
            function applyCheckResult(result) {
                const perGroup = result?.perGroupCorrect ?? result?.PerGroupCorrect ?? {};
                const msgText = result?.message ?? result?.Message ?? "";

                document.querySelectorAll('input.blank-char').forEach(input => {
                    input.classList.remove('wrong', 'correct');
                });

                Object.entries(perGroup).forEach(([group, ok]) => {
                    const inputs = document.querySelectorAll(`input.blank-char[data-group="${group}"]`);
                    inputs.forEach(i => i.classList.add(ok ? 'correct' : 'wrong'));
                });

                const msg = document.getElementById('blankResultMsg');
                if (msg) msg.textContent = msgText || '';

                const allCorrect =
                    result?.isAllCorrect ?? result?.IsAllCorrect ??
                    result?.isCorrect ?? result?.IsCorrect ??
                    false;

                lastCheck.checked = true;
                lastCheck.isAllCorrect = !!allCorrect;
            }

            // ===========================
            // ✅ 답 수집 유틸
            // ===========================
            function collectAnswers() {
                const answers = {};
                document.querySelectorAll('input.blank-char').forEach(input => {
                    const group = input.dataset.group;
                    const idx = parseInt(input.dataset.idx || "0", 10) - 1;
                    if (!group || idx < 0) return;
                    if (!answers[group]) answers[group] = [];
                    answers[group][idx] = input.value || "";
                });

                Object.keys(answers).forEach(k => {
                    answers[k] = (answers[k] || []).map(v => v || "");
                });

                return answers;
            }

            // ===========================
            // ✅ 제출하기(채점) 버튼
            // ===========================
            const btnCheck = document.getElementById('btnCheckBlanks');

            btnCheck?.addEventListener('click', async () => {
                const lessonNo = parseInt(document.querySelector('.def-text')?.dataset.lesson || "0", 10);
                const url = btnCheck.dataset.checkUrl;

                if (!lessonNo) { alert("lessonNo 없음"); return; }
                if (!url) { alert("check url 없음"); return; }

                const answers = collectAnswers();

                try {
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ lessonNo, answers })
                    });

                    const text = await res.text();
                    if (!res.ok) {
                        alert("채점 오류: " + res.status + "\n" + text);
                        return;
                    }

                    const result = JSON.parse(text);
                    applyCheckResult(result);

                } catch (err) {
                    alert("네트워크/스크립트 오류: " + err);
                }
            });

            // ===========================
            // ✅ 미션 제출 버튼 (중복 클릭 방지)
            // ===========================
            const btnMissionSubmit = document.getElementById("btnMissionSubmit");
            if (btnMissionSubmit) {
                btnMissionSubmit.addEventListener("click", async () => {
                    if (btnMissionSubmit.dataset.busy === "1") return;
                    btnMissionSubmit.dataset.busy = "1";
                    btnMissionSubmit.disabled = true;

                    try {
                        const checked = document.querySelector('.mission input[type="checkbox"]')?.checked;
                        if (!checked) { alert("미션 완료 체크를 먼저 해주세요 😊"); return; }

                        const lessonNo = parseInt(document.querySelector('.def-text')?.dataset.lesson || "0", 10);
                        if (!lessonNo) { alert("lessonNo 없음"); return; }

                        const answers = collectAnswers();

                        // ✅ 아직 채점을 안했다면 먼저 채점
                        if (!lastCheck.checked) {
                            const url = document.getElementById('btnCheckBlanks')?.dataset.checkUrl;
                            if (!url) { alert("check url 없음"); return; }

                            const res = await fetch(url, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ lessonNo, answers })
                            });

                            const text = await res.text();
                            if (!res.ok) { alert("채점 오류: " + res.status + "\n" + text); return; }

                            const result = JSON.parse(text);
                            applyCheckResult(result);
                        }

                        await submitLesson(lessonNo, answers);

                    } finally {
                        btnMissionSubmit.disabled = false;
                        btnMissionSubmit.dataset.busy = "0";
                    }
                });
            }

        })();
    </script>

</body>
</html>
