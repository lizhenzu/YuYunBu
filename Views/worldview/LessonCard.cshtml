@using System.Net
@*  Views/Worldview/LessonCard.cshtml  *@
@using BulletinBoard.ViewModels.Worldview
@model BulletinBoard.ViewModels.Worldview.WorldviewLessonVM
@{
    Layout = null;

    var L = Model?.LessonNo ?? 1;

    // ✅ fallback 없으면 key(N/A) 표시
    string GetText(string key, string fallback = "")
    {
        string result;

        if (Model?.ContentMap != null &&
            Model.ContentMap.TryGetValue(key, out var v) &&
            !string.IsNullOrWhiteSpace(v))
        {
            result = v;
        }
        else if (!string.IsNullOrWhiteSpace(fallback))
        {
            result = fallback;
        }
        else
        {
            result = $"{key}(N/A)";
        }

        // ✅ DB에 "\n" (두 글자)로 저장된 경우 → 실제 줄바꿈으로
        result = result.Replace("\\r\\n", "\n").Replace("\\n", "\n");

        // ✅ 혹시 CRLF가 섞여 있으면 정리 (선택)
        result = result.Replace("\r\n", "\n");

        return result;
    }

    // ✅ 유튜브 URL (DB에서 가져옴)
    var headerYoutubeUrl = GetText("HeaderYouTubeUrl");
    var activityYoutubeUrl = GetText("ActivityYouTubeUrl");

    // ✅ (중요) GetText가 (N/A)를 돌려주므로, 실제 URL 유무 판별은 별도로!
    bool HasRealUrl(string? s)
        => !string.IsNullOrWhiteSpace(s) && !s.Trim().EndsWith("(N/A)", StringComparison.Ordinal);

    var hasHeaderYt = HasRealUrl(headerYoutubeUrl);
    var hasActivityYt = HasRealUrl(activityYoutubeUrl);
}

