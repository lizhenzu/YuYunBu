function confirmMessage(showCancelButton, messageText = '정상적으로 처리되었습니다.') {
    return new Promise((resolve, reject) => {
        var alertBox = document.createElement('div');
        alertBox.style.position = 'fixed';
        alertBox.style.left = '50%';
        alertBox.style.top = '50%';
        alertBox.style.transform = 'translate(-50%, -50%)';
        alertBox.style.padding = '20px';
        alertBox.style.backgroundColor = '#fff';
        alertBox.style.border = '1px solid #ccc';
        alertBox.style.borderRadius = '10px';
        alertBox.style.zIndex = '9999';
        alertBox.style.textAlign = 'center';
        alertBox.style.width = '300px'; // 알림 창 너비 지정

        // "알림" 메시지 추가
        var alertTitle = document.createElement('div');
        alertTitle.innerText = '알림';
        alertTitle.style.fontSize = '16px';
        alertTitle.style.color = '#fff';
        alertTitle.style.backgroundColor = '#007BFF'; // 배경 색상 지정
        alertTitle.style.padding = '10px 0';
        alertTitle.style.width = '100%'; // 좌우 100% 차게
        alertTitle.style.marginTop = '12px'; // 상단 여백
        alertTitle.style.marginBottom = '23px'; // 하단 여백

        //// 메세지 추가
        //var message = document.createElement('p');
        //message.innerText = '정상적으로 처리되었습니다.';
        //message.style.fontSize = '14px'; // 글씨 크기를 줄임
        //message.style.whiteSpace = 'nowrap'; // 텍스트가 한 줄로 유지되도록 함

        var message = document.createElement('p');
        message.innerText = messageText;
        message.style.fontSize = '15px'; // 글씨 크기를 줄임
       // message.style.whiteSpace = 'nowrap'; // 텍스트가 한 줄로 유지되도록 함
        message.style.fontWeight = 'bold';

        // 확인 버튼 추가
        var confirmButton = document.createElement('button');
        confirmButton.innerText = '확인';
        confirmButton.style.marginTop = '10px';
        confirmButton.style.padding = '5px 20px';
        confirmButton.style.backgroundColor = '#4CAF50';
        confirmButton.style.color = '#fff';
        confirmButton.style.border = 'none';
        confirmButton.style.borderRadius = '5px';
        confirmButton.style.cursor = 'pointer';
        confirmButton.style.display = 'inline-block'; // 인라인 블록으로 버튼 나란히 배치

        // 취소 버튼 추가
        var cancelButton = document.createElement('button');
        cancelButton.innerText = '취소';
        cancelButton.style.marginTop = '10px';
        cancelButton.style.marginLeft = '10px'; // 확인 버튼과 간격 추가
        cancelButton.style.padding = '5px 20px';
        cancelButton.style.backgroundColor = '#f44336';
        cancelButton.style.color = '#fff';
        cancelButton.style.border = 'none';
        cancelButton.style.borderRadius = '5px';
        cancelButton.style.cursor = 'pointer';
        cancelButton.style.display = 'inline-block'; // 인라인 블록으로 버튼 나란히 배치

        // 확인 버튼 클릭 시 'y' 반환
        confirmButton.onclick = function () {
            document.body.removeChild(alertBox);
            document.body.removeChild(overlay);
            resolve('y');
        };

        // 취소 버튼 클릭 시 'c' 반환
        cancelButton.onclick = function () {
            document.body.removeChild(alertBox);
            document.body.removeChild(overlay);
            resolve('c');
        };

        alertBox.appendChild(alertTitle); // 알림 메시지를 먼저 추가
        alertBox.appendChild(message);
        alertBox.appendChild(confirmButton);

        if (showCancelButton) {
            alertBox.appendChild(cancelButton); // 취소 버튼 추가
        }

        var overlay = document.createElement('div');
        overlay.style.position = 'fixed';
        overlay.style.top = '0';
        overlay.style.left = '0';
        overlay.style.width = '100%';
        overlay.style.height = '100%';
        overlay.style.backgroundColor = 'rgba(0, 0, 0, 0.9)';
        overlay.style.zIndex = '9998';

        document.body.appendChild(overlay);
        document.body.appendChild(alertBox);
    });
}
